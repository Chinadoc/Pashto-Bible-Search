# Copy to .env.local for local Next.js runs
NEXT_PUBLIC_CLOUDFLARE_WORKER_URL=http://127.0.0.1:8787

# Optional: if you need to hit R2 directly from scripts/tools (not required for the app itself)
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET_NAME=pashto-bible-audio
