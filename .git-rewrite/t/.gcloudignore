# Based on .dockerignore; controls what Cloud Build uploads
# VCS
.git

# Bytecode and caches
**/__pycache__/
*.pyc
*.pyo
.DS_Store
.cache/

# Local envs and deps
venv/
node_modules/

# Heavy directories not needed to build backend image
all_txt_copies/
ot_txt_copies/
cache/
pashto-bible-react/
ui_backend/
inflection_cache/
inflection_service/
lingdocs_dictionary/
docs/
rx/

# Per-book directories
pashto*/

# Allowlisted files and directories (these are included by default if not ignored)
# Keep backend source, web JSON asset, and indices
# backend/**
# web/pashto_bible.json
# form_occurrence_index.json
# form_to_root_map.json
# audio_file_map.json (optional)

