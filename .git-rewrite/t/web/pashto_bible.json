لې او هغو ټېکادارانو ته یې وروسپارلې چې د بیا جوړونې مسوولیت یې په غاړه دی.»"}, {"ref": "2 Kings 2:9", "text": "که څه هم دغو کاهنانو ته اجازه نه وه چې په اورشلیم کې څښتن ته د قربانۍ په ځای کې خدمت وکړي، خو هغوی کولای شول چې هغه فطیره ډوډۍ وخوري چې د نورو کاهنانو دپاره پخېدله."}, {"ref": "2 Kings 2:9", "text": "یهویاکین د خپل پلار لاره غوره کړه او د څښتن په وړاندې یې ګناه وکړه."}, {"ref": "2 Kings 2:9", "text": "هغه د څښتن کور، شاهي ماڼۍ او په اورشلیم کې ټولې مهمې ودانۍ وسوځولې"}, {"ref": "2 Kings 2:10", "text": "حزقیا ورته وویل: «سیوری تل مخکې ځي او دا اسانه کار دی. زه غواړم چې سیوری دې لس پوړۍ شاته لاړ شي.»"}, {"ref": "2 Kings 2:10", "text": "څښتن د خپلو خدمتګارانو یعنې نبیانو په وسیله وویل:"}, {"ref": "2 Kings 2:10", "text": "شافان زیاته کړه: «حلقیا ماته یو کتاب راکړی دی» او هغه یې پاچا ته په لوړ اواز ولوست."}, {"ref": "2 Kings 2:10", "text": "همدارنګه یوشیا پاچا د توفت د قربانۍ ځای هم ناپاکه وګرځاوه چې د حنوم د زوی په دره کې ؤ، ترڅو هېڅوک ونه شي کولای چې خپل زوی یا خپله لور د سوځېدونکې نذرانې په توګه د مولک بت ته قرباني کړي."}, {"ref": "2 Kings 2:10", "text": "د هغه د پاچاهۍ په دوران کې د بابلیانو لښکر چې د نبوکدنصر پاچا منصبدارانو یې مشري کوله، اورشلیم ته ورغلل او هغه یې کلابند کړ."}, {"ref": "2 Kings 2:10", "text": "او د هغه ټولو عسکرو چې د هغه سره وو، د ښار دېوالونه راوغورځول."}, {"ref": "2 Kings 2:11", "text": "نو اشعیا نبي په څښتن باندې غږ وکړ او څښتن هغه سیوری چې د آحاز په زینه باندې راښکته شوی ؤ، لس پوړۍ وروسته کړ."}, {"ref": "2 Kings 2:11", "text": "«منسي پاچا داسې د کرکې وړ کارونه وکړل چې د اموریانو د کارونو څخه ډېر بد وو او په خپلو بتانو یې د یهودا خلک په ګناه باندې اخته کړل."}, {"ref": "2 Kings 2:11", "text": "کله چې پاچا د شریعت د کتاب خبرې واورېدلې، له غمه یې خپل کالي وشکول."}, {"ref": "2 Kings 2:11", "text": "یوشیا د اسونو هغه مجسمې هم لېرې کړې چې د یهودا پاچاهانو لمر ته د عبادت کولو دپاره وقف کړې وې او هغه جنګي ګاډۍ یې وسوځولې چې په دې عبادت کې به ورڅخه کار اخیستل کېده. (دا مجسمې د څښتن د کور په حوېلۍ کې د هغې دروازې تر څنګ چې د یو لوړ رتبه درباري نتنملک د اوسېدلو ځای ته نژدې وه، ساتل شوې وې.)"}, {"ref": "2 Kings 2:11", "text": "د محاصرې په وخت کې خپله نبوکدنصر اورشلیم ته راغی."}, {"ref": "2 Kings 2:11", "text": "بیا نبوزرادان هغه خلک چې په ښار کې پاتې وو، د هغو کسانو په شمول چې بابلیانو ته تسلیم شوي وو، بابل ته بوتلل."}, {"ref": "2 Kings 2:12", "text": "په همدې وخت کې د بابل پاچا د بلدان زوی مرودک بلدان خبر شو چې حزقیا پاچا ناروغ ؤ، نو هغه د خپلو استازو په لاس حزقیا ته لیکونه او سوغات ورولېږل."}, {"ref": "2 Kings 2:12", "text": "نو زه د اسراییلو څښتن خدای به په اورشلیم او یهودا باندې داسې بلا راولم چې هرڅوک خبر شي، هغه به هک حیران شي."}, {"ref": "2 Kings 2:12", "text": "هغه حلقیا کاهن، د شافان زوی اخیقام، د میکایا زوی عکبور، شافان د دربار منشي او د پاچا خدمتګار عسایا ته دغه امر ورکړ:"}, {"ref": "2 Kings 2:12", "text": "یوشیا پاچا د قربانۍ هغه ځایونه چې د یهودا پاچاهانو د ماڼۍ په بام یعنې د آحاز پاچا په کوټې باندې جوړ کړي وو، د قربانۍ د هغو ځایونو سره یوځای وران کړل چې منسي پاچا د خدای د کور په دوو حوېلیو کې جوړ کړي وو. هغه دا د قربانۍ ځایونه ټوټې ټوټې کړل او د قدرون په دره کې یې وغورځول."}, {"ref": "2 Kings 2:12", "text": "یهویاکین پاچا د خپلې مور، خپلو خدمتګارانو، خپلو منصبدارانو او د ماڼۍ د درباریانو سره بابلیانو ته تسلیم شو. نبوکدنصر د خپلې پاچاهۍ په اتم کال یهویاکین بندي کړ."}, {"ref": "2 Kings 2:12", "text": "خو هغه په یهودا کې ځینې غریب خلک پرېښودل چې د انګورو په باغونو او پټیو کې کار وکړي."}, {"ref": "2 Kings 2:13", "text": "حزقیا استازو ته هرکلی ووایه او هغوی ته یې د خپلو شتمنېو تحویلخانې، یعنې خپل سپین او سره زر، خپلې مسالې او عطرونه او خپل ټول عسکري سامان وروښودل. د هغه په ماڼۍ يا پاچاهۍ کې داسې شی نه ؤ چې هغوی ته یې نه وي ښودلی."}, {"ref": "2 Kings 2:13", "text": "زه به اورشلیم ته داسې سزا ورکړم لکه څنګه چې مې سامرې او د اسراییلو پاچا اخاب او د هغه اولادې ته ورکړې وه. زه به اورشلیم د هغه د خلکو څخه داسې پاک کړم لکه د یو قاب خواړه چې په پوره توګه خوړل کیږي."}, {"ref": "2 Kings 2:13", "text": "«لاړ شئ او د څښتن سره زما او د یهودا د ټولو خلکو دپاره د دې کتاب د خبرو په اړه مشوره وکړئ. څښتن په مونږ باندې ډېر په قهر دی، ځکه څه چې په دې کتاب کې لیکل شوي دي، زمونږ نیکونو په هغو باندې عمل نه دی کړی.»"}, {"ref": "2 Kings 2:13", "text": "یوشیا د قربانۍ هغه ځایونه ناپاک وګرځول چې سلیمان پاچا د اورشلیم په ختیځ کې او د فساد یعنې د ګناه د غره په جنوب کې یې د ناوړه بتانو د عبادت دپاره جوړ کړي وو، یعنې د صیدون د خلکو بت عشتاروت، د موآب د خلکو بت کموش او د عمون د خلکو بت مولک دپاره."}, {"ref": "2 Kings 2:13", "text": "نبوکدنصر د څښتن د کور او د ماڼۍ ټولې خزانې بابل ته یووړې. همدارنګه هغه د سرو زرو هغه ټول سامان چې سلیمان پاچا د څښتن د کور دپاره جوړ کړی ؤ، ټوټې ټوټې کړ. دا هرڅه د څښتن د پېشګویۍ سره سم سرته ورسېدل."}, {"ref": "2 Kings 2:13", "text": "بابلیانو هغه برنجي ستنې او ګاډۍ ګانې چې د څښتن په کور کې وې د لویې برنجي ټانکۍ سره یوځای ټوټې ټوټې کړلې او ټول برنج یې بابل ته یووړل."}, {"ref": "2 Kings 2:14", "text": "بیا اشعیا نبي حزقیا پاچا ته ورغی او پوښتنه یې ترې وکړه: «دا خلک د کوم ځای څخه راغلي وو او تاته یې څه وویل؟» حزقیا ځواب ورکړ: «هغوی د یو ډېر لېرې وطن یعنې د بابل څخه راغلي وو.»"}, {"ref": "2 Kings 2:14", "text": "هغه خلک چې ژوندي پاتې کیږي د هغو څخه به مخ واړوم او هغوی به خپلو دښمنانو ته په لاس ورکړم. هغوی به ورباندې فتح ومومي او وطن به یې لوټ کړي."}, {"ref": "2 Kings 2:14", "text": "حلقیا، اخیقام، عکبور، شافان او عسایا لاړل چې د یوې پیغمبرې سره چې حلده نومېدله، مشوره وکړي. هغه د اورشلیم د ښار په نوې سیمه کې اوسېدله (د هغې مېړه شلوم نومېده چې د تقوه زوی او د حرحس لمسی ؤ. هغه د خدای د کور د کالیو د ساتلو مسوولیت په غاړه درلود). نو څه چې پېښ شوي وو هغې ته یې بیان کړل."}, {"ref": "2 Kings 2:14", "text": "یوشیا پاچا د تیږو ستنې ټوټې ټوټې کړې، د اشیره بتان یې وران کړل او هغه ځمکه چې دغه بتان په کې ودرول شوي وو، هغه یې د انسانانو په هډوکو باندې پټه کړه."}, {"ref": "2 Kings 2:14", "text": "نبوکدنصر د اورشلیم خلک او ټول منصبداران او جنګیالیان د اسیرانو په توګه بوتلل چې د دې ټولو شمېر لسو زرو تنو ته رسېده. هغه کسبګران هم د اهنګرانو په شمول بوتلل او یوازې ډېر غریب خلک یې په یهودا کې پرېښودل."}, {"ref": "2 Kings 2:14", "text": "همدارنګه هغوی بېلچې، د قربانۍ د ځای څخه د ایرو د لېرې کولو لوښي، د څراغونو د پلتو پاکوونکي، د قربانیو د وینو کاسې، د خوشبویۍ د سوځولو کاسې او نور ټول هغه برنجي سامان چې د خدای په کور کې د خدمت دپاره ورڅخه کار اخیستل کېده، یووړل."}, {"ref": "2 Kings 2:15", "text": "اشعیا پوښتنه وکړه: «ستا په ماڼۍ کې هغوی څه ولیدل؟» حزقیا ځواب ورکړ: «هغوی هرڅه ولیدل. په تحویلخانو کې داسې شی نه ؤ چې هغوی ته مې نه وي ښودلی.»"}, {"ref": "2 Kings 2:15", "text": "زه د خپل قوم سره دا کار ځکه کوم چې هغوی داسې کارونه کړي دي چې زه ورڅخه کرکه لرم. له هغه وخت څخه چې د هغوی نیکونه د مصر څخه راوتلي دي تر نن ورځې پورې یې زما قهر راپارولی دی.»"}, {"ref": "2 Kings 2:15", "text": "هغې ورته وویل چې پاچا ته بېرته لاړ شي او هغه ته د اسراییلو د څښتن خدای دغه پیغام ورکړي:"}, {"ref": "2 Kings 2:15", "text": "پرته له دې یوشیا هغه د قربانۍ ځای هم وران کړ چې په بیت ییل کې ؤ او د نباط د زوی یروبعام پاچا له خوا چې د اسراییلو د ګناه سبب ګرځېدلی ؤ، جوړ شوی ؤ. یوشیا د قربانۍ ځای راوغورځاوه، د هغه تیږې یې ټوټې ټوټې کړې او په خاورو یې بدلې کړې. هغه د اشیره بت هم وسوځاوه."}, {"ref": "2 Kings 2:15", "text": "نبوکدنصر، یهویاکین د هغه د مور، ښځو، درباریانو او د یهودا د مشرانو سره د اسیرانو په توګه بابل ته بوتلل."}, {"ref": "2 Kings 2:15", "text": "هغوی هغه ټول شیان هم یووړل چې د سرو یا سپینو زرو څخه جوړ شوي وو چې په هغو کې د وینو د شیندلو کاسې او د اور لوښي شامل وو."}, {"ref": "2 Kings 2:16", "text": "بیا اشعیا حزقیا پاچا ته وویل: «څښتن داسې وایي:"}, {"ref": "2 Kings 2:16", "text": "برسېره پردې چې منسي د یهودا خلک د بت پرستۍ خواته واړول او د دې سبب شو چې هغوی د څښتن په وړاندې ګناه وکړي، هغه دومره ډېر بې ګناه خلک ووژل چې د اورشلیم په کوڅو کې یې وینې بهېدلې."}, {"ref": "2 Kings 2:16", "text": "«څښتن داسې وایي: د دې کتاب د لیکنې له مخې چې د یهودا پاچا لوستلی دی، زه به په دې ځای او د دې ځای په خلکو باندې بلا راولم."}, {"ref": "2 Kings 2:16", "text": "بیا یوشیا شاوخوا وکتل او په غونډۍ باندې یې یوه هدیره ولیدله. د هغو څخه یې هډوکي راوویستل، د قربانۍ په ځای کې یې وسوځول او په دې ډول هغه د قربانۍ ځای ناپاکه کړ. لکه څنګه چې د خدای نبي یروبعام ته پېشګویي کړې وه، کټ مټ هماغسې وشو