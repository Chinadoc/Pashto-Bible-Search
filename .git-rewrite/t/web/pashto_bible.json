تيارۀ وى."}, {"ref": "None Job 3:30", "text": "کومه چې اوبۀ د کاڼى په شان سختې کړى، او د سمندر مخ کلک کړى؟"}, {"ref": "None Job 3:30", "text": "د دې بچى وينه څښى، او چې په کوم ځائ کښې مرداره وى، نو هغه په هغه ځائ کښې حاضر وى.“"}, {"ref": "None Job 3:31", "text": "زما د رباب ساز په ژړا بدل شوے دے، او زما د شپېلۍ آواز د ژړا نه ډک دے."}, {"ref": "None Job 3:31", "text": "زما په خاندان کښې هر يو کس ته پته ده، چې زما کور ته څوک هم راغلى دى نو د هغوئ ښۀ مېلمستيا شوې ده."}, {"ref": "None Job 3:31", "text": "ايُوبه، ما ته توجو شه او ما ته غوږ ونيسه، تۀ خاموش اوسه او زۀ به خبرې کوم."}, {"ref": "None Job 3:31", "text": "خلق خُدائ پاک ته ولې نۀ وائى چې، ”مونږ ګناه کړې ده، خو مونږ به نوره ګناه نۀ کوُو“؟"}, {"ref": "None Job 3:31", "text": "ځکه چې د دې په ذريعه هغه په خلقو حکومت کوى، او هغه خلقو له بې‌حسابه خوراک ورکوى."}, {"ref": "None Job 3:31", "text": "تۀ عقدِ ثُريا ستورو ته لار ښودلے شې، يا جبار ستورے په مينځ بېلولے شې څۀ؟"}, {"ref": "None Job 3:32", "text": "ما په پردو خلقو هيڅکله بې‌غورى نۀ ده کړې چې هغوئ په کوڅه کښې شپه تېره کړى، او ما مسافرو ته خپلې دروازې کولاو ساتلې دى."}, {"ref": "None Job 3:32", "text": "کۀ تۀ څۀ وائې، نو ووايه، زۀ غواړم چې تا بې‌ګناه ثابت کړم."}, {"ref": "None Job 3:32", "text": "يا، ”ما چې کومه بدعملى کړې وى نو هغه ما ته وښايه، کۀ ما غلطى کړې وى، نو فوراً به يې پرېږدم“؟"}, {"ref": "None Job 3:32", "text": "هغه برېښنا په خپلو لاسونو کښې ساتى، او حُکم ورکوى چې نښه وولى."}, {"ref": "None Job 3:32", "text": "ولې تۀ منطقتُ البُروج ستورو ته خپل موسمونه ښودلے شې، يا تۀ بناتُ النعش ستورى ته سره د هغې د بچو لار ښودلے شې؟"}, {"ref": "None Job 3:33", "text": "کۀ ما خپله ګناه د نورو خلقو په شان پټه کړې وې، او غلطى مې په خپل زړۀ کښې پټه ساتلې وې،"}, {"ref": "None Job 3:33", "text": "کۀ داسې نۀ وى، نو ما ته غوږ ونيسه، خاموش شه او زۀ به تا ته د عقل ښودنه وکړم.“"}, {"ref": "None Job 3:33", "text": "خُدائ پاک به ستا د خوښې دپاره خپل اِنصاف پرېږدى؟ خو تا هغه رد کړے دے. دا زما نه بلکې ستا فېصله ده، مونږ ته اوس ووايه چې ستا خيال څۀ دے؟"}, {"ref": "None Job 3:33", "text": "د هغۀ د تندر آواز داسې وائى، چې هغه غېرتى دے او د ګناه خِلاف غصه لرى."}, {"ref": "None Job 3:33", "text": "تۀ د آسمان په قانون پوهېږې څۀ؟ يا تۀ د هغوئ قانون په زمکه باندې قائمولے شې څۀ؟"}, {"ref": "None Job 3:34", "text": "ځکه چې زۀ د ګڼې نه يا د خلقو د بې‌عزتۍ نه يرېدلے يم، چې غلے پاتې يم او د کور نه نۀ يم وتلے،"}, {"ref": "None Job 3:34", "text": "چې څوک پوهه لرى نو هغوئ به ما ته ووائى، او هغه عقلمند چې ما ته غوږ ږدى نو هغوئ به ووائى،"}, {"ref": "None Job 3:34", "text": "ولې تۀ خپل آواز وريځو ته رسولے شې څۀ، د دې دپاره چې باران ووروى؟"}, {"ref": "None Job 3:35", "text": "نو اے کاش چې ما ته چا غوږ نيولے وے. زۀ ليکلى درکوم چې هره يوه خبره رښتيا ده. او قادر خُدائ دې زما فرياد واورى، او زما مخالفين دې ليکلے اِلزام راوړى چې زۀ يې وګورم."}, {"ref": "None Job 3:35", "text": "”ايُوب د جهالت خبرې کوى، د هغۀ خبرې د کم عقلتوب نه ډکې دى.“"}, {"ref": "None Job 3:35", "text": "تۀ برېښنا ځلولے شې څۀ؟ يا دا پخپله مرضۍ باندې راغورزولے شې څۀ؟"}, {"ref": "None Job 3:36", "text": "بې‌شکه زۀ به په فخر سره د اِلزام مقابله وکړم او زۀ به دا د تاج په شان په سر کړم."}, {"ref": "None Job 3:36", "text": "ايُوب دې عدالت ته راوستلے شى او غټى نه غټه سزا دې ورکړے شى، ځکه چې هغه د بدعمله سړى په شان خبرې کوى."}, {"ref": "None Job 3:36", "text": "خبره په زړۀ کښې چا اچولې ده، او دماغو له پوهه چا ورکړې ده؟"}, {"ref": "None Job 3:37", "text": "زۀ به هغۀ له د خپل عمل حِساب کِتاب ورکړم، او د هغۀ په حضور کښې به زړَور ولاړ يم."}, {"ref": "None Job 3:37", "text": "ځکه چې هغه د سرکشۍ سره ګناه کوى، هغه ګستاخ دے، او هغه د خُدائ پاک خِلاف ډېرې خبرې کوى.“"}, {"ref": "None Job 3:37", "text": "داسې هوښيار شته چې وريځې وشمېرى؟ يا د آسمان نه باران ورولے شى داسې لکه چې د منګى نه اوبۀ توئ کړے شى،"}, {"ref": "None Job 3:38", "text": "کۀ ما هغه زمکه قبضه کړې وى چې کومه زۀ کرَم او دا مې د خپل اصلى مالِک نه اخستې وى،"}, {"ref": "None Job 3:38", "text": "په هغه اوچه زمکه باندې چې د خاورې نه يې لوټې جوړې شوې وى؟"}, {"ref": "None Job 3:39", "text": "کۀ د دې پېداوار ما بغېر د پېسو نه خوړلے وى، او کۀ ما د دې مالِکان وژلى وى،"}, {"ref": "None Job 3:39", "text": "ولې تۀ د ازمرى دپاره ښکار کولے شې، او د وړو زمرو لوږه پوره کولے شې،"}, {"ref": "None Job 3:40", "text": "نو پرېږده چې د غنمو په ځائ ازغى وشى، او د اوربشو په ځائ دې ګنده واښۀ وشى.“ د ايُوب خبرې ختمې شوې."}, {"ref": "None Job 3:40", "text": "کله چې هغه په خپلو غارونو کښې پټ وى، يا په بوټو کښې د ښکار په اِنتظار ناست وى؟"}, {"ref": "None Job 3:41", "text": "کارغانو دپاره د خوراک بندوبست څوک کوى، کله چې د هغوئ بچى خُدائ پاک ته ژړا کوى، او د خوراک د نشتوالى په وجه سرګردانه ګرځى؟"}, {"ref": "None Job 4:1", "text": "بيا مالِک خُدائ ايُوب ته وفرمائيل،"}, {"ref": "None Job 4:1", "text": "سمندرى بلاګانې تۀ د کُنډې سره راويستلے شې، يا د دې ژبه د پړى سره تړلے شې څۀ؟"}, {"ref": "None Job 4:1", "text": "بيا ايُوب مالِک خُدائ له جواب ورکړو،"}, {"ref": "None Job 4:2", "text": "”تۀ اوس هم د قادر خُدائ سره بحث کول غواړې څۀ؟ څوک چې د خُدائ پاک سره بحث کوى نو هغه به جواب ورکوى.“"}, {"ref": "None Job 4:2", "text": "ولې تۀ دې ته پېزوان اچولے شې، يا يې په ژامنه کښې کُنډه اچولے شې؟"}, {"ref": "None Job 4:2", "text": "”ما ته پته ده چې تۀ هر څۀ کولے شې، او تا د خپل کار نه هيڅ څوک نۀ شى ايسارولے."}, {"ref": "None Job 4:3", "text": "بيا ايُوب مالِک خُدائ له جواب ورکړو،"}, {"ref": "None Job 4:3", "text": "ولې دا به د رحم دپاره تا ته ډېر مِنتُونه وکړى؟ يا به نرمې خبرې درته وکړى؟"}, {"ref": "None Job 4:3", "text": "تا وفرمائيل چې، ”هغه څوک دے چې زما په حِکمت باندې د ناپوهۍ سره شک کوى؟“ هغه زۀ يم، ما د داسې څيزونو خبره کوله چې ما ته يې هيڅ پته نۀ وه، او هغه خبرې زما دپاره ډېرې عجيبه او لوئې وې."}, {"ref": "None Job 4:4", "text": "”ګوره، زۀ هيڅ هم نۀ يم، زۀ به تا له څۀ جواب درکړم؟ زۀ په خپله خولۀ باندې لاس ږدم."}, {"ref": "None Job 4:4", "text": "دا به تا سره يو لوظ وکړى څۀ چې ټول عُمر به ستا غلام وى؟"}, {"ref": "None Job 4:4", "text": "تا وفرمائيل چې، ”ما ته غوږ ونيسه او زۀ به وايم، زۀ به تپوس کوم او تۀ به ما له جواب راکوې.“"}, {"ref": "None Job 4:5", "text": "ما ډېر څۀ وئيلى دى، نور زۀ څۀ نۀ وايم.“"}, {"ref": "None Job 4:5", "text": "ولې تۀ به دا د يو مارغۀ په شان وساتې څۀ، يا تۀ به دا وتړې څۀ دپاره د دې چې ستا وينځې ورسره لوبې وکړى؟"}, {"ref": "None Job 4:5", "text": "ما مخکښې صرف ستا په حقله اورېدلى دى، خو اوس مې په خپلو سترګو وليدلې."}, {"ref": "None Job 4:6", "text": "بيا مالِک خُدائ د طوفان نه ايُوب له جواب ورکړو،"}, {"ref": "None Job 4:6", "text": "ولې سوداګر به د دې سودا وکړى؟ چې په بازار کښې يې خرڅ کړى؟"}, {"ref": "None Job 4:6", "text": "نو ما چې څۀ وئيلى دى نو په هغې شرمنده يم، او په خاورو او ايرو کښې توبه وباسم.“"}, {"ref": "None Job 4:7", "text": "”نو اوس ورته ټينګ شه، زۀ به ستا نه تپوس وکړم او تۀ به ما له جواب راکړې."}, {"ref": "None Job 4:7", "text": "ولې د هغې په څرمن باندې غشى څۀ اثر کوى، او د دې سر د نېزو سره غوڅولے شې؟"}, {"ref": "None Job 4:7", "text": "کله چې مالِک خُدائ د ايُوب سره دا خبرې وکړې، نو مالِک خُدائ تيمانى اليفز ته وفرمائيل، ”زۀ تا او ستا دوو ملګرو ته سخت غصه يم، ځکه چې تاسو زما هغه خبره نۀ ده کړې چې کومه صحيح ده، لکه څنګه چې زما خِدمت کوونکى ايُوب کړې ده."}, {"ref": "None Job 4:8", "text": "ولې تۀ د دې ثابِتولو کوشش کوې چې زۀ بې‌اِنصافه يم، او ما غلط وګڼې او خپل ځان ته صحيح ووائې؟"}, {"ref": "None Job 4:8", "text": "کۀ تۀ خپل لاس د دې سره ولګوې، نو د جنګ په مزه به پوهه شې، او بيا به هيڅکله داسې نۀ کوې."}, {"ref": "None Job 4:8", "text": "نو په دې وجه اوس اووۀ غوَيى او اووۀ ګډان بوځه او زما خِدمت کوونکى ايُوب له ورشه او د خپل ځان دپاره دا د سوزېدونکې نذرانې په توګه پېش کړه، نو زما خِدمت کوونکے ايُوب به ستا دپاره دُعا وکړى، ځکه چې زۀ به د هغۀ دُعا قبلوم او ستاسو د کم عقلتوب په مطابق کار به درسره نۀ کوم، ځکه چې تاسو زما هغه خبره نۀ ده کړې چې کومه صحيح ده، لکه څنګه چې زما خِدمت کوونکى ايُوب کړې ده.“"}, {"ref": "None Job 4:9", "text": "تۀ د خُدائ پاک په شان تکړه يې څۀ، ستا آواز د هغۀ د تندر د آواز په شان کېدے شى؟"}, {"ref": "None Job 4:9", "text": "نه، د دې نيول څۀ فائده نۀ کوى، او کوم ښکارى چې د دې د نيولو کوشش کوى نو هغه به راوغورزولے شى."}, {"ref": "None Job 4:9", "text": "نو تيمانى اليفز، شوحى بِلداد او نعماتى ضوفر لاړل او چې مالِک خُدائ څنګه فرمائيلى وُو هم هغه شان يې وکړل، او مالِک خُدائ د ايُوب دُعا قبوله کړه."}, {"ref": "None Job 4:10", "text": "کۀ داسې وى نو په رُعب داب او شان و شوکت سره خپل ځان سنګار کړه، د عزت او درناوى په جامو باندې خپل ځان پټ کړه."}, {"ref": "None Job 4:10", "text": "هيڅ څوک هم دا جرأت نۀ شى کولے چې کار ورسره وساتى. او د دې په وړاندې څوک ټېنګېدے شى؟"}, {"ref": "None Job 4:10", "text": "نو کله چې ايُوب د خپلو ملګرو دپاره دُعا وکړه نو خُدائ پاک هغۀ له بيا برکت ورکړو، او چې ايُوب مخکښې څۀ لرل نو مالِک خُدائ هغۀ له د هغې يو په دوه نور هم زيات ورکړل."}, {"ref": "None Job 4:11", "text": "خپل ځان په قهر کړه، هر يو مغرور سړى ته ګوره او هغه سپک کړه،"}, {"ref": "None Job 4:11", "text": "چا ما له څۀ راکړى دى چې زۀ بدله ورکړم؟ د آسمان نه لاندې هر څۀ زما دى؟"}, {"ref": "None Job 4:11", "text": "نو هلته هغۀ له د هغۀ ټول وروڼه خوېندې او ټول پخوانى خپل پردى راغلل او هغوئ د هغۀ په کور کښې روټۍ وخوړه. او هغوئ ورته مينه ښکاره کړه او د هغه تکليفونو په وجه يې هغۀ له تسلى ورکړه چې مالِک خُدائ په هغۀ راوستى وُو. او هغوئ هر يو هغۀ له لږې پېسې او يوه د سرو زرو ګوتمه ورکړه."}, {"ref": "None Job 4:12", "text": "ټولو مغروره خلقو ته وګوره او هغوئ عاجزان کړه، او بدعمله خلق ټک سره ووژنه."}, {"ref": "None Job 4:12", "text": "زۀ به د دې د بدن د اندامونو په حقله خاموشى نۀ اختياروم، يا د دې د لوئ طاقت او د دې د ښۀ بدن په حقله به وايم."}, {"ref": "None Job 4:12", "text": "نو مالِک خُدائ د ايُوب وروستنے عُمر د اول عُمر نه زيات برکتناک کړو، او د هغۀ څوارلس زره ګډې، شپږ زره اوښان، دوه زره غوَيى او يو زر خرۀ وُو."}, {"ref": "None Job 4:13", "text": "هغوئ ټول په خاورو کښې ښخ کړه، او هغوئ قبر کښې قېد کړه."}, {"ref": "None Job 4:13", "text": "د دې نه څرمن څوک ويستے شى؟ د دې ډکه څرمن څوک سورے کولے شى؟"}, {"ref": "None Job 4:13", "text": "د هغۀ اووۀ زامن او درې لوڼه هم وې."}, {"ref": "None Job 4:14", "text": "نو زۀ به دې هم صِفت وکړم، ځکه چې خپل طاقت تا بچ کولے شى."}, {"ref": "None Job 4:14", "text": "د دې د خولې ژامنې څوک کولاولے شى؟ ځکه چې د دې غاښونه خلق يروى."}, {"ref": "None Job 4:14", "text": "هغۀ په وړومبۍ لور باندې يميمه، په دوېمه قصياه او په درېمه باندې قرن‌هپوک نوم کېښودو."}, {"ref": "None Job 4:15", "text": "دريابى مېښې ته وګوره، چې هغه مې هم هغه شان جوړه کړې ده لکه څنګه مې چې تۀ جوړ کړے يې، دا د يو غوَيى په شان واښۀ خورى."}, {"ref": "None Job 4:15", "text": "د دې ملا د ډالونو قطارونو نه جوړه ده، دا د يو بل سره کلک انښلى."}, {"ref": "None Job 4:15", "text": "او په هغه ټول مُلک کښې د ايُوب د لوڼو په شان ښائسته ښځې نۀ وې، خپل پلار هغوئ له د دوئ د وروڼو په شان ميراث ورکړو."}, {"ref": "None Job 4:16", "text": "د هغې طاقت د هغې په بدن کښې دے، او د هغې طاقت د هغې د خېټې په پټو کښې دے."}, {"ref": "None Job 4:16", "text": "د يو بل سره دومره نزدې دى، چې د دې په مينځ کښې هوا هم نۀ شى تېرېدلے."}, {"ref": "None Job 4:16", "text": "ايُوب د دې نه پس يو سل او څلوېښت کاله ژوندے وو او د څلورم نسل پورې خپل بچى او نمسى يې وليدل."}, {"ref": "None Job 4:17", "text": "د هغې لکۍ لکه د دِيار د ونې په شان سخته ده، د هغې د پتُون پټې خپلو کښې غوټه شوې دى."}, {"ref": "None Job 4:17", "text": "دا د يو بل سره تړلى شوى دى، دې يو بل نيولے دے او د يو بل نه نۀ جدا کيږى."}, {"ref": "None Job 4:17", "text": "نو بيا ايُوب په پوخ عُمر کښې مړ شو."}, {"ref": "None Job 4:18", "text": "د دې هډوکى د زېړو نلکې دى، د هغې هډوکى د اوسپنې سيخونه دى."}, {"ref": "None Job 4:18", "text": "د دې انټوشى لکه د رڼا پړق وى، او د دې سترګې د سحر د سوروالى په شان دى."}, {"ref": "None Job 4:19", "text": "دا د خُدائ پاک د کارنامو يو لوئ کار دے، او صرف د دې خالِق په دې باندې قابو موندلے شى."}, {"ref": "None Job 4:19", "text": "د دې خولې نه د ډيوو شُغلې ځى، او د اور ذرې ترې نه راوځى."}, {"ref": "None Job 4:20", "text": "ځکه چې غرونه د دې دپاره خوراک پېدا کوى چرته چې ټول ځنګلى ځناور لوبې کوى."}, {"ref": "None Job 4:20", "text": "د دې د پوزې نه لوګے راوځى، لکه چې د پتيلې لاندې د بلو لوخو لوګے وى."}, {"ref": "None Job 4:21", "text": "دا په اوبو کښې د نيلوفر بوټو لاندې پراتۀ وى او د لوخې په ډنډونو کښې پټ وى."}, {"ref": "None Job 4:21", "text": "د دې ساه سکارۀ بلوى، او د دې خولې نه يوه لمبه راوځى."}, {"ref": "None Job 4:22", "text": "د نيلوفر بوټى ورباندې سورے کوى، او د نِهر د غاړې د وَلو ونې د دې نه ګېرچاپېره تاو وى."}, {"ref": "None Job 4:22", "text": "د دې څټ مضبوط دے، او چې چرته هم ځى نو هلته يره راځى."}, {"ref": "None Job 4:23", "text": "کۀ سيند په موج کښې وى، نو دا نۀ يريږى، د اُردن سيند کۀ تر خولې پورې هم ډک وى نو دا نۀ يريږى."}, {"ref": "None Job 4:23", "text": "د دې د غوښې موړې د يوې بلې سره انښتې دى، دا مضبوطې جوړې دى او نۀ خوځيږى."}, {"ref": "None Job 4:24", "text": "څوک دا د کُنډو سره راوچتولے شى، يا يې څوک په پوزه کښې د قابو کولو دپاره پېزوان اچولے شى؟"}, {"ref": "None Job 4:24", "text": "د دې زړۀ د کاڼى په شان سخت دے، لکه د ژرندې د کاڼى په شان سخت دے."}, {"ref": "None Job 4:25", "text": "کله چې دا په خپله پاڅى نو طاقتور خلق ويريږى، او يرې نه وتښتى."}, {"ref": "None Job 4:26", "text": "داسې تُوره نشته چې زخمى يې کړى، نۀ پرې نېزه، نۀ غشے او نۀ ورباندې نرۍ نېزه څۀ اثر کوى."}, {"ref": "None Job 4:27", "text": "دا اوسپنه د بوسو په شان ګڼى، او زېړ د ورَستو شوو لرګو په شان ګڼى."}, {"ref": "None Job 4:28", "text": "غشى دا نۀ شى شړلے، او د ليندې کاڼى خو ورته ګپ ښکارى."}, {"ref": "None Job 4:29", "text": "لَوړ د بوسو په شان ګڼى، او د نرو نېزو په راويستلو پورې دا خندا کوى."}, {"ref": "None Job 4:30", "text": "د دې خېټه د تېرو ماتو شوو شيشو په شان ده، دا په خټه باندې داسې نښه پرېږدى لکه چې په مېخونو سورے شوے وى."}, {"ref": "None Job 4:31", "text": "دا سمندر د يشېدلو اوبو په شان خوځوى، او دا سمندر داسې شاربى لکه شُملې."}, {"ref": "None Job 4:32", "text": "دا د خپل ځان شا ته يو پړقېدونکې کرښه پرېږدى، او سمندر تک سپين کړى"}, {"ref": "None Job 4:33", "text": "په زمکه باندې د دې ثانى نشته، دا يو داسې مخلوق دے چې نۀ يريږى."}, {"ref": "None Job 4:34", "text": "دا په ټولو کښې ډېر مغرور دے، دا د ټولو ځناورو بادشاه دے.“"}, {"ref": "None Joshua 1:1", "text": "د اورشلیم پاچا ادوني صدق واورېدل چې یوشع عای نیولی دی او هغه یې بیخي له منځه وړی او د هغه ځای پاچا یې وژلی دی لکه څنګه چې هغه د اریحا او د هغه ځای د پاچا سره همداسې کړي وو. هغه دا هم واورېدل چې د جبعون خلکو د اسراییلو سره د سولې تړون کړی دی او د هغوی په منځ کې اوسیږي."}, {"ref": "None Joshua 1:1", "text": "کله چې د اسراییلو د بریالیتوب خبر د حاصور پاچا یابین ته ورسېده، هغه د مادون پاچا یوباب او د شمرون او اخشاف پاچاهانو"}, {"ref": "None Joshua 1:1", "text": "مخکې له دې چې موسی مړ شي هغه او د اسراییلو خلکو د اردن د سیند د ختیځې خوا دوو پاچاهانو ته ماتې ورکړه. دې دوو پاچاهانو په هغې سیمې باندې چې د ارنون له درې څخه د حرمون تر غره پورې رسېدله او په هغې کې د اردن د درې ختیځه خوا هم شامله وه، حکومت کاوه."}, {"ref": "None Joshua 1:1", "text": "کله چې یوشع زوړ شو، څښتن هغه ته وویل: «ته ډېر زوړ شوی یې، خو ډېره ځمکه لا پاتې ده چې باید ونیول شي."}, {"ref": "None Joshua 1:1", "text": "هغه ځمکې چې بني اسراییلو د کنعان په خاوره کې تر لاسه کړې، العازار کاهن، د نون زوی یوشع او د قوم مشرانو د هغوی ترمنځ ووېشلې."}, {"ref": "None Joshua 1:1", "text": "د یهودا د قبیلې طایفو د ځمکې یوه برخه تر لاسه کړه چې په لاندې ډول تشریح کیږي. دا ځمکه د صین د دښتې جنوب یعنې د ادوم د پولې پورې رسېدله."}, {"ref": "None Joshua 1:1", "text": "د هغې ځمکې جنوبي سرحد چې د یوسف اولادې ته ورکړل شوې ده، اریحا ته نژدې د اردن د سیند څخه پیل شوی دی یعنې د اریحا د چینو د ختیځ څخه پیل شوی او د دښتې څخه تېر شوی او د اریحا څخه د بیت ییل تر غرنۍ سیمې پورې رسېدلی دی."}, {"ref": "None Joshua 1:1", "text": "د ځمکې یوه برخه چې د اردن د سیند په لوېدیځ کې وه، ځینو کورنیو ته چې د یوسف د مشر زوی منسي اولاده وه ورکړل شوه. ماخیر د جلعاد پلار ؤ او د منسي مشر زوی ؤ. ماخیر یو نظامي اتل ؤ، نو د اردن د سیند په ختیځ کې د جلعاد او باشان سیمې هغه ته ورکړل شوې."}, {"ref": "None Joshua 1:1", "text": "کله چې هغوی هغه خاوره ونیوله، د اسراییلو ټول قوم په شیلوه کې سره راټول شو او هلته یې سپېڅلې خېمه ودروله."}, {"ref": "None Joshua 1:1", "text": "دوهمه پچه د شمعون د قبیلې د طایفو په نوم ووتله. د هغوی سیمه د یهودا په ځمکه کې پرته وه."}, {"ref": "None Joshua 1:2", "text": "د اورشلیم خلک ډېر وېرېدل، ځکه چې جبعون د شاهي ښارونو په شان یو ډېر لوی ښار ؤ. دا ښار د عای څخه لوی ؤ او ټول خلک یې ښه جنګیالي وو."}, {"ref": "None Joshua 1:2", "text": "او هغو پاچاهانو ته پیغام ولېږه چې د شمال په غرنۍ سیمه کې، د اردن په دره کې، د جلیل د بحیرې په جنوب کې، د غرونو په لمنو کې او دور ته نژدې په غونډیو باندې اوسېدل."}, {"ref": "None Joshua 1:2", "text": "سیحون د اموریانو پاچا ؤ چې په حشبون کې یې پاچاهي کوله. هغه د عروعیر څخه چې د ارنون د درې په څنګ کې ؤ او د درې له منځ څخه د یبوق تر سیند پورې چې د عمونیانو پوله وه پاچاهي کوله. په دې کې نیم جلعاد شامل ؤ."}, {"ref": "None Joshua 1:2", "text": "دا هغه ځمکه ده چې پاتې ده: د فلسطینیانو او د جشوریانو ټوله سیمه،"}, {"ref": "None Joshua 1:2", "text": "لکه څنګه چې څښتن د موسی په وسیله حکم کړی ؤ، د اردن د سیند په لوېدیځ کې د نهو قبیلو او نیمې قبیلې سیمې د پچې اچولو په وسیله وټاکل شوې."}, {"ref": "None Joshua 1:2", "text": "دا جنوبي پوله د مړې بحیرې د جنوبي برخې په پای کې پیل شوې،"}, {"ref": "None Joshua 1:2", "text": "هغه د بیت ییل څخه لوز ته راوتلی دی او عطاروت ادار ته چې ارکیان په کې اوسېدل، وتلی دی."}, {"ref": "None Joshua 1:2", "text": "د اردن د سیند په لوېدیځ کې د منسي پاتې کورنیو ته ځمکه ورکړل شوه چې هغه کورنۍ دا وې: ابیعزر، هالک، اسري ییل، شکیم، حافر او شمیداع. دا د یوسف د زوی یعنې منسي نارینه اولاده وه او هغوی د کورنیو مشران وو."}, {"ref": "None Joshua 1:2", "text": "خو د اسراییلو اووه قبیلې وې چې خپله د ځمکې برخه لا ورته نه وه ورکړل شوې."}, {"ref": "None Joshua 1:2", "text": "په هغې کې دا ځایونه شامل وو: بیرشبع (شبع)، مولاده،"}, {"ref": "None Joshua 1:3", "text": "نو ادوني صدق د حبرون پاچا هوهام، د یرموت پاچا فرآم، د لاخیش پاچا یافیع او د عجلون پاچا دبیر ته دا لاندېنی پیغام ولېږه:"}, {"ref": "None Joshua 1:3", "text": "همدارنګه هغه د کنعانیانو پاچاهانو ته چې د اردن د سیند په دواړو خواوو کې اوسېدل، د اموریانو، حیتیانو، فرزیانو او یبوسیانو پاچاهانو ته چې په غرنۍ سیمه کې اوسېدل او د هغو حویانو پاچاهانو ته هم پیغام ورولېږه چې د حرمون د غره په لمنو کې د مصفه په خاوره کې اوسېدل."}, {"ref": "None Joshua 1:3", "text": "په هغې کې د اردن دره د جلیل د بحیرې څخه جنوب خواته د بیت یشیموت (د مړې بحیرې ختیځ ته) او پیسګاه د غره تر لمنې پورې شامل وو."}, {"ref": "None Joshua 1:3", "text": "همدارنګه د عویانو سیمه تر جنوب پورې (د شیحور څخه نیولې چې د مصر په پولې کې وه د عقرون تر پولې پورې چې په شمال کې وه، د کنعانیانو ځمکه ګڼل کېدله. د فلسطین پاچاهان په غزه، اشدود، اشقلون، جت او عقرون کې اوسېدل)،"}, {"ref": "None Joshua 1:3", "text": "د عقربیم د غاښي جنوب خواته تللې، د صین تر دښتې پورې غزېدلې ده او د قادش برنیع تر جنوب پورې وه. بیا هغه د حزرون څخه تېره شوې، پورته د ادار خواته تللې او د قرقع خواته ګرځېدلې ده."}, {"ref": "None Joshua 1:3", "text": "بیا د ښکتني بیت حورون پورې په لوېدیځ کې د یفلیطیانو سیمې ته غزېدلی دی. د هغه ځای څخه جازر ته وتلی او د مدیترانې په بحیره کې ختم شوی دی."}, {"ref": "None Joshua 1:3", "text": "د منسي لمسي جلعاد یو زوی درلود چې حافر نومېده. حافر یو زوی درلود چې صلفحاد نومېده او هغه هېڅ زامن نه درلودل، خو پنځه لورګانې یې درلودلې چې نومونه یې دا وو: محله، نوعه، حجله، ملکه او ترزه."}, {"ref": "None Joshua 1:3", "text": "نو یوشع د اسراییلو قوم ته وویل: «تاسو به ترڅو پورې د هغې ځمکې په نیولو کې چې ستاسو د نیکونو څښتن خدای تاسو ته درکړې ده سستي کوئ؟"}, {"ref": "None Joshua 1:3", "text": "حزر شوعال، بالح، عاصم،"}, {"ref": "None Joshua 1:4", "text": "«راشئ او زما سره مرسته وکړئ چې په جبعون باندې حمله وکړو، ځکه چې د هغه ځای خلکو د یوشع او اسراییلیانو سره د سولې تړون کړی دی.»"}, {"ref": "None Joshua 1:4", "text": "هغوی د خپلو ټولو عسکرو سره راغلل. هغه یو لوی لښکر ؤ او د بحیرې د شګو په شان ډېر وو. هغوی ډېر زیات اسونه او جنګي ګاډۍ هم درلودلې."}, {"ref": "None Joshua 1:4", "text": "همدارنګه موسی او اسراییلیانو د باشان پاچا عوج ته چې د پاتې شویو رفاییانو څخه ؤ هم ماتې ورکړه. هغه په عشتاروت او ادرعي کې پاچاهي کوله."}, {"ref": "None Joshua 1:4", "text": "د کنعانیانو ټول هېواد او میعاره چې په صیدونیانو پورې اړه لري تر افیق پورې چې د اموریانو په پوله کې دی،"}, {"ref": "None Joshua 1:4", "text": "هغه د عصمون څخه تېره شوې او د هغه خوړ سره یوځای شوې ده چې د مصر د پولې سره ؤ او د مدیترانې په بحیره کې ختمه شوې ده. دا د ټولو اسراییلو جنوبي پوله هم وه."}, {"ref": "None Joshua 1:4", "text": "د یوسف اولادې یعنې د افرایم او لوېدیځې منسي قبیلو دا ځمکه د خپل ملکیت په توګه تر لاسه کړه."}, {"ref": "None Joshua 1:4", "text": "هغوی العازار کاهن، د نون زوی یوشع او مشرانو ته ورغلې او ویې ویل: «څښتن موسی ته ویلي دي چې صلفحاد هېڅ زامن نه لري. نو د هغه هرې لور ته د ځمکې یوه برخه ورکړه.» یوشع د څښتن د حکم څخه اطاعت وکړ. هغه د صلفحاد لورګانو ته د هغوی د نارینه خپلوانو په شان ځمکه ورکړه."}, {"ref": "None Joshua 1:4", "text": "د هرې قبیلې څخه درې درې تنه وټاکئ. زه به هغوی ولېږم چې ټول هېواد وګوري او هغه سیمه اندازه کړي چې هغوی به یې د خپل ملکیت په توګه تر لاسه کوي. بیا دې هغوی بېرته ماته راشي."}, {"ref": "None Joshua 1:4", "text": "التولد، بتول، حرمه،"}, {"ref": "None Joshua 1:5", "text": "د اموریانو دغو پنځو پاچاهانو یعنې د اورشلیم پاچا، د حبرون پاچا، د یرموت پاچا، د لاخیش پاچا او د عجلون پاچا خپل ځواکونه سره یوځای کړل. هغوی جبعون کلابند کړ او په هغه باندې یې حمله وکړه."}, {"ref": "None Joshua 1:5", "text": "دا ټول پاچاهان سره راټول شول او د میروم د خوړ سره یې کمپ جوړ کړ. هلته هغوی خپل ځواکونه سره یوځای کړل چې د اسراییلو په وړاندې وجنګیږي."}, {"ref": "None Joshua 1:5", "text": "د هغه په پاچاهۍ کې د حرمون غر، سلخه او ټول باشان د جشور او معکې تر پولې او همدارنګه نیم جلعاد د حشبون د پاچا سیحون تر سیمې پورې شامل وو."}, {"ref": "None Joshua 1:5", "text": "د جبالیانو ځمکه او ټول لبنان تر ختیځ پورې، د بعل جاد څخه نیولې چې د حرمون د غره جنوب خواته پروت دی د حمات تر غاښي پورې."}, {"ref": "None Joshua 1:5", "text": "نو اسراییلیانو د څښتن د امر له مخې چې موسی ته یې کړی ؤ، ځمکه ووېشله."}, {"ref": "None Joshua 1:5", "text": "د یهودا د قبیلې ختیځه پوله مړه بحیره وه. دا پوله په شمال کې تر هغه ځای پورې غزېدلې ده په کوم ځای کې چې د اردن سیند د مړې بحیرې سره یوځای کیږي"}, {"ref": "None Joshua 1:5", "text": "دا سیمه د طایفې له مخې د افرایم سیمه وه: د هغوی د ځمکې سرحد د عطاروت ادار څخه چې په ختیځ کې ؤ پورتني بیت حورون ته رسېده"}, {"ref": "None Joshua 1:5", "text": "د هغوی په منځ کې به دا ځمکه په اوو برخو ووېشل شي. د یهودا قبیله به په خپله سیمه یعنې په جنوب کې پاتې شي او د یوسف اولاده به په خپله سیمه یعنې شمال کې پاتې شي."}, {"ref": "None Joshua 1:5", "text": "صقلغ، بیت مرکبوت، حزر سوسه،"}, {"ref": "None Joshua 1:6", "text": "جبعونیانو یوشع ته هغه کمپ ته چې په جلجال کې ؤ دا پیغام ولېږه: «د خپلو خدمتګارانو څخه لاس مه اخله. همدا اوس راشه او زمونږ سره مرسته وکړه او مونږ وژغوره! ځکه چې د غرنۍ سیمې د اموریانو ټولو پاچاهانو زمونږ په ضد ځواکونه سره یوځای کړي دي او په مونږ باندې یې حمله کړې ده.»"}, {"ref": "None Joshua 1:6", "text": "څښتن یوشع ته وویل: «د هغوی څخه مه وېرېږه، ځکه چې زه څښتن به هغوی ټول ووژنم. سبا دا وخت به هغوی ټول مړه وي. له جګړې څخه وروسته د هغوی اسونه ګوډ کړئ او جنګي ګاډۍ یې وسوځوئ.»"}, {"ref": "None Joshua 1:6", "text": "موسی او د اسراییلو قوم دغو دوو پاچاهانو ته ماتې ورکړه. د څښتن خدمتګار موسی د هغوی خاوره د روبین او جاد قبیلو ته او د منسي نیمې قبیلې ته د هغوی د ملکیت په توګه ورکړه."}, {"ref": "None Joshua 1:6", "text": "په دې کې د صیدونیانو چې د لبنان د غرونو او د مسرفوت مایم ترمنځ په غرنۍ سیمه کې اوسیږي، ټوله سیمه شامله ده. زه به په خپله د اسراییلو له مخې څخه دا خلک لېرې کړم. څنګه چې ما په تا باندې حکم کړی دی، ته باید دا ځمکه د اسراییلیانو په منځ کې ووېشې."}, {"ref": "None Joshua 1:6", "text": "یوه ورځ د یهودا د قبیلې یو څو کسان په جلجال کې یوشع ته راغلل. د هغوی څخه یو کس کالیب د قنزي یفنه زوی هغه ته وویل: «ایا ستا په یاد دي چې څښتن خپل نبي موسی ته په قادش برنیع کې زما او ستا په هکله څه وویل؟"}, {"ref": "None Joshua 1:6", "text": "او هغه تر بیت حجله پورې غزېدلې ده، د بیت عربه شمال خواته تللې او د هغه ځای څخه د بوهن ګټ ته راوتلې ده. (بوهن د روبین زوی ؤ.)"}, {"ref": "None Joshua 1:6", "text": "او د مدیترانې بحیرې ته تللی دی. د مکمیته څخه چې په شمال کې ؤ، ختیځ خواته تعنت شیلوه ته راګرځېدلی او د هغه ځای په ختیځ کې تېر شوی او یانواح ته تللی دی."}, {"ref": "None Joshua 1:6", "text": "وروسته له هغې چې تاسو د ځمکې د اوو برخو تشریح ولیکئ، ماته یې دلته راوړئ او زه به د خپل څښتن خدای په حضور کې ستاسو دپاره پچه واچوم."}, {"ref": "None Joshua 1:6", "text": "بیت لباعوت او شاروحن - د شاوخوا کلیو سره دیارلس ښارګوټي."}, {"ref": "None Joshua 1:7", "text": "نو یوشع د خپل ټول لښکر سره چې د هغه تر ټولو ښه جنګیالي په کې شامل وو د جلجال څخه روان شو."}, {"ref": "None Joshua 1:7", "text": "نو یوشع او د هغه ټول لښکر په هغوی باندې د میروم د خوړ تر څنګ ناڅاپه حمله وکړه."}, {"ref": "None Joshua 1:7", "text": "یوشع او د اسراییلو قوم هغو پاچاهانو ته چې د اردن د سیند په لوېدیځه خوا کې وو ماتې ورکړه، یعنې د بعل جاد څخه چې د لبنان په دره کې پروت ؤ د حالق تر غره پورې چې په جنوب کې ادوم ته نژدې ؤ. یوشع هغه ځمکه د اسراییلو د قبیلو ترمنځ ووېشله او د ملکیت په توګه یې هغوی ته ورکړه."}, {"ref": "None Joshua 1:7", "text": "بیا دا ځمکه په هغو نهو قبیلو او د منسي په نیمې قبیلې ووېشه چې تر اوسه پورې ځمکه نه لري چې د هغوی ملکیت شي.»"}, {"ref": "None Joshua 1:7", "text": "زه څلوېښت کلن وم کله چې د څښتن خدمتګار موسی زه د جاسوسۍ دپاره د قادش برنیع څخه د کنعان هېواد ته ولېږلم. نو څه چې ما لیدلي وو د هغو په اړه مې هغه ته حقیقت ووایه."}, {"ref": "None Joshua 1:7", "text": "او دا پوله بیا د مصیبت له درې څخه پورته دبیر ته راوتلې او د شمال خواته د جلجال په لوري چې د درې په جنوب کې د ادومیم غاښي ته مخامخ ده، ګرځېدلې ده. بیا هغه د عین شمس د چینو خواته تللې او په عین روجل کې راوتلې ده."}, {"ref": "None Joshua 1:7", "text": "بیا دا سرحد د یانواح څخه عطاروت او نعره ته راښکته شوی، د اریحا سره نښتی او د اردن سیند ته راوتلی دی."}, {"ref": "None Joshua 1:7", "text": "د منسي سیمه د اشیر څخه تر مکمیته پورې رسېدله. مکمیته د شکیم په ختیځ کې وه او سرحد یې بیا جنوب خواته هغه ځای ته چې د عین تفوح خلک په کې اوسېدل، رسېدلې ده."}, {"ref": "None Joshua 1:7", "text": "خو بیاهم لاویان به ستاسو د پاتې خلکو سره د ځمکې برخه تر لاسه نه کړي، ځکه چې د هغوی برخه څښتن ته د کاهنانو په توګه خدمت کول دي. بې له شکه د جاد، روبین او د ختیځې منسي قبیلو لا مخکې د اردن د سیند په ختیځ کې خپله ځمکه تر لاسه کړې ده، هغه ځمکه د څښتن خدمتګار یعنې موسی هغوی ته ورکړې ده.»"}, {"ref": "None Joshua 1:7", "text": "عین، رمون، عاتر او عاشان - د شاوخوا کلیو سره څلور ښارګوټي."}, {"ref": "None Joshua 1:8", "text": "څښتن یوشع ته وویل: «د هغوی څخه مه وېرېږه. هغوی به تاته په لاس درکړم. د هغوی څخه به یو تن هم ونه شي کولای چې ستا په وړاندې ودریږي.»"}, {"ref": "None Joshua 1:8", "text": "څښتن اسراییلیان په هغوی باندې بریالي کړل. اسراییلیانو په هغوی باندې حمله وکړه او په شمال کې یې تر مسرفوت مایم او لوی صیدون او په ختیځ کې د مصفه تر درې پورې تعقیب کړل. جګړه تر هغه وخته پورې روانه وه، ترڅو چې د دښمن له خوا هېڅوک ژوندی پاتې نه شو."}, {"ref": "None Joshua 1:8", "text": "کومه ځمکه چې یوشع د هغوی په منځ کې ووېشله په هغې کې دا ځایونه شامل وو: غرنۍ سیمه، د غرونو لوېدیځې لمنې، د اردن دره، د غرونو ختیځ اړخونه او د کنعان جنوبي دښته. دا ځمکه د حیتیانو، اموریانو، کنعانیانو، فرزیانو، حویانو او یبوسیانو وطن ؤ."}, {"ref": "None Joshua 1:8", "text": "موسی لا پخوا د روبین او جاد قبیلو او د منسي بلې نیمې قبیلې ته هغه ځمکه ورکړې وه چې د اردن د سیند په ختیځه غاړه باندې پرته وه."}, {"ref": "None Joshua 1:8", "text": "خو زما سره چې کوم کسان تللي وو، هغوی زمونږ خلک دې خاورې ته د تللو څخه ووېرول. خو ما په وفادارۍ سره د خپل څښتن خدای مقصد سرته ورساوه."}, {"ref": "None Joshua 1:8", "text": "بیا دا پوله د غونډۍ جنوب خواته د هنوم د زوی د درې په لاره تېره شوې ده چېرته چې د یبوسیانو ښار یعنې اورشلیم پروت ؤ. دا پوله بیا د هغې غونډۍ سرته رسیږي چې د هنوم د درې په لوېدیځه خوا کې وه چې د رفاییم د درې شمالي برخه وه."}, {"ref": "None Joshua 1:8", "text": "د تفوح څخه دا سرحد لوېدیځ خواته د قانه خوړ ته تللی او د مدیترانې په بحیره کې ختم شوی دی. دا هغه ځمکه وه چې د ملکیت په توګه د افرایم قبیلې ته طایفه په طایفه ورکړل شوه."}, {"ref": "None Joshua 1:8", "text": "د تفوح ښارګوټی د منسي او افرایم د سیمو ترمنځ په سرحد کې پروت ؤ. په خپله ښار د افرایم د قبیلې ؤ، خو د هغه شاوخوا ځمکه د منسي د قبیلې وه."}, {"ref": "None Joshua 1:8", "text": "څنګه چې هغه کسان د هغې ځمکې د نقشې اخیستلو دپاره روان شول، نو یوشع هغوی ته وویل: «لاړ شئ او د ټولې خاورې اندازه واخلئ او د هغه بیان ولیکئ. بیا ماته راشئ او زه به دلته په شیلوه کې د څښتن په حضور کې ستاسو دپاره پچه واچوم.»"}, {"ref": "None Joshua 1:8", "text": "په دې سیمه کې په جنوب کې تر بعلت بییر (جنوبي رامه) پورې ټول ښارګوټي او کلي شامل وو. دا هغه ځمکه وه چې د شمعون د قبیلې طایفو د خپل ملکیت په توګه تر لاسه کړه."}, {"ref": "None Joshua 1:9", "text": "یوشع او د هغه لښکر ټوله شپه د جلجال څخه د جبعون پورې مزل وکړ او په اموریانو باندې یې ناڅاپي حمله وکړه."}, {"ref": "None Joshua 1:9", "text": "یوشع د هغوی سره هماغه شان کار وکړ څنګه چې څښتن هغه ته حکم کړی ؤ. هغه د هغوی اسونه ګوډ کړل او د هغوی جنګي ګاډۍ یې وسوځولې."}, {"ref": "None Joshua 1:9", "text": "د اسراییلو قوم د لاندېنیو ښارونو پاچاهانو ته ماتې ورکړه: اریحا، عای (بیت ییل ته نژدې)،"}, {"ref": "None Joshua 1:9", "text": "دا سیمه د هغه ښار څخه چې د ارنون د درې په منځ کې ؤ او په هغې کې د عروعیر ښار چې د هغې درې په شمالي څنډه کې ؤ شامل ؤ، شمال خواته غزېدلې ده. په هغې کې د دیبون په شمال کې د میدیبا لوړه جلګه شامله وه."}, {"ref": "None Joshua 1:9", "text": "په هماغه ورځ زه بېرته راغلم او موسی راته وویل: ‹څرنګه چې ته څښتن خدای ته وفادار وې، نو زه وعده کوم چې په کومه خاوره کې چې ته ګرځېدلی یې، هغه به د تل دپاره ستا او ستا د اولادې شي.›"}, {"ref": "None Joshua 1:9", "text": "د هغه ځای څخه دا پوله د نفتوح چینې او بیا هغو ښارګوټو ته تللې ده چې د عفرون غر ته نژدې وو. دا پوله هلته د بعله خواته ګرځېدلې ده چې اوس د قریت یعاریم په نوم یادیږي،"}, {"ref": "None Joshua 1:9", "text": "په دې کې ځینې ښارګوټي او کلي هم شامل وو چې د منسي د قبیلې په خاوره کې وو، خو هغه افرایم ته ورکړل شول."}, {"ref": "None Joshua 1:9", "text": "دا سرحد بیا ښکته د قانه خوړ ته تللی دی. کوم ښارګوټي چې د خوړ په جنوب کې وو هغه د افرایم شول، که څه هم هغه د منسي په سیمه کې وو. د منسي سرحد د خوړ په شمالي خوا باندې تېر شوی او د مدیترانې په بحیره کې ختم شوی دی."}, {"ref": "None Joshua 1:9", "text": "هغه کسان لاړل او په ټول هېواد کې وګرځېدل او دا یې ولیکل چې هغوی څنګه هغه ځمکه په اوو برخو ووېشله او د ښارګوټو لست یې جوړ کړ. بیا هغوی بېرته یوشع ته چې د شیلوه په کمپ کې ؤ راستانه شول."}, {"ref": "None Joshua 1:9", "text": "څرنګه چې د یهودا برخه د هغوی د اړتیا له اندازې څخه زیاته وه، نو د هغه د سیمې یوه برخه د شمعون قبیلې ته ورکړل شوه."}, {"ref": "None Joshua 1:10", "text": "څښتن اموریان د اسراییلیانو په لیدلو سره ووېرول. اسراییلیانو هغوی په جبعون کې ووژل او پاتې یې په بیت حورون کې د غره د غاښي په ښکتنۍ لاره تعقیب کړل. هغوی تر هغه وخته پورې په اموریانو باندې خپلې حملې ته دوام ورکړ، ترڅو د عزیقه او مقیده ښارونو ته ورسېدل."}, {"ref": "None Joshua 1:10", "text": "یوشع بېرته راوګرځېد، هغه د حاصور ښار ونیوه او د هغه ځای پاچا یې وواژه. (په هغه وخت کې نورې پاچاهۍ چې پورته ورڅخه یادونه وشوه، د حاصور د پاچا تر واکمنۍ لاندې وې.)"}, {"ref": "None Joshua 1:10", "text": "اورشلیم، حبرون،"}, {"ref": "None Joshua 1:10", "text": "د هغوی سیمه د عمون تر پولې پورې رسېدله. همدارنګه په هغې کې هغه ټول ښارونه هم شامل وو چې د اموریانو پاچا سیحون به ورباندې د حشبون د ښار څخه حکومت کاوه."}, {"ref": "None Joshua 1:10", "text": "خو اوس ګوره، زه لا تر اوسه ژوندی یم او پنځه څلوېښت کاله مخکې څښتن موسی ته دا خبره کړې وه او په هغه وخت کې د اسراییلو خلک په دښته کې سرګردانه ګرځېدل. ګورئ، زه اوس پنځه اتیا کلن یم."}, {"ref": "None Joshua 1:10", "text": "چېرته چې دغه پوله د ادوم د غرنۍ سیمې په خوا کې د بعله د لوېدیځ څخه راچاپېره شوې ده. بیا هغه د یعاریم د غره شمالي خوا (کسالون) ته تللې، ښکته بیت شمس ته راوتلې او د تمنه څخه تېریږي."}, {"ref": "None Joshua 1:10", "text": "خو هغوی کنعانیان چې د جازر اوسېدونکي وو، ونه شړل. نو کنعانیان تر نن ورځې پورې د افرایمیانو په منځ کې اوسیږي، خو هغوی مجبور دي چې د غلامانو په توګه کار وکړي."}, {"ref": "None Joshua 1:10", "text": "افرایم په جنوب کې پروت ؤ او منسي په شمال کې. د مدیترانې بحیره د هغوی لوېدیځ سرحد ؤ. اشیر په شمال لوېدیځ کې پروت ؤ او یساکار په شمال ختیځ کې."}, {"ref": "None Joshua 1:10", "text": "بیا یوشع د هغوی دپاره په شیلوه کې د څښتن په حضور کې پچه واچوله او د اسراییلو هرې پاتې قبیلې ته یې د ځمکې یوه ټاکلې برخه ورکړه."}, {"ref": "None Joshua 1:10", "text": "درېمه پچه د زبولون د قبیلې د طایفو په نوم ووتله. هغه ځمکه چې هغوی تر لاسه کړه د سارید پورې رسېدله."}, {"ref": "None Joshua 1:11", "text": "کله چې اموریان د اسراییلو د لښکرو څخه ښکته د غاښي په لاره باندې تښتېدل، څښتن په هغوی باندې تر عزیقه پورې غټې غټې ږلۍ واورولې. د هغو خلکو شمېر چې په ږلیو مړه شول د هغو خلکو څخه زیات وو چې د اسراییلیانو له خوا ووژل شول."}, {"ref": "None Joshua 1:11", "text": "هغوی هلته ټول خلک ووژل. هېڅوک ژوندی پاتې نه شو او ښار یې وسوځاوه."}, {"ref": "None Joshua 1:11", "text": "یرموت، لاخیش،"}, {"ref": "None Joshua 1:11", "text": "په هغې کې جلعاد، د جشور او معکې سیمې، د حرمون ټول غر او ټول باشان تر سلخه پورې شامل وو."}, {"ref": "None Joshua 1:11", "text": "زه نن هم د هماغه وخت په شان چې موسی ولېږلم قوي یم. کوم قوت چې ما په هغه وخت کې درلود، اوس یې هم لرم او د جګړې او نورو کارونو دپاره تیار یم."}, {"ref": "None Joshua 1:11", "text": "بیا دا پوله هغې غونډۍ ته وتلې ده چې د عقرون په شمال کې ده. بیا د شکرون خواته ګرځېدلې، د بعله د غره څخه تېره شوې او یبییل ته راوتلې ده. دا پوله د مدیترانې په بحیره کې ختمه شوې ده"}, {"ref": "None Joshua 1:11", "text": "د یساکار او اشیر په سیمو کې منسي بیت شان او یبلعام د هغو د شاوخوا کلیو سره او همدارنګه دور (هغه دور چې په غونډیو باندې ؤ)، عین دور، تعنک، مجدو او د هغو شاوخوا کلي تر لاسه کړل."}, {"ref": "None Joshua 1:11", "text": "لومړنۍ قبیله چې د پچې له مخې یې ځمکه تر لاسه کړه هغه د بنیامین قبیله وه. د هغوی د طایفو ځمکه د یهودا او یوسف د قبیلو ترمنځ پرته وه."}, {"ref": "None Joshua 1:11", "text": "دا سرحد د هغه ځای څخه په لوېدیځه خوا کې مرعله ته تللی او د دباشه پورې رسېدلی او یقنعام ته نژدې ویالې ته تللی دی."}, {"ref": "None Joshua 1:12", "text": "په هغه ورځ چې څښتن اسراییلیانو ته په اموریانو باندې بری ورکړ، یوشع څښتن ته دعا وکړه. هغه د اسراییلیانو په مخکې وویل: ای لمره، ودرېږه د جبعون په سر باندې ای سپوږمۍ، ودرېږه د ایالون په دره باندې"}, {"ref": "None Joshua 1:12", "text": "یوشع هغه ټول ښارونه د هغو د پاچاهانو سره ونیول او ټول یې ووژل. لکه څنګه چې د څښتن خدمتګار موسی امر کړی ؤ، یوشع هغوی په پوره توګه له منځه یووړل."}, {"ref": "None Joshua 1:12", "text": "عجلون، جازر،"}, {"ref": "None Joshua 1:12", "text": "په هغې کې د عوج پاچاهي شامله وه. عوج د رفاییانو د جملې څخه یوازېنی کس ؤ چې ژوندی پاتې شوی ؤ او په عشتاروت او ادرعي کې یې پاچاهي کوله. موسی دې خلکو ته ماتې ورکړې وه او هغوی یې شړلي وو."}, {"ref": "None Joshua 1:12", "text": "اوس دغه غرنۍ سیمه چې په هغه ورځ څښتن زما سره د هغې وعده کړې وه ماته راکړه. تا په خپله په هغه ورځ واورېدل چې لوړ قدي عناقیان هلته اوسیږي او د هغوی ښارونه لوی دي او دېوالونه لري، خو لکه څنګه چې څښتن ویلي دي هغه به زما سره مرسته وکړي چې هغوی وشړم.»"}, {"ref": "None Joshua 1:12", "text": "او هلته یې لوېدیځه پوله جوړه کړې ده. د یهودا خلک په دې سرحدونو کې اوسېدل."}, {"ref": "None Joshua 1:12", "text": "بیاهم منسیانو نه شو کولای هغه کنعانیان وشړي چې په دې ښارګوټو کې اوسېدل، نو هغوی هلته اوسېدلو ته دوام ورکړ."}, {"ref": "None Joshua 1:12", "text": "په شمال کې د هغوی سرحد د اردن د سیند څخه پیل شوی دی او بیا د اریحا په شمالي مخ ځوړي باندې پورته تللی او په لوېدیځ کې د غرنۍ سیمې په لاره بیت آون ته نژدې دښتې ته رسېدلی دی."}, {"ref": "None Joshua 1:12", "text": "دا سرحد د سارید ختیځې خواته د کسلوت تابور د سیمې پولې ته ګرځېدلی او دابره ته راوتلی او پورته تر یافیع پورې رسېدلی دی."}, {"ref": "None Joshua 1:13", "text": "نو لمر او سپوږمۍ تر هغه وخته پورې ودرېدل، ترڅو چې قوم په خپلو دښمنانو باندې بری وموند. دا پېښه د یاشر په کتاب کې لیکل شوې ده. لمر د اسمان په منځ کې ودرېده او ټوله ورځ ونه لوېد."}, {"ref": "None Joshua 1:13", "text": "خو بیاهم، اسراییلیانو د هغو ښارونو څخه چې په غونډیو باندې ودان شوي وو هېڅ کوم ښار ونه سوځاوه، پرته له حاصور څخه چې یوشع هغه وسوځاوه."}, {"ref": "None Joshua 1:13", "text": "دبیر، جدر،"}, {"ref": "None Joshua 1:13", "text": "خو بیاهم اسراییلیانو جشوریان او معکیان ونه شړل، نو هغوی تر نن ورځې پورې د اسراییلیانو په منځ کې اوسیږي."}, {"ref": "None Joshua 1:13", "text": "بیا یوشع کالیب ته برکت ورکړ او هغه ته یې د حبرون ښار د هغه د ملکیت په توګه ورکړ."}, {"ref": "None Joshua 1:13", "text": "څنګه چې څښتن یوشع ته حکم کړی ؤ، د یهودا د سیمې یوه برخه د یفنه زوی کالیب ته چې د یهودا د قبیلې څخه ؤ ورکړل شوه. هغه قریت اربع یعنې د حبرون ښار چې د عناق د نیکه یعنې اربع پورې یې اړه درلودله تر لاسه کړ."}, {"ref": "None Joshua 1:13", "text": "که څه هم کله چې اسراییلیان نور هم قوي شول، کنعانیان یې په سخت کار کولو باندې مجبور کړل، خو بیخي یې ونه شړل."}, {"ref": "None Joshua 1:13", "text": "بیا دا سرحد هغه مخ ځوړي ته چې د لوز (چې بیت ییل هم بلل کیږي) جنوب خواته دی تللی دی. بیا هغه عطاروت ادار ته چې د ښکتني بیت حورون په جنوب کې په غره باندې ؤ، رسېدلی دی."}, {"ref": "None Joshua 1:13", "text": "بیا دا سرحد د ختیځ خواته د جت حافر او عت قاصین ته تللی، رمون ته راوتلی او د نیعه خواته ګرځېدلی دی."}, {"ref": "None Joshua 1:14", "text": "داسې ورځ هېڅکله نه ده راغلې او نه به راشي چې خدای لمر او سپوږمۍ د یو انسان د دعا په خاطر ودروي. څښتن په رښتیا سره د اسراییلو په خاطر جنګېده!"}, {"ref": "None Joshua 1:14", "text": "د اسراییلو خلکو د دې ښارونو څخه ټول قیمتي شیان او څاروي یووړل او د ځانونو دپاره یې وساتل. خو هغوی ټول خلک ووژل، هېڅوک هم ژوندی پاتې نه شو."}, {"ref": "None Joshua 1:14", "text": "حرما، عراد،"}, {"ref": "None Joshua 1:14", "text": "موسی د لاوي قبیلې ته هېڅ ځمکه نه وه ورکړې، ځکه چې د اسراییلو څښتن خدای هغوی ته ویلي وو: «تاسو به د ځمکې په ځای هغه قربانۍ تر لاسه کوئ چې زما د قربانۍ په ځای باندې سوځول کیږي.»"}, {"ref": "None Joshua 1:14", "text": "نو حبرون تر اوسه پورې د کالیب د اولادې ملکیت دی، ځکه چې هغه په وفادارۍ سره د اسراییلو د څښتن خدای اطاعت کړی ؤ."}, {"ref": "None Joshua 1:14", "text": "کالیب د عناق اولاده یعنې د شیشای، اخیمان او تلمای طایفې د ښار څخه وشړلې."}, {"ref": "None Joshua 1:14", "text": "یوه ورځ د یوسف اولاده یوشع ته ورغله او پوښتنه یې ترې وکړه: «تا ولې مونږ ته د دې ځمکې څخه یوازې یوه برخه راکړې ده؟ څښتن مونږ ته تل برکت راکړی دی، په دې خاطر زمونږ خلک ډېر زیات دي.»"}, {"ref": "None Joshua 1:14", "text": "بیا دا سرحد بلې خواته تللی، د دې غره د لوېدیځې خوا څخه جنوب ته ګرځېدلی او قریت بعل (قریت یعاریم) ته وتلی دی. هغه ځای د یهودا د قبیلې دی. دا لوېدیځ سرحد ؤ."}, {"ref": "None Joshua 1:14", "text": "په شمال کې دا سرحد د حناتون خواته ګرځېدلی او د یفتح ییل په دره کې ختم شوی دی."}, {"ref": "None Joshua 1:15", "text": "د جګړې څخه وروسته یوشع او د هغه لښکر بېرته خپل کمپ ته جلجال ته ستانه شول."}, {"ref": "None Joshua 1:15", "text": "څښتن خپل خدمتګار موسی ته حکمونه ورکړي وو، موسی هغه یوشع ته ورکړل او یوشع هغه سرته ورسول. یوشع هغه ټول کارونه تر سره کړل چې څښتن په موسی باندې د هغو حکم کړی ؤ."}, {"ref": "None Joshua 1:15", "text": "لبنه، عدولام،"}, {"ref": "None Joshua 1:15", "text": "موسی د روبین په قبیله کې هرې یوې طایفې ته ځمکه ورکړه."}, {"ref": "None Joshua 1:15", "text": "له دې څخه مخکې حبرون د قریت اربع په نوم یادېده. اربع د عناقیانو په منځ کې یو لوی اتل ؤ. نو بیا په هېواد کې ارامي شوه."}, {"ref": "None Joshua 1:15", "text": "کالیب د هغه ځای څخه د دبیر په اوسېدونکو باندې د حملې دپاره لاړ. (دا ښار مخکې د قریت سفر په نوم یادېده.)"}, {"ref": "None Joshua 1:15", "text": "یوشع په ځواب کې وویل: «که چېرې تاسو ډېر یئ او د افرایم غرنۍ سیمه ستاسو دپاره ډېره کمه وي، بیا پورته ځنګلونو ته لاړ شئ او د فرزیانو او رفاییانو په ځمکه کې د ځانونو دپاره ځمکه د ونو څخه پاکه کړئ.»"}, {"ref": "None Joshua 1:15", "text": "جنوبي سرحد د قریت یعاریم د غاړې څخه شروع شوی او د نفتوح چینو ته رسېدلی دی."}, {"ref": "None Joshua 1:15", "text": "زبولون د شاوخوا کلیو سره دولس ښارګوټي درلودل. د هغو څخه ځینې یې دا وو: قطه، نهلال، شمرون، یداله او بیت لحم."}, {"ref": "None Joshua 1:16", "text": "د جګړې په وخت کې هغه پنځه اموریایي پاچاهان تښتېدلي وو او ځانونه یې په مقیده کې په سمڅه کې پټ کړي وو."}, {"ref": "None Joshua 1:16", "text": "نو یوشع دغه ټوله خاوره ونیوله: غرنۍ سیمه، د غرونو لوېدیځې لمنې، شمال او جنوب دواړه، د جوشن ټوله سیمه، ټوله جنوبي دښته او د اردن دره."}, {"ref": "None Joshua 1:16", "text": "مقیده، بیت ییل،"}, {"ref": "None Joshua 1:16", "text": "د هغوی ځمکه په جنوب کې په هغه ښارګوټي کې شروع کېدله چې د ارنون د درې په منځ کې ؤ. په هغې کې د عروعیر ښارګوټی چې د درې په شمالي څنډه کې ؤ، شامل ؤ او په شمال کې د میدیبا د شاوخوا لوړې جلګې پورې رسېدله."}, {"ref": "None Joshua 1:16", "text": "کالیب وویل: «هرچا چې قریت سفر فتح کړ، زه به خپله لور عکسه هغه ته په نکاح ورکړم.»"}, {"ref": "None Joshua 1:16", "text": "د یوسف اولادې په ځواب کې وویل: «زمونږ دپاره غرنۍ سیمه بس نه ده. برسېره پردې، ټول کنعانیان چې په ډاګونو کې یعنې هغوی چې په بیت شان او د هغه ځای په شاوخوا کلیو کې اوسیږي او هغه کنعانیان چې د یزرعیل په دره کې اوسیږي، هغوی ټول د اوسپنې جنګي ګاډۍ لري.»"}, {"ref": "None Joshua 1:16", "text": "بیا دا سرحد د غره بېخ ته چې د هنوم د زوی درې ته مخامخ دی او د رفاییم د درې په شمال کې دی ښکته شوی دی. د هغه ځای څخه جنوب خواته د هنوم د درې له لارې هغې غونډۍ ته چې د اورشلیم په جنوب کې ده تللی او بیا عین روجل ته رسېدلی دی."}, {"ref": "None Joshua 1:16", "text": "دا ښارګوټي او د هغو کلي په هغې ځمکه کې وو چې د زبولون د قبیلې طایفو د خپل ملکیت په توګه تر لاسه کړه."}, {"ref": "None Joshua 1:17", "text": "یو چا هغوی پیدا کړل او یوشع خبر شو چې هغوی د مقیدې په سمڅه کې پټ شوي وو."}, {"ref": "None Joshua 1:17", "text": "تفوح، حافر،"}, {"ref": "None Joshua 1:17", "text": "په دې کې حشبون او کوم ښارګوټي چې په لوړې جلګې باندې پراته وو یعنې دیبون، باموت بعل، بیت بعل معون،"}, {"ref": "None Joshua 1:17", "text": "عتني ییل د کالیب د ورور قناز زوی هغه ښار ونیوه، نو کالیب خپله لور هغه ته په نکاح ورکړه."}, {"ref": "None Joshua 1:17", "text": "یوشع د افرایم او د لوېدیځې منسي قبیلو ته وویل: «تاسو په رښتیا سره زیات او ډېر قوي یئ. تاسو ته به د یوې برخې څخه زیاته سیمه درکړل شي."}, {"ref": "None Joshua 1:17", "text": "بیا د شمال خواته عین شمس ته ګرځېدلی او بیا د جلیلوت خواته چې د ادومیم غاښي ته مخامخ ؤ، وتلی دی. دا سرحد بیا د بوهن ګټ ته ښکته شوی دی (بوهن د روبین زوی ؤ)"}, {"ref": "None Joshua 1:17", "text": "څلورمه پچه د یساکار د قبیلې د طایفو په نوم ووتله."}, {"ref": "None Joshua 1:18", "text": "یوشع خپلو کسانو ته وویل: «د سمڅې خولې ته یو څو غټې تیږې ورغړوئ او هلته یو څو ساتونکي ودروئ،"}, {"ref": "None Joshua 1:18", "text": "عفیق، لشارون،"}, {"ref": "None Joshua 1:18", "text": "یاهص، قدیموت، میفاعت،"}, {"ref": "None Joshua 1:18", "text": "د واده په ورځ عتني ییل هغه وهڅوله چې د خپل پلار څخه یو پټی وغواړي. عکسه د خپل خره څخه ښکته شوه او کالیب د هغې څخه پوښتنه وکړه: «څه غواړې؟»"}, {"ref": "None Joshua 1:18", "text": "غرنۍ سیمه به ستاسو شي. خو هغه ځمکه یو ځنګل دی، تاسو باید ونې ووهئ او ځمکه یې پاکه کړئ او هغه په پوره توګه ونیسئ. که څه هم کنعانیان قوي دي او د اوسپنې جنګي ګاډۍ لري، خو تاسو به وکولای شئ چې هغوی وشړئ.»"}, {"ref": "None Joshua 1:18", "text": "او د هغې غونډۍ شمال خواته تېر شوی چې د اردن دره ورڅخه ښکاري. بیا دا سرحد درې ته ښکته شوی دی،"}, {"ref": "None Joshua 1:18", "text": "د هغوی په سیمه کې دا ځایونه شامل وو: یزرعیل، کسلوت، شونم،"}, {"ref": "None Joshua 1:19", "text": "خو تاسو په خپله هلته مه پاتې کېږئ. د دښمن پسې شئ او د شا له خوا ورباندې حمله وکړئ. هغوی مه پرېږدئ چې خپلو ښارونو ته ورورسیږي! ځکه چې زمونږ څښتن خدای مونږ په هغوی باندې بریالي کړي یو.»"}, {"ref": "None Joshua 1:19", "text": "مادون، حاصور،"}, {"ref": "None Joshua 1:19", "text": "قریتایم، سبمه، سارت شحر چې په دره کې په غونډۍ باندې ؤ،"}, {"ref": "None Joshua 1:19", "text": "هغې په ځواب کې وویل: «زه د اوبو یو څو چینې غواړم. هغه ځمکه چې تا راته راکړې ده هغه په جنوبي دښته کې ده.» نو کالیب هغې ته پورتنۍ او ښکتنۍ چینې ورکړې."}, {"ref": "None Joshua 1:19", "text": "د هغه ځای څخه د بیت حجلې د غونډۍ د شمالي خوا څخه تېر شوی او د مړې بحیرې په شمال کې چې د اردن سیند ورسره یوځای کیږي ختم شوی دی. دا جنوبي سرحد ؤ."}, {"ref": "None Joshua 1:19", "text": "حفارایم، شییون، اناحره،"}, {"ref": "None Joshua 1:20", "text": "نو یوشع او اسراییلیانو د دښمن عسکر نژدې ټول له منځه یووړل. خو یوازې یو څو کسان چې پاتې شوي وو هغوی خپلو دېوال لرونکو ښارونو ته ورورسېدل."}, {"ref": "None Joshua 1:20", "text": "شمرون مرون، اخشاف،"}, {"ref": "None Joshua 1:20", "text": "بیت فغور، د پیسګاه د غره ډډې او بیت یشیموت ټول شامل وو."}, {"ref": "None Joshua 1:20", "text": "دا هغه ځمکه ده چې د یهودا د قبیلې طایفو د خپل ملکیت په توګه تر لاسه کړه:"}, {"ref": "None Joshua 1:20", "text": "د اردن سیند ختیځ سرحد ؤ. دا د هغې خاورې سرحدونه وو چې د بنیامین د قبیلې طایفو د خپل ملکیت په توګه تر لاسه کړې وه."}, {"ref": "None Joshua 1:20", "text": "ربیت، قشیون، آبص،"}, {"ref": "None Joshua 1:21", "text": "بیا ټول لښکر یوشع ته هغه کمپ ته چې په مقیده کې ؤ روغ راستون شو. له دې وروسته هېچا جرات نه شو کولای چې د اسراییلیانو په هکله کومه بده خبره وکړي."}, {"ref": "None Joshua 1:21", "text": "په هغه وخت کې یوشع عناقیان چې لوړ قدونه یې درلودل او په حبرون، دبیر، عناب او د یهودا او اسراییلو په پاتې ټولو غرنیو سیمو کې اوسېدل هم له منځه یووړل. یوشع هغوی د خپلو ښارونو سره بیخي له منځه یووړل."}, {"ref": "None Joshua 1:21", "text": "تعنک، مجدو،"}, {"ref": "None Joshua 1:21", "text": "هغه ټول ښارګوټي چې په لوړې جلګې باندې پراته وو او د سیحون ټوله پاچاهي (سیحون د اموریانو پاچا ؤ او په حشبون کې یې حکومت کاوه) شامل وو. موسی سیحون او د مدیانیانو مشرانو یعنې اوي، راقم، صور، حور او رابع ته ماتې ورکړې وه. دا مشران چې په هغه هېواد کې اوسېدل، د سیحون سره ملګري شول."}, {"ref": "None Joshua 1:21", "text": "هغه لېرې جنوبي ښارګوټي چې د هغوی پورې یې اړه درلودله، یعنې هغه ښارګوټي چې د ادوم پولې ته نژدې وو دا وو: قبصییل، عیدر، یاجور،"}, {"ref": "None Joshua 1:21", "text": "د بنیامین د قبیلې د طایفو ښارګوټي دا وو: اریحا، بیت حجله، عمیق قصیص،"}, {"ref": "None Joshua 1:21", "text": "رمه، عین جنیم، عین حده او بیت فسیس."}, {"ref": "None Joshua 1:22", "text": "بیا یوشع وویل: «د سمڅې خوله خلاصه کړئ او هغه پنځه پاچاهان ماته راوباسئ.»"}, {"ref": "None Joshua 1:22", "text": "د عناقیانو څخه هېڅوک د اسراییلیانو په خاوره کې پاتې نه شو، یوازې په غزه، جت او اشدود کې ځینې خلک ژوندي پاتې شول."}, {"ref": "None Joshua 1:22", "text": "قادش، یقنعام (په کرمل کې)،"}, {"ref": "None Joshua 1:22", "text": "په هغو خلکو کې چې د اسراییلیانو له خوا وژل شوي وو، بلعام د بعور زوی چې فال کتونکی ؤ هم شامل ؤ."}, {"ref": "None Joshua 1:22", "text": "قینه، دیمونه، عدعده،"}, {"ref": "None Joshua 1:22", "text": "بیت عربه، صمارایم، بیت ییل،"}, {"ref": "None Joshua 1:22", "text": "او دا سرحد د تابور غره، شحصیمه او بیت شمس ته رسېدلی او د اردن د سیند سره ختم شوی دی. په هغه کې شپاړس ښارګوټي د هغو د شاوخوا کلیو سره شامل وو."}, {"ref": "None Joshua 1:23", "text": "نو هغوی هغه پنځه پاچاهان یعنې د اورشلیم، حبرون، یرموت، لاخیش او د عجلون پاچاهان د سمڅې څخه راوویستل."}, {"ref": "None Joshua 1:23", "text": "څنګه چې څښتن موسی ته لارښوونه کړې وه، یوشع ټوله خاوره ونیوله او هغه یې اسراییلیانو ته د هغوی د خپل ملکیت په توګه ورکړه. هغه یې په څو برخو ووېشله، هرې قبیلې ته یوه برخه ورسېدله. په پای کې په هغه هېواد کې ارامي شوه."}, {"ref": "None Joshua 1:23", "text": "دور (د دور په لوړو سیمو)، قوییم (په جلیل کې)"}, {"ref": "None Joshua 1:23", "text": "دا سیمه او د هغې ښارونه او کلي د روبین قبیلې ته د هغوی د ملکیت په توګه ورکړل شول او د اردن سیند د هغې لوېدیځه پوله وه."}, {"ref": "None Joshua 1:23", "text": "قادش، حاصور، یتنان،"}, {"ref": "None Joshua 1:23", "text": "عویم، فاره، عفره،"}, {"ref": "None Joshua 1:23", "text": "دا ښارګوټي او د هغو کلي په هغې ځمکه کې وو چې د یساکار د قبیلې طایفو د خپل ملکیت په توګه تر لاسه کړه."}, {"ref": "None Joshua 1:24", "text": "کله چې هغوی دا پاچاهان یوشع ته راوستل، هغه د اسراییلو ټول خلک راوغوښتل او د لښکرو قوماندانانو ته یې چې د هغه سره راغلي وو امر وکړ چې راشي او د دې پاچاهانو په ورمېږونو باندې خپلې پښې کېږدي. نو هغوی همداسې وکړل."}, {"ref": "None Joshua 1:24", "text": "او ترزه. د ټولو پاچاهانو شمېر یو دېرشو ته رسېده."}, {"ref": "None Joshua 1:24", "text": "همدارنګه موسی د جاد په قبیله کې هرې یوې طایفې ته ځمکه ورکړه."}, {"ref": "None Joshua 1:24", "text": "زیف، طالم، بعلوت،"}, {"ref": "None Joshua 1:24", "text": "کفرعموني، عفني او جابع د شاوخوا کلیو سره دولس ښارګوټي."}, {"ref": "None Joshua 1:24", "text": "پنځمه پچه د اشیر د قبیلې د طایفو په نوم ووتله."}, {"ref": "None Joshua 1:25", "text": "بیا یوشع خپلو قوماندانانو ته وویل: «مه وېرېږئ او زړونه مه بایلئ. قوي او زړور اوسئ، ځکه چې څښتن به ستاسو په ټولو دښمنانو باندې چې تاسو ورسره جنګ کوئ، همداسې کار وکړي.»"}, {"ref": "None Joshua 1:25", "text": "د هغوی په سیمه کې یعزیر، د جلعاد ټول ښارګوټي او د عمون نیمه ځمکه تر عروعیر پورې چې د ربه په ختیځ کې وه شامل وو."}, {"ref": "None Joshua 1:25", "text": "حاصور حدته، قریوت حزرون (حاصور)،"}, {"ref": "None Joshua 1:25", "text": "جبعون، رامه، بیروت،"}, {"ref": "None Joshua 1:25", "text": "د هغوی په سیمه کې دا ځایونه شامل وو: حلقات، حلي، باطن، اکشاف،"}, {"ref": "None Joshua 1:26", "text": "بیا یوشع هغه پنځه پاچاهان ووژل او هغوی یې په پنځو ونو کې ځوړند کړل او د هغوی مړي تر ماښامه پورې هلته پاتې شول."}, {"ref": "None Joshua 1:26", "text": "د هغوی ځمکه د حشبون څخه نیولې تر رامت مصفه او بطونیم پورې او د محنایم څخه نیولې د دبیر تر سیمې پورې غزېدلې وه."}, {"ref": "None Joshua 1:26", "text": "امام، شمع، مولاده،"}, {"ref": "None Joshua 1:26", "text": "مصفه، کفیره، موزا،"}, {"ref": "None Joshua 1:26", "text": "الملک، عمعاد او مشال. په لوېدیځ کې دا سرحد کرمل او شیحور لبنه ته رسېده."}, {"ref": "None Joshua 1:27", "text": "د لمرپرېواته په وخت کې یوشع امر وکړ او هغوی د هغو پاچاهانو مړي د ونو څخه راښکته کړل او په هغه سمڅه کې یې وغورځول چې هغوی مخکې په کې پټ شوي وو. هغوی د سمڅې په خوله کې لویې لویې تیږې کېښودلې او هغه تر نن ورځې پورې هلته دي."}, {"ref": "None Joshua 1:27", "text": "د اردن د درې په هغه سیمه کې چې جاد ته ورکړل شوې وه په هغې کې بیت هارام، بیت نمره، سوکوت او صافون یعنې د حشبون د پاچا سیحون پخوانۍ پاچاهي شامله وه. د هغوی لوېدیځه پوله د اردن سیند ؤ او هغه په شمال کې د جلیل تر بحیرې پورې رسېدله."}, {"ref": "None Joshua 1:27", "text": "حزر جده، حشمون، بیت فالط،"}, {"ref": "None Joshua 1:27", "text": "راقم، یرفییل، تراله،"}, {"ref": "None Joshua 1:27", "text": "بیا د هغه ځای څخه ختیځې خواته بیت داجون ته ګرځېدلی، د زبولون او د یفتح ییل تر درې پورې رسېدلی دی او په شمال کې بیت عامق او نعي ییل ته راوتلی دی. دا سرحد د شمال خواته د کابول،"}, {"ref": "None Joshua 1:28", "text": "په هماغه ورځ یوشع د مقیده په ښار باندې حمله وکړه او هغه یې ونیوه او د هغه پاچا یې وواژه. هغه د دې ښار ټول خلک ووژل. هېڅوک یې ژوندی پرېنښود. هغه د مقیده د پاچا سره هماغه شان چلند وکړ لکه څنګه چې هغه د اریحا د پاچا سره کړی ؤ."}, {"ref": "None Joshua 1:28", "text": "دا هغه سیمې او د هغو ښارګوټي او کلي وو چې د جاد قبیلې ته ورکړل شول."}, {"ref": "None Joshua 1:28", "text": "حزر شوعل، بیرشبع، بزیوتیه،"}, {"ref": "None Joshua 1:28", "text": "صیله، الف، یبوسي ښار (اورشلیم)، جبعه او قریت یعاریم - د شاوخوا کلیو سره څوارلس ښارګوټي. دا هغه ځمکه وه چې د بنیامین د قبیلې طایفو د خپل ملکیت په توګه تر لاسه کړې وه."}, {"ref": "None Joshua 1:28", "text": "عبرون، رحوب، حمون، قانه او تر لوی صیدون پورې غزېدلی دی."}, {"ref": "None Joshua 1:29", "text": "وروسته له هغې یوشع او د هغه ټول لښکر له مقیده څخه لبنه ته لاړل او په هغه ځای باندې یې حمله وکړه."}, {"ref": "None Joshua 1:29", "text": "موسی د منسي په نیمه قبیله کې هرې یوې طایفې ته ځمکه ورکړه."}, {"ref": "None Joshua 1:29", "text": "بعاله، عییم، عاصم،"}, {"ref": "None Joshua 1:29", "text": "دا سرحد بیا رامه ته ګرځېدلی او د صور قوي دېوال لرونکي ښار ته رسېده. بیا هغه حوسه ته ګرځېدلی او د مدیترانې په بحیره کې ختم شوی دی. په دې سیمه کې محالاب، اکزیب،"}, {"ref": "None Joshua 1:30", "text": "څښتن اسراییلیان په دې ښار او د هغه په پاچا باندې هم بریالي کړل. هغوی هېڅوک ژوندی پرېنښود او د ښار ټول خلک یې ووژل. لکه څنګه چې هغوی د اریحا پاچا وژلی ؤ هماغه شان هغوی د لبنه پاچا هم وواژه."}, {"ref": "None Joshua 1:30", "text": "د هغوی سیمه تر محنایم پورې وه او په هغې کې د باشان پاچا عوج ټوله پاچاهي او همدارنګه په باشان کې د یاییر ټول شپېته کلي شامل وو."}, {"ref": "None Joshua 1:30", "text": "التولد، کسیل، حرمه،"}, {"ref": "None Joshua 1:30", "text": "عمه، عفیق او رحوب شامل وو. د شاوخوا کلیو سره دوه ویشت ښارګوټي وو."}, {"ref": "None Joshua 1:31", "text": "له هغې وروسته یوشع او د هغه لښکر د لبنه څخه لاخیش ته لاړل، هغه یې کلابند کړ او حمله یې ورباندې وکړه."}, {"ref": "None Joshua 1:31", "text": "په دې کې نیم جلعاد، همدارنګه عشتاروت او ادرعي یعنې په باشان کې د عوج د پاچاهۍ شاهي ښارونه شامل وو. دا ټول هغو نیمو طایفو ته ورکړل شول چې د ماخیر یعنې د منسي د زوی څخه د اولادې په توګه پاتې وې."}, {"ref": "None Joshua 1:31", "text": "صقلج، مدمنه، سنسنه،"}, {"ref": "None Joshua 1:31", "text": "دا ښارګوټي او د هغو کلي په هغې ځمکه کې وو چې د اشیر د قبیلې طایفو د خپل ملکیت په توګه تر لاسه کړه."}, {"ref": "None Joshua 1:32", "text": "د جګړې په دوهمه ورځ څښتن اسراییلیان په لاخیش باندې بریالي کړل. هغوی د ښار ټول خلک د لبنه د خلکو په شان ووژل."}, {"ref": "None Joshua 1:32", "text": "په دې ډول موسی د موآب ډاګونه چې د اردن د سیند په بله غاړه او د اریحا په ختیځ کې وو، ووېشل."}, {"ref": "None Joshua 1:32", "text": "لباعوت، سلخیم، عین او رمون - د شاوخوا کلیو سره ټول نهه ویشت ښارګوټي وو."}, {"ref": "None Joshua 1:32", "text": "شپږمه پچه د نفتالي د قبیلې د طایفو په نوم ووتله:"}, {"ref": "None Joshua 1:33", "text": "هورام د جازر پاچا د لاخیش سره د مرستې دپاره راغی، خو یوشع هغه او د هغه لښکر ته ماتې ورکړه او د هغوی یو کس یې هم ژوندی پرېنښود."}, {"ref": "None Joshua 1:33", "text": "خو موسی د لاوي قبیلې ته هېڅ ځمکه ورنه کړه، ځکه چې څښتن وعده کړې وه چې هغه به تل د هغوی اړتیاوې پوره کوي."}, {"ref": "None Joshua 1:33", "text": "هغه ښارګوټي چې د غرونو په لوېدیځو لمنو کې پراته وو: اشتاول، زرعه، اشنه،"}, {"ref": "None Joshua 1:33", "text": "د هغوی سرحد د حالف او په صعنیم کې د څېړۍ د ونې څخه تېر شوی او د ادامي ناقب او یبنییل څخه تر لقوم پورې رسېده او د اردن د سیند سره ختم شوی ؤ."}, {"ref": "None Joshua 1:34", "text": "بیا یوشع او د هغه لښکر د لاخیش څخه عجلون ته لاړل، هغه یې کلابند کړ او حمله یې ورباندې وکړه."}, {"ref": "None Joshua 1:34", "text": "زانوح، عین جنیم، تفوح، عینام،"}, {"ref": "None Joshua 1:34", "text": "په هغه ځای کې دا سرحد لوېدیځې خواته د ازنوت تابور په لور ګرځېدلی او په حقوق کې راوتلی دی. هغه په جنوب کې د زبولون سیمې ته، په لوېدیځ کې د اشیر سیمې ته او په ختیځ کې د اردن سیند ته رسېدلی دی."}, {"ref": "None Joshua 1:35", "text": "هغوی په هماغه ورځ دا ښار ونیوه او د لاخیش په شان یې د هغه ځای ټول خلک ووژل."}, {"ref": "None Joshua 1:35", "text": "یرموت، عدولام، سوکوه، عزیقه،"}, {"ref": "None Joshua 1:35", "text": "هغه قوي دېوال لرونکي ښارګوټي دا وو: صدیم، صیر، حمت، رقت، کنارت،"}, {"ref": "None Joshua 1:36", "text": "له هغې وروسته هغوی د عجلون څخه د غونډیو له لارې حبرون ته وروختل او په هغه باندې یې حمله وکړه."}, {"ref": "None Joshua 1:36", "text": "شعرایم، عدیتایم، جدیره او جدیروتایم - د شاوخوا کلیو سره څوارلس ښارګوټي وو."}, {"ref": "None Joshua 1:36", "text": "ادامه، رامه، حاصور،"}, {"ref": "None Joshua 1:37", "text": "هغوی هغه ښار او د هغه شاوخوا کلي ونیول، بیا یې ټول خلک ووژل چې په هغو کې پاچا هم شامل ؤ. لکه څنګه چې هغوی عجلون له منځه وړی ؤ هماغه شان یې حبرون هم بیخي له منځه یووړ."}, {"ref": "None Joshua 1:37", "text": "صنان، حداشاه، مجدل جاد،"}, {"ref": "None Joshua 1:37", "text": "قادش، ادرعي، عین حاصور،"}, {"ref": "None Joshua 1:38", "text": "بیا یوشع د خپل لښکر سره راوګرځېد او په دبیر باندې یې حمله وکړه."}, {"ref": "None Joshua 1:38", "text": "دلعان، مصفه، یقت ییل،"}, {"ref": "None Joshua 1:38", "text": "یرون، مجدل ییل، حوریم، بیت عناه او بیت شمس. د شاوخوا کلیو سره نولس ښارګوټي وو."}, {"ref": "None Joshua 1:39", "text": "هغوی ښار، د هغه پاچا او شاوخوا ټول کلي ونیول. د هغه ځای ټول خلک یې بیخي له منځه یووړل. هغوی د دبیر او د هغه ځای د پاچا سره هماغه شان کار وکړ لکه څنګه یې چې د حبرون د ښار او د لبنه د ښار او پاچا سره کړی ؤ."}, {"ref": "None Joshua 1:39", "text": "لاخیش، بصقت، عجلون،"}, {"ref": "None Joshua 1:39", "text": "دا ښارګوټي او د هغو کلي په هغې ځمکه کې وو چې د نفتالي د قبیلې طایفو د خپل ملکیت په توګه تر لاسه کړه."}, {"ref": "None Joshua 1:40", "text": "یوشع ټوله خاوره فتح کړه. هغه د غرنۍ سیمې، د غرونو د ختیځو لمنو، د غرونو د لوېدیځو لمنو او د کنعان د جنوبي سیمې پاچاهانو ته ماتې ورکړه. هغه هېڅوک ژوندی پرېنښود، ټول ووژل شول. دا هغه څه وو چې د اسراییلو څښتن خدای د هغو حکم کړی ؤ."}, {"ref": "None Joshua 1:40", "text": "کبون، لحمان، کتلیش،"}, {"ref": "None Joshua 1:40", "text": "اوومه پچه د دان د قبیلې د طایفو په نوم ووتله."}, {"ref": "None Joshua 1:41", "text": "یوشع دا خاوره د قادش برنیع څخه تر غزې او د جوشن د ټولې سیمې څخه تر جبعون پورې فتح کړه."}, {"ref": "None Joshua 1:41", "text": "جدیروت، بیت داجون، نعمه او مقیده - د شاوخوا کلیو سره شپاړس ښارګوټي وو."}, {"ref": "None Joshua 1:41", "text": "د هغوی په سیمه کې دا ځایونه شامل وو: زرعه، اشتاول، عیر شمس،"}, {"ref": "None Joshua 1:42", "text": "یوشع په یوې لښکر کشۍ سره په دې ټولو پاچاهانو او د هغوی په سیمو باندې فتح تر لاسه کړه، ځکه چې د اسراییلو څښتن خدای د اسراییلو دپاره جګړه کوله."}, {"ref": "None Joshua 1:42", "text": "لبنه، عاتر، عاشان،"}, {"ref": "None Joshua 1:42", "text": "شعلبین، ایالون، یتله،"}, {"ref": "None Joshua 1:43", "text": "بیا یوشع د خپل لښکر سره په جلجال کې خپل کمپ ته راستون شو."}, {"ref": "None Joshua 1:43", "text": "یفتاح، اشنه، نصیب،"}, {"ref": "None Joshua 1:43", "text": "ایلون، تمنه، عقرون،"}, {"ref": "None Joshua 1:44", "text": "قعیله، اکزیب او مریشه - د شاوخوا کلیو سره نهه ښارګوټي وو."}, {"ref": "None Joshua 1:44", "text": "التقي، جبتون، بعله،"}, {"ref": "None Joshua 1:45", "text": "عقرون د شاوخوا کلیو او بانډو سره،"}, {"ref": "None Joshua 1:45", "text": "یهود، بني برق، جت رمون،"}, {"ref": "None Joshua 1:46", "text": "د عقرون څخه د مدیترانې تر بحیرې پورې هغه ټول ښارونه او ښارګوټي چې اشدود ته نژدې وو."}, {"ref": "None Joshua 1:46", "text": "میاه یرقون او رقون د هغې سیمې سره چې یافا ته مخامخ وه."}, {"ref": "None Joshua 1:47", "text": "اشدود او غزه د هغو د ښارګوټو او کلیو سره تر هغه خوړ پورې چې د مصر په پوله کې ؤ او د مدیترانې د بحیرې تر غاړې پورې."}, {"ref": "None Joshua 1:48", "text": "هغه ښارګوټي چې په غرنۍ سیمه کې وو: شامیر، یتیر، سوکوه،"}, {"ref": "None Joshua 1:49", "text": "دنه، قریت سنه (دبیر)،"}, {"ref": "None Joshua 1:49", "text": "کله چې د اسراییلو قوم د ځمکې د وېشلو څخه وزګار شو، هغوی د نون زوی یوشع ته د ځمکې یوه برخه ورکړه چې د هغه شي."}, {"ref": "None Joshua 1:50", "text": "عناب، اشتموع، عانیم،"}, {"ref": "None Joshua 1:50", "text": "څنګه چې څښتن حکم کړی ؤ، هغوی یوشع ته هغه ښارګوټی ورکړ چې هغه غوښتی ؤ، یعنې تمنه سارح چې د افرایم په غرنۍ سیمه کې ؤ. هغه دا ښارګوټی بیا ودان کړ او هلته ځای په ځای شو."}, {"ref": "None Joshua 1:51", "text": "جوشن، حولون او جیلوه - د شاوخوا کلیو سره یوولس ښارګوټي وو."}, {"ref": "None Joshua 1:51", "text": "دا هغه سیمې وې چې العازار کاهن، یوشع او د اسراییلو د قبیلو د طایفو مشرانو په شیلوه کې د پچې له مخې ووېشلې. هغوی دا کار د څښتن په حضور کې د سپېڅلې خېمې په دروازه کې وکړ. په دې ډول هغوی د ځمکې وېش سرته ورساوه."}, {"ref": "None Joshua 1:52", "text": "اراب، دومه، اشعان،"}, {"ref": "None Joshua 1:53", "text": "یانوم، بیت تفوح، افیقه،"}, {"ref": "None Joshua 1:54", "text": "حمطه، قریت اربع (حبرون) او صیعور - د شاوخوا کلیو سره نهه ښارګوټي وو."}, {"ref": "None Joshua 1:55", "text": "معون، کرمل، زیف، یوطه،"}, {"ref": "None Joshua 1:56", "text": "یزرعیل، یقدعام، زانوح،"}, {"ref": "None Joshua 1:57", "text": "قاین، جبعه او تمنه - د شاوخوا کلیو سره لس ښارګوټي وو."}, {"ref": "None Joshua 1:58", "text": "حلحول، بیت صور، جدور،"}, {"ref": "None Joshua 1:59", "text": "معارات، بیت عنوت او التقون - د شاوخوا کلیو سره شپږ ښارګوټي وو."}, {"ref": "None Joshua 1:60", "text": "قریت بعل (قریت یعاریم) او ربه - د شاوخوا کلیو سره دوه ښارګوټي وو."}, {"ref": "None Joshua 1:61", "text": "هغه ښارګوټي چې په دښته کې پراته وو: بیت عربه، مدین، سکاکه،"}, {"ref": "None Joshua 1:62", "text": "نبشان، د مالګې ښار او عین جدي - د شاوخوا کلیو سره شپږ ښارګوټي وو."}, {"ref": "None Joshua 1:63", "text": "خو د یهودا خلکو نه شو کولای چې یبوسیان د اورشلیم څخه وشړي. له دې امله هغوی تر اوسه پورې د یهودا د خلکو سره په هغه ښار کې اوسیږي."}, {"ref": "None Joshua 2:1", "text": "بیا څښتن یوشع ته وویل"}, {"ref": "None Joshua 2:1", "text": "بیا یوشع د روبین، جاد او ختیځې منسي د قبیلو خلک راوغوښتل."}, {"ref": "None Joshua 2:1", "text": "وروسته له اوږدې مودې څښتن اسراییلو ته د شاوخوا ټولو دښمنانو څخه ارامي ورکړه. په دې وخت کې یوشع ډېر زوړ شوی ؤ."}, {"ref": "None Joshua 2:1", "text": "یوشع په شکیم کې د اسراییلو ټولې قبیلې راټولې کړې. هغه د اسراییلو سپین ږیري، مشران، قاضیان او مامورین راوغوښتل. هغوی راغلل او د خدای په حضور کې ودرېدل."}, {"ref": "None Joshua 2:2", "text": "چې د اسراییلو قوم ته ووایه: «د پناه اخیستلو ښارونه چې د هغو په اړه مې د موسی په وسیله تاسو ته ویلي وو، وټاکئ."}, {"ref": "None Joshua 2:2", "text": "یوشع هغوی ته وویل: «تاسو هغه ټول کارونه کړي دي چې د څښتن خدمتګار موسی درته امر کړی ؤ او زما ټولو حکمونو ته مو غاړه ایښې ده."}, {"ref": "None Joshua 2:2", "text": "هغه ټول اسراییلیان یعنې د هغوی سپین ږیري، مشران، قاضیان او مامورین راوغوښتل او هغوی ته یې وویل: «زه اوس ډېر زوړ شوی یم."}, {"ref": "None Joshua 2:2", "text": "یوشع ټول قوم ته وویل: «د اسراییلو څښتن خدای داسې وایي: ‹ډېره موده مخکې ستاسو نیکونه چې په هغو کې د ابراهیم او د ناحور پلار یعنې تارح شامل ؤ، د فرات د سیند په بلې غاړې باندې اوسېدل او د نورو خدایانو عبادت به یې کاوه."}, {"ref": "None Joshua 2:3", "text": "نو هرڅوک چې په سهوې سره یو سړی ووژني، کولای شي هلته لاړ شي او د وژل شوي کس د خپلوانو څخه وتښتي او خوندي پاتې شي."}, {"ref": "None Joshua 2:3", "text": "نو څنګه چې څښتن حکم کړی ؤ، د اسراییلو قوم لاویانو ته د خپلو سیمو څخه ځینې ښارګوټي او څړځایونه ورکړل."}, {"ref": "None Joshua 2:3", "text": "که څه هم جنګ زیات اوږد شو، خو تاسو په دې موده کې خپل اسراییلي ورونه پریښي نه دي او کومه وظیفه چې ستاسو څښتن خدای تاسو ته سپارلې وه هغه مو سرته رسولې ده."}, {"ref": "None Joshua 2:3", "text": "تاسو ولیدل چې ستاسو څښتن خدای ستاسو په خاطر په دې ټولو قومونو باندې څه وکړل. هغه په خپله ستاسو دپاره جګړه وکړه."}, {"ref": "None Joshua 2:3", "text": "بیا ما ستاسو نیکه ابراهیم د هغه ځای څخه بوته او د کنعان په ټوله خاوره کې مې وګرځاوه. هغه ته مې اسحاق ورکړ او د اسحاق په وسیله مې هغه ته ډېره اولاده ورکړه."}, {"ref": "None Joshua 2:4", "text": "هغه کولای شي د دې ښارونو د جملې څخه یو ښار ته وتښتي، د ښار دروازې ته چې د قضاوت ځای دی ورشي او مشرانو ته دې د پېښې په هکله بیان ورکړي. بیا به هغوی هغه کس ته اجازه ورکړي چې ښار ته ورننوځي او هغه ته د اوسېدلو دپاره ځای ورکړي، ترڅو وکولای شي هلته پاتې شي."}, {"ref": "None Joshua 2:4", "text": "لومړنۍ پچه د قهاتیانو د طایفو په نوم ووتله. هغو لاویانو ته چې د هارون کاهن د اولادې څخه وو، هغوی ته د یهودا، شمعون او بنیامین د سیمو څخه دیارلس ښارګوټي ورکړل شول."}, {"ref": "None Joshua 2:4", "text": "اوس ستاسو څښتن خدای د خپلې وعدې سره سم ستاسو ورونو ته ارامي ورکړې ده. نو بېرته خپلو کورونو یعنې هغې ځمکې ته لاړ شئ چې د اردن د سیند په ختیځ کې ده او د څښتن خدمتګار موسی تاسو ته درکړې ده."}, {"ref": "None Joshua 2:4", "text": "ما ستاسو قبیلو ته ټوله ځمکه په ختیځ کې د اردن د سیند څخه په لوېدیځ کې د مدیترانې تر بحیرې پورې ورکړه. ما تاسو ته د هغو ټولو قومونو ځمکه چې مخکې مونږ فتح کړې وه درکړې ده او همدارنګه د هغو قومونو ځمکه چې تر اوسه پورې لا مونږ فتح کړې نه ده."}, {"ref": "None Joshua 2:4", "text": "اسحاق ته مې دوه زامن ورکړل یعنې یعقوب او عیسو. عیسو ته مې د ادوم غرنۍ سیمه د هغه د ملکیت په توګه ورکړه، خو ستاسو نیکه یعقوب او د هغه اولادونه مصر ته لاړل."}, {"ref": "None Joshua 2:5", "text": "که چېرې بدل اخیستونکی هغه تعقیب کړي، نو د هغه ښار خلک باید په قتل باندې تورن کس هغه ته په لاس ورنه کړي. هغوی باید د هغه ساتنه وکړي، ځکه چې هغه کس یې په سهوې سره وژلی دی او مخکې یې ورسره کومه دښمني نه درلودله."}, {"ref": "None Joshua 2:5", "text": "د افرایم، دان او لوېدیځې منسي د سیمو څخه لس ښارګوټي د قهات پاتې اولادې ته ورکړل شول."}, {"ref": "None Joshua 2:5", "text": "تاسو په غور سره د هغو ټولو شیانو څخه اطاعت کوئ چې موسی تاسو ته امر کړی دی چې د خپل څښتن خدای سره مینه کوئ او د هغه رضا پوره کوئ. د هغه حکمونو ته غاړه ږدئ، هغه ته وفادار اوسئ او د زړه له کومي او په خپل ټول توان سره د هغه خدمت کوئ.»"}, {"ref": "None Joshua 2:5", "text": "ستاسو څښتن خدای به هغوی ستاسو په وړاندې په شا تګ ته مجبور کړي او څنګه چې تاسو مخکې ځئ هغوی به وشړي. لکه څنګه چې هغه ستاسو سره وعده کړې ده، تاسو به د هغوی ځمکه ونیسئ."}, {"ref": "None Joshua 2:6", "text": "هغه به په دې ښار کې تر هغه وخته پورې پاتې کیږي، ترڅو په علني محاکمه کې بې ګناه ثابت شي او تر هغې پورې چې لوی کاهن مړ شي. بیا هغه کولای شي چې بېرته خپل کور او خپل ښارګوټي ته یعنې د کوم ځای څخه چې هغه راتښتېدلی وي، لاړ شي.»"}, {"ref": "None Joshua 2:6", "text": "د یساکار، اشیر، نفتالي او په باشان کې د ختیځې منسي د سیمو څخه د جرشون اولادې ته دیارلس ښارګوټي ورکړل شول."}, {"ref": "None Joshua 2:6", "text": "تاسو قوي اوسئ او هرڅه چې د موسی په شریعت کې لیکل شوي دي، هغو ته په غور سره غاړه کېږدئ او هغه سرته ورسوئ. د هغو یوه برخه هم له نظره مه غورځوئ."}, {"ref": "None Joshua 2:7", "text": "نو د اسراییلو قوم د جلیل قادش چې د نفتالي په غرنۍ سیمه کې ؤ بېل کړ، شکیم یې د افرایم په غرنۍ سیمه کې او قریت اربع (حبرون) یې د یهودا په غرنۍ سیمه کې بېل کړ."}, {"ref": "None Joshua 2:7", "text": "د مراري د اولادې طایفو د روبین، جاد او زبولون د سیمو څخه دولس ښارګوټي تر لاسه کړل."}, {"ref": "None Joshua 2:7", "text": "پام کوئ د هغو قومونو سره چې ستاسو په منځ کې پاتې دي، ملګرتیا ونه کړئ او د هغوی خدایانو ته عبادت مه کوئ. هغوی ته دعا مه کوئ او په قسم خوړلو کې د هغوی نومونه مه اخلئ."}, {"ref": "None Joshua 2:7", "text": "هغوی ماته د مرستې دپاره فریاد وکړ او ما د هغوی او مصریانو ترمنځ تیاره رامنځته کړه. په مصریانو باندې مې اوبه راوستلې او هغوی مې په بحیره کې ډوب کړل. تاسو په خپلو سترګو ولیدل چې ما په مصر باندې څه وکړل. له هغې وروسته تاسو ډېره موده په دښته کې اوسېدلئ."}, {"ref": "None Joshua 2:8", "text": "د اردن د سیند په ختیځ کې د دښتې په لوړه جلګه باندې چې د اریحا ختیځې خواته وه هغوی باصر وټاکه چې د روبین په سیمه کې ؤ، راموت یې په جلعاد کې چې د جاد په سیمه کې پروت ؤ، وټاکه او جولان یې په باشان کې چې د منسي په سیمه کې پروت ؤ، وټاکه."}, {"ref": "None Joshua 2:8", "text": "نو لکه څنګه چې څښتن د موسی په وسیله امر کړی ؤ، د اسراییلو قوم د پچې له مخې لاویانو ته دا ښارګوټي د څړځایونو سره ورکړل."}, {"ref": "None Joshua 2:8", "text": "د هغې په ځای، د خپل څښتن خدای سره وفادار اوسئ لکه څنګه چې تر اوسه پورې ورسره وفادار یئ."}, {"ref": "None Joshua 2:8", "text": "بیا مې تاسو هغې خاورې ته راوستلئ چې د اردن د سیند په ختیځ کې وه. هلته اموریان اوسېدل او هغوی ستاسو سره جګړه وکړه، خو تاسو زما په مرسته هغوی ته ماتې ورکړه، هغوی مو له منځه یووړل او د هغوی خاوره مو ونیوله."}, {"ref": "None Joshua 2:9", "text": "دا د پناه اخیستلو هغه ښارونه وو چې د اسراییلو د ټول قوم دپاره او د هغو پردیو خلکو دپاره چې د هغوی په منځ کې اوسېدل، وټاکل شول. هرچا چې به په سهوې سره بل کس واژه، هغه به د بدل اخیستونکي څخه هلته ساتنه تر لاسه کولای شوه. که چېرې هغه کس اول د غونډې په مخکې نه ؤ ملامت شوی، نو هغه یې نه شو وژلی."}, {"ref": "None Joshua 2:9", "text": "نو د روبین او جاد د قبیلو او د ختیځې منسي د قبیلې خلک بېرته خپلو کورونو ته لاړل. هغوی د اسراییلو پاتې خلک په شیلوه کې چې په کنعان کې وه، پرېښودل او خپلې خاورې ته چې د جلعاد خاوره وه، لاړل. دا خاوره هغوی د څښتن د حکم سره سم چې د موسی په وسیله یې کړی ؤ، نیولې وه."}, {"ref": "None Joshua 2:9", "text": "څښتن لوی او قدرتمند قومونه ستاسو له مخې څخه لېرې کړي دي او تر نن ورځې پورې هېچا دا توان نه دی موندلی چې ستاسو په وړاندې ودریږي."}, {"ref": "None Joshua 2:9", "text": "کله چې د موآب پاچا د صفور زوی بالاق ستاسو په وړاندې ودرېده، هغه د بعور زوی بلعام راوغوښت او د هغه څخه یې وغوښتل چې په تاسو باندې لعنت ووایي."}, {"ref": "None Joshua 2:10", "text": "ستاسو څخه هر یو کولای شي چې د دښمن زرو تنو ته ماتې ورکړي، ځکه چې ستاسو څښتن خدای د خپلې وعدې سره سم ستاسو دپاره جګړه کوي."}, {"ref": "None Joshua 2:10", "text": "خو ما د بلعام خبرو ته غوږ ونه نیوه. هغه مې مجبور کړ چې تاسو ته برکت درکړي. په دې ډول مې تاسو د بالاق څخه وژغورلئ."}, {"ref": "None Joshua 2:11", "text": "هغوی ته یې د یهودا په غرنۍ سیمه کې قریت اربع (حبرون) د شاوخوا څړځایونو سره ورکړه (اربع د عناق پلار ؤ)."}, {"ref": "None Joshua 2:11", "text": "بیا ډېر پام کوئ چې د خپل څښتن خدای سره مینه وکړئ."}, {"ref": "None Joshua 2:11", "text": "بیا تاسو د اردن د سیند څخه پورې وتلئ او اریحا ته راغلئ. د اریحا خلکو د اموریانو، فرزیانو، کنعانیانو، حیتیانو، جرجاشیانو، حویانو او یبوسیانو په شان ستاسو سره جګړه وکړه. خو ما تاسو ته په هغوی ټولو باندې بری درکړ."}, {"ref": "None Joshua 2:12", "text": "خو هغوی د ښار شاوخوا پټي او کلي پخوا د یفنه زوی کالیب ته د هغه د ملکیت په توګه ورکړي وو."}, {"ref": "None Joshua 2:12", "text": "نو د لوېدیځو قبیلو ټول خلک په شیلوه کې سره راټول شول چې لاړ شي او د ختیځو قبیلو سره وجنګیږي."}, {"ref": "None Joshua 2:12", "text": "که چېرې تاسو بې وفایي وکړئ او د هغو قومونو سره یوځای شئ چې تر اوسه پورې ستاسو په منځ کې پاتې دي او د هغوی سره ودونه وکړئ،"}, {"ref": "None Joshua 2:12", "text": "ستاسو دښمنان ستاسو څخه وتښتېدل، خو ستاسو د تورو، لیندو او غشو له امله نه. ما ستاسو په دښمنانو کې سخته وېره راپیدا کړه او هغوی وتښتېدل لکه څنګه چې مې د هغو دوو اموریایي پاچاهانو سره کړي وو چې د اردن د سیند په ختیځ کې اوسېدل."}, {"ref": "None Joshua 2:13", "text": "نو هغوی د هارون کاهن اولادې ته دا لاندې ښارګوټي ورکړل: حبرون (چې په قتل باندې تورن شوي کس دپاره د پناه اخیستلو ښار ؤ)، لبنه،"}, {"ref": "None Joshua 2:13", "text": "نو د اسراییلو خلکو د العازار کاهن زوی فینحاس د جلعاد خاورې ته د روبین، جاد او د ختیځې منسي قبیلو ته ولېږه."}, {"ref": "None Joshua 2:13", "text": "نو بیا باور ولرئ چې څښتن خدای به نور دا قومونه ستاسو له مخې څخه لېرې نه کړي، بلکې هغوی به ستاسو دپاره د دام یا د لومې په شان خطرناک شي او ستاسو د شاګانو دپاره به د قمچینې په شان شي او ستاسو په سترګو کې به د اغزیو په شان شي. او دا به تر هغه وخته پورې دوام ومومي، ترڅو ستاسو څخه هېڅوک په دې ښې ځمکه کې چې خپل څښتن خدای درته درکړې ده پاتې نه شي."}, {"ref": "None Joshua 2:13", "text": "ما تاسو ته ځمکه درکړه په کومې باندې چې تاسو زحمت نه ؤ ویستلی او ښارونه مې درکړل چې هغه تاسو نه وو ودان کړي او اوس په هغو کې اوسېږئ. د انګورو او زیتونو د باغونو څخه چې تاسو کرلي نه وو، خواړه خورئ.›»"}, {"ref": "None Joshua 2:14", "text": "یتیر، اشتموع،"}, {"ref": "None Joshua 2:14", "text": "نو د فینحاس سره لس مشران لاړل، د هرې لوېدیځې قبیلې څخه یو یو کس یعنې د هغوی د کورنیو د مشرانو څخه یو یو کس."}, {"ref": "None Joshua 2:14", "text": "اوس زما د مړینې وخت رارسېدلی دی. تاسو هر یو په خپل زړه کې پوهېږئ چې ستاسو څښتن خدای تاسو ته هغه ټول ښه شیان درکړي دي چې وعده یې کړې وه. هره وعده چې هغه کړې ده، هغه پوره شوې ده او یوه وعده یې هم ماته شوې نه ده."}, {"ref": "None Joshua 2:14", "text": "بیا یوشع وویل: «نو د څښتن څخه ووېرېږئ او په پوره وفادارۍ سره د هغه عبادت وکړئ. هغه بتان چې ستاسو نیکونو یې په مصر او د فرات د سیند په بله غاړه باندې عبادت کاوه، لېرې ګوزار کړئ او د څښتن عبادت وکړئ."}, {"ref": "None Joshua 2:15", "text": "حولون، دبیر،"}, {"ref": "None Joshua 2:15", "text": "کله چې هغوی د جلعاد خاورې ته د روبین، جاد او ختیځې منسي خلکو ته ورغلل،"}, {"ref": "None Joshua 2:15", "text": "خو لکه څنګه چې زمونږ څښتن خدای ستاسو سره د ټولو ښو شیانو وعده کړې ده او هغه یې سرته رسولې ده، نو هماغسې هغه به په تاسو باندې ټولې بدۍ هم راولي، ترڅو تاسو د دې ښې ځمکې څخه چې هغه تاسو ته درکړې ده، ورک کړي."}, {"ref": "None Joshua 2:15", "text": "که چېرې تاسو د هغه عبادت کول نه غواړئ، نو نن پرېکړه وکړئ چې د کومو خدایانو عبادت به کوئ. ایا د هغو خدایانو عبادت به کوئ چې ستاسو نیکونو یې د فرات د سیند په بله غاړه باندې عبادت کاوه او یا به د اموریانو د خدایانو چې تاسو اوس د هغوی په خاوره کې اوسېږئ، عبادت کوئ. خو زه به د خپلې کورنۍ سره د څښتن عبادت کوم.»"}, {"ref": "None Joshua 2:16", "text": "عین، یوطه او بیت شمس د هغو د څړځایونو سره - د یهودا او شمعون د قبیلو څخه نهه ښارګوټي."}, {"ref": "None Joshua 2:16", "text": "هغوی وویل: «مونږ د څښتن د ټول قوم له خوا خبرې کوو: ‹تاسو ولې د اسراییلو د څښتن خدای په وړاندې داسې بد کار کړی دی؟ تاسو د خپلو ځانونو دپاره د دې قربانۍ د ځای په جوړولو سره د هغه په وړاندې سرکښي کړې ده! تاسو نور د هغه پیروان نه یئ."}, {"ref": "None Joshua 2:16", "text": "که چېرې تاسو هغه لوظ مات کړئ چې د هغه حکم یې په تاسو باندې کړی دی او د نورو خدایانو خدمت او عبادت وکړئ، نو بیا به هغه په قهر شي او تاسو ته به سزا درکړي او تاسو به زر د هغې ځمکې څخه ورک شئ چې زمونږ څښتن خدای تاسو ته درکړې ده.»"}, {"ref": "None Joshua 2:16", "text": "قوم په ځواب کې وویل: «مونږ به هېڅکله داسې ونه کړو چې څښتن پرېږدو او د نورو خدایانو عبادت وکړو."}, {"ref": "None Joshua 2:17", "text": "د بنیامین د سیمې څخه یې هغوی ته جبعون، جبع،"}, {"ref": "None Joshua 2:17", "text": "په فغور کې زمونږ ګناه در په یاده کړئ. ایا زمونږ دپاره هغه بس نه وه؟ سره له دې چې د څښتن په قوم باندې وبا نازله شوه، خو تر نن ورځې پورې مونږ د هغې ګناه څخه خپل ځانونه پاک کړي نه دي."}, {"ref": "None Joshua 2:17", "text": "دا په خپله زمونږ څښتن خدای ؤ چې مونږ یې د خپلو نیکونو سره د مصر څخه چې په کې غلامان وو راوویستلو او مونږ هغه معجزې ولیدلې چې هغه وښودلې. په خپل ټول سفر کې او د هغو ټولو قومونو په منځ کې چې مونږ ورڅخه تېرېدلو، هغه وساتلو."}, {"ref": "None Joshua 2:18", "text": "عناتوت او علمون د هغو د څړځایونو سره ورکړل. دا څلور ښارګوټي وو."}, {"ref": "None Joshua 2:18", "text": "ایا تاسو اوس غواړئ چې د څښتن د پیروۍ څخه انکار وکړئ؟ که چېرې تاسو نن د څښتن په وړاندې سرکښي وکړئ، سبا به هغه د اسراییلو په ټول قوم باندې په قهر شي."}, {"ref": "None Joshua 2:18", "text": "څښتن زمونږ د مخې څخه هغه ټول قومونه لېرې کړل چې په دې خاوره کې اوسېدل چې په هغو کې اموریان هم شامل وو. نو مونږ به هم د څښتن عبادت او اطاعت کوو، ځکه چې هغه زمونږ خدای دی.»"}, {"ref": "None Joshua 2:19", "text": "د کاهنانو یعنې د هارون د اولادې دپاره د څړځایونو سره ټول دیارلس ښارګوټي ورکړل شول."}, {"ref": "None Joshua 2:19", "text": "خو که چېرې ستاسو خاوره د عبادت دپاره مناسبه نه وي، نو د څښتن ځمکې ته راشئ چې د هغه سپېڅلې خېمه په کې ولاړه ده او زمونږ په منځ کې ځمکه واخلئ. خو د څښتن په وړاندې سرکښي مه کوئ او پرته زمونږ د څښتن خدای د قربانۍ د ځای څخه د بلې قربانۍ د ځای په جوړولو سره مونږ مه ګناهکاروئ."}, {"ref": "None Joshua 2:19", "text": "یوشع قوم ته وویل: «کېدای شي چې تاسو د څښتن عبادت ونه شئ کولای، ځکه چې هغه سپېڅلی او غیرتي خدای دی. تاسو باید هغه ته پوره وفادار اوسئ. که چېرې تاسو د هغه په وړاندې ګناه او سرکښي وکړئ، نو هغه به تاسې ونه بخښي."}, {"ref": "None Joshua 2:20", "text": "د لاویانو د قهاتیانو پاتې طایفو ته د افرایم د سیمې څخه یو څو ښارګوټي ورکړل شول."}, {"ref": "None Joshua 2:20", "text": "ایا هغه څه چې د عخان سره وشول هغه مو په یاد دي؟ څښتن مونږ ته ویلي وو چې د اریحا د ښار ټول شیان له منځه یوسئ، خو عخان د څښتن د حکم څخه سرغړونه وکړه او څښتن مونږ ټولو ته سزا راکړه. عخان د خپلو کړو له امله مړ شو او نور ډېر اسراییلیان هم د عخان د ګناه له امله مړه شول.›»"}, {"ref": "None Joshua 2:20", "text": "که چېرې تاسو هغه پرېږدئ او د نورو قومونو د بتانو عبادت وکړئ، هغه به ستاسو په ضد شي او تاسو ته به سزا درکړي. که څه هم مخکې هغه ستاسو سره ښه ؤ، خو تاسې به له منځه یوسي.»"}, {"ref": "None Joshua 2:21", "text": "هغوی ته د افرایم په غرنۍ سیمه کې دا څلور ښارګوټي ورکړل شول: شکیم (چې په قتل باندې تورن شوي کس دپاره د پناه اخیستلو ښار ؤ)، جازر،"}, {"ref": "None Joshua 2:21", "text": "د روبین، جاد او ختیځې منسي د قبیلو خلکو د لوېدیځو قبیلو استازو ته په ځواب کې وویل:"}, {"ref": "None Joshua 2:21", "text": "قوم یوشع ته وویل: «نه! مونږ به د څښتن عبادت او اطاعت کوو.»"}, {"ref": "None Joshua 2:22", "text": "قبصایم او بیت حورون د هغو د څړځایونو سره."}, {"ref": "None Joshua 2:22", "text": "«څښتن یوازېنی قوي خدای دی! مونږ د هغه څخه غوښتنه کوو چې زمونږ شاهد اوسي! هغه پوهیږي چې مونږ ولې داسې کار کړی دی او مونږ غواړو چې تاسو هم ورباندې پوه شئ! که چېرې مونږ د څښتن په وړاندې سرکښي کړې وي او د هغه سره مو خپل لوظ مات کړی وي، نو څښتن دې نور مونږ ژوندي نه پرېږدي."}, {"ref": "None Joshua 2:22", "text": "یوشع هغوی ته وویل: «تاسو د خپلو ځانونو شاهدان یئ. تاسو وویل چې مونږ د څښتن عبادت او اطاعت کول غوره کړي دي.» هغوی وویل: «هو، مونږ شاهدان یو.»"}, {"ref": "None Joshua 2:23", "text": "همدارنګه هغوی د دان د سیمې څخه دا څلور ښارګوټي تر لاسه کړل: التقي، جبتون،"}, {"ref": "None Joshua 2:23", "text": "که چېرې مونږ د څښتن څخه پیروي کول پرې ایښي وي او خپل د قربانۍ ځای مو جوړ کړی وي چې په هغې باندې سوځېدونکې نذرانې یا د غلو دانو یا د سلامتۍ نذرانې وړاندې کړو، نو پرېږدئ چې څښتن په خپله مونږ ته سزا راکړي."}, {"ref": "None Joshua 2:23", "text": "هغه غوښتنه وکړه: «خو لکه د هغو بتانو په شان چې نور قومونه یې عبادت کوي ستاسو سره هم یو څه بتان شته. هغه لېرې ګوزار کړئ او د اسراییلو د څښتن خدای سره د وفادارۍ لوظ وکړئ.»"}, {"ref": "None Joshua 2:24", "text": "ایالون او جت رمون د هغو د څړځایونو سره."}, {"ref": "None Joshua 2:24", "text": "نه! مونږ د دې وېرې له امله دا کار وکړ چې کېدای شي یوه ورځ ستاسو اولاده زمونږ اولادې ته ووایي چې تاسو څه حق لرئ چې د اسراییلو د څښتن خدای عبادت کوئ؟"}, {"ref": "None Joshua 2:24", "text": "قوم یوشع ته وویل: «مونږ به یوازې د خپل څښتن خدای عبادت کوو او د هغه حکمونو ته به غاړه ږدو.»"}, {"ref": "None Joshua 2:25", "text": "هغوی د لوېدیځې نیمې منسي د سیمې څخه دوه ښارګوټي تر لاسه کړل: تعنک او جت رمون د هغو د څړځایونو سره."}, {"ref": "None Joshua 2:25", "text": "څښتن د اردن د سیند څخه زمونږ او ستاسو یعنې د روبین او جاد د خلکو ترمنځ یو سرحد جوړ کړ. تاسو د څښتن سره هېڅ کار نه لرئ. بیا کېدای شي چې ستاسو اولاده زمونږ اولاده د څښتن د عبادت څخه منع کړي."}, {"ref": "None Joshua 2:25", "text": "په هغه ورځ یوشع په شکیم کې د اسراییلو د خلکو استازیتوب وکړ او د هغوی او څښتن ترمنځ یې یو تړون وکړ او هغوی ته یې قوانین او اصول ورکړل چې ورڅخه پیروي وکړي."}, {"ref": "None Joshua 2:26", "text": "دا ټول لس ښارګوټي د هغو د څړځایونو سره د قهاتیانو پاتې طایفو ته ورکړل شول."}, {"ref": "None Joshua 2:26", "text": "نو مونږ د قربانۍ د ځای د جوړولو پرېکړه وکړه، نه د سوځېدونکو نذرانو دپاره او نه د قربانیو دپاره،"}, {"ref": "None Joshua 2:26", "text": "یوشع دا خبرې د خدای د قوانینو په کتاب کې ولیکلې. بیا هغه یوه لویه تیږه واخیستله او د څښتن د عبادت په ځای کې یې د څېړۍ د ونې لاندې ودروله."}, {"ref": "None Joshua 2:27", "text": "د لاویانو د جرشونیانو طایفو ته لاندېني ښارګوټي ورکړل شول: د ختیځې نیمې منسي د سیمې څخه جولان چې په باشان کې ؤ (چې په قتل باندې تورن شوي کس دپاره د پناه اخیستلو ښار ؤ) او بعشتره د هغو د څړځایونو سره - دوه ښارګوټي."}, {"ref": "None Joshua 2:27", "text": "بلکې دا به زمونږ او ستاسو د خلکو دپاره او زمونږ څخه وروسته نسلونو دپاره یوه نښه وي چې مونږ به د څښتن د سپېڅلې خېمې په مخکې د سوځېدونکو نذرانو، قربانیو او سلامتۍ د نذرانو په وړاندې کولو سره د هغه عبادت کوو. بیا به په راتلونکې کې ستاسو اولاده نه شي کولای چې زمونږ اولادې ته داسې ووایي چې تاسو د څښتن عبادت نه شئ کولای."}, {"ref": "None Joshua 2:27", "text": "هغه ټول قوم ته وویل: «ګورئ، دا تیږه به زمونږ شاهده وي. دې تیږې هغه ټولې خبرې واورېدلې چې څښتن مونږ ته وکړې. نو که چېرې تاسو د خپل خدای څخه منکر شئ، نو دا تیږه به ستاسو په خلاف شهادت ورکوي.»"}, {"ref": "None Joshua 2:28", "text": "د یساکار د سیمې څخه قشیون، دابره،"}, {"ref": "None Joshua 2:28", "text": "مونږ فکر کاوه چې که چېرې داسې وشي، امکان لري چې زمونږ اولاده ووایي چې ګورئ، زمونږ نیکونو د څښتن د قربانۍ د ځای په شان یوه نمونه جوړه کړه. دا د سوځېدونکو نذرانو یا د قربانیو دپاره نه، بلکې هغه یې د دې دپاره جوړه کړې ده چې دا وښایي چې مونږ هم ستاسو په شان د څښتن خلک یو."}, {"ref": "None Joshua 2:28", "text": "بیا یوشع قوم رخصت کړ او هر یو کس د خپلې برخې ځمکې ته ور ستون شو."}, {"ref": "None Joshua 2:29", "text": "یرموت او عین جنیم د هغو د څړځایونو سره - څلور ښارګوټي."}, {"ref": "None Joshua 2:29", "text": "مونږ به په یقین سره د څښتن په وړاندې سرکښي ونه کړو او نه به د قربانۍ د ځای په جوړولو سره چې په هغه باندې سوځېدونکې نذرانې یا د غلو دانو نذرانې یا قربانۍ وړاندې کړو، د هغه پیروي کول پرېږدو. مونږ به بل داسې د قربانۍ ځای جوړ نه کړو چې زمونږ د څښتن خدای د قربانګاه ځای ونیسي چې د هغه د سپېڅلې خېمې په مخکې ده.»"}, {"ref": "None Joshua 2:29", "text": "څه موده وروسته د څښتن خدمتګار د نون زوی یوشع د یوسلو لسو کالو په عمر مړ شو."}, {"ref": "None Joshua 2:30", "text": "د اشیر د سیمې څخه مشال، عبدون،"}, {"ref": "None Joshua 2:30", "text": "فینحاس کاهن او د لوېدیځو قبیلو لسو مشرانو چې د هغه سره وو د روبین، جاد او ختیځې منسي د قبیلو د خلکو خبرې واورېدلې او هغوی قانع شول."}, {"ref": "None Joshua 2:30", "text": "هغه یې په خپله ځمکه یعنې په تمنه سارح کې چې د افرایم په غرنۍ سیمه او د جاعش د غره په شمال کې وه، ښخ کړ."}, {"ref": "None Joshua 2:31", "text": "حلقات او رحوب د هغو د څړځایونو سره - څلور ښارګوټي."}, {"ref": "None Joshua 2:31", "text": "فینحاس هغوی ته وویل: «اوس مونږ په دې پوه شو چې څښتن زمونږ سره مل دی. تاسو د هغه په وړاندې سرکښي نه ده کړې بلکې د اسراییلو قوم مو د څښتن د سزا څخه ژغورلی دی.»"}, {"ref": "None Joshua 2:31", "text": "ترڅو پورې چې یوشع ژوندی ؤ، د اسراییلو خلکو د څښتن عبادت او اطاعت کاوه. حتی د هغه د مړینې څخه وروسته هم ترڅو پورې چې د قوم هغه سپین ږیري ژوندي وو چې د څښتن هغه ټول کارونه په خپلو سترګو لیدلي وو چې د اسراییلو دپاره یې کړي وو، هغوی څښتن ته وفادار پاتې شول."}, {"ref": "None Joshua 2:32", "text": "د نفتالي د سیمې څخه قادش په جلیل کې (چې په قتل باندې تورن شوي کس دپاره د پناه اخیستلو ښار ؤ)، حموت دور او قرتان د هغو د څړځایونو سره - درې ښارګوټي."}, {"ref": "None Joshua 2:32", "text": "بیا فینحاس او د لوېدیځو قبیلو مشران بېرته د کنعان خاورې ته راستانه شول او څه چې پېښ شوي وو هغه یې د اسراییلو خلکو ته بیان کړل."}, {"ref": "None Joshua 2:32", "text": "د یوسف مړی چې د اسراییلو خلکو د مصر څخه راوړی ؤ، په شکیم کې په هغې ټوټه ځمکه کې ښخ کړای شو چې یعقوب د شکیم د ښار د بنیاد ایښودونکي حمور د زامنو څخه د سپینو زرو په سلو سکو باندې اخیستې وه. دا ځمکه د یوسف اولادې ته په میراث پاتې شوه."}, {"ref": "None Joshua 2:33", "text": "د جرشونیانو د طایفو ټول ښارګوټي د هغو د څړځایونو سره دیارلسو ته رسېدل."}, {"ref": "None Joshua 2:33", "text": "اسراییلیان قانع شول او د خدای ستاینه یې وکړه. هغوی نور داسې خبرې نه کولې چې د روبین او جاد د خلکو سره جنګ وکړي او د هغوی خاوره له منځه یوسي."}, {"ref": "None Joshua 2:33", "text": "د هارون زوی العازار هم مړ شو او په جبعه کې چې د افرایم په غرنۍ سیمه کې یو ښارګوټی ؤ ښخ کړای شو، دا ښارګوټی د هغه زوی فینحاس ته ورکړل شوی ؤ."}, {"ref": "None Joshua 2:34", "text": "د مراریانو طایفو (پاتې لاویانو) ته لاندېني ښارګوټي ورکړل شول: د زبولون د سیمې څخه یقنعام، قرته،"}, {"ref": "None Joshua 2:34", "text": "د روبین او جاد خلکو وویل: «دا د قربانۍ ځای زمونږ د ټولو ترمنځ شاهد دی چې څښتن زمونږ خدای دی.» نو هغه د قربانۍ ځای یې د شاهد په نوم یاد کړ."}, {"ref": "None Joshua 2:35", "text": "دمنه او نحلال د هغو د څړځایونو سره - څلور ښارګوټي."}, {"ref": "None Joshua 2:36", "text": "د روبین د سیمې څخه باصر، یاهص،"}, {"ref": "None Joshua 2:37", "text": "قدیموت او میفعه د هغو د څړځایونو سره - څلور ښارګوټي."}, {"ref": "None Joshua 2:38", "text": "د جاد د سیمې څخه راموت په جلعاد کې (چې په قتل باندې تورن شوي کس دپاره د پناه اخیستلو ښار ؤ)، محنایم،"}, {"ref": "None Joshua 2:39", "text": "حشبون او یعزیر د هغو د څړځایونو سره - ټول څلور ښارګوټي."}, {"ref": "None Joshua 2:40", "text": "د ټولو ښارګوټو شمېر چې د مراریانو طایفو یعنې پاتې لاویانو ته ورکړل شول، دولسو ته رسېده."}, {"ref": "None Joshua 2:43", "text": "نو څښتن اسراییلو ته هغه ټوله ځمکه ورکړه چې د هغوی د نیکونو سره یې قسم خوړلی ؤ. هغوی د دې ځمکې ملکیت تر لاسه کړ او هلته ځای په ځای شول."}, {"ref": "None Joshua 2:44", "text": "لکه څنګه چې څښتن د هغوی د نیکونو سره وعده کړې وه، هغه د هغوی په ټوله خاوره کې ارامي راوستله. د هغوی یو دښمن هم نه شو کولای چې د هغوی په وړاندې ودریږي، ځکه چې څښتن اسراییلیانو ته په خپلو ټولو دښمنانو باندې بری ورکړی ؤ."}, {"ref": "None Joshua 2:45", "text": "څښتن چې کومې وعدې د اسراییلو د قوم سره کړې وې، هغه ټولې یې سرته ورسولې."}, {"ref": "None Judges 1:1", "text": "د ابیملک د مړینې څخه وروسته د فواه زوی او د دودو لمسی تولع د اسراییلو د ژغورلو دپاره راغی. هغه د یساکار د قبیلې څخه ؤ او د افرایم په غرنۍ سیمه کې د شامیر په ښارګوټي کې اوسېده."}, {"ref": "None Judges 1:1", "text": "یفتاح یو زړور عسکر ؤ چې د جلعاد څخه ؤ. د هغه د پلار نوم جلعاد ؤ او مور یې بدلمنه وه."}, {"ref": "None Judges 1:1", "text": "د افرایم کسان د جګړې دپاره تیار شول. هغوی د اردن د سیند څخه صافون ته پورې وتل او یفتاح ته یې وویل: «کله چې ته د عمونیانو سره د جګړې دپاره تللې، مونږ دې ولې د مرستې دپاره راونه غوښتلو؟ اوس به مونږ ستا کور ستا سره یوځای وسوځوو!»"}, {"ref": "None Judges 1:1", "text": "اسراییلیانو یوځل بیا د څښتن په وړاندې ګناه وکړه. نو څښتن فلسطینیان پرېښودل چې څلوېښت کاله په هغوی باندې حکومت وکړي."}, {"ref": "None Judges 1:1", "text": "یوه ورځ شمشون تمنې ته لاړ او هلته یې یوه فلسطینۍ انجلۍ ولیدله."}, {"ref": "None Judges 1:1", "text": "څه موده وروسته د غنمو د لو په وخت کې شمشون د خپلې ښځې د لیدلو دپاره ورغی او هغې ته یې د سوغات په توګه یو سېرلی یووړ. شمشون د هغې پلار ته وویل: «زه غواړم چې د خپلې ښځې کوټې ته لاړ شم.» خو هغه ورته اجازه ورنه کړه چې دننه لاړ شي."}, {"ref": "None Judges 1:1", "text": "یوه ورځ شمشون د فلسطینیانو ښار غزې ته لاړ او هلته هغه یوه بدلمنه ښځه ولیدله او د هغې کور ته ورغی چې شپه ورسره تېره کړي."}, {"ref": "None Judges 1:1", "text": "د افرایم په غرنۍ سیمه کې یو سړی چې نوم یې میخا ؤ، اوسېده."}, {"ref": "None Judges 1:1", "text": "په هغې زمانه کې اسراییلو پاچا نه درلود. د دان قبیلې یو ځای لټاوه چې په کې واوسیږي، ځکه چې هغوی لا تر هغه وخته پورې د اسراییلو د قبیلو په منځ کې خپله ځمکه تر لاسه کړې نه وه."}, {"ref": "None Judges 1:1", "text": "په هغې زمانه کې چې اسراییلو پاچا نه درلود، د لاوي د قبیلې یو کس چې د افرایم د غرنۍ سیمې په یو لېرې ځای کې اوسېده، د بیت لحم څخه چې د یهودا په سیمه کې ؤ، یوه وینځه وکړه."}, {"ref": "None Judges 1:2", "text": "هغه درویشت کاله د اسراییلو مشر ؤ. بیا هغه مړ شو او په شامیر کې ښخ کړای شو."}, {"ref": "None Judges 1:2", "text": "جلعاد د خپلې نکاح کړې ښځې څخه نور زامن هم درلودل. کله چې هغوی لوی شول، نو یفتاح یې د کور څخه وویست او ورته ویې ویل: «ته به زمونږ په کورنۍ کې میراث تر لاسه نه کړې، ځکه چې ته د بلې ښځې زوی یې.»"}, {"ref": "None Judges 1:2", "text": "خو یفتاح هغوی ته وویل: «ما او زما قوم د عمونیانو سره سخته شخړه درلودله. ما ستاسو څخه مرسته وغوښتله، خو تاسو زمونږ سره مرسته ونه کړه."}, {"ref": "None Judges 1:2", "text": "په هغه وخت کې د زرعه په ښارګوټي کې یو سړی اوسېده چې نوم یې مانوح ؤ او د دان د قبیلې څخه ؤ. د هغه ښځه شنډه وه او اولاد یې نه درلود."}, {"ref": "None Judges 1:2", "text": "کله چې هغه بېرته کور ته راستون شو، نو خپل مور او پلار ته یې وویل: «ما په تمنه کې یوه فلسطینۍ انجلۍ ولیدله. هغه ماته وکړئ، زه غواړم چې د هغې سره واده وکړم.»"}, {"ref": "None Judges 1:2", "text": "هغه شمشون ته وویل: «ما په رښتیا فکر کاوه چې ته د هغې څخه کرکه کوې، نو هغه ما ستا ملګري ته ورکړه. خو د هغې کشره خور د هغې څخه ډېره ښایسته ده، د دې په ځای ته کولای شې د هغې سره واده وکړې.»"}, {"ref": "None Judges 1:2", "text": "د غزې خلک خبر شول چې شمشون هلته دی. نو هغوی هغه ځای کلابند کړ او هغه ته یې ټوله شپه د ښار په دروازه کې انتظار وکړ. هغوی ټوله شپه غلي وو او د ځانونو سره یې ویل: «مونږ به د سهار تر رڼا کېدلو پورې صبر وکړو او بیا به یې ووژنو.»"}, {"ref": "None Judges 1:2", "text": "یوه ورځ هغه خپلې مور ته وویل: «ایا هغه یوولس سوه د سپینو زرو سکې دې په یاد دي چې ستا څخه غلا شوي وو؟ کله چې تا هغه کس ته چې هغه یې پټ کړي وو ښېرې وکړلې زه په هغه ځای کې وم. دا کار ما کړی ؤ.» مور یې وویل: «زویه څرنګه چې تا اقرار وکړ، نو څښتن دې تاته برکت درکړي!»"}, {"ref": "None Judges 1:2", "text": "نو د دان د قبیلې خلکو د خپلو طایفو څخه پنځه تنه جنګي کسان د زرعه او اشتاول څخه ولېږل چې د هغې خاورې وضع وڅېړي چې هغوی غوښتل په کې واوسیږي. کله چې هغه کسان د افرایم غرنۍ سیمې ته ورسېدل، نو د میخا کور ته راغلل او هلته یې شپه تېره کړه."}, {"ref": "None Judges 1:2", "text": "خو هغه وینځه یعنې د لاوي ښځه د لاوي څخه خفه شوه او بېرته د خپل پلار کور ته چې په بیت لحم کې ؤ، لاړه او څلور میاشتې هلته پاتې شوه."}, {"ref": "None Judges 1:3", "text": "د تولع څخه وروسته جلعادي یاییر راغی. هغه دوه ویشت کاله د اسراییلو مشر ؤ."}, {"ref": "None Judges 1:3", "text": "نو یفتاح د خپلو ورونو څخه وتښتېد او د طوب په خاوره کې اوسېده او هلته د هغه په شاوخوا خوشې او بېکاره خلک راټول شول او په هغه پسې شول."}, {"ref": "None Judges 1:3", "text": "کله چې ما ولیدل چې تاسو مرسته نه کوئ، نو ما خپل ژوند په خطر کې واچاوه او د هغوی سره د جګړې دپاره د سرحد څخه واوښتلم او څښتن ماته په هغوی باندې بری راکړ. اوس راغلي یئ چې زما سره جګړه وکړئ؟»"}, {"ref": "None Judges 1:3", "text": "یوه ورځ د څښتن فرښته هغې ښځې ته ښکاره شوه او ورته ویې ویل: «ته شنډه او بې اولاده یې. خو زر به امیدواره شې او زوی به وزېږوې."}, {"ref": "None Judges 1:3", "text": "خو مور او پلار یې ورڅخه پوښتنه وکړه: «ایا ستا د قوم او خپلوانو په منځ کې انجلۍ نشته چې ته غواړې په هغو ناسنته فلسطینیانو کې ښځه وکړې؟» خو شمشون خپل پلار ته وویل: «همدا انجلۍ راته وکړئ. هغه زما خوښه ده.»"}, {"ref": "None Judges 1:3", "text": "شمشون وویل: «دا ځل چې په فلسطینیانو باندې هرڅه وکړم زه به بې ګناه یم!»"}, {"ref": "None Judges 1:3", "text": "خو شمشون تر نیمې شپې پورې هلته په بستره کې پروت ؤ. بیا هغه پاڅېده او د ښار دروازه یې د هغې د چوکاټ سره راونیوله او د اړم او ټولو شیانو سره یې وویستله. هغه یې په خپلو اوږو باندې کېښودله او د هغې غونډۍ سرته یې چې حبرون ته مخامخ وه، یووړله."}, {"ref": "None Judges 1:3", "text": "هغه سپین زر بېرته خپلې مور ته ورکړل او هغې وویل: «زه دا سپین زر د خپل زوی له خوا څښتن ته وقف کوم. د دې څخه به د لرګي د بت په جوړولو کې چې د سپینو زرو پوښ به ورته ورکړل شي، کار واخیستل شي. نو زه به دا سپین زر بېرته تاته درکړم.»"}, {"ref": "None Judges 1:3", "text": "هغوی په هغه ځای کې د ځوان لاوي لهجه وپېژندله، نو هغوی ورغلل او پوښتنه یې ترې وکړه: «ته دلته څه کوې؟ چا دلته راوستلی یې؟»"}, {"ref": "None Judges 1:3", "text": "بیا د هغې مېړه پرېکړه وکړه چې د هغې پسې لاړ شي او هغه هڅوي چې بېرته راشي. نو خپل نوکر او دوه خره یې د ځان سره واخیستل. کله چې د خپل خسر کور ته ورسېده، ښځې یې هغه دننه راوست. کله چې د هغې پلار هغه ولیده، نو د هغه په لیدلو خوشحاله شو او هرکلی یې ورته ووایه."}, {"ref": "None Judges 1:4", "text": "هغه دېرش زامن درلودل چې هر یو یې په خپل خره باندې سپرېده. هغوی په جلعاد کې دېرش ښارګوټي درلودل چې تر نن ورځې پورې د یاییر د ښارګوټو په نوم یادیږي."}, {"ref": "None Judges 1:4", "text": "څه موده وروسته عمونیانو د اسراییلو سره جنګ پیل کړ."}, {"ref": "None Judges 1:4", "text": "خو د افرایم خلکو وویل: «تاسو د جلعاد خلک یوازې د افرایم مهاجرین یئ. اوس هم په هغې خاوره کې اوسېږئ چې هغه د افرایم او منسي خاوره ده.» نو یفتاح د جلعاد لښکرې سره راټولې کړلې. بیا هغوی حمله وکړه او د افرایم لښکرو ته یې ماتې ورکړه."}, {"ref": "None Judges 1:4", "text": "پام کوه چې هېڅ شراب ونه څښې او حرام شیان ونه خورې."}, {"ref": "None Judges 1:4", "text": "د هغه مور او پلار نه پوهېدل چې دا کار د څښتن له خوا ؤ، ځکه چې څښتن یوه موقع کتله چې د فلسطینیانو په وړاندې کوم عمل وکړي. په هغه وخت کې فلسطینیانو په اسراییلو باندې حکومت کاوه."}, {"ref": "None Judges 1:4", "text": "نو هغه لاړ او درې سوه ګیدړان یې ونیول او یوه یوه جوړه یې لکۍ په لکۍ سره وتړل. بیا هغه د لکیو په هرې جوړې پورې یو یو څراغ وتاړه."}, {"ref": "None Judges 1:4", "text": "څه موده وروسته، شمشون په یوې انجلۍ باندې چې دلیله نومېدله او د سورق په دره کې اوسېدله، مین شو."}, {"ref": "None Judges 1:4", "text": "خو هغه دا سپین زر بېرته خپلې مور ته ورکړل. هغې دوه سوه د سپینو زرو سکې واخیستلې او یو زرګر ته یې ورکړل او هغه د لرګي یو بت جوړ کړ او د سپینو زرو پوښ یې ورته ورکړ. بیا یې هغه د میخا په کور کې کېښود."}, {"ref": "None Judges 1:4", "text": "هغه ځواب ورکړ: «ما د میخا سره یو قرارداد کړی دی او هغه ماته د کاهنتوب د خدمت په بدل کې اجوره راکوي.»"}, {"ref": "None Judges 1:4", "text": "د هغه خسر ټینګار وکړ چې هغه پاتې شي، نو هغه هلته درې ورځې پاتې شو. هغوی هلته خپله ډوډۍ خوړله او شپې یې تېرولې."}, {"ref": "None Judges 1:5", "text": "کله چې یاییر مړ شو، هغه په قامون کې ښخ کړای شو."}, {"ref": "None Judges 1:5", "text": "نو د جلعاد مشران لاړل چې یفتاح د طوب د خاورې څخه راولي."}, {"ref": "None Judges 1:5", "text": "جلعادیانو د اردن د سیند څخه د تېرېدلو ټولې لارې ونیولې چې د افرایمیانو د تېښتې مخه ونیسي. نو کله به چې د افرایمیانو څخه کوم یو غوښتل چې د اردن د سیند څخه تېر شي، نو د جلعاد خلکو به ورڅخه پوښتنه کوله چې «ایا ته افرایمی یې؟» که چېرې هغه به وویل چې «نه، زه نه یم.»"}, {"ref": "None Judges 1:5", "text": "کله چې ستا زوی وشو، نو هېڅکله باید د هغه ویښتان ونه خرایې، ځکه چې هغه به د زېږېدلو د ورځې څخه د نذر په توګه خدای ته وقف شي. هغه به اسراییل د فلسطینیانو څخه وژغوري.»"}, {"ref": "None Judges 1:5", "text": "نو شمشون د خپل مور او پلار سره تمنې ته روان شو. کله چې هغه د تمنې د انګورو د باغونو څخه تېرېده، نو یو ځوان زمری راغی او په شمشون باندې وغورېده."}, {"ref": "None Judges 1:5", "text": "بیا یې څراغونو ته اور واچاوه او ګیدړان یې د فلسطینیانو په ولاړو فصلونو کې خوشې کړل. هغه د ګېډیو انبارونه او ولاړ فصلونه د انګورو او زیتونو د باغونو سره وسوځول."}, {"ref": "None Judges 1:5", "text": "د فلسطینیانو مشران هغې ته ورغلل او ورته ویې ویل: «شمشون وغولوه چې تاته ووایي چې هغه ولې دومره قوي دی. همدارنګه مونږ څنګه وکولای شو هغه مغلوب کړو، ترڅو هغه وتړو او کمزوری یې کړو. که دا کار وکړې، نو مونږ هر یو به تاته یوولس سوه د سپینو زرو سکې درکړو.»"}, {"ref": "None Judges 1:5", "text": "میخا بتخانه درلودله. هغه یو څو بتان او یو سپېڅلی پېشبند جوړ کړ او د خپلو زامنو څخه یې یو تن د خپل کاهن په توګه وټاکه."}, {"ref": "None Judges 1:5", "text": "بیا هغوی ورته وویل: «مهرباني وکړه د خدای څخه سوال وکړه چې مونږ به په دې سفر کې بریالي شو که نه.»"}, {"ref": "None Judges 1:5", "text": "د څلورمې ورځې په سهار هغوی وختي پاڅېدل او تګ ته تیار شول. خو خسر خپل زوم ته وویل: «لومړی یو څه وخورئ چې د سفر دپاره تکړه شئ او وروسته به بیا لاړ شئ.»"}, {"ref": "None Judges 1:6", "text": "اسراییلیانو یوځل بیا د څښتن په وړاندې ګناه وکړه او د بعل او عشتاروت بتانو او د سوریې، صیدون، موآب، عمون او فلسطین خدایانو ته یې په عبادت لاس پورې کړ. هغوی څښتن پرېښود او د هغه عبادت کول یې بس کړل."}, {"ref": "None Judges 1:6", "text": "هغوی هغه ته وویل: «راشه او زمونږ قوماندان شه، ترڅو مونږ وکولای شو د عمونیانو سره جګړه وکړو.»"}, {"ref": "None Judges 1:6", "text": "نو هغوی به ویل چې «سمه ده، ته شبولت ووایه.» خو هغه به «سبولت» ویل، ځکه چې هغه به یې سم نه شو تلفظ کولای، نو هغه کس به یې نیوه او هلته به یې واژه. په هغه وخت کې دوه څلوېښت زره افرایمیان د اردن د سیند په غاړه ووژل شول."}, {"ref": "None Judges 1:6", "text": "بیا هغه ښځه خپل مېړه ته ورغله او ورته ویې ویل: «ماته د خدای یو نبي راغی. هغه د خدای د فرښتې په شان ښکاره کېده او ډېر هیبتناک ؤ. ما د هغه څخه دا پوښتنه ونه کړه چې ته د کوم ځای څخه راغلی یې او هغه هم ماته خپل نوم ونه ښوده."}, {"ref": "None Judges 1:6", "text": "ناڅاپه د څښتن روح هغه قوي کړ او هغه په تشو لاسونو زمری دوه ټوټې کړ لکه یو سېرلی چې دوه ټوټې شي. خو هغه خپل مور او پلار ته په دې هکله څه ونه ویل."}, {"ref": "None Judges 1:6", "text": "کله چې فلسطینیانو پوښتنه وکړه چې «دا کار چا کړی دی؟» کوم چا هغوی خبر کړل چې «دا کار شمشون کړی دی، ځکه چې د هغه خسر چې د تمنې څخه دی، د شمشون ښځه د هغه ملګري ته واده کړې وه.» نو فلسطینیان لاړل او هغه ښځه او د هغې پلار یې ژوندي وسوځول."}, {"ref": "None Judges 1:6", "text": "نو دلیلې شمشون ته وویل: «مهرباني وکړه ماته ووایه چې ته ولې دومره قوي یې. څنګه څوک کولای شي چې تا وتړي او کمزوری دې کړي؟»"}, {"ref": "None Judges 1:6", "text": "په هغه زمانه کې اسراییلو پاچا نه درلود، نو هرچا به هغه کارونه کول چې زړه یې غوښتل."}, {"ref": "None Judges 1:6", "text": "کاهن هغوی ته په ځواب کې وویل: «په خیر لاړ شئ، څښتن به تاسو په دې سفر کې وساتي.»"}, {"ref": "None Judges 1:6", "text": "نو هغوی دواړه سره کښېناستل او ویې خوړل او ویې څښل. بیا خسر یې ورته وویل: «مهرباني وکړئ نن شپه هم زمونږ سره پاتې شئ او په خوشحالۍ سره یې تېره کړئ.»"}, {"ref": "None Judges 1:7", "text": "نو څښتن په هغوی باندې په قهر شو او هغوی یې فلسطینیانو او عمونیانو ته په لاس ورکړل،"}, {"ref": "None Judges 1:7", "text": "خو یفتاح په ځواب کې وویل: «تاسو زما څخه دومره کرکه کوله چې زه مو د خپل پلار د کور پرېښودلو ته مجبور کړم. اوس چې په تاسو باندې تکلیف راغلی دی، نو ماته راغلئ؟»"}, {"ref": "None Judges 1:7", "text": "یفتاح شپږ کاله د اسراییلو مشري وکړه. بیا هغه مړ شو او په جلعاد کې په خپل ښارګوټي کې ښخ کړای شو."}, {"ref": "None Judges 1:7", "text": "خو هغه راته وویل چې ته به امیدواره شې او یو زوی به وزېږوې. شراب به نه څښې او حرام شیان به نه خورې، ځکه چې دا هلک به د زېږېدلو د وخت څخه نیولې د مرګ تر ورځې پورې د نذر په توګه څښتن ته وقف وي.»"}, {"ref": "None Judges 1:7", "text": "بیا هغه لاړ او د هغې انجلۍ سره یې خبرې وکړې او هغه یې خوښه شوه."}, {"ref": "None Judges 1:7", "text": "شمشون هغوی ته وویل: «څرنګه چې تاسو داسې کار کړی دی، نو زه قسم خورم چې ترڅو پورې مې ستاسو څخه د هغوی بدل نه وي اخیستی تر هغې پورې به ارام نه کښېنم.»"}, {"ref": "None Judges 1:7", "text": "شمشون په ځواب کې وویل: «که چېرې څوک ما د لیندې په اوو نویو مزو باندې چې وچ شوي نه وي وتړي، نو زه به کمزوری شم او د عادي خلکو په شان به شم.»"}, {"ref": "None Judges 1:7", "text": "په دې وخت کې هلته یو ځوان لاوي ؤ چې د یهودا د بیت لحم په ښارګوټي کې اوسېده."}, {"ref": "None Judges 1:7", "text": "نو هغه پنځه کسان روان شول او د لایش ښار ته لاړل. هغوی ولیدل چې د هغه ځای خلک د صیدونیانو په شان په سوله او امن کې ژوند کوي. هغوی ارام خلک وو او په خاطر جمعۍ سره یې ژوند تېراوه. د هغوی سره د هېڅ شي کمی نه ؤ. هغوی د صیدونیانو څخه لېرې اوسېدل او د بل چا سره یې معامله نه درلودله."}, {"ref": "None Judges 1:7", "text": "لاوي کوښښ کاوه چې لاړ شي، خو خسر یې ورڅخه په کلکه وغوښتل چې پاتې شي، نو هغه بله شپه هم هلته پاتې شو."}, {"ref": "None Judges 1:8", "text": "اتلس کاله هغوی په اسراییلیانو باندې ظلم وکړ او ټول اسراییلیان یې چې په جلعاد کې د اردن د سیند ختیځ خواته د اموریانو په هېواد کې اوسېدل، وځورول."}, {"ref": "None Judges 1:8", "text": "مشرانو وویل: «خو مونږ اوس ستا څخه غواړو چې بېرته راشې. که چېرې د عمونیانو سره په جنګ کې زمونږ مشري وکړې، نو مونږ به تا د جلعاد د ټولو خلکو مشر کړو.»"}, {"ref": "None Judges 1:8", "text": "د یفتاح څخه وروسته ابصان چې د بیت لحم څخه ؤ د اسراییلو مشري وکړه."}, {"ref": "None Judges 1:8", "text": "بیا مانوح څښتن ته دعا وکړه او ویې ویل: «ای څښتنه، زه تاته سوال کوم، هغه نبي چې تا رالېږلی ؤ هغه پرېږده چې یوځل بیا راشي او مونږ ته وښایي چې کله هغه هلک پیدا شي د هغه روزنه څنګه وکړو.»"}, {"ref": "None Judges 1:8", "text": "څه موده وروسته کله چې شمشون د هغې سره د واده کولو دپاره بېرته روان شو، هغه د لارې څخه راوګرځېد چې د هغه زمري مړی وویني چې وژلی یې ؤ. هغه زمري ته وکتل او حیران شو چې د هغه په بدن کې ډېرې د شاتو مچۍ او شات وو."}, {"ref": "None Judges 1:8", "text": "شمشون په هغوی باندې ډېره سخته حمله وکړه او ډېر کسان یې ورڅخه ووژل. بیا هغه لاړ او د عیطام د ګټ په سمڅه کې اوسېده."}, {"ref": "None Judges 1:8", "text": "نو فلسطیني مشرانو دلیلې ته د کمان اووه نوي مزي چې وچ شوي نه وو، راوړل او هغې شمشون وتاړه."}, {"ref": "None Judges 1:8", "text": "هغه د بیت لحم څخه لاړ چې د اوسېدلو دپاره کوم بل ځای پیدا کړي. هغه په لاره کې د میخا کور ته چې د افرایم په غرنۍ سیمه کې ؤ، راغی."}, {"ref": "None Judges 1:8", "text": "کله چې هغه کسان بېرته زرعه او اشتاول ته راستانه شول، نو خلکو ورڅخه پوښتنه وکړه چې «تاسو څه خبر راوړی دی؟»"}, {"ref": "None Judges 1:8", "text": "د پنځمې ورځې په سهار هغه وختي پاڅېده چې لاړ شي، خو د ښځې پلار وویل: «یو څه وخورئ، بیا کولای شئ چې ماسپښین لاړ شئ.» نو هغو دواړو یوځای ډوډۍ وخوړه."}, {"ref": "None Judges 1:9", "text": "عمونیان د یهودا، بنیامین او افرایم د قبیلو سره د جګړې دپاره حتی د اردن د سیند څخه تېر شول. اسراییلیان په ډېر لوی مصیبت اخته شول."}, {"ref": "None Judges 1:9", "text": "یفتاح په ځواب کې وویل: «که چېرې تاسو ما د عمونیانو سره د جګړې دپاره بوځئ او څښتن هغوی ماته په لاس راکړي، ایا زه به په رښتیا ستاسو مشر شم؟»"}, {"ref": "None Judges 1:9", "text": "هغه دېرش زامن او دېرش لورګانې درلودلې. هغه خپلې لورګانې نورو طایفو ته په نکاح ورکړې او د نورو طایفو څخه یې دېرش نجونې راوستلې چې خپلو زامنو ته یې په نکاح کړي. ابصان اووه کاله د اسراییلو مشري وکړه."}, {"ref": "None Judges 1:9", "text": "خدای د مانوح غوښتنه قبوله کړه او په داسې حال کې چې هغه ښځه په پټي کې ناسته وه، فرښته بېرته هغې ته راغله. په هغه وخت کې د هغې مېړه مانوح د هغې سره نه ؤ."}, {"ref": "None Judges 1:9", "text": "هغه په خپلو لاسونو یو څه شات راوتوږل او په لاره کې یې وخوړل. بیا هغه خپل مور او پلار ته ورغی او هغوی ته یې هم لږ ورکړل او هغوی وخوړل. خو شمشون هغوی ته ونه ویل چې دا شات یې د مړ زمري د بدن څخه راخیستي وو."}, {"ref": "None Judges 1:9", "text": "فلسطینیان لاړل او د یهودا په سیمه کې یې خېمې ودرولې او د لحي په ښارګوټي باندې یې حمله وکړه."}, {"ref": "None Judges 1:9", "text": "دلیلې یو څو کسان د خپل کور په بله کوټه کې پټ کړي وو، نو هغې شمشون ته غږ وکړ: «شمشونه، فلسطینیان راغلي دي چې تا ونیسي!» خو شمشون هغه مزي لکه د تار په شان چې په اور کې سوځېدلی وي، وشکول. نو هغوی د شمشون د زور په راز پوه نه شول."}, {"ref": "None Judges 1:9", "text": "میخا د هغه څخه پوښتنه وکړه: «ته د کوم ځای څخه راغلی یې؟» هغه په ځواب کې وویل: «زه لاوي یم او په یهودا کې د بیت لحم څخه یم. د اوسېدلو دپاره ځای لټوم.»"}, {"ref": "None Judges 1:9", "text": "هغوی په ځواب کې وویل: «راځئ چې په لایش باندې حمله وکړو. مونږ هغه ځمکه ولیدله، هغه ډېره ښه ځمکه ده. زړه نازړه کېږئ مه! لاړ شئ او هغه ونیسئ!"}, {"ref": "None Judges 1:9", "text": "کله چې هغه سړی او د هغه وینځه او نوکر پاڅېدل چې لاړ شي، د هغه خسر وویل: «ګورئ، اوس ورځ تېره شوې ده او ماښام نژدې دی. یوه بله شپه هم زمونږ سره پاتې شئ او خوشحاله اوسئ. بیا کولای شئ چې سهار وختي پاڅېږئ او خپل کور ته لاړ شئ.»"}, {"ref": "None Judges 1:10", "text": "بیا اسراییلیانو څښتن ته فریاد وکړ او ویې ویل: «مونږ ستا په وړاندې ګناه کړې ده، ځکه چې ته زمونږ خدای یې او مونږ ته پرېښودلې او د بعل د بتانو عبادت مو پیل کړ.»"}, {"ref": "None Judges 1:10", "text": "د جلعاد مشرانو یفتاح ته په ځواب کې وویل: «څښتن به زمونږ ترمنځ شاهد وي. مونږ وعده کوو څه چې ته وایې هماغسې به کوو.»"}, {"ref": "None Judges 1:10", "text": "بیا هغه مړ شو او په بیت لحم کې ښخ کړای شو."}, {"ref": "None Judges 1:10", "text": "نو هغه په منډه خپل مېړه ته ورغله او ویې ویل: «هغه سړی چې هغه ورځ ماته ښکاره شوی ؤ، هغه بیا راغلی دی.»"}, {"ref": "None Judges 1:10", "text": "د هغه پلار د واده دپاره تیاری نیوه چې شمشون هلته په تمنه کې یوه مېلمستیا چې په هغې زمانه کې د ځوانانو ترمنځ رواج ؤ، جوړه کړه."}, {"ref": "None Judges 1:10", "text": "د یهودا خلکو پوښتنه وکړه: «تاسو ولې په مونږ باندې حمله کوئ؟» هغوی په ځواب کې وویل: «مونږ د دې دپاره راغلي یو چې شمشون ونیسو او هغه کار ورسره وکړو چې هغه زمونږ سره وکړ.»"}, {"ref": "None Judges 1:10", "text": "بیا دلیلې شمشون ته وویل: «تا په ما باندې ملنډې ووهلې او دروغ دې راته وویل. اوس ماته ووایه چې تا څنګه څوک تړلی شي.»"}, {"ref": "None Judges 1:10", "text": "میخا وویل: «زما سره واوسېږه او زما مشاور او کاهن شه. زه به تاته په کال کې لس د سپینو زرو سکې، یو څه کالي او ډوډۍ درکوم.»"}, {"ref": "None Judges 1:10", "text": "کله چې هلته ورسېدلئ، تاسو به ووینئ چې هغه بې غمه خلک دي. هغه یو لوی وطن دی هرڅه چې وغواړئ هلته شته او خدای هغه تاسو ته درکړی دی.»"}, {"ref": "None Judges 1:11", "text": "څښتن هغوی ته دا ځواب ورکړ: «هغه وخت چې مصریانو، اموریانو، عمونیانو، فلسطینیانو،"}, {"ref": "None Judges 1:11", "text": "نو یفتاح د جلعاد د مشرانو سره لاړ او خلکو هغه خپل مشر او قوماندان وټاکه. کومې خبرې چې یفتاح مشرانو ته کړې وې، هغه یې په مصفه کې د څښتن په حضور کې تکرار کړلې."}, {"ref": "None Judges 1:11", "text": "د ابصان څخه وروسته ایلون چې د زبولون د قبیلې څخه ؤ، لس کاله د اسراییلو مشري وکړه."}, {"ref": "None Judges 1:11", "text": "مانوح د خپلې ښځې سره روان شو او هغه سړي ته ورغی او پوښتنه یې ترې وکړه: «ایا ته هغه سړی یې چې زما د ښځې سره دې خبرې کړې وې؟» هغه په ځواب کې وویل: «هو.»"}, {"ref": "None Judges 1:11", "text": "کله چې فلسطینیانو ولیدل چې شمشون څه ډول سړی دی، نو هغوی خپلو دېرشو ځوانانو ته وویل چې د هغه سره په مېلمستیا کې پاتې شي."}, {"ref": "None Judges 1:11", "text": "نو د یهودا درې زره کسان د عیطام د ګټ سمڅې ته لاړل او شمشون ته یې وویل: «ته خبر نه یې چې فلسطینیان په مونږ باندې حکومت کوي؟ تا زمونږ سره څه وکړل؟» هغه په ځواب کې وویل: «کوم کار چې هغوی زما سره کړی ؤ، ما هم د هغوی سره هماغسې کار وکړ.»"}, {"ref": "None Judges 1:11", "text": "هغه وویل: «که چېرې څوک ما په داسې رسیو باندې وتړي چې هېڅ کار ورڅخه اخیستل شوی نه وي، نو زه به کمزوری شم او د عادي خلکو په شان به شم.»"}, {"ref": "None Judges 1:11", "text": "نو د دان د قبیلې څخه شپږ سوه تنه د جګړې دپاره تیار شول او د زرعه او اشتاول څخه روان شول."}, {"ref": "None Judges 1:12", "text": "صیدونیانو، عمالیقیانو او معونیانو په تاسو باندې ظلم کاوه او تاسو ماته فریاد وکړ، ایا د هغوی څخه مې ونه ژغورلئ؟"}, {"ref": "None Judges 1:12", "text": "بیا یفتاح د عمون پاچا ته استازي ورولېږل چې هغه ته ووایي: «ته زمونږ سره څه دښمني لرې؟ تا ولې زمونږ په هېواد باندې حمله کړې ده؟»"}, {"ref": "None Judges 1:12", "text": "بیا هغه مړ شو او د زبولون د سیمې په ایالون نومي ځای کې ښخ کړای شو."}, {"ref": "None Judges 1:12", "text": "بیا مانوح وویل: «کله چې ستا خبرې رښتیا شي، هغه هلک باید څه وکړي؟ هغه باید څه ډول ژوند وکړي؟»"}, {"ref": "None Judges 1:12", "text": "شمشون هغوی ته وویل: «اجازه راکړئ چې تاسو ته یوه معما ووایم. که چېرې تاسو ماته د مېلمستیا په اووه ورځو کې د هغې ځواب راکړ، زه به تاسو ته د کتان دېرش جوړې ساده کالي او دېرش جوړې ښکلي کالي درکړم."}, {"ref": "None Judges 1:12", "text": "هغوی ورته وویل: «مونږ د دې دپاره راغلي یو چې تا وتړو او فلسطینیانو ته دې وسپارو.» شمشون وویل: «ماته قسم وخورئ چې تاسو به مې په خپله نه وژنئ.»"}, {"ref": "None Judges 1:12", "text": "نو دلیلې نوې رسۍ راواخیستې او شمشون یې ورباندې وتاړه. د مخکې ځل په شان فلسطینیان په بله کوټه کې پټ وو. هغې شمشون ته غږ وکړ: «شمشونه، فلسطینیان راغلي دي چې تا ونیسي!» خو هغه د خپلو لاسونو څخه رسۍ لکه د تارونو په شان وشکولې."}, {"ref": "None Judges 1:12", "text": "هغوی لاړل او د یهودا د قریت یعاریم د ښار په لوېدیځ کې یې خېمې ودرولې. په دې خاطر هغه ځای تر نن ورځې پورې د دان د کمپ په نوم یادیږي."}, {"ref": "None Judges 1:12", "text": "خو بادار یې وویل: «نه، مونږ په دې پردي ښار کې چې اسراییلیان په کې نشته نه پاتې کېږو. مونږ به جبعې ته لاړ شو."}, {"ref": "None Judges 1:13", "text": "خو تاسو زه پرېښودم او د نورو خدایانو عبادت مو وکړ، نو زه به نور تاسو ونه ژغورم."}, {"ref": "None Judges 1:13", "text": "د عمون پاچا د یفتاح استازو ته په ځواب کې وویل: «کله چې اسراییلیان د مصر څخه ووتل، هغوی زما ځمکه د ارنون د سیند څخه نیولې د یبوق او د اردن د سیندونو پورې ونیوله. اوس په سوله اییز ډول هغه ماته بېرته راکړه.»"}, {"ref": "None Judges 1:13", "text": "د ایلون څخه وروسته د هلیل زوی عبدون چې د فرعتون څخه ؤ، د اسراییلو مشر شو."}, {"ref": "None Judges 1:13", "text": "د څښتن فرښتې په ځواب کې وویل: «ستا ښځه باید زما په ټولو خبرو باندې عمل وکړي."}, {"ref": "None Judges 1:13", "text": "خو که چېرې تاسو ځواب رانه کړ، تاسو باید ماته دېرش جوړه د کتان ساده کالي او دېرش جوړه ښکلي کالي راکړئ.» هغوی ورته وویل: «ته خپله معما مونږ ته ووایه چې مونږ یې واورو.»"}, {"ref": "None Judges 1:13", "text": "هغوی وویل: «سمه ده، مونږ به ستا لاسونه وتړو او هغوی ته به دې وسپارو. مونږ به تا نه وژنو.» نو هغوی په دوو نویو رسۍ ګانو باندې د هغه لاسونه وتړل او د ګټ څخه یې بېرته راوست."}, {"ref": "None Judges 1:13", "text": "بیا دلیلې شمشون ته وویل: «ته تر اوسه پورې په ما باندې ملنډې وهې او ماته دروغ وایې. اوس راته ووایه چې تا څنګه څوک تړلی شي.» هغه په ځواب کې وویل: «که چېرې ته زما د سر اووه کوڅۍ په کارګاه باندې د تار سره واوبې او په یو مېخ باندې یې کلکې کړې، نو زه به د نورو خلکو په شان کمزوری شم.» نو په هغه وخت کې چې هغه ویده ؤ، دلیلې د هغه د سر اووه کوڅۍ له تار سره واوبدلې"}, {"ref": "None Judges 1:13", "text": "میخا وویل: «اوس زه پوهېږم چې څښتن به راته برکت راکړي، ځکه چې دغه لاوي زما کاهن دی.»"}, {"ref": "None Judges 1:13", "text": "بیا هغوی د هغه ځای څخه لاړل او د میخا کور ته چې د افرایم په غرنۍ سیمه کې ؤ، ورغلل."}, {"ref": "None Judges 1:13", "text": "راځئ کوښښ وکړو چې جبعې یا رامه ته ځانونه ورسوو او د دې دواړو ځایونو څخه په یو ځای کې شپه تېره کړو.»"}, {"ref": "None Judges 1:14", "text": "لاړ شئ هغو خدایانو ته فریاد وکړئ چې تاسو خپلو ځانونو دپاره غوره کړي دي. کله چې د تکلیف سره مخامخ کېږئ، نو پرېږدئ چې هغوی مو وژغوري.»"}, {"ref": "None Judges 1:14", "text": "یفتاح بېرته د عمون پاچا ته استازي ورولېږل"}, {"ref": "None Judges 1:14", "text": "هغه څلوېښت زامن او دېرش لمسیان درلودل چې هر یو به په خپل خر سپرېده. عبدون اته کاله د اسراییلو مشري وکړه."}, {"ref": "None Judges 1:14", "text": "هر شی چې د انګورو څخه جوړیږي هغه باید ونه خوري. هغه دې نه شراب څښي او نه دې حرام شیان خوري. هرڅه چې مې ورته ویلي دي په هغو باندې دې عمل وکړي.»"}, {"ref": "None Judges 1:14", "text": "هغه وویل: د خوړونکي څخه راووت د خوړلو شی د زورور څخه راووت یو خوږ شی درې ورځې وروسته بیاهم هغوی ونه شو کولای چې د معما ځواب پیدا کړي."}, {"ref": "None Judges 1:14", "text": "کله چې شمشون لحي ته ورسېده، فلسطینیان په منډه د هغه خواته ورغلل او چیغې یې وهلې. ناڅاپه د څښتن روح هغه قوي کړ او هغه رسۍ ګانې یې چې د هغه لاسونه ورباندې تړل شوي وو لکه د سوځېدلي کتان په شان وشکولې او هغه ولوېدلې."}, {"ref": "None Judges 1:14", "text": "او په مېخ باندې یې کلکې کړې. هغې بیا شمشون ته غږ وکړ: «شمشونه، فلسطینیان راغلي دي چې تا ونیسي!» هغه د خوب څخه راویښ شو او کارګاه یې د مېخ او تارونو سره راوویستله."}, {"ref": "None Judges 1:14", "text": "هغو پنځو کسانو چې د لایش خاوره یې کتلې وه، خپلو ملګرو ته وویل: «ایا تاسو پوهېږئ چې د دغو کورونو څخه په یو کور کې د لرګیو بت دی چې د سپینو زرو پوښ ورته ورکړل شوی دی؟ هلته نور بتان او سپېڅلی پېشبند هم شته. تاسو څه فکر کوئ چې څه باید وکړو؟»"}, {"ref": "None Judges 1:14", "text": "نو هغوی روان شول او د لمر پرېواته په وخت جبعې ته چې د بنیامین په سیمه کې وه، ورسېدل."}, {"ref": "None Judges 1:15", "text": "خو د اسراییلو خلکو څښتن ته وویل: «مونږ ګناه کړې ده. څه چې ستا خوښه وي زمونږ سره یې وکړه، خو اوس مونږ د عمونیانو څخه وژغوره.»"}, {"ref": "None Judges 1:15", "text": "چې هغه ته ووایي: «دا خبره رښتیا نه ده چې اسراییلو د موآبیانو او عمونیانو ځمکه نیولې وه."}, {"ref": "None Judges 1:15", "text": "بیا هغه مړ شو او د افرایم په سیمه فرعتون کې چې د عمالیقیانو په غرنۍ سیمه کې پروت ؤ، ښخ کړای شو."}, {"ref": "None Judges 1:15", "text": "په څلورمه ورځ هغوی د شمشون ښځې ته وویل: «ته خپل مېړه وغولوه چې مونږ ته د دې معما معنی ووایي او که نه، نو مونږ به تا او ستا د پلار کورنۍ وسوځوو. ایا تاسو مونږ دلته د دې دپاره راغوښتي یو چې لوټ مو کړئ؟»"}, {"ref": "None Judges 1:15", "text": "بیا شمشون د یوه داسې خره د ژامې هډوکی پیدا کړ چې په هماغو نژدې وختونو کې مردار شوی ؤ. هغه خپل لاس وراوږد کړ، هغه یې راواخیست او زر تنه یې ورباندې ووژل."}, {"ref": "None Judges 1:15", "text": "نو دلیلې هغه ته وویل: «ته څنګه وایې چې زه درباندې ګرانه یم، حال دا چې ته په ما باندې باور هم نه کوې؟ دا درېم ځل دی چې ته په ما باندې ملنډې وهې او د خپل زور راز دې ماته نه وایې.»"}, {"ref": "None Judges 1:15", "text": "نو هغوی د میخا کور ته چې هغه ځوان لاوي په کې اوسېده، ننوتل او د هغه لاوي څخه یې د هغه د احوال پوښتنه وکړه."}, {"ref": "None Judges 1:15", "text": "هغوی د لارې څخه راوګرځېدل چې په هغه ځای کې شپه تېره کړي. خو هېچا نه غوښتل چې هغوی د ځان سره د شپې تېرولو دپاره بوځي. نو هغوی لاړل او د ښار په چوک کې کښېناستل."}, {"ref": "None Judges 1:16", "text": "نو هغوی د پردیو خدایانو څخه لاس واخیست او د څښتن عبادت یې پیل کړ. نو څښتن نور د هغوی تکلیفونه نه شول لیدلی."}, {"ref": "None Judges 1:16", "text": "بلکې کله چې اسراییلیان د مصر څخه ووتل، هغوی د دښتې په لاره باندې سرې بحیرې ته او بیا قادش ته لاړل."}, {"ref": "None Judges 1:16", "text": "بیا د شمشون ښځه خپل مېړه ته په ژړا ورغله او ویې ویل: «زه درباندې ګرانه نه یم! ته زما څخه کرکه کوې. تا زما وطندارانو ته یوه معما ویلې ده، خو د هغې معنی دې ماته نه ده ویلې!» شمشون وویل: «ما حتی خپل مور او پلار ته هم نه دي ویلي، نو تاته یې ولې ووایم؟»"}, {"ref": "None Judges 1:16", "text": "نو شمشون وویل: ما زر کسان ووژل د خره د ژامې په هډوکي باندې ما د مړو څخه جوړې ډېرۍ ګانې کړلې د خره د ژامې په هډوکي باندې"}, {"ref": "None Judges 1:16", "text": "دلیلې په دې خبرو باندې چې هره ورځ به یې شمشون ته کولې، هغه ډېر تنګ کړ."}, {"ref": "None Judges 1:16", "text": "په دې وخت کې د دان شپږ سوه عسکر چې په وسلو باندې سمبال وو، د دروازې په خوله کې ولاړ وو."}, {"ref": "None Judges 1:16", "text": "په همدې وخت کې یو زوړ سړی چې ټوله ورځ یې په پټي کې کار کړی ؤ او کور ته روان ؤ راغی. په جبعه کې چې کوم خلک اوسېدل، هغوی زیاتره د بنیامین د قبیلې څخه وو، خو دا سړی په اصل کې د افرایم د غرنۍ سیمې څخه ؤ، خو په جبعه کې اوسېده."}, {"ref": "None Judges 1:17", "text": "بیا د عمونیانو لښکرې د جنګ دپاره تیارې شوې او په جلعاد کې یې خېمې ودرولې. اسراییلیان سره راټول شول او د جلعاد په مصفه کې یې خېمې ودرولې."}, {"ref": "None Judges 1:17", "text": "بیا هغوی د ادوم پاچا ته استازي ولېږل چې د هغه څخه د هغه د هېواد څخه د تېرېدلو دپاره اجازه واخلي، خو د ادوم پاچا هغوی ته اجازه ورنه کړه. هغوی د موآب د پاچا څخه هم دا غوښتنه وکړه، خو هغه هم اجازه ورنه کړه چې د هغوی په هېواد باندې تېر شي. نو اسراییلیان په قادش کې پاتې شول."}, {"ref": "None Judges 1:17", "text": "مانوح وویل: «ستا نوم څه دی؟ کله چې ستا خبرې رښتیا شي، نو بیا به مونږ ستا عزت کوو.»"}, {"ref": "None Judges 1:17", "text": "هغې د مېلمستیا په ټولو اوو ورځو کې وژړل. خو په اوومه ورځ هغه ورته د معما معنی وویله، ځکه چې هغه یې ډېر تنګ کړ. بیا هغې د معما ځواب هغو ځوانانو ته ووایه."}, {"ref": "None Judges 1:17", "text": "کله چې هغه خپلې خبرې خلاصې کړې، نو د ژامې هډوکی یې په ځمکه وغورځاوه او هغه ځای یې د ژامې د هډوکي د غونډۍ په نوم یاد کړ."}, {"ref": "None Judges 1:17", "text": "نو شمشون اخر هغې ته خپل راز ووایه. هغه وویل: «زما د سر ویښتان هېڅکله خریل شوي نه دي، ځکه چې زه د زېږېدلو د وخت څخه خدای ته د نذر په توګه وقف شوی یم. که چېرې زما سر وخریل شي، نو زه به خپل قوت له لاسه ورکړم او د نورو خلکو په شان به کمزوری شم.»"}, {"ref": "None Judges 1:17", "text": "په داسې حال کې چې کاهن د شپږ سوه وسله والو کسانو سره د دروازې په خوله کې ولاړ ؤ، هغه پنځه جاسوسان دننه ننوتل او په سپینو زرو باندې پوښل شوی بت، نور بتان او سپېڅلی پېشبند یې راواخیستل."}, {"ref": "None Judges 1:17", "text": "هغه سړي هغه مسافر د ښارګوټي په چوک کې ولیده او پوښتنه یې ترې وکړه: «د کوم ځای څخه راغلي یئ او چېرته روان یئ؟»"}, {"ref": "None Judges 1:18", "text": "د جلعاد مشرانو یو بل ته وویل: «هرچا چې لومړی په عمونیانو باندې حمله وکړه، هغه به د جلعاد د ټولو خلکو مشر شي.»"}, {"ref": "None Judges 1:18", "text": "بیا هغوی د دښتې په لاره لاړل او د ادوم او د موآب په هېوادونو باندې راتاو شول او د موآب ختیځ خواته راغلل. د ارنون د سیند په بله غاړه باندې یې خېمې ودرولې، خو د ارنون د سیند څخه تېر نه شول، ځکه چې هغه د موآب سرحد ؤ."}, {"ref": "None Judges 1:18", "text": "فرښتې پوښتنه وکړه: «ته ولې غواړې چې زما نوم وپېژنې؟ ځکه چې زما د نوم په معنی باندې پوهېدل د انسان د قدرت څخه وتلی کار دی.»"}, {"ref": "None Judges 1:18", "text": "په اوومه ورځ د لمر پرېواته څخه مخکې د ښارګوټي خلک هغه ته راغلل او ویې ویل: څه شی به خوږ وي ډېر د شاتو څخه؟ څه شی قوي به وي ډېر د زمري څخه؟ شمشون ځواب ورکړ: زما په غوا باندې که تاسو قلبه کړې نه وای نو دا معما به مو حل کړې نه وای"}, {"ref": "None Judges 1:18", "text": "بیا شمشون ډېر تږی شو، نو هغه څښتن ته فریاد وکړ او ویې ویل: «تا خپل بنده ته داسې لوی بری ورکړ. ایا اوس به د تندې څخه مړ کېږم او دې کافرو فلسطینیانو ته به په لاس ورځم؟»"}, {"ref": "None Judges 1:18", "text": "کله چې دلیله پوه شوه چې شمشون ورته حقیقت بیان کړ، نو هغې د فلسطینیانو مشرانو ته دا خبر ورولېږه: «تاسو یوځل بیا راشئ شمشون ماته خپل راز بیان کړ.» نو هغوی راغلل او هغه پیسې چې د هغې سره یې وعده کړې وه، د ځان سره راوړې."}, {"ref": "None Judges 1:18", "text": "کله چې کاهن ولیدل چې دا کسان سپېڅلي شیان وړي، نو د هغوی څخه یې پوښتنه وکړه: «تاسو څه کوئ؟»"}, {"ref": "None Judges 1:18", "text": "لاوي په ځواب کې وویل: «مونږ د یهودا د بیت لحم څخه راغلي یو او د افرایم د غرنۍ سیمې یو لېرې ځای ته چې مونږ په کې اوسېږو، روان یو. خو هېڅوک نه غواړي مونږ خپل کور ته بوځي چې شپه ورسره تېره وکړو."}, {"ref": "None Judges 1:19", "text": "بیا اسراییلیانو سیحون د اموریانو پاچا ته چې پایتخت یې په حشبون کې ؤ، استازي ولېږل او د هغه څخه یې اجازه وغوښتله چې د هغوی د خاورې په لاره باندې خپل هېواد ته لاړ شي."}, {"ref": "None Judges 1:19", "text": "نو مانوح یو سېرلی او یو څه غلې دانې واخیستلې او په یو ګټ باندې یې څښتن ته وړاندې کړل. څښتن د مانوح او د هغه د ښځې د سترګو په وړاندې داسې عجیبه کار وکړ."}, {"ref": "None Judges 1:19", "text": "ناڅاپه د څښتن روح هغه قوي کړ او هغه د اشقلون ښار ته لاړ او د هغه ځای دېرش کسان یې ووژل. هغوی یې لوڅ کړل او د هغوی جامې یې هغو خلکو ته ورکړې چې معما یې حل کړې وه. بیا هغه ډېر په قهر سره بېرته د خپل پلار کور ته لاړ."}, {"ref": "None Judges 1:19", "text": "بیا خدای هلته په لحي کې په ځمکه کې د یو تش ځای څخه اوبه جاري کړلې. شمشون هغه وڅښلې او بیا یې قوت وموند او تازه شو. نو هغه چینه یې د فریاد کوونکي د چینې په نوم یاده کړه او هغه تر اوسه پورې په لحي کې ده."}, {"ref": "None Judges 1:19", "text": "دلیلې شمشون په خپل زنګون باندې ویده کړ، بیا هغې یو سړی راوغوښت او د شمشون د ویښتو اووه کوڅۍ یې وخریلې. نو دلیلې هغه کمزوری کړ او هغه خپل قوت له لاسه ورکړ."}, {"ref": "None Judges 1:19", "text": "هغوی وویل: «غلی شه! خوله دې بنده کړه! زمونږ سره راځه او زمونږ کاهن او مشاور شه. تاته کومه خبره ښه ښکاري، چې د یو کس د کورنۍ کاهن شې او که د اسراییلو د یوې قبیلې کاهن شې؟»"}, {"ref": "None Judges 1:19", "text": "مونږ د خپلو خرو دپاره بوس او پروړه او د خپل ځان او خپلې ښځې او خپل نوکر دپاره ډوډۍ او شراب راوړي دي. مونږ بل هېڅ شي ته اړتیا نه لرو پرته له یو ځای څخه چې په کې ویده شو.»"}, {"ref": "None Judges 1:20", "text": "خو سیحون په اسراییلیانو باندې اعتبار ونه کړ چې د هغه د سیمې له لارې تېر شي. هغه خپل ټول کسان راټول کړل او په یاهص کې یې خېمې ودرولې او په اسراییلیانو باندې یې حمله وکړه."}, {"ref": "None Judges 1:20", "text": "او د شمشون ښځه د هغه ملګري ته چې په واده کې یې د هغه خدمت کاوه، واده شوه."}, {"ref": "None Judges 1:20", "text": "شمشون د فلسطینیانو د واکمنۍ په دوران کې شل کاله د اسراییلو قاضي ؤ."}, {"ref": "None Judges 1:20", "text": "بیا هغې شمشون ته غږ وکړ: «شمشونه، فلسطینیان راغلي دي چې تا ونیسي!» هغه له خوبه راویښ شو او فکر یې وکړ چې زه به د مخکې په شان په یو ټکان سره خپل ځان ازاد کړم. خو شمشون نه پوهېده چې څښتن هغه پریښی ؤ."}, {"ref": "None Judges 1:20", "text": "په دې خبره کاهن ډېر خوشحاله شو. نو هغه سپېڅلي شیان واخیستل او د هغوی سره لاړ."}, {"ref": "None Judges 1:20", "text": "هغه زوړ سړي وویل: «زه خپل کور ته ستاسو د راتللو هرکلی کوم چې شپه راسره وکړئ او زما مېلمانه شئ. خو په چوک کې شپه مه کوئ.»"}, {"ref": "None Judges 1:21", "text": "خو د اسراییلو څښتن خدای اسراییلیان په سیحون او د هغه په لښکر باندې بریالي کړل. نو اسراییلیانو د هغو اموریانو ټوله سیمه چې هغوی په کې اوسېدل، ونیوله."}, {"ref": "None Judges 1:21", "text": "فلسطینیانو هغه ونیوه، سترګې یې ورڅخه وویستلې او غزې ته یې یووړ. هلته هغوی شمشون په برنجي زولنو وتاړه، په زندان کې یې واچاوه او مجبور یې کړ چې غلې دانې مېچن کړي."}, {"ref": "None Judges 1:21", "text": "هغوی خپل ماشومان، حیوانات او خپله شتمني مخکې کړل او په خپله لاره روان شول."}, {"ref": "None Judges 1:21", "text": "نو هغه زوړ سړي هغوی خپل کور ته بوتلل او د هغوی خره یې ماړه کړل. بیا هغوی خپلې پښې ووینځلې او ډوډۍ یې وخوړله."}, {"ref": "None Judges 1:22", "text": "هغوی د اموریانو ټوله سیمه د ارنون د سیند څخه د یبوق تر سیند پورې او د دښتې څخه د اردن تر سیند پورې ونیوله."}, {"ref": "None Judges 1:22", "text": "مانوح خپلې ښځې ته وویل: «مونږ به په رښتیا سره مړه شو، ځکه چې خدای مو لیدلی دی!»"}, {"ref": "None Judges 1:22", "text": "خو د خریلو څخه وروسته د هغه ویښتانو بیا په راشنه کېدلو پیل وکړ."}, {"ref": "None Judges 1:22", "text": "کله چې هغوی د میخا د کور څخه یو څه لېرې لاړل، نو میخا خپل ګاونډیان د جګړې دپاره راوغوښتل او هغوی د دان د کسانو پسې روان شول."}, {"ref": "None Judges 1:22", "text": "په داسې حال کې چې هغوی خپل زړونه خوشحالول، د ښارګوټي ځینې بدکاره خلک د کور څخه راچاپېر شول. هغوی دروازه په زور ووهله او د کور خاوند یعنې زوړ سړي ته یې غږ وکړ: «ستا کور ته چې کوم سړی راغلی دی هغه مونږ ته راوباسه چې بد کار ورسره وکړو.»"}, {"ref": "None Judges 1:23", "text": "نو دا د اسراییلو څښتن خدای ؤ چې د خپل قوم یعنې اسراییلو په خاطر یې اموریان وشړل. ایا تاسو د دې هڅه کوئ چې هغه بېرته واخلئ؟"}, {"ref": "None Judges 1:23", "text": "خو د هغه ښځې په ځواب کې وویل: «که چېرې څښتن زمونږ د وژلو نیت درلودلی، نو هغه به زمونږ نذرانې قبولې کړې نه وای او نه به یې مونږ ته دا ټول شیان ښودلي وای او نه به یې مونږ ته په دې وخت کې دا خبرې کړې وای.»"}, {"ref": "None Judges 1:23", "text": "د فلسطینیانو مشران سره راټول شول چې جشن ونیسي او خپل خدای داجون ته یوه لویه قرباني وړاندې کړي. هغوی وویل: «زمونږ خدای مونږ ته په خپل دښمن شمشون باندې بری راکړی دی!»"}, {"ref": "None Judges 1:23", "text": "څنګه چې هغوی ته ورورسېدل، نو غږ یې ورباندې وکړ چې ودریږي. د دان کسان راوګرځېدل او د میخا څخه یې پوښتنه وکړه: «څه خبره ده؟ دا کسان دې ولې راټول کړي دي او مونږ تعقیبوې؟»"}, {"ref": "None Judges 1:23", "text": "خو د کور خاوند دباندې ووت او هغوی ته یې وویل: «نه، زما دوستانو! داسې خراب او بد اخلاقه کار مه کوئ! دا سړی زما مېلمه دی، داسې شرموونکی کار مه کوئ."}, {"ref": "None Judges 1:24", "text": "هرڅه چې تاسو ته ستاسو خدای کموش درکړي دي، هغه تاسو خپلو ځانونو ته وساتئ، خو هرڅه چې زمونږ څښتن خدای مونږ ته راکړي دي، هغه به مونږ خپلو ځانونو ته وساتو."}, {"ref": "None Judges 1:24", "text": "نو هغې ښځې یو هلک وزېږاوه او په هغه باندې یې شمشون نوم کېښود. هغه لوی شو او څښتن هغه ته برکت ورکړ."}, {"ref": "None Judges 1:24", "text": "میخا په ځواب کې وویل: «تاسو زما کاهن او هغه خدایان چې ما جوړ کړي وو، یووړل. هېڅ شی مو راته نه دی پریښی. بیا څنګه زما څخه پوښتنه کوئ چې څه خبره ده؟»"}, {"ref": "None Judges 1:24", "text": "ګورئ، زه به تاسو ته خپله پېغله لور او زما د مېلمه وینځه راولم، هرڅه چې غواړئ د هغوی سره یې وکړئ، خو د دې سړي سره داسې شرمناکه کار مه کوئ.»"}, {"ref": "None Judges 1:25", "text": "ایا ته د صفور د زوی بالاق څخه چې د موآب پاچا ؤ، ډېر ښه یې؟ ایا هغه کله د اسراییلو سره کومه دعوه کړې ده، یا یې د هغوی سره جګړه کړې ده؟"}, {"ref": "None Judges 1:25", "text": "او هغه وخت چې شمشون د زرعه او اشتاول ترمنځ د دان په کمپ کې ؤ، د څښتن روح د هغه په قوي کولو پیل وکړ."}, {"ref": "None Judges 1:25", "text": "د دان سړیو په ځواب کې وویل: «زمونږ سره بحث مه کوه، هسې نه چې زمونږ ځینې بد خویه کسان درباندې حمله وکړي او ته او ستا کورنۍ به ووژل شئ.»"}, {"ref": "None Judges 1:25", "text": "خو هغو خلکو د هغه خبرو ته غوږ ونه نیوه. نو هغه لاوي خپله وینځه ونیوله او هغوی ته یې دباندې ورولېږله. هغوی هغه بې عزته کړه او ټوله شپه یې ورباندې تېری وکړ او سهار یې پرېښودله چې لاړه شي."}, {"ref": "None Judges 1:26", "text": "درې سوه کاله کیږي چې اسراییلیان په حشبون، عروعیر او د هغو شاوخوا کلیو او هغو ټولو ښارګوټو کې چې د ارنون د سیند په غاړه پراته دي، اوسیږي. تاسو په هغه وخت کې ولې هغه بېرته ونه نیول؟"}, {"ref": "None Judges 1:26", "text": "شمشون هغه هلک ته چې دی یې له لاسه نیولی ؤ وویل: «ما پرېږده چې په هغو ستنو باندې لاس کېږدم چې دغه ودانۍ ورباندې ولاړه ده. زه غواړم چې تکیه ورباندې وکړم.»"}, {"ref": "None Judges 1:26", "text": "نو بیا د دان سړي په خپله لاره روان شول. میخا ولیدل چې هغوی ورباندې ډېر قوي دي، نو هغه بېرته خپل کور ته ستون شو."}, {"ref": "None Judges 1:26", "text": "سهار وختي هغه ښځه بېرته راغله او د هغه کور په دروازه کې چې د هغې مېړه په کې مېلمه ؤ، ولوېدله او د سهار تر رڼا کېدلو پورې هلته پرته وه."}, {"ref": "None Judges 1:27", "text": "ما ستا سره څه بدي نه ده کړې، بلکې ته زما سره بدي کوې او راغلی یې چې جګړه راسره وکړې. څښتن چې قاضي دی، پرېږده چې هغه نن د اسراییلیانو او عمونیانو ترمنځ پرېکړه وکړي چې زمونږ څخه کوم یو په حقه دی، اسراییل یا عمون.»"}, {"ref": "None Judges 1:27", "text": "هغه عبادتځای د سړیو او ښځو څخه ډک ؤ. د فلسطینیانو ټول مشران هلته موجود وو او په بام باندې نژدې درې زره سړي او ښځې وې چې شمشون ته یې کتل چې د هغوی دپاره یې ساعت تېري کوله."}, {"ref": "None Judges 1:27", "text": "سهار د هغې مېړه پاڅېده او کله چې هغه دروازه خلاصه کړه چې په خپله لاره لاړ شي، نو ویې لیدل چې وینځه یې د دروازې په خوله کې پرته وه او لاسونه یې د دروازې په خوله کې ایښي وو."}, {"ref": "None Judges 1:28", "text": "خو د عمون پاچا د یفتاح پیغام ته هېڅ پام ونه کړ."}, {"ref": "None Judges 1:28", "text": "بیا شمشون څښتن ته دعا وکړه: «ای څښتن تعالی، ما در په یاد کړه. ای خدایه یوازې یوځل بیا ماته قوت راکړه چې د فلسطینیانو څخه د خپلو سترګو بدل واخلم.»"}, {"ref": "None Judges 1:28", "text": "هغه خپلې وینځې ته وویل: «پاڅېږه چې لاړ شو.» خو هېڅ ځواب یې وانه ورېد. بیا هغه سړي د هغې مړی په خپل خره باندې کېښود او کور ته روان شو."}, {"ref": "None Judges 1:29", "text": "بیا په یفتاح باندې د څښتن روح نازل شو. څنګه چې هغه د جلعاد او منسي څخه تېر شو، یو لښکر یې تیار کړ او د جلعاد مصفې ته راستون شو او د هغه ځای څخه عمون ته لاړ."}, {"ref": "None Judges 1:29", "text": "نو شمشون هغه دوه منځنۍ ستنې چې ودانۍ ورباندې ولاړه وه ونیولې، یو لاس یې په یوې او بل لاس یې په بلې ستنې باندې کېښود. ستنې یې ټېل وهلې"}, {"ref": "None Judges 1:29", "text": "د هغه ښارګوټي نوم یې د لایش څخه په دان باندې بدل کړ، یعنې د یعقوب د زامنو څخه د یو زوی په نوم چې د هغوی د قبیلې نیکه ؤ."}, {"ref": "None Judges 1:29", "text": "کله چې کور ته ورسېده، نو یو چاقو یې راواخیست او د خپلې وینځې مړی یې دولس ټوټې کړ او د اسراییلو دولسو قبیلو ته یې یوه یوه ټوټه ورولېږله."}, {"ref": "None Judges 1:30", "text": "یفتاح د څښتن سره قسم وخوړ او ویې ویل: «که چېرې عمونیان ماته په لاس راکړې،"}, {"ref": "None Judges 1:30", "text": "او چیغې یې کړې: «پرېږده چې د فلسطینیانو سره یو ځای مړ شم!» هغه په خپل ټول قوت سره ستنې ټېل وهلې او هغه ودانۍ په ټولو مشرانو او نورو خلکو باندې چې په هغه ځای کې وو، راولوېدله. نو په دې ډول د هغو خلکو شمېر چې شمشون د خپل مرګ په وخت کې ووژل د هغو خلکو څخه زیات ؤ چې هغه په خپل ټول ژوندانه کې وژلي وو."}, {"ref": "None Judges 1:30", "text": "د دان سړیو د خپلو ځانونو دپاره د میخا بت ودراوه او یوناتان د جرشون زوی او د موسی لمسي د دان د قبیلې دپاره د کاهن په توګه خدمت کاوه. د هغه اولادې تر هغې پورې د کاهنانو په توګه خدمت کاوه، ترڅو چې هغه خلک جلاوطنه شول."}, {"ref": "None Judges 1:30", "text": "هرچا چې هغه لیدله نو ویل یې: «د کومې ورځې نه چې اسراییلیان د مصر څخه راوتلي دي داسې کار هېڅکله نه لیدل شوی او نه شوی دی. مونږ باید په دې هکله فکر وکړو او خبرې وکړو چې څه باید وکړو.»"}, {"ref": "None Judges 1:31", "text": "نو کله چې زه په بریالیتوب سره راستون شم، نو لومړنی کس چې زما د کور څخه به زما لیدلو ته راووځي، هغه به د څښتن وي او زه به هغه د سوځېدونکې نذارنې په توګه قرباني کړم.»"}, {"ref": "None Judges 1:31", "text": "د هغه ورونه او پاتې کورنۍ راغله چې د هغه مړی یوسي. هغوی د شمشون مړی بېرته یووړ او د خپل پلار مانوح په هدیره کې یې چې د زرعه او اشتاول ترمنځ پرته وه، ښخ کړ. شمشون شل کاله د اسراییلو مشر ؤ."}, {"ref": "None Judges 1:31", "text": "سره له دې چې د خدای کور په شیلوه کې ؤ، خو د دان خلکو هغه بت ته عبادت کاوه چې میخا جوړ کړی ؤ."}, {"ref": "None Judges 1:32", "text": "نو یفتاح د سیند څخه تېر شو او د عمونیانو سره یې جګړه وکړه او څښتن هغه ته بری ورکړ."}, {"ref": "None Judges 1:33", "text": "هغه د عروعیر څخه د منیت د شاوخوا سیمې پورې او د ابیل کرامیم پورې شل ښارګوټي له منځه یووړل. په هغه ځای کې زیاته وژنه وشوه او عمونیانو د اسراییلو له خوا ماتې وخوړله."}, {"ref": "None Judges 1:34", "text": "کله چې یفتاح خپل کور ته چې په مصفه کې ؤ راستون شو، هغه کس چې د هغه مخې ته ورغی د هغه لور وه، هغې نڅا کوله او چمبه یې وهله. دا د هغه یوازېنی اولاد ؤ. له هغې پرته هغه نه زوی درلود او نه لور."}, {"ref": "None Judges 1:35", "text": "کله چې هغه خپله لور ولیدله، نو د غمه یې خپل کالي وشکول او چیغې یې کړې: «ای زما لورې! تا زما زړه مات کړ! ولې دې زه ودردولم؟ ما څښتن ته نذر منلی دی او زه نه شم کولای چې د هغه څخه وګرځم.»"}, {"ref": "None Judges 1:36", "text": "هغې ورته وویل: «که چېرې تا د څښتن سره وعده کړې وي، نو څنګه چې دې ویلي دي هماغسې کار راسره وکړه، ځکه چې څښتن ستا د دښمنانو یعنې عمونیانو څخه ستا بدله واخیستله.»"}, {"ref": "None Judges 1:37", "text": "خو هغې د خپل پلار څخه دا غوښتنه وکړه: «زما دپاره یو کار وکړه. ما د دوو میاشتو دپاره پرېږده چې د خپلو ملګرو سره په غرونو کې وګرځم او هلته ویر وکړم، ځکه چې زه به په پېغلتوب کې مړه شم.»"}, {"ref": "None Judges 1:38", "text": "هغه وویل: «لاړه شه» او هغه یې پرېښودله چې د دوو میاشتو دپاره لاړه شي. هغه د نجونو سره غرونو ته لاړه او ویې ژړل، ځکه چې هغه به ناواده شوې او بې اولاده مړه شي."}, {"ref": "None Judges 1:39", "text": "دوه میاشتې وروسته هغه بېرته خپل پلار ته راغله او د هغې پلار چې څښتن ته کوم نذر منلی ؤ هغه یې پوره کړ او هغه پېغله وه چې مړه شوه. له دې وروسته دا په اسراییلو کې یو رواج شو"}, {"ref": "None Judges 1:40", "text": "چې هر کال به د اسراییلو پېغلې د څلورو ورځو دپاره وتلې او د جلعادي یفتاح د لور دپاره به یې ویر کاوه."}, {"ref": "None Judges 2:1", "text": "بیا ټول اسراییلیان په شمال کې د دان څخه په جنوب کې تر بیرشبع پورې او همدارنګه د جلعاد د خاورې څخه په یوه لویه غونډه کې په مصفه کې د څښتن په حضور کې سره راټول شول."}, {"ref": "None Judges 2:1", "text": "په هغه وخت کې چې اسراییلیان په مصفه کې سره راټول شوي وو، هغوی داسې قسم خوړلی ؤ: «زمونږ څخه به هېڅوک خپله لور بنیامینیانو ته په نکاح نه ورکوي.»"}, {"ref": "None Judges 2:2", "text": "د هغوی شمېر د پیاده عسکرو او مشرانو سره څلور لکه تنه وو چې په هغه ځای کې د څښتن په حضور کې د هغه د قوم په غونډه کې حاضر وو."}, {"ref": "None Judges 2:2", "text": "نو د اسراییلو قوم بیت ییل ته لاړ او هلته تر ماښامه پورې د خدای په حضور کې کښېناستل. هغوی په لوړ اواز سره سخت وژړل"}, {"ref": "None Judges 2:3", "text": "بنیامینیان خبر شول چې ټول اسراییلیان په مصفې کې سره راټول شوي دي. اسراییلیانو د وژل شوې ښځې د مېړه څخه پوښتنه وکړه: «مونږ ته ووایه چې دا ناوړه پېښه څنګه رامنځته شوه.»"}, {"ref": "None Judges 2:3", "text": "او ویې ویل: «ای د اسراییلو څښتن خدایه، د اسراییلو سره ولې داسې وشول؟ د بنیامین قبیله ولې د اسراییلو د منځ څخه ورکه شي؟»"}, {"ref": "None Judges 2:4", "text": "هغه لاوي چې ښځه یې وژل شوې وه، په ځواب کې وویل: «زه او زما وینځه جبعې ته چې د بنیامین په سیمه کې ده، د شپې تېرولو دپاره لاړو."}, {"ref": "None Judges 2:4", "text": "بله ورځ سهار وختي خلکو د قربانۍ ځای جوړ کړ او سوځېدونکې او د سلامتۍ نذرانې یې وړاندې کړې."}, {"ref": "None Judges 2:5", "text": "د شپې د جبعې سړي زما پسې راغلل او کور یې کلابند کړ. هغوی زما د وژلو نیت درلود، خو د دې په ځای هغوی زما وینځه بې عزته کړه او هغه مړه شوه."}, {"ref": "None Judges 2:5", "text": "بیا هغوی د یو بل څخه پوښتنه وکړه: «د اسراییلو د ټولو قبیلو څخه داسې کومه ډله شته چې د مصفې په غونډه کې د څښتن په حضور کې نه وه حاضره شوې؟» هغوی په کلکه دا قسم خوړلی ؤ چې هرڅوک چې په مصفه کې د څښتن په حضور کې حاضر نه شي، هغه دې ووژل شي."}, {"ref": "None Judges 2:6", "text": "ما د هغې مړی راواخیست او هغه مې ټوټې ټوټې کړ او بیا مې د هغې هره ټوټه د اسراییلو د دولسو قبیلو څخه هرې قبیلې ته ولېږله، ځکه چې د جبعې سړیو په اسراییلو کې داسې سپک او شرمناکه کار کړی دی."}, {"ref": "None Judges 2:6", "text": "نو د اسراییلو خلکو د خپلو بنیامیني ورونو دپاره افسوس کاوه او ویل به یې: «نن اسراییلو د خپلو قبیلو څخه یوه قبیله له لاسه ورکړه."}, {"ref": "None Judges 2:7", "text": "اوس تاسو د اسراییلو ټول قوم باید په خپله پرېکړه وکړئ چې په دې هکله څه وکړو!»"}, {"ref": "None Judges 2:7", "text": "اوس د هغو بنیامینیانو دپاره چې ژوندي پاتې شوي دي، څه وکړو چې د هغوی دپاره ښځې پیدا کړو؟ ځکه چې مونږ د څښتن په نوم قسم خوړلی دی چې خپلې لورګانې به هغوی ته نه ورکوو.»"}, {"ref": "None Judges 2:8", "text": "ټول خلک یوځای پاڅېدل او ویې ویل: «زمونږ څخه به هېڅوک خپلې خېمې یا خپل کور ته نه ځي."}, {"ref": "None Judges 2:8", "text": "کله چې هغوی پوښتنه وکړه: «ایا د اسراییلو د قبیلو څخه کومه ډله د مصفې په غونډه کې حاضره شوې نه وه؟» هغوی ته معلومه شوه چې د یابیش څخه چې په جلعاد کې دی هېڅوک نه ؤ راغلی."}, {"ref": "None Judges 2:9", "text": "مونږ به داسې کار وکړو چې پچه به واچوو او په جبعې باندې د حملې دپاره به یو څو کسان وټاکو."}, {"ref": "None Judges 2:9", "text": "ځکه کله چې هغوی خلک وشمېرل، نو ورته معلومه شوه چې د یابیش جلعاد څخه هېڅوک هلته نه ؤ."}, {"ref": "None Judges 2:10", "text": "د اسراییلو د ټولو قبیلو څخه به د هرو سلو کسانو څخه لس کسان لښکر ته ډوډۍ رسوي او نور دې لاړ شي او د جبعې خلکو ته دې د هغه ناوړه کار په خاطر سزا ورکړي چې هغوی په اسراییلو کې کړی دی.»"}, {"ref": "None Judges 2:10", "text": "نو غونډې خپل دولس زره زړور کسان ولېږل او هغوی ته یې دا امر ورکړ: «لاړ شئ او د یابیش ټول خلک د ښځو او ماشومانو سره ووژنئ،"}, {"ref": "None Judges 2:11", "text": "نو د اسراییلو ټول سړي د یو مقصد دپاره سره راټول شول چې په ښارګوټي باندې حمله وکړي."}, {"ref": "None Judges 2:11", "text": "ټول نارینه او همدارنګه هغه ټولې ښځې چې پېغلې نه وي، ووژنئ.»"}, {"ref": "None Judges 2:12", "text": "اسراییلیانو د بنیامین د قبیلې ټولې سیمې ته استازي ولېږل چې ورته ووایي: «تاسو ولې داسې جرم کړی دی؟"}, {"ref": "None Judges 2:12", "text": "هغوی د جلعاد په یابیش باندې حمله وکړه او د څلور سوه پېغلو سره چې هلته یې پیدا کړې وې د شیلوه کمپ ته چې د کنعان په خاوره کې ؤ، راستانه شول."}, {"ref": "None Judges 2:13", "text": "اوس د جبعې هغه بدکاره سړي مونږ ته تسلیم کړئ، ترڅو هغوی ووژنو او د اسراییلو څخه دا بدي لېرې کړو.» خو بنیامینیانو د خپلو نورو اسراییلي ورونو خبرو ته غوږ ونه نیوه."}, {"ref": "None Judges 2:13", "text": "بیا ټولې غونډې هغو پاتې بنیامینیانو ته چې د رمون د ګټ سره اوسېدل، یو پیغام ولېږه او هغوی ته یې د سولې وړاندیز وکړ."}, {"ref": "None Judges 2:14", "text": "هغوی د بنیامین د ټولو ښارګوټو څخه راغلل او په جبعې کې سره راټول شول چې د اسراییلیانو په وړاندې جګړه وکړي."}, {"ref": "None Judges 2:14", "text": "نو بنیامینیان بېرته راغلل او اسراییلیانو هغوی ته د یابیش هغه نجونې چې ژوندۍ پاتې شوې وې، ورکړې. خو دا نجونې د هغوی ټولو دپاره بس نه وې."}, {"ref": "None Judges 2:15", "text": "د اسراییلو خلک په بنیامینیانو باندې ډېر خفه وو، ځکه چې څښتن د هغوی د قبیلو ترمنځ بې اتفاقي پیدا کړې وه."}, {"ref": "None Judges 2:16", "text": "نو د غونډې مشرانو وویل: «د بنیامین د قبیلې ټولې ښځې وژل شوې دي. نو څه باید وکړو چې د هغوی پاتې سړیو ته ښځې پیدا کړو؟"}, {"ref": "None Judges 2:17", "text": "اسراییلیانو څلور لکه روزل شوي عسکر سره راټول کړل چې په هغو کې بنیامینیان شامل نه وو."}, {"ref": "None Judges 2:17", "text": "پاتې ژوندي بنیامینیان باید وارثان ولري، ترڅو د اسراییلو یوه قبیله د تل دپاره له منځه لاړه نه شي."}, {"ref": "None Judges 2:18", "text": "اسراییلیان په بیت ییل کې د عبادت ځای ته لاړل او هلته یې د خدای څخه پوښتنه وکړه: «کومه قبیله به لومړی په بنیامینیانو باندې حمله کوي؟» څښتن په ځواب کې وویل: «د یهودا قبیله.»"}, {"ref": "None Judges 2:18", "text": "مونږ نه شو کولای چې خپلې لورګانې هغوی ته ورکړو، ځکه چې مونږ قسم خوړلی دی چې هرڅوک چې بنیامینیانو ته لور ورکړي په هغه باندې دې لعنت وي.»"}, {"ref": "None Judges 2:19", "text": "سبا سهار وختي اسراییلیان روان شول او د جبعې ښارګوټي ته نژدې یې خېمې ودرولې."}, {"ref": "None Judges 2:19", "text": "بیا هغوی دا فکر وکړ چې په شیلوه کې د څښتن دپاره کلنی جشن نیول کیږي. (شیلوه د بیت ییل په شمال او د لبونه په جنوب کې او د هغې لارې په ختیځ کې ده چې د شکیم او بیت ییل ترمنځ ده.)"}, {"ref": "None Judges 2:20", "text": "هغوی لاړل چې د بنیامین په لښکرو باندې حمله وکړي او جبعې ته مخامخ یې د جګړې دپاره سنګرونه ونیول."}, {"ref": "None Judges 2:20", "text": "هغوی بنیامینیانو ته وویل: «لاړ شئ او د انګورو په باغونو کې پټ شئ"}, {"ref": "None Judges 2:21", "text": "د بنیامین لښکر د ښارګوټي څخه راووت او په هغه ورځ یې د جګړې په ډګر کې دوه ویشت زره اسراییلیان ووژل."}, {"ref": "None Judges 2:21", "text": "او هلته انتظار وباسئ. کله چې د شیلوه انجونې د جشن په دوران کې د نڅا دپاره دباندې راووځي، تاسو د انګورو د باغونو څخه راووځئ او د هغو څخه هر یو خپلو ځانونو ته یوه یوه انجلۍ په زور راونیسئ او د ځان سره یې د بنیامین خاورې ته بوځئ چې ستاسو ښځې شي."}, {"ref": "None Judges 2:22", "text": "که چېرې د هغوی پلرونه او ورونه تاسو ته راشي او اعتراض وکړي، نو تاسو کولای شئ چې هغوی ته داسې ووایئ: ‹مهرباني وکړئ مونږ ته اجازه راکړئ چې هغوی وساتو، ځکه چې مونږ هغوی د جنګ په دوران کې ستاسو څخه نه دي نیولې چې زمونږ ښځې شي. څرنګه چې تاسو هغوی مونږ ته نه دي راکړې، نو تاسو د خپل قسم په ماتولو ګناهکار نه یئ.›»"}, {"ref": "None Judges 2:23", "text": "بنیامینیانو همداسې وکړل. هغوی هر یو د هغو نجونو څخه چې په شیلوه کې یې نڅا کوله، یوه یوه انجلۍ د خپل ځان دپاره راونیوله او هغوی یې خپلې سیمې ته بوتللې. بیا هغوی خپل ښارګوټي بېرته اباد کړل او هلته اوسېدل."}, {"ref": "None Judges 2:24", "text": "نو اسراییلیان د دوهم ځل دپاره ووتل چې د بنیامینیانو د عسکرو په وړاندې وجنګیږي."}, {"ref": "None Judges 2:24", "text": "نو اسراییلیان هم هر یو بېرته خپلې قبیلې، خپلې کورنۍ او خپلې ځمکې ته لاړل."}, {"ref": "None Judges 2:25", "text": "په هماغه ورځ بنیامینیان د جبعې څخه راووتل او دا ځل یې اتلس زره روزل شوي اسراییلي عسکر ووژل."}, {"ref": "None Judges 2:25", "text": "په هغه زمانه کې اسراییلو پاچا نه درلود، نو هرچا به هغه کارونه کول چې زړه یې غوښتل."}, {"ref": "None Judges 2:26", "text": "بیا د اسراییلو ټول خلک بیت ییل ته لاړل او هلته یې وژړل. هغوی د څښتن په حضور کې کښېناستل، تر ماښامه پورې یې روژه ونیوله او څښتن ته یې سوځېدونکې او د سلامتۍ نذرانې وړاندې کړې."}, {"ref": "None Judges 2:29", "text": "نو اسراییلیانو د جبعې په شاوخوا کې کمین ونیوه."}, {"ref": "None Judges 2:30", "text": "په درېمه ورځ هغوی د بنیامینیانو په وړاندې ووتل او د مخکې ځل په شان یې خپل عسکر جبعې ته مخامخ ځای په ځای کړل."}, {"ref": "None Judges 2:31", "text": "بنیامینیان د هغوی سره د مقابلې دپاره راووتل. اسراییلیان په شا لاړل او بنیامینیان د هغوی پسې شول او د ښار څخه لېرې شول. هغوی د مخکې ځل په شان د اسراییلیانو په وژلو پیل وکړ. په بانډو او په هغو لارو باندې چې بیت ییل او جبعې ته تللې وې، دېرش تنه اسراییلیان ووژل شول."}, {"ref": "None Judges 2:32", "text": "بنیامینیانو وویل: «مونږ هغوی ته د مخکې ځل په شان ماتې ورکړه.» خو اسراییلیانو داسې پلان جوړ کړی ؤ چې په شا لاړ شي او هغوی د ښارګوټي څخه لارو ته وباسي."}, {"ref": "None Judges 2:33", "text": "نو کله چې د اسراییلو اصلي لښکر په شا شو او په بعل تامار کې بیا سره راټول شول، نو هغه اسراییلیان چې د جبعې په لوېدیځ کې په کمین کې پټ وو د خپلو ځایونو څخه په منډه راووتل."}, {"ref": "None Judges 2:34", "text": "لس زرو ځانګړو کسانو چې د ټولو اسراییلو څخه غوره شوي وو په جبعې باندې حمله وکړه او جګړه ډېره سخته وه. بنیامینیان نه پوهېدل چې د هغوی بربادي نژدې ده."}, {"ref": "None Judges 2:35", "text": "نو څښتن د اسراییلو سره مرسته وکړه چې بنیامینیانو ته ماتې ورکړي. په هغه ورځ اسراییلیانو پنځه ویشت زره او سل تنه ووژل."}, {"ref": "None Judges 2:36", "text": "نو بنیامینیان پوه شول چې هغوی ماتې خوړلې ده. د اسراییلیانو د جګړې ګټل د اسراییلیانو د لښکرو اصلي ډله د بنیامینیانو څخه بېرته په شا لاړله، ځکه چې هغوی په خپلو کسانو باندې چې د جبعې په شاوخوا کې یې کمین نیولی ؤ، تکیه درلودله."}, {"ref": "None Judges 2:37", "text": "بیا هغو کسانو چې په کمین کې وو د هرې خوا څخه په جبعې باندې حمله وکړه او د هغه ښارګوټي ټول اوسېدونکي یې ووژل او ښار ته یې اور واچاوه."}, {"ref": "None Judges 2:38", "text": "د اسراییلو اصلي لښکر او هغه پټ شویو کسانو په خپل منځ کې یوه نښه ټاکلې وه. کله چې هغوی زیات لوګي ولیدل چې د ښارګوټي څخه پورته کیږي،"}, {"ref": "None Judges 2:39", "text": "نو کوم اسراییلیان چې د ښارګوټي څخه دباندې وو هغه به راګرځي او په بنیامینیانو باندې به حمله کوي. تر دغه وخته پورې بنیامینیانو دېرش تنه اسراییلیان وژلي وو. هغوی د خپلو ځانونو سره ویل: «هو، مونږ هغوی ته د مخکې ځل په شان ماتې ورکړه.»"}, {"ref": "None Judges 2:40", "text": "خو کله چې بنیامینیانو شاته وکتل او ویې لیدل چې د ښارګوټي له هرې خوا څخه اسمان ته لوګی پورته کیږي،"}, {"ref": "None Judges 2:41", "text": "نو بیا اسراییلیان راوګرځېدل او په هغوی باندې یې حمله وکړه. بنیامینیان پوه شول چې یوه بلا ورباندې راتلونکې ده، نو هغوی وارخطا شول."}, {"ref": "None Judges 2:42", "text": "هغوی د اسراییلیانو څخه په شا لاړل او د دښتې خواته په منډو شول، خو ویې نه شو کولای چې وتښتي. هغوی د اصلي لښکر او هغو کسانو ترمنځ راګېر شول چې د ښارګوټي څخه راوتل، نو هغوی له منځه لاړل."}, {"ref": "None Judges 2:43", "text": "اسراییلیانو بنیامینیان کلابند کړل او په دوامداره توګه یې د جبعې تر ختیځه پورې تعقیب کړل او په لاره کې یې ووژل."}, {"ref": "None Judges 2:44", "text": "د بنیامینیانو اتلس زره زړور عسکر ووژل شول."}, {"ref": "None Judges 2:45", "text": "هغه کسان چې ژوندي پاتې وو هغوی په دښته کې د رمون د ګټ خواته وتښتېدل، خو اسراییلیانو په لاره باندې د هغوی پنځه زره تنه ووژل. هغوی تر جدعوم پورې د بنیامینیانو پسې شول او دوه زره تنه یې نور هم ووژل."}, {"ref": "None Judges 2:46", "text": "په هغه ورځ د بنیامینیانو پنځه ویشت زره کسان ووژل شول. هغوی ټول زړور عسکر وو."}, {"ref": "None Judges 2:47", "text": "خو یوازې شپږ سوه تنو وکولای شول چې په دښته کې د رمون ګټ ته وتښتي او څلور میاشتې هغوی هلته پاتې شول."}, {"ref": "None Judges 2:48", "text": "اسراییلیان د پاتې بنیامینیانو پسې راوګرځېدل او هغوی ټول یې د سړیو، ښځو، ماشومانو او حیواناتو سره ووژل او په هغه سیمه کې یې ټول ښارګوټي وسوځول."}, {"ref": "None Leviticus 1:1", "text": "د هارون زامنو ناداب او ابیهو هر یو خپل د اور لوښی راواخیست او په هغې کې یې بل شوي سکاره واچول، خوشبویي یې ورزیاته کړه او هغه یې څښتن ته وړاندې کړل. خو دا اور سپېڅلی نه ؤ، ځکه چې څښتن په هغوی باندې د هغه د وړاندې کولو امر نه ؤ کړی."}, {"ref": "None Leviticus 1:1", "text": "څښتن موسی او هارون ته وویل:"}, {"ref": "None Leviticus 1:1", "text": "څښتن موسی ته وویل:"}, {"ref": "None Leviticus 1:1", "text": "څښتن موسی او هارون ته وویل:"}, {"ref": "None Leviticus 1:1", "text": "څښتن موسی ته وویل:"}, {"ref": "None Leviticus 1:1", "text": "څښتن موسی او هارون ته وویل:"}, {"ref": "None Leviticus 1:1", "text": "د هارون د دوو زامنو د مړینې څخه وروسته چې څښتن ته ورنژدې شول او مړه شول، څښتن د موسی سره خبرې وکړې."}, {"ref": "None Leviticus 1:1", "text": "څښتن موسی ته امر وکړ"}, {"ref": "None Leviticus 1:1", "text": "څښتن موسی ته وویل:"}, {"ref": "None Leviticus 1:1", "text": "څښتن موسی ته وویل:"}, {"ref": "None Leviticus 1:2", "text": "نو څښتن ناڅاپه اور نازل کړ او هغوی یې په خپل حضور کې وسوځول او مړه شول."}, {"ref": "None Leviticus 1:2", "text": "«اسراییلیانو ته ووایئ چې د ټولو حیواناتو له جملې څخه چې په ځمکه باندې ژوند کوي، یعنې هغه حیوانات چې غوښه یې خوړلی شئ، هغه دا دي:"}, {"ref": "None Leviticus 1:2", "text": "«اسراییلیانو ته ووایه چې کله یوه ښځه امیدواره شي او زوی وزېږوي، هغه به اووه ورځې د خپلې میاشتینۍ ناروغۍ په شان ناپاکه وي."}, {"ref": "None Leviticus 1:2", "text": "«کله چې د چا په پوستکي باندې زخم، دانه یا داغ وي چې کېدای شي هغه د پوستکي په یوې ساري ناروغۍ باندې بدله شي، هغه باید هارون کاهن یا د هغه یو زوی ته چې کاهن وي راوستل شي."}, {"ref": "None Leviticus 1:2", "text": "«دا قوانین د هغه کس د پاکېدلو په اړه دي چې د پوستکي د ساري ناروغۍ څخه روغ شوی وي. په هغه ورځ چې د هغه پاکوالی اعلانیږي، باید هغه کاهن ته راوستل شي."}, {"ref": "None Leviticus 1:2", "text": "«د اسراییلیانو سره خبرې وکړئ او ورته ووایئ: کله چې د یو سړي د تناسلي الې څخه زوه راووځي، هغه زوه ناپاکه ده."}, {"ref": "None Leviticus 1:2", "text": "هغه وویل: «خپل ورور هارون ته ووایه چې یوازې په یو مناسب وخت کې دې ډېر سپېڅلي ځای ته چې د پردې شاته دی ورننوځي، ځکه دا هغه ځای دی چې زه په کې په ورېځو کې د لوظ د صندوق د سرپوښ دپاسه راښکاره کېږم. که هغه سرغړونه وکړي، نو وبه وژل شي."}, {"ref": "None Leviticus 1:2", "text": "چې هارون او د هغه زامنو او د اسراییلو ټول قوم ته لاندېني حکمونه ورکړي."}, {"ref": "None Leviticus 1:2", "text": "«د اسراییلو د خلکو سره خبرې وکړه او ورته ووایه چې زه ستاسو څښتن خدای یم."}, {"ref": "None Leviticus 1:2", "text": "«د اسراییلو د ټول قوم سره خبرې وکړه او ورته ووایه: سپېڅلي اوسئ، ځکه چې زه ستاسو څښتن خدای سپېڅلی یم."}, {"ref": "None Leviticus 1:3", "text": "بیا موسی هارون ته وویل: «دا هغه څه دي چې څښتن یې په هکله خبرې کولې او هغه وویل: هغه خلک چې خدمت کوي زما باید وکړي درناوی د سپېڅلتوب زما د ټول قوم په نظر کې به زه دروند یم خو هارون غلی پاتې شو.»"}, {"ref": "None Leviticus 1:3", "text": "هر حیوان چې خلاص سوم ولري او شخوند وهونکی هم وي."}, {"ref": "None Leviticus 1:3", "text": "په اتمه ورځ دې هلک سنت شي."}, {"ref": "None Leviticus 1:3", "text": "کاهن دې د هغه زخم معاینه کړي او که چېرې په هغه کې ویښتان سپین شوي وو او زخم د پوستکي څخه ژور ښکاره کېده، نو دا د پوستکي ساري ناروغي ده. نو کاهن به هغه کس ناپاک اعلان کړي."}, {"ref": "None Leviticus 1:3", "text": "کاهن دې د کمپ څخه دباندې لاړ شي او هغه دې معاینه کړي. که چېرې هغه کس د پوستکي د ساري ناروغۍ څخه روغ شوی وي،"}, {"ref": "None Leviticus 1:3", "text": "که دا زوه د هغه د تناسلي الې څخه رابهیږي یا دا بهېدل د پړسوب له امله بند شوي وي، هغه به ناپاک کړي."}, {"ref": "None Leviticus 1:3", "text": "کله چې هارون د ګناه د نذرانې دپاره یو خوسی او د سوځېدونکې نذرانې دپاره یو پسه راوړي، بیا هغه کولای شي چې ډېر سپېڅلي ځای ته ورننوځي.»"}, {"ref": "None Leviticus 1:3", "text": "د مصر د خلکو په شان کار مه کوئ چې یو وخت تاسو په کې اوسېدلئ، یا د کنعان د خلکو په شان کار مه کوئ چې زه اوس تاسو هلته بیایم."}, {"ref": "None Leviticus 1:3", "text": "تاسو هر یو باید د خپل مور او پلار درناوی وکړئ او باید د سبت د ورځې څخه پیروي وکړئ. زه ستاسو څښتن خدای یم."}, {"ref": "None Leviticus 1:4", "text": "موسی میشاییل او الصافان چې د هارون او موسی د تره عزییل زامن وو، راوغوښتل او ورته ویې ویل: «دلته راشئ، د خپل تره د زامنو مړي د سپېڅلي ځای څخه لېرې کړئ او د کمپ څخه دباندې یې یوسئ.»"}, {"ref": "None Leviticus 1:4", "text": "خو داسې حیوانات شته چې یوازې شخوند وهونکي دي یا یوازې خلاص سوم لري، خو تاسو باید د هغو غوښه ونه خورئ. لکه اوښ، که څه هم هغه شخوند وهونکی دی، خو خلاص سوم نه لري. دا ستاسو دپاره ناپاک دی."}, {"ref": "None Leviticus 1:4", "text": "بیا باید هغه ښځه د وینې د بهېدلو څخه د پاکېدلو دپاره دري دېرش ورځې صبر وکړي. هغه باید هېڅ یو پاک شي ته لاس ورنه وړي او نه دې د پاکېدلو د ورځو د پوره کېدلو پورې سپېڅلې خېمې ته ورننوځي."}, {"ref": "None Leviticus 1:4", "text": "که چېرې د هغه د پوستکي زخم سپین ؤ، خو د پوستکي څخه ژور نه ښکاره کېده او ویښتان په کې سپین شوي نه وو، کاهن دې هغه ناروغه کس د اوو ورځو دپاره د نورو څخه بېل وساتي."}, {"ref": "None Leviticus 1:4", "text": "کاهن به داسې حکم وکړي چې دوه ژوندۍ پاکې مرغۍ، د سبر لږ لرګي، سور تار او د وېلني بوټی دې د پاکوالي د مراسمو دپاره راوړل شي."}, {"ref": "None Leviticus 1:4", "text": "که داسې سړی چې زوه ورڅخه راوځي، که هغه په هرې بسترې باندې څملي او یا په هر شي باندې کښېني هغه شی به ناپاک شي."}, {"ref": "None Leviticus 1:4", "text": "بیا څښتن دا لارښوونې وکړې: «مخکې له دې چې هارون ډېر سپېڅلي ځای ته ننوځي، هغه باید غسل وکړي او د کاهنتوب دغه سپېڅلي کالي دې واغوندي: د کتان کمیس، نېکرونه، پټۍ او لونګۍ."}, {"ref": "None Leviticus 1:4", "text": "تاسو باید زما قوانینو ته غاړه کېږدئ او زما د فرمانونو له مخې عمل وکړئ. زه ستاسو څښتن خدای یم."}, {"ref": "None Leviticus 1:4", "text": "ما مه پرېږدئ او د بتانو عبادت مه کوئ. د فلزاتو څخه خدایان مه جوړوئ او عبادت یې مه کوئ. زه ستاسو څښتن خدای یم."}, {"ref": "None Leviticus 1:5", "text": "نو هغوی راغلل او څنګه چې موسی حکم کړی ؤ، د هغوی مړي یې د کالیو څخه ونیول او د کمپ څخه یې دباندې یووړل."}, {"ref": "None Leviticus 1:5", "text": "غرنۍ سویه، که څه هم هغه شخوند وهونکې ده خو خلاص سوم نه لري، دا ستاسو دپاره ناپاکه ده."}, {"ref": "None Leviticus 1:5", "text": "که چېرې هغه لور وزېږوي، دا ښځه به څوارلس ورځې ناپاکه وي، لکه څنګه چې د میاشتینۍ ناروغۍ په دوران کې ناپاکه کیږي. بیا باید هغه ښځه د وینې د بهېدلو څخه د پاکېدلو دپاره شپږشپېته ورځې صبر وکړي."}, {"ref": "None Leviticus 1:5", "text": "کاهن به په اوومه ورځ هغه بیا معاینه کړي او که چېرې د هغه په نظر کې زخم هماغه شان ښکاره کېده او خپور شوی نه ؤ، کاهن به هغه د نورو اوو ورځو دپاره بېل وساتي."}, {"ref": "None Leviticus 1:5", "text": "بیا به کاهن داسې حکم وکړي چې د دې مرغیو څخه دې یوه د خټو د لوښي دپاسه چې د چینې تازه اوبه په کې وي، حلاله شي."}, {"ref": "None Leviticus 1:5", "text": "هرڅوک چې د هغه د بسترې سره ولګیږي،"}, {"ref": "None Leviticus 1:5", "text": "د اسراییلو قوم دې هارون ته دوه سېرلي د ګناه د نذرانې دپاره او یو پسه د سوځېدونکې نذرانې دپاره ورکړي."}, {"ref": "None Leviticus 1:5", "text": "د دې حکم معنی دا ده چې د اسراییلو خلک به له همدې وخت څخه څښتن ته هغه حیوانات راوړي چې په صحرا کې یې حلالول. هغوی باید هغه کاهن ته د سپېڅلې خېمې د دروازې خولې ته راولي او د سلامتۍ د نذرانو په توګه دې قرباني کړي."}, {"ref": "None Leviticus 1:5", "text": "زما په فرمانونو او قوانینو باندې عمل وکړئ، ځکه څوک چې هغو ته غاړه کېږدي د هغو په وسیله به ژوند وکړي. زه څښتن یم."}, {"ref": "None Leviticus 1:5", "text": "کله چې تاسو د سلامتۍ د نذرانې دپاره څښتن ته یو حیوان قرباني کوئ، هغه په یوې داسې طریقې سره قرباني کړئ چې زما له خوا قبوله شي."}, {"ref": "None Leviticus 1:6", "text": "بیا موسی هارون او د هغه زامنو العازار او ایتامار ته وویل: «خپل ویښتان ګډوډ مه پرېږدئ او خپل کالي مه شلوئ چې دا وښایي چې تاسو غمجن یئ. که چېرې داسې وکړئ، نو تاسو به مړه شئ او څښتن به په ټول قوم باندې په قهر شي. خو نور ټول اسراییلیان کولای شي چې د هغو دوو کسانو دپاره چې څښتن د اور په وسیله له منځه وړي دي، وژاړي."}, {"ref": "None Leviticus 1:6", "text": "سویه که څه هم شخوند وهونکې ده، خو خلاص سوم نه لري. دا ستاسو دپاره ناپاکه ده."}, {"ref": "None Leviticus 1:6", "text": "کله چې د یو زوی یا د یوې لور د زېږولو دپاره د پاکېدلو ورځې خلاصې شي، هغه دې د سپېڅلې خېمې د دروازې په خوله کې کاهن ته ورشي. هغه دې یو وری چې یو کلن وي د سوځېدونکې نذرانې دپاره او یوه قمري یا یوه کوتره د ګناه د نذرانې دپاره راوړي."}, {"ref": "None Leviticus 1:6", "text": "په اوومه ورځ دې کاهن هغه د دوهم ځل دپاره معاینه کړي. که چېرې زخم مړاوی شوی ؤ او په پوستکي کې نه ؤ خپور شوی، کاهن به هغه پاک اعلان کړي، دا یوازې یوه ګرمکه ده. هغه کس باید خپل کالي ووینځي او هغه به پاک شي."}, {"ref": "None Leviticus 1:6", "text": "هغه دې بله ژوندۍ مرغۍ د سبر د لرګي، سور تار او د وېلني د بوټي سره واخلي او د هغې مرغۍ په وینه کې دې غوټه کړي چې د تازه اوبو دپاسه حلاله شوې وي."}, {"ref": "None Leviticus 1:6", "text": "یا په هغه شي باندې کښېني چې هغه سړی ورباندې ناست ؤ، نو هغه کس باید خپل کالي ووینځي او غسل دې وکړي، خو هغه به تر ماښامه پورې ناپاک پاتې شي."}, {"ref": "None Leviticus 1:6", "text": "هارون دې یو غویی د خپلې ګناه د نذرانې دپاره وړاندې کړي چې د خپل ځان او خپلې کورنۍ دپاره کفاره ادا کړي."}, {"ref": "None Leviticus 1:6", "text": "کاهن دې د سپېڅلې خېمې د دروازې په خوله کې هغه وینه د څښتن د قربانۍ په ځای باندې وشیندي او وازګه دې وسوځوي چې بوی یې په څښتن باندې ښه لګیږي."}, {"ref": "None Leviticus 1:6", "text": "هېڅوک دې د خپلو نژدې خپلوانو سره زنا نه کوي. زه څښتن یم."}, {"ref": "None Leviticus 1:6", "text": "غوښه باید په هماغه ورځ چې قرباني کوئ وخورئ یا په راتلونکې ورځ. هرڅه چې تر درېمې ورځې پورې پاتې شي، باید وسوځول شي."}, {"ref": "None Leviticus 1:7", "text": "د خېمې د دروازې د خولې څخه مه ځئ، که نه، نو تاسو به مړه شئ، ځکه چې تاسو د څښتن د مسح کولو په تېلو باندې پاک شوي یئ.» نو څنګه چې موسی ویلي وو، هغوی هماغسې وکړل."}, {"ref": "None Leviticus 1:7", "text": "د خوګ غوښه مه خورئ. هغه باید ناپاک وګڼل شي. هغه خلاص سومان لري، خو شخوند وهونکی نه دی."}, {"ref": "None Leviticus 1:7", "text": "کاهن به د هغې دپاره د کفارې د ادا کولو په خاطر هغه د څښتن په حضور کې وړاندې کړي او هغه ښځه به د وینې د بهېدلو څخه پاکه شي. دا اصول د هغې ښځې دپاره دي چې یو هلک یا یوه انجلۍ وزېږوي."}, {"ref": "None Leviticus 1:7", "text": "خو که چېرې کاهن هغه کس معاینه کړی وي او هغه یې پاک اعلان کړی وي او له هغې څخه وروسته ګرمکه د هغه په بدن باندې خپره شي، هغه باید خپل ځان بیا کاهن ته ورښکاره کړي."}, {"ref": "None Leviticus 1:7", "text": "کاهن به اووه ځلې په هغه کس باندې چې د ساري ناروغۍ څخه پاکیږي، هغه وینه وشیندي او هغه به پاک اعلان کړي. بیا دې هغه ژوندۍ مرغۍ په صحرا کې خوشې کړي."}, {"ref": "None Leviticus 1:7", "text": "هرڅوک چې د هغه سړي سره ولګیږي، باید خپل کالي ووینځي او غسل دې وکړي، خو هغه به تر ماښامه پورې ناپاک پاتې شي."}, {"ref": "None Leviticus 1:7", "text": "بیا دې هغه دوه سېرلي واخلي او د سپېڅلې خېمې د دروازې په خوله کې دې د څښتن په حضور کې وړاندې کړي."}, {"ref": "None Leviticus 1:7", "text": "د اسراییلو قوم باید نور په صحرا کې د هغو پېریانو دپاره قرباني ونه کړي چې د سېرلیو په شان ښکاري او په دې کار سره دې د څښتن سره بې وفایي نه کوي. د اسراییلو قوم باید تل ترتله په دې حکم باندې عمل وکړي."}, {"ref": "None Leviticus 1:7", "text": "د خپلې مور سره په زنا کولو سره د خپل پلار سپکاوی مه کوئ. هغه ستاسو مور ده، د هغې سره زنا مه کوئ."}, {"ref": "None Leviticus 1:7", "text": "که چېرې د هغې څخه لږه په درېمه ورځ وخوړل شي، هغه ناپاکه ده او دا نذرانه به قبوله نه شي."}, {"ref": "None Leviticus 1:8", "text": "څښتن هارون ته وویل:"}, {"ref": "None Leviticus 1:8", "text": "تاسو باید د دې حیواناتو غوښه ونه خورئ او مه د هغو مړو ته لاس وروړئ، دا ستاسو دپاره ناپاک دي."}, {"ref": "None Leviticus 1:8", "text": "که چېرې دا ښځه یو وری نه شي اخیستلی، نو دوه کوترې یا دوه قمري ګانې دې راوړي، یوه د سوځېدونکې نذرانې دپاره او بله د ګناه د نذرانې دپاره او کاهن به د هغې د ناپاکۍ د لېرې کولو دپاره کفاره ادا کړي او هغه به پاکه شي.»"}, {"ref": "None Leviticus 1:8", "text": "کاهن دې هغه معاینه کړي، که چېرې هغه ګرمکه په بدن باندې خپره شوې وه، کاهن به هغه ناپاک اعلان کړي، دا یوه ساري ناروغي ده."}, {"ref": "None Leviticus 1:8", "text": "کوم کس چې پاکیږي، هغه باید خپل کالي ووینځي، خپل ټول ویښتان دې وخرایي او غسل دې وکړي، بیا به هغه پاک شي. له دې وروسته هغه کولای شي چې کمپ ته ورننوځي، خو اووه ورځې باید د خپلې خېمې څخه دباندې واوسیږي."}, {"ref": "None Leviticus 1:8", "text": "که چېرې هغه کس چې زوه ورڅخه راوځي په داسې یو کس باندې چې هغه پاک وي لیاړې واچوي، هغه سړی باید خپل کالي ووینځي او غسل دې وکړي، خو هغه به تر ماښامه پورې ناپاک پاتې شي."}, {"ref": "None Leviticus 1:8", "text": "هغه دې د دوو سېرلیو دپاره پچه واچوي او د دوه تیږو څخه دې کار واخلي، په یوې باندې دې د څښتن دپاره نښه وکړي او په بلې باندې دې د عزازیل دپاره."}, {"ref": "None Leviticus 1:8", "text": "که چېرې کوم اسراییلی یا پردی کس چې د دوی په منځ کې اوسیږي، سوځېدونکې نذرانه یا کومه بله قرباني"}, {"ref": "None Leviticus 1:8", "text": "د خپل پلار د نورو ښځو سره په زنا کولو سره د خپل پلار سپکاوی مه کوئ."}, {"ref": "None Leviticus 1:8", "text": "هرڅوک چې هغه وخوري، هغه به ګناهکار وي، ځکه چې هغه څه چې څښتن ته سپېڅلي دي، هغه یې عادي ګڼلي دي. هغه کس باید د خدای د قوم څخه وشړل شي."}, {"ref": "None Leviticus 1:9", "text": "«ته او ستا زامن د شرابو د څښلو نه وروسته سپېڅلې خېمې ته مه ورننوځئ، که چېرې داسې وکړئ نو مړه به شئ. دا یو تلپاتې قانون دی چې ستاسو ټوله اولاده به ورباندې عمل کوي."}, {"ref": "None Leviticus 1:9", "text": "تاسو کولای شئ هر ډول ماهیان چې وزرونه او پتري ولري وخورئ،"}, {"ref": "None Leviticus 1:9", "text": "کله چې یو کس د پوستکي ساري ناروغي ولري، هغه باید کاهن ته راوستل شي."}, {"ref": "None Leviticus 1:9", "text": "هغه باید په اوومه ورځ بیا خپل سر، ږیره، وروځې او د بدن پاتې ویښتان وخرایي. خپل کالي دې ووینځي او غسل دې وکړي، نو هغه به پاک شي."}, {"ref": "None Leviticus 1:9", "text": "که دا سړی په کوم زین باندې کښېني، هغه به ناپاک شي"}, {"ref": "None Leviticus 1:9", "text": "هارون به هغه سېرلی چې د څښتن دپاره د پچې په وسیله غوره شوی وي، د ګناه د نذرانې په توګه قرباني کړي."}, {"ref": "None Leviticus 1:9", "text": "څښتن ته د نذرانې په توګه د سپېڅلې خېمې د دروازې د خولې څخه پرته په بل هرځای کې وړاندې کړي، د خدای د قوم څخه به وشړل شي."}, {"ref": "None Leviticus 1:9", "text": "د خپلې سکه یا ناسکه خور سره که هغه ستاسو د پلار لور وي یا د مور، که هغه تاسو سره په یو کور کې زېږېدلې وي یا په بل ځای کې، د هغې سره زنا مه کوئ."}, {"ref": "None Leviticus 1:9", "text": "کله چې تاسو د خپلې ځمکې حاصلات لو کوئ، نو هغه د پټي تر غاړو پورې مه لو کوئ او هغه وږي چې د لو څخه پاتې شوي وي، هغه مه راټولوئ."}, {"ref": "None Leviticus 1:10", "text": "تاسو باید د هغو شیانو ترمنځ چې سپېڅلي او عادي دي، فرق وکړئ او د هغو شیانو ترمنځ چې کوم پاک دي او کوم ناپاک."}, {"ref": "None Leviticus 1:10", "text": "خو هر حیوان چې په اوبو کې ژوند کوي او وزرونه او پتري نه لري، باید غوښه یې ونه خوړل شي."}, {"ref": "None Leviticus 1:10", "text": "کاهن دې هغه معاینه کړي، که چېرې په پوستکي کې یو سپین زخم وي چې ویښتان یې سپین کړي وي او که چېرې په زخم کې خامه غوښه وي،"}, {"ref": "None Leviticus 1:10", "text": "هغه باید په اتمه ورځ دغه شیان راوړي: دوه وري او یوه یو کلنه مېږه چې هېڅ عیب په کې نه وي، د غلې دانې د نذرانې دپاره درې کیلو ګرامه ښه اوړه چې د زیتونو تېل ورسره ګډ وي او یوه پیاله د زیتونو تېل."}, {"ref": "None Leviticus 1:10", "text": "او هرڅوک چې د هغه شي سره ولګیږي چې دا سړی ورباندې ناست ؤ، هغه به تر ماښامه پورې ناپاک وي. هرڅوک چې داسې شیان راپورته کړي، هغه باید خپل کالي ووینځي او غسل دې وکړي، خو تر ماښامه پورې به ناپاک پاتې شي."}, {"ref": "None Leviticus 1:10", "text": "کوم سېرلی چې د عزازیل دپاره غوره شوی ؤ هغه به څښتن ته ژوندی وړاندې شي او په دښته کې به عزازیل ته ورولېږل شي، د دې په خاطر چې د قوم د ګناهونو دپاره کفاره ادا کړي."}, {"ref": "None Leviticus 1:10", "text": "که چېرې کوم اسراییلی یا هغه پردی کس چې د دوی په منځ کې اوسیږي کومه وینه وخوري، څښتن وایي چې د هغه په خلاف به شي او د خپل قوم څخه به یې وشړي."}, {"ref": "None Leviticus 1:10", "text": "د خپلې لمسۍ سره زنا مه کوئ، هغه به ستاسو دپاره سپکاوی وي."}, {"ref": "None Leviticus 1:10", "text": "خپل د انګورو باغ ته دوهم ځل مه ورځئ او هغه انګور مه راټولوئ چې رالوېدلي وي. هغه غریبانو او پردیو خلکو ته پرېږدئ. زه ستاسو څښتن خدای یم."}, {"ref": "None Leviticus 1:11", "text": "باید د اسراییلو قوم ته هغه ټول قوانین ورزده کړئ چې ما تاسو ته د موسی په وسیله درکړي دي.»"}, {"ref": "None Leviticus 1:11", "text": "داسې حیوانات باید حرام وګڼل شي. تاسو باید د هغو غوښه ونه خورئ او حتی مړو ته یې لاس هم مه وروړئ."}, {"ref": "None Leviticus 1:11", "text": "نو دا د پوستکي یوه دوامداره ناروغي ده او کاهن به هغه ناپاک اعلان کړي. کاهن دې هغه د معاینې دپاره بېل ونه ساتي، ځکه چې هغه په ښکاره ناپاک دی."}, {"ref": "None Leviticus 1:11", "text": "کاهن باید هغه کس چې پاکیږي، د دې نذرانو سره د سپېڅلې خېمې د دروازې په خوله کې د څښتن حضور ته ورولي."}, {"ref": "None Leviticus 1:11", "text": "که چېرې یو سړی چې زوه ورڅخه راووځي او خپل لاسونه یې نه وي وینځلي، په کوم بل کس باندې ولګیږي، نو هغه څوک چې دی ورسره لګېدلی دی باید خپل کالي ووینځي او غسل دې وکړي، خو هغه به تر ماښامه پورې ناپاک پاتې شي."}, {"ref": "None Leviticus 1:11", "text": "کله چې هارون یو غویی د خپلې ګناه د نذرانې دپاره حلال کړي چې د خپل ځان او خپلې کورنۍ دپاره کفاره ادا کړي،"}, {"ref": "None Leviticus 1:11", "text": "د هر ژوندي شي ژوند په وینه کې دی او څښتن هغه د اسراییلو قوم ته ورکړې ده، د دې په خاطر چې د قربانۍ په ځای باندې د ځان دپاره کفاره ادا کړي. همدا وینه ده چې د یو چا د ژوند دپاره کفاره ادا کوي."}, {"ref": "None Leviticus 1:11", "text": "د یوې ناسکه خور سره زنا مه کوئ، هغه هم ستاسو خور ده."}, {"ref": "None Leviticus 1:11", "text": "غلا مه کوئ. یو بل ته دروغ مه وایئ او یو بل مه غولوئ."}, {"ref": "None Leviticus 1:12", "text": "بیا موسی هارون او د هغه پاتې زامنو العازار او ایتامار ته وویل: «د غلې دانې هغه نذرانه چې څښتن ته په اور باندې د تیارېدونکو نذرانو څخه پاتې شوې ده واخلئ، د هغې څخه فطیره ډوډۍ پخه کړئ او د قربانۍ د ځای په څنګ کې یې وخورئ، ځکه چې دا نذرانه ډېره سپېڅلې ده."}, {"ref": "None Leviticus 1:12", "text": "هر شی چې په اوبو کې ژوند کوي او وزرونه او پتري ونه لري، باید ونه خورئ."}, {"ref": "None Leviticus 1:12", "text": "بیا به کاهن یو وری د یوې پیالې تېلو سره واخلي او هغه به د تاوان د نذرانې په توګه وړاندې کړي. کاهن به هغه پورته ونیسي، ترڅو دا وښایي چې هغه څښتن ته وقف شوي دي."}, {"ref": "None Leviticus 1:12", "text": "که هغه سړی چې زوه ورڅخه راوځي د خټو هر لوښي ته لاس وروړي، هغه باید مات شي او که د لرګي کوم لوښي ته لاس وروړي، هغه باید ووینځل شي."}, {"ref": "None Leviticus 1:12", "text": "نو هغه به د قربانۍ د ځای څخه د اور یو لوښی چې د لګول شویو سکارو څخه ډک وي او دوه موټي ښه میده شوې خوشبویي راواخلي او هغه دې ډېر سپېڅلي ځای ته راوړي."}, {"ref": "None Leviticus 1:12", "text": "په دې خاطر څښتن د اسراییلو قوم ته ویلي دي چې نه به دوی او نه به هغه پردی کس چې د دوی په منځ کې اوسیږي، وینه وخوري."}, {"ref": "None Leviticus 1:12", "text": "د خپل پلار د خور سره زنا مه کوئ، هغه ستاسو د پلار نژدې خپلوانه ده."}, {"ref": "None Leviticus 1:12", "text": "زما په نوم په دروغو قسم مه خورئ او په دې ډول د خپل خدای نوم مه سپکوئ. زه ستاسو څښتن خدای یم."}, {"ref": "None Leviticus 1:13", "text": "هغه په یو سپېڅلي ځای کې وخورئ، ځکه چې دا ستا او ستا د زامنو د هغو نذرانو برخه ده چې څښتن ته په اور باندې تیاریږي. دا هغه څه دي چې څښتن یې ماته امر کړی دی."}, {"ref": "None Leviticus 1:13", "text": "هغه دې وری په هغه سپېڅلي ځای کې حلال کړي چې د ګناه د نذرانو او سوځېدونکو نذرانو دپاره حیوانات حلالیږي. هغه باید داسې وکړي، ځکه چې د تاوان نذرانه د ګناه د نذرانې په شان د کاهن ده او هغه ډېره سپېڅلې ده."}, {"ref": "None Leviticus 1:13", "text": "له هغې وروسته چې د زوې د راوتلو څخه د دغه سړي علاج وشي، هغه باید اووه ورځې صبر وکړي او بیا دې د چینې په تازه اوبو کې خپل کالي ووینځي او غسل دې وکړي، نو هغه به پاک شي."}, {"ref": "None Leviticus 1:13", "text": "هغه به هلته د څښتن په حضور کې خوشبویي په اور باندې واچوي او د خوشبویۍ لوګی به د لوظ د صندوق سرپوښ پټ کړي، ترڅو هارون هغه ونه ویني او مړ نه شي."}, {"ref": "None Leviticus 1:13", "text": "که چېرې کوم اسراییلی یا پردی کس چې د دوی په منځ کې اوسیږي، یو داسې حیوان یا مرغۍ ښکار کړي چې هغه حلال وي، باید د هغه وینه په ځمکه باندې تویه کړي او په خاورو باندې دې پټه کړي."}, {"ref": "None Leviticus 1:13", "text": "د خپلې مور د خور سره زنا مه کوئ، ځکه چې هغه ستاسو د مور نژدې خپلوانه ده."}, {"ref": "None Leviticus 1:13", "text": "خپل ګاونډی مه لوټوئ او هغه مه غولوئ. د یو مزدور اجوره حتی د یوې شپې دپاره هم مه ځنډوئ."}, {"ref": "None Leviticus 1:14", "text": "خو سینه او شاتنۍ پښه چې پورته نیول کیږي، هغه دې په داسې ځای کې چې په مذهبي لحاظ پاک وي، وخوړل شي. دا برخه تاسو، ستاسو زامنو او لورګانو ته ستاسو د برخې په توګه د سلامتۍ د هغو نذرانو څخه چې د اسراییلو د خلکو له خوا وړاندې کیږي، درکول کیږي."}, {"ref": "None Leviticus 1:14", "text": "خو هرکله چې په هغه باندې خامه غوښه راښکاره شي، هغه به ناپاک شي."}, {"ref": "None Leviticus 1:14", "text": "کاهن دې د وري د وینې څخه لږه وینه واخلي او د هغه کس چې پاکیږي، د هغه د ښي غوږ په نرمۍ، د ښي لاس په غټې ګوتې او د ښي پښې په غټې ګوتې دې وسولوي."}, {"ref": "None Leviticus 1:14", "text": "هغه باید په اتمه ورځ دوه کوترې یا دوه قمري ګانې واخلي او د څښتن حضور ته دې د سپېڅلې خېمې د دروازې خولې ته راشي او هغه دې کاهن ته ورکړي."}, {"ref": "None Leviticus 1:14", "text": "د غویي لږه وینه به واخلي او په خپلې ګوتې باندې به یې د سرپوښ مخکینۍ برخې ته وشیندي او بیا به د هغې څخه لږه د لوظ د صندوق مخې ته اووه ځلې وشیندي."}, {"ref": "None Leviticus 1:14", "text": "د هر ژوندي شي ژوند په وینه کې دی، نو په دې خاطر څښتن د اسراییلو قوم ته ویلي دي چې باید د هېڅ یو ژوندي شي وینه ونه خوري. هرڅوک چې هغه وخوري، باید د خدای د قوم څخه وشړل شي."}, {"ref": "None Leviticus 1:14", "text": "د خپل تره د ښځې سره په زنا کولو د خپل تره سپکاوی مه کوئ، هغه هم ستاسو نژدې خپلوانه ده."}, {"ref": "None Leviticus 1:14", "text": "کڼو خلکو ته ښکنځلې مه کوئ او د ړندو په مخکې داسې شی مه ږدئ چې هغوی ورباندې وښوییږي، زما څخه ووېرېږئ. زه ستاسو څښتن خدای یم."}, {"ref": "None Leviticus 1:15", "text": "شاتنۍ پښه او سینه باید د هغو نذرانو د وازګې سره چې په اور باندې تیاریږي، څښتن ته پورته ونیول شي. بیا لکه څنګه چې څښتن حکم کړی دی، هغه به د تل دپاره ستاسو او ستاسو د اولادې برخه وي.»"}, {"ref": "None Leviticus 1:15", "text": "کله چې کاهن دا خامه غوښه وویني، هغه کس به ناپاک اعلان کړي. خامه غوښه ناپاکه ده، هغه کس په ساري ناروغۍ اخته دی."}, {"ref": "None Leviticus 1:15", "text": "بیا به کاهن لږ تېل راواخلي او د خپل چپ لاس په ورغوي کې به یې توی کړي،"}, {"ref": "None Leviticus 1:15", "text": "کاهن دې هغه قرباني کړي، یوه د ګناه د نذرانې دپاره او بله د سوځېدونکې نذرانې دپاره. په دې ډول به کاهن د څښتن په حضور کې د هغه سړي دپاره د هغه د زوې د راوتلو له امله کفاره ادا کړي."}, {"ref": "None Leviticus 1:15", "text": "بیا به هارون د ګناه د نذرانې سېرلی د قوم په خاطر حلال کړي او د هغه وینه به ډېر سپېڅلي ځای ته یوسي او هماغسې کار به ورسره وکړي چې د غویي په وینه باندې یې کړی ؤ. هغه به د لوظ د صندوق په سرپوښ او د صندوق مخې ته وشیندي."}, {"ref": "None Leviticus 1:15", "text": "هرڅوک، که هغه اسراییلی یا پردی وي د یو داسې حیوان غوښه وخوري چې په خپل مرګ باندې مړ شوی وي یا د وحشي حیواناتو له خوا وژل شوی وي، باید خپل کالي ووینځي او غسل دې وکړي. هغه به تر ماښامه پورې ناپاک وي، بیا به پاک شي."}, {"ref": "None Leviticus 1:15", "text": "د خپلې انږور سره زنا مه کوئ. هغه ستاسو د زوی ښځه ده."}, {"ref": "None Leviticus 1:15", "text": "عدالت تر پښو مه لاندې کوئ. د غریب طرفداري مه کوئ او د لویانو خاطر مه کوئ، خو د نورو سره په انصاف قضاوت وکړئ."}, {"ref": "None Leviticus 1:16", "text": "موسی د هغه سېرلي په اړه پوښتنه وکړه چې د ګناه د نذرانې دپاره ؤ او خبر شو چې هغه سوځول شوی دی. په دې خبره هغه په العازار او ایتامار باندې په قهر شو او پوښتنه یې وکړه:"}, {"ref": "None Leviticus 1:16", "text": "خو کله چې دا خامه غوښه روغه شي او بیا سپینه شي، هغه کس باید کاهن ته ورشي."}, {"ref": "None Leviticus 1:16", "text": "خپله ښي ګوته به په خپل ورغوي کې غوټه کړي او لږ تېل به په خپلې ګوتې سره د څښتن په حضور کې اووه ځلې وشیندي."}, {"ref": "None Leviticus 1:16", "text": "کله چې له یو سړي څخه مني راووځي، هغه باید خپل ټول ځان ووینځي، خو هغه به تر ماښامه پورې ناپاک پاتې شي."}, {"ref": "None Leviticus 1:16", "text": "په دې ډول به هغه د پاکولو مراسم سرته ورسوي چې ډېر سپېڅلی ځای د اسراییلو د قوم د ناپاکۍ او د هغوی د ټولو ګناهونو څخه پاک کړي. هغه دې دا کار د سپېڅلې خېمې دپاره هم وکړي، ځکه چې هغه د کمپ په منځ کې ولاړه ده او کمپ په مذهبي لحاظ ناپاک دی."}, {"ref": "None Leviticus 1:16", "text": "خو که چېرې هغه خپل کالي ونه وینځي او غسل ونه کړي، نو د خپلو بدو سزا به وویني."}, {"ref": "None Leviticus 1:16", "text": "د خپلې ورېندار سره زنا مه کوئ، دا به ستاسو د ورور دپاره سپکاوی وي."}, {"ref": "None Leviticus 1:16", "text": "د هېچا په اړه دروغ مه خپروئ او کله چې یو کس په محکمه کې په مرګ باندې محکوم وي، نو ښکاره خبرې وکړئ، کېدای شي چې ستاسو شاهدي د هغه سره مرسته وکړي. زه څښتن یم."}, {"ref": "None Leviticus 1:17", "text": "«تاسو ولې د ګناه نذرانه په یو سپېڅلي ځای کې ونه خوړله؟ هغه ډېره سپېڅلې ده او څښتن د دې دپاره تاسو ته درکړې وه چې د کفارې په ادا کولو سره د قوم څخه ګناه لېرې شي."}, {"ref": "None Leviticus 1:17", "text": "کاهن دې هغه معاینه کړي، که چېرې د زخم څخه یوازې سپین داغونه پاتې وي کاهن به هغه ناروغه کس پاک اعلان کړي، بیا به هغه پاک شي."}, {"ref": "None Leviticus 1:17", "text": "کاهن دې لږ تېل چې د هغه د لاس په ورغوي کې پاتې دي، راواخلي او د هغه کس چې پاکیږي د هغه د ښي غوږ په نرمۍ، د ښي لاس په غټې ګوتې او د ښي پښې په غټې ګوتې وسولوي."}, {"ref": "None Leviticus 1:17", "text": "هر هغه شی چې د ټوکر یا څرمنې څخه جوړ شوی وي او مني ورباندې لوېدلي وي باید ووینځل شي، خو هغه به تر ماښامه پورې ناپاک پاتې شي."}, {"ref": "None Leviticus 1:17", "text": "له هغه وخت څخه چې هارون ډېر سپېڅلي ځای ته د کفارې د ادا کولو دپاره ننوځي، د هغه د راوتلو پورې باید هېڅوک په خېمه کې نه وي. کله چې هغه د خپل ځان، خپلې کورنۍ او ټول قوم دپاره کفاره ادا کوي،"}, {"ref": "None Leviticus 1:17", "text": "که تاسو د یوې ښځې سره څملئ، نو د هغې د لور یا د هغې د لمسۍ سره زنا مه کوئ، ځکه چې هغوی د هغې نژدې خپلوان دي. دا ډېر بد کار دی."}, {"ref": "None Leviticus 1:17", "text": "د خپل ورور سره په خپل زړه کې کینه مه ساتئ. هغه په ښکاره د خپلې ګناه په خاطر ورټئ، ترڅو د هغه په ګناه کې شریک نه شئ."}, {"ref": "None Leviticus 1:18", "text": "په دې خاطر چې د هغه وینه سپېڅلې خېمې ته نه وه وړل شوې، نو تاسو باید د سېرلي غوښه هلته خوړلې وای، لکه څنګه چې ما درته امر کړی ؤ.»"}, {"ref": "None Leviticus 1:18", "text": "کله چې د یو چا په پوستکي باندې یوه دانه وي او روغه شي"}, {"ref": "None Leviticus 1:18", "text": "کاهن به پاتې تېل چې د هغه په ورغوي کې دي، د هغه چا په سر باندې توی کړي چې پاکیږي او د هغه دپاره به د څښتن په حضور کې کفاره ادا کړي."}, {"ref": "None Leviticus 1:18", "text": "سړی او ښځه دواړه باید د یوځای کېدلو څخه وروسته غسل وکړي، خو تر ماښامه پورې به ناپاک پاتې شي."}, {"ref": "None Leviticus 1:18", "text": "نو باید بیا د نذرانو د سوځولو دپاره د قربانۍ ځای ته لاړ شي او هغه پاک کړي. هغه باید د غویي او سېرلي لږه وینه واخلي او د قربانۍ د ځای په ښکرونو باندې دې وسولوي."}, {"ref": "None Leviticus 1:18", "text": "ترڅو پورې چې ستاسو ښځې ژوندۍ وي، د خپلو ښینو سره د دوهمې ښځې په توګه واده مه کوئ او د هغوی سره زنا مه کوئ."}, {"ref": "None Leviticus 1:18", "text": "د خپلو خلکو څخه د بدل اخیستلو پسې مه ګرځئ. د هغوی څخه کرکه مه کوئ، خو د خپل ګاونډي سره د خپل ځان په شان مینه کوئ. زه څښتن یم."}, {"ref": "None Leviticus 1:19", "text": "هارون په ځواب کې وویل: «که چېرې ما د ګناه نذرانه نن خوړلې وای، ایا څښتن به هغه قبوله کړې وای؟ قوم خپله د ګناه نذرانه نن څښتن ته وړاندې کړه او خپله سوځېدونکې نذرانه یې راوړله، خو بیاهم په ما باندې دا هیبتناکه پېښې وشوې.»"}, {"ref": "None Leviticus 1:19", "text": "او په هغه ځای باندې چې دانه وه، یو زخم یا سوربخن سپین داغ راښکاره شي، هغه باید خپل ځان کاهن ته ورښکاره کړي."}, {"ref": "None Leviticus 1:19", "text": "بیا دې کاهن د ګناه نذرانه قرباني کړي او د هغه چا دپاره دې کفاره ادا کړي چې د خپلې ناپاکۍ څخه پاکیږي. له هغې وروسته به د سوځېدونکې نذرانې دپاره حیوان حلال کړي"}, {"ref": "None Leviticus 1:19", "text": "کله چې یوه ښځه میاشتینۍ ناروغي ولري، هغه اووه ورځې ناپاکه پاتې کیږي. هرڅوک چې دې ښځې ته لاس وروړي، هغه به تر ماښامه پورې ناپاک وي."}, {"ref": "None Leviticus 1:19", "text": "هغه باید په خپله ګوته لږه وینه واخلي او د قربانۍ په ځای باندې دې اووه ځلې وشیندي. په دې ډول دې هغه د اسراییلو قوم د ناپاکۍ څخه پاک او سپېڅلې کړي."}, {"ref": "None Leviticus 1:19", "text": "د یوې ښځې سره د هغې د میاشتینۍ ناروغۍ په دوران کې مه یوځای کېږئ، ځکه چې هغه ناپاکه ده."}, {"ref": "None Leviticus 1:19", "text": "زما د فرمانونو څخه پیروي وکړئ. غیر همجنس کورني حیوانات د نسل د پیدا کولو دپاره سره مه یوځای کوئ. په خپل پټي کې دوه ډوله تخمونه مه کرئ. داسې کالي مه اغوندئ چې د دوو مختلفو جنسونو څخه جوړ شوي وي."}, {"ref": "None Leviticus 1:20", "text": "کله چې موسی دا خبرې واورېدلې، هغه قانع شو."}, {"ref": "None Leviticus 1:20", "text": "ټول وزر لرونکي حشرات حرام دي،"}, {"ref": "None Leviticus 1:20", "text": "کاهن دې هغه معاینه کړي، که چېرې هغه د پوستکي څخه ژور وي او ویښتان په کې سپین شوي وي، کاهن به هغه ناپاک اعلان کړي. دا د پوستکي یوه ساري ناروغي ده چې د دانې په ځای منځ ته راغلې ده."}, {"ref": "None Leviticus 1:20", "text": "او د غلې دانې د نذرانې سره به یې د قربانۍ په ځای باندې وړاندې کړي. په دې ډول به د هغه کس دپاره کفاره ادا کړي او هغه به پاک شي."}, {"ref": "None Leviticus 1:20", "text": "که هغه د خپلې میاشتینۍ ناروغۍ په وخت کې په هر شي باندې کښېني یا ورباندې څملي، هغه شی به ناپاک شي."}, {"ref": "None Leviticus 1:20", "text": "کله چې هارون د ډېر سپېڅلي ځای، د سپېڅلې خېمې پاتې برخې او د قربانۍ د ځای د پاکولو مراسم سرته ورسوي، هغه به هغه ژوندی سېرلی څښتن ته وړاندې کوي چې د عزازیل دپاره غوره شوی دی."}, {"ref": "None Leviticus 1:20", "text": "د بل سړي د ښځې سره زنا مه کوئ او په هغې باندې خپل ځان مه ناپاکه کوئ."}, {"ref": "None Leviticus 1:20", "text": "که چېرې یو کس د یوې داسې وینځې سره چې هغه د بل کس سره کوژدن شوې وي زنا وکړي، که څه هم هغه بل کس د هغې د ازادېدلو په خاطر پیسې نه وي ورکړې، نو باید هغې وینځې او هغه کس ته چې د هغې سره یې زنا کړې وه، سزا ورکړل شي. خو هغوی دې ونه وژل شي، ځکه چې هغه ازاده شوې نه ده."}, {"ref": "None Leviticus 1:21", "text": "بې له هغو حشراتو څخه چې ټوپونه وهي."}, {"ref": "None Leviticus 1:21", "text": "خو که چېرې کاهن هغه معاینه کړي او سپین ویښتان په کې نه وي او د پوستکي څخه ژور نه وي او مړاوی شوی وي، بیا دې کاهن هغه کس د اوو ورځو دپاره بېل وساتي."}, {"ref": "None Leviticus 1:21", "text": "که چېرې هغه کس غریب وي او نور څه نه شي اخیستلی، باید یو وری د تاوان د نذرانې په توګه راوړي. کاهن به هغه څښتن ته د وقف کولو دپاره پورته ونیسي او د هغه کس دپاره به کفاره ادا کړي. هغه به یو کیلو ګرام ښه اوړه چې د زیتونو تېل ورسره ګډ وي، د غلې دانې د نذرانې دپاره راوړي او یوه پیاله تېل."}, {"ref": "None Leviticus 1:21", "text": "هغه دې دواړه لاسونه د ژوندي سېرلي په سر باندې کېږدي او په هغه باندې دې د اسراییلو د قوم د ټولو بدکاریو، ګناهونو او سرکښیو اقرار وکړي او هغه دې د سېرلی په سر باندې واچوي. هغه به دا سېرلی لېرې دښتې ته ولېږي او یو داسې سړي ته دې وسپاري چې د دې کار دپاره ټاکل شوی وي."}, {"ref": "None Leviticus 1:21", "text": "د خپلو ماشومانو څخه هېڅ یو ماشوم مه ورکوئ چې د مولک د بت دپاره قرباني شي. زه ستاسو څښتن خدای یم او په دې کار به زما سپکاوی وشي."}, {"ref": "None Leviticus 1:21", "text": "هغه سړی به د تاوان د نذرانې په توګه یو پسه د سپېڅلې خېمې د دروازې په خوله کې څښتن ته راوړي."}, {"ref": "None Leviticus 1:22", "text": "د هغو څخه کولای شئ چې ډول ډول چورچورکۍ او ملخان وخورئ."}, {"ref": "None Leviticus 1:22", "text": "که چېرې هغه زخم په پوستکي کې خپریږي، کاهن به هغه کس ناپاک اعلان کړي، دا ساري ناروغي ده."}, {"ref": "None Leviticus 1:22", "text": "همدارنګه هغه کس به دوه کوترې یا دوه قمري ګانې راوړي، یوه د ګناه د نذرانې دپاره او بله د سوځېدونکې نذرانې دپاره."}, {"ref": "None Leviticus 1:22", "text": "کله چې هغه سړی هغه سېرلی په دښته کې خوشې کړي، نو هغه سېرلی به د هغوی ټول ګناهونه د خپل ځان سره یو شاړ ځای ته یوسي."}, {"ref": "None Leviticus 1:22", "text": "هېڅ یو سړی دې د بل سړي سره بد کار نه کوي، د دې څخه خدای کرکه کوي."}, {"ref": "None Leviticus 1:22", "text": "په هغه باندې به کاهن د څښتن په حضور کې د هغه د ګناه په خاطر کفاره ادا کړي او د هغه ګناه به وبخښل شي."}, {"ref": "None Leviticus 1:23", "text": "خو نور ټول وزر لرونکي حشرات چې په پښو باندې هم ګرځي، باید حرام وګڼل شي."}, {"ref": "None Leviticus 1:23", "text": "خو که چېرې هغه بدل شوی او خپور شوی نه وي، دا یوازې د دانې داغ دی او کاهن به هغه کس پاک اعلان کړي."}, {"ref": "None Leviticus 1:23", "text": "هغه باید په اتمه ورځ دا شیان د خپل ځان د پاکېدلو دپاره د سپېڅلې خېمې د دروازې په خوله کې کاهن ته راوړي."}, {"ref": "None Leviticus 1:23", "text": "بیا دې هارون سپېڅلې خېمې ته ورننوځي او د کتان هغه کالي چې ډېر سپېڅلي ځای ته د ورننوتلو څخه مخکې یې اغوستی ؤ، وباسي او هلته دې پرېږدي."}, {"ref": "None Leviticus 1:23", "text": "د یو حیوان سره جنسي اړیکې مه ساتئ او په دې ډول په دې کار خپل ځان مه ناپاکه کوئ. یوه ښځه باید یو حیوان ته د جنسي اړیکو په خاطر خپل ځان وړاندې نه کړي، دا ډېر بد کار دی."}, {"ref": "None Leviticus 1:23", "text": "کله چې تاسو د کنعان خاورې ته ورننوځئ او د مېوې یوه ونه وکرئ، هغه مېوه د لومړنیو درېو کلونو دپاره حرامه وګڼئ. په دې موده کې تاسو باید هغه مېوه ونه خورئ."}, {"ref": "None Leviticus 1:24", "text": "کله چې د یو چا پوستکی سوځېدلی وي او د سوځېدلي ځای په خامه غوښه کې یو سوربخن سپین یا سپین داغ راښکاره شي،"}, {"ref": "None Leviticus 1:24", "text": "کاهن به وری او د زیتونو تېل د تاوان د نذرانې دپاره واخلي او څښتن ته به یې د وقف کولو دپاره پورته ونیسي."}, {"ref": "None Leviticus 1:24", "text": "که چېرې یو سړی د هغې ښځې سره په هغه وخت کې یوځای شي کله چې د هغې میاشتینۍ ناروغي پیل کیږي، هغه سړی به اووه ورځې ناپاک وي. په هرې بسترې باندې چې هغه څملي هغه بستره به ناپاکه شي."}, {"ref": "None Leviticus 1:24", "text": "هغه به په یو سپېڅلي ځای کې غسل وکړي او خپل عادي کالي به واغوندي. بیا به هغه دباندې راووځي او یوه سوځېدونکې نذرانه به د ځان او یوه د قوم دپاره قرباني کړي، د دې په خاطر چې د خپل ځان او د هغوی دپاره کفاره ادا کړي."}, {"ref": "None Leviticus 1:24", "text": "په دې عملونو باندې خپل ځانونه مه ناپاکه کوئ، ځکه چې نورو قومونو په دې ډول خپل ځانونه ناپاکه کړل. دا هغه قومونه دي چې په دې خاوره کې اوسیږي او څښتن یې د دې په خاطر وباسي، ترڅو تاسو وکولای شئ چې هغې خاورې ته ورننوځئ."}, {"ref": "None Leviticus 1:24", "text": "په څلورم کال به هغه ټوله مېوه ما یعنې څښتن ته د شکرګزارۍ په خاطر وقف شي."}, {"ref": "None Leviticus 1:25", "text": "نو کاهن دې هغه داغ معاینه کړي. که چېرې په هغه کې ویښتان سپین شوي وو او د پوستکي څخه ژور ښکاره کېده، دا د پوستکي یوه ساري ناروغي ده چې په هغه سوځېدلي ځای کې پیل شوې ده. کاهن به هغه کس ناپاک اعلان کړي."}, {"ref": "None Leviticus 1:25", "text": "هغه به وری د تاوان د نذرانې په توګه حلال کړي او د هغه لږه وینه به واخلي او د هغه کس چې پاکیږي، د ښي غوږ په نرمۍ، د ښي لاس په غټې ګوتې او د ښي پښې په غټې ګوتې به یې وسولوي."}, {"ref": "None Leviticus 1:25", "text": "که چېرې د یوې ښځې څخه د میاشتینۍ ناروغۍ څخه پرته د ډېرو ورځو دپاره وینه بهیږي، یا برسېره په عادي میاشتینۍ ناروغۍ د هغې څخه وینه بهیږي، نو ترڅو پورې چې دا وینه بهیږي، هغه ښځه د میاشتینۍ ناروغۍ په شان ناپاکه پاتې کیږي."}, {"ref": "None Leviticus 1:25", "text": "همدارنګه هغه به د قربانۍ په ځای باندې د حیوان وازګه چې د ګناه د نذرانې دپاره ده، وسوځوي."}, {"ref": "None Leviticus 1:25", "text": "د هغوی عملونو هغه خاوره ناپاکه کړې ده، نو څښتن هغې خاورې ته سزا ورکوي او هغه مجبوروي چې خپل اوسېدونکي وشړي."}, {"ref": "None Leviticus 1:25", "text": "خو په پنځم کال به هغه مېوه تاسو ته حلاله وي. که چېرې تاسو دا ټول کارونه وکړئ، ستاسو ونې به زیاته مېوه ونیسي. زه ستاسو څښتن خدای یم."}, {"ref": "None Leviticus 1:26", "text": "خو که چېرې کاهن هغه معاینه کړي او په داغ کې سپین ویښتان نه وي او هغه د پوستکي څخه ژور نه وي او مړاوی شوی وي، بیا دې کاهن هغه کس د اوو ورځو دپاره بېل وساتي."}, {"ref": "None Leviticus 1:26", "text": "بیا دې کاهن لږ تېل راواخلي او د خپل چپ لاس په ورغوي کې دې توی کړي."}, {"ref": "None Leviticus 1:26", "text": "په دې موده کې که چېرې هغه په هره بستره باندې څملي او یا په هر شي باندې چې کښېني هغه به ناپاک شي."}, {"ref": "None Leviticus 1:26", "text": "هغه سړی چې سېرلی یې په دښته کې عزازیل ته ورپرېښود، باید کمپ ته د بېرته راتګ څخه مخکې خپل کالي ووینځي او غسل دې وکړي."}, {"ref": "None Leviticus 1:26", "text": "داسې غوښه مه خورئ چې وینه په کې وي. فال مه ګورئ او کوډې مه کوئ."}, {"ref": "None Leviticus 1:27", "text": "په اوومه ورځ دې کاهن هغه معاینه کړي. که چېرې هغه خپریږي، کاهن به هغه کس ناپاک اعلان کړي، دا د پوستکي یوه ساري ناروغي ده."}, {"ref": "None Leviticus 1:27", "text": "هغه دې په خپله ښي ګوته د خپل ورغوي څخه لږ تېل اووه ځلې د څښتن په حضور کې وشیندي."}, {"ref": "None Leviticus 1:27", "text": "هرڅوک چې دغو شیانو ته لاس وروړي هغه به ناپاک شي. هغه باید خپل کالي ووینځي او غسل دې وکړي، خو تر ماښامه پورې به ناپاک پاتې شي."}, {"ref": "None Leviticus 1:27", "text": "هغه غویی او سېرلی چې د ګناه د نذرانو دپاره ورڅخه کار واخیستل شو او د هغو وینه د کفارې د ادا کولو دپاره ډېر سپېڅلي ځای ته راوړل شوه، باید د کمپ څخه دباندې یووړل شي. د هغو پوستکي، غوښه او خوشایي دې وسوځول شي."}, {"ref": "None Leviticus 1:27", "text": "د خپلو شقیقو ویښتان مه خرایئ او ږیره مه لنډوئ."}, {"ref": "None Leviticus 1:28", "text": "خو که چېرې بیاهم زخم بدل شوی نه وي او خپور شوی نه وي، خو مړاوی شوی وي، نو دا د سوځېدلي ځای پړسوب دی او کاهن به هغه کس پاک اعلان کړي. دا یوازې د سوځېدلي ځای داغ دی."}, {"ref": "None Leviticus 1:28", "text": "د خپل ورغوي څخه دې لږ تېل په هماغو ځایونو باندې وسولوي چې د تاوان د نذرانې وینه یې ورباندې سولولې وه، یعنې د هغه کس چې پاکیږي د هغه د ښي غوږ په نرمۍ، د ښي لاس په غټې ګوتې او د ښي پښې په غټې ګوتې دې هغه وسولوي."}, {"ref": "None Leviticus 1:28", "text": "وروسته له دې چې د هغې وینه ودریږي، باید اووه ورځې صبر وکړي، نو بیا به هغه پاکه شي."}, {"ref": "None Leviticus 1:28", "text": "کوم سړی چې هغه سوځوي باید خپل کالي ووینځي او غسل دې وکړي، له هغې وروسته هغه کمپ ته ننوتلی شي."}, {"ref": "None Leviticus 1:28", "text": "که چېرې تاسو دا ځمکه ناپاکه کړئ، نو هغه به تاسو ایسته وغورځوي لکه څنګه چې ستاسو څخه مخکې قومونه یې غورځولي وو."}, {"ref": "None Leviticus 1:28", "text": "د مړي په غم کې خپل بدنونه مه غوڅوئ او خالونه ورباندې مه جوړوئ. زه څښتن یم."}, {"ref": "None Leviticus 1:29", "text": "د هغو حیواناتو څخه چې په ځمکه باندې ګرځي، دغه حیوانات ستاسو دپاره ناپاک دي: ړنده مږه، موږک، هر ډول سمساره،"}, {"ref": "None Leviticus 1:29", "text": "که چېرې د یو سړي یا د یوې ښځې په سر یا په زنه باندې زخم وي،"}, {"ref": "None Leviticus 1:29", "text": "کاهن به هغه تېل چې د هغه په ورغوي کې پاتې دي، د هغه کس په سر باندې چې پاکیږي، توی کړي او په دې ډول به د هغه دپاره د څښتن په حضور کې کفاره ادا کړي."}, {"ref": "None Leviticus 1:29", "text": "په اتمه ورځ باید هغه ښځه دوه کوترې یا دوه قمري ګانې واخلي او هغه دې د سپېڅلې خېمې د دروازې په خوله کې کاهن ته راوړي."}, {"ref": "None Leviticus 1:29", "text": "په لاندېنیو مقرراتو باندې دې د تل دپاره عمل وشي. د اوومې میاشتې په لسمه ورځ تاسو ټول اسراییلیان او هغه پردي خلک چې ستاسو په منځ کې اوسیږي، باید روژه ونیسئ او هېڅ کار باید ونه کړئ،"}, {"ref": "None Leviticus 1:29", "text": "نو هرڅوک چې د داسې کارونو څخه چې د کرکې وړ دي کوم کار وکړي، نو د خدای د قوم څخه به وشړل شي.»"}, {"ref": "None Leviticus 1:29", "text": "د خپلو لورګانو څخه بدلمنې مه جوړوئ او هغوی مه شرموئ. که داسې وکړئ، نو دا خاوره به په بدلمنۍ بدله شي او د بدکارۍ څخه به ډکه شي."}, {"ref": "None Leviticus 1:30", "text": "ډول ډول د کور او د شګې چرمښکۍ او کربوړی."}, {"ref": "None Leviticus 1:30", "text": "نو کاهن دې هغه زخم معاینه کړي. که چېرې هغه د پوستکي څخه ژور ښکاري او زیړ نري ویښتان په کې وي، نو کاهن به هغه کس ناپاک اعلان کړي. دا یو خارښت دی او د سر یا د زنې ساري ناروغي ده."}, {"ref": "None Leviticus 1:30", "text": "کاهن دې یوه د ګناه د نذرانې دپاره او بله د سوځېدونکې نذرانې دپاره قرباني کړي. په دې ډول به هغه د څښتن په حضور کې د هغې ښځې دپاره د هغې د وینې د بهېدلو د ناپاکۍ په خاطر کفاره ادا کړي."}, {"ref": "None Leviticus 1:30", "text": "ځکه چې په دې ورځ به ستاسو د پاکولو دپاره کفاره ادا شي. بیا به تاسو د څښتن په حضور کې د خپلو ټولو ګناهونو څخه پاک شئ."}, {"ref": "None Leviticus 1:30", "text": "څښتن وویل: «زما امرونو ته غاړه کېږدئ او د هغو د کرکې وړ رواجونو څخه پیروي مه کوئ چې ستاسو د راتګ څخه مخکې به کېدل او په هغو باندې خپل ځانونه مه ناپاکه کوئ. زه ستاسو څښتن خدای یم.»"}, {"ref": "None Leviticus 1:30", "text": "د سبت د ورځې څخه پیروي وکړئ او د هغه ځای درناوی وکړئ چې زما عبادت په کې کیږي. زه څښتن یم."}, {"ref": "None Leviticus 1:31", "text": "هرڅوک چې د هغو مړو ته لاس وروړي، هغه به تر ماښامه پورې ناپاک وي."}, {"ref": "None Leviticus 1:31", "text": "خو کله چې کاهن د ناسور دا ډول زخم معاینه کړي، که چېرې هغه د پوستکي څخه ژور نه ښکاره کېده، خو بیاهم تور ویښتان په کې نه وو، نو کاهن دې هغه ناروغه کس اووه ورځې بېل وساتي."}, {"ref": "None Leviticus 1:31", "text": "کله چې ستاسو څخه کوم یو ناپاک وي، باید د اسراییلو د قوم څخه لېرې واوسیږي. که نه، نو زما سپېڅلې خېمه به چې د کمپ په منځ کې ده، ناپاکه شي او ټول قوم به مړ شي.»"}, {"ref": "None Leviticus 1:31", "text": "دا به د سبت په شان د ارام کولو سپېڅلې ورځ وي، په دې ورځ باید تاسو روژه ونیسئ. په دغو مقرراتو باندې دې د تل دپاره عمل وشي."}, {"ref": "None Leviticus 1:31", "text": "هغو خلکو ته مه ورځئ چې هغوی دعوه کوي چې دوی کولای شي د مړو سره خبرې وکړي. همدارنګه د فال کتونکو پسې مه ګرځئ، ځکه چې د هغوی په وسیله به تاسو ناپاک شئ. زه ستاسو څښتن خدای یم."}, {"ref": "None Leviticus 1:32", "text": "که چېرې د هغو مړي په یو شي باندې ولویږي، هغه شی به ناپاک شي. همداسې کار به د لرګي، ټوکر، څرمنې، یا بوجۍ په موادو باندې کیږي او مهمه نه ده چې هغه د څه شي دپاره کارول کیږي. هغه دې په اوبو کې غوټه کړای شي، خو تر ماښامه پورې به ناپاک پاتې شي."}, {"ref": "None Leviticus 1:32", "text": "په اوومه ورځ دې کاهن هغه زخم معاینه کړي. که چېرې خارښت خپور شوی نه ؤ او زیړ ویښتان په کې نه وو او د پوستکي څخه ژور نه ښکاره کېده،"}, {"ref": "None Leviticus 1:32", "text": "دا مقررات د هغه چا دپاره دي چې د پوستکي په ساري ناروغۍ باندې اخته وي او د خپل ځان د پاکوالي دپاره هغه نذرانې چې رواج وې، نه شي اخیستلی.»"}, {"ref": "None Leviticus 1:32", "text": "هغه کاهن چې مسح شوی وي او د خپل پلار په ځای د لوی کاهن په توګه وقف شوی وي، هغه دې کفاره ادا کړي. هغه دې د کتان سپېڅلي کالي واغوندي"}, {"ref": "None Leviticus 1:32", "text": "د سپین ږیرو په مخکې پاڅېږئ، د مشرانو درناوی کوئ او زما څخه وېرېږئ. زه څښتن یم."}, {"ref": "None Leviticus 1:33", "text": "که چېرې د هغو مړي د خټې په یو لوښي کې وغورځیږي، هرڅه چې په هغه کې دي ناپاک به شي او تاسو باید هغه لوښی مات کړئ."}, {"ref": "None Leviticus 1:33", "text": "نو د هغه کس ټول سر باید وخرایل شي پرته له زخمي ځای څخه. کاهن دې هغه نورې اووه ورځې بېل وساتي."}, {"ref": "None Leviticus 1:33", "text": "څښتن موسی او هارون ته وویل:"}, {"ref": "None Leviticus 1:33", "text": "او دا مراسم دې سرته ورسوي د دې په خاطر چې ډېر سپېڅلی ځای، د سپېڅلې خېمې پاتې برخې او د قربانۍ ځای پاک کړي او د کاهنانو او ټول قوم دپاره کفاره ادا کړي."}, {"ref": "None Leviticus 1:33", "text": "د هغو پردیو خلکو سره بد چلند مه کوئ چې ستاسو په خاوره کې اوسیږي."}, {"ref": "None Leviticus 1:34", "text": "کوم خواړه چې په عادي توګه حلال وي، خو که د داسې لوښي څخه په هغو خوړو باندې اوبه توی شي، هغه به ناپاک شي او د څښلو هرڅه چې په دې لوښي کې وي، هغه ناپاک دي."}, {"ref": "None Leviticus 1:34", "text": "په اوومه ورځ دې کاهن هغه خارښت بیا معاینه کړي، که چېرې هغه په پوستکي کې خپور شوی نه ؤ او د پوستکي څخه ژور نه ښکاره کېده، کاهن به هغه پاک اعلان کړي. هغه کس باید خپل کالي ووینځي او پاک به شي."}, {"ref": "None Leviticus 1:34", "text": "«کله چې تاسو د کنعان خاورې ته چې تاسو ته یې ستاسو د ملکیت په توګه درکوم، ورننوځئ او که چېرې په تاسو کې څوک په یو کور کې یوه چڼاسکه چې ما درلېږلې ده پیدا کړي،"}, {"ref": "None Leviticus 1:34", "text": "د اسراییلیانو د ټولو ګناهونو دپاره دې په کال کې یوځل کفاره ادا شي. په دې مقرراتو باندې دې د تل دپاره عمل وشي.» نو څنګه چې څښتن موسی ته امر کړی ؤ، هماغسې وشول."}, {"ref": "None Leviticus 1:34", "text": "د هغوی سره د یو اسراییلي په شان چلند وکړئ او د خپلو ځانونو په شان ورسره مینه وکړئ. دا یاد ساتئ چې تاسو هم یو وخت د مصر په خاوره کې پردي وئ. زه ستاسو څښتن خدای یم."}, {"ref": "None Leviticus 1:35", "text": "په هر شي باندې چې د هغو مړي ولویږي هغه شی ناپاکه کیږي، که په هغو کې نغری یا د پخلي لوښی شامل وي، هغه باید مات شي."}, {"ref": "None Leviticus 1:35", "text": "خو که چېرې د هغه د پاکوالي د اعلان څخه وروسته خارښت خپور شي،"}, {"ref": "None Leviticus 1:35", "text": "نو د هغه کور خاوند باید لاړ شي او کاهن ته دې داسې ووایي چې ما په خپل کور کې یو شی لیدلی دی چې د چڼاسکې په شان ښکاري."}, {"ref": "None Leviticus 1:35", "text": "کله چې تاسو یو شی اندازه کوئ یا هغه وزن کوئ، نو غلطي په کې مه کوئ او هېڅوک مه غولوئ."}, {"ref": "None Leviticus 1:36", "text": "خو یوه چینه یا څاه چې دغه مړه حیوانات په کې پراته وي، هغه پاک پاتې کیږي. خو هرڅوک چې د دغو مړو له جملې څخه کوم یو ته لاس وروړي، هغه به ناپاک شي."}, {"ref": "None Leviticus 1:36", "text": "کاهن دې هغه معاینه کړي او که چېرې خارښت په پوستکي کې خپور شوی وي، کاهن دا اړتیا نه لري چې زیړ ویښتان ولټوي، هغه کس ناپاک دی."}, {"ref": "None Leviticus 1:36", "text": "کاهن به داسې حکم وکړي چې مخکې له دې چې هغه د چڼاسکې د معاینه کولو دپاره لاړ شي، هرڅه دې د هغه کور څخه راوویستل شي. که نه، نو هرڅه چې په هغه کور کې دي، هغه به ناپاکه اعلان شي. له هغې وروسته دې کاهن دننه لاړ شي او کور دې معاینه کړي."}, {"ref": "None Leviticus 1:36", "text": "د سمو ترازوګانو، سمو وزنونو او سمو اندازو څخه کار اخلئ. زه ستاسو څښتن خدای یم او ما تاسو د مصر څخه راوویستلئ."}, {"ref": "None Leviticus 1:37", "text": "که چېرې یو داسې مړی په هغو تخمونو باندې وغورځیږي چې کرل کیږي، هغه تخمونه پاک پاتې کیږي."}, {"ref": "None Leviticus 1:37", "text": "خو که چېرې د هغه په نظر کې هغه بدل شوی نه وي او تور ویښتان په کې راشنه شوي وي، دا خارښت روغ شوی دی. هغه کس پاک دی او کاهن به هغه همداسې پاک اعلان کړي."}, {"ref": "None Leviticus 1:37", "text": "هغه دې په دېوالونو باندې چڼاسکې معاینه کړي. که چېرې په هغه کې شین بخن یا سوربخن داغونه وي چې دېوال خرابوي،"}, {"ref": "None Leviticus 1:37", "text": "زما د ټولو فرمانونو او قوانینو څخه پیروي کوئ. زه څښتن یم.»"}, {"ref": "None Leviticus 1:38", "text": "خو که چېرې په تخمونو باندې اوبه توی شوې وي او په هغه باندې یو داسې مړی ولویږي، نو هغه ستاسو دپاره ناپاک دي."}, {"ref": "None Leviticus 1:38", "text": "کله چې د یو سړي یا د یوې ښځې په پوستکي باندې سپین داغونه وي،"}, {"ref": "None Leviticus 1:38", "text": "نو کاهن به د هغه کور څخه لاړ شي او کور به د اوو ورځو دپاره بند کړي."}, {"ref": "None Leviticus 1:39", "text": "که چېرې یو حیوان چې ستاسو دپاره پاک وي مړ شي، هرڅوک چې د هغه مړي ته لاس وروړي هغه به تر ماښامه پورې ناپاک وي."}, {"ref": "None Leviticus 1:39", "text": "نو کاهن دې هغه کس معاینه کړي. که چېرې دا داغونه مړاوي او سپین وي، هغه یوه بې زیانه ګرمکه ده چې په بدن باندې راختلې ده، هغه کس پاک دی."}, {"ref": "None Leviticus 1:39", "text": "په اوومه ورځ به کاهن بېرته راشي او هغه کور به بیا معاینه کړي. که چېرې چڼاسکه په دېوالونو باندې خپره شوې وي،"}, {"ref": "None Leviticus 1:40", "text": "هرڅوک چې د دې مړ حیوان د غوښې څخه لږه غوښه وخوري، باید خپل کالي ووینځي، خو هغه به تر ماښامه پورې ناپاک وي. هرڅوک چې د هغه مړی راپورته کړي، هغه باید خپل کالي ووینځي، خو هغه به تر ماښامه پورې ناپاک وي."}, {"ref": "None Leviticus 1:40", "text": "که چېرې یو سړي خپل ویښتان له لاسه ورکړي وي او ګنجی شوی وي، هغه پاک دی."}, {"ref": "None Leviticus 1:40", "text": "هغه دې حکم وکړي چې هغه تیږې چې چڼاسکې ورباندې پیدا شوې دي، هغه دې لېرې شي او د ښار څخه دې دباندې په یو ناپاک ځای کې وغورځول شي."}, {"ref": "None Leviticus 1:41", "text": "هره خزنده چې په ځمکه باندې ګرځي، باید ونه خوړل شي."}, {"ref": "None Leviticus 1:41", "text": "که چېرې هغه د خپلې کوپړۍ یا تندي ویښتان له لاسه ورکړي وي او لوڅ تندی ولري، هغه پاک دی."}, {"ref": "None Leviticus 1:41", "text": "له هغې وروسته باید کاهن ټول دننني دېوالونه په یو چا باندې وتوږي او خاوره دې د ښار څخه دباندې په یو ناپاکه ځای کې وغورځوي."}, {"ref": "None Leviticus 1:42", "text": "ستاسو دپاره هره خزنده حرامه ده، که هغه په سینه باندې ښوییږي یا په څلورو یا په ډېرو پښو ګرځي."}, {"ref": "None Leviticus 1:42", "text": "خو که چېرې د هغه په ګنجي سر یا لوڅ تندي باندې سوربخن سپین زخم وي، دا د پوستکي یوه ساري ناروغي ده."}, {"ref": "None Leviticus 1:42", "text": "بیا دې د هغو تیږو په ځای چې لېرې کړای شوې دي د نورو تیږو څخه کار واخیستل شي او دېوالونو ته دې نوی اخېړ ورکړای شي."}, {"ref": "None Leviticus 1:43", "text": "د هغو څخه د کوم یو په خوړلو سره خپل ځانونه مه ناپاکه کوئ."}, {"ref": "None Leviticus 1:43", "text": "کاهن دې هغه معاینه کړي او که چېرې زخم سوربخن سپین وي،"}, {"ref": "None Leviticus 1:43", "text": "که چېرې د دېوالونو د تیږو د لېرې کولو، توږلو او اخېړولو نه وروسته بیا په هغه کور کې چڼاسکه راښکاره شي"}, {"ref": "None Leviticus 1:44", "text": "زه ستاسو څښتن خدای یم، تاسو باید خپل ځانونه پاک کړئ او سپېڅلي اوسئ، ځکه چې زه سپېڅلی یم. خپل ځانونه په هېڅ یوې خزندې باندې مه ناپاکه کوئ."}, {"ref": "None Leviticus 1:44", "text": "نو هغه سړی ناروغ او ناپاک دی. کاهن به هغه ناپاک اعلان کړي، ځکه چې د هغه په سر باندې زخم دی."}, {"ref": "None Leviticus 1:44", "text": "نو کاهن دې لاړ شي او هغه دې بیا معاینه کړي. که چېرې په کور کې چڼاسکه خپره شوې وي، نو دا یوه خرابوونکې چڼاسکه ده او دا کور ناپاک دی."}, {"ref": "None Leviticus 1:45", "text": "زه څښتن یم چې تاسو مې د مصر څخه راوویستلئ، ترڅو ستاسو خدای اوسم. له دې امله تاسو باید سپېڅلي اوسئ، ځکه چې زه سپېڅلی یم."}, {"ref": "None Leviticus 1:45", "text": "هغه کس چې په داسې ساري ناروغۍ اخته وي باید شلېدلي کالي واغوندي، خپل ویښتان دې ببر پرېږدي، خپله خوله دې پټه کړي او داسې چیغې دې ووهي: زه ناپاک یم! زه ناپاک یم!"}, {"ref": "None Leviticus 1:45", "text": "هغه کور باید وران شي او د هغه تیږې، تیرونه او ټوله خاوره باید د ښار څخه دباندې یو ناپاکه ځای ته یووړل شي."}, {"ref": "None Leviticus 1:46", "text": "دا قوانین د حیواناتو، مرغانو او هرڅه چې په اوبو کې ژوند کوي او ټولو خزندو په اړه دي."}, {"ref": "None Leviticus 1:46", "text": "ترڅو پورې چې هغه کس په دې ناروغۍ باندې اخته وي هغه ناپاک پاتې کیږي. هغه باید یوازې او د کمپ څخه دباندې واوسیږي."}, {"ref": "None Leviticus 1:46", "text": "په هغه دوران کې چې کاهن هغه کور بند اعلان کړی وي، نو هرڅوک چې هغه ته ننوځي، هغه به تر ماښامه پورې ناپاک وي."}, {"ref": "None Leviticus 1:47", "text": "تاسو باید پام وکړئ چې د پاک او ناپاک او همدارنګه د حلالو او حرامو حیواناتو ترمنځ فرق وکړئ.»"}, {"ref": "None Leviticus 1:47", "text": "که چېرې کوم کالي چڼاسکې وهلي وي، که هغه د وړیو څخه جوړ شوي وي یا د کتان کالي وي،"}, {"ref": "None Leviticus 1:47", "text": "همدارنګه هرڅوک چې په هغه کور کې خوب کوي یا خوراک کوي، باید خپل کالي ووینځي."}, {"ref": "None Leviticus 1:48", "text": "د کتان یا وړیو ټوکر، یا څرمن او یا داسې شی وي چې د څرمنې څخه جوړ شوی وي،"}, {"ref": "None Leviticus 1:48", "text": "خو که چېرې کاهن راشي او هغه معاینه کړي، نو که د کور د اخېړولو څخه وروسته چڼاسکه خپره شوې نه وي، نو هغه به کور پاک اعلان کړي، ځکه چې چڼاسکه ورکه شوې ده."}, {"ref": "None Leviticus 1:49", "text": "که چېرې هغه چڼاسکه شنه بخنه یا سره بخنه وي، نو دا یوه خپرېدونکې چڼاسکه ده او کاهن ته باید وروښودل شي."}, {"ref": "None Leviticus 1:49", "text": "هغه دې د کور د پاکولو دپاره دوه مرغۍ، د سبر لرګی، سور تار او د وېلني بوټی راواخلي."}, {"ref": "None Leviticus 1:50", "text": "کاهن دې هغه چڼاسکه معاینه کړي او هغه شی دې اووه ورځې بېل کېږدي."}, {"ref": "None Leviticus 1:50", "text": "هغه به د دغو مرغیو څخه یوه د خټو د لوښي دپاسه چې د چینې تازه اوبه په کې وي، حلاله کړي."}, {"ref": "None Leviticus 1:51", "text": "په اوومه ورځ دې هغه بیا معاینه کړي. که چېرې چڼاسکه خپره شوې وه، نو هغه شی ناپاک دی."}, {"ref": "None Leviticus 1:51", "text": "بیا دې د سبر لرګی، د وېلني بوټی، سور تار او ژوندۍ مرغۍ راواخلي او هغه دې د مړې مرغۍ په وینه او تازه اوبو کې غوټه کړي او په کور باندې دې اووه ځلې وشیندي."}, {"ref": "None Leviticus 1:52", "text": "کاهن باید هغه کالي وسوځوي، ځکه چې چڼاسکه خرابوونکې ده او هغه دې وسوځول شي."}, {"ref": "None Leviticus 1:52", "text": "په دې ډول به کاهن هغه کور د مرغۍ په وینه، تازه اوبو، ژوندۍ مرغۍ، د سبر په لرګي، د وېلني په بوټي او سور تار باندې پاک کړي."}, {"ref": "None Leviticus 1:53", "text": "خو کله چې کاهن هغه معاینه کړي او دا معلومه کړي چې چڼاسکه په هغه شي باندې نه ده خپره شوې،"}, {"ref": "None Leviticus 1:53", "text": "بیا دې هغه ژوندۍ مرغۍ د ښار څخه دباندې په صحرا کې خوشې کړي. په دې ډول به هغه د کور دپاره د پاکوالي مراسم سرته ورسوي او هغه به پاک شي.»"}, {"ref": "None Leviticus 1:54", "text": "هغه به دا حکم وکړي چې دا خراب شوی شی ووینځل شي. بیا دې هغه د نورو اوو ورځو دپاره بېل کېږدي."}, {"ref": "None Leviticus 1:54", "text": "دا مقررات د پوستکي د هرې ساري ناروغۍ دپاره دي لکه خارښت،"}, {"ref": "None Leviticus 1:55", "text": "وروسته له دې چې خراب شوی شی ووینځل شي، کاهن دې هغه بیا معاینه کړي. که چېرې چڼاسکې خپل رنګ نه وي بدل کړی، که څه هم هغه خپره شوې نه ده، بیاهم هغه ناپاک دی. که دا خرابوالی په مخکې وي یا شاته، تاسو باید دا شی وسوځوئ."}, {"ref": "None Leviticus 1:56", "text": "خو کله چې کاهن هغه معاینه کړي، که چېرې د هغه شي د وینځلو څخه وروسته چڼاسکه مړاوې شوې وي، هغه دې خرابه شوې برخه وشلوي."}, {"ref": "None Leviticus 1:57", "text": "خو که چېرې چڼاسکه په پورتنیو شیانو باندې بیا راښکاره شي، نو دا خپرېدونکې ده او په هرڅه باندې چې چڼاسکه وي، نو خاوند یې باید هغه شی وسوځوي."}, {"ref": "None Leviticus 1:57", "text": "د دې مقرراتو له مخې دا پرېکړه کېدای شي چې یو شی په کوم وخت کې پاک دی او په کوم وخت کې ناپاک."}, {"ref": "None Leviticus 1:58", "text": "که چېرې هغه کس هغه شی ووینځي او چڼاسکه ورکه شي هغه دې بیا ووینځل شي، نو هغه شی به پاک شي."}, {"ref": "None Leviticus 1:59", "text": "دا قوانین د هغو کالیو په هکله دي چې چڼاسکې وهلي وي، که هغه د وړیو یا کتان څخه جوړ شوي وي، د وړیو یا کتان ټوکر وي یا هغه شیان وي چې د څرمنې څخه جوړ شوي وي. نو په دې ډول به کاهن کولای شي دا پرېکړه وکړي چې ایا دا شیان پاک دي یا ناپاک.»"}, {"ref": "None Leviticus 2:1", "text": "څښتن موسی ته وویل:"}, {"ref": "None Leviticus 2:1", "text": "څښتن موسی ته وویل: «د کاهنانو یعنې د هارون د زامنو سره خبرې وکړه او ورته ووایه: هېڅ یو کاهن باید د خپلوانو د مړي د جنازې په مراسمو کې په ګډون کولو سره خپل ځان ناپاک نه کړي،"}, {"ref": "None Leviticus 2:1", "text": "څښتن موسی ته وویل:"}, {"ref": "None Leviticus 2:1", "text": "څښتن موسی ته وویل:"}, {"ref": "None Leviticus 2:1", "text": "څښتن موسی ته وویل:"}, {"ref": "None Leviticus 2:1", "text": "د سینا په غره باندې څښتن موسی ته وویل:"}, {"ref": "None Leviticus 2:1", "text": "څښتن وویل: «د خپلو ځانونو دپاره بتان، مجسمې یا د تیږو ستنې مه جوړوئ چې د هغو عبادت وکړئ. زه ستاسو څښتن خدای یم."}, {"ref": "None Leviticus 2:1", "text": "څښتن موسی ته وویل:"}, {"ref": "None Leviticus 2:2", "text": "«اسراییلیانو ته ووایه: که ستاسو څخه یو څوک یا کوم پردی کس چې په اسراییلو کې اوسیږي د خپلو ماشومانو څخه کوم ماشوم د مولک بت ته د قربانۍ په توګه وړاندې کړي، هغه باید ووژل شي. د قوم خلک دې هغه سنګسار کړي."}, {"ref": "None Leviticus 2:2", "text": "پرته له یو نژدې خپلوان څخه لکه د هغه مور یا پلار، د هغه زوی یا لور، د هغه سکه ورور،"}, {"ref": "None Leviticus 2:2", "text": "«هارون او د هغه زامنو ته ووایه چې د هغو پاکو نذرانو درناوی وکړي چې اسراییلیان یې ماته وقف کوي، ترڅو هغوی زما سپېڅلی نوم سپک نه کړي. زه څښتن یم."}, {"ref": "None Leviticus 2:2", "text": "«د اسراییلو خلکو ته ووایه چې ما ستاسو دپاره څو مذهبي اخترونه ټاکلي دي چې سره راټول شئ او زما عبادت وکړئ."}, {"ref": "None Leviticus 2:2", "text": "«اسراییلیانو ته امر وکړه چې د هغو څراغونو دپاره چې په سپېڅلې خېمه کې دي د زیتونو سوچه تېل راوړي، ترڅو هغه په دوامداره توګه بل وساتل شي."}, {"ref": "None Leviticus 2:2", "text": "«د اسراییلیانو سره خبرې وکړه او ورته ووایه: کله چې تاسو هغې خاورې ته چې زه یې درکوم ورننوځئ، باید څښتن ته د درناوي په خاطر هر اووم کال د ځمکې د کرلو څخه ډډه وکړئ."}, {"ref": "None Leviticus 2:2", "text": "د سبت د ورځې څخه پیروي وکړئ او د هغه ځای درناوی وکړئ چې زما عبادت په کې کیږي. زه څښتن یم."}, {"ref": "None Leviticus 2:2", "text": "«د اسراییلیانو سره خبرې وکړه او ورته ووایه چې که چېرې څوک یو بل کس د ځانګړي نذر په توګه څښتن ته وقف کړي، نو هغه کس به د لاندېنیو پیسو په ورکولو سره ازاد شي:"}, {"ref": "None Leviticus 2:3", "text": "زه به د هغه کس په خلاف شم او د خپل قوم څخه به یې وشړم، ځکه چې مولک ته د خپلو ماشومانو په قرباني کولو سره یې زما سپېڅلی ځای ناپاک کړی او زما د سپېڅلي نوم سپکاوی یې کړی دی."}, {"ref": "None Leviticus 2:3", "text": "یا یوه پېغله خور چې واده شوې نه وي او مېړه نه لري چې هغه وساتي."}, {"ref": "None Leviticus 2:3", "text": "که چېرې ستاسو د اولادې څخه کوم یو د ناپاکۍ په حال کې هغو سپېڅلو نذرانو ته ورنژدې شي چې د اسراییلو قوم ماته وقف کړې دي، هغه بیا هېڅکله د قربانۍ په ځای کې خدمت نه شي کولای. دا خبره به تل ترتله عملي کیږي. زه څښتن یم."}, {"ref": "None Leviticus 2:3", "text": "تاسو د خپل کار دپاره شپږ ورځې لرئ، خو اوومه ورځ چې د سبت ورځ ده، د ارام کولو دپاره ده. په هغه ورځ کار مه کوئ، خو د عبادت دپاره راټول شئ. دا مهمه نه ده چې چېرته اوسېږئ، سبت د څښتن ورځ ده."}, {"ref": "None Leviticus 2:3", "text": "هارون دې هر ماښام هغه بل کړي او هغه دې تر سهاره پورې د څښتن په حضور کې د پردې څخه دباندې د لوظ د صندوق په مخکې چې په ډېر سپېڅلي ځای کې دی، بل وساتي. دا حکم دې د تل دپاره مراعت شي."}, {"ref": "None Leviticus 2:3", "text": "شپږ کاله خپل پټي وکرئ او شپږ کاله د خپلو انګورو د تاکونو څانګې اصلاح کړئ او حاصلات یې راټول کړئ."}, {"ref": "None Leviticus 2:3", "text": "که چېرې تاسو زما د فرمانونو څخه پیروي وکړئ او زما امرونو ته غاړه کېږدئ،"}, {"ref": "None Leviticus 2:4", "text": "کله چې هغه کس داسې کار وکړي او قوم ورباندې خپلې سترګې پټې کړي او هغه کس ونه وژني،"}, {"ref": "None Leviticus 2:4", "text": "هغه به خپل ځان د هغه چا په مرګ باندې نه ناپاکه کوي چې د واده په وسیله د هغه خپلوان شوی وي."}, {"ref": "None Leviticus 2:4", "text": "که چېرې د هارون د اولادې څخه کوم یو د پوستکي په ساري ناروغۍ اخته وي یا د بدن څخه یې زوه راوځي، هغه تر هغه وخته پورې دا پاکې نذرانې نه شي خوړلی، ترڅو پورې چې پاک نه شي. هر کاهن چې داسې کوم شي ته لاس وروړي چې د مړي سره د لګېدلو په وسیله ناپاک شوی وي یا که چېرې د کاهن څخه مني ووځي،"}, {"ref": "None Leviticus 2:4", "text": "دغه اخترونه باید په ټاکل شویو وختونو کې اعلان کړئ."}, {"ref": "None Leviticus 2:4", "text": "هارون باید په هغو څراغونو باندې پام وکړي چې د سوچه سرو زرو په څراغدان باندې دي او وګوري چې هغه په منظمه توګه د څښتن په حضور کې بل وي."}, {"ref": "None Leviticus 2:4", "text": "خو په اووم کال دې ځمکه بیخي شاړه پاتې شي، دا به څښتن ته وقف شوی کال وي. په دې کال کې خپل پټي مه کرئ او د خپلو انګورو د تاکونو څانګې مه اصلاح کوئ."}, {"ref": "None Leviticus 2:4", "text": "نو زه به په سم وخت په تاسو باندې باران ووروم، ترڅو ځمکه حاصلات ورکړي او ونې مېوې ونیسي."}, {"ref": "None Leviticus 2:5", "text": "نو زه به په خپله د هغه کس، د هغه د ټولې کورنۍ او هغو ټولو په خلاف شم چې د هغه سره یوځای زما سره بې وفایي کوي او د مولک عبادت کوي. زه به هغوی د خپل قوم څخه وشړم."}, {"ref": "None Leviticus 2:5", "text": "هېڅ کاهن به په دې خاطر چې هغه داسې ښکاره شي چې د چا په مرګ باندې غمجن دی، نه به د خپل سر کومه برخه خرایي، نه به خپله ږیره لنډوي او نه به خپل بدن غوڅوي."}, {"ref": "None Leviticus 2:5", "text": "یا که چېرې هغه په ناپاک حیوان یا ناپاک کس باندې لاس وهلی وي، نو هغه ناپاک کیږي."}, {"ref": "None Leviticus 2:5", "text": "څښتن ته د درناوي کولو دپاره د فسحې د اختر لمانځل هر کال د لومړۍ میاشتې په څوارلسمه ورځ د لمرپرېواته په وخت کې پیل کیږي."}, {"ref": "None Leviticus 2:5", "text": "څلورویشت کیلو ګرامه ښه اوړه واخله او دولس ډوډۍ ورڅخه پخې کړه."}, {"ref": "None Leviticus 2:5", "text": "هغه غلې دانې مه رېبئ چې بې له کرلو په خپله راشنې کیږي او د خپلو هغو تاکونو څخه انګور مه راټولوئ چې څانګې یې اصلاح شوې نه وي. دا یو کال دی چې ځمکه په کې بیخي شاړه پاتې کیږي."}, {"ref": "None Leviticus 2:5", "text": "ستاسو فصلونه به دومره پرېمانه شي چې ستاسو د غلو دانو غوبل به تر هغې پورې دوام وکړي، ترڅو د انګورو د راټولولو وخت راشي او ستاسو د انګورو د حاصل راټولول به تر هغه وخته پورې دوام وکړي، ترڅو د غلو دانو د کرلو وخت راورسیږي. هرڅه چې تاسو یې غواړئ، هغه به وخورئ او په خپله خاوره کې به په امن سره واوسېږئ."}, {"ref": "None Leviticus 2:6", "text": "که چېرې تاسو هغو خلکو ته ورشئ چې کوډې کوي یا کولای شي چې د مړو سره خبرې وکړي، نو زه به ستاسو په خلاف شم او تاسې به د خپل قوم څخه وشړم."}, {"ref": "None Leviticus 2:6", "text": "هغه باید پاک او سپېڅلی وي او زما نوم سپک نه کړي، ځکه چې هغه ماته په اور باندې د خوړو نذرانې تیاروي او باید سپېڅلی وي."}, {"ref": "None Leviticus 2:6", "text": "هر کاهن چې دغو شیانو ته لاس وروړي هغه به ناپاک شي، نو هغه تر ماښامه پورې ناپاک پاتې کیږي. بیاهم هغه پاکې نذرانې نه شي خوړلی، ترڅو پورې چې غسل ونه کړي."}, {"ref": "None Leviticus 2:6", "text": "په پنځلسمه ورځ د فطیرې ډوډۍ اختر پیل کیږي او اووه ورځې دوام کوي. تاسو باید په دې موده کې فطیره ډوډۍ وخورئ."}, {"ref": "None Leviticus 2:6", "text": "دا ډوډۍ په دوه قطارونو کې چې په هر قطار کې شپږ ډوډۍ وي، په هغه مېز باندې کېږده چې په سوچه سرو زرو پوښل شوی دی او د څښتن په حضور کې دی."}, {"ref": "None Leviticus 2:6", "text": "زه به ستاسو خاورې ته ارامي راولم او تاسو به بې د چا له وېرې خوب کولای شئ. زه به د هغې خاورې څخه خطرناک حیوانات لېرې کړم او هلته به نور جنګ نه وي."}, {"ref": "None Leviticus 2:7", "text": "خپل ځانونه پاک کړئ او سپېڅلي اوسئ، ځکه چې زه ستاسو څښتن خدای یم."}, {"ref": "None Leviticus 2:7", "text": "یو کاهن باید د یوې داسې ښځې سره واده ونه کړي چې هغه بدلمنه وي یا پېغله نه وي او یا د خپل مېړه له خوا ورته طلاق ورکړای شوی وي، ځکه چې هغه خپل خدای ته سپېڅلی دی."}, {"ref": "None Leviticus 2:7", "text": "کله چې لمر پرېوځي، هغه به پاک شي او له هغې څخه وروسته هغه کولای شي چې پاکې نذرانې وخوري، ځکه چې دا د هغه خواړه دي."}, {"ref": "None Leviticus 2:7", "text": "د دغو ورځو څخه په لومړۍ ورځ د عبادت دپاره سره راټول شئ او هېڅ خپل ورځنی کار مه کوئ."}, {"ref": "None Leviticus 2:7", "text": "په هر قطار باندې لږه سوچه او قیمتي خوشبویي واچوه چې دا خوشبویي به څښتن خدای ته په اور باندې د تیارېدونکې نذرانې د یوې نښې په شان وي چې د ډوډۍ په ځای وړاندې کیږي."}, {"ref": "None Leviticus 2:7", "text": "تاسو به په خپلو دښمنانو باندې بریالي شئ او په جګړه کې به یې ووژنئ."}, {"ref": "None Leviticus 2:8", "text": "زما د فرمانونو څخه پیروي وکړئ. زه څښتن یم چې تاسو پاک او سپېڅلي کوم."}, {"ref": "None Leviticus 2:8", "text": "خلک باید کاهن سپېڅلی وګڼي، ځکه چې هغه ماته د خوړو نذرانې وړاندې کوي. زه څښتن یم، زه سپېڅلی یم او خپل خلک سپېڅلي کوم."}, {"ref": "None Leviticus 2:8", "text": "هغه دې د داسې حیوان غوښه ونه خوري چې په خپل مرګ مړ شوی وي یا د وحشي حیواناتو په وسیله وژل شوی وي، په دې باندې به هغه ناپاک شي. زه څښتن یم."}, {"ref": "None Leviticus 2:8", "text": "اووه ورځې هغه نذرانې وړاندې کړئ چې څښتن ته په اور باندې تیاریږي او په اوومه ورځ به بیا د عبادت دپاره سره راټول شئ، خو هېڅ خپل ورځنی کار مه کوئ.»"}, {"ref": "None Leviticus 2:8", "text": "دا ډوډۍ دې په هر سبت کې د څښتن په حضور کې کېښودل شي. دا د تل دپاره د اسراییلو دنده ده."}, {"ref": "None Leviticus 2:8", "text": "اووه ځلې اووه کاله وشمېرئ، چې ټول نهه څلوېښت کاله کیږي."}, {"ref": "None Leviticus 2:8", "text": "ستاسو پنځه تنه به وکولای شي چې سلو تنو ته ماتې ورکړي او ستاسو سل تنه به وکولای شي چې لسو زرو تنو ته ماتې ورکړي."}, {"ref": "None Leviticus 2:8", "text": "که چېرې یو کس چې نذر ورکوي ډېر غریب وي او نه شي کولای چې دا ټاکل شوې اندازه ورکړي، هغه دې دا کس کاهن ته وړاندې کړي او کاهن به نذر ورکوونکي ته د هغه د توان سره سمه بیه وټاکي."}, {"ref": "None Leviticus 2:9", "text": "که چېرې یو څوک خپل پلار یا خپلې مور ته ښکنځلې وکړي، نو هغه باید ووژل شي. نو خون به یې په خپله غاړه وي."}, {"ref": "None Leviticus 2:9", "text": "که چېرې د یو کاهن لور بدلمنه شي، نو هغه خپل پلار رسوا کوي او باید وسوځول شي چې مړه شي."}, {"ref": "None Leviticus 2:9", "text": "ټول کاهنان دې زما د مقرراتو څخه چې هغوی ته مې ورکړي دي، پیروي وکړي. که نه، نو هغوی به ګناهکاران او مړه شي، ځکه چې هغوی سپېڅلو مقرراتو ته په سپکه سترګه کتلي دي. زه څښتن یم چې هغوی سپېڅلي کوم."}, {"ref": "None Leviticus 2:9", "text": "څښتن موسی ته وویل:"}, {"ref": "None Leviticus 2:9", "text": "دا ډوډۍ د هارون او د هغه د اولادې ده. هغوی دې هغه په یو سپېڅلي ځای کې وخوري، ځکه چې دا د هغو نذرانو یوه ډېره سپېڅلې برخه ده چې څښتن ته په اور باندې تیاریږي.»"}, {"ref": "None Leviticus 2:9", "text": "بیا د اوومې میاشتې په لسمه ورځ چې د کفارې ورځ ده، په ټول وطن کې سرني ووهئ."}, {"ref": "None Leviticus 2:9", "text": "زه به تاسو ته برکت درکړم او ډېر اولادونه به درکړم او په هغه لوظ باندې به ودرېږم چې تاسو سره مې کړی دی."}, {"ref": "None Leviticus 2:9", "text": "که چېرې د هغه نذر یو داسې حیوان وي چې څښتن ته د نذرانې په توګه د منلو وړ وي، نو داسې سوغات چې څښتن ته ورکول کیږي، هغه سپېڅلی دی."}, {"ref": "None Leviticus 2:10", "text": "که چېرې یو سړی د بل سړي د ښځې سره زنا وکړي، هغه سړی او هغه ښځه دواړه باید ووژل شي."}, {"ref": "None Leviticus 2:10", "text": "لوی کاهن چې په سر باندې یې د مسح کولو تېل اچول شوي دي او د دې دپاره وقف شوی دی چې د کاهنتوب کالي واغوندي، نو باید خپل ویښتان ګډوډ پرېنږدي او خپل کالي ونه شلوي چې داسې ښکاره شي چې هغه د چا په مرګ باندې غمجن دی."}, {"ref": "None Leviticus 2:10", "text": "څوک چې د کاهن د کورنۍ غړی نه وي، هغه پاکې نذرانې نه شي خوړلی. د کاهن مېلمه یا مزدور هم هغه نه شي خوړلی."}, {"ref": "None Leviticus 2:10", "text": "«د اسراییلیانو سره خبرې وکړه او ورته ووایه: کله چې تاسو هغې خاورې ته چې زه یې تاسو ته درکوم ورننوځئ او فصل یې ورېبئ، نو کاهن ته لومړنۍ ګېډۍ ورکړئ."}, {"ref": "None Leviticus 2:10", "text": "په دې ډول به تاسو پنځوسم کال سپېڅلی کال وګڼئ او د وطن ټولو اوسېدونکو ته به ازادي اعلان کړئ. د دې کال په دوران کې به هغه ټول جایداد چې خرڅ شوی وي، خپل اصلي خاوند یا د هغه اولادې ته بېرته ورکړل شي او هرڅوک چې د غلام په توګه خرڅ شوی وي، خپلې کورنۍ ته به ورستون شي."}, {"ref": "None Leviticus 2:10", "text": "ستاسو حاصلات به دومره پرېمانه شي چې هغه به تر کاله پورې ورسیږي او حتی څه چې د زاړه حاصل څخه پاتې دي هغه به لېرې وغورځوئ، ترڅو د نوي حاصل دپاره ځای پیدا شي."}, {"ref": "None Leviticus 2:10", "text": "که هغه حیوان ښه وي یا خراب، هغه نه شي کولای چې د بل حیوان سره یې بدل کړي. که چېرې داسې وکړي، نو دواړه حیوانات د څښتن کیږي."}, {"ref": "None Leviticus 2:11", "text": "که چېرې یو سړی د خپل پلار د ښځو څخه د یوې ښځې سره زنا وکړي، هغه خپل پلار سپکوي، نو هغه سړی او ښځه دواړه باید ووژل شي. خون به یې په خپله غاړه وي."}, {"ref": "None Leviticus 2:11", "text": "خو که چېرې یو کاهن په خپلو پیسو باندې یو غلام اخیستی وي یا که چېرې یو غلام د هغه په کورنۍ کې زېږېدلی وي، هغه غلام کولای شي چې هغه خواړه وخوري."}, {"ref": "None Leviticus 2:11", "text": "هغه دې دا ګېډۍ د څښتن په حضور کې پورته کړي، ترڅو هغه ستاسو په خاطر قبوله شي. کاهن دې هغه د سبت د ورځې څخه وروسته په بله ورځ پورته کړي."}, {"ref": "None Leviticus 2:11", "text": "پنځوسم کال به ستاسو دپاره د بېرته ورکولو کال وي. تاسو خپلې ځمکې ونه کرئ او هغه غلې دانې ونه رېبئ چې په خپله راشنې کیږي او د خپلو هغو تاکونو څخه انګور مه راټولوئ چې څانګې یې اصلاح شوې نه وي."}, {"ref": "None Leviticus 2:11", "text": "زه به راشم او ستاسو په منځ کې به اوسېږم او هېڅکله به ستاسو څخه کرکه ونه کړم."}, {"ref": "None Leviticus 2:11", "text": "که چېرې د هغه نذر یو ناپاک حیوان وي، دا چې هغه څښتن ته د نذرانې په توګه د منلو وړ نه دی، نو هغه حیوان باید کاهن ته راوستل شي."}, {"ref": "None Leviticus 2:12", "text": "که چېرې یو سړی د خپلې انږور سره زنا وکړي، هغوی دواړه باید ووژل شي. کوم کار چې هغوی کړی دی، هغه ډېر بد کار دی او خون به یې په خپله غاړه وي."}, {"ref": "None Leviticus 2:12", "text": "که چېرې د یو کاهن لور د یو داسې سړي سره واده وکړي چې هغه کاهن نه وي، هغه نه شي کولای چې پاکې نذرانې وخوري."}, {"ref": "None Leviticus 2:12", "text": "په هماغه ورځ یوه سوځېدونکې نذرانه هم څښتن ته قرباني کړئ، یعنې یو وری چې یو کلن وي او هېڅ عیب په کې نه وي."}, {"ref": "None Leviticus 2:12", "text": "هغه یې تر څارنې لاندې وساته او څښتن ته یې انتظار کاوه چې دوی ته ووایي چې د هغه سره څه وکړي."}, {"ref": "None Leviticus 2:12", "text": "د بېرته ورکولو ټول کال به ستاسو دپاره پاک وي، تاسو به یوازې هغه څه خورئ چې په پټي کې په خپل سر راشنه کیږي."}, {"ref": "None Leviticus 2:12", "text": "زه به تاسو سره مل یم او ستاسو خدای به یم او تاسو به زما قوم یئ."}, {"ref": "None Leviticus 2:12", "text": "کاهن دې د هغه د ښه والي یا بدوالي له مخې بیه وټاکي او دا به اخرنۍ بیه وي."}, {"ref": "None Leviticus 2:13", "text": "که چېرې یو سړی د یو بل سړي سره بد کار وکړي، نو هغوی د کرکې وړ کار کړی دی او دواړه باید ووژل شي. خون به یې په خپله غاړه وي."}, {"ref": "None Leviticus 2:13", "text": "هغه باید د داسې انجلۍ سره واده وکړي چې پېغله وي."}, {"ref": "None Leviticus 2:13", "text": "خو که چېرې د یو کاهن لور کونډه یا طلاقه شوې وي او اولادونه ونه لري او بېرته راشي او د خپل پلار په کور کې اوسیږي، هغه کولای شي چې هغه خواړه وخوري چې د هغې پلار یې د کاهن په توګه تر لاسه کوي. په هر حال د کاهن د کورنۍ د غړو څخه پرته هېڅوک نه شي کولای چې هغه وخوري."}, {"ref": "None Leviticus 2:13", "text": "د هغې سره به تاسو د دوو کیلو ګرامو ښو اوړو د غلې دانې یوه نذرانه چې د زیتونو تېل ورسره ګډ وي وړاندې کړئ. دا یوه داسې نذرانه ده چې په اور باندې څښتن ته تیاریږي او بوی یې په هغه باندې ښه لګیږي. همدارنګه د هغې سره به تاسو د څښلو د نذرانې په توګه یو لیتر د شرابو نذرانه هم وړاندې کړئ."}, {"ref": "None Leviticus 2:13", "text": "بیا څښتن موسی ته وویل:"}, {"ref": "None Leviticus 2:13", "text": "په دې کال کې به هغه ټول جایداد چې خرڅ شوی وي، خپل اصلي خاوند ته بېرته ورکړل شي."}, {"ref": "None Leviticus 2:13", "text": "زه ستاسو څښتن خدای یم چې تاسو مې د مصر څخه راوویستلئ، ترڅو نور د مصریانو غلامان ونه اوسئ. ما ستاسو د غلامۍ جغونه مات کړل او تاسو ته مې د دې توان درکړ چې په سرلوړۍ سره واوسېږئ.»"}, {"ref": "None Leviticus 2:13", "text": "که چېرې خاوند یې وغواړي چې هغه حیوان بېرته واخلي، باید د هغې د بیې څخه شل فیصده زیات ورکړي."}, {"ref": "None Leviticus 2:14", "text": "که چېرې یو سړی د یوې انجلۍ او د هغې د مور دواړو سره واده وکړي، نو درې واړه باید د خپل ډېر بد کار له امله وسوځول شي چې مړه شي، ترڅو ستاسو په منځ کې بدکاري نه وي."}, {"ref": "None Leviticus 2:14", "text": "هغه باید د یوې کونډې یا طلاق شوې یا د داسې ښځې سره واده ونه کړي چې هغه بدلمنه وي، خو یوازې د خپلې قبیلې څخه د یوې پېغلې سره دې واده وکړي."}, {"ref": "None Leviticus 2:14", "text": "که چېرې داسې خلک چې د کاهن د کورنۍ غړي نه وي په سهوې سره پاکې نذرانې وخوري، هغوی باید کاهن ته د اضافه شلو فیصدو سره پوره تاوان ورکړي."}, {"ref": "None Leviticus 2:14", "text": "ترڅو پورې چې تاسو خدای ته دا نذرانه راوړې نه وي، نو نوې غلې دانې هېڅ مه خورئ. که هغه خامې وي، نینې شوې وي، یا ډوډۍ ورڅخه پخه شوې وي هغه دې ونه خوړل شي. په دې قانون باندې دې د تل دپاره ستاسو د ټولو نسلونو له خوا عمل وشي."}, {"ref": "None Leviticus 2:14", "text": "«کفر ویونکی د کمپ څخه دباندې وباسه. هرچا چې د هغه ښکنځلې چې څښتن ته یې کړې دي اورېدلې وي، خپل لاسونه دې د هغه په سر باندې کېږدي او ټول قوم دې هغه سنګسار کړي."}, {"ref": "None Leviticus 2:14", "text": "که چېرې تاسو په خپل یو هېوادوال باندې ځمکه خرڅه کړئ یا یې ورڅخه واخلئ، د یو بل څخه ګټه مه اخلئ."}, {"ref": "None Leviticus 2:14", "text": "څښتن وویل: «خو که چېرې زما امرونو ته غاړه کېنږدئ، نو تاسو ته به سزا درکړل شي."}, {"ref": "None Leviticus 2:14", "text": "که چېرې یو کس خپل کور څښتن ته وقف کوي، کاهن به ورته د هغه د ښه والي یا بدوالي له مخې بیه وټاکي او هغه به اخرنۍ بیه وي."}, {"ref": "None Leviticus 2:15", "text": "که چېرې یو سړی د یو حیوان سره جنسي اړیکې ولري، هغه باید د حیوان سره یوځای ووژل شي."}, {"ref": "None Leviticus 2:15", "text": "که نه، نو د هغه اولادونه چې باید سپېڅلي وي، هغوی به ناپاک وي. زه څښتن یم او ما هغه د لوی کاهن په توګه غوره کړی دی.»"}, {"ref": "None Leviticus 2:15", "text": "د سبت د ورځې په سبا چې تاسو په کې څښتن ته د وړاندې کولو دپاره خپلې ګېډۍ راوړئ، پوره اووه هفتې وشمېرئ."}, {"ref": "None Leviticus 2:15", "text": "اسراییلیانو ته ووایه: که چېرې څوک خدای ته ښکنځلې وکړي، نو هغه به د خپلو بدو سزا وویني."}, {"ref": "None Leviticus 2:15", "text": "د ځمکې بیه دې د هغو کلونو د شمېر له مخې حساب شي چې د بېرته ورکولو د بل کاله پورې په کې دا ځمکه حاصل ورکولای شي."}, {"ref": "None Leviticus 2:15", "text": "که چېرې تاسو زما د قوانینو او حکمونو د منلو څخه انکار وکړئ او هغه لوظ مات کړئ چې تاسو سره مې کړی دی،"}, {"ref": "None Leviticus 2:15", "text": "که چېرې هغه کس چې خپل کور یې وقف کړی دی، وغواړي چې هغه بېرته واخلي، باید شل فیصده اضافه بیه ادا کړي او کور به بیا د هغه شي."}, {"ref": "None Leviticus 2:16", "text": "که چېرې یوه ښځه د یو حیوان سره د جنسي اړیکو د لرلو هڅه وکړي، هغه باید د حیوان سره یوځای ووژل شي. خون به یې په خپله غاړه وي."}, {"ref": "None Leviticus 2:16", "text": "څښتن موسی ته وویل:"}, {"ref": "None Leviticus 2:16", "text": "په پنځوسمه ورځ، یعنې هغه ورځ چې د اووم سبت څخه وروسته وي، د نوي حاصل څخه څښتن ته د غلې دانې بله نذرانه وړاندې کړئ."}, {"ref": "None Leviticus 2:16", "text": "هرڅوک چې د څښتن په نوم کفر ووایي، باید ووژل شي. ټول قوم باید هغه سنګسار کړي. که هغه یو پردی کس وي یا اسراییلی وي، کله چې هغه د خدای په نوم کفر ووایي، باید ووژل شي."}, {"ref": "None Leviticus 2:16", "text": "که چېرې کلونه ډېر وي، نو بیه به یې لوړه وي، خو که چېرې کلونه کم وي، نو بیه به یې ټیټه وي، ځکه چې څه چې خرڅیږي هغه به د فصلونو د شمېر له مخې وي."}, {"ref": "None Leviticus 2:16", "text": "نو زه به تاسو ته داسې سزا درکړم: په تاسو باندې به افت نازل کړم، داسې ناروغي چې د علاج وړ نه وي او تبې چې تاسو به ړانده کړي او ستاسو ژوند به خراب کړي. تاسو به خپل فصلونه وکرئ، خو هېڅ ګټه به درته ونه رسوي، ځکه چې څه چې تاسو کرئ ستاسو دښمنان به یې وخوري."}, {"ref": "None Leviticus 2:16", "text": "که چېرې یو کس څښتن ته د خپلې کورنۍ د ځمکې کومه برخه وقف کوي، د هغې بیه دې د هغه تخم د اندازې له مخې وټاکل شي چې په هغه ځمکه کې کرل کیږي، یعنې د دوه سوه کیلو ګرامو اوربشو تخم دپاره پنځوس د سپینو زرو سکې."}, {"ref": "None Leviticus 2:17", "text": "که چېرې یو سړی د خپلې سکه یا ناسکه خور سره واده وکړي، دا یوه رسوایي ده. هغوی باید په عام محضر کې د قوم څخه وشړل شي. هغه د خپلې خور سپکاوی کړی دی او مسوولیت به یې په خپله غاړه وي."}, {"ref": "None Leviticus 2:17", "text": "«هارون ته ووایه چې ستا د اولادې څخه هېڅ یو سړی چې جسماني عیبونه ولري، نه شي کولای چې ماته د خوړو نذرانه وړاندې کړي. دا خبره به تل ترتله عملي کیږي."}, {"ref": "None Leviticus 2:17", "text": "څښتن موسی ته وویل:"}, {"ref": "None Leviticus 2:17", "text": "هره کورنۍ دې دوه ډوډۍ راوړي چې ماته د وقف کولو دپاره پورته ونیول شي. هره یوه دې د دوو کیلو ګرامو ښو اوړو څخه پخه شوې وي او خمیره هم په کې وي. دا به څښتن ته د لومړنیو رېبل شویو غلو دانو د نذرانې په توګه وړاندې شي."}, {"ref": "None Leviticus 2:17", "text": "هرڅوک چې قتل وکړي، باید ووژل شي"}, {"ref": "None Leviticus 2:17", "text": "د یو بل څخه ګټه مه اخلئ خو زما څخه ووېرېږئ، ځکه چې زه ستاسو څښتن خدای یم."}, {"ref": "None Leviticus 2:17", "text": "زه به ستاسو په خلاف شم، ترڅو ستاسو دښمنان تاسو ته ماتې درکړي او هغوی چې ستاسو څخه کرکه کوي، په تاسو باندې به حکومت کوي. تاسو به دومره وېرېږئ چې بې له دې چې څوک مو تعقیب کړي، تاسو به تښتئ."}, {"ref": "None Leviticus 2:17", "text": "که چېرې هغه دا ځمکه د بېرته ورکولو د کال څخه وروسته سمدلاسه وقف کړي، نو ټوله بیه دې ادا کړي."}, {"ref": "None Leviticus 2:18", "text": "که چېرې یو سړی د یوې ښځې سره د میاشتینۍ ناروغۍ په دوران کې یوځای شي، هغوی دواړه دې د قوم څخه وشړل شي، ځکه چې هغوی د پاکوالي په اړه مقررات مات کړي دي."}, {"ref": "None Leviticus 2:18", "text": "هېڅ یو سړی چې جسماني عیبونه په کې وي، نه شي کولای چې هغه نذرانه وړاندې کړي لکه څوک چې ړوند وي، ګوډ وي، بدشکله یا بې ډوله وي،"}, {"ref": "None Leviticus 2:18", "text": "«هارون او د هغه د زامنو او ټولو اسراییلیانو سره خبرې وکړه او ورته ووایه: که چېرې ستاسو څخه یو کس که هغه یو اسراییلی یا یو داسې پردی کس وي چې په اسراییلو کې اوسیږي، ماته د سوځېدونکې نذرانې دپاره یو سوغات وړاندې کوي، که هغه د نذر د ورکولو په توګه وي یا د خپلې خوښې نذرانه وي،"}, {"ref": "None Leviticus 2:18", "text": "قوم دې د ډوډۍ سره اووه یو کلن وري، یو غویی او دوه پسونه وړاندې کړي، د دغو څخه دې په یو کې هم کوم عیب نه وي. دا به د غلې دانې او د څښلو د نذرانې سره څښتن ته یوه سوځېدونکې نذرانه وي، یوه داسې نذرانه چې بوی یې په څښتن باندې ښه لګیږي."}, {"ref": "None Leviticus 2:18", "text": "او هرڅوک چې د بل چا حیوان ووژني، باید تاوان یې ورکړي. قانون دا دی چې د ژوند په بدل کې ژوند واخیستل شي."}, {"ref": "None Leviticus 2:18", "text": "د څښتن د ټولو فرمانونو او قوانینو څخه پیروي وکړئ، ترڅو په دې خاوره کې په امن سره ژوند وکړئ."}, {"ref": "None Leviticus 2:18", "text": "که چېرې د دغو ټولو شیانو څخه وروسته بیاهم ماته غوږ ونه نیسئ، زه به تاسو ته ستاسو د ګناهونو په خاطر اووه چنده زیاته سزا درکړم."}, {"ref": "None Leviticus 2:18", "text": "خو که چېرې هغه کس خپله ځمکه له دې څخه وروسته وقف کړي، کاهن به د هغې بیه د هغو کلونو د شمېر له مخې حساب کړي چې د بېرته ورکولو تر راتلونکي کال پورې پاتې وي او کمه بیه به وټاکي."}, {"ref": "None Leviticus 2:19", "text": "د خپلې مور د خور یا د خپل پلار د خور سره زنا مه کوئ، ځکه چې دا کار به د یو نژدې خپلوان سپکاوی وي، د دغه بد کار مسوولیت به ستاسو دواړو په غاړه وي."}, {"ref": "None Leviticus 2:19", "text": "د چا لاس یا پښه چې معیوبه وي،"}, {"ref": "None Leviticus 2:19", "text": "تاسو باید د پادې یا رمې څخه یو نر حیوان وړاندې کړئ چې کوم عیب په کې نه وي، د دې دپاره چې هغه ستاسو په خاطر قبول شي."}, {"ref": "None Leviticus 2:19", "text": "بیا د ګناه د نذرانې دپاره یو سېرلی او د سلامتۍ د نذرانې دپاره دوه یو کلن وري قرباني کړئ."}, {"ref": "None Leviticus 2:19", "text": "که چېرې یو څوک یو بل کس ټپي کړي، هرڅه چې هغه کړي وي، هماغه شان عمل به ورسره کیږي."}, {"ref": "None Leviticus 2:19", "text": "ځمکه به خپل حاصلات ورکړي او تاسو چې هرڅه غواړئ د خوړلو دپاره به یې ولرئ او په امن کې به ژوند کوئ."}, {"ref": "None Leviticus 2:19", "text": "زه به ستاسو سخت غرور مات کړم. هېڅ باران به نه وي او ستاسو ځمکه به وچه شي او د اوسپنې په شان به کلکه شي."}, {"ref": "None Leviticus 2:19", "text": "که چېرې هغه کس چې ځمکه یې وقف کړې ده وغواړي چې هغه بېرته واخلي، باید د اضافه شلو فیصدو سره بیه ادا کړي او ځمکه به بېرته د هغه شي."}, {"ref": "None Leviticus 2:20", "text": "که چېرې یو سړی د خپل تره د ښځې سره زنا کوي هغه خپل تره سپکوي. مسوولیت به د هغوی په غاړه وي، هغوی به بې اولاده پاتې شي."}, {"ref": "None Leviticus 2:20", "text": "څوک په ملا باندې کړوپ وي یا ټیټ قدی وي، څوک چې د سترګې یا د پوستکي په ناروغۍ اخته وي او څوک چې خصي وي."}, {"ref": "None Leviticus 2:20", "text": "که چېرې تاسو یو داسې حیوان وړاندې کړئ چې کوم عیب په کې وي، زه څښتن به هغه قبول نه کړم."}, {"ref": "None Leviticus 2:20", "text": "کاهن دې هغه ډوډۍ چې د لومړنیو رېبل شویو غلو دانو نښه ده، د دوه وریو سره څښتن ته د وقف کېدلو په خاطر پورته ونیسي. دا څښتن ته یوه سپېڅلې نذرانه ده چې باید کاهنانو ته ورکړل شي."}, {"ref": "None Leviticus 2:20", "text": "که چېرې تاسو د چا یو هډوکی مات کړئ، ستاسو یو هډوکی به مات شي. که چېرې تاسو د چا یوه سترګه وباسئ، ستاسو یوه سترګه به وویستل شي. که چېرې تاسو د چا یو غاښ مات کړئ، ستاسو یو غاښ به مات شي. څنګه چې تاسو یو بل کس ټپي کړئ، تاسو سره به په بدل کې هماغه شان کار کیږي."}, {"ref": "None Leviticus 2:20", "text": "خو کېدای شي چې تاسو پوښتنه وکړئ: که چېرې مونږ څه شی ونه کرو او حاصل راټول نه کړو، نو په اووم کال به څه شی وخورو؟"}, {"ref": "None Leviticus 2:20", "text": "ستاسو ټول زیار او زحمت به تاسو ته هېڅ ګټه ونه رسوي، ځکه چې ستاسو ځمکه به فصلونه نه کوي او ونې به مېوه ونه نیسي."}, {"ref": "None Leviticus 2:20", "text": "که چېرې هغه ځمکه په بل چا باندې خرڅوي، نو هغه دې لومړی بېرته په بیه واخلي، پرته له دې د بېرته اخیستلو حق د تل دپاره له لاسه ورکوي."}, {"ref": "None Leviticus 2:21", "text": "که چېرې یو سړی د خپلې ورېندار سره واده وکړي، هغوی به بې اولاده وي. هغه یو ناپاکه کار کړی او د خپل ورور سپکاوی یې کړی دی.»"}, {"ref": "None Leviticus 2:21", "text": "د هارون کاهن د اولادې څخه هېڅ یو سړی چې کوم جسماني عیبونه په کې وي، نه شي کولای چې ماته د خوړو یوه داسې نذرانه وړاندې کړي چې په اور باندې تیاریږي."}, {"ref": "None Leviticus 2:21", "text": "کله چې یو کس څښتن ته د رمې او یا پادې څخه د سلامتۍ نذرانه راوړي چې یو نذر ورکړي یا د خپلې خوښې نذرانې په توګه وي، د دې دپاره چې د منلو وړ وي، نو په هغې کې باید هېڅ عیب نه وي."}, {"ref": "None Leviticus 2:21", "text": "تاسو باید په هماغه ورځ د عبادت دپاره سره راټول شئ او هېڅ ورځنی کار ونه کړئ. هر چېرته چې ستاسو اولاده اوسیږي، دا مقررات دې تل ترتله مراعت کړي."}, {"ref": "None Leviticus 2:21", "text": "هرڅوک چې یو حیوان ووژني تاوان به یې ورکوي، خو څوک چې یو انسان ووژني، هغه به ووژل شي."}, {"ref": "None Leviticus 2:21", "text": "زه به په شپږم کال تاسو ته داسې برکت درکړم چې ځمکه به د درېو کلونو دپاره پوره حاصل ورکړي."}, {"ref": "None Leviticus 2:21", "text": "که چېرې تاسو زما په خلاف اوسئ او ماته غوږ ونه نیسئ، زه به بیا ستاسو سزا اووه چنده زیاته کړم."}, {"ref": "None Leviticus 2:21", "text": "د بېرته ورکولو په راتلونکي کال کې به دا ځمکه سپېڅلې او د څښتن تلپاتې ملکیت شي. هغه به د کاهنانو شي."}, {"ref": "None Leviticus 2:22", "text": "څښتن وویل: «زما د ټولو فرمانونو او قوانینو څخه پیروي وکړئ، ترڅو تاسو د کنعان د ځمکې څخه چې هلته مو راولم، ونه شړم."}, {"ref": "None Leviticus 2:22", "text": "داسې سړی کولای شي چې هغه خواړه وخوري چې ماته وړاندې شوي وي، یعنې د خوړو سپېڅلې نذرانه او د خوړو ډېره سپېڅلې نذرانه."}, {"ref": "None Leviticus 2:22", "text": "څښتن ته داسې حیوان مه وړاندې کوئ چې ړوند، ګوډ یا معیوب وي، زخم ولري او یا د پوستکي په دوامداره ناروغۍ اخته وي. هغه د قربانۍ په ځای باندې د یوې داسې نذرانې په توګه مه ږدئ چې په اور باندې څښتن ته تیاریږي."}, {"ref": "None Leviticus 2:22", "text": "کله چې تاسو د خپلو ځمکو حاصلات لو کوئ، نو هغه د پټیو تر غاړو پورې مه لو کوئ او هغه وږي چې د لو څخه پاتې شوي وي، هغه مه راټولوئ. هغه غریبانو او پردیو خلکو ته پرېږدئ. زه ستاسو څښتن خدای یم.»"}, {"ref": "None Leviticus 2:22", "text": "دا قانون په تاسو ټولو باندې عملي کیږي، یعنې په اسراییلیانو او په هغو پردیو خلکو باندې چې ستاسو په منځ کې اوسیږي، ځکه چې زه ستاسو څښتن خدای یم.»"}, {"ref": "None Leviticus 2:22", "text": "کله چې تاسو د اتم کال په دوران کې خپلې ځمکې وکرئ، د هغو حاصلاتو څخه به خواړه خورئ چې د شپږم کال په دوران کې راټول شوي وو او په نهم کال کې به هغه خواړه وخورئ چې تاسو په اتم کال کې کرلي دي."}, {"ref": "None Leviticus 2:22", "text": "زه به ستاسو منځ ته وحشي حیوانات درولېږم او هغوی به ستاسو اولادونه ووژني، ستاسو حیوانات به له منځه یوسي او ستاسو شمېر به دومره کم کړي چې لارې به مو خوشې پاتې شي."}, {"ref": "None Leviticus 2:22", "text": "که چېرې یو کس څښتن ته داسې یو پټی وقف کړي چې اخیستی یې وي او د هغه د کورنۍ د ځمکې برخه نه وي،"}, {"ref": "None Leviticus 2:23", "text": "د هغو خلکو د رواجونو څخه پیروي مه کوئ چې هلته اوسیږي او زه یې د دې په خاطر شړم، ترڅو تاسو وکولای شئ هغې خاورې ته ورننوځئ. زه د هغوی څخه د هغوی د ټولو بدو عملونو له امله کرکه کوم."}, {"ref": "None Leviticus 2:23", "text": "خو په دې خاطر چې په هغه کې جسماني عیب دی، هغه دې سپېڅلې پردې او د قربانۍ ځای ته نژدې رانه شي او زما سپېڅلی ځای او هرڅه چې په کې دي هغه دې نه ناپاکه کوي، ځکه چې زه څښتن یم او کاهنان سپېڅلي کوم.»"}, {"ref": "None Leviticus 2:23", "text": "که څه هم تاسو کولای شئ چې د خپلې خوښې نذرانې په توګه یو حیوان چې بې ډوله یا کوچنی وي وړاندې کړئ، خو هغه به د نذر په توګه قبول نه شي."}, {"ref": "None Leviticus 2:23", "text": "څښتن موسی ته وویل:"}, {"ref": "None Leviticus 2:23", "text": "کله چې موسی د اسراییلو قوم ته دا خبرې وکړې، هغوی دا سړی د کمپ څخه دباندې وویست او سنګسار یې کړ. په دې ډول د اسراییلو قوم هغه څه وکړل چې څښتن یې موسی ته امر کړی ؤ."}, {"ref": "None Leviticus 2:23", "text": "تاسو باید خپله ځمکه د تل دپاره خرڅه نه کړئ، ځکه چې دا ستاسو نه ده. هغه ځمکه زما ده او تاسو په کې د هغو پردیو خلکو په شان یئ چې کولای شي د هغې څخه یوازې ګټه واخلي."}, {"ref": "None Leviticus 2:23", "text": "که چېرې د دغو ټولو سزاګانو سره سره زما خبرو ته غوږ ونه نیسئ او زما په خلاف پاتې شئ،"}, {"ref": "None Leviticus 2:23", "text": "کاهن به د هغه بیه د هغو کلونو د شمېر له مخې حساب کړي چې د بېرته ورکولو تر راتلونکي کال پورې پاتې وي او هغه کس باید په هماغه ورځ بیه ادا کړي. پیسې د څښتن کیږي."}, {"ref": "None Leviticus 2:24", "text": "خو تاسو سره مې د دې غني او حاصلخېزې ځمکې وعده کړې ده، ترڅو هغه ستاسو ملکیت شي او هغه به تاسو ته درکوم. زه ستاسو څښتن خدای یم او تاسو مې د نورو قومونو څخه بېل کړي یئ."}, {"ref": "None Leviticus 2:24", "text": "نو موسی دا هرڅه هارون او د هغه زامنو او ټولو اسراییلیانو ته وویل."}, {"ref": "None Leviticus 2:24", "text": "څښتن ته هېڅ داسې حیوان مه وړاندې کوئ چې خصیه یې ټکول شوې، پرېکړل شوې، زخمي شوې یا ویستل شوې وي. تاسو باید په خپله خاوره کې داسې کار ونه کړئ."}, {"ref": "None Leviticus 2:24", "text": "«د اسراییلو قوم ته ووایه چې د هر کال د اوومې میاشتې لومړۍ ورځ د ارام کولو ځانګړې ورځ ده او د اسراییلو ټول خلک دې د سرني د اواز په اورېدلو سره د عبادت دپاره سره راټول شي."}, {"ref": "None Leviticus 2:24", "text": "کله چې ځمکه خرڅیږي، د هغې اصلي خاوند حق لري چې هغه بېرته په بیه واخلي."}, {"ref": "None Leviticus 2:24", "text": "زه به په خپله ستاسو په خلاف شم او تاسو ته به له مخکې څخه اووه چنده سخته سزا درکړم."}, {"ref": "None Leviticus 2:24", "text": "دا پټی به د بېرته ورکولو په کال کې د هغه اصلي خاوند یا د هغه اولادې ته بېرته ورکړای شي."}, {"ref": "None Leviticus 2:25", "text": "له دې امله تاسو باید د پاکو او ناپاکو حیواناتو او مرغانو ترمنځ ښکاره فرق وکړئ. هغه حیوانات یا مرغان چې هغه مې ناپاک اعلان کړي دي، مه خورئ. د هغو په خوړلو به ناپاک شئ."}, {"ref": "None Leviticus 2:25", "text": "تاسو باید د پردیو خلکو څخه داسې حیوانات وانخلئ چې د خوړو د نذرانو په توګه یې وړاندې کړئ. هغه به ستاسو دپاره قبول نه شي، ځکه چې هغه بې ډوله دي یا عیبونه په کې دي.»"}, {"ref": "None Leviticus 2:25", "text": "په هماغه ورځ خپل عادي کار مه کوئ، خو څښتن ته یوه داسې نذرانه وړاندې کړئ چې په اور باندې تیاریږي.»"}, {"ref": "None Leviticus 2:25", "text": "که چېرې ستاسو اسراییلیانو څخه یو کس غریب شي او مجبور شي چې د خپلې ځمکې څخه یو څه ځمکه خرڅه کړي، د هغه ډېر نژدې خپلوان باید هغه بېرته واخلي."}, {"ref": "None Leviticus 2:25", "text": "زه به په تاسو باندې جنګ راولم د دې په خاطر چې تاسو ته د خپل لوظ د ماتولو دپاره سزا درکړم او که چېرې تاسو د خوندي پاتې کېدلو دپاره په خپلو ښارونو کې راټول شئ، زه به په تاسو باندې ناعلاجه ناروغۍ نازلې کړم او تاسو به مجبور شئ چې خپلو دښمنانو ته تسلیم شئ."}, {"ref": "None Leviticus 2:25", "text": "ټولې بیې باید د سپېڅلي ځای د اندازې له مخې وټاکل شي."}, {"ref": "None Leviticus 2:26", "text": "تاسو به پاک او سپېڅلي شئ، ځکه چې زه څښتن سپېڅلی یم. ما تاسو د نورو قومونو څخه بېل کړي یئ، ترڅو یوازې زما شئ."}, {"ref": "None Leviticus 2:26", "text": "څښتن موسی ته وویل:"}, {"ref": "None Leviticus 2:26", "text": "څښتن موسی ته وویل:"}, {"ref": "None Leviticus 2:26", "text": "که چېرې یو کس یو خپلوان هم ونه لري چې هغه بېرته واخلي، کېدای شي چې هغه وروسته شتمن شي او پوره پیسې ولري چې هغه بېرته واخلي."}, {"ref": "None Leviticus 2:26", "text": "زه به په تاسو باندې خواړه بند کړم چې لس ښځې به په یو تنور ډوډۍ پخوي. ستاسو جیره به دومره کمه کړم چې کله تاسو هغه ټوله وخورئ، بیا به هم ماړه نه شئ."}, {"ref": "None Leviticus 2:26", "text": "لومړنی زېږېدلی حیوان له پخوا څخه د څښتن دی، نو هېڅوک نه شي کولای چې هغه څښتن ته وقف کړي. که هغه یو خوسی وي، یو وری یا سېرلی وي، که هغه نر وي یا ښځه، هغه د څښتن دی."}, {"ref": "None Leviticus 2:27", "text": "هر سړی یا هره ښځه چې دا دعوه کوي چې د مړو سره مشورې کوي، باید ووژل شي. تاسو باید هغه سنګسار کړئ، خون به یې په خپله غاړه وي.»"}, {"ref": "None Leviticus 2:27", "text": "«کله چې یو خوسی، یو وری یا یوه وزه پیدا شي، د خپلې مور سره دې اووه ورځې پاتې شي. له اتمې ورځې څخه به هغه د یوې داسې نذرانې په توګه د منلو وړ وي چې څښتن ته په اور باندې تیاریږي."}, {"ref": "None Leviticus 2:27", "text": "«هر کال د اوومې میاشتې لسمه ورځ د کفارې ورځ ده. په هغه ورځ د عبادت دپاره سره راټول شئ او روژه ونیسئ. یوه داسې نذرانه وړاندې کړئ چې څښتن ته په اور باندې تیاریږي."}, {"ref": "None Leviticus 2:27", "text": "نو په داسې حالت کې هغه باید د حاصلاتو بیه د هغو کلونو دپاره معلومه کړي چې د بېرته ورکولو تر راتلونکي کاله پورې پاتې وي او د هغو پیسې دې هغه کس ته ورکړي چې ورباندې چې هغه خرڅه شوې وي. بیا هغه کولای شي چې بېرته خپله ځمکه واخلي."}, {"ref": "None Leviticus 2:27", "text": "که چېرې له دې سره سره بیاهم تاسو ماته غوږ ونه نیسئ او زما په خلاف پاتې شئ،"}, {"ref": "None Leviticus 2:27", "text": "که چېرې هغه یو ناپاک حیوان وي، کېدای شي چې په اصلي بیه د اضافه شلو فیصدو سره بېرته واخیستل شي. که چېرې هغه بېرته وانخیستل شي، کېدای شي چې په بل چا باندې په اصلي بیه خرڅ شي."}, {"ref": "None Leviticus 2:28", "text": "یوه غوا او د هغې خوسی یا یوه مېږه او د هغې وری یا یوه وزه او د هغې بچی په یوه ورځ مه حلالوئ."}, {"ref": "None Leviticus 2:28", "text": "په هغه ورځ هېڅ کار مه کوئ، ځکه چې دا د کفارې ورځ ده چې ستاسو دپاره ستاسو د څښتن خدای په حضور کې کفاره ادا کیږي."}, {"ref": "None Leviticus 2:28", "text": "خو که چېرې اصلي خاوند نه شي کولای چې هغه ځمکه بېرته په بیه واخلي، نو هغه به د بېرته ورکولو د راتلونکي کال پورې د نوي خاوند وي. د بېرته ورکولو په کال به هغه بېرته خپل اصلي خاوند ته ورکړل شي."}, {"ref": "None Leviticus 2:28", "text": "بیا به زه په تاسو باندې خپل غضب نازل کړم او ستاسو سزا به له پخوا څخه اووه چنده زیاته کړم."}, {"ref": "None Leviticus 2:28", "text": "هېڅوک نه شي کولای چې داسې څه خرڅ کړي یا یې بېرته واخلي چې پرته له کوم شرط څخه یې څښتن ته وقف کړی وي، که هغه یو انسان وي، یو حیوان، یا د کورنۍ ځمکه وي. هغه په تلپاتې توګه د څښتن دي."}, {"ref": "None Leviticus 2:29", "text": "کله چې تاسو څښتن ته د شکرانې یوه نذرانه قرباني کوئ، نو د مقرراتو څخه پیروي وکړئ، ترڅو هغه ستاسو په خاطر قبوله شي."}, {"ref": "None Leviticus 2:29", "text": "هرڅوک چې په هغه ورځ روژه ونه نیسي باید د خدای د قوم څخه وشړل شي."}, {"ref": "None Leviticus 2:29", "text": "که چېرې یو کس په دېوال لرونکي ښار کې یو کور خرڅ کړي، دا حق لري چې د لومړي کال په ټول دوران کې د خرڅېدلو د نېټې څخه را په دې خوا هغه بېرته واخلي."}, {"ref": "None Leviticus 2:29", "text": "ستاسو لوږه به دومره زیاته شي چې خپل اولادونه به وخورئ."}, {"ref": "None Leviticus 2:29", "text": "څوک چې په مرګ محکوم شوی وي، هغه نه شي کولای چې خپل ژوند بېرته په بیه واخلي، هغه باید ووژل شي."}, {"ref": "None Leviticus 2:30", "text": "هغه باید په هماغه ورځ وخوړل شي، د هغې څخه تر سهاره پورې هېڅ شی مه پرېږدئ. زه څښتن یم."}, {"ref": "None Leviticus 2:30", "text": "که چېرې څوک په هغه ورځ کوم کار وکړي، زه به په خپله هغه ووژنم."}, {"ref": "None Leviticus 2:30", "text": "خو که چېرې هغه په دې کال کې بېرته وانخلي، د هغه د بېرته اخیستلو حق له لاسه ورکوي او هغه کور د اخیستونکي او د هغه د اولادې تلپاتې ملکیت کیږي. هغه به د بېرته ورکولو په کال کې بېرته ورنه کړای شي."}, {"ref": "None Leviticus 2:30", "text": "زه به ستاسو سیمه ییز عبادت ځایونه او د خوشبویۍ د سوځولو ځایونه له منځه یوسم. مړي به مو ستاسو په بې ساه بتانو باندې وغورځوم. زه به ستاسو څخه کرکه وکړم."}, {"ref": "None Leviticus 2:30", "text": "د ځمکې د ټولو حاصلاتو لسمه برخه که هغه غلې دانې وي یا مېوه، هغه د څښتن ده."}, {"ref": "None Leviticus 2:31", "text": "زما د حکمونو څخه پیروي وکړئ. زه څښتن یم."}, {"ref": "None Leviticus 2:31", "text": "دا قانون ستاسو په ټوله اولاده باندې هر چېرته چې اوسیږي، عملي کیږي."}, {"ref": "None Leviticus 2:31", "text": "خو کوم کورونه چې په بې دېواله کلیو کې دي، په هغو باندې دې د پټیو په شان کار وشي. اصلي خاوند حق لري چې هغه بېرته واخلي او هغه دې د بېرته ورکولو په کال کې بېرته ورکړای شي."}, {"ref": "None Leviticus 2:31", "text": "ستاسو ښارونه به په کنډوالو بدل کړم، ستاسو عبادت ځایونه به له منځه یوسم او ستاسو قربانۍ به قبولې نه کړم."}, {"ref": "None Leviticus 2:31", "text": "که چېرې یو کس وغواړي چې د هغې څخه لږ بېرته واخلي، هغه باید د اضافه شلو فیصدو سره اصلي بیه ادا کړي."}, {"ref": "None Leviticus 2:32", "text": "زما سپېڅلی نوم مه سپکوئ. د اسراییلو ټول قوم باید د دې خبرې اقرار وکړي چې زه سپېڅلی یم. زه څښتن یم چې تاسو سپېڅلي کوم"}, {"ref": "None Leviticus 2:32", "text": "د هغې میاشتې په نهمه ورځ د لمرپرېواته څخه نیولې د میاشتې د لسمې ورځې تر لمرپرېواته پورې دا ورځ د ارام کولو د یوې ځانګړې ورځې په توګه ولمانځئ او په دې دوران کې باید تاسو روژه ونیسئ.»"}, {"ref": "None Leviticus 2:32", "text": "لاویان دا حق لري چې خپل جایداد په هغو ښارونو کې چې هغوی ته ورکړل شوي دي، په هر وخت کې بېرته په بیه واخلي."}, {"ref": "None Leviticus 2:32", "text": "زه به ستاسو وطن داسې وران کړم چې کله ستاسو دښمنان هغه ونیسي، نو دې ورانۍ ته به هک حیران پاتې شي."}, {"ref": "None Leviticus 2:32", "text": "کله چې څوک خپلې پادې او رمې شمېري، د هغو څخه هر لسم حیوان د څښتن دی."}, {"ref": "None Leviticus 2:33", "text": "او تاسو مې د دې دپاره له مصر څخه راوویستلئ چې ستاسو خدای اوسم. زه څښتن یم.»"}, {"ref": "None Leviticus 2:33", "text": "څښتن موسی ته وویل:"}, {"ref": "None Leviticus 2:33", "text": "که چېرې یو لاوي د دغو ښارونو څخه په یو ښار کې یو کور خرڅ کړي او بېرته یې وانخلي، هغه باید د بېرته ورکولو په کال کې بېرته ورکړای شي، ځکه چې د اسراییلو د قوم په منځ کې چې لاویان په خپلو ښارونو کې کوم کورونه لري، هغه د هغوی تلپاتې ملکیت دی."}, {"ref": "None Leviticus 2:33", "text": "زه به په تاسو باندې جنګ راولم او تاسو به په پردیو هېوادونو کې خپاره کړم. ستاسو ځمکه به خوشې پاتې شي او ښارونه به مو په کنډوالو بدل شي."}, {"ref": "None Leviticus 2:33", "text": "هغه کس نه شي کولای چې خپل حیوانات داسې ترتیب کړي چې خراب حیوانات ورڅخه غوره کړي او نه شي کولای چې هغه بدل کړي. که چېرې هغه یو حیوان د بل سره بدل کړي، بیا دواړه حیوانات د څښتن کیږي او بېرته په بیه نه شي اخیستل کېدای.»"}, {"ref": "None Leviticus 2:34", "text": "«اسراییلیانو ته ووایه چې د اوومې میاشتې په پنځلسمه ورځ څښتن ته د درناوۍ دپاره د جونګړو اختر پیل کیږي. هغه اووه ورځې دوام کوي."}, {"ref": "None Leviticus 2:34", "text": "خو هغه څړځایونه چې د لاویانو د ښارونو په شاوخوا کې دي، هغه به هېڅکله خرڅ نه شي. دا د تل دپاره د هغوی ملکیت دی."}, {"ref": "None Leviticus 2:34", "text": "دا هغه امرونه دي چې څښتن موسی ته د سینا په غره باندې د اسراییلیانو دپاره ورکړل."}, {"ref": "None Leviticus 2:35", "text": "په دغو ورځو کې لومړۍ ورځ د عبادت دپاره سره راټول شئ او خپل ورځنی کار مه کوئ."}, {"ref": "None Leviticus 2:35", "text": "که چېرې یو اسراییلی چې تاسو سره نژدې اوسیږي غریب شي او خپل ځان ونه شي ساتلی، تاسو باید د هغه سره داسې مرسته وکړئ لکه څنګه یې چې د یو پردي یا موقتي اوسېدونکي سره کوئ، ترڅو هغه وکولای شي چې ستاسو په خوا کې واوسیږي."}, {"ref": "None Leviticus 2:36", "text": "اووه ورځې څښتن ته داسې نذرانې وړاندې کړئ چې په اور باندې تیاریږي او په اتمه ورځ بیا د عبادت دپاره سره راټول شئ او د پخوا په شان نذرانه وړاندې کړئ. دا د عبادت ورځ ده او تاسو به خپل عادي کار نه کوئ."}, {"ref": "None Leviticus 2:36", "text": "د یو اسراییلي څخه هېڅ سود مه اخلئ، خو د خپل خدای څخه ووېرېږئ، ترڅو ستاسو هېوادوال وکولای شي چې ستاسو په خوا کې واوسیږي."}, {"ref": "None Leviticus 2:36", "text": "ستاسو هغه خلک چې په جلاوطنۍ کې دي، د هغوی په زړونو کې به داسې وېره واچوم چې د هغې پاڼې له اواز څخه به هم تښتي چې باد یې رپوي. هغوی به داسې منډې وهي لکه څوک چې یې په جګړه کې تعقیبوي. د هغوی په څنګ کې به هېڅ دښمن نه وي، خو هغوی به غورځیږي."}, {"ref": "None Leviticus 2:37", "text": "دا هغه اخترونه دي چې د څښتن له خوا ټاکل شوي دي. هغه داسې ولمانځئ چې سره راټول شئ او هغه ډول ډول نذرانې چې په اور باندې څښتن ته تیاریږي یعنې سوځېدونکې نذرانې، د غلو دانو نذرانې، قربانۍ او د څښلو نذرانې، دا هره یوه دې په خپله مناسبه ورځ هغه ته وړاندې شي."}, {"ref": "None Leviticus 2:37", "text": "په هغو پیسو باندې چې تاسو یې ورته په پور ورکوئ د هغوی څخه سود مه اخلئ او په هغو خوړو باندې چې تاسو یې ورباندې خرڅوئ، ګټه مه اخلئ."}, {"ref": "None Leviticus 2:37", "text": "هېڅ څوک به هغوی نه تعقیبوي، خو هغوی به د یو بل دپاسه غورځیږي او دا توان به نه لري چې د خپلو دښمنانو په وړاندې ودریږي."}, {"ref": "None Leviticus 2:38", "text": "دا اخترونه د سبت د ورځو څخه بېل دي او دا نذرانې د عادي سوغاتونو څخه بېلې دي، یعنې ستاسو د هغو نذرانو څخه چې د نذرونو دپاره دي او د هغو د خپلې خوښې نذرانو څخه چې څښتن ته یې ورکوئ."}, {"ref": "None Leviticus 2:38", "text": "زه ستاسو څښتن خدای یم چې تاسو مې د مصر څخه راوویستلئ، ترڅو د کنعان ځمکه درکړم او ستاسو خدای اوسم."}, {"ref": "None Leviticus 2:38", "text": "هغوی به په پردي وطن کې مړه شي او د خپلو دښمنانو خاوره به یې ژوندي تېر کړي."}, {"ref": "None Leviticus 2:39", "text": "نو کله چې تاسو خپل پټي ورېبل، اووه ورځې دا اختر چې د اوومې میاشتې په پنځلسمه ورځ پیل کیږي، ولمانځئ. لومړۍ ورځ به د ارام کولو ورځ وي او اتمه ورځ به هم د ارام کولو ورځ وي."}, {"ref": "None Leviticus 2:39", "text": "که چېرې یو اسراییلی چې تاسو سره نژدې اوسیږي دومره غریب شي چې خپل ځان په تاسو باندې د غلام په توګه خرڅ کړي، تاسو به په هغه باندې د غلامانو کار نه کوئ."}, {"ref": "None Leviticus 2:39", "text": "د هغوی څخه چې څوک د خپلو دښمنانو په خاوره کې ژوندي پاتې شي، د هغوی ژوند به ستاسو او ستاسو د نیکونو د ګناه له امله برباد شي."}, {"ref": "None Leviticus 2:40", "text": "په لومړۍ ورځ تاسو د خپلو ونو څخه ډېره ښه مېوه، د خرما د ونې څانګې، پاڼې لرونکې څانګې او د سیند د غاړو څخه ولې واخلئ او اووه ورځې د خپل څښتن خدای په حضور کې خوشحالي وکړئ."}, {"ref": "None Leviticus 2:40", "text": "د هغه سره دې د مزدور یا هغه موقتي اوسېدونکي په شان چلند وشي چې ستاسو په منځ کې اوسیږي. هغه اسراییلی دې د بېرته ورکولو تر بل کاله پورې ستاسو خدمت وکړي."}, {"ref": "None Leviticus 2:40", "text": "خو ستاسو اولاده به د خپلو ګناهونو او خپلو نیکونو د ګناهونو اقرار کوي چې زما سره یې بې وفایي او دښمني وکړه"}, {"ref": "None Leviticus 2:41", "text": "دا هر کال اووه ورځې څښتن ته د درناوي دپاره د یو اختر په توګه ولمانځئ. ستاسو راتلونکې اولاده دې تل ترتله د دې قانون څخه پیروي وکړي. هغه په اوومه میاشت ولمانځئ."}, {"ref": "None Leviticus 2:41", "text": "په هغه وخت کې به هغه او د هغه اولادونه ستاسو څخه لاړ شي او خپلې کورنۍ او د خپلو نیکونو ملکیت ته به ورستانه شي."}, {"ref": "None Leviticus 2:41", "text": "او زه یې د خپل ځان په خلاف کړم، ترڅو هغوی د خپلو دښمنانو خاورې ته وشړم. په اخر کې کله چې ستاسو د اولادې سخت زړونه نرم شي او د خپلې ګناه دپاره سزا ومومي،"}, {"ref": "None Leviticus 2:42", "text": "د اسراییلو ټول خلک باید اووه ورځې په جونګړو کې واوسیږي،"}, {"ref": "None Leviticus 2:42", "text": "اسراییلیان زما غلامان دي چې ما د مصر څخه راوویستل. په دې خاطر باید هغوی د غلامانو په توګه خرڅ نه شي."}, {"ref": "None Leviticus 2:42", "text": "زه به د یعقوب، اسحاق او ابراهیم سره خپل لوظ او خپل قوم ته د ځمکې د ورکولو وعده رایاده کړم."}, {"ref": "None Leviticus 2:43", "text": "ترڅو ستاسو اولاده په دې پوه شي کله چې ما د اسراییلو قوم د مصر څخه راوویست، هغوی مې دې ته مجبور کړل چې په ساده جونګړو کې واوسیږي. زه ستاسو څښتن خدای یم.»"}, {"ref": "None Leviticus 2:43", "text": "د خپل خدای څخه ووېرېږئ او د هغوی سره سخت چلند مه کوئ."}, {"ref": "None Leviticus 2:43", "text": "لومړی باید د دې وطن خلک دا ځمکه پرېږدي، ترڅو د شاړې پاتې کېدلو څخه ګټه واخلي او هغوی باید زما د قوانینو او فرمانونو د ردولو په سبب د خپلو ګناهونو پوره بیه ادا کړي."}, {"ref": "None Leviticus 2:44", "text": "نو په دې ډول موسی د اسراییلو خلکو ته لارښوونه وکړه چې د څښتن اخترونه ولمانځي."}, {"ref": "None Leviticus 2:44", "text": "که چېرې تاسو غلامانو ته اړتیا لرئ، کولای شئ چې د خپل شاوخوا قومونو څخه یې په بیه واخلئ."}, {"ref": "None Leviticus 2:44", "text": "بیاهم، کله چې هغوی د خپلو دښمنانو په خاوره کې وي، زه به یې بیخي له منځه نه وړم. هغوی به نه پرېږدم او خپل لوظ به ورسره مات نه کړم، ځکه چې زه د هغوی څښتن خدای یم."}, {"ref": "None Leviticus 2:45", "text": "همدارنګه تاسو کولای شئ چې ځینې پردي خلک چې ستاسو په منځ کې اوسیږي او د هغوی اولادونه چې ستاسو په خاوره کې پیدا شوي دي هم په بیه واخلئ. هغوی به ستاسو ملکیت شي."}, {"ref": "None Leviticus 2:45", "text": "خو زه به د هغوی په خاطر هغه لوظ رایاد کړم چې د هغوی د نیکونو سره مې هغه وخت کړی ؤ چې هغوی مې د مصر څخه راوویستل، د دې دپاره چې زه به د هغوی خدای اوسم او په دې ډول مې نورو قومونو ته خپل قدرت وروښود.»"}, {"ref": "None Leviticus 2:46", "text": "وروسته تاسو هغوی خپلو اولادونو ته د میراث په توګه پرېښودلی شئ او د ټول عمر دپاره ورڅخه غلامان جوړولی شئ. خو د خپلو اسراییلیانو سره باید سخت چلند ونه کړئ."}, {"ref": "None Leviticus 2:46", "text": "دا هغه فرمانونه، قوانین او مقررات دي چې څښتن د سینا په غره باندې د اسراییلیانو دپاره موسی ته ورکړل."}, {"ref": "None Leviticus 2:47", "text": "فرض کړئ یو پردی یا یو داسې موقتي اوسېدونکی چې ستاسو په منځ کې اوسیږي شتمن شي، خو کوم اسراییلی غریب شي او خپل ځان په هغه پردی کس یا د هغه کس د کورنۍ په غړي باندې د غلام په توګه خرڅ کړي."}, {"ref": "None Leviticus 2:48", "text": "هغه د خرڅېدلو څخه وروسته بیاهم حق لري چې بېرته په بیه واخیستل شي. یو ورور،"}, {"ref": "None Leviticus 2:49", "text": "یا یو تره یا یو د تره زوی یا یو بل نژدې خپلوان یې بېرته اخیستلی شي. که چېرې هغه په خپله پوره پیسې لاسته راوړي، خپله ازادي په خپله اخیستلی شي."}, {"ref": "None Leviticus 2:50", "text": "هغه باید د هغه چا سره چې دی یې اخیستی دی مشوره وکړي او د هغه وخت څخه چې خپل ځان یې خرڅ کړی ؤ د بېرته ورکولو د بل کاله پورې کلونه دې وشمېري او د هغه د ازادېدلو بیه دې د پاتې کلونو د هغه نرخ له مخې وي چې یو مزدور ته د هغو کلونو د شمېر په حساب ورکول کیږي."}, {"ref": "None Leviticus 2:53", "text": "د هغه سره دې د داسې مزدورانو په شان چلند وشي چې د کال په حساب اجیران نیول کیږي. تاسو باید وګورئ چې د هغه خاوند د هغه سره سخت چلند ونه کړي."}, {"ref": "None Leviticus 2:54", "text": "حتی که چېرې هغه په دغو طریقو ازاد نه شي، د بېرته ورکولو په راتلونکي کال باید هغه او د هغه اولادونه ازاد شي."}, {"ref": "None Leviticus 2:55", "text": "دا ځکه چې اسراییلیان زما غلامان دي چې ما د مصر څخه راوویستل. زه د هغوی څښتن خدای یم.»"}, {"ref": "None Nehemiah 1:1", "text": "لومړنی کس چې مهر یې ولګاوه هغه والي یعنې نحمیا د حکلیا زوی ؤ او بیا صدقیا مهر ولګاوه. لاندې خلکو هم مهرونه ولګول:"}, {"ref": "None Nehemiah 1:1", "text": "نو د قوم مشران په اورشلیم کې ځای په ځای شول او نورو خلکو پچه واچوله چې د هرو لسو کورنیو څخه دې یوه کورنۍ غوره شي او هغه دې د اورشلیم په سپېڅلي ښار کې واوسیږي او پاتې دې په نورو ښارګوټو کې واوسیږي."}, {"ref": "None Nehemiah 1:1", "text": "په هغه ورځ چې کله د موسی تورات په لوړ اواز سره خلکو ته لوستل کېده، هغوی داسې لیکنه راپیدا کړه چې په هغې کې ویل شوي وو چې عمونیانو او موآبیانو ته اجازه نشته چې د خدای د قوم د غونډې سره یوځای شي."}, {"ref": "None Nehemiah 1:2", "text": "هر سړی چې په خپله خوښه حاضرېده چې په اورشلیم کې واوسیږي، خلکو د هغه دپاره د برکت غوښتنه کوله."}, {"ref": "None Nehemiah 1:2", "text": "دا په دې خاطر چې د عمون او موآب خلکو اسراییلیانو ته د مصر څخه د راوتلو په وخت کې په لاره کې د خوړو او اوبو په ورکولو سره هرکلی ونه کړ، بلکې د دې په ځای هغوی بلعام ته پیسې ورکړې چې په اسراییلو باندې لعنت ووایي، خو زمونږ خدای هغه لعنت په برکت باندې بدل کړ."}, {"ref": "None Nehemiah 1:3", "text": "د اسراییلو خلک، 