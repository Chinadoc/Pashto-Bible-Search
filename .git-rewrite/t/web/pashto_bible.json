يل څوک چې زما په نوم دروغ وائى او خلقو ته وائى چې، ما خوب وليدو. په خوب کښې په ما الهام وشو."}, {"ref": "None Jeremiah 2:25", "text": "د زِمرى، عيلام او د مادى ټولو بادشاهانو ته،"}, {"ref": "None Jeremiah 2:25", "text": "”مالِک خُدائ ربُ الافواج د بنى اِسرائيلو خُدائ پاک داسې فرمائى چې، تا په خپل اختيار سره يو خط صفنياه د معسياه زوئ، اِمام ته، او تا د دې نقل نورو اِمامانو او د يروشلم خلقو ته ولېږلو، چې په کښې تا وليکلو چې،"}, {"ref": "None Jeremiah 2:26", "text": "زۀ به تا او ستا مور د دې مُلک نه جلاوطن کړم، او تاسو به په پردى مُلک کښې مړۀ شئ، په هغه مُلک کښې چرته چې تاسو پېدا شوى نۀ يئ."}, {"ref": "None Jeremiah 2:26", "text": "دا خبرې به ترڅو پورې د دې دروغژنو پېغمبرانو په زړونو کښې راځى، څوک چې د خپلو سوچونو پېغامونه خلقو ته بيانوى."}, {"ref": "None Jeremiah 2:26", "text": "او ما د شمال ټولو نزدې لرې بادشاهانو ته، او پرله پسې د زمکې په مخ ټولو بادشاهتونو ته ورکړه. او د دې هر څۀ نه وروستو د بابل بادشاه به يې هم وڅښى."}, {"ref": "None Jeremiah 2:26", "text": "تۀ مالِک خُدائ د يهويدع په ځائ اِمام جوړ کړې او هغۀ تۀ د خپل کور مشر جوړ کړې. نو تا ته په کار دى چې هر يو ليونے کس چې په دروغو سره نبوت کوى د لرګى په کنده کښې بند کړې او په غاړه کښې ورته د اوسپنې زنځير واچوې."}, {"ref": "None Jeremiah 2:27", "text": "تاسو به دې مُلک ته بيا هيڅکله هم واپس رانۀ شئ کوم چې تاسو غوښتل چې هغه بيا ووينئ.“"}, {"ref": "None Jeremiah 2:27", "text": "د هغوئ خيال دا دے چې کوم خوبونه چې دوئ په خپلو کښې يو بل ته بيانوى نو د دې په وجه به زما خلق زما نوم هېر کړى، لکه څنګه چې پخوا د دوئ پلار نيکۀ زما نوم هېر کړے وو او د بعل بُت عبادت يې وکړو.“"}, {"ref": "None Jeremiah 2:27", "text": "بيا مالِک خُدائ ما ته وفرمائيل، ”اوس هغوئ ته ووايه چې، مالِک خُدائ ربُ الافواج د بنى اِسرائيلو خُدائ پاک فرمائى، تاسو وڅښئ چې نشه شئ او اولټۍ وکړئ، او چې راوغورزېږئ چې بيا هيڅکله راپورته نۀ شئ ځکه چې زۀ به په تاسو جنګ راولم."}, {"ref": "None Jeremiah 2:27", "text": "نو بيا تاسو د عنتوت يرمياه ته زورنه ولې نۀ ده ورکړې، چا چې ستاسو په مينځ کښې د پېغمبرۍ دعوىٰ کوله او خلقو ته يې د پېغمبرۍ خبرې کولې؟"}, {"ref": "None Jeremiah 2:28", "text": "خلقو ووئيل چې، ”ولې دا سړے يهوياکين بادشاه د هغه مات منګى په شان دے څۀ، کوم چې غورزولے شوے وى او د هيچا په کار نۀ وى؟ هغه او د هغۀ بچى ولې په يو داسې مُلک کښې جلاوطن کړے شوى دى چې هغوئ ته هيڅ پته هم نۀ وى؟“"}, {"ref": "None Jeremiah 2:28", "text": "مالِک خُدائ فرمائى چې، ”کوم پېغمبر چې خوب ليدلے دے هغه دې بې‌شکه خپل خوب بيان کړى، خو چې په چا زما کلام نازل شوے دے هغه دې په وفادارۍ سره کلام خلقو ته واوروى. تش بوس د غنمو برابر دى څۀ؟“"}, {"ref": "None Jeremiah 2:28", "text": "خو کۀ هغوئ ستا د لاس د پيالۍ اخستلو او څښلو نه اِنکار وکړى، هغوئ ته ووايه، مالِک خُدائ ربُ الافواج فرمائى چې، دا پيالۍ به ضرور څښئ."}, {"ref": "None Jeremiah 2:28", "text": "ځکه چې مونږ ته په بابل کښې هغۀ پېغام راولېږلو، او پېشګوئې يې وکړه چې زمونږ په جلاوطنۍ کښې به ډېر وخت لګيږى. نو هغۀ ووئيل، تاسو په دې وجه کورونه جوړ کړئ او هلته په کښې اوسېږئ، باغونه وکَرئ او د هغې مېوې خورئ.“"}, {"ref": "None Jeremiah 2:29", "text": "اے زما وطنه، زما وطنه، زما وطنه. د مالِک خُدائ دې پېغام ته غوږ ونيسه،"}, {"ref": "None Jeremiah 2:29", "text": "مالِک خُدائ فرمائى چې، ”آيا زما پېغام د اور په شان نۀ دے څۀ، او زما پېغام د څټک په شان نۀ دے څۀ چې ګټ ټوټه ټوټه کوى؟"}, {"ref": "None Jeremiah 2:29", "text": "ګورئ چې ما د تباهۍ کار په يروشلم کښې شروع کړلو کوم ښار چې زما په نوم ياديږى. نو ولې تاسو به د سزا نه خلاص شئ څۀ؟ تاسو به بې‌سزا پاتې نۀ شئ، ځکه چې زۀ په ټوله زمکه کښې او د هغوئ په ټولو اوسېدونکو باندې جنګ راولم، مالِک خُدائ ربُ الافواج دا فرمائى."}, {"ref": "None Jeremiah 2:29", "text": "صفنياه اِمام دا خط يرمياه نبى ته ولوستلو،"}, {"ref": "None Jeremiah 2:30", "text": "مالِک خُدائ دا فرمائى چې، ”دا کس په بې‌اولادو کښې حساب کړه، دا کس به په خپل ټول ژوند کښې نۀ خوشحاله او نۀ آباد شى. د هغۀ د اولاد نه به څوک هم آباد نۀ شى، او يو به هم نۀ د داؤد په تخت کښېنى، او نۀ به په يهوداه کښې حکومت وکړى.“"}, {"ref": "None Jeremiah 2:30", "text": "نو ځکه زۀ د هغه پېغمبرانو خِلاف يم څوک چې د يو بل نه خبرې نقل کوى او بيا خلقو ته وائى چې دا کلام زما د طرفه دے.“"}, {"ref": "None Jeremiah 2:30", "text": "نو ا