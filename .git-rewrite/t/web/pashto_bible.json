 منظمه توګه به یې دغه ډوډۍ د خدای له حضور څخه لېرې کوله او د هغې په ځای به یې توده ډوډۍ کېښودله."}, {"ref": "1 Samuel 2:6", "text": "یوه ورځ شاوول په جبعه کې په یوې غونډۍ باندې د غز د ونې لاندې نېزه په لاس ناست ؤ او ټول افسران یې د هغه په شاوخوا کې ولاړ وو. هغه ته خبر ورغی چې داود او د هغه سړي پیدا شول."}, {"ref": "1 Samuel 2:6", "text": "کله چې ابیاتار د اخیملک زوی وتښتېد او په قعیله کې د داود سره یوځای شو، سپېڅلی پېشبند یې له ځان سره راوړ."}, {"ref": "1 Samuel 2:6", "text": "هغه خپلو کسانو ته وویل: «څښتن دې ما له دې څخه وساتي چې خپل بادار ته چې څښتن هغه د پاچا په توګه غوره کړی دی، زیان ورسوم! زه باید هغه ته ډېر لږ زیان هم ونه رسوم، ځکه چې هغه د څښتن له خوا غوره شوی پاچا دی.»"}, {"ref": "1 Samuel 2:6", "text": "داود هغوی ته امر وکړ چې نابال ته ووایي: «خوشحاله او ژوندی اوسې! تاسو ته او ستاسو کورنۍ ته ښه روغتیا غواړم! هغو ټولو ته چې ستاسو سره دي، هم روغتیا غواړم!"}, {"ref": "1 Samuel 2:6", "text": "نو داود د حیتي اخیملک او د یوآب د ورور ابیشای چې د زرویه زامن وو، څخه پوښتنه وکړه: «ستاسو دواړو څخه به کوم یو زما سره د شاوول قرارګاه ته ننوځي؟» ابیشای ځواب ورکړ: «زه درسره ځم.»"}, {"ref": "1 Samuel 2:6", "text": "نو اخیش په هغه ورځ داود ته د صقلغ ښار ورکړ او له دې امله د صقلغ ښار تر نن ورځې پورې د یهودا د پاچاهانو دی."}, {"ref": "1 Samuel 2:6", "text": "نو هغه د څښتن څخه پوښتنه وکړه چې څه وکړي، خو څښتن هغه ته نه د خوبونو، نه د اوریم په کارولو او نه د نبیانو په وسیله ځواب ورکړ."}, {"ref": "1 Samuel 2:6", "text": "نو اخیش داود راوغوښت او ورته ویې ویل: «زه د اسراییلو د ژوندي څښتن په نوم قسم خورم چې ته ماته وفادار یې او زه په دې خوښ یم چې زما سره لاړ شې او وجنګیږې. د هغې ورځې څخه چې ته ماته را اووښتی یې په تا کې مې کومه غلطي پیدا نه کړه. خو نور پاچاهان تا نه خوښوي."}, {"ref": "1 Samuel 2:7", "text": "که چېرې هغه ووایي: ‹ډېره ښه ده نو زما خیر به په کې وي، خو که چېرې هغه ډېر په قهر شي، نو ته به پوه شې چې هغه نیت لري چې ماته زیان ورسوي."}, {"ref": "1 Samuel 2:7", "text": "داسې وشوه چې دواغ ادومی د شاوول د شپنو مشر په هماغه ورځ هلته ؤ، ځکه چې د پاکوالي مراسم یې په ځای کول."}, {"ref": "1 Samuel 2:7", "text": "هغه خپلو افسرانو ته وویل: «ای د بنیامین خلکو! واورئ، ایا د یسي زوی به تاسو ټولو ته ځمکې او د انګورو باغونه درکړي؟ ایا هغه به تاسو د زر کسیزه ډلې قوماندانان او یا د سل کسیزه ډلې قوماندانان وټاکي؟"}, {"ref": "1 Samuel 2:7", "text": "شاوول ته خبر ورسېده چې داود قعیلې ته تللی دی، هغه وویل: «خدای هغه ماته راتسلیم کړ. داود خپل ځان د دېوال او د قوي دروازو لرونکي ښار کې کلابند کړی دی.»"}, {"ref": "1 Samuel 2:7", "text": "په دې خبرو داود خپل سړي ورټل او هغوی یې پرېنښودل چې په شاوول باندې حمله وکړي. شاوول سمڅه پرېښودله او په خپله لاره لاړ."}, {"ref": "1 Samuel 2:7", "text": "ما واورېدل چې د پسونو د سکولولو وخت دی. کله چې ستاسو شپانه زمونږ سره وو، مونږ د هغوی سره بد چلند نه ؤ کړی. ټول وخت چې هغوی په کرمل کې وو د هغوی څخه هېڅ شی ورک نه شو."}, {"ref": "1 Samuel 2:7", "text": "بیا د شپې په وخت داود او ابیشای د شاوول قرارګاه ته ورغلل او ویې لیدل چې شاوول د هغې په منځ کې ویده دی او نېزه یې خپل سرته نژدې په ځمکه کې ټومبلې ده. ابنیر او عسکر د هغه په شاوخوا کې ویده وو."}, {"ref": "1 Samuel 2:7", "text": "داود یو کال او څلور میاشتې د فلسطینیانو په خاوره کې ژوند وکړ."}, {"ref": "1 Samuel 2:7", "text": "نو شاوول خپلو درباریانو ته امر وکړ: «ماته یوه ښځه راپیدا کړئ چې کوډګره وي او د مړو د ارواحګانو سره مشورې کوي چې زه هغې ته ورشم او ورڅخه پوښتنه وکړم.» هغوی ځواب ورکړ: «د عین دور په ښار کې یوه کوډګره ښځه شته.»"}, {"ref": "1 Samuel 2:7", "text": "اوس بېرته کور ته وګرځه او هېڅ داسې کار ونه کړې چې د سولې خلاف وي او فلسطیني پاچاهان ورباندې خفه شي.»"}, {"ref": "1 Samuel 2:8", "text": "زما سره احسان وکړه او په هغه تړون باندې چې د څښتن په نوم دې زما سره کړی ؤ ودرېږه، خو که چېرې زه ګناهکار یم، نو ته مې په خپله ووژنه! خپل پلار ته دې ولې ما ورولې چې ووژل شم؟›»"}, {"ref": "1 Samuel 2:8", "text": "داود اخیملک ته وویل: «ایا ستا سره توره یا نېزه شته چې ماته یې راکړې؟ د پاچا حکم زه مجبور کړم، ترڅو په داسې بیړه لاړ شم چې ما دومره وخت پیدا نه کړ چې خپله توره یا کومه بله وسله راواخلم.»"}, {"ref": "1 Samuel 2:8", "text": "ایا د دې دپاره تاسو زما په ضد دسیسه جوړوئ؟ تاسو یو هم ماته ونه ویل چې زما خپل زوی د داود سره لاس یو کړی دی. هېڅوک نشته چې په ما زړه وسوځوي یا ماته ووایي چې زما خپل سړی داود همدا اوس زما د وژلو دپاره موقع لټوي او زما زوی هغه هڅولی دی!»"}, {"ref": "1 Samuel 2:8", "text": "نو شاوول خپل ټول ځواکونه د جګړې دپاره راوغوښتل چې قعیلې ته لاړ شي او داود او د هغه سړي کلابند کړي."}, {"ref": "1 Samuel 2:8", "text": "داود هم د سمڅې څخه راووت او شاوول ته یې غږ وکړ: «اعلیحضرته! زما باداره!» کله چې شاوول شاته وکتل، داود د درناوي په خاطر په ځمکه باندې پړمخې پرېوت."}, {"ref": "1 Samuel 2:8", "text": "د خپلو خدمتګارانو څخه پوښتنه وکړئ او دوی به درته ووایي. نن ځانګړې ورځ ده. له دې امله زما د ځوانانو سره مهربانه اوسئ. مهرباني وکړئ څه چې راکولای شئ مونږ او خپل زوی داود ته یې راکړئ.»"}, {"ref": "1 Samuel 2:8", "text": "ابیشای داود ته وویل: «نن شپه خدای ستا دښمن ستا په لاس کې درکړی دی. اوس اجازه راکړه چې هغه په یو ګوزار د هغه په خپله نېزه د ځمکې سره مېخ کړم او دوهم ګوزار به پرې ونه کړم.»"}, {"ref": "1 Samuel 2:8", "text": "په دې دوران کې به داود او د هغه کسانو په جشوریانو، جرزیانو او عمالیقیانو باندې حملې کولې. دغه قومونه د ډېرې اوږدې مودې راهیسې په هغه خاوره کې چې د شور څخه تر مصر پورې رسېدله، اوسېدل."}, {"ref": "1 Samuel 2:8", "text": "نو شاوول خپله څېره بدله کړه، نور کالي یې واغوستل او د خپلو دوه کسانو سره د شپې په تیاره کې هغې ښځې ته ورغی. هغه ورته وویل: «زما دپاره د ارواحګانو سره مشوره وکړه او ماته ووایه چې څه کېدونکي دي. هغه سړی ماته راوغواړه چې زه یې نوم درته وایم.»"}, {"ref": "1 Samuel 2:8", "text": "داود ځواب ورکړ: «ای ښاغلیه، زما څخه کومه غلطي شوې ده؟ لکه څنګه چې تاسو وایئ، له هغې ورځې څخه چې ما ستاسو خدمت پیل کړی دی په ما کې مو هېڅ غلطي ونه لیدله. نو ولې زه نه شم کولای چې ستاسو سره لاړ شم او د خپل بادار پاچا د دښمنانو سره وجنګېږم؟»"}, {"ref": "1 Samuel 2:9", "text": "یوناتان وویل: «داسې فکر مه کوه! که چېرې زه پوه شوی وای چې زما پلار نیت لري چې تاته زیان درورسوي، ایا تاته به مې خبر نه وای درکړی؟»"}, {"ref": "1 Samuel 2:9", "text": "اخیملک ځواب ورکړ: «ما سره د فلسطیني جلیات یعنې د هغه چا توره شته چې تا د ایله په دره کې وواژه. هغه توره ما په یوه ټوکر کې تاوه کړې ده او هغه د کاهن د سپېڅلي پېشبند شاته ده، که چېرې غواړې نو وایې خله. دلته بې له دې تورې بله نشته.» داود وویل: «هغه ماته راکړه، دا تر ټولو ښه توره ده.»"}, {"ref": "1 Samuel 2:9", "text": "خو ادومي دواغ چې د شاوول د افسرانو سره ولاړ ؤ، وویل: «ما د یسي زوی ولیده چې په نوب کې د اخیتوب زوی اخیملک ته راغی."}, {"ref": "1 Samuel 2:9", "text": "کله چې داود واورېدل چې شاوول په هغه باندې د حملې کولو نیت لري، هغه ابیاتار کاهن ته وویل: «سپېڅلی پېشبند دلته راوړه.»"}, {"ref": "1 Samuel 2:9", "text": "هغه شاوول ته وویل: «ولې د خلکو خبرې اورئ چې وایي: ‹پام کوه، داود غواړي چې تاته زیان ورسوي؟›"}, {"ref": "1 Samuel 2:9", "text": "د داود کسان راورسېدل او د داود په نوم یې نابال ته پیغام ورکړ. بیا هغوی د ځواب دپاره منتظر شول."}, {"ref": "1 Samuel 2:9", "text": "خو داود ابیشای ته وویل: «هغه له منځه مه وړه! څښتن به په یقین سره هغه چاته سزا ورکړي چې د هغه غوره شوي پاچا ته زیان ورسوي.»"}, {"ref": "1 Samuel 2:9", "text": "کله به چې داود په یوې سیمې باندې حمله کوله، نو یو سړی یا ښځه به یې هم ژوندی نه پرېښود. همدارنګه د هغوی پسونه، غویان، خره، اوښان او حتی کالي به یې اخیستل. بیا به بېرته اخیش ته راستنېده."}, {"ref": "1 Samuel 2:9", "text": "خو ښځې هغه ته وویل: «بې له شکه ته پوهېږې چې شاوول څه کړي دي، هغه کوډګران او هغه څوک چې د مړو د ارواحګانو سره خبرې کوي د هېواد څخه شړلي دي. ولې دې راته دام ایښی دی چې ومې وژنې؟»"}, {"ref": "1 Samuel 2:9", "text": "اخیش ځواب ورکړ: «زه یې منم، زما په نظر کې ته لکه د خدای د فرښتې په شان وفادار یې، خو قوماندانانو وویل چې ته نه شې کولای چې زمونږ سره جنګ ته لاړ شې."}, {"ref": "1 Samuel 2:10", "text": "داود پوښتنه وکړه: «که چېرې ستا پلار تاته سخت ځواب درکړي څوک به ماته خبر راکړي؟»"}, {"ref": "1 Samuel 2:10", "text": "نو داود په هماغه ورځ لاړ، د شاوول څخه وتښتېد او د جت پاچا اخیش ته یې ځان ورساوه."}, {"ref": "1 Samuel 2:10", "text": "اخیملک د څښتن څخه پوښتنه وکړه چې داود باید څه وکړي او وروسته هغه داود ته یو څه خواړه او د فلسطیني جلیات توره ورکړه.»"}, {"ref": "1 Samuel 2:10", "text": "داود دعا وکړه: «ای څښتنه، د اسراییلو خدایه! ما اورېدلي دي چې شاوول نیت لري چې قعیلې ته راشي او ښار زما یعنې ستا د غلام په خاطر له منځه یوسي."}, {"ref": "1 Samuel 2:10", "text": "تاسو په خپله ولیدل چې همدا اوس په دې سمڅه کې څښتن ماته په لاس راکړئ. زما ځینو کسانو زه وهڅولم چې تاسو ووژنم، خو ما درباندې رحم وکړ. هغوی ته مې وویل: ‹زه به هېڅکله خپل بادار ته زیان ونه رسوم، ځکه چې څښتن هغه غوره کړی دی چې پاچا شي.›"}, {"ref": "1 Samuel 2:10", "text": "نابال د داود خدمتګارانو ته په ځواب کې وویل: «داود څوک دی؟ د یسي زوی څه کار کوي؟ په دې ورځو کې ډېر نوکران د خپلو بادارانو څخه تښتي."}, {"ref": "1 Samuel 2:10", "text": "داود زیاته کړه: «د ژوندي څښتن په نوم قسم، هغه ورځ به راشي چې څښتن شاوول ووژني. یا به په خپل اجل مړ شي او یا په جګړه کې ووژل شي."}, {"ref": "1 Samuel 2:10", "text": "کله به چې اخیش پوښتنه کوله: «دا ځل دې په کوم ځای باندې حمله کړې ده؟» داود به ورته ویل: «زه د یهودا جنوبي برخې ته» یا «د یرحمییل سیمې ته» یا «هغې سیمې ته تللی وم چې قینیان په کې اوسیږي.»"}, {"ref": "1 Samuel 2:10", "text": "شاوول هغې ته د ژوندي څښتن په نوم باندې قسم وخوړ او ویې ویل: «په دې کار به ته سزا ونه مومې.»"}, {"ref": "1 Samuel 2:10", "text": "نو ای داوده! تاسو ټول چې شاوول پرېښود او ماته راواوښتئ، سبا سهار مجبور یئ چې وختي پاڅېږئ او څنګه چې رڼایي شي، نو لاړ شئ.»"}, {"ref": "1 Samuel 2:11", "text": "یوناتان ځواب ورکړ: «راځه چې پټیو ته لاړ شو.» نو هغوی یوځای هلته لاړل."}, {"ref": "1 Samuel 2:11", "text": "خو د اخیش درباریانو هغه ته وویل: «ایا دا داود، د خپل هېواد پاچا نه دی؟ دا هغه سړی دی چې د هغه په اړه به ښځو د ګډا کولو په وخت کې دا سندرې ویلې: شاوول وژلي دي زرګونه خلک خو داود لس چنده د هغه نه زیات»"}, {"ref": "1 Samuel 2:11", "text": "نو شاوول پاچا د اخیتوب زوی اخیملک کاهن او د هغه د پلار ټوله کورنۍ چې هغوی هم په نوب کې کاهنان وو، راوغوښتل او د ده حضور ته حاضر شول."}, {"ref": "1 Samuel 2:11", "text": "ایا د قعیلې ښاریان به ما شاوول ته وسپاري؟ ایا لکه څنګه چې مې اورېدلي دي شاوول به په رښتیا سره راشي؟ ای څښتنه، د اسراییلو خدایه، زه تاته زاري کوم چې ځواب راکړه!» څښتن ځواب ورکړ: «شاوول به راشي.»"}, {"ref": "1 Samuel 2:11", "text": "وګوره، ای زما پلاره، زما په لاس کې څه شی دی! لیدلی شې چې دا ستا د چپنې یوه ټوټه ده. ما کولای شول چې تا ووژنم، خو د هغې په ځای مې یوازې ستا چپنه غوڅه کړه. یقین وکړه چې زه ستا په ضد د یاغيتوب یا تاته د زیان رسولو په فکر کې نه یم. ما ستا سره غلطي نه ده کړې، خو ته زما د وژلو په لټه کې یې."}, {"ref": "1 Samuel 2:11", "text": "ایا هغه ډوډۍ، اوبه او غوښه چې د خپلو پسونو سکولوونکو دپاره مې تیار کړي دي، واخلم او هغو خلکو ته یې ورکړم، چې زه نه پوهېږم د کوم ځای څخه راغلي دي؟»"}, {"ref": "1 Samuel 2:11", "text": "څښتن دې داسې نه کړي چې زه دې هغه چاته د زیان رسولو هڅه وکړم چې څښتن پاچا کړی دی! اوس هغه نېزه او د اوبو کوزه چې د ده سرته ایښې دي راواخله او ځه چې لاړ شو.»"}, {"ref": "1 Samuel 2:11", "text": "داود به هر یو سړی او ښځه وژل، ترڅو هېڅوک ونه شي کولای بېرته جت ته لاړ شي او خبر ورکړي چې داود او د هغه سړیو په رښتیا سره څه کړي دي. تر هغه وخته پورې چې داود په فلسطین کې اوسېده، همداسې به یې کول."}, {"ref": "1 Samuel 2:11", "text": "نو ښځې پوښتنه وکړه: «څوک درته راوغواړم؟» هغه وویل: «سموییل راته راوغواړه.»"}, {"ref": "1 Samuel 2:11", "text": "نو داود او د هغه سړي سهار وختي پاڅېدل چې بېرته د فلسطین خاورې ته لاړ شي. فلسطینیان یزرعیل ته روان شول."}, {"ref": "1 Samuel 2:12", "text": "بیا یوناتان داود ته وویل: «زه د څښتن، د اسراییلو د خدای په حضور کې تاته وعده درکوم، سبا نه بل سبا تر همدې وخته پورې به زه د خپل پلار نیت معلوم کړم. که چېرې د هغه چلند ستا په هکله ښه ؤ، زه به تاته خبر درولېږم."}, {"ref": "1 Samuel 2:12", "text": "د هغوی خبرو په داود باندې ډېره اغیزه وکړه او د اخیش پاچا څخه ډېر زیات ووېرېده."}, {"ref": "1 Samuel 2:12", "text": "شاوول وویل: «ای د اخیتوب زویه، واوره!» هغه ځواب ورکړ: «هو، ښاغلیه، زه ستاسو په خدمت کې یم.»"}, {"ref": "1 Samuel 2:12", "text": "داود پوښتنه وکړه: «ایا د قعیلې ښاریان به ما او زما سړي شاوول ته وسپاري؟» څښتن وویل: «هغوی به تاسو وسپاري.»"}, {"ref": "1 Samuel 2:12", "text": "څښتن دې قضاوت وکړي چې زمونږ څخه کوم یو ملامت دی! څښتن دې ستا څخه د هغو بدو کارونو بدله واخلي چې زما سره دې کړي دي، خو سره له دې به زه ډېر لږ زیان هم تاته در ونه رسوم."}, {"ref": "1 Samuel 2:12", "text": "نو د داود خدمتګاران بېرته هغه ته ورغلل او هرڅه چې نابال ویلي وو، ورته بیان یې کړل."}, {"ref": "1 Samuel 2:12", "text": "نو داود نېزه او د اوبو کوزه چې د شاوول سرته ایښې وې، راواخیستلې او هغه او ابیشای لاړل. هېچا ونه لیدل او پوه نه شول چې څه پېښ شول او هېڅوک راویښ نه شو. هغوی ټول ویده وو، ځکه چې څښتن په هغو ټولو باندې دروند خوب راوستلی ؤ."}, {"ref": "1 Samuel 2:12", "text": "اخیش په داود باندې باور کاوه او د ځان سره به یې ویل: «د هغه خپل قوم اسراییل د هغه څخه دومره زیاته کرکه کوي چې هغه به ټول عمر زما خدمت کوي.»"}, {"ref": "1 Samuel 2:12", "text": "کله چې هغې ښځې سموییل ولیده، په لوړ اواز یې چیغې ووهلې. هغې شاوول ته وویل: «زه دې ولې وغولولم؟ ته شاوول یې!»"}, {"ref": "1 Samuel 2:13", "text": "که چېرې هغه تاته د زیان رسولو اراده لري، نو څښتن دې ماته سخته سزا راکړي، که تاته مې په دې هکله خبر درنه کړ او ته مې په سلامتۍ سره لېرې ونه لېږلې. څښتن دې ستا سره وي لکه څنګه چې زما د پلار سره ؤ."}, {"ref": "1 Samuel 2:13", "text": "نو کله چې داود د هغوی سره ؤ، هغه خپل ځان په لېونتوب وواهه. کله چې هغوی هڅه وکړه چې دی ونیسي، نو هغه د لېوني په شان عمل کاوه. هغه به په دروازو باندې کرښې ویستلې او په خپله ږیره باندې به یې لاړې تویولې."}, {"ref": "1 Samuel 2:13", "text": "شاوول د هغه څخه پوښتنه وکړه: «تا او د یسي زوی ولې زما په ضد دسیسه جوړه کړې ده؟ ولې دې هغه ته ډوډۍ او توره ورکړې ده او د هغه دپاره دې د خدای سره مشوره کړې ده؟ هغه اوس زما په ضد راپورته شوی او موقع لټوي چې ما ووژني!»"}, {"ref": "1 Samuel 2:13", "text": "نو داود او د هغه سړي چې شمېر یې شپږ سوه تنه وو، د قعیلې څخه لاړل او د یو ځای څخه به بل ځای ته تلل. کله چې شاوول ته خبر ورسېده چې داود د قعیلې څخه تښتېدلی دی، نو هغه خپل د تګ پلان پرېښود."}, {"ref": "1 Samuel 2:13", "text": "لکه چې پخوانی متل دی: ‹بد کارونه یوازې د بدو خلکو په وسیله تر سره کیږي، نو زه به تاته زیان ونه رسوم.›"}, {"ref": "1 Samuel 2:13", "text": "داود خپلو کسانو ته امر وکړ: «خپلې تورې له ملا وتړئ!» نو دوی خپلې تورې وتړلې او داود خپله توره وتړله. شاوخوا څلور سوه کسان د داود سره لاړل او دوه سوه کسان د سامانونو سره پاتې شول."}, {"ref": "1 Samuel 2:13", "text": "بیا داود د درې بلې خواته تېر شو او د غونډۍ په سر باندې ودرېده. د دوی ترمنځ زیاته فاصله وه."}, {"ref": "1 Samuel 2:13", "text": "پاچا هغې ته وویل: «مه وېرېږه! څه شی وینې؟» ښځې په ځواب کې وویل: «زه یوه ارواح وینم چې د ځمکې څخه دباندې راوځي.»"}, {"ref": "1 Samuel 2:14", "text": "نو اخیش خپلو درباریانو ته وویل: «ګورئ! دا سړی لېونی دی! هغه مو ولې ماته راوستلی دی؟"}, {"ref": "1 Samuel 2:14", "text": "اخیملک په ځواب کې وویل: «ستاسو په افسرانو کې داود تر ټولو وفادار دی! هغه ستاسو زوم دی، ستاسو د ساتونکو مشر دی او په شاهي دربار کې هر یو د هغه درناوی کوي."}, {"ref": "1 Samuel 2:14", "text": "داود د زیف د دښتې په غرنۍ سیمه کې په خوندي ځایونو کې اوسېده. شاوول تل هڅه کوله چې هغه پیدا کړي، خو خدای داود هغه ته په لاس نه ورکاوه."}, {"ref": "1 Samuel 2:14", "text": "د اسراییلو پاچا د چا په ضد وتلی دی؟ تاسو څوک تعقیبوئ؟ مړ سپی؟ یا ورږه؟"}, {"ref": "1 Samuel 2:14", "text": "د نابال د خدمتګارانو څخه یو کس د نابال ښځې ابیجایل ته وویل: «ایا تا اورېدلي دي؟ داود د دښتې څخه ځینې استازي زمونږ بادار ته رالېږلي وو چې د هغه سلامونه ورته ورسوي، خو نابال دوی سپک کړل."}, {"ref": "1 Samuel 2:14", "text": "داود ابنیر او د شاوول لښکرو ته نارې ووهلې: «ای ابنیره! ته زما اواز اورې؟» ابنیر ځواب ورکړ: «ته څوک یې چې نارې وهې او پاچا راپاڅوې؟»"}, {"ref": "1 Samuel 2:14", "text": "هغه پوښتنه وکړه: «هغه د څه شي په شان ښکاري؟» هغې وویل: «یو زوړ سړی چې چپنه یې اغوستې ده راپورته کیږي.» نو شاوول پوه شو چې سموییل دی، هغه د درناوي په خاطر په ځمکه باندې پړمخې پرېوت."}, {"ref": "1 Samuel 2:15", "text": "ایا لږ لېونیان لرم؟ ولې دې بل هم راوست چې خپل د لېونتوب په حرکتونو سره ما وځوروي؟ زه نه غواړم چې هغه زما ماڼۍ ته راننوځي.»"}, {"ref": "1 Samuel 2:15", "text": "هو، ما د هغه دپاره د خدای سره مشوره کړې ده او دا لومړی ځل نه دی. تر کومه ځایه چې ستاسو په ضد د دسیسې خبره ده، نو تاسو اعلیحضرت باید په ما او همدارنګه زما په کورنۍ باندې تور ونه لګوئ، د دې خبرې څخه زه هېڅ خبر نه یم!»"}, {"ref": "1 Samuel 2:15", "text": "کله چې داود په حورش کې د زیف په دښته کې ؤ، هغه پوه شو چې شاوول د هغه د وژلو دپاره راوتلی دی."}, {"ref": "1 Samuel 2:15", "text": "څښتن به قضاوت کوي او هغه به دا پرېکړه کوي چې زمونږ څخه کوم یو ملامت دی. هغه دې دا موضوع وڅېړي، زما دفاع دې وکړي او ستا د لاس څخه دې ما وژغوري.»"}, {"ref": "1 Samuel 2:15", "text": "بیاهم د داود سړي زمونږ سره ډېر ښه وو. هغوی زمونږ سره بد چلند نه دی کړی او ټوله موده چې په دښته کې د هغوی سره نژدې وو، زمونږ هېڅ شی ورک نه شو."}, {"ref": "1 Samuel 2:15", "text": "داود ځواب ورکړ: «ای ابنیره! په اسراییلو کې ستا په شان تکړه سړی څوک شته؟ نو بیا ولې د خپل بادار یعنې پاچا ساتنه نه کوې؟ همدا اوس یو څوک قرارګاه ته ننوتی ؤ چې ستا بادار ووژني."}, {"ref": "1 Samuel 2:15", "text": "سموییل شاوول ته وویل: «زه دې ولې په تکلیف کړم چې بېرته راشم؟» شاوول وویل: «زه په لوی مصیبت باندې اخته یم. فلسطینیان زما سره جګړه کوي، خدای زما څخه خپل مخ اړولی دی او ماته نور نه د نبیانو او نه د خوبونو په وسیله ځواب راکوي. نو تاسو مې د دې دپاره راوغوښتلئ چې راته ووایئ چې څه وکړم.»"}, {"ref": "1 Samuel 2:16", "text": "نو یوناتان د داود د کورنۍ سره تړون وکړ، ویې ویل: «که چېرې دا تړون مات شي، څښتن دې هغو خلکو ته سزا ورکړي چې دا تړون یې مات کړی دی.»"}, {"ref": "1 Samuel 2:16", "text": "پاچا وویل: «ای اخیملکه! ته او ستا د پلار ټوله کورنۍ باید ووژل شئ.»"}, {"ref": "1 Samuel 2:16", "text": "د شاوول زوی یوناتان حورش ته د داود لیدلو ته ورغی او هغه ته یې ډاډ ورکړ چې خدای ستا سره مل دی."}, {"ref": "1 Samuel 2:16", "text": "کله چې داود خپلې خبرې خلاصې کړې، شاوول پوښتنه وکړه: «ای داوده زما زویه! ایا دا په رښتیا ته يې؟» او په لوړ اواز یې په ژړا پیل وکړ."}, {"ref": "1 Samuel 2:16", "text": "په ټوله موده کې چې مونږ د دوی تر څنګ رمې څرولې، لکه د دېوال په شان یې شپه او ورځ زمونږ ساتنه کوله."}, {"ref": "1 Samuel 2:16", "text": "ای ابنیره! ته په خپله دنده کې ناکام شوې، زه د ژوندي څښتن په نوم قسم خورم چې تاسو ټول د مرګ لایق یئ، ځکه چې تاسو د خپل بادار چې څښتن هغه پاچا کړی دی، ساتنه نه ده کړې. وګوره! چېرته ده د پاچا نېزه؟ چېرته ده د اوبو هغه کوزه چې د هغه سرته ایښې وه؟»"}, {"ref": "1 Samuel 2:16", "text": "سموییل وویل: «اوس چې څښتن ستا څخه مخ اړولی دی او ستا دښمن شوی دی، ولې زما سره مشوره کوې؟"}, {"ref": "1 Samuel 2:17", "text": "یوناتان یوځل بیا داود مجبور کړ چې خپل قسم تایید کړي چې د هغه سره مینه لري. ځکه چې په یوناتان باندې داود دومره ګران ؤ لکه څنګه چې خپل ځان ورباندې ګران ؤ."}, {"ref": "1 Samuel 2:17", "text": "په دې وخت کې پاچا هغه ساتونکو ته چې د ده په څنګ کې وو، امر وکړ: «د څښتن کاهنان ووژنئ، ځکه چې دوی هم د داود پلویان دي. دوی پوهېدل چې هغه تښتي، خو بیاهم دوی زه خبر نه کړم.» خو د پاچا ساتونکو ونه غوښتل چې د څښتن په کاهنانو باندې لاس پورته کړي او هغوی ووژني."}, {"ref": "1 Samuel 2:17", "text": "یوناتان وویل: «مه وېرېږه، زما پلار به ونه شي کولای چې تا پیدا کړي. ته به په اسراییلو باندې پاچا شې او زه به په رتبه کې ستا نه دوهم یم، زما پلار شاوول هم په دې باندې پوهیږي.»"}, {"ref": "1 Samuel 2:17", "text": "شاوول زیاته کړه: «ته زما څخه ډېر نېک یې. تا زما سره ښه چلند، خو ما ستا سره بد چلند کړی دی."}, {"ref": "1 Samuel 2:17", "text": "اوس په دې هکله فکر وکړه او وګوره چې ته څه کولای شې، ځکه چې زمونږ په بادار او د هغه په ټوله کورنۍ باندې مصیبت راروان دی. هغه دومره بد خویه سړی دی چې هېڅوک ورسره خبرې نه شي کولای.»"}, {"ref": "1 Samuel 2:17", "text": "شاوول د داود اواز وپېژانده او ویې ویل: «ای زما زویه داوده، ایا دا ستا اواز دی؟» داود ځواب ورکړ: «هو، اعلیحضرته! دا زما اواز دی.»"}, {"ref": "1 Samuel 2:17", "text": "څښتن هغه څه کړي دي چې زما په وسیله یې تاته ویلي وو. هغه ستا څخه پاچاهي اخیستې او داود ته یې ورکړې ده."}, {"ref": "1 Samuel 2:18", "text": "هغه وخت یوناتان هغه ته وویل: «څرنګه چې سبا د نوې میاشتې اختر دی، نو خلک به خبر شي، ځکه چې ستا ځای به په دسترخوان کې خالي وي."}, {"ref": "1 Samuel 2:18", "text": "نو شاوول ادومي دواغ ته وویل: «ته هغوی ووژنه!» او دواغ هغوی ټول ووژل. په هغه ورځ یې پنځه اتیا کاهنان چې د کتان سپېڅلي پېشبندونه به یې اغوستل، ووژل."}, {"ref": "1 Samuel 2:18", "text": "هغوی دواړو د څښتن په حضور کې تړون وکړ. بیا یوناتان کور ته لاړ، خو داود په حورش کې پاتې شو."}, {"ref": "1 Samuel 2:18", "text": "تا نن وښودله چې زما سره دې ښېګڼه وکړه، ځکه سره له دې چې څښتن زه تاته تسلیم کړم، خو تا ونه وژلم."}, {"ref": "1 Samuel 2:18", "text": "ابیجایل وخت له لاسه ورنه کړ، هغې دوه سوه دانې ډوډۍ، د شرابو دوه ژي، پنځه پاخه شوي پسونه، پنځه پیمانې وریتې شوې غلې دانې، د ممیزو سل کلچې او د وچ شویو انځرو دوه سوه کلچې یې واخیستلې او هغه یې په خرو باندې بار کړې."}, {"ref": "1 Samuel 2:18", "text": "او هغه زیاته کړه: «ای باداره، تاسو ولې خپل نوکر تعقیبوئ؟ ما څه کړي دي؟ کوم جرم مې کړی دی؟"}, {"ref": "1 Samuel 2:18", "text": "تا د څښتن د حکم څخه سرغړونه وکړه او د هغه قهر او غضب دې عمالیقیانو ته ونه ښود. نو ځکه څښتن دا ورځ په تا باندې راوستې ده."}, {"ref": "1 Samuel 2:19", "text": "سبا نه بل سبا ماښام هغه ځای ته زر لاړ شه چېرته چې ته مخکې پټ شوی وې او هلته د تیږو د ډېرۍ تر شا انتظار کوه."}, {"ref": "1 Samuel 2:19", "text": "وروسته نوب د کاهنانو ښار ته لاړ او د کاهنانو کورنۍ د ښځو او سړیو نه نیولې تر کوچنیانو او تي رودونکو ماشومانو پورې یې ټول ووژل. حتی غویان، خره او د هغوی پسونه یې هم ژوندي پرېنښودل."}, {"ref": "1 Samuel 2:19", "text": "د زیف خلک شاوول ته چې په جبعې کې اوسېده لاړل او ورته ویې ویل: «داود زمونږ په سیمه کې، په حورش کې د حخیله په غره کې چې د یهودا د دښتې په جنوب کې پروت دی، پټ شوی دی."}, {"ref": "1 Samuel 2:19", "text": "کله چې یو کس خپل دښمن پیدا کړي ایا هغه به بې له زیان رسولو پرېږدي؟ د هغه چلند په سبب چې نن دې زما سره وکړ، څښتن دې تاته اجر درکړي."}, {"ref": "1 Samuel 2:19", "text": "بیا هغې خپلو خدمتګارانو ته وویل: «تاسو مخکې لاړ شئ او زه درپسې ځم.» خو هغې خپل مېړه نابال ته څه ونه ویل."}, {"ref": "1 Samuel 2:19", "text": "ای اعلیحضرته، زما خبرې واورئ، که چېرې داسې وي چې څښتن تاسو زما په ضد لمسولی یئ، نو یوه نذرانه دې قبوله کړي. خو که چېرې دا د ځینو خلکو کار وي، نو د څښتن لعنت دې په هغوی باندې نازل شي، ځکه چې هغوی زه د څښتن د وطن څخه چېرته چې زما کور ؤ، بل هېواد ته وشړلم. یعنې دا چې هغوی ما مجبوروي چې د پردیو خدایانو عبادت وکړم."}, {"ref": "1 Samuel 2:19", "text": "پرته له دې به څښتن اسراییل او تا دواړه فلسطینیانو ته په لاس ورکړي او سبا به ته او ستا زامن زما سره یئ. څښتن به د اسراییلو لښکر هم فلسطینیانو ته تسلیم کړي.»"}, {"ref": "1 Samuel 2:20", "text": "زه به درې غشي د هغې په څنګ کې دروولم چې داسې ګومان وشي چې زه یوه نښه ولم."}, {"ref": "1 Samuel 2:20", "text": "خو ابیاتار چې د اخیملک د زامنو ‎څخه او د اخیتوب لمسی ؤ، وتښتېد او لاړ چې د داود سره یوځای شي."}, {"ref": "1 Samuel 2:20", "text": "اعلیحضرته! اوس نو کله چې ستاسو خوښه وي راشئ او مونږ د دې مسوولیت په غاړه لرو چې هغه تاسو ته وسپارو.»"}, {"ref": "1 Samuel 2:20", "text": "اوس زه په دې باندې یقین لرم چې ته به پاچا شې او ستا پاچاهي به په اسراییلو باندې ټینګه شي."}, {"ref": "1 Samuel 2:20", "text": "هغه په خپل خره باندې سپره وه او د غره لمنې ته راښکته کېدله چې ناڅاپه یې داود او د هغه کسان ولیدل چې د هغې خواته راروان وو."}, {"ref": "1 Samuel 2:20", "text": "اوس مه پرېږدئ چې د څښتن د حضور څخه لېرې په پردۍ خاوره کې ووژل شم. د اسراییلو پاچا د څه دپاره راوځي چې زما په شان یوه ورږه ووژني؟ هغه ولې لکه د یوې زرکې په شان ما لټوي؟»"}, {"ref": "1 Samuel 2:20", "text": "شاوول سمدلاسه پرېوت او په ځمکه باندې اوږد وغزېده. د سموییل له خبرو څخه ډېر ووېرېده. هغه خپل قوت له لاسه ورکړی ؤ، ځکه چې هغه ټوله ورځ او ټوله شپه هېڅ شی نه وو خوړلي."}, {"ref": "1 Samuel 2:21", "text": "بیا به زه یو هلک ولېږم او ورته به ووایم: لاړ شه او غشي راپیدا کړه. که هغه ته مې وویل چې ګوره، غشي تاته نه دي رسېدلي، ورشه هغه دلته راوړه، زه د ژوندي څښتن په نوم قسم خورم چې تاته به خطر نه وي."}, {"ref": "1 Samuel 2:21", "text": "هغه داود ته خبر ورکړ چې شاوول د څښتن کاهنان ووژل."}, {"ref": "1 Samuel 2:21", "text": "شاوول ځواب ورکړ: «څښتن دې تاسو ته برکت درکړي، ځکه چې تاسو په ما باندې ډېره مهرباني کوئ.»"}, {"ref": "1 Samuel 2:21", "text": "خو د څښتن په نوم قسم وخوره چې زما اولاده به نه وژنې او زما نوم به زما د پلار د کورنۍ څخه له منځه نه وړې.»"}, {"ref": "1 Samuel 2:21", "text": "داود لږ مخکې ویلي وو: «دا بې ګټې وه چې د دې سړي شتمني مې په دې دښته کې وساتله چې د هغه هېڅ شی ورک نه شو. هغه د ښو په بدل کې راسره بد وکړل."}, {"ref": "1 Samuel 2:21", "text": "بیا شاوول وویل: «ما ګناه کړې ده! بېرته راشه، ای زما زویه داوده! په دې خاطر چې نن شپه دې زه ژوندی پرېښودم، زه به بیا هېڅکله تاته زیان ونه رسوم. زما رفتار د کم عقلۍ ؤ! ما ډېره لویه غلطي کړې ده.»"}, {"ref": "1 Samuel 2:21", "text": "کله چې هغه ښځه شاوول ته ورغله او ویې لیدل چې هغه ډېر وېرېدلی ؤ، هغې ورته وویل: «ګورئ، باداره! ما خپل ځان په خطر کې واچاوه او تاسو چې څه ماته ویلي وو، هغه کار مې وکړ."}, {"ref": "1 Samuel 2:22", "text": "خو که زه هغه ته داسې ووایم چې غشي ستا څخه تېر شوي دي، نو دا به دا معنی ولري چې څښتن غواړي چې تا لېرې ولېږي، نو ته باید لاړ شې."}, {"ref": "1 Samuel 2:22", "text": "داود ابیاتار ته وویل: «کله چې ما په هغه ورځ ادومي دواغ هلته ولیده، زه پوه شوم چې هغه به خامخا شاوول ته خبر ورکوي. نو ستا د ټولو خپلوانو د مړینې مسوولیت زما په غاړه دی."}, {"ref": "1 Samuel 2:22", "text": "شاوول زیاته کړه: «لاړ شئ، نور تیاری هم ونیسئ او معلومه کړئ چې داود د عادت له مخې چېرته ځي او چا دی په هغه ځای کې لیدلی دی. ما اورېدلي دي چې هغه ډېر مکرجن دی."}, {"ref": "1 Samuel 2:22", "text": "نو داود د شاوول دپاره قسم وخوړ. وروسته له هغه شاوول خپل کور ته ستون شو، خو داود او د هغه سړي خپل خوندي ځای ته لاړل."}, {"ref": "1 Samuel 2:22", "text": "خدای دې ما ووژني که چېرې زه د سهار څخه مخکې د نابال خلکو څخه اخرنی نارینه هم ونه وژنم.»"}, {"ref": "1 Samuel 2:22", "text": "داود ځواب ورکړ: «ای اعلیحضرته! ستاسو نېزه دلته ده، ستاسو د سړیو څخه دې یو کس راشي او هغه دې واخلي."}, {"ref": "1 Samuel 2:22", "text": "اوس مهرباني وکړئ څه چې زه وایم هماغسې وکړئ. اجازه راکړئ چې ستاسو دپاره یو څه خواړه تیار کړم. تاسو باید څه وخورئ، ترڅو د سفر دپاره پوره قوت پیدا کړئ.»"}, {"ref": "1 Samuel 2:23", "text": "هغه تړون چې زما او ستا ترمنځ شوی دی، یاد ساته. څښتن به تر ابده پورې زما او ستا ترمنځ شاهد وي.»"}, {"ref": "1 Samuel 2:23", "text": "زما سره پاتې شه او مه وېرېږه. هغه سړی چې غواړي تا ووژني، هغه غواړي چې ما هم ووژني. ته به زما سره خوندي یې.»"}, {"ref": "1 Samuel 2:23", "text": "د هغه د پټېدلو ټول ځایونه معلوم کړئ او د ښکاره معلوماتو سره بېرته ماته راشئ. وروسته له هغې به زه ستاسو سره لاړ شم، که چېرې د یهودا د سیمې په هره قبیله کې وي، زه به یې پیدا کړم.»"}, {"ref": "1 Samuel 2:23", "text": "کله چې ابیجایل داود ولیده، هغه په بیړه د خپل خره څخه راښکته شوه او د هغه د درناوي په خاطر ټیټه شوه."}, {"ref": "1 Samuel 2:23", "text": "څښتن هر هغه چاته اجر ورکوي چې نېک او وفادار وي. هغه نن ته ماته په لاس راکړی وې، خو ما ونه غوښتل هغه چاته زیان ورسوم چې څښتن د پاچا په توګه غوره کړی دی."}, {"ref": "1 Samuel 2:23", "text": "شاوول انکار وکړ او ویې ویل: «نه یې خورم.» خو د هغه کسانو او هغې ښځې هغه وهڅاوه او هغه د دوی خبره ومنله. هغه د ځمکې څخه راپورته شو او په کټ باندې کښېناست."}, {"ref": "1 Samuel 2:24", "text": "نو داود په پټیو کې پټ شو. کله چې د نوې میاشتې اختر راورسېد، پاچا د ډوډۍ خوړلو دپاره راغی"}, {"ref": "1 Samuel 2:24", "text": "نو دوی رخصت شول او د شاوول څخه مخکې زیف ته لاړل. داود او د هغه کسان د معون په دښته کې وو یعنې د یهودا د دښتې د جنوبي برخې په یوه دره کې."}, {"ref": "1 Samuel 2:24", "text": "هغه د داود پښو ته پرېوتله او ویې ویل: «ای زما باداره، پرېږدئ چې ملامتي یوازې په ما باندې وي. خپلې خدمتګارې ته اجازه ورکړئ چې خبرې درسره وکړم، واورئ چې ستاسو خدمتګاره څه وایي."}, {"ref": "1 Samuel 2:24", "text": "لکه څنګه چې نن ما ستا ژوند وژغوره، نو څښتن دې هم زما ژوند وژغوري او ما دې د ټولو مصیبتونو څخه خلاص کړي.»"}, {"ref": "1 Samuel 2:24", "text": "هغې ښځې په کور کې یو چاغ خوسی درلود، هغه یې زر حلال کړ. وروسته هغې یو څه اوړه راواخیستل، ویې اغږل او فطیره ډوډۍ یې پخه کړه."}, {"ref": "1 Samuel 2:25", "text": "او هغه د خپل عادت له مخې د دېوال سره په خپل ځای کې کښېناست. یوناتان مخامخ او ابنیر د شاوول تر څنګ ناست وو، خو د داود ځای خالي ؤ."}, {"ref": "1 Samuel 2:25", "text": "شاوول او د هغه کسانو په لټولو پیل وکړ، کله چې داود ته په دې هکله خبر ورسېده، هغه یو لوی ګټ ته چې د معون په دښته کې ؤ لاړ او هلته پاتې شو. کله چې شاوول دا واورېدل، نو داود پسې د معون دښتې ته لاړ."}, {"ref": "1 Samuel 2:25", "text": "زما بادار دې د دغه بېکاره سړي نابال پروا نه ساتي، هغه کټ مټ د خپل نوم په شان کم عقل سړی دی! ای باداره، کله چې ستاسو خدمتګاران راورسېدل زه په هغه ځای کې نه وم."}, {"ref": "1 Samuel 2:25", "text": "نو شاوول داود ته وویل: «ای زما زویه داوده! خدای دې تاته برکت درکړي، ته به مهم کارونه وکړې او په هغو کې به بریالی یې.» نو داود په خپله لاره لاړ او شاوول خپل کور ته ستون شو."}, {"ref": "1 Samuel 2:25", "text": "بیا یې هغه خواړه د شاوول او د هغه د کسانو په مخکې کېښودل او هغوی وخوړل. په هماغه شپه هغوی پاڅېدل او روان شول."}, {"ref": "1 Samuel 2:26", "text": "خو شاوول په هغه ورځ هېڅ ونه ویل، ځکه هغه فکر کاوه: «داود ته خامخا څه پېښ شوي دي چې هغه یې د دود له مخې ناپاک کړی دی. په یقین سره هغه ناپاک دی.»"}, {"ref": "1 Samuel 2:26", "text": "شاوول د یو غره یوه اړخ ته او داود او د هغه سړي د غره بل اړخ ته تلل او بیړه یې کوله چې د شاوول څخه وتښتي. څنګه چې شاوول او د هغه ځواکونه داود او د هغه سړیو ته نژدې کېدل چې دوی ونیسي،"}, {"ref": "1 Samuel 2:26", "text": "دا څښتن دی چې تاسو یې د خپلو دښمنانو څخه د بدل اخیستلو او وژلو څخه منع کړي یئ. اوس زه تاسو ته د ژوندي څښتن په نوم او ستاسو په سر قسم خورم چې ستاسو دښمنان او هغوی چې غواړي تاسو ته زیان ورسوي لکه د نابال په شان به سزا ومومي."}, {"ref": "1 Samuel 2:27", "text": "خو په راتلونکې ورځ چې د میاشتې دوهمه ورځ وه، د داود ځای بیا خالي ؤ. نو شاوول د خپل زوی یوناتان څخه پوښتنه وکړه: «د یسي زوی ولې نه پرون ډوډۍ ته راغی او نه نن؟»"}, {"ref": "1 Samuel 2:27", "text": "یو استازی شاوول ته راغی او ویې ویل: «زر راشه! فلسطینیانو زمونږ په خاورې حمله کړې ده.»"}, {"ref": "1 Samuel 2:27", "text": "مهرباني وکړئ، دغه سوغات چې تاسو ته مې راوړی دی قبول کړئ او خپلو سړیو ته یې ورکړئ."}, {"ref": "1 Samuel 2:28", "text": "یوناتان په ځواب کې وویل: «هغه زما څخه هیله وکړه چې اجازه ورته ورکړم چې بیت لحم ته لاړ شي."}, {"ref": "1 Samuel 2:28", "text": "نو شاوول د داود تعقیبول پرېښودل او لاړ چې د فلسطینیانو سره وجنګیږي. له دې امله دا ځای «د تېښتې د ګټ» په نوم یاد شو."}, {"ref": "1 Samuel 2:28", "text": "ای ښاغلیه، هیله لرم کومه خطا چې زما څخه شوې ده هغه راته وبخښئ. څښتن به تاسو او همدارنګه ستاسو اولاده هم پاچاهان کړي، ځکه چې تاسو د هغه دپاره جنګېږئ او ترڅو پورې چې ژوندي یئ، بد کار به ونه کړئ."}, {"ref": "1 Samuel 2:29", "text": "داود وویل: ماته اجازه راکړه چې لاړ شم، ځکه چې زمونږ کورنۍ په ښار کې قرباني کوي او زما ورور ماته امر کړی دی چې هلته واوسم. که ته زما څخه خوشحاله یې، ما پرېږده چې لاړ شم ترڅو خپل خپلوان ووینم. نو ځکه هغه د پاچا دسترخوان ته نه دی راغلی.»"}, {"ref": "1 Samuel 2:29", "text": "داود لاړ او د عین جدي په خوندي ځای کې اوسېده."}, {"ref": "1 Samuel 2:29", "text": "که چېرې څوک په تاسو باندې حمله وکړي او ستاسو د وژلو هڅه وکړي، ستاسو څښتن خدای به تاسو داسې خوندي وساتي لکه څوک چې د یوې قیمتي خزانې ساتنه کوي. خو ستاسو دښمنان به لېرې ګوزار کړي لکه څنګه چې څوک تیږه په مچنوغزه باندې ګوزاروي."}, {"ref": "1 Samuel 2:30", "text": "شاوول په یوناتان باندې ډېر په قهر شو او هغه ته یې وویل: «ته زما زوی نه یې، ته خاین یې! زه پوهېږم چې ستا دا خوښه ده چې د یسي زوی ته وفادار اوسې. وشرمېږه! او ستا مور دې هم وشرمیږي چې ته یې زېږولی یې."}, {"ref": "1 Samuel 2:30", "text": "او کله چې څښتن هغه ټول ښه کارونه چې ستاسو سره یې وعده کړې ده، سرته ورسوي او تاسو د اسراییلو مشر وټاکي،"}, {"ref": "1 Samuel 2:31", "text": "ایا په دې نه پوهېږې تر هغه چې د یسي زوی ژوندی وي، ته به هېڅکله د دې ملک پاچا نه شې؟ نو اوس څوک ولېږه او هغه دلته راوله، ځکه چې هغه باید ووژل شي!»"}, {"ref": "1 Samuel 2:31", "text": "نو باداره! ستاسو وجدان به د بېځایه وژنې یا د بدل اخیستلو د پښېمانۍ احساس نه کوي. او کله چې څښتن تاسو ته بری درکړي، نو ما هېره نه کړئ.»"}, {"ref": "1 Samuel 2:32", "text": "یوناتان پوښتنه وکړه: «هغه ولې ووژل شي؟ هغه څه ګناه کړې ده؟»"}, {"ref": "1 Samuel 2:32", "text": "داود ابیجایل ته وویل: «د اسراییلو د څښتن خدای ثنا دې وي چې نن ورځ یې ته زما د لیدلو دپاره راواستولې!"}, {"ref": "1 Samuel 2:33", "text": "په دې وخت کې شاوول خپله نېزه په یوناتان پسې ګوزاره کړه چې هغه ووژني او یوناتان پوه شو چې په رښتیا د ده پلار پرېکړه کړې ده چې داود ووژني."}, {"ref": "1 Samuel 2:33", "text": "ستا د ښه قضاوت دپاره دې د خدای شکر وي چې زه دې نن ورځ د وینې تویولو او زما په خپل لاس د بدل اخیستلو څخه وساتلم."}, {"ref": "1 Samuel 2:34", "text": "یوناتان په ډېر قهر د دسترخوان څخه پاڅېد او د میاشتې په دوهمه ورځ یې ډوډۍ ونه خوړله، ځکه چې هغه په دې باندې غمجن شو چې د ده پلار داود سپک کړ."}, {"ref": "1 Samuel 2:34", "text": "څښتن پرېنښودم چې تاته زیان ورسوم. خو زه د اسراییلو د ژوندي خدای په نوم قسم خورم چې که چېرې تا زما د لیدلو دپاره بیړه نه وای کړې، نو تر سهاره پورې به د نابال ټول نارینه وژل شوي وای!»"}, {"ref": "1 Samuel 2:35", "text": "لکه څنګه چې دوی یو د بله سره موافقه کړې وه، د بلې ورځې په سهار یوناتان پټیو ته لاړ چې د داود سره وګوري. یوناتان یو ځوان هلک د ځان سره یووړ"}, {"ref": "1 Samuel 2:35", "text": "بیا داود هغه څه قبول کړل چې هغه ته یې راوړي وو او ورته ویې ویل: «په خیر سره خپل کور ته لاړه شه، ستا خبرې مې واورېدلې او ستا غوښتنه مې ومنله.»"}, {"ref": "1 Samuel 2:36", "text": "او هغه ته یې وویل: «منډه کړه او هغه غشي چې زه یې ولم، راپیدا کړه.» هلک منډه کړه او یوناتان یو غشی وویشت چې د هلک څخه تېر شو."}, {"ref": "1 Samuel 2:36", "text": "ابیجایل بېرته نابال ته ورغله، هغه په کور کې ؤ او یوه داسې مېلمستیا یې جوړه کړې وه لکه څنګه چې د پاچا دپاره جوړیږي. هغه نشه ؤ او خوشحاله ؤ. نو هغې تر سبا سهاره پورې ده ته هېڅ څه ونه ویل."}, {"ref": "1 Samuel 2:37", "text": "کله چې هلک هغه ځای ته ورغی چې غشی په کې لوېدلی ؤ، یوناتان په هلک باندې غږ وکړ: «ایا غشی ستا څخه تېر شوی نه دی؟»"}, {"ref": "1 Samuel 2:37", "text": "نو وروسته له هغې چې نابال په سهار کې د نشې څخه په حال شو، هرڅه چې پېښ شوي وو، هغې ورته وویل. په هغه باندې د زړه حمله راغله او هغه بیخي فلج شو."}, {"ref": "1 Samuel 2:38", "text": "بیا یوناتان د هغه هلک پسې چیغې کړې: «بیړه وکړه! زر لاړ شه! مه ودرېږه!» هلک غشی راپورته کړ او خپل بادار ته راستون شو."}, {"ref": "1 Samuel 2:38", "text": "نابال لس ورځې په همدې حال کې ؤ او وروسته څښتن د هغه ژوند پای ته ورساوه."}, {"ref": "1 Samuel 2:39", "text": "هلک پوه نه شو چې دا څه معنی لري. یوازې یوناتان او داود پوهېدل."}, {"ref": "1 Samuel 2:39", "text": "کله چې داود واورېدل چې نابال مړ شو، هغه وویل: «د څښتن ثنا دې وي! هغه د نابال څخه زما د سپکاوي بدله واخیستله او زه یې د بد کار څخه وساتلم. څښتن نابال ته د خپلو بدیو سزا ورکړه.» وروسته له هغې داود ابیجایل ته پیغام واستاوه او غوښتنه یې ورڅخه وکړه چې د ده سره واده وکړي."}, {"ref": "1 Samuel 2:40", "text": "نو یوناتان خپلې وسلې هغه هلک ته ورکړې او ورته ویې ویل: «لاړ شه او دا ښار ته یوسه.»"}, {"ref": "1 Samuel 2:40", "text": "د هغه خدمتګاران کرمل ته لاړل او ابیجایل ته یې وویل: «داود مونږ تاته رالېږلي یو چې تا د ځان سره بوځو چې د هغه سره واده وکړې.»"}, {"ref": "1 Samuel 2:41", "text": "وروسته له هغې چې هلک لاړ، داود د تیږو د ډېرۍ له شا راپاڅېده، په ځمکه باندې پړمخې پرېوت او درې ځله د درناوي په خاطر یوناتان ته په ځمکې باندې پړمخې پرېوت. کله چې هغوی یو بل ښکلول نو هغوی دواړو ژړل، د داود خفګان د یوناتان نه هم زیات وو."}, {"ref": "1 Samuel 2:41", "text": "ابیجایل د درناوي په خاطر ټیټه شوه او ویې ویل: «داود ته داسې ووایئ: ‹زه ستاسو وینځه دې ته تیاره یم چې ستاسو خدمت وکړم او ستاسو د خدمتګارانو پښې ووینځم.›»"}, {"ref": "1 Samuel 2:42", "text": "یوناتان داود ته وویل: «په خیر لاړ شه، ځکه چې مونږ یو د بله سره د څښتن په نوم د دوستۍ قسم خوړلی دی او ویلي مو دي چې څښتن دې تر ابده پورې زما او ستا ترمنځ او زما د اولادې او ستا د اولادې ترمنځ شاهد وي.» له هغې وروسته داود لاړ او یوناتان بېرته ښار ته ستون شو."}, {"ref": "1 Samuel 2:42", "text": "هغه زر پاڅېدله او په خپل خره باندې سپره شوه. پنځه وینځې یې ورسره روانې شوې، هغه د داود د خدمتګارانو سره لاړله او په دې توګه د هغه ښځه شوه."}, {"ref": "1 Samuel 2:43", "text": "همدارنګه داود د اخینوعم سره چې د یزرعیل څخه وه، هم واده کړی ؤ او دوی دواړه د هغه ښځې شوې."}, {"ref": "1 Samuel 2:44", "text": "خو شاوول خپله لور میکال چې د داود ښځه وه، فلتي د لایش زوی ته چې د جلیم څخه ؤ، ورکړه."}, {"ref": "1 Samuel 3:1", "text": "داود او د هغه کسان په درېمه ورځ صقلغ ته ورسېدل. هغه وخت چې هغوی هلته نه وو، عمالیقیانو د یهودا په جنوب او صقلغ باندې حمله کړې وه. صقلغ یې سوځولی ؤ"}, {"ref": "1 Samuel 3:1", "text": "فلسطینیانو د جلبوع په غره کې د اسراییلو سره جنګ وکړ. په هغه ځای کې ډېر اسراییلیان ووژل شول او پاتې یې چې په هغو کې شاوول پاچا او د هغه زامن هم شامل وو، وتښتېدل."}, {"ref": "1 Samuel 3:2", "text": "او ښځې او کوچنیان یې د اسیرانو په توګه د ځان سره بېولي وو، خو څوک یې وژلي نه وو."}, {"ref": "1 Samuel 3:2", "text": "خو فلسطینیانو هغوی ډېر سخت تعقیب کړل او د شاوول درې زامن، یوناتان، ابیناداب او ملکیشوع یې ووژل."}, {"ref": "1 Samuel 3:3", "text": "کله چې داود او د هغه کسان صقلغ ته راورسېدل، دوی پوه شول چې ښار سوځېدلی دی او د هغوی ښځې، زامن او لورګانې اسیران شوي دي."}, {"ref": "1 Samuel 3:3", "text": "په شاوول باندې جګړه ډېره سخته شوه او کله چې غشي ویشتونکي هغه ته ورسېدل، نو هغه یې ډېر سخت ټپي کړ."}, {"ref": "1 Samuel 3:4", "text": "نو داود او د هغه کسانو په لوړ اواز سره تر هغې پورې وژړل چې په هغوی کې نور د دې توان پاتې نه شو چې وژاړي."}, {"ref": "1 Samuel 3:4", "text": "شاوول خپل عسکر ته چې د هغه وسله یې انتقالوله، وویل: «خپله توره راوباسه او ما ووژنه، ترڅو دا کافر فلسطینیان راباندې نه ملنډې ووهي، نه مې په عذاب کړي او نه مې ووژني.» خو هغه ځوان د دې کار څخه ډېر ووېرېد. نو شاوول خپله توره راواخیستله او ځان یې ورباندې وغورځاوه."}, {"ref": "1 Samuel 3:5", "text": "حتی د داود دوه ښځې، یزرعیلي اخینوعم او د کرملي نابال کونډه ابیجایل هم اسیرې شوې وې."}, {"ref": "1 Samuel 3:5", "text": "کله چې هغه ځوان ولیدل چې شاوول مړ شوی دی، نو هغه هم په خپلې تورې باندې ځان وغورځاوه او د شاوول سره یوځای مړ شو."}, {"ref": "1 Samuel 3:6", "text": "داود ډېر زیات پرېشانه شو، ځکه چې د هغه کسانو د هغه د سنګسارولو خبرې کولې. هغوی د خپلو ماشومانو د لاسه ورکولو له امله ډېر په قهر وو. خو داود د خپل څښتن خدای څخه د زړه قوت لاسته راوړ."}, {"ref": "1 Samuel 3:6", "text": "نو په دې ډول شاوول، د هغه درې زامن، هغه ځوان عسکر او د هغه ټول جنګیالي په هغه ورځ یوځای سره مړه شول."}, {"ref": "1 Samuel 3:7", "text": "بیا داود د اخیملک زوی ابیاتار کاهن ته وویل: «سپېڅلی پېشبند ماته راوړه» او ابیاتار دا کار وکړ."}, {"ref": "1 Samuel 3:7", "text": "کله چې د یزرعیل د درې د بلې خوا او د اردن د سیند د ختیځې خوا اسراییلیانو واورېدل چې د اسراییلو لښکر تښتېدلی دی او دا چې شاوول او د هغه زامن وژل شوي دي، دوی خپل ښارونه پرېښودل او وتښتېدل. نو فلسطینیان راغلل او په دغو ښارونو کې ځای په ځای شول."}, {"ref": "1 Samuel 3:8", "text": "داود د څښتن څخه پوښتنه وکړه: «ایا زه د هغو یرغلګرو پسې ورشم؟ او هغوی ته به ورسېږم؟» څښتن ځواب ورکړ: «ورپسې ورشه! ته به په یقین سره هغوی ته ورسېږې او اسیران به ازاد کړې.»"}, {"ref": "1 Samuel 3:8", "text": "د جګړې نه یوه ورځ وروسته فلسطینیان د مړو د لوټلو دپاره ورغلل، نو هغوی د شاوول او د هغه د درې زامنو مړي وموندل چې د جلبوع په غره کې پراته وو."}, {"ref": "1 Samuel 3:9", "text": "نو داود او د هغه شپږ سوه کسان روان شول. کله چې هغوی د بسور خوړ ته ورسېدل، نو د دوی څخه ځینې هلته پاتې شول."}, {"ref": "1 Samuel 3:9", "text": "دوی د شاوول سر پرې کړ، د هغه څخه یې زغرې وویستلې او د فلسطین ټول هېواد ته یې استازي ولېږل چې دا زېری د خپلو بتانو او خپلو خلکو په منځ کې خپور کړي."}, {"ref": "1 Samuel 3:10", "text": "داود د څلور سوه کسانو سره تعقیبولو ته دوام ورکړ. نور دوه سوه کسان دومره ستړي شوي وو چې ویې نه شو کولای د هغه خوړ څخه تېر شي، نو دوی شاته پاتې شول."}, {"ref": "1 Samuel 3:10", "text": "دوی د شاوول زغرې د عشتاروت په بتخانه کې کېښودلې او د هغه مړی یې د بیت‎ شان په دېوال باندې مېخ کړ."}, {"ref": "1 Samuel 3:11", "text": "د داود کسانو یو مصري سړی په صحرا کې پیدا کړ او هغه یې داود ته راوست. هغه ته یې یو څه خواړه او اوبه ورکړل،"}, {"ref": "1 Samuel 3:11", "text": "کله چې په جلعاد کې د یابیش د ښار خلکو د هغه څه په اړه چې فلسطینیانو په شاوول باندې کړي وو، واورېدل،"}, {"ref": "1 Samuel 3:12", "text": "همدارنګه یې د انځرو د کلچې څخه یوه ټوټه او د ممیزو دوه کلچې ورکړې. وروسته له دې چې هغه یې وخوړلې هغه بېرته قوي شو، ځکه چې هغه درې ورځې او درې شپې نه څه خوړلي وو او نه څه څښلي وو."}, {"ref": "1 Samuel 3:12", "text": "د هغوی تر ټولو زړور سړي ووتل او ټوله شپه یې بیت شان ته سفر وکړ. هغوی د شاوول او د هغه د زامنو مړي د دېوال څخه راښکته کړل، یابیش ته یې راوړل او هلته یې وسوځول."}, {"ref": "1 Samuel 3:13", "text": "داود د هغه څخه پوښتنه وکړه: «ستا بادار څوک دی او د کوم ځای یې؟» هغه ځوان ځواب ورکړ: «زه مصری یم او د یوه عمالیقي غلام یم. درې ورځې کیږي چې ناروغ شوی یم، په دې خاطر خپل بادار پرېښودم."}, {"ref": "1 Samuel 3:13", "text": "بیا هغوی د دوی هډوکي راواخیستل، هغه یې په ښار کې د غز د ونې لاندې ښخ کړل او د اوو ورځو دپاره یې روژه ونیوله."}, {"ref": "1 Samuel 3:14", "text": "مونږ د کریتیانو په علاقه، د یهودا په جنوبي برخه او د کالیب په سیمه باندې حمله وکړه او همدارنګه مونږ د صقلغ ښار وسوځاوه.»"}, {"ref": "1 Samuel 3:15", "text": "داود د هغه څخه پوښتنه وکړه: «ایا ته به ما د هغو یرغلګرو پورې ورسوې؟» هغه ځواب ورکړ: «ماته د خدای په نوم باندې قسم وخوره چې ته به مې نه وژنې او نه به مې خپل بادار ته په لاس کې ورکوې، نو زه به تا هغوی ته ورسوم.»"}, {"ref": "1 Samuel 3:16", "text": "نو دغه مصري داود هغوی ته ورساوه. یرغلګران په هرځای کې خپاره شوي وو او د هغه ډېر لوی غنیمت له امله چې د فلسطین او یهودا څخه یې نیولی ؤ، خوړل یې او څښل یې او جشن یې نیولی ؤ."}, {"ref": "1 Samuel 3:17", "text": "په راتلونکې ورځ د لمرخاته څخه مخکې داود په هغوی باندې حمله وکړه او تر ماښامه پورې یې جنګ وکړ. بې له هغو څلور سوه ځوانانو چې په اوښانو باندې سپاره شول او وتښتېدل، بل هېڅ یو ورڅخه په تېښته بریالی نه شو."}, {"ref": "1 Samuel 3:18", "text": "داود ټول شیان چې عمالیقیانو وړي وو، وژغورل چې په هغو کې د هغه دوه ښځې هم شاملې وې."}, {"ref": "1 Samuel 3:19", "text": "هېڅوک نه ؤ ورک شوی، نه ځوان او نه زوړ، نه زامن او نه لورګانې او نه هغه شیان چې عمالیقیانو د خپلو ځانونو دپاره د غنیمت په توګه نیولي وو. داود هرڅه بېرته تر لاسه کړل."}, {"ref": "1 Samuel 3:20", "text": "همدارنګه داود د عمالیقیانو ټولې رمې او پادې واخیستلې او د هغه کسانو دا د نورو څارویو په مخکې بېول او ویل یې: «دا د داود غنیمت دی!»"}, {"ref": "1 Samuel 3:21", "text": "نو بیا داود هغو دوه سوه کسانو ته ورغی چې له ډېرې ستومانۍ څخه یې نه شو کولای چې په هغه پسې لاړ شي او د بسور په خوړ کې د هغه څخه شاته پاتې شوي وو. هغوی د داود او د هغو خلکو هرکلي ته ووتل چې د هغه سره وو. څنګه چې داود او د هغه کسان ورنژدې شول هغه د هغوی سره روغبړ او د احوال پوښتنه وکړه."}, {"ref": "1 Samuel 3:22", "text": "خو ځینو بدو او بېکاره سړیو چې د داود سره تللي وو، وویل: «دوی زمونږ سره لاړ نه شول، نو مونږ به د غنیمت څخه دوی ته هېڅ ورنه کړو. دوی کولای شي چې خپلې ښځې او ماشومان واخلي او لاړ شي.»"}, {"ref": "1 Samuel 3:23", "text": "خو داود ځواب ورکړ: «ای زما ورونو! د هغه شیانو سره چې څښتن مونږ ته راکړي دي داسې کار نه شئ کولای! څښتن مونږ سلامت وساتلو او په یرغلګرو باندې یې مونږ ته بری راکړ."}, {"ref": "1 Samuel 3:24", "text": "هېڅوک په دې هکله ستاسو سره موافق نه دي. د هغه سړي برخه به چې د سامانونو سره پاتې کیږي د هغه چا د برخې سره برابره وي چې جنګ ته ځي. د ټولو برخې به یو برابر وي.»"}, {"ref": "1 Samuel 3:25", "text": "داود دا یو قانون وټاکه او د هغه وخت نه تر نن ورځې پورې په اسراییلو کې د هغه څخه پیروي کیږي."}, {"ref": "1 Samuel 3:26", "text": "کله چې داود صقلغ ته ستون شو، هغه د غنیمت یوه برخه خپلو ملګرو ته چې د یهودا سپین ږیري وو، د دې پیغام سره ولېږله: «دا د هغه غنیمت یوه برخه ده چې مونږ د څښتن د دښمنانو څخه نیولی ؤ، دا ستاسو دپاره سوغات دی.»"}, {"ref": "1 Samuel 3:27", "text": "هغه دا سوغاتونه هغو خلکو ته چې په بیت ییل، د یهودا د جنوب په راموت کې او هغو خلکو ته چې د یتیر،"}, {"ref": "1 Samuel 3:28", "text": "عروعیر، سفموت، اشتموع،"}, {"ref": "1 Samuel 3:29", "text": "او د راکال په ښارونو کې وو او هغو ښارونو ته چې د یرحمییلیانو او د قینیانو طایفې په کې اوسېدلې، ولېږل."}, {"ref": "1 Samuel 3:30", "text": "همدارنګه یې هغو خلکو ته چې د حرما، بورعاشان او عتاق په ښارونو کې وو"}, {"ref": "1 Samuel 3:31", "text": "او د حبرون خلکو ته یې هم ولېږل. په دې توګه داود دا سوغاتونه ټولو هغو ځایونو ته ولېږل چې هغه او د هغه سړي په کې ګرځېدلي وو."}, {"ref": "2 Chronicles 1:1", "text": "رحبعام شکیم ته لاړ، ځکه چې ټول اسراییلیان هلته راټول شوي وو چې هغه پاچا کړي."}, {"ref": "2 Chronicles 1:1", "text": "کله چې رحبعام اورشلیم ته ورسېده، هغه د یهودا او بنیامین د قبیلو څخه یوسلو اتیا زره غوره شوي عسکر راټول کړل. هغه پرېکړه وکړه چې په اسراییلو باندې حمله وکړي او د اسراییلو شمالي قبیلې یوځل بیا تر خپل واک لاندې راولي."}, {"ref": "2 Chronicles 1:1", "text": "څنګه چې رحبعام د خپلې پاچاهۍ واک تر‌لاسه کړ او قوي شو، هغه او د هغه ټول قوم د څښتن د شریعت لاره پرېښودله."}, {"ref": "2 Chronicles 1:1", "text": "د یروبعام د پاچاهۍ په اتلسم کال، ابیا د یهودا پاچا شو"}, {"ref": "2 Chronicles 1:1", "text": "ابیا مړ شو او د داود د ښار په شاهي هدیره کې ښخ شو. د هغه زوی آسا د هغه په ځای پاچا شو. د هغه په وخت کې په یهودا کې لس کاله ارامي وه."}, {"ref": "2 Chronicles 1:1", "text": "د عودید په زوی عزریا باندې د خدای روح نازل شو"}, {"ref": "2 Chronicles 1:1", "text": "د آسا د پاچاهۍ په شپږ دېرشم کال د اسراییلو پاچا بعشا په یهودا باندې حمله وکړه او د رامه ښار یې ونیوه. هغه دا ښار قوي کړ، د دې دپاره چې د یهودا د ټولو خلکو د تګ راتګ مخه ونیسي."}, {"ref": "2 Chronicles 1:1", "text": "یهوشافاط د خپل پلار آسا په ځای پاچا شو او د اسراییلو په خلاف یې خپل ځان قوي کړ."}, {"ref": "2 Chronicles 1:1", "text": "یهوشافاط ډېر شتمن او عزتمن ؤ. هغه خپل زوی ته د اخاب لور واده کړه او په دې ډول هغه د اخاب ملګری شو."}, {"ref": "2 Chronicles 1:1", "text": "د یهودا پاچا یهوشافاط خپلې ماڼۍ ته چې په اورشلیم کې وه په خیریت سره راستون شو."}, {"ref": "2 Chronicles 1:2", "text": "کله چې د نباط زوی یروبعام چې د سلیمان له لاسه مصر ته تښتېدلی ؤ، دا خبر واورېد، نو هغه د مصر څخه راستون شو."}, {"ref": "2 Chronicles 1:2", "text": "خو څښتن شمعیه نبي ته وویل:"}, {"ref": "2 Chronicles 1:2", "text": "نو د رحبعام د پاچاهۍ په پنځم کال څښتن هغوی ته د بې‌وفایۍ په خاطر سزا ورکړه. هغه د مصر پاچا شیشق ته اجازه ورکړه چې په اورشلیم باندې حمله وکړي."}, {"ref": "2 Chronicles 1:2", "text": "او هغه درې کاله په اورشلیم کې پاچاهي وکړه. د هغه مور میکایا نومېدله چې د اوري‌ییل لور وه. اوري‌ییل د جبعې د ښار څخه ؤ. د ابیا او یروبعام ترمنځ جګړه پیل شوه،"}, {"ref": "2 Chronicles 1:2", "text": "آسا هغه کارونه کول چې د څښتن خدای په نظر کې ښه او سم وو."}, {"ref": "2 Chronicles 1:2", "text": "او هغه لاړ چې د آسا پاچا سره لیدنه کتنه وکړي. عزریا هغه ته وویل: «ای آسا او د یهودا او د بنیامین ټولو خلکو، ماته غوږ ونیسئ! تر هغه وخته پورې چې تاسو د څښتن سره یئ، هغه ستاسو سره مل دی، که چېرې تاسو د هغه په لټه کې شئ، هغه به پیدا کړئ. خو که چېرې د هغه څخه مخ واړوئ، هغه به هم ستاسو څخه مخ واړوي."}, {"ref": "2 Chronicles 1:2", "text": "نو آسا پاچا هغه سپین زر او سره زر چې د څښتن د کور او د خپلې ماڼۍ په خزانو کې وو، واخیستل. بیا یې هغه دمشق ته د سوریې پاچا بنهدد ته د دې پیغام سره ولېږل:"}, {"ref": "2 Chronicles 1:2", "text": "هغه د یهودا په ټولو قوي ښارونو کې عسکر او د یهودا په پاتې سیمه کې او همدارنګه د افرایم په هغو ښارونو کې چې د هغه پلار آسا نیولي وو، نظامي پوستې ځای په ځای کړې."}, {"ref": "2 Chronicles 1:2", "text": "یو څو کاله وروسته یهوشافاط د اخاب د لیدنې دپاره د سامرې ښار ته ورغی. اخاب د یهوشافاط او د هغه د درباریانو د درناوي دپاره ډېر پسونه او غویان حلال کړل او یوه لویه مېلمستیا یې جوړه کړه. هغه هڅه وکړه چې یهوشافاط دې خبرې ته راضي کړي چې په جلعاد کې د راموت په ښار باندې په حمله کې د هغه سره لاس یو کړي."}, {"ref": "2 Chronicles 1:2", "text": "د حناني زوی ییهو چې یو نبي ؤ، د پاچا د لیدلو دپاره لاړ او ورته ویې ویل: «ایا د بدو خلکو سره مرسته یا د هغو خلکو طرفداري کول چې د څښتن څخه کرکه کوي، سم کار دی؟ په دې خاطر د څښتن قهر او غضب په تا باندې راغلی دی!"}, {"ref": "2 Chronicles 1:3", "text": "بیا هغوی یروبعام راوغوښت او هغه او د اسراییلو ټول خلک رحبعام ته ورغلل او هغه ته یې وویل:"}, {"ref": "2 Chronicles 1:3", "text": "«د یهودا پاچا یعنې د سلیمان زوی رحبعام او د یهودا او بنیامین د قبیلو اسراییلیانو ته ووایه:"}, {"ref": "2 Chronicles 1:3", "text": "شیشق د خپلو یو زرو او دوه سوو جنګي ګاډیو او شپېتو زرو اس سوارانو او د لیبیایي، شکیم او ایتوپیایي د بې‌شمېرو عسکرو په مرسته حمله وکړه."}, {"ref": "2 Chronicles 1:3", "text": "د ابیا په لښکرو کې څلور سوه زره غوره شوي زړور جنګیالي وو او یروبعام همداسې د اته سوه زره زړورو جنګیالیو په درلودلو سره د هغه مقابله وکړه."}, {"ref": "2 Chronicles 1:3", "text": "هغه د پردیو خدایانو د قربانۍ او د بتانو سیمه‌اییز عبادتځایونه وران کړل. هغه د تیږو ستنې ټوټې ټوټې کړې او د اشیره بتان یې راوغورځول."}, {"ref": "2 Chronicles 1:3", "text": "اسراییلو ډېره موده پرته له رښتیني خدای او شریعت څخه ژوند تېراوه. کاهنان نه وو چې هغوی ته څه ورزده کړي."}, {"ref": "2 Chronicles 1:3", "text": "«زما او ستاسو ترمنځ دې داسې یو تړون وي لکه څنګه چې زما د پلار او ستاسو د پلار ترمنځ ؤ. ګورئ، زه تاسو ته سپین او سره زر درلېږم. نو خپل تړون اوس د اسراییلو د پاچا بعشا سره مات کړئ، ترڅو هغه خپلې لښکرې زما د سیمې څخه وباسي.»"}, {"ref": "2 Chronicles 1:3", "text": "څښتن د یهوشافاط سره مل ؤ، په دې خاطر چې یهوشافاط د خپل نیکه داود هغه لاره غوره کړې وه چې هغه د خپلې پاچاهۍ په پیل کې خپله کړې وه. هغه د بعل عبادت ونه کړ،"}, {"ref": "2 Chronicles 1:3", "text": "د اسراییلو پاچا اخاب د یهودا د پاچا یهوشافاط څخه پوښتنه وکړه: «ایا ته به زما سره لاړ شې چې په راموت باندې حمله وکړو؟» یهوشافاط په ځواب کې وویل: «هو، څه چې زما دي هغه ستا دي، یعنې زه او زما خلک. مونږ به ستا سره په جګړه کې لاس یو کړو."}, {"ref": "2 Chronicles 1:3", "text": "خو ستا هر کار خراب نه دی. تا هغه بتان لېرې کړل چې د اشیره په عبادت کې ورڅخه کار اخیستل کېده او ته په اخلاص سره غواړې چې د څښتن عبادت وکړې.»"}, {"ref": "2 Chronicles 1:4", "text": "«ستاسو پلار سلیمان زمونږ سره ډېر سخت چلند کاوه او دروند بار یې په مونږ باندې ایښی ؤ. که چېرې تاسو دا بار زمونږ د اوږو نه سپک او زمونږ دپاره ژوند اسانه کړئ، نو مونږ به ستاسو خدمت کوو.»"}, {"ref": "2 Chronicles 1:4", "text": "‹د اسراییلو په خلکو باندې چې ستاسو ورونه دي حمله ونه کړئ، ټول خپلو کورونو ته لاړ شئ. هغه څه چې پېښ شوي دي هغه زما رضا ده.›» نو هغوی د څښتن د حکم څخه اطاعت وکړ او د یروبعام په خلاف جګړې ته لاړ نه شول."}, {"ref": "2 Chronicles 1:4", "text": "هغه په یهودا کې قوي ښارونه ونیول او تر اورشلیمه پورې یې پرمختګ وکړ."}, {"ref": "2 Chronicles 1:4", "text": "ابیا د صمارایم د غره سرته چې د افرایم په غرنۍ سیمه کې ؤ، پورته شو او ویې ویل: «یروبعامه او ټولو اسراییلیانو واورئ!"}, {"ref": "2 Chronicles 1:4", "text": "هغه د یهودا په خلکو باندې امر وکړ چې د څښتن یعنې د خپلو نیکونو د خدای عبادت وکړي او د هغه قوانینو او حکمونو ته غاړه کېږدي."}, {"ref": "2 Chronicles 1:4", "text": "خو د مصیبت په وخت کې به د اسراییلو څښتن خدای ته راګرځېدل. هغوی د خدای په لټه کې شول او هغه یې پیدا کړ."}, {"ref": "2 Chronicles 1:4", "text": "بنهدد پاچا د آسا غوښتنه ومنله او خپل قوماندانان او لښکرې یې ولېږلې چې د اسراییلو په ښارونو باندې حمله وکړي. هغوی عیون، دان، آبل‌مایم او د نفتالي ټول هغه ښارونه ونیول چې ګودامونه په کې وو."}, {"ref": "2 Chronicles 1:4", "text": "بلکې هغه د خپل پلار د خدای عبادت کاوه، د هغه حکمونه یې منل او د اسراییلو د پاچاهانو غلطه لاره یې غوره نه کړه."}, {"ref": "2 Chronicles 1:4", "text": "خو پرېږده چې لومړی د څښتن څخه پوښتنه وکړو.»"}, {"ref": "2 Chronicles 1:4", "text": "یهوشافاط په اورشلیم کې اوسېده، خو هغه به بیا بیا په جنوب کې له بیرشبع څخه نیولې، په شمال کې د افرایم تر غرنۍ سیمې پورې سفر کاوه. هغه د خلکو سره خبرې کولې او هغوی به یې راضي کول چې بېرته د خپلو نیکونو څښتن خدای ته رجوع وکړي."}, {"ref": "2 Chronicles 1:5", "text": "رحبعام په ځواب کې وویل: «په درېو ورځو کې بېرته راشئ او زه به ځواب درکړم.» نو خلک لاړل."}, {"ref": "2 Chronicles 1:5", "text": "رحبعام په اورشلیم کې پاتې شو او په یهودا کې یې څو ښارونه په نظامي کلاګانو بدل کړل، ترڅو د خپلې سیمې په دفاع کولو کې ورڅخه کار واخلي. په هغو کې دا ښارونه شامل وو:"}, {"ref": "2 Chronicles 1:5", "text": "شمعیه نبي رحبعام پاچا او د یهودا هغو مشرانو ته ورغی چې د شیشق څخه د تېښتې له امله په اورشلیم کې راټول شوي وو. شمعیه هغوی ته وویل: «ستاسو دپاره څښتن دا پیغام لري: ‹تاسو زه پرېښودم، نو زه هم اوس تاسو شیشق ته پرېږدم.›»"}, {"ref": "2 Chronicles 1:5", "text": "ایا تاسو نه پوهېږئ چې د اسراییلو څښتن خدای د داود او د هغه د اولادې سره د تل دپاره په اسراییلو باندې د پاچاهي کولو نه ماتېدونکی لوظ کړی دی؟"}, {"ref": "2 Chronicles 1:5", "text": "هغه د یهودا په ټولو ښارګوټو کې سیمه‌ییز عبادتځایونه او د خوشبویۍ د سوځولو ځایونه وران کړل. له دې امله د هغه د پاچاهۍ په وخت کې امن او ارامي وه."}, {"ref": "2 Chronicles 1:5", "text": "په هغه وخت کې هېچا نه شو کولای چې په امن سره تګ راتګ وکړي، ځکه چې په هر هېواد کې نا‌ارامي او ګډوډي وه."}, {"ref": "2 Chronicles 1:5", "text": "کله چې بعشا له دې څخه خبر شو، هغه د رامه ښار د قوي کولو نه لاس واخیست او کار یې بس کړ."}, {"ref": "2 Chronicles 1:5", "text": "نو څښتن هغه ته د یهودا په پاچاهۍ باندې ټینګ واک ورکړی ؤ. د یهودا ټولو خلکو یهوشافاط ته سوغاتونه راوړل او هغه ډېر شتمن او عزتمن شو."}, {"ref": "2 Chronicles 1:5", "text": "اخاب نبیان راوغوښتل چې څلور سوه تنه وو او د هغو څخه یې پوښتنه وکړه: «ایا مونږ په راموت باندې حمله وکړو که نه؟» نبیانو ځواب ورکړ: «هو، خدای به ستاسو سره مرسته وکړي چې هغوی ته ماتې ورکړئ.»"}, {"ref": "2 Chronicles 1:5", "text": "هغه د یهودا په هر قوي شوي ښار کې قاضیان وټاکل"}, {"ref": "2 Chronicles 1:6", "text": "بیا رحبعام د هغو سپین‌ږیرو سره مشوره وکړه چې د هغه د پلار سلیمان په ژوندانه کې یې د هغه خدمت کاوه. هغه پوښتنه وکړه: «تاسو څنګه مشوره راکوئ چې دې خلکو ته څه ځواب ووایم؟»"}, {"ref": "2 Chronicles 1:6", "text": "بیت‌لحم، عیتام، تقوع،"}, {"ref": "2 Chronicles 1:6", "text": "پاچا او مشرانو خپله ګناه ومنله او ویې ویل: «څښتن عادل دی.»"}, {"ref": "2 Chronicles 1:6", "text": "خو ای د نباط زویه یروبعامه، ته د داود د زوی سلیمان درباري وې او تا د خپل بادار په وړاندې سرکښي وکړه."}, {"ref": "2 Chronicles 1:6", "text": "د آسا د پاچاهۍ په وخت کې د یهودا په سیمه کې ارامي وه. په هغه وخت کې هغه په یهودیه کې قوي ښارونه جوړ کړل او څو کاله هلته جنګ نه ؤ، ځکه چې څښتن هغوی ته ارامي ورکړې وه."}, {"ref": "2 Chronicles 1:6", "text": "یو قوم به په بل قوم باندې او یو ښار به په بل ښار باندې ظلم او تېری کاوه، نو ځکه خدای هغوی په هر ډول مصیبت او کړاو اخته کړل."}, {"ref": "2 Chronicles 1:6", "text": "بیا آسا پاچا د ټولې یهودا څخه سړي راټول کړل او په هغوی باندې یې هغه تیږې او تیرونه یووړل چې بعشا په رامه کې ورڅخه کار اخیست او هغوی دا د جبع او مصفه د ښارونو په قوي کولو کې ولګول."}, {"ref": "2 Chronicles 1:6", "text": "یهوشافاط په پوره توګه څښتن ته وفادار پاتې شو. برسېره پردې هغه په یهودا کې سیمه‌ییز عبادتځایونه او د اشیره بتان له منځه یووړل."}, {"ref": "2 Chronicles 1:6", "text": "خو یهوشافاط پوښتنه وکړه: «ایا دلته کوم بل نبي نشته چې د هغه په وسیله مونږ د څښتن سره مشوره وکړو؟»"}, {"ref": "2 Chronicles 1:6", "text": "او هغوی ته یې دا لارښوونې وکړې: «په قضاوت کولو کې غور کوئ، ځکه چې تاسو د انسان په خاطر نه بلکې د څښتن په خاطر قضاوت کوئ. کله چې تاسو قضاوت کوئ څښتن ستاسو سره مل دی."}, {"ref": "2 Chronicles 1:7", "text": "هغوی ځواب ورکړ: «که چېرې تاسو د دې خلکو سره نېکي وکړئ او هغوی ته داسې ځواب ورکړئ چې خوشحاله شي، نو هغوی به تل ستاسو خدمتګاران وي.»"}, {"ref": "2 Chronicles 1:7", "text": "بیت‌صور، سوکوه، عدولام،"}, {"ref": "2 Chronicles 1:7", "text": "کله چې څښتن دا ولیدل، شمعیه ته یې وویل: «له دې امله چې هغوی اوس خپله ګناه ومنله، زه به هغوی ټول تباه نه کړم. نو کله چې شیشق حمله وکړي، زه به یو شمېر کسان وژغورم. زما غضب به د شیشق په وسیله په اورشلیم باندې نازل نه شي."}, {"ref": "2 Chronicles 1:7", "text": "وروسته یوه ډله بدمعاشان ستا شاوخوا راټول شول او د سلیمان زوی رحبعام تاسو مجبور کړ چې خبره مو ومني. هغه یو نوی ځوان او ډېر بې‌تجربه ؤ، نو ځکه یې ونه شو کولای چې ستاسو په وړاندې مقاومت وکړي."}, {"ref": "2 Chronicles 1:7", "text": "هغه د یهودا خلکو ته وویل: «راځئ چې د دې ښارونو دپاره دېوالونه او د څارنې برجونه جوړ کړو او داسې دروازې ورته جوړې کړو چې په اړمونو بندیږي. دا هېواد تر‌اوسه پورې زمونږ دی، ځکه چې مونږ خپل څښتن خدای ته رجوع کړې ده. هغه د ټولو دښمنانو څخه په ارامۍ کې ساتلي یو.» خلکو ښارونه اباد کړل او نېکمرغه شول."}, {"ref": "2 Chronicles 1:7", "text": "خو تاسو تکړه او زړور اوسئ او بې‌حوصلې کېږئ مه. بیا چې تاسو کوم کار کوئ، تاسو ته به د هغې اجر درکول کیږي.»"}, {"ref": "2 Chronicles 1:7", "text": "په هغه وخت کې حناني نبي آسا ته ورغی او ورته ویې ویل: «تا د خپل څښتن خدای په ځای د سوریې په پاچا باندې تکیه کړې ده. اوس د سوریې لښکرې ستا له لاسه وتلې دي."}, {"ref": "2 Chronicles 1:7", "text": "هغه د خپلې پاچاهۍ په درېم کال د یهودا ښارونو ته د زده کړې دپاره دا لاندې مامورین ولېږل: بنحاییل، عوبدیا، زکریا، نتنییل او میکایا."}, {"ref": "2 Chronicles 1:7", "text": "د اسراییلو پاچا ځواب ورکړ: «دلته یو بل نبي هم شته، یعنې د یمله زوی میکایا. خو زه د هغه څخه کرکه لرم، ځکه چې هغه هېڅکله زما په هکله ښه پېشګویي نه کوي او تل بده پېشګویي کوي.» یهوشافاط ځواب ورکړ: «پاچا دې داسې خبره نه کوي.»"}, {"ref": "2 Chronicles 1:7", "text": "نو بیا د څښتن څخه ووېرېږئ او په احتیاط او پام سره قضاوت کوئ، ځکه چې څښتن زمونږ خدای بې‌انصافي، طرفداري کول یا رشوت اخیستل بد ګڼي.»"}, {"ref": "2 Chronicles 1:8", "text": "خو رحبعام د هغو سپین‌ږیرو مشوره ونه منله او د هغو ځوانانو سره یې مشوره وکړه چې د هغه سره لوی شوي وو او د هغه خدمت یې کاوه."}, {"ref": "2 Chronicles 1:8", "text": "جت، مریشه، زیف،"}, {"ref": "2 Chronicles 1:8", "text": "خو هغوی به د شیشق رعیت شي، ترڅو وپوهیږي چې زما د خدمت کولو او د نړۍ د حاکمانو د خدمت کولو ترمنځ څومره فرق دی.»"}, {"ref": "2 Chronicles 1:8", "text": "اوس تاسو فکر کوئ چې د هغې پاچاهۍ په ضد جنګېدلی شئ چې څښتن د داود اولادې ته ورکړې ده. تاسو یو لوی لښکر لرئ او هماغه د سرو زرو سخوندران چې یروبعام جوړ کړل چې ستاسو خدایان شي."}, {"ref": "2 Chronicles 1:8", "text": "آسا یو لوی لښکر درلود: د هغوی څخه درې سوه زره تنه د یهودا د قبیلې څخه وو او لوی سپرونه او نېزې ورسره وې. دوه لکه او اتیا زره تنه د بنیامین د قبیلې څخه وو او کوچني سپرونه او لیندې ورسره وې. هغوی ټول زړور جنګیالي وو."}, {"ref": "2 Chronicles 1:8", "text": "کله چې آسا د عودید د زوی عزریا پېشګویي واورېدله، نو هغه زړور شو. هغه ټول هغه بتان لېرې کړل چې د یهودا او د بنیامین په خاوره کې وو او همدارنګه هغه بتان چې په هغو ښارونو کې وو چې هغه د افرایم په غرنۍ سیمه کې نیولي وو. هغه د څښتن د قربانۍ ځای هم بېرته جوړ کړ چې د هغه د کور د برنډې په مخکې ؤ."}, {"ref": "2 Chronicles 1:8", "text": "په یاد دې دي چې د ایتوپیایانو او د لیبیایانو لښکرې چې زیات شمېر جنګي ګاډۍ او اس سواران یې درلودل، څومره زورورې وې؟ خو هغه وخت تا په څښتن باندې توکل وکړ چې مرسته درسره وکړي او هغوی ته دې ماتې ورکړه."}, {"ref": "2 Chronicles 1:8", "text": "د هغوی سره نهه لاویان او دوه کاهنان لاړل. لاویان دا وو: شمعیه، نتنیا، زبدیا، عساهیل، شمیراموت، یهوناتان، ادونیا، طوبیا او طوب‌ادونیا. کاهنان دا وو: الیشمع او یهورام."}, {"ref": "2 Chronicles 1:8", "text": "بیا د اسراییلو پاچا یو درباري راوغوښت او ورته ویې ویل: «لاړ شه او زر میکایا زما حضور ته راوله!»"}, {"ref": "2 Chronicles 1:8", "text": "یهوشافاط په اورشلیم کې هم ځینې لاویان، کاهنان او د کورنیو مشران وټاکل چې د څښتن په خاطر قضاوت وکړي او د اورشلیم د اوسېدونکو شخړې حل کړي."}, {"ref": "2 Chronicles 1:9", "text": "د هغوی څخه یې پوښتنه وکړه: «ستاسو مشوره څه ده؟ دې خلکو ته څه ځواب ووایم چې ماته وایي: هغه بار چې ستاسو پلار زمونږ په اوږو ایښی دی، زمونږ څخه سپک کړه؟»"}, {"ref": "2 Chronicles 1:9", "text": "ادورایم، لاخیش، عزیقه،"}, {"ref": "2 Chronicles 1:9", "text": "شیشق پاچا په اورشلیم باندې حمله وکړه او هغه د څښتن د کور او د شاهي ماڼۍ ټولې خزانې د ځان سره یووړلې. برسېره پردې هغه سپرونه یې چې سلیمان د سرو زرو څخه جوړ کړي وو، هم یووړل."}, {"ref": "2 Chronicles 1:9", "text": "تاسو لاویان او د څښتن کاهنان یعنې د هارون اولاده وشړله. د هغوی په ځای تاسو د نورو قومونو په شان کاهنان وټاکل. هرڅوک چې د یو غویي یا د اووه پسونو سره راشي، کولای شي چې خپل ځان ستاسو د تش په نامه خدایانو د یو کاهن په توګه سپېڅلی کړي."}, {"ref": "2 Chronicles 1:9", "text": "زارح ایتوپیایي د یو میلیون کسیزه لښکر او درې سوه جنګي ګاډیو سره په یهودا باندې حمله وکړه او تر مریشه پورې یې پرمختګ وکړ."}, {"ref": "2 Chronicles 1:9", "text": "آسا د یهودا او د بنیامین ټول خلک او همدارنګه د افرایم، منسي او د شمعون د سیمو خلک چې د هغوی سره په یهودا کې اوسېدل، راوغوښتل. د دې خلکو زیات شمېر د آسا پلویان شوي وو، ځکه چې هغوی لیدلي وو چې د هغه څښتن خدای د هغه سره مل دی."}, {"ref": "2 Chronicles 1:9", "text": "څښتن په ځیر سره ټولې نړۍ ته ګوري او هغو خلکو ته قوت ورکوي چې هغه ته وفادار دي. تا د کم عقلتوب کار کړی دی، نو له دې څخه وروسته به تل په جګړه کې یې.»"}, {"ref": "2 Chronicles 1:9", "text": "هغوی د څښتن د تورات کتاب واخیست او د یهودا په ټولو ښارونو کې ګرځېدل او خلکو ته یې تعلیم ورکاوه."}, {"ref": "2 Chronicles 1:9", "text": "اخاب او یهوشافاط دواړو خپل شاهانه کالي اغوستي وو او د سامرې د دروازې تر‌څنګ په درمند ځای کې په خپلو تختونو باندې ناست وو. ټولو نبیانو د هغوی په حضور کې پېشګویانې کولې."}, {"ref": "2 Chronicles 1:9", "text": "یهوشافاط هغوی ته دا لاندېنۍ لارښوونې ورکړې: «تاسو باید خپل کارونه په وفادارۍ او د زړه له کومي د څښتن څخه په وېره کې تر‌سره کړئ."}, {"ref": "2 Chronicles 1:10", "text": "هغو ځوانانو په ځواب کې وویل: «هغو خلکو ته داسې ځواب ورکړئ: ‹زما کوچنۍ ګوته زما د پلار د ملا څخه پنډه ده."}, {"ref": "2 Chronicles 1:10", "text": "زرعه، ایالون او حبرون. دا د یهودا او د بنیامین قوي ښارونه دي."}, {"ref": "2 Chronicles 1:10", "text": "نو رحبعام د هغو په ځای برنجي سپرونه جوړ کړل او هغه یې د هغو ساتونکو قوماندانانو ته وسپارل چې د شاهي ماڼۍ په دروازه کې یې پهره کوله."}, {"ref": "2 Chronicles 1:10", "text": "خو څښتن زمونږ خدای دی. مونږ د هغه څخه مخ نه دی اړولی! کاهنان چې د هارون اولاده ده د څښتن خدمت کوي او لاویان د هغوی سره مرسته کوي."}, {"ref": "2 Chronicles 1:10", "text": "آسا حرکت وکړ چې د هغه سره وجنګیږي او دواړه خواوې مریشه ته نژدې د صفاته په دره کې، ځای په ځای شوې."}, {"ref": "2 Chronicles 1:10", "text": "د آسا د پاچاهۍ د پنځلسم کال په درېمه میاشت هغوی په اورشلیم کې راټول شول."}, {"ref": "2 Chronicles 1:10", "text": "کله چې آسا دا خبرې واورېدلې، هغه دومره په نبي باندې په قهر شو چې حناني یې په زندان کې واچاوه. د هماغه وخت نه آسا په ځینو خلکو باندې خپل ظلمونه پیل کړل."}, {"ref": "2 Chronicles 1:10", "text": "د یهودا په شاوخوا پاچاهیو باندې د څښتن وېره راغله، نو د هغوی څخه هېچا په یهوشافاط باندې حمله ونه کړه."}, {"ref": "2 Chronicles 1:10", "text": "د کنعنه زوی صدقیا چې د نبیانو د ډلې څخه ؤ د خپل ځان دپاره د اوسپنې څخه ښکرونه جوړ کړي وو، ویې ویل: «ای اخابه، څښتن وایي چې ته به د دې ښکرونو په وسیله په سوریایانو باندې حمله وکړې او هغوی به له منځه یوسې.»"}, {"ref": "2 Chronicles 1:10", "text": "هرکله چې ستاسو وطنداران د هر ښار څخه تاسو ته د قتل یا د یو قانون یا د امر د ماتولو یوه دعوه راوړي، تاسو باید خلکو ته خبرداری ورکړئ چې د څښتن په وړاندې ګناه ونه کړي، ترڅو هغه په قهر نه شي او تاسو او ستاسو وطندارانو ته سزا ورنه کړي. یاد ساتئ، که چېرې د دې لارښوونو څخه پیروي وکړئ، نو تاسو به مجرم او ګناهکار نه ګڼل کېږئ."}, {"ref": "2 Chronicles 1:11", "text": "زما پلار په تاسو باندې دروند بار ایښی ؤ، زه به هغه نور هم دروند کړم. زما پلار تاسو په قمچینو باندې وهلئ، زه به تاسو په اغزي لرونکو قمچینو باندې ووهم.›»"}, {"ref": "2 Chronicles 1:11", "text": "هغه هر یو ښار ته د لښکرو یو یو قوماندان ورکړ او په ښارونو کې یې خواړه، د زیتونو تېل او د انګورو شراب ذخیره کړل."}, {"ref": "2 Chronicles 1:11", "text": "هرکله به چې پاچا د څښتن کور ته ورتللو، نو ساتونکو به سپرونه وړل او وروسته به یې بېرته د پهره‌دارانو کوټې ته راوړل."}, {"ref": "2 Chronicles 1:11", "text": "هغوی هر سهار او ماښام څښتن ته سوځېدونکې نذرانې وړاندې کوي او خوشبویي ورته سوځوي. هغوی سپېڅلې ډوډۍ په یو داسې مېز باندې ږدي چې پاک شوی وي او هر ماښام د سرو زرو په څراغدان باندې څراغونه بلوي. مونږ د خپل څښتن خدای د حکمونو پیروي کوو، خو تاسو ورڅخه مخ اړولی دی!"}, {"ref": "2 Chronicles 1:11", "text": "آسا خپل څښتن خدای ته زاري وکړه او ویې ویل: «ای څښتنه، یوازې ته د یو کمزوري لښکر سره مرسته کولای شې چې یو قوي لښکر ته ماتې ورکړي. ای زمونږ څښتن خدایه، مونږ ستا په مرستې باندې تکیه کوو. مونږ ستا په نوم د دې قوي لښکر سره د جنګ دپاره راغلي یو او مونږ پوهېږو چې ته به ماتې نه خورې. ته زمونږ څښتن خدای یې.»"}, {"ref": "2 Chronicles 1:11", "text": "په هماغه ورځ هغوی د هغه غنیمت څخه چې د ځان سره یې راوړی ؤ، څښتن ته اووه سوه غویان او اووه زره پسونه قرباني کړل."}, {"ref": "2 Chronicles 1:11", "text": "آسا چې د خپلې پاچاهۍ په وخت کې له پیل نه تر پایه پورې هرڅه وکړل هغه د یهودا او د اسراییلو د پاچاهانو د تاریخ په کتاب کې لیکل شوي دي."}, {"ref": "2 Chronicles 1:11", "text": "ځینو فلسطینیانو د باج په توګه هغه ته سپین زر او نور سوغاتونه راوړل. عربانو هغه ته اووه زره اووه سوه پسونه او په همدې شمېر سېرلي راوړل."}, {"ref": "2 Chronicles 1:11", "text": "ټولو نبیانو دا ومنله چې اخاب دې په راموت کې په سوریایانو باندې حمله وکړي او دا یې هم وویل چې څښتن به د هغه سره مرسته کوي چې هغوی ته ماتې ورکړي."}, {"ref": "2 Chronicles 1:11", "text": "لوی کاهن یعنې امریا به په هره شرعي دعوه کې وروستنۍ پرېکړه کوي او د اسماعیل زوی زبدیا یعنې د یهودا د قبیلې مشر به په نورو ټولو دعوو کې وروستنۍ پرېکړه کوي. پاتې لاویان به د محکمې د مامورینو په توګه ستاسو خدمت کوي. زړور اوسئ او په دغو لارښوونو باندې عمل وکړئ او څښتن دې د هغه چا سره مل شي چې د حق طرفدار وي!»"}, {"ref": "2 Chronicles 1:12", "text": "لکه څنګه چې رحبعام پاچا ویلي وو، درې ورځې وروسته یروبعام او ټول خلک هغه ته بېرته راغلل."}, {"ref": "2 Chronicles 1:12", "text": "دغه ښارونه یې په سپرونو او نېزو باندې سمبال کړل او په دې ډول یې هغه قوي کړل او د یهودا او بنیامین قبیلې یې د خپل واک لاندې وساتلې."}, {"ref": "2 Chronicles 1:12", "text": "څرنګه چې رحبعام خپله ګناه ومنله، نو د څښتن د غضب نه یې خلاصون پیدا کړ او په پوره توګه له منځه لاړ نه شو او په یهودا کې څه ناڅه نېک کارونه کېدل."}, {"ref": "2 Chronicles 1:12", "text": "په خپله خدای زمونږ مشر او لارښود دی او د هغه کاهنان د سرنیو سره دلته دي، هغوی تیار دي چې سرني وغږوي، ترڅو مونږ ستاسو په خلاف جګړې ته راوغواړي. ای د اسراییلو خلکو! د څښتن یعنې د خپلو نیکونو د خدای په خلاف مه جنګېږئ! تاسو دا جګړه نه شئ ګټلی!»"}, {"ref": "2 Chronicles 1:12", "text": "نو څښتن د ایتوپیایانو لښکرو ته د آسا او یهودا د لښکرو په لاس ماتې ورکړه او هغوی وتښتېدل."}, {"ref": "2 Chronicles 1:12", "text": "هغوی لوظ وکړ او دا خبره یې ومنله چې د زړه له کومي او په ټول ځان به د خپلو نیکونو د څښتن خدای عبادت کوي."}, {"ref": "2 Chronicles 1:12", "text": "آسا د خپلې پاچاهۍ په نهه دېرشم کال د پښو په یوې سختې ناروغۍ اخته شو. خو حتی په هغه وخت کې هم د مرستې دپاره هغه څښتن ته نه، بلکې ډاکترانو ته رجوع وکړه."}, {"ref": "2 Chronicles 1:12", "text": "نو یهوشافاط نور هم د قدرت خاوند شو. هغه په یهودا کې کلاګانې او د ګودامونو دپاره ښارونه ودان کړل"}, {"ref": "2 Chronicles 1:12", "text": "په همدې وخت کې هغه استازی چې د میکایا پسې تللی ؤ، هغه ته یې وویل: «ای میکایا، ټولو نبیانو د اخاب دپاره د بریالیتوب پېشګویي وکړه، اوس لاړ شه او د هغو خبره تایید کړه.»"}, {"ref": "2 Chronicles 1:13", "text": "پاچا د سپین‌ږیرو د مشورې پروا ونه ساتله او خلکو ته یې ډېر سخت ځواب ورکړ."}, {"ref": "2 Chronicles 1:13", "text": "کاهنانو او لاویانو د اسراییلو هغه ټول ځایونه چې په کې اوسېدل پرېښودل، ترڅو د رحبعام څخه ملاتړ وکړي."}, {"ref": "2 Chronicles 1:13", "text": "رحبعام پاچا په اورشلیم کې خپل ځان ټینګ کړ او پاچاهي یې وکړه. هغه د یو څلوېښت کلنۍ په عمر پاچا شو او په اورشلیم کې یې اوولس کاله پاچاهي وکړه. اورشلیم هغه ښار ؤ چې څښتن هغه د اسراییلو د ټولو قبیلو څخه د خپل عبادت دپاره غوره کړی ؤ. د رحبعام د مور نوم نعمه وه چې د عمون د هېواد څخه وه."}, {"ref": "2 Chronicles 1:13", "text": "خو په داسې حال کې چې ابیا خبرې کولې، یروبعام خپل ځینې عسکر پټ ولېږل چې د شا له خوا د یهودا په لښکرو باندې حمله وکړي او پاتې کسان د مخې له خوا ورباندې راغلل."}, {"ref": "2 Chronicles 1:13", "text": "بیا آسا او د هغه عسکرو هغوی تر جرار پورې تعقیب کړل. دومره ډېر ایتوپیایان ووژل شول چې د هغوی لښکر ونه شو کولای چې بېرته سره یوځای شي او وجنګیږي. څښتن او د هغه لښکر هغوی تباه کړل او هغوی په زیاته اندازه غنیمت ونیوه."}, {"ref": "2 Chronicles 1:13", "text": "هرچا، ځوان او زوړ، نارینه او ښځې چې د هغه عبادت به یې نه کاوه، هغه به وژل کېده."}, {"ref": "2 Chronicles 1:13", "text": "دوه کاله وروسته هغه مړ شو."}, {"ref": "2 Chronicles 1:13", "text": "چې هغه په کې په لوی شمېر ذخیرې ساتلې وې. هغه په اورشلیم کې یو شمېر زړور او تکړه عسکر هم وساتل چې"}, {"ref": "2 Chronicles 1:13", "text": "خو میکایا ځواب ورکړ: «زه د ژوندي څښتن په نوم قسم خورم هرڅه چې زما خدای وایي، زه به هماغه پاچا ته ووایم.»"}, {"ref": "2 Chronicles 1:14", "text": "هغه د هغو ځوانانو مشوره ومنله او ویې ویل: «زما پلار په تاسو باندې دروند بار ایښی ؤ، زه به هغه نور هم دروند کړم. زما پلار تاسو په قمچینو وهلئ، زه به تاسې په اغزي لرونکو قمچینو باندې ووهم.»"}, {"ref": "2 Chronicles 1:14", "text": "څرنګه چې یروبعام او د هغه زامنو، لاویان د څښتن د کاهنانو په توګه د خپلو دندو څخه لېرې کړل، لاویانو په اسراییلو کې خپل جایداد او څړځایونه پرېښودل او اورشلیم او د یهودا نورو ځایونو ته یې کډه وکړه."}, {"ref": "2 Chronicles 1:14", "text": "هغه بد کارونه کول، ځکه چې هغه کوښښ نه کاوه د څښتن رضا معلومه کړي."}, {"ref": "2 Chronicles 1:14", "text": "د یهودا لښکرو ولیدل چې د مخې او د شا له خوا په هغوی باندې حمله روانه ده. نو هغوی څښتن ته د مرستې په خاطر زارۍ وکړلې او کاهنانو سرني وغږول."}, {"ref": "2 Chronicles 1:14", "text": "هغوی وکولای شول چې د جرار د شاوخوا سیمو ښارونه له منځه یوسي، ځکه چې څښتن په دغو خلکو باندې وېره راوستې وه. له دې امله چې دې ښارونو ډېر غنیمت درلود، نو د آسا لښکرو دا ټول لوټ کړل."}, {"ref": "2 Chronicles 1:14", "text": "هغوی په لوړ اواز سره سرني وغږول او د څښتن په نوم یې قسم وخوړ چې په خپل لوظ به ودریږي."}, {"ref": "2 Chronicles 1:14", "text": "هغوی د هغه په مړي باندې ډول ډول خوشبویي او عطرونه لګولي وو او د هغه د درنښت دپاره یې یو ډېر لوی اور بل کړ. هغه د داود په ښار کې په هغه قبر کې ښخ شو چې هغه د خپل ځان دپاره جوړ کړی ؤ."}, {"ref": "2 Chronicles 1:14", "text": "د خپلو طایفو له مخې راټول شوي وو. د یهودا د طایفو څخه: ادنه د زر کسیزو ډلو لومړنی قوماندان ؤ او درې سوه زره عسکر د هغه تر قوماندې لاندې وو."}, {"ref": "2 Chronicles 1:14", "text": "بیا میکایا اخاب ته ورغی او اخاب ورڅخه پوښتنه وکړه: «ای میکایا، ایا مونږ راموت ته د جګړې دپاره لاړ شو یا نه؟» میکایا ځواب ورکړ: «حمله ورباندې وکړئ، تاسو به بریالي شئ. هغوی به تاسو ته تسلیم شي.»"}, {"ref": "2 Chronicles 1:15", "text": "نو په دې ډول پاچا د خلکو غوښتنه ونه منله، ځکه چې په دې کې د خدای رضا وه، ترڅو هغه خبره سرته ورسیږي چې څښتن د اخیا نبي په وسیله چې د شیلوه څخه ؤ، د نباط زوی یروبعام ته کړې وه."}, {"ref": "2 Chronicles 1:15", "text": "یروبعام خپل کاهنان غوره کړل چې د اسراییلو په سیمه‌ییزو عبادتځایونو کې، یعنې هغو ځایونو کې چې د سخوندرانو او د وزو بتان هم وو، خدمت وکړي."}, {"ref": "2 Chronicles 1:15", "text": "رحبعام چې د خپلې پاچاهۍ په وخت کې نور هرڅه وکړل د هغه د کورنۍ د نسب‌نامې په شمول د دوو نبیانو یعنې د شمعیه او د عیدو په تاریخ کې لیکل شوي دي. په دې ټوله موده کې د رحبعام او یروبعام ترمنځ جګړه وه."}, {"ref": "2 Chronicles 1:15", "text": "د یهودا لښکرو په لوړ اواز چیغه ووهله او کله چې هغوی چیغه ووهله، نو بیا ابیا او د هغه لښکرو حمله وکړه او خدای یروبعام او د اسراییلو لښکرو ته ماتې ورکړه."}, {"ref": "2 Chronicles 1:15", "text": "هغوی په هغو کمپونو باندې هم حمله وکړه چې شپانه په کې اوسېدل او ډېر پسونه، وزې او اوښان یې ونیول. بیا هغوی بېرته اورشلیم ته راستانه شول."}, {"ref": "2 Chronicles 1:15", "text": "د یهودا ټول خلک خوشحاله وو، ځکه چې هغوی د زړه له کومي دا لوظ کړی ؤ. هغوی په شوق سره د څښتن عبادت کاوه او څښتن هغوی قبول کړل او هغوی ته یې د هرې خوا نه سوله ور په برخه کړه."}, {"ref": "2 Chronicles 1:15", "text": "یهوحانان دوهم قوماندان ؤ او دوه سوه اتیا زره عسکر یې د قوماندې لاندې وو."}, {"ref": "2 Chronicles 1:15", "text": "خو پاچا میکایا ته وویل: «څو ځلې باید زه تاته قسم درکړم چې یوازې هغه څه راته ووایه چې څښتن ویلي دي؟»"}, {"ref": "2 Chronicles 1:16", "text": "کله چې ټولو اسراییلیانو ولیدل چې پاچا د هغوی خبره ونه منله، هغوی چیغې ووهلې: «مونږ باید د داود د کورنۍ سره وفادار پاتې نه شو. زمونږ دپاره د داود په کورنۍ کې څه نشته. ای د اسراییلو خلکو، ځئ چې خپلو کورونو ته لاړ شو! پرېږدئ چې رحبعام په خپلو خلکو باندې پاچاهي وکړي.» نو ټول اسراییلیان خپلو کورونو ته لاړل."}, {"ref": "2 Chronicles 1:16", "text": "د اسراییلو د ټولو قبیلو څخه هغه خلک چې په اخلاص سره یې غوښتل د اسراییلو د څښتن خدای عبادت وکړي، لاویانو پسې اورشلیم ته لاړل، ترڅو وکولای شي چې د خپلو نیکونو څښتن خدای ته قربانۍ وړاندې کړي."}, {"ref": "2 Chronicles 1:16", "text": "رحبعام مړ شو او د داود د ښار په شاهي هدیره کې ښخ شو. د رحبعام زوی ابیا د هغه په ځای پاچا شو."}, {"ref": "2 Chronicles 1:16", "text": "اسراییلیان وتښتېدل او خدای هغوی د یهودا د لښکرو په لاس تسلیم کړل."}, {"ref": "2 Chronicles 1:16", "text": "آسا پاچا حتی خپله نیا معکه د ملکې د مور په توګه د خپل مقام څخه لېرې کړه، ځکه چې هغې د اشیره د کرکې وړ بت جوړ کړی ؤ. آسا هغه بت رانسکور کړ، هغه یې ټوټې ټوټې کړ او ټوټې یې د قدرون په دره کې وسوځولې."}, {"ref": "2 Chronicles 1:16", "text": "د زکري زوی عمسیا چې په خپله خوښه د څښتن خدمت کاوه، هغه درېم قوماندان ؤ او دوه سوه زره عسکر یې تر لاس لاندې وو."}, {"ref": "2 Chronicles 1:16", "text": "میکایا ځواب ورکړ: «ما ولیدل چې اسراییلي عسکر د هغو پسونو په شان دي چې په غونډیو کې اخوا دې خوا ګرځي او شپون نه لري. څښتن وویل: دغه لښکر مشر نه لري. نو پرېږده چې هغوی په خیر سره خپلو کورونو ته لاړ شي.»"}, {"ref": "2 Chronicles 1:17", "text": "رحبعام یوازې په هغو خلکو باندې پاچاهي کوله چې د یهودا په ښارګوټو کې اوسېدل."}, {"ref": "2 Chronicles 1:17", "text": "په دې کار باندې هغوی د یهودا پاچاهي قوي کړه او هغوی درې کاله د سلیمان د زوی رحبعام څخه ملاتړ وکړ، ځکه چې په دې دوران کې هغوی د داود او د سلیمان لاره غوره کړه."}, {"ref": "2 Chronicles 1:17", "text": "ابیا او د هغه لښکر هغوی ته درانه زیانونه ورواړول او د اسراییلو پنځه سوه زره تر ټولو غوره شوي عسکر ووژل شول."}, {"ref": "2 Chronicles 1:17", "text": "که څه هم آسا د اسراییلو سیمه‌ییز عبادتځایونه له منځه یو نه وړل، خو هغه ټول عمر څښتن ته وفادار پاتې شو."}, {"ref": "2 Chronicles 1:17", "text": "د بنیامین د طایفو څخه: لومړنی قوماندان یې الیاداع، یو زړور جنګیالی ؤ. دوه سوه زره عسکر د هغه د قوماندې لاندې وو چې ټولو سره لیندې او سپرونه وو."}, {"ref": "2 Chronicles 1:17", "text": "اخاب، یهوشافاط ته وویل: «ما تاته ونه ویل چې هغه به زما په هکله هېڅکله ښه پېشګویي ونه کړي، هغه یوازې بده پېشګویي کوي؟»"}, {"ref": "2 Chronicles 1:18", "text": "بیا رحبعام پاچا د بېګار د کارونو مسوول ادورام اسراییلیانو ته ولېږه، خو د اسراییلو خلکو هغه سنګسار کړ او ویې واژه. خو رحبعام په بیړه په خپلې جنګي ګاډۍ کې سپور شو او اورشلیم ته وتښتېد."}, {"ref": "2 Chronicles 1:18", "text": "رحبعام د داود د زوی یعنې یریموت د لور محلت سره واده وکړ چې مور یې ابیحایل وه چې د الیاب لور او د یسي لمسۍ وه."}, {"ref": "2 Chronicles 1:18", "text": "په هغه وخت کې اسراییلیانو ماتې وخوړله او د یهودا لښکرې بریالۍ شوې، ځکه چې هغوی د خپلو نیکونو په څښتن خدای باندې توکل وکړ."}, {"ref": "2 Chronicles 1:18", "text": "هغه د خدای په کور کې سره زر او سپین زر او نور ټول شیان کېښودل چې هغه او د هغه پلار خدای ته وقف کړي وو."}, {"ref": "2 Chronicles 1:18", "text": "دوهم قوماندان یې یهوزاباد ؤ او یو سلو اتیا زره تنه وسله‌وال عسکر یې د قوماندې لاندې وو."}, {"ref": "2 Chronicles 1:18", "text": "میکایا په ځواب کې وویل: «واورئ چې څښتن نور څه وویل! څښتن مې په اسمان کې ولیده چې په خپل تخت باندې ناست ؤ او ټولې فرښتې د هغه ښي او چپ اړخ ته ولاړې وې."}, {"ref": "2 Chronicles 1:19", "text": "نو د اسراییلو شمالي قبیلو د هغې ورځې نه وروسته د داود د شاهي کورنۍ په وړاندې یاغیتوب پیل کړ."}, {"ref": "2 Chronicles 1:19", "text": "د رحبعام او د محلت درې زامن پیدا شول چې دا یې نومونه وو: یعوش، شمریا او زهم."}, {"ref": "2 Chronicles 1:19", "text": "ابیا د یروبعام لښکرې تعقیب کړې او د اسراییلو ښارګوټي یې د یروبعام څخه ونیول، یعنې بیت‌ییل، یشانه او عفرون د هغو د شاوخوا کلیو سره."}, {"ref": "2 Chronicles 1:19", "text": "د آسا د پاچاهۍ تر پنځه دېرشم کاله پورې هلته نوره هېڅ جګړه ونه شوه."}, {"ref": "2 Chronicles 1:19", "text": "دغو عسکرو په اورشلیم کې د پاچا خدمت کاوه او برسېره پردې پاچا په ټوله سیمه کې نور عسکر هم درلودل چې د یهودا په قوي شویو ښارونو کې یې ځای په ځای کړي وو."}, {"ref": "2 Chronicles 1:19", "text": "څښتن پوښتنه وکړه: ‹څوک کولای شي چې اخاب د اسراییلو پاچا وغولوي چې هغه راموت ته لاړ شي او هلته ووژل شي؟› یو څو فرښتو یوه خبره او نورو بله خبره کوله."}, {"ref": "2 Chronicles 1:20", "text": "بیا رحبعام د ابشالوم د لور معکې سره واده وکړ. ابیا، عتای، زیزا او شلومیت د هغوی اولادونه وو."}, {"ref": "2 Chronicles 1:20", "text": "د ابیا د پاتې پاچاهۍ په دوران کې یروبعام هېڅکله خپل قوت بېرته تر‌لاسه نه کړ. څښتن یروبعام وواهه او هغه مړ شو،"}, {"ref": "2 Chronicles 1:20", "text": "نو په پای کې یوه ارواح رامخکې شوه، د څښتن په مخکې ودرېدله او هغه ته یې وویل: ‹زه کولای شم چې اخاب وغولوم.› څښتن ورڅخه پوښتنه وکړه: ‹څنګه؟›"}, {"ref": "2 Chronicles 1:21", "text": "رحبعام اتلس ښځې او شپېته وینځې درلودلې او د اته ویشتو زامنو او د شپېتو لورګانو پلار ؤ. رحبعام ته د خپلو ټولو ښځو او وینځو څخه معکه ډېره ګرانه وه،"}, {"ref": "2 Chronicles 1:21", "text": "خو ابیا نور هم قوي شو. هغه څوارلس ښځې، دوه ویشت زامن او شپاړس لورګانې درلودلې."}, {"ref": "2 Chronicles 1:21", "text": "ارواح ځواب ورکړ: ‹زه به د اخاب په ټولو نبیانو باندې دروغ ووایم.› څښتن ځواب ورکړ: ‹ښه ده. اوس لاړه شه او هغه وغولوه. ته به بریالی شې.›"}, {"ref": "2 Chronicles 1:22", "text": "نو هغه ابیا د معکه زوی د خپلو زامنو مشر وټاکه، ترڅو د هغه څخه وروسته پاچا شي."}, {"ref": "2 Chronicles 1:22", "text": "د ابیا د پاچاهۍ نورې پېښې چې په هغو کې د هغه خبرې او کارونه شامل دي د عیدو نبي په تاریخ کې لیکل شوي دي."}, {"ref": "2 Chronicles 1:22", "text": "ای اخابه! کټ مټ هماغسې وشول. څښتن ستا نبیان دې ته مجبور کړل چې تاته دروغ ووایي، ځکه د څښتن اراده دا ده چې ستا په سر باندې بلا راشي.»"}, {"ref": "2 Chronicles 1:23", "text": "رحبعام په عاقلانه ډول خپلو زامنو ته مسوولیتونه وروسپارل او د یهودا او د بنیامین په قوي ښارونو کې یې هغوی ځای په ځای کړل. هغوی ته یې پرېمانه خوراکي شیان ورکړل او ډېرې ښځې یې ورته وکړې."}, {"ref": "2 Chronicles 1:23", "text": "بیا د کنعنه زوی صدقیا، میکایا ته نژدې شو، په څپېړه یې وواهه او پوښتنه یې ترې وکړه: «کله د څښتن روح زما څخه تللی دی او ستا سره یې خبرې کړې دي؟»"}, {"ref": "2 Chronicles 1:24", "text": "میکایا ځواب ورکړ: «په هغه ورځ به په دې باندې پوه شې چې د یو کور په دنننۍ کوټه کې پټ شې.»"}, {"ref": "2 Chronicles 1:25", "text": "اخاب امر وکړ: «میکایا ونیسئ! هغه د سامرې والي آمون او شاهزاده یوآش ته ورولئ."}, {"ref": "2 Chronicles 1:26", "text": "هغوی ته ووایئ چې میکایا په زندان کې واچوئ او ترڅو پورې چې زه بېرته په خیر سره راستنېږم، هغه ته یوازې ډوډۍ او اوبه ورکوئ.»"}, {"ref": "2 Chronicles 1:27", "text": "میکایا وویل: «که چېرې ته په خیر سره بېرته راستون شوې، نو څښتن به زما په وسیله خبرې نه وي کړې.» بیا یې ټولو خلکو ته وویل: «ما چې څه وویل هغه هېر نه کړئ.»"}, {"ref": "2 Chronicles 1:28", "text": "نو د اسراییلو پاچا اخاب او د یهودا پاچا یهوشافاط د خپلو لښکرو سره د جلعاد راموت ته روان شول."}, {"ref": "2 Chronicles 1:29", "text": "مخکې له دې چې هغوی جګړې ته لاړ شي، اخاب وویل: «ای یهوشافاطه! زه به خپله څېره بدله کړم، خو ته خپله شاهانه چپنه واغونده.» نو اخاب خپله څېره بدله کړه او هغوی جګړې ته لاړل."}, {"ref": "2 Chronicles 1:30", "text": "د سوریې پاچا د خپلو جنګي ګاډیو قوماندانانو ته امر وکړ: «پرته د اسراییلو له پاچا څخه د بل چا سره جګړه ونه کړئ.»"}, {"ref": "2 Chronicles 1:31", "text": "نو کله چې هغوی یهوشافاط په خپله شاهانه چپنه کې ولیده، هغوی فکر وکړ چې هغه اخاب دی، نو هغوی په هغه باندې د حملې دپاره راوګرځېدل. خو یهوشافاط چیغې کړې او څښتن خدای د هغه سره مرسته وکړه او هغوی یې ورڅخه لېرې کړل."}, {"ref": "2 Chronicles 1:32", "text": "کله چې هغوی پوه شول چې هغه اخاب نه دی، نو د هغه د تعقیبولو څخه یې لاس واخیست."}, {"ref": "2 Chronicles 1:33", "text": "خو د جګړې په وخت کې یو سوریایي عسکر په سهوې سره یو غشی ګوزار کړ او هغه د اخاب د زغرو د کالیو په درز باندې ولګېده. اخاب د خپلې جنګي ګاډۍ چلوونکي ته وویل: «راوګرځه او ما د جګړې د میدان څخه وباسه، ځکه چې زه ټپي شوی یم.»"}, {"ref": "2 Chronicles 1:34", "text": "جګړه ټوله ورځ سختېدله، اخاب په خپلې جنګي ګاډۍ کې تکیه وهلې وه او د هغه ځای څخه یې د سوریایانو لښکرې لیدلې. هغه تر مازدیګره پورې هلته پاتې شو او د لمر پرېوتولو په وخت کې مړ شو."}, {"ref": "2 Chronicles 2:1", "text": "څه موده وروسته د موآب او د عمون لښکرو د معونیانو سره لاس یو کړ او د یهوشافاط په وړاندې جګړې ته لاړل."}, {"ref": "2 Chronicles 2:1", "text": "یهوشافاط مړ شو او د داود د ښار په شاهي هدیره کې ښخ شو. د یهوشافاط زوی یهورام د هغه په ځای پاچا شو."}, {"ref": "2 Chronicles 2:1", "text": "ځینو عربانو د یرغلګرو مشري وکړه او حمله یې وکړه او پرته له اخزیا چې کشر ؤ د یهورام ټول زامن یې ووژل. نو بیا د اورشلیم خلکو اخزیا د هغه د پلار څخه وروسته پاچا کړ."}, {"ref": "2 Chronicles 2:1", "text": "د شپږ کالو انتظار څخه وروسته یهویاداع کاهن پرېکړه وکړه چې اوس د دې وخت رارسېدلی دی چې یو کار وشي. هغه د دغو پنځو عسکري منصبدارانو سره تړون وکړ: د یروحام زوی عزریا، د یهوحانان زوی اسماعیل، د عوبید زوی عزریا، د عدایا زوی معسیا او د زکري زوی الیشافاط."}, {"ref": "2 Chronicles 2:1", "text": "یوآش اووه کلن ؤ چې د یهودا پاچا شو او په اورشلیم کې یې څلوېښت کاله پاچاهي وکړه. د هغه مور زبیه د بیرشبع د ښار څخه وه."}, {"ref": "2 Chronicles 2:1", "text": "امصیا د پنځه ویشت کلنۍ په عمر پاچا شو او په اورشلیم کې یې نهه ویشت کاله پاچاهي وکړه. د هغه مور یهوعدان نومېدله چې د اورشلیم څخه وه."}, {"ref": "2 Chronicles 2:1", "text": "د یهودا ټولو خلکو د امصیا شپاړس کلن زوی عزیا د هغه د پلار په ځای د پاچا په توګه غوره کړ."}, {"ref": "2 Chronicles 2:1", "text": "یوتام د پنځه ویشت کلنۍ په عمر پاچا شو او په اورشلیم کې یې شپاړس کاله پاچاهي وکړه. د هغه مور یروشه د صادوق لور وه."}, {"ref": "2 Chronicles 2:1", "text": "آحاز شل کلن ؤ چې پاچا شو او شپاړس کاله یې په اورشلیم کې پاچاهي وکړه. هغه د خپل نیکه داود لاره غوره نه کړه او داسې کارونه یې ونه کړل چې د څښتن په نظر کې ښه وو."}, {"ref": "2 Chronicles 2:1", "text": "حزقیا پنځه ویشت کلن ؤ چې پاچا شو او هغه نهه ویشت کاله په اورشلیم کې پاچاهي وکړه. د هغه د مور نوم ابیا ؤ چې د زکریا لور وه."}, {"ref": "2 Chronicles 2:2", "text": "څو کسان راغلل او یهوشافاط ته یې وویل: «د ادوم له خوا یو ډېر لوی لښکر د مړې بحیرې له ختیځ څخه راغلی دی چې زمونږ په هېواد باندې حمله وکړي. هغوی لا مخکې حززون‌تامار (عین‌جدي) ته رسېدلي دي.»"}, {"ref": "2 Chronicles 2:2", "text": "یهوشافاط اووه زامن درلودل چې دا یې نومونه وو: یهورام، عزریا، یحییل، زکریا، عزریاهو، میکاییل او شفطیا."}, {"ref": "2 Chronicles 2:2", "text": "هغوی د یهودا ټولو ښارونو ته سفر وکړ او ټول لاویان او د اسراییلو د طایفو مشران یې اورشلیم ته راټول کړل."}, {"ref": "2 Chronicles 2:2", "text": "ترڅو پورې چې یهویاداع ژوندی ؤ، یوآش هغه کارونه کول چې څښتن ورباندې خوشحالېده."}, {"ref": "2 Chronicles 2:2", "text": "هغه داسې کارونه کول چې د څښتن په نظر کې ښه وو، خو د زړه له کومي یې نه کول."}, {"ref": "2 Chronicles 2:2", "text": "عزیا د خپل پلار تر مړینې وروسته د ایلوت ښارګوټی د یهودا دپاره بېرته ونیوه او بیا یې ودان کړ."}, {"ref": "2 Chronicles 2:2", "text": "یوتام د خپل پلار په شان هغه کارونه کول چې د څښتن په نظر کې ښه وو، خو د هغه په شان یې د څښتن کور ته په ننوتلو سره ګناه نه کوله. خو بیاهم خلکو خپلو بدو رواجونو ته دوام ورکړ."}, {"ref": "2 Chronicles 2:2", "text": "آحاز د اسراییلو د پاچاهانو لاره غوره کړه. هغه د بعل د اوسپنې بتان جوړ کړل او"}, {"ref": "2 Chronicles 2:2", "text": "هغه لکه د خپل نیکه داود پاچا په شان هغه کارونه وکړل چې د څښتن په نظر کې ښه وو."}, {"ref": "2 Chronicles 2:3", "text": "یهوشافاط ووېرېده، نو هغه اراده وکړه چې د څښتن څخه لارښوونه وغواړي. بیا هغه امر وکړ چې په ټوله یهودیه کې دې روژه ونیول شي."}, {"ref": "2 Chronicles 2:3", "text": "د هغوی پلار هغوی ته ډېر زیات سوغاتونه یعنې سره زر، سپین زر او نور قیمتي شیان ورکړي وو او هغوی یې د یهودا د قوي شویو ښارونو مسوولان ټاکلي وو. خو پاچاهي یې یهورام ته ورکړې وه، ځکه چې هغه یې مشر زوی ؤ."}, {"ref": "2 Chronicles 2:3", "text": "هغوی ټول د خدای په کور کې سره راټول شول او هلته یې د یوآش یعنې د پاچا د زوی سره یو لوظ وکړ. یهویاداع هغوی ته وویل: «دا د پاچا زوی دی. لکه څنګه چې څښتن وعده کړې ده چې د داود اولاده به پاچاهان وي، نو هغه باید پاچا شي."}, {"ref": "2 Chronicles 2:3", "text": "یهویاداع د یوآش پاچا دپاره دوه ښځې خوښې کړې، بیا یوآش د هغوی څخه د څو زامنو او لوڼو خاوند شو."}, {"ref": "2 Chronicles 2:3", "text": "څنګه چې امصیا د یهودا واک تر‌لاسه کړ، نو هغه درباریان چې پاچا یعنې د ده پلار یې په قتل رسولی ؤ، ویې وژل."}, {"ref": "2 Chronicles 2:3", "text": "عزیا د شپاړس کلنۍ په عمر پاچا شو او په اورشلیم کې یې دوه پنځوس کاله پاچاهي وکړه. د هغه د مور نوم یکلیا ؤ چې د اورشلیم څخه وه."}, {"ref": "2 Chronicles 2:3", "text": "دا یوتام ؤ چې د څښتن د کور پاسنۍ دروازه یې بیا جوړه کړه او د ښار په هغه دېوال باندې یې ډېر کار وکړ چې د اورشلیم د عوفل په سیمه کې ؤ."}, {"ref": "2 Chronicles 2:3", "text": "د هنوم د زوی په دره کې یې ورته خوشبویي وسوځوله. حتی خپل زامن یې هم د سوځېدونکو نذرانو په توګه قرباني کړل. دا د هغو قومونو ناوړه رواج ؤ چې څښتن د اسراییلو د وړاندې تګ سره سم شړلي وو."}, {"ref": "2 Chronicles 2:3", "text": "حزقیا د خپلې پاچاهۍ د لومړي کال په لومړۍ میاشت د څښتن د کور دروازې پرانیستې او هغه یې بېرته جوړې کړې."}, {"ref": "2 Chronicles 2:4", "text": "د یهودا د هر ښار څخه خلک اورشلیم ته راغلل، د دې دپاره چې د څښتن څخه مرسته وغواړي."}, {"ref": "2 Chronicles 2:4", "text": "کله چې یهورام په پوره توګه د پاچاهۍ واک تر‌لاسه کړ، هغه خپل ټول ورونه او د اسراییلو ځینې مامورین ووژل."}, {"ref": "2 Chronicles 2:4", "text": "هغه داسې کارونه وکړل چې د څښتن په نظر کې بد وو، ځکه چې د هغه د پلار د مړینې څخه وروسته د اخاب پاچا د کورنۍ نور غړي د هغه مشاوران شول او د هغه د رانسکورېدلو سبب شول."}, {"ref": "2 Chronicles 2:4", "text": "مونږ به داسې وکړو: د کاهنانو او د لاویانو درې ډلې به د سبت په ورځ په خپلو دندو کې وي. یوه ډله به د خدای د کور د دروازو ساتنه کوي"}, {"ref": "2 Chronicles 2:4", "text": "کله چې د یوآش د پاچاهۍ یو څه موده تېره شوه، هغه پرېکړه وکړه چې د څښتن کور بېرته جوړ کړي."}, {"ref": "2 Chronicles 2:4", "text": "خو د هغو قاتلانو اولادونه یې ونه وژل. دا ځکه چې هغه په دې اړه د هغه شریعت پیروي وکړه چې د موسی د تورات په کتاب کې دی. لکه څنګه چې څښتن حکم کړی ؤ: «پلرونه دې د هغو جرمونو په خاطر نه وژل کیږي چې د هغوی اولادونو کړي وي او اولادونه دې د هغو جرمونو په خاطر نه وژل کیږي چې د هغوی پلرونو کړي وي. هرڅوک دې یوازې د هغو جرمونو دپاره ووژل شي چې هغوی په خپله کړي وي.»"}, {"ref": "2 Chronicles 2:4", "text": "عزیا د خپل پلار په شان د څښتن اطاعت کاوه او ښه کارونه یې کول."}, {"ref": "2 Chronicles 2:4", "text": "هغه د یهودا په غرونو کې ښارونه ودان کړل او په ځنګلونو کې یې کلاوې او د څارنې برجونه جوړ کړل."}, {"ref": "2 Chronicles 2:4", "text": "آحاز په سیمه‌ییزو عبادتځایونو، غونډیو او د هرې سیوري لرونکې ونې لاندې قربانۍ کولې او خوشبویي یې سوځولې."}, {"ref": "2 Chronicles 2:4", "text": "هغه د څښتن د کور په ختیځې حوېلۍ کې کاهنان او لاویان راټول کړل"}, {"ref": "2 Chronicles 2:5", "text": "وروسته له دې چې د یهودیې او د اورشلیم ټول خلک د څښتن په کور کې راټول شول، یهوشافاط د نوې حوېلۍ مخې ته ودرېده"}, {"ref": "2 Chronicles 2:5", "text": "یهورام د دوه دېرشو کالو په عمر ؤ چې پاچا شو او اته کاله یې په اورشلیم کې پاچاهي وکړه."}, {"ref": "2 Chronicles 2:5", "text": "اخزیا د هغوی مشوره ومنله او د اسراییلو د پاچا یورام سره لاړ چې د جلعاد په راموت کې په حزاییل پاچا او د سوریې په لښکرو باندې حمله وکړي. په دې جګړه کې د سوریې عسکرو یورام ټپي کړ،"}, {"ref": "2 Chronicles 2:5", "text": "او بله ډله به د شاهي ماڼۍ ساتنه کوي او پاتې نور به په هغه دروازه کې چې د بنیاد په نوم یادیږي، ودرول شي. نور ټول خلک به د څښتن د کور په حوېلۍ کې سره راټول شي."}, {"ref": "2 Chronicles 2:5", "text": "هغه کاهنانو او لاویانو ته حکم وکړ: «د یهودا ښارونو ته لاړ شئ او زر تر زره د خپل خدای د کور د کلنۍ رغونې دپاره د ټولو اسراییلیانو څخه پیسې راټولې کړئ.» خو لاویانو ځنډ وکړ،"}, {"ref": "2 Chronicles 2:5", "text": "امصیا پاچا د یهودا او د بنیامین د قبیلو ټول سړي په نظامي ډلو کې د هغو د طایفو له مخې چې دوی ورپورې تړاو درلود، تنظیم کړل او قوماندانان یې د زرو او سلو تنو لرونکو ډلو په سر کې ځای په ځای کړل. په دې کې د شلو کالو او د هغې څخه د زیات عمر لرونکي سړي وو چې ټول درې سوه زره کسان وو. هغوی غوره شوي عسکر وو چې د جګړې دپاره تیار وو او د نېزو او سپرونو د کارولو مهارت یې درلود."}, {"ref": "2 Chronicles 2:5", "text": "زکریا د عزیا مشاور ؤ او هغه یې د خدای اطاعت ته هڅاوه. نو ترڅو پورې چې زکریا ژوندی ؤ، عزیا خدای ته رجوع وکړه او خدای هغه بریالی کړ."}, {"ref": "2 Chronicles 2:5", "text": "هغه د عمون د پاچا او د هغه د لښکر په ضد جګړه وکړه او هغوی ته یې ماتې ورکړه. عمونیانو د درېو کالو دپاره په هر کال کې هغه ته درې زره او څلور سوه کیلو‌ګرامه سپین زر، زر ټنه غنم او زر ټنه اوربشې باج ورکاوه."}, {"ref": "2 Chronicles 2:5", "text": "او هلته یې ورسره خبرې وکړې. هغه وویل: «ای لاویانو زما خبرې واورئ، خپل ځانونه او د خپلو نیکونو د څښتن خدای کور پاک کړئ او د کور څخه ناپاک شیان لېرې کړئ."}, {"ref": "2 Chronicles 2:6", "text": "او دعا یې وکړه: «ای زمونږ د نیکونو څښتن خدایه! ته د اسمان څخه د نړۍ په هر قوم باندې پاچاهي کوې. ته دومره قوي او زورور یې چې هېڅوک نه شي کولای ستا په وړاندې ودریږي."}, {"ref": "2 Chronicles 2:6", "text": "یهورام لکه د اخاب د کورنۍ په شان د اسراییلو د پاچاهانو لاره غوره کړه. د اخاب لور د یهورام ښځه وه او هغه د څښتن په وړاندې ګناه وکړه،"}, {"ref": "2 Chronicles 2:6", "text": "نو هغه د یزرعیل ښار ته راستون شو چې زخمونه یې روغ شي. اخزیا د هغه د لیدلو دپاره هلته ورغی."}, {"ref": "2 Chronicles 2:6", "text": "پرته له کاهنانو او لاویانو چې په دنده کې دي، هېڅوک دې د څښتن کور ته نه ننوځي. پورته نومول شوي کاهنان او لاویان کولای شي چې ورننوځي، ځکه چې هغوی پاک شوي دي، خو پاتې خلک باید د څښتن د لارښوونو اطاعت وکړي او دباندې پاتې شي."}, {"ref": "2 Chronicles 2:6", "text": "نو وروسته پاچا لوی کاهن یهویاداع خپل حضور ته راوغوښت او ورته ویې ویل: «تا ولې لاویان د هغې مالیې د راټولولو دپاره چې د خدای خدمتګار موسی په اسراییلیانو باندې ایښې وه نه دي لېږلي، ترڅو هغه د یهودا او د اورشلیم څخه راټوله کړي او سپېڅلې خېمې ته یې راوړي؟»"}, {"ref": "2 Chronicles 2:6", "text": "برسېره پردې هغه سل زره زړور عسکر د اسراییلو څخه د شاوخوا درې زره او څلور سوه کیلو‌ګرامه سپینو زرو په بیه اجیر ونیول."}, {"ref": "2 Chronicles 2:6", "text": "عزیا د فلسطینیانو په ضد جګړې ته لاړ. هغه د جت، یبنه او د اشدود د ښارونو دېوالونه وران کړل او اشدود ته نژدې او په پاتې فلسطین کې یې ښارونه ودان کړل."}, {"ref": "2 Chronicles 2:6", "text": "یوتام قوي شو، ځکه چې هغه په وفادارۍ سره د خپل څښتن خدای اطاعت کاوه."}, {"ref": "2 Chronicles 2:6", "text": "زمونږ نیکونه زمونږ څښتن خدای ته بې‌وفا وو او هغه کارونه یې کول چې د هغه په نظر کې بد وو. هغوی څښتن پرېښود او د هغه د اوسېدلو ځای ته یې شا کړه."}, {"ref": "2 Chronicles 2:7", "text": "ای زمونږ خدایه! کله چې ستا قوم اسراییلو دې وطن ته کډه وکړه، تا د دې ځای اوسېدونکي وشړل او دا ځمکه دې د خپل دوست یعنې د ابراهیم اولادې ته ورکړه چې د تل دپاره د هغوی شي."}, {"ref": "2 Chronicles 2:7", "text": "خو څښتن نه غوښتل چې د داود شاهي کورنۍ له منځه یوسي، ځکه چې څښتن د داود سره لوظ کړی ؤ او وعده یې کړې وه چې د هغه اولاده به تل په یهودا باندې پاچاهي کوي."}, {"ref": "2 Chronicles 2:7", "text": "خدای دا لیدنه کتنه د اخزیا د نسکورېدلو سبب وګرځوله. کله چې اخزیا هلته ورسېده، هغه د یورام سره د ییهو سره چې د نمشي زوی ؤ، د لیدلو دپاره ووت. (ییهو هماغه سړی ؤ چې څښتن د اخاب د شاهي کورنۍ له منځه وړلو دپاره غوره کړی ؤ.)"}, {"ref": "2 Chronicles 2:7", "text": "لاویان دې په داسې حال کې د پاچا په شاوخوا کې پهره وکړي چې خپلې تورې یې راویستلې وي او هر‌چېرته چې پاچا ځي، هغوی دې ورسره وي. هرڅوک چې د څښتن کور ته د ننوتلو هڅه وکړي، هغه دې ووژل شي.»"}, {"ref": "2 Chronicles 2:7", "text": "د هغې بدکارې ښځې یعنې د عتلیا پیروان د خدای کور ته ننوتي وو او د ټولو سپېڅلو شیانو څخه یې د بعل په عبادت کې کار اخیست."}, {"ref": "2 Chronicles 2:7", "text": "خو د خدای یو نبي پاچا ته ورغی او ورته ویې ویل: «دا د اسراییلو عسکر مه پرېږده چې ستا سره لاړ شي، ځکه چې څښتن د شمال د پاچاهۍ د خلکو سره مل نه دی."}, {"ref": "2 Chronicles 2:7", "text": "خدای د هغه سره مرسته وکړه چې فلسطینیانو ته، هغو عربانو ته چې په جور‌بعل کې اوسېدل او همدارنګه معونیانو ته ماتې ورکړي."}, {"ref": "2 Chronicles 2:7", "text": "د یوتام د پاچاهۍ نورې پېښې، د هغه جګړې او کړنلارې ټولې د اسراییلو او یهودا د پاچاهانو د تاریخ په کتاب کې لیکل شوې دي."}, {"ref": "2 Chronicles 2:7", "text": "یو اسراییلي عسکر چې زکري نومېده د آحاز پاچا زوی معسیا، د ماڼۍ د چارو مدیر عزریقام او القانه چې د پاچا څخه وروسته دوهم سړی ؤ، ووژل."}, {"ref": "2 Chronicles 2:7", "text": "هغوی د څښتن د کور دروازې بندې کړې، څراغونه یې مړه کړل او د اسراییلو د خدای په کور کې یې خوشبویي یا سوځېدونکې نذرانې هغه ته وړاندې نه کړې."}, {"ref": "2 Chronicles 2:8", "text": "زمونږ نیکونه په دې ځمکه کې اوسېدل او ستا د نوم او عزت دپاره یې سپېڅلی کور جوړ کړ."}, {"ref": "2 Chronicles 2:8", "text": "د یهورام په پاچاهۍ کې د ادوم خلک یاغي شول او د ځان دپاره یې خپل پاچا وټاکه."}, {"ref": "2 Chronicles 2:8", "text": "څنګه چې ییهو د خدای پرېکړه د اخاب په شاهي کورنۍ باندې عملي کوله، هغه د یوې ډلې سره مخامخ شو چې د یهودا مشران او د اخزیا ورېرونه په کې وو چې د اخزیا سره د هغه د خدمت دپاره تللي وو. ییهو هغه ټول ووژل."}, {"ref": "2 Chronicles 2:8", "text": "لاویانو او د یهودا خلکو د یهویاداع کاهن د حکمونو څخه پیروي وکړه. قوماندانان په درېو ډلو کې د خپلو ټولو ساتونکو سره حاضر شول، هغو کسانو چې د سبت په ورځ یې دنده لرله او هغوی چې په همدې ورځ رخصتېدل، نو یهویاداع هغوی ته اجازه ورنه کړه چې خپلو کورونو ته لاړ شي."}, {"ref": "2 Chronicles 2:8", "text": "د پاچا د امر سره سم یو صندوق جوړ شو او هغه یې د څښتن د کور د دروازې دباندې کېښود."}, {"ref": "2 Chronicles 2:8", "text": "ته به دا فکر کوې چې هغوی به تاته په جګړه کې قوت درکړي، خو خدای دا قدرت لري چې چاته بری یا ماتې ورکړي او هغه به ستا دښمنان پرېږدي چې تاته ماتې درکړي.»"}, {"ref": "2 Chronicles 2:8", "text": "عمونیانو عزیا ته باج ورکاوه او هغه دومره قوي شو چې شهرت یې د مصر تر پولې پورې خپور شو."}, {"ref": "2 Chronicles 2:8", "text": "یوتام د پنځه ویشت کلنۍ په عمر پاچا شو او په اورشلیم کې یې شپاړس کاله پاچاهي وکړه."}, {"ref": "2 Chronicles 2:8", "text": "که څه هم د یهودا خلک د هغوی خپلوان وو، خو د اسراییلو لښکرو دوه سوه زره ښځې او ماشومان د اسیرانو په توګه ونیول او د ډېر زیات غنیمت سره یې سامریې ته بوتلل."}, {"ref": "2 Chronicles 2:8", "text": "له دې امله څښتن په یهودا او په اورشلیم باندې ډېر په قهر شو. تاسو په دې ښه پوهېږئ، هغه څه چې څښتن په هغوی باندې کړي دي په هغې ټول خلک ووېرېدل، وارخطا او مسخره شول."}, {"ref": "2 Chronicles 2:9", "text": "هغوی پوهېدل چې هرکله په دې خاوره باندې کومه بلا، یعنې جګړه، وبا یا قحطي راشي، بیا هغوی کولای شي چې راشي او ستا په حضور کې د دې کور مخې ته چې ستا په نوم یادیږي، ودریږي. هغوی کولای شي د تکلیف په وخت کې تاته دعا او زارۍ وکړي او ته به د هغوی دعا واورې او هغوی به وژغورې."}, {"ref": "2 Chronicles 2:9", "text": "نو یهورام او د هغه منصبداران د خپلو جنګي ګاډیو سره روان شول او په ادوم باندې یې یرغل وکړ. هلته د ادومیانو لښکرو هغوی کلابند کړل، خو هغوی وکولای شول چې د شپې په تیاره کې له کلابندۍ څخه ووځي."}, {"ref": "2 Chronicles 2:9", "text": "له هغې وروسته اخزیا ولټول شو او په سامره کې وموندل شو چېرته چې هغه پټ ؤ. هغه یې ییهو ته وروست او هغوی اخزیا وواژه. خو هغه یې د هغه د نیکه یعنې د یهوشافاط د درنښت په خاطر چې د زړه له کومي یې د څښتن خدمت کړی ؤ، ښخ کړ. په دې ډول د اخزیا د کورنۍ هېڅ غړی پاتې نه شو چې د یهودا پاچا شي."}, {"ref": "2 Chronicles 2:9", "text": "یهویاداع هغه نېزې او سپرونه قوماندانانو ته ورکړل چې د داود د پاچا وو او د خدای په کور کې ساتل شوي وو."}, {"ref": "2 Chronicles 2:9", "text": "هغوی د اورشلیم او د یهودا ټولو خلکو ته پیغام ولېږه چې څښتن ته هغه مالیه راوړي چې موسی د څښتن خدمتګار د اسراییلو په خلکو باندې په دښته کې ټاکلې وه."}, {"ref": "2 Chronicles 2:9", "text": "امصیا د نبي څخه پوښتنه وکړه: «خو هغه ټول سپین زر به څنګه کیږي چې ما د اسراییلو عسکرو ته ورکړي دي؟» نبي په ځواب کې وویل: «څښتن بېرته د هغه څخه ډېر درکولای شي!»"}, {"ref": "2 Chronicles 2:9", "text": "عزیا د اورشلیم د کنج په دروازې، د درې په دروازې او په هغه ځای کې قوي برجونه جوړ کړل چېرته چې د ښار دېوال تاو شوی ؤ."}, {"ref": "2 Chronicles 2:9", "text": "یوتام مړ شو او د داود د ښار په شاهي هدیره کې ښخ شو. بیا د هغه زوی آحاز د هغه په ځای‎ پاچا شو."}, {"ref": "2 Chronicles 2:9", "text": "د څښتن یو نبي چې عودید نومېده، هغه د سامرې په ښار کې اوسېده. څنګه چې د اسراییلو لښکر ښار ته د یهودا د اسیرانو سره لاړل، عودید ورسره مخامخ شو او ورته ویې ویل: «ستاسو د نیکونو څښتن خدای په یهودا باندې په قهر شو او تاسو یې پرېښودئ چې هغوی ته ماتې ورکړئ، خو اوس هغه خبر شوی دی چې تاسو په څومره بې‌رحمۍ سره هغوی ووژل."}, {"ref": "2 Chronicles 2:9", "text": "له همدې امله زمونږ پلرونه په جګړه کې ووژل شول او زمونږ ښځې، زامن او لورګانې د اسیرانو په توګه یووړل شول."}, {"ref": "2 Chronicles 2:10", "text": "اوس ته ګورې چې د عمون، موآب او ادوم لښکر په مونږ باندې د حملې دپاره راغلي دي. کله چې زمونږ نیکونه د مصر نه راووتل، تا هغوی ته اجازه ورنه کړه چې د هغوی خاورې ته ورننوځي. نو زمونږ نیکونو هغوی له منځه یو نه وړل او په بله لاره لاړل."}, {"ref": "2 Chronicles 2:10", "text": "یهودا هېڅکله ونه شو کولای چې په ادوم باندې خپله واکمني بېرته تر‌لاسه کړي. حتی د لبنه ښاریان هم په هغه وخت کې یاغي شول. دا ځکه وشول چې یهورام د خپلو نیکونو د څښتن خدای څخه مخ اړولی ؤ."}, {"ref": "2 Chronicles 2:10", "text": "څنګه چې عتلیا واورېدل چې د هغې زوی اخزیا پاچا وژل شوی دی، نو هغې پرېکړه وکړه چې د یهودا د شاهي کورنۍ ټول غړي دې ووژل شي."}, {"ref": "2 Chronicles 2:10", "text": "بیا هغه د خدای د کور د جنوبي خوا څخه نیولې تر شمالي خوا پورې د پاچا د ساتلو دپاره ټول خلک په وسلو سمبال او د خدای د کور او قربانۍ د ځای شاوخوا ته یې ځای په ځای کړل."}, {"ref": "2 Chronicles 2:10", "text": "خلکو او د هغوی مشرانو چې دا خبره واورېدله، نو خوشحاله شول او هغوی د خپلې مالیې پیسې راوړې او صندوق یې ورڅخه ډک کړ."}, {"ref": "2 Chronicles 2:10", "text": "نو امصیا اجیر اسراییلي عسکر بېرته خپل وطن ته رخصت کړل. په دې خاطر هغوی د یهودا په خلکو ډېر په قهر شول او په ډېر قهر سره خپلو کورونو ته ستانه شول."}, {"ref": "2 Chronicles 2:10", "text": "هغه په دښته کې هم قوي برجونه جوړ کړل او د اوبو ډېرې ذخیرې یې وکیندلې، ځکه چې هغه د غرونو په لوېدیځو لمنو او ډاګونو کې ډېرې پادې درلودلې. هغه د کرنې سره مینه درلودله، نو هغه په غرنۍ سیمه کې د خپلو انګورو د باغونو دپاره باغوانان او په حاصلخېزه خاوره کې د خپلو فصلونو د کرنې دپاره بزګران درلودل."}, {"ref": "2 Chronicles 2:10", "text": "اوس تاسو دا نیت لرئ چې د اورشلیم او د یهودا سړي او ښځې خپل غلامان کړئ. ایا په دې نه پوهېږئ چې تاسو هم د خپل څښتن خدای په وړاندې ګناهونه کړي دي؟"}, {"ref": "2 Chronicles 2:10", "text": "اوس ما پرېکړه کړې ده چې د اسراییلو د څښتن خدای سره یو لوظ وکړم، ترڅو د هغه سخت قهر زمونږ څخه لېرې شي."}, {"ref": "2 Chronicles 2:11", "text": "د هغې په بدل کې هغوی راغلي دي چې مونږ د هغې ځمکې څخه وشړي چې تا راکړې ده."}, {"ref": "2 Chronicles 2:11", "text": "یهورام حتی د یهودا په غونډیو کې سیمه‌ییز عبادتځایونه هم جوړ کړل او د پردیو خدایانو په عبادت کولو سره یې د یهودا او د اورشلیم خلک بې‌لارې کړل."}, {"ref": "2 Chronicles 2:11", "text": "اخزیا یوه ناسکه خور درلودله چې یهوشبع نومېدله، هغه د یهویاداع نومې یو کاهن ښځه وه. هغې په پټه د اخزیا یو زوی چې یوآش نومېده وژغوره. هغه یې په غلا د نورو شاهزادګانو له منځه چې قتل کېدلو ته نژدې وو، یووړ او د هغه د دایې سره یې د خدای د کور د خوب په یوه کوټه کې پټ کړ. په دې ډول د هغه د قتل څخه چې د عتلیا په لاس کېدونکی ؤ، مخنیوی وشو."}, {"ref": "2 Chronicles 2:11", "text": "یهویاداع او د هغه زامنو یوآش دباندې راوویست، د هغه په سر یې تاج کېښود او د پاچاهۍ د قانون یو نقل یې ورته ورکړ. د هغه په سر باندې یې د زیتونو تېل واچول چې دا وښایي چې هغه اوس پاچا شو، په هغه وخت کې خلکو چیغې ووهلې: «ژوندی دې وي پاچا!»"}, {"ref": "2 Chronicles 2:11", "text": "لاویانو به په منظم ډول صندوق د پاچا درباریانو ته وروړ. هرکله به چې هغه ډکېده، شاهي منشي او د لوی کاهن استازي به پیسې ورڅخه راویستلې او صندوق به یې بېرته په خپل ځای کې کېښود. دا کار به هره ورځ کېده او په دې ډول هغوی ډېرې پیسې راټولې کړې."}, {"ref": "2 Chronicles 2:11", "text": "امصیا بېرته خپل همت تر‌لاسه کړ او خپل لښکر یې د مالګې درې ته بوته. هغوی هلته وجنګېدل او لس زره ادومي عسکر یې ووژل."}, {"ref": "2 Chronicles 2:11", "text": "عزیا د جګړې دپاره یو تیار لښکر درلود چې د فرقو څخه جوړ شوی ؤ. د هغوی شمېر د یعییل منشي او د هغه مرستیال معسیا له خوا ټاکل کېده او اداره کېده. حننیا د پاچا یو درباري او د لښکرو عمومي قوماندان ؤ."}, {"ref": "2 Chronicles 2:11", "text": "ماته غوږ ونیسئ! دا اسیران ستاسو خپلوان دي. هغوی بېرته ولېږئ که نه، نو د څښتن قهر او غضب به په تاسو باندې نازل شي.»"}, {"ref": "2 Chronicles 2:11", "text": "زما زامنو، په خپلو وظیفو کې بې‌پروایي مه کوئ. څښتن تاسو د دې دپاره غوره کړي یئ چې د هغه په حضور کې ودرېږئ او د هغه خدمت وکړئ او هغه ته خوشبویي وسوځوئ.»"}, {"ref": "2 Chronicles 2:12", "text": "ای زمونږ خدایه! ته قضاوت وکړه او هغوی ته سزا ورکړه، مونږ څنګه د دې لوی لښکر په وړاندې ودرېږو چې په مونږ باندې حمله کوي؟ مونږ بې‌وسه یو. مونږ نه پوهېږو چې څه وکړو، خو مونږ ستا مرستې ته سترګې په لاره یو.»"}, {"ref": "2 Chronicles 2:12", "text": "الیاس نبي یهورام ته یو لیک واستاوه چې داسې یې په کې لیکلي وو: «څښتن ستا د نیکه داود خدای داسې وایي: ته د خپل پلار یهوشافاط پاچا یا د خپل نیکه آسا پاچا په لاره روان نه شوې."}, {"ref": "2 Chronicles 2:12", "text": "یوآش د هغوی سره د خدای په کور کې د شپږو کالو دپاره چې ملکې عتلیا په یهودا کې پاچاهي کوله، پټ پاتې شو."}, {"ref": "2 Chronicles 2:12", "text": "عتلیا د خلکو د منډو او د پاچا دپاره د ستاینې اوازونه واورېدل، نو هغه د څښتن کور ته چې خلک په کې راټول شوي وو، ورغله."}, {"ref": "2 Chronicles 2:12", "text": "یوآش او یهویاداع به پیسې هغو سړیو ته ورکولې چې د څښتن د کور د رغونې څارنه یې کوله. هغه پیسې به یې د ګلکارانو، نجارانو، اهنګرانو او د مسګرانو په نیولو کې لګولې."}, {"ref": "2 Chronicles 2:12", "text": "هغوی نور لس زره تنه عسکر ونیول او د کمره سر ته یې وخېژول. بیا یې د هغه ځای نه راوغورځول او ټول لاندې په ګټونو باندې ټوټې ټوټې شول."}, {"ref": "2 Chronicles 2:12", "text": "دوه زره او شپږ سوه د طایفو مشران د لښکرو قوماندانان وو."}, {"ref": "2 Chronicles 2:12", "text": "د اسراییلو د شمال د پاچاهۍ دغو څلورو مشرانو هم د لښکر د دې کار مخالفت وکړ: د یهوحانان زوی عزریا، د مشلیموت زوی برکیا، د شلوم زوی یحزقیا او د حدلای زوی عماسا."}, {"ref": "2 Chronicles 2:13", "text": "د یهودا ټول سړي د خپلو ښځو او ماشومانو سره د څښتن په حضور کې ولاړ وو."}, {"ref": "2 Chronicles 2:13", "text": "د هغې په ځای د اسراییلو د پاچاهانو په لاره روان شوې او د یهودا او د اورشلیم خلک دې وهڅول چې د بتانو عبادت وکړي، لکه څنګه چې اخاب او د هغه شاهي کورنۍ د اسراییلو د بې‌وفایۍ سبب ګرځېدلي وو. تا حتی خپل ورونه هم ووژل چې ستا څخه ښه خلک وو."}, {"ref": "2 Chronicles 2:13", "text": "هغې هلته د څښتن د کور په دروازه کې نوی پاچا ولیده چې د پاچاهانو د ځانګړې ستنې سره ولاړ وو او قوماندانان او سرني غږوونکي د هغه په خوا کې ولاړ وو. ټولو خلکو خوشحالي کوله او سرني یې غږول او د څښتن د کور موسیقي غږوونکو چې خپلې د موسیقۍ الې ورسره وې د جشن مشري کوله. عتلیا د ډېر قهر نه خپل کالي وشکول او چیغې یې ووهلې: «خیانت! خیانت!»"}, {"ref": "2 Chronicles 2:13", "text": "هغوی ټولو ډېر سخت کار وکړ او د خدای کور یې بېرته خپل اصلي حالت ته راوست او هغه یې قوي جوړ کړ."}, {"ref": "2 Chronicles 2:13", "text": "په دې وخت کې هغو اسراییلي عسکرو ته چې امصیا اجازه نه وه ورکړې چې د هغه سره جګړې ته لاړ شي، د یهودا په ښارونو باندې چې د سامرې او د بیت‌حورون ترمنځ وو حمله وکړه، درې زره کسان یې ووژل او په زیاته اندازه غنیمت یې ونیوه."}, {"ref": "2 Chronicles 2:13", "text": "د دوی د لاس لاندې درې لکه اووه زره او پنځه سوه عسکر وو چې په قوت سره یې د پاچا دپاره د هغه د دښمنانو په ضد جګړه کوله."}, {"ref": "2 Chronicles 2:13", "text": "هغوی وویل: «هغه اسیران دلته مه راولئ! ځکه په دې کار سره مونږ د خدای په وړاندې ګناهکاروئ. مونږ لا پخوا د څښتن په وړاندې زیاته ګناه کړې ده، تاسو غواړئ چې زمونږ ګناه لا نوره هم زیاته شي. نژدې دی چې د خدای قهر او غضب په مونږ باندې نازل شي.»"}, {"ref": "2 Chronicles 2:14", "text": "د څښتن روح په یو لاوي باندې چې په غونډه کې حاضر ؤ، نازل شو. هغه یحزییل نومېده او د هغه شجره په لاندې ډول وه: پلار یې زکریا، نیکه یې بنایاه، غور‌نیکونه یې یعییل او متنیا وو. هغه د اساف د طایفې یو غړی ؤ."}, {"ref": "2 Chronicles 2:14", "text": "په دې خاطر به څښتن ستا په خلکو، ښځو، ماشومانو او ټولو شتمنیو باندې بده وبا راولي."}, {"ref": "2 Chronicles 2:14", "text": "یهویاداع نه غوښتل چې عتلیا د څښتن په کور کې ووژل شي، نو هغه د لښکرو قوماندانان راوغوښتل او ویې ویل: «عتلیا د لښکرو د قطارونو څخه دباندې وباسئ او هر هغه څوک چې د هغې د ژغورلو هڅه وکړي، هغه ووژنئ.»"}, {"ref": "2 Chronicles 2:14", "text": "کله چې د بیا رغولو کار پای ته ورسېده، پاتې سره او سپین زر پاچا او یهویاداع ته ورکړل شول. هغوی د هغو څخه د څښتن د کور دپاره د کاسو او نورو لوښو په جوړولو کې کار واخیست، یعنې د هغه د سوځېدونکو نذرانو او د نورو کارونو دپاره. د یهواش بدکاري ترڅو پورې چې یهویاداع ژوندی ؤ، د څښتن په کور کې سوځېدونکې نذرانې په منظم ډول وړاندې کېدلې."}, {"ref": "2 Chronicles 2:14", "text": "کله چې امصیا ادومیانو ته د ماتې ورکولو څخه راستون شو، د هغوی بتان یې د خپل ځان سره راوړل. هغه یې د خپلو بتانو په شان ودرول، د هغو عبادت یې وکړ او قربانۍ یې ورته وسوځولې."}, {"ref": "2 Chronicles 2:14", "text": "عزیا لښکر ته سپرونه، نېزې، د اوسپنې خولۍ، د زغرو کورتۍ، لیندې او غشي او په مچنوغزو کې د ویشتلو دپاره تیږې ورسولې."}, {"ref": "2 Chronicles 2:14", "text": "نو بیا لښکرو اسیران او غنیمت خلکو او د هغوی مشرانو ته وسپارل."}, {"ref": "2 Chronicles 2:15", "text": "بیا یحزییل وویل: «اعلیحضرته او د یهودا او د اورشلیم ټولو خلکو! څښتن وایي: ‹تاسو مه وېرېږئ او مه پرېږدئ چې دا ډېر لوی لښکر تاسو بې‌زړه کړي. دا جنګ د خدای جنګ دی، ستاسو جنګ نه دی."}, {"ref": "2 Chronicles 2:15", "text": "په خپله ته به د کولمو په یوې داسې سختې ناروغۍ اخته شې چې ورځ په ورځ به زیاتیږي، تر هغې چې کولمې به دې راووځي.»"}, {"ref": "2 Chronicles 2:15", "text": "نو قوماندانانو عتلیا هغې دروازې ته راوویستله چې اسونه به په کې ماڼۍ ته ورننوتل او هلته یې ووژله."}, {"ref": "2 Chronicles 2:15", "text": "یهویاداع د زوړوالي عمر ته ورسېده او په یوسلو دېرش کلنۍ کې مړ شو."}, {"ref": "2 Chronicles 2:15", "text": "په دې خبره څښتن په قهر شو، نو هغه امصیا ته یو نبي ورولېږه. نبي پوښتنه وکړه: «ولې دې د پردیو خدایانو عبادت وکړ چې حتی خپل خلک یې هم ستا له لاسه ونه شو ژغورلی؟»"}, {"ref": "2 Chronicles 2:15", "text": "په اورشلیم کې د هغه ماهرو کارګرانو داسې ماشینونه جوړ کړل چې غشي او لویې تیږې یې د برجونو او د ښار د دېوال د کنجونو څخه ورباندې ګوزار کړي. د هغه شهرت په هرځای کې خپور شو او هغه د هغې مرستې له امله چې د خدای څخه یې تر‌لاسه کوله، ډېر قوي شو."}, {"ref": "2 Chronicles 2:15", "text": "پورته څلورو ذکر شویو سړیو ته دنده وسپارل شوه چې هغو اسیرانو ته چې لوڅ وو، په غنیمت نیول شوي کالي ورکړي. هغوی اسیرانو ته د اغوستلو دپاره کالي او د پښو دپاره څپلۍ ورکړې. همدارنګه هغوی ته یې خوراک او څښاک ورکړ او د زیتونو تېل یې د هغوی په زخمونو باندې واچول. هغه چې ډېر کمزوري وو او مزل یې نه شو کولای، په خرو یې سپاره کړل او ټول اسیران بېرته اریحا ته چې د خرما د ونو ښار دی، د هغوی خپل قوم ته یووړل شول. بیا اسراییلیان سامریې ته راستانه شول."}, {"ref": "2 Chronicles 2:15", "text": "دغو سړیو خپل لاویان ورونه راټول او هغوی ټولو خپل ځانونه په مذهبي توګه پاک کړل. بیا هغوی د څښتن د شریعت سره سم او د پاچا په امر د څښتن د کور په پاکولو پیل وکړ."}, {"ref": "2 Chronicles 2:16", "text": "څنګه چې هغوی سبا ته د صیص غاښي ته راوخېژي، نو حمله ورباندې وکړئ. د درې په اخر سر کې چې یروییل ته نژدې دښتې ته وتلی دی، مخامخ شئ."}, {"ref": "2 Chronicles 2:16", "text": "څښتن د یهورام په ضد د فلسطینیانو او د عربانو چې ایتوپیایانو ته نژدې اوسېدل، کینه راوپاروله."}, {"ref": "2 Chronicles 2:16", "text": "یهویاداع کاهن د ځان، د ټولو خلکو او د یوآش پاچا سره لوظ وکړ چې دوی به د څښتن خدمتګاران وي."}, {"ref": "2 Chronicles 2:16", "text": "هغه د داود د ښار په شاهي هدیره کې ښخ شو، ځکه چې هغه د اسراییلو د قوم، د خدای او د خدای د کور دپاره ښه کارونه کړي وو."}, {"ref": "2 Chronicles 2:16", "text": "امصیا د هغه خبره ونیوله او ویې ویل: «ته چا د پاچا مشاور کړې یې؟ چوپ شه که نه، نو وبه دې وژنم!» نبي غلی شو، خو دا خبره یې وکړه: «اوس زه پوهېږم چې خدای ستا د تباه کولو پرېکړه کړې ده، ځکه چې تا دا ټول کارونه کړي دي او زما مشورې ته دې پام نه دی کړی.»"}, {"ref": "2 Chronicles 2:16", "text": "خو کله چې عزیا پاچا قوي شو، نو هغه مغرور شو چې همدا یې د رانسکورېدلو سبب شو. عزیا د خپل څښتن خدای سره خیانت وکړ، ځکه چې د څښتن کور ته ننوت چې خوشبویۍ د سوځولو د قربانۍ ځای کې وسوځوي."}, {"ref": "2 Chronicles 2:16", "text": "کاهنان د څښتن کور ته ننوتل چې هغه پاک کړي او هغوی هر هغه څه د کور حوېلۍ ته راوویستل چې ناپاک وو. د هغه ځای نه لاویانو دا ټول شیان د ښار څخه دباندې د قدرون درې ته یووړل."}, {"ref": "2 Chronicles 2:17", "text": "تاسو به حتی جګړې ته هم مجبور نه شئ. یوازې په خپلو ځایونو کې ځای په ځای شئ او انتظار وکړئ، تاسو به ووینئ چې څښتن به تاسو د خپلو دښمنانو څخه وژغوري. ای د یهودا او د اورشلیم خلکو، مه وېرېږئ او مه بې‌زړه کېږئ. سبا ووځئ او د هغوی په وړاندې ودرېږئ. څښتن به ستاسو سره مل وي.›»"}, {"ref": "2 Chronicles 2:17", "text": "هغوی په یهودا باندې حمله وکړه، شاهي ماڼۍ یې لوټ کړه او پرته له اخزیا چې د هغه کشر زوی ؤ هغوی د پاچا ټولې ښځې او زامن د اسیرانو په توګه بوتلل."}, {"ref": "2 Chronicles 2:17", "text": "بیا ټول خلک د بعل بتخانې ته ورغلل او هغه یې راوغورځوله. هغوی د قربانۍ ځایونه او بتان ټوټې ټوټې کړل او متان چې د بعل کاهن ؤ هغه یې د قربانۍ د ځایونو مخې ته وواژه."}, {"ref": "2 Chronicles 2:17", "text": "وروسته له دې چې یهویاداع مړ شو، د یهودا مشران راغلل او پاچا ته یې د درناوي په خاطر خپل سرونه ټیټ کړل. هغوی پاچا راضي کړ چې د هغوی خبرو ته غوږ ونیسي."}, {"ref": "2 Chronicles 2:17", "text": "د یهودا پاچا امصیا د خپلو مشاورانو سره خبرې وکړې، بیا یې د اسراییلو پاچا د ییهو لمسي او د یهواخاز زوی یهواش ته داسې پیغام ورولېږه: «راووځه او په جګړه کې زما سره مخامخ شه!»"}, {"ref": "2 Chronicles 2:17", "text": "خو عزریا کاهن چې اتیا تنه قوي او زړور د څښتن کاهنان ورسره وو، عزیا پسې لاړ،"}, {"ref": "2 Chronicles 2:17", "text": "د لومړۍ میاشتې په لومړۍ ورځ کار پیل شو او په اتمه ورځ هغوی دا ټول کار د څښتن د کور تر برنډې پورې ورساوه. بیا هغوی نورې اته ورځې کار وکړ او د میاشتې تر شپاړسمې ورځې پورې یې د څښتن کور پاک او هغه یې د عبادت دپاره تیار کړ."}, {"ref": "2 Chronicles 2:18", "text": "بیا یهوشافاط پاچا په ځمکه باندې پړمخې پرېوت او سجده یې وکړه او نورو ټولو د یهودا او د اورشلیم خلک هم په سجده پرېوتل او د څښتن عبادت یې وکړ."}, {"ref": "2 Chronicles 2:18", "text": "بیا وروسته له هغې څښتن یهورام پاچا د کولمو په یوې نه‌رغېدونکې ناروغۍ اخته کړ."}, {"ref": "2 Chronicles 2:18", "text": "یهویاداع کاهنان او لاویان د څښتن د کور د کار مسوولان وټاکل. هغوی به هغه دندې سرته رسولې چې د داود پاچا له خوا ورته سپارل شوې وې او هغه قربانۍ به یې سوځولې چې څښتن ته د موسی د شریعت له مخې وړاندې کېدلې. هغوی د موسیقۍ او د جشنونو مسوولان هم وو."}, {"ref": "2 Chronicles 2:18", "text": "نو خلکو د څښتن یعنې د هغوی د نیکونو د خدای په کور کې عبادت کول بس کړل او د اشیره او د نورو بتانو عبادت یې پیل کړ. د هغوی د دې ګناه په سبب د څښتن قهر په یهودا او په اورشلیم باندې نازل شو."}, {"ref": "2 Chronicles 2:18", "text": "خو یهوآش بېرته دا ځواب ورولېږه: «یوځل په لبنان کې د اغزیو یو بوټي د سبر یوې ونې ته پیغام ورولېږه: ستا لور باید زما د زوی سره واده وکړي. خو یو وحشي ځناور راغی او هغه بوټی یې تر‌پښو لاندې کړ."}, {"ref": "2 Chronicles 2:18", "text": "چې هغه منع کړي. هغوی وویل: «عزیا! ته هېڅ حق نه لرې چې څښتن ته خوشبویي وسوځوې. یوازې هغه کاهنان چې د هارون د اولادې څخه دي، د دې کار دپاره وقف شوي دي. د دې سپېڅلي ځای نه لاړ شه. تا د څښتن خدای په وړاندې ګناه کړې ده او هغه به تاته نور عزت نه درکوي.»"}, {"ref": "2 Chronicles 2:18", "text": "په دې وخت کې فلسطینیانو په هغو ښارونو باندې حمله کوله چې د غرونو په لوېدیځو لمنو او جنوبي یهودا کې پراته وو. هغوی د بیت‌شمس، ایالون او د جدیروت ښارونه ونیول. همدارنګه یې د سوکوه، تمنه او د جمزو ښارونه د هغو د شاوخوا کلیو سره هم ونیول. بیا هغوی په دې ځایونو کې مېشت شول."}, {"ref": "2 Chronicles 2:18", "text": "بیا لاویان د حزقیا پاچا حضور ته ورغلل او ورته ویې ویل: «مونږ د څښتن د ټول کور د پاکولو کار پای ته ورساوه چې د سوځېدونکو نذرانو د قربانۍ ځای، د سپېڅلې ډوډۍ مېز او د هغو ټول سامان په کې شامل دي."}, {"ref": "2 Chronicles 2:19", "text": "بیا د قهات او د قورح د طایفو لاویان ودرېدل او په ډېر لوړ اواز یې د اسراییلو د څښتن خدای ثنا او صفت وکړ."}, {"ref": "2 Chronicles 2:19", "text": "د وخت په تېرېدلو سره د دوهم کال په اخر کې د ناروغۍ له امله د هغه کولمې راووتلې او هغه په رنځ او عذاب کې مړ شو. د هغه خلکو د هغه په ویاړ اور بل نه کړ لکه څنګه چې د هغه د نیکونو دپاره بل شوی ؤ."}, {"ref": "2 Chronicles 2:19", "text": "یهویاداع د څښتن د کور په دروازو کې ساتونکو ته دنده ورکړه چې ناپاکه خلکو ته د ننوتلو اجازه ورنه کړي."}, {"ref": "2 Chronicles 2:19", "text": "څښتن هغوی ته د خبرداري ورکولو دپاره نبیان ورولېږل چې بېرته هغه ته رجوع وکړي، خو خلکو ورته غوږ ونه نیوه."}, {"ref": "2 Chronicles 2:19", "text": "امصیا، ته اوس لافې وهې چې تا ادومیانو ته ماتې ورکړې ده، خو زه تاته دا مشوره درکوم چې په کور کې پاتې شه. که کومه ستونزه دې رامنځته کړه، ته او ستا د یهودا پاچاهي به له منځه لاړه شي.»"}, {"ref": "2 Chronicles 2:19", "text": "عزیا د څښتن په کور کې د خوشبویۍ د سوځولو د قربانۍ ځای په څنګ کې ولاړ ؤ او د خوشبویۍ د سوځولو لوښی یې په لاس کې ؤ. هغه په کاهنانو باندې په قهر شو او سمدلاسه یې په تندي باندې جذام راښکاره شو."}, {"ref": "2 Chronicles 2:19", "text": "له دې امله چې د یهودا پاچا آحاز خپل خلک بدکارۍ ته هڅولي وو او د څښتن نافرماني یې کړې وه، نو څښتن د یهودا خلک خوار او ذلیل کړل."}, {"ref": "2 Chronicles 2:19", "text": "مونږ هغه ټول سامان هم بېرته راوړی دی چې احاز پاچا د هغو کلونو په دوران کې وړی ؤ کله چې هغه خدای ته بې‌وفا شو او مونږ هغه بېرته وقف کړی دی. هغه ټول مو د څښتن د قربانۍ د ځای په مخکې ایښي دي.»"}, {"ref": "2 Chronicles 2:20", "text": "بله ورځ سهار وختي خلک د تقوع دښتې ته روان شول. څنګه چې هغوی حرکت وکړ، یهوشافاط ودرېده او ویې ویل: «د یهودا او د اورشلیم خلکو! په خپل څښتن خدای باندې باور وکړئ، ترڅو قوي اوسئ. د هغه د نبیانو په خبرو باندې باور وکړئ، نو تاسو به بریالي شئ.»"}, {"ref": "2 Chronicles 2:20", "text": "یهورام د دوه دېرش کلنۍ په عمر پاچا شوی ؤ او په اورشلیم کې یې اته کاله پاچاهي وکړه. د هغه په مړینې هېڅوک خواشینی نه شو. هغوی هغه د داود په ښار کې ښخ کړ، خو په شاهي هدیره کې یې ښخ نه کړ."}, {"ref": "2 Chronicles 2:20", "text": "په اخر کې یهویاداع ټول قوماندانان، د یهودا ډېر مهم ښاریان او حکومتي مامورین راوغوښتل. څنګه چې هغوی یوآش د څښتن د کور څخه د پورتنۍ دروازې په لاره ماڼۍ ته روان کړ، د خلکو ګڼه‌ګوڼه هغوی پسې روانه شوه او هلته یې هغه د یهودا د پاچا په توګه په تخت کښېناوه."}, {"ref": "2 Chronicles 2:20", "text": "بیا د څښتن روح د یهویاداع کاهن په زوی یعنې په زکریا باندې نازل شو. هغه په داسې ځای کې ودرېده چې خلکو ته ښکاره کېده او غږ یې وکړ: «څښتن خدای پوښتنه کوي: ‹ولې تاسو زما د حکمونو څخه سرغړونه کړې ده او په ځان باندې افت راولئ؟ د دې په خاطر چې تاسو زما څخه مخ اړولی، ما هم ستاسو څخه مخ اړولی دی.›»"}, {"ref": "2 Chronicles 2:20", "text": "خو امصیا ورته غوږ ونه نیوه. دا د خدای رضا وه چې امصیا او د هغه عسکر د دښمن لاس ته ولویږي، ځکه چې هغوی د ادومي بتانو عبادت کړی ؤ."}, {"ref": "2 Chronicles 2:20", "text": "لوی کاهن عزریا او نورو کاهنانو په وېرې سره د پاچا تندي ته کتل او بیا یې هغه په بیړه د څښتن د کور څخه دباندې وویست. هغه زر زر د هغه ځای څخه لاړ، ځکه چې څښتن هغه په مرض باندې اخته کړ."}, {"ref": "2 Chronicles 2:20", "text": "بیا د آشور پاچا تغلت فلاسر یهودا ته راغی، خو د دې په ځای چې د آحاز سره مرسته وکړي، د هغه مخالفت یې وکړ او هغه یې د کړاوونو سره مخامخ کړ."}, {"ref": "2 Chronicles 2:20", "text": "حزقیا پاچا بله ورځ سهار وختي د ښار مشران راټول کړل او هغوی یو ځای د څښتن کور ته لاړل."}, {"ref": "2 Chronicles 2:21", "text": "د خلکو سره د مشورې څخه وروسته هغه څو کسان وټاکل. د پاچا په امر هغوی سپېڅلي کالي واغوستل، د دې دپاره چې د لښکر مخې ته لاړ شي او د څښتن د ستاینې دپاره دا سندره ووایي: د څښتن شکر کوئ ده ابدي د هغه مینه"}, {"ref": "2 Chronicles 2:21", "text": "نو ټولو خلکو خوشحالي کوله او په ښار کې کراره کراري وه، ځکه چې عتلیا وژل شوې وه."}, {"ref": "2 Chronicles 2:21", "text": "یوآش پاچا د زکریا په خلاف په دسیسه کې ملګری شو او خلکو د پاچا په امر زکریا د څښتن د کور په حوېلۍ کې سنګسار کړ."}, {"ref": "2 Chronicles 2:21", "text": "نو د اسراییلو پاچا یهوآش د یهودا د پاچا امصیا په ضد جګړې ته لاړ. هغوی د یهودا په بیت‌شمس کې سره مخامخ شول"}, {"ref": "2 Chronicles 2:21", "text": "عزیا پاچا د عمر تر پایه پورې د جذام په ناروغۍ اخته ؤ او له همدې امله هغه د خلکو او د څښتن د کور نه لېرې په یو کور کې اوسېده. د هغه زوی یوتام د ماڼۍ او هېواد واک درلود."}, {"ref": "2 Chronicles 2:21", "text": "نو آحاز د څښتن د کور، د ماڼۍ او د خلکو د مشرانو د کورونو څخه قیمتي شیان واخیستل او د آشور پاچا ته یې ورکړل، خو دې کار هم څه ګټه ونه کړه."}, {"ref": "2 Chronicles 2:21", "text": "هغوی د شاهي کورنۍ او د یهودا د خلکو دپاره او همدارنګه د څښتن د کور د پاکوالي دپاره اووه غویان، اووه پسونه، اووه وري او اووه سېرلي د ګناه د نذرانې په توګه راوړل. پاچا کاهنانو یعنې د هارون اولادې ته امر وکړ چې هغه د څښتن د قربانۍ په ځای باندې قرباني کړي."}, {"ref": "2 Chronicles 2:22", "text": "څنګه چې هغوی د څښتن د ستاینې سندرې پیل کړې، څښتن یرغلګرې لښکرې په وارخطایۍ اخته کړې،"}, {"ref": "2 Chronicles 2:22", "text": "پاچا هغه د وفادارۍ خدمتونه هېر کړل چې د زکریا پلار یهویاداع د هغه دپاره کړي وو او هغه زکریا وواژه. زکریا د ځنکدن په وخت کې غږ وکړ: «څښتن دې ستا دا اعمال وویني او ستا نه دې زما بدل واخلي!»"}, {"ref": "2 Chronicles 2:22", "text": "او د یهودا لښکرو ماتې وخوړله. د یهودا ټول عسکر بېرته خپلو کورونو ته وتښتېدل."}, {"ref": "2 Chronicles 2:22", "text": "هغه نور ټول کارونه د پیل نه تر پایه پورې چې عزیا پاچا د خپلې پاچاهۍ په دوران کې کړي وو، د آموص زوی اشعیا نبي ثبت کړل."}, {"ref": "2 Chronicles 2:22", "text": "حتی وروسته له دې چې په احاز باندې دا وېروونکې پېښې وشوې، هغه د څښتن په وړاندې د پخوا څخه هم زیاته ګناه وکړه."}, {"ref": "2 Chronicles 2:22", "text": "کاهنانو لومړی غویان، بیا پسونه او بیا یې وري حلال کړل. د هرې قربانۍ د حلالېدلو څخه وروسته یې د هغو وینه د قربانۍ په ځای باندې وشیندله."}, {"ref": "2 Chronicles 2:23", "text": "نو د عمونیانو او موآبیانو عسکرو د ادوم په عسکرو باندې حمله وکړه او په پوره توګه یې له منځه یووړل. بیا هغوی د یو بل په خلاف شول او تر هغه وخته پورې سره وجنګېدل، ترڅو چې ټول لښکر له منځه لاړ!"}, {"ref": "2 Chronicles 2:23", "text": "د هماغه کال په اخر کې د سوریې لښکرو په یهودا او په اورشلیم باندې حمله وکړه، د قوم ټول مشران یې ووژل او ټول غنیمت یې خپل پاچا ته چې په دمشق کې ؤ، ولېږه."}, {"ref": "2 Chronicles 2:23", "text": "یهواش، د یوآش زوی او د اخزیا لمسی امصیا، ونیوه او اورشلیم ته یې بوته. هلته یې د ښار دېوال د افرایم د دروازې څخه نیولې د کنج تر دروازې پورې وران کړ. د دېوال برخه نژدې دوه سوه متره اوږده وه."}, {"ref": "2 Chronicles 2:23", "text": "عزیا مړ شو او د دې په خاطر چې هغه په جذام اخته ؤ، هغه یې په ځانګړې شاهي هدیره کې ښخ نه کړ. د هغې په ځای یې هغه د پاچاهانو په یوې بلې هدیره کې ښخ کړ. بیا د عزیا زوی یوتام د هغه په ځای پاچا شو."}, {"ref": "2 Chronicles 2:23", "text": "هغه د ځان سره وویل: «د سوریایانو خدایانو به هرومرو د هغوی د پاچاهانو سره مرسته کړې وي چې ماته ماتې راکړي. کېدای شي که چېرې زه هغو خدایانو ته قربانۍ وړاندې کړم، زما سره به هم مرسته وکړي.» دا هغه ګناه وه چې په اخر کې د احاز د رانسکورېدلو او د ټولو اسراییلیانو د تباهۍ سبب شوه."}, {"ref": "2 Chronicles 2:23", "text": "په پای کې کاهنانو وزې د ګناه د نذرانې دپاره پاچا او نورو عبادت کوونکو ته وروړلې او عبادت کوونکو خپل لاسونه ورباندې کېښودل."}, {"ref": "2 Chronicles 2:24", "text": "کله چې د یهودا لښکر هغه برج ته ورسېده چې دښتې ته مخامخ ؤ، هغوی ولیدل چې ټول دښمنان یې په ځمکه باندې مړه پراته دي. یو یې هم نه ؤ تښتېدلی."}, {"ref": "2 Chronicles 2:24", "text": "د سوریې لښکر کوچنی ؤ، خو څښتن هغوی پرېښودل چې د یهودا یو ډېر لوی لښکر ته ماتې ورکړي، ځکه چې خلکو د خپلو نیکونو د څښتن خدای څخه مخ اړولی ؤ. په دې ډول یوآش پاچا ته سزا ورکړل شوه."}, {"ref": "2 Chronicles 2:24", "text": "هغه د څښتن د کور ټول سره او سپین زر د غنیمت په توګه سامریې ته یووړل، همدارنګه هغه سامان یې هم یووړ چې د عوبید ادوم اولادې یې ساتنه کوله او د ماڼۍ خزانې یې هم یووړې. ځینې خلک یې یرغمل ونیول او بیا سامریې ته راستون شو."}, {"ref": "2 Chronicles 2:24", "text": "برسېره پردې، هغه د خدای د کور ټول سامان واخیست او هغه یې ټوټې ټوټې کړ. هغه د څښتن کور بند کړ او د اورشلیم په هره برخه کې یې د قربانۍ ځایونه جوړ کړل."}, {"ref": "2 Chronicles 2:24", "text": "بیا کاهنانو سېرلي حلال کړل او د هغو وینه یې د ټولو خلکو د ګناه د کفارې دپاره د قربانۍ په ځای باندې وشیندله، ځکه چې پاچا امر کړی ؤ چې سوځېدونکې نذرانې او د ګناه نذرانې دې د ټولو اسراییلو دپاره وړاندې شي."}, {"ref": "2 Chronicles 2:25", "text": "نو یهوشافاط او د هغه عسکر ورغلل چې غنیمت راټول کړي. هغوی ډېر سامان، کالي او نور قیمتي شیان وموندل. غنیمت دومره زیات ؤ چې هغوی وړلی نه شو. هغه دومره ډېر ؤ چې په راټولولو کې یې درې ورځې ولګېدلې."}, {"ref": "2 Chronicles 2:25", "text": "هغه ډېر سخت زخمي شو او کله چې دښمنان لاړل، د هغه دوو درباریانو هغه ته دسیسه جوړه کړه. هغه یې په خپله بستره کې وواژه او د یهویاداع کاهن د زوی د قتل بدل یې ورڅخه واخیست. هغه د داود په ښار کې ښخ شو، خو په شاهي هدیره کې ښخ نه شو."}, {"ref": "2 Chronicles 2:25", "text": "د یهواش د مړینې څخه وروسته امصیا پنځلس کاله ژوند وکړ."}, {"ref": "2 Chronicles 2:25", "text": "هغه د یهودا په هر ښار کې بتانو ته د عبادت ځایونه جوړ کړل چې پردیو خدایانو ته خوشبویي په کې وسوځول شي. هغه په دې ډول د خپلو نیکونو څښتن خدای په خپل ځان باندې په قهر کړ."}, {"ref": "2 Chronicles 2:25", "text": "پاچا په هغه حکم باندې عمل وکړ چې څښتن داود پاچا ته د پاچا د نبي یعنې د جاد او د ناتان نبي په وسیله کړې وې. حزقیا لاویان د څښتن په کور کې په داسې حال کې ودرول چې شرنګېدونکي زنګونه، چنګونه او ربابونه،"}, {"ref": "2 Chronicles 2:26", "text": "بیا په څلورمه ورځ هغوی د برکت په دره کې راټول شول او هلته یې د څښتن ستاینه وکړه. نو ځکه هغه دره تر‌اوسه پورې د برکت د درې په نوم یادیږي."}, {"ref": "2 Chronicles 2:26", "text": "هغو کسانو چې د هغه په ضد یې دسیسه جوړه کړه، زاباد د شمعت عمونۍ زوی او یهوزاباد د شمریت موآبۍ زوی ؤ."}, {"ref": "2 Chronicles 2:26", "text": "امصیا چې د خپلې پاچاهۍ د پیل نه تر پایه پورې نور څه کړي دي، هغه د اسراییلو او د یهودا د پاچاهانو په تاریخ کې لیکل شوي دي."}, {"ref": "2 Chronicles 2:26", "text": "آحاز چې د خپلې پاچاهۍ په دوران کې د اول نه تر پایه نور څه کړي وو، د یهودا او د اسراییلو د پاچاهانو د تاریخ په کتاب کې لیکل شوي دي."}, {"ref": "2 Chronicles 2:26", "text": "یعنې هغه ډول الې ورسره وې چې داود پاچا ورڅخه کار اخیستی ؤ. کاهنان هم د سرنیو سره هلته ودرېدل."}, {"ref": "2 Chronicles 2:27", "text": "د یوآش د زامنو کیسې، هغه پېشګویانې چې د هغه په ضد شوې دي او هغه څنګه د خدای کور بیا جوړ کړ، دا ټول د پاچاهانو د کتاب په تفسیر کې لیکل شوي دي. د هغه زوی امصیا د هغه په ځای پاچا شو."}, {"ref": "2 Chronicles 2:27", "text": "د هغه وخت راهیسې چې هغه د څښتن څخه مخ اړولی دی، په اورشلیم کې د امصیا د وژلو دپاره دسیسه جوړه شوه، نو هغه د لاخیش ښار ته وتښتېده. خو دښمنانو یې امصیا پسې نور خلک ورولېږل او هغه یې هلته وواژه."}, {"ref": "2 Chronicles 2:27", "text": "آحاز مړ شو او په اورشلیم کې په یوه هدیره کې چې شاهي هدیره نه وه، ښخ شو. بیا د هغه زوی حزقیا د هغه په ځای پاچا شو."}, {"ref": "2 Chronicles 2:27", "text": "حزقیا امر وکړ چې سوځېدونکې نذرانه دې د قربانۍ په ځای کې وړاندې شي. څنګه چې د هغې وړاندې کول پیل شول، خلکو څښتن ته د ستاینې سندرې وویلې او ساز غږوونکو د سرنیو او د موسیقۍ د نورو آلو په غږولو سره د هغوی ملګرتیا کوله."}, {"ref": "2 Chronicles 2:28", "text": "د هغه مړی په اس باندې بېرته اورشلیم ته یووړل شو او د داود د ښار په شاهي هدیره کې ښخ شو."}, {"ref": "2 Chronicles 2:28", "text": "ټول عبادت کوونکي په سجده شول او سندرو او د سرنیو غږول تر هغه وخته پورې دوام وموند، ترڅو چې د ګناه نذرانه وسوځېدله."}, {"ref": "2 Chronicles 2:29", "text": "کله چې نورو ټولو پاچاهانو واورېدل چې څښتن څنګه د اسراییلو د دښمنانو په ضد جنګېدلی دی، په هغوی کې د خدای وېره راپیدا شوه."}, {"ref": "2 Chronicles 2:29", "text": "د مراسمو په پای کې حزقیا پاچا او ټول خلک په سجده شول او د خدای عبادت یې وکړ."}, {"ref": "2 Chronicles 2:30", "text": "په دې ډول یهوشافاط په سوله او ارامۍ کې پاچاهي وکړه، ځکه چې خپل خدای ورته له هرې خوا ارامي ورکړې وه."}, {"ref": "2 Chronicles 2:30", "text": "پاچا او د قوم مشرانو لاویانو ته امر وکړ چې څښتن ته د ستاینې هغه سندرې ووایي چې داود او اساف نبي لیکلې وې. نو هغوی په ډېرې خوښۍ سره سندرې وویلې، بیا هغوی په سجده شول او د خدای عبادت یې وکړ."}, {"ref": "2 Chronicles 2:31", "text": "یهوشافاط د پنځه دېرشو کالو په عمر ؤ چې د یهودا پاچا شو او هغه په اورشلیم کې پنځه ویشت کاله پاچاهي وکړه. د هغه د مور نوم عزوبه وه چې د شلحي لور وه."}, {"ref": "2 Chronicles 2:31", "text": "حزقیا خلکو ته وویل: «اوس چې تاسو د سپېڅلتوب له مراسمو سره خپل ځانونه څښتن ته وقف کړل، نو د هغه کور ته قربانۍ او د شکرانې نذرانې راوړئ.» خلکو دا خبره ومنله او د هغوی څخه ځینو په خپله خوښه حیوانات هم راوستل چې د سوځېدونکو نذرانو په توګه قرباني شي."}, {"ref": "2 Chronicles 2:32", "text": "هغه د خپل پلار آسا په شان هماغه کارونه وکړل چې د څښتن په نظر کې سم وو،"}, {"ref": "2 Chronicles 2:32", "text": "هغوی اویا غویان، سل پسونه او دوه سوه وري د سوځېدونکو نذرانو په توګه د څښتن دپاره راوړل."}, {"ref": "2 Chronicles 2:33", "text": "خو سیمه‌ییز عبادتځایونه وران نه شول. خلکو لا د زړه له کومي د خپلو نیکونو د خدای عبادت نه ؤ غوره کړی."}, {"ref": "2 Chronicles 2:33", "text": "هغه حیوانات چې د قربانیو دپاره سپېڅلي شوي وو، د هغو شمېر شپږ سوه غویانو او درې زره پسونو ته رسېده."}, {"ref": "2 Chronicles 2:34", "text": "یهوشافاط چې د خپلې پاچاهۍ د پیل څخه تر پایه پورې نور څه کارونه کړي وو، د حناني د زوی د ییهو په تاریخ کې چې د اسراییلو د پاچاهانو د تاریخ د کتاب یوه برخه ده، لیکلي دي."}, {"ref": "2 Chronicles 2:34", "text": "له دې امله چې د کاهنانو شمېر لږ ؤ، هغوی نه شو کولای چې د قربانۍ د ټولو حیواناتو پوستکي وباسي، نو ځکه ترڅو چې نورو کاهنانو خپل ځانونه پاک کړل، د هغوی ورونه یعنې لاویان د دې کار د سرته رسولو دپاره حاضر شول چې د هغوی سره مرسته وکړي. د ځان په پاک ساتلو کې د کاهنانو په پرتله لاویان وفادار وو."}, {"ref": "2 Chronicles 2:35", "text": "یوځل د یهودا پاچا یهوشافاط د اسراییلو د پاچا اخزیا سره چې ډېر بد کارونه یې کړي وو، لاس یو کړ."}, {"ref": "2 Chronicles 2:35", "text": "د زیات شمېر سوځېدونکو نذرانو څخه پرته کاهنانو د سلامتۍ د نذرانو د وازګې د سوځولو مسوولیت په غاړه درلود. همدارنګه یې د هغو شرابو د تویولو مسوولیت هم په غاړه درلود چې د سوځېدونکو نذرانو سره وړاندې کېدل. په دې ډول د څښتن کور د عبادت دپاره تیار شو."}, {"ref": "2 Chronicles 2:36", "text": "هغوی د عصیون‌جابر په بندر کې بحري کشتۍ‌ګانې جوړې کړې."}, {"ref": "2 Chronicles 2:36", "text": "حزقیا پاچا او ټولو خلکو د دې دپاره خوشحالي کوله چې خدای ورسره مرسته وکړه چې دا ټول کارونه زر تر‌سره کړي."}, {"ref": "2 Chronicles 2:37", "text": "خو د دودواهو زوی الیعازر چې د مریشه له ښارګوټي څخه ؤ، یهوشافاط ته پېشګویي وکړه: «د دې په خاطر چې تا د اخزیا سره لاس یو کړی دی، څښتن به هغه شیان له منځه یوسي چې تا جوړ کړي دي.» نو بیا ټولې کشتۍ‌ګانې ماتې شوې او هېڅکله له بندر نه لاړې نه شوې."}, {"ref": "2 Chronicles 3:1", "text": "وروسته له دې چې اختر پای ته ورسېده، د اسراییلو ټول خلک د یهودا هر ښار ته لاړل او د تیږو ستنې یې ماتې کړې، د اشیره بتان یې راوغورځول او د قربانۍ ځایونه او سیمه‌ییز عبادتځایونه یې وران کړل. هغوی د یهودا په پاتې سیمه کې او د بنیامین، افرایم او منسي په سیمو کې هم همداسې وکړل. بیا هغوی ټول خپلو کورونو ته ستانه شول."}, {"ref": "2 Chronicles 3:1", "text": "له دې ښو او نېکو کارونو څخه وروسته چې حزقیا پاچا په وفادارۍ سره سرته ورسول، د آشور پاچا سناخاریب په یهودا باندې حمله وکړه. هغه هغه قوي شوي ښارونه کلابند کړل او غوښتل یې چې دا ښارونه ونیسي."}, {"ref": "2 Chronicles 3:1", "text": "منسي دولس کلن ؤ چې د یهودا پاچا شو او هغه په اورشلیم کې پنځه پنځوس کاله پاچاهي وکړه."}, {"ref": "2 Chronicles 3:1", "text": "یوشیا اته کلن ؤ چې د یهودا پاچا شو او هغه په اورشلیم کې یودېرش کاله پاچاهي وکړه."}, {"ref": "2 Chronicles 3:1", "text": "یوشیا پاچا د څښتن د درناوي دپاره په اورشلیم کې د فسحې اختر ولمانځه. هغوی د لومړۍ میاشتې په څوارلسمه ورځ د اختر دپاره وري حلال کړل."}, {"ref": "2 Chronicles 3:1", "text": "د یهودا خلکو د یوشیا زوی یهوآحاز غوره کړ او هغه یې په اورشلیم کې پاچا کړ."}, {"ref": "2 Chronicles 3:2", "text": "حزقیا پاچا د کاهنانو او د لاویانو ډلې بېرته جوړې کړې او په دې ډلو کې هر یو تن ځانګړې دندې درلودلې. په دغو دندو کې د سوځېدونکو نذرانو او د سلامتۍ نذرانو وړاندې کول، د خدای په کور کې په عبادت کې برخه اخیستل، شکرګزاري کول او د کور په دروازو کې ستاینه کول شامل وو."}, {"ref": "2 Chronicles 3:2", "text": "کله چې حزقیا ولیدل چې سناخاریب په اورشلیم باندې هم د حملې کولو نیت لري،"}, {"ref": "2 Chronicles 3:2", "text": "منسي د څښتن په وړاندې ګناه وکړه. هغه د هغو قومونو د ناوړه دودونو څخه پیروي وکړه چې څښتن د خپل قوم د وړاندې تګ سره سم شړلي وو."}, {"ref": "2 Chronicles 3:2", "text": "یوشیا هغه کار کاوه چې د څښتن په نظر کې ښه ؤ. هغه د خپل نیکه داود لاره غوره کړه او په ټینګه یې د څښتن د ټولو قوانینو اطاعت کاوه."}, {"ref": "2 Chronicles 3:2", "text": "هغه کاهنانو ته دندې وروسپارلې او د څښتن په کور کې یې خدمت ته وهڅول."}, {"ref": "2 Chronicles 3:2", "text": "یهوآحاز درویشت کلن ؤ چې د یهودا پاچا شو او درې میاشتې یې په اورشلیم کې پاچاهي وکړه."}, {"ref": "2 Chronicles 3:3", "text": "حزقیا پاچا د خپلو رمو او پادو څخه هر سهار او ماښام د سوځېدونکو نذرانو دپاره حیوانات تیارول او همدارنګه د سبت په ورځ د نوې میاشتې په اختر کې او په هغو نورو اخترونو کې چې د څښتن د شریعت غوښتنه وه، حیوانات برابرول."}, {"ref": "2 Chronicles 3:3", "text": "منسي د عبادت هغه سیمه‌ییز ځایونه بېرته جوړ کړل چې د هغه پلار حزقیا وران کړي وو. هغه د بعل دپاره د قربانۍ ځایونه او د اشیره بتان جوړ کړل او د ستورو عبادت یې کاوه."}, {"ref": "2 Chronicles 3:3", "text": "د یوشیا د پاچاهۍ په اتم کال کله چې هغه لا ډېر ځوان ؤ، هغه د خپل نیکه یعنې د داود پاچا د خدای په عبادت کولو پیل وکړ. وروسته د څلورو کالو هغه یهودا او اورشلیم د سیمه ایزو عبادتځایونو، د اشیره د بتانو او د نورو ټولو بتانو څخه پاکول پیل کړل."}, {"ref": "2 Chronicles 3:3", "text": "هغه لاویانو ته چې ټولو اسراییلیانو ته یې تعلیم ورکاوه او د څښتن خدمت ته وقف شوي وو، دا لارښوونه وکړه: «د لوظ سپېڅلی صندوق په هغه کور کې کېږدئ چې د داود زوی سلیمان پاچا جوړ کړی دی. تاسو به نور هغه د یو ځای څخه بل ځای ته نه وړئ، بلکې د خپل څښتن خدای او د هغه د قوم یعنې د اسراییلو خدمت به کوئ."}, {"ref": "2 Chronicles 3:3", "text": "د مصر پاچا نیکو هغه د تخت څخه لېرې کړ او د یهودا خلک یې مجبور کړل چې هغه ته درې زره او څلور سوه کیلو‌ګرامه سپین زر او څلوردېرش کیلو‌ګرامه سره زر باج ورکړي."}, {"ref": "2 Chronicles 3:4", "text": "د هغوی پلان پاچا او ټولو خلکو ته ښه ښکاره شو،"}, {"ref": "2 Chronicles 3:4", "text": "برسېره پردې، پاچا د اورشلیم خلکو ته وویل هغه نذرانې راوړي چې کاهنانو او لاویانو یې د اخیستلو حق درلود، ترڅو هغوی وکولای شي چې د څښتن د شریعت د شرطونو د عملي کولو دپاره خپل ټول وخت وقف کړي."}, {"ref": "2 Chronicles 3:4", "text": "هغه په اورشلیم کې د څښتن په کور کې د نورو خدایانو دپاره د قربانۍ ځایونه جوړ کړل چې د هغو په اړه څښتن ویلي وو: «په دې ځای کې باید تل زما عبادت وشي.»"}, {"ref": "2 Chronicles 3:4", "text": 