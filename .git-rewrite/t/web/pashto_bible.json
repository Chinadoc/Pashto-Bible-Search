ئى چې، ”کله چې دا ښار د حنن‌ايل د برج نه واخله تر د ګوټ د دروازې پورې به دوباره زما دپاره آباد شى."}, {"ref": "None Jeremiah 3:38", "text": "بيا به هغوئ زما خلق وى او زۀ به د هغوئ خُدائ پاک يم."}, {"ref": "None Jeremiah 3:39", "text": "او د هغه ځائ نه به سيدها د ښار حدود جارب غونډۍ پورې ورسيږى او بيا به د جوعه طرف ته راتاو شى."}, {"ref": "None Jeremiah 3:39", "text": "زۀ به هغوئ ته د زړۀ او د سوچ يووالے ورکړم چې د خپل ځان د خوشحالۍ او د خپل نسل د آبادۍ او سکون دپاره به زما نه همېشه يريږى."}, {"ref": "None Jeremiah 3:40", "text": "نو بيا به ټوله دره چرته چې د مړو لاشونه او ايرې غورزولے شى او هغه ټوله زمکه د کومې مېدانونه چې د قِدرون د درې د نمرخاتۀ پورې پراتۀ دى، او د آسونو د دروازې پورې، ټوله به مالِک خُدائ ته مقدسه وى. دا ښار به هيڅکله بيا د بېخ نه راونۀ ويستلے شى او نۀ به تباه شى.“"}, {"ref": "None Jeremiah 3:40", "text": "زۀ به د هغوئ سره ابدى لوظ وکړم، چې زۀ به د هغوئ سره ښېګړه کول هيڅکله نۀ پرېږدم. او زۀ به خپله يره د هغوئ په زړُونو کښې واچوم، ترڅو چې نور هغوئ ما نه لرې لاړ نۀ شى."}, {"ref": "None Jeremiah 3:41", "text": "هغوئ ته په برکت ورکولو سره ما ته خوشحالى ملاويږى، او زۀ به په وفادارۍ او پوره زړۀ سره هغوئ په دې مُلک کښې دوباره آباد کړم."}, {"ref": "None Jeremiah 3:42", "text": "لکه څنګه چې ما په دې خلقو دا لوئ افت راوستو، نو دغه شان به زۀ دوئ ته هغه ټولې سوکالۍ هم ورکړم د کومې چې ما هغوئ سره وعده کړې ده."}, {"ref": "None Jeremiah 3:43", "text": "نو يو ځل به بيا په دې مُلک کښې زمکې واخستلے شى، د کوم چې تاسو وايئ چې دا خو صحرا او بې‌کاره زمکه ده، بغېر د انسانانو او ځناورو، ځکه چې دا خو بابليانو ته په قبضه کښې ورکړے شوې وه."}, {"ref": "None Jeremiah 3:44", "text": "آو، د بنيامين په علاقه، د يروشلم په خوا او شا، د يهوداه په ښارونو، غريزه علاقو، د غرونو په کلو، مغربى صحراګانو او په نجب کښې به زمکې د سپينو زرو سيکو باندې اخستلے کيږى او مهر شوى انتقالونه او ګواهان به په کښې نيولے کيږى، ځکه چې زۀ به دا قوم د غلامۍ نه واپس راولم. دا د مالِک خُدائ فرمان دے.“"}, {"ref": "None Jeremiah 4:1", "text": "د مالِک خُدائ پېغام يرمياه ته پس د هغې نه ورکړے شو کله چې د فوج کمانډر نبوزردان هغه په راما کښې آزاد کړو. نو هغۀ يرمياه هم د يروشلم او يهوداه په هغه کسانو کښې په زنځيرونو تړلے وموندلو څوک چې بابل ته جلاوطن کېدلو."}, {"ref": "None Jeremiah 4:1", "text": "هم د هغه کال په اوومه مياشت، اِسمٰعيل د نتنياه زوئ او د اليسمع نمسے چې د شاهى خاندان يو کس وو، او د اوچتې عُهدې آفسر وو، هغه د لسو سړو سره مصفاه ته د جدلياه سره مِلاوېدو له لاړو. کله چې هغوئ په شريکه روټۍ خوړله،"}, {"ref": "None Jeremiah 4:1", "text": "نو بيا د فوج ټول جنګى مشران، يوحانان د قريح زوئ او يزنياه د هوسعياه زوئ، او د وړو نه تر لويو پورې ټول خلق"}, {"ref": "None Jeremiah 4:1", "text": "کله چې يرمياه د مالِک خُدائ د دوئ د خُدائ پاک هغه پېغام بيانول ټولو خلقو ته ختم کړو کوم يې چې دوئ ته رالېږلے وو،"}, {"ref": "None Jeremiah 4:1", "text": "دا پېغام يرمياه ته د يهوداه د خلقو په حقله ورکړے شو څوک چې د مِصر په جنوبى ښارونو کښې لکه مجدال، تحفنحيس، ميمفِس او څوک چې په بره برخو کښې اوسېدل،"}, {"ref": "None Jeremiah 4:1", "text": "يرمياه نبى باروک د نيرياه زوئ ته د يهويقيم د يوسياه د زوئ د بادشاهۍ په څلورم کال چې د يهوداه بادشاه وو پېغام ورکړو د دې نه وروستو کله چې باروک په طومار کښې هغه څۀ وليکل کوم چې ورته يرمياه فرمائيلى وُو."}, {"ref": "None Jeremiah 4:1", "text": "مالِک خُدائ د غېر‌يهوديانو په حقله يرمياه نبى ته پېغام ورولېږلو."}, {"ref": "None Jeremiah 4:1", "text": "دا د مالِک خُدائ هغه کلام دے چې د فِرعون د لښکرو په غزه د حملې کولو نه مخکښې، په يرمياه نبى د فلستيانو په حقله نازل شو."}, {"ref": "None Jeremiah 4:1", "text": "مالِک خُدائ ربُ الافواج د بنى اِسرائيلو خُدائ پاک د موآب په حقله فرمائى، ”په نبو ښار باندې افسوس، ځکه چې دا ښار به تباه شى. د قِريَتائم بې‌حرمتى به وشى او قبضه به کړے شى. او د مضبوطې قلعه بې‌حرمتى به وشى او ټوټه ټوټه به شى."}, {"ref": "None Jeremiah 4:1", "text": "د عمونيانو په حقله مالِک خُدائ فرمائى چې، ”آيا د بنى اِسرائيلو څوک اولاد نشته؟ او د هغوئ څوک وارث نشته؟ نو بيا ولې د مولک بُت تابعدارى کوونکو د جاد په مال حال قبضه کړې ده او د هغوئ په ښارونو کښې اوسيږى؟“"}, {"ref": "None Jeremiah 4:2", "text": "د فوج کمانډر يرمياه ته آواز وکړو او ورته يې ووئيل چې، ”مالِک خُدائ ستا مقدس رب دا تباهى په دې مُلک نازله کړې ده."}, {"ref": "None Jeremiah 4:2", "text": "نو ناګهانه د نتنياه زوئ اِسمٰعيل او د هغۀ لسو کسانو ټوپ کړو او خپلې تُورې يې راوويستلې او جدلياه يې قتل کړو، څوک چې د بابل بادشاه په يهوداه کښې ګورنر مقرر کړے وو."}, {"ref": "None Jeremiah 4:2", "text": "يرمياه نبى ته راغلل او ورته يې ووئيل، ”مونږ ستا مِنت کوُو چې زمونږ دپاره د مالِک خُدائ ستا مقدس خُدائ نه دُعا وغواړه، کوم چې پاتې شوى کسان يُو. لکه څنګه چې تۀ وينې چې د مخکښې په مقابل کښې اوس مونږ ډېر لږ يُو."}, {"ref": "None Jeremiah 4:2", "text": "نو عزرياه د هوسعياه زوئ او يوحانان د قريح زوئ او نورو ټولو کبرژنو خلقو يرمياه ته ووئيل چې، ”تۀ دروغ وائې، مالِک خُدائ زمونږ خُدائ پاک مونږ کله هم مِصر ته د تلو نه منع کړى نۀ يُو."}, {"ref": "None Jeremiah 4:2", "text": "”مالِک خُدائ ربُ الافواج د بنى اِسرائيلو خُدائ پاک فرمائى چې، تاسو هغه تباهى په خپله وليده چې کومه ما په يروشلم او د يهوداه په نورو ټولو ښارونو باندې راوستله. او نن دا شاړ او تباه شوى پراتۀ دى،"}, {"ref": "None Jeremiah 4:2", "text": "”اے باروکه، دا هغه څۀ دى چې مالِک خُدائ د بنى اِسرائيلو خُدائ پاک يې تاسو ته فرمائى چې،"}, {"ref": "None Jeremiah 4:2", "text": "کوم پېغام چې د مِصر په حقله وو هغه دا وو چې، د يهوداه بادشاه يهويقيم د يوسياه د زوئ د بادشاهۍ په څلورم کال، د کرکميس د جنګ په موقع کله چې فِرعون نِکوه د مِصر بادشاه او د هغۀ فوجيانو د فرات د سيند سره نزدې د بابل بادشاه نبوکدنضر نه شکست وخوړو."}, {"ref": "None Jeremiah 4:2", "text": "”مالِک خُدائ وفرمائيل چې، وګوره، د شمال نه اوبۀ څنګه راوچتيږى، او د سېلاب په شان په زور شور راروانې دى، دا به ټوله زمکه او هر څۀ چې په کښې دى رالاندې کړى، ښارونه او د هغې اوسېدونکى به ډوب کړى، ټول خلق به د مدد دپاره چغې وهى او څومره خلق چې په کښې اوسيږى هغوئ به ژړا کوى."}, {"ref": "None Jeremiah 4:2", "text": "د نن نه پس به څوک هم د موآب تعريف ونۀ کړى، په حسبون کښې به خلق د هغې د راغورزولو منصوبې جوړوى، هغوئ وائى راځئ چې د موآب نوم او نشان ختم کړُو. اے د مدمين ښاريې، تۀ به هم خاموشه شې، او تاسو به په تُوره مړۀ شئ."}, {"ref": "None Jeremiah 4:2", "text": "مالِک خُدائ فرمائى، ”خو هغه ورځې راروانې دى کله چې زۀ به د عمونيانو د ربه د ښار خلاف د جنګ آواز وکړم. دا ښار به د تباهۍ نه د خاورو يو ډېرے جوړ شى، او د خوا او شا کلى به يې وسوزولے شى. نو بيا به بنى اِسرائيل هغه کسان وشړى چا چې دوئ شړلى وُو."}, {"ref": "None Jeremiah 4:3", "text": "لکه څنګه چې هغۀ فرمائيلى وُو هغه شان يې وکړل. ځکه چې دې خلقو د مالِک خُدائ خلاف ګناه وکړه او د هغۀ نافرمانى يې وکړه."}, {"ref": "None Jeremiah 4:3", "text": "اِسمٰعيل هم هغه ټول يهوديان ووژل څوک چې په مصفاه کښې د جدلياه سره وُو، او هغه بابليان فوجيان هم چې هلته وُو."}, {"ref": "None Jeremiah 4:3", "text": "زمونږ دپاره دُعا وکړه چې مالِک خُدائ زمونږ خُدائ پاک مونږ ته لارښودنه وکړى چې څۀ وکړُو او چرته لاړ شُو.“"}, {"ref": "None Jeremiah 4:3", "text": "تۀ باروک د نيرياه زوئ په دې رضا کړے يې چې داسې خبرې کوه، ځکه هغه غواړى چې مونږ دلته پاتې شُو او د بابليانو د لاسه مړۀ شُو او يا بابل ته جلاوطن کړے شُو.“"}, {"ref": "None Jeremiah 4:3", "text": "ځکه کوم بد کارونه چې هغوئ وکړل. هغوئ زما قهر په هغه خوشبو سوزولو او غېرو معبودانو ته په عبادت کولو راوچت کړو چې نۀ خو هغوئ او نۀ تاسو او نۀ د هغوئ پلار نيکۀ پېژندل."}, {"ref": "None Jeremiah 4:3", "text": "تا ووئيل چې افسوس دې په ما وى. زۀ د غمونو او تکليفونو د لاندې شوے يم. ولې زما دا دردونه کافى نۀ وُو څۀ؟ مالِک خُدائ زما په غمونو کښې اضافه وکړه. زۀ د اسويلو نه ستړے ستومانه شوے يم او هيڅ قسم آرام راته نۀ ملاويږى."}, {"ref": "None Jeremiah 4:3", "text": "”خپل غټ او واړۀ ډالونه تيار کړئ او د جنګ دپاره راوځئ."}, {"ref": "None Jeremiah 4:3", "text": "هغوئ به د آسونو د سومونو او پښو ټکار واورى، او د دشمن د جنګى ګاډو غرار او د هغوئ د پايو شور به واورى. پلاران به د يرې نه جام شى او د خپلو بې‌وسه ماشومانو د بچ کولو دپاره به شاته نۀ ګورى."}, {"ref": "None Jeremiah 4:3", "text": "د حورونايم نه د چغو آوازونو ته غوږ شئ، د لوئې تباهۍ درزار او آوازونه اورېدلے کيږى."}, {"ref": "None Jeremiah 4:3", "text": "اے د حسبون ښځو، وژاړئ، ځکه چې د عى ښار تباه شو. اے د ربه ښځو، وير وکړئ. د ټاټ جامې واغوندئ او ماتم وکړئ. اخوا ديخوا سرګردانه وزغلئ، ځکه چې د مولک بُت به سره د خپلو اِمامانو او خادِمانو جلاوطن کړے شى."}, {"ref": "None Jeremiah 4:4", "text": "خو زۀ اوس ستا د لاسونو نه زنځيرونه اخوا کوم او تا آزادوم. کۀ تۀ ما سره بابل ته تلل غواړې، نو راځه چې ځُو. زۀ به ګورم چې ستا پوره خيال وساتلے شى. او کۀ تۀ ما سره هلته تلل نۀ غواړې، نو دلته ايسار شه. ټول مُلک ستا د وړاندې دے. چرته چې تۀ تلل غواړې نو هلته په آزاده توګه لاړ شه."}, {"ref": "None Jeremiah 4:4", "text": "د جدلياه د قتلېدو نه يوه ورځ وروستو چې لا څوک هم د هغۀ په مرګ باندې خبر نۀ وُو،"}, {"ref": "None Jeremiah 4:4", "text": "يرمياه هغوئ ته په جواب کښې وفرمائيل چې، ”صحيح ده، زۀ به مالِک خُدائ ستاسو خُدائ پاک ته هم هغه شان دُعا وکړم لکه څنګه چې تاسو ما ته خواست وکړو، او زۀ به هر هغه څۀ تاسو ته ووايم چې هغه څۀ ما ته وفرمائى. زۀ به ستاسو نه هيڅ څيز هم نۀ پټوم.“"}, {"ref": "None Jeremiah 4:4", "text": "نو بيا د قريح زوئ يوحانان او نورو فوجى مشرانو او نورو ټولو خلقو د مالِک خُدائ د حکم نه اِنکار وکړو چې په يهوداه کښې پاتې شى."}, {"ref": "None Jeremiah 4:4", "text": "ما بار بار تاسو ته خپل خِدمتګاران پېغمبران درولېږل، هغوئ تاسو ته مِنت وکړو چې دا حرامکارى مۀ کوئ د کوم نه چې زۀ نفرت کوم."}, {"ref": "None Jeremiah 4:4", "text": "باروکه، مالِک خُدائ داسې فرمائى چې، زۀ به دا قوم تباه کړم کوم چې ما آباد کړے دے. او څۀ چې ما کَرلى دى هغه به د بېخ نه راوباسم."}, {"ref": "None Jeremiah 4:4", "text": "خپل آسونه زين کړئ او ورباندې سوارۀ شئ. صفونه جوړ کړئ او د جنګ ټوپۍ په سر کړئ. خپلې نېزې تېرې کړئ، او زغره واچوئ."}, {"ref": "None Jeremiah 4:4", "text": "د ټولو فلستيانو د تباهۍ ورځ رارسېدلې ده او ورسره د هغوئ هم څوک چې به د صور او صيدا خلقو سره مدد کوى. مالِک خُدائ په خپله هغه فلستيان تباه کوى، هغوئ څوک چې ژوندى پاتې شوى دى او د کريت د ساحل نه راغلى دى."}, {"ref": "None Jeremiah 4:4", "text": "موآب به ټول تباه شى، د هغې واړۀ ماشومان به په تېزه چغې وهى."}, {"ref": "None Jeremiah 4:4", "text": "تاسو ولې په خپل لوئ طاقت باندې فخر او لافې کوئ؟ ستاسو مال دولت به کم کړے شى، اے عمونه. چې د سرکشه جينۍ په شان په خپل مال دولت باندې يقين کوئ او داسې وايئ، په چا کښې جرأت شته چې په مونږ باندې حمله وکړى؟“"}, {"ref": "None Jeremiah 4:5", "text": "کۀ چرې تا دا فېصله کړې وى چې دلته پاتې شې، نو بيا جدلياه د اخيقام زوئ او د سافن نمسى ته واپس لاړ شه. هغه د بابل بادشاه له طرفه د يهوداه حکمران مقرر شوے دے. د هغه خلقو سره پاتې شه په چا چې هغه حکومت کوى. خو دا ستا خوښه ده، چرته دې چې زړۀ غواړى هلته لاړ شه.“ نو بيا نبوزردان يرمياه ته څۀ خوراک او پېسې ورکړې او هغۀ ته يې ووئيل چې لاړ شه."}, {"ref": "None Jeremiah 4:5", "text": "اتيا کسان د شِکم، سيلا او سامريه نه د خُدائ کور ته راغلل چې عبادت وکړى. هغوئ خپلې ږيرې د غم په وجه خرئيلې وې، او د غم په وجه يې خپلې جامې هم شلولې وې او خپل ځانونه يې هم زخمى کړى وُو. او خپل ځان سره يې غله دانه او خوشبو مالِک خُدائ ته د نذرانې پېش کولو په توګه راوړې وې."}, {"ref": "None Jeremiah 4:5", "text": "بيا هغوئ يرمياه ته ووئيل، ”نو بيا دې مالِک خُدائ په مونږ په دې خبره رښتينے او وفادار ګواه وى کۀ چرې مونږ ستا په هغه ټولو خبرو عمل ونۀ کړو کومې چې مالِک خُدائ ستا خُدائ پاک زمونږ دپاره تا ته فرمائيلى دى چې تۀ يې مونږ ته بيان کړې."}, {"ref": "None Jeremiah 4:5", "text": "يوحنان او نورو مشرانو ځان سره ټول خلق بوتلل څوک چې د نزدې مُلکونو نه راواپس شوى وُو کوم ځائ ته چې دوئ خوارۀ شوى وُو."}, {"ref": "None Jeremiah 4:5", "text": "خو هغوئ د نبيانو خبرو ته غوږ ونۀ نيولو او نۀ يې توجو ورکړه، او هغوئ د خپلو هغه بد عملونو نه راونۀ ګرځېدل او نۀ يې غېر معبودانو ته خوشبو سوزول بند کړل."}, {"ref": "None Jeremiah 4:5", "text": "ولې تۀ د خپل ځان دپاره د دې نه نور هم زيات د خاص سلوک اُميد کوې څۀ؟ داسې مۀ کوه. زۀ به لوئ افت په دې خلقو نازل کړم. خو تۀ چرته هم ځې نو زۀ به تا ته ستا ژوندون درکړم. مالِک خُدائ داسې فرمائى.“"}, {"ref": "None Jeremiah 4:5", "text": "خو زۀ څۀ ګورم؟ چې په مِصرى فوجيانو باندې د يرې نه دهشت راغلے دے او هغوئ د يرې نه لګيا دى په شا کيږى، د هغوئ فوجيانو شکست وخوړلو. او په وارخطايۍ سره په مخه تښتى او هغوئ وروستو نۀ ګورى، او د هرې خوا نه په هغوئ باندې يره خوره شوې ده، مالِک خُدائ داسې فرمائيلى دى."}, {"ref": "None Jeremiah 4:5", "text": "غزه لور به د غم نه خپل سر ګنجے کړى او د اسقلون ښار به وران او خاموشه شى. اے د مېدانى علاقې پاتې شوو خلقو ترڅو پورې به خپل ځان وهئ او ماتم به کوئ؟"}, {"ref": "None Jeremiah 4:5", "text": "هغوئ لوحيت ته په بره تلو سخته ژړا کوى، او حورونايم ته په ورکوزېدو سره د تباهۍ د درزار او شور په اورېدو هغوئ په چغو چغو ژړا کوى."}, {"ref": "None Jeremiah 4:5", "text": "مالِک خُدائ ربُ الافواج فرمائى چې، ”ګورئ، زۀ به ستاسو د هرې خوا نه په تاسو باندې يره او وحشت راولم. او ستاسو هر يو کس به د مُلک نه وشړلے شى، او هيڅ څوک به هم دا مفروران يو ځائ ته راجمع نۀ کړى."}, {"ref": "None Jeremiah 4:6", "text": "نو بيا يرمياه جدلياه د اخيقام زوئ له په مصفاه کښې واپس لاړو، او هغه په يهوداه کښې د هغه خلقو سره اوسېدلو کوم چې په هغه مُلک کښې پاتې شوى وُو."}, {"ref": "None Jeremiah 4:6", "text": "نو اِسمٰعيل د اوښکو نه په ډکو سترګو سره د مصفاه نه بهر ووتو او د هغه کسانو سره د ملاقات دپاره لاړو. کله چې هغه هغوئ ته ورسېدلو نو ورته يې ووئيل چې، ”راشئ، وګورئ چې د جدلياه د اخيقام زوئ سره څۀ شوى دى.“"}, {"ref": "None Jeremiah 4:6", "text": "کۀ هغه کلام زمونږ خوښ شى او کۀ خوښ نۀ شى، مونږ به د مالِک خُدائ د کلام پيروى کوُو چا ته چې تۀ مونږ د خپل خواست دپاره لېږې. ځکه کۀ چرې مونږ د هغۀ د کلام پيروى وکړُو، نو هر څۀ به زمونږ دپاره د خير وى.“"}, {"ref": "None Jeremiah 4:6", "text": "او په هغوئ کښې نارينه، زنانه، ماشومان، د بادشاه لوڼه، او ټول هغه خلق شامل وُو چې نبوزردان د محافظانو آفسر جدلياه ته سپارلى وُو. په دوئ کښې يرمياه پېغمبر او باروک هم شامل وُو."}, {"ref": "None Jeremiah 4:6", "text": "نو په دې وجه ما خپل سخت قهر د يهوداه په ښارونو او د يروشلم په کوڅو لکه د اور په شان نازل کړو، او هغه يې تر نن ورځ پورې تباه او په خرابه بدل کړل."}, {"ref": "None Jeremiah 4:6", "text": "تېزه منډه وهونکے هم نۀ شى تښتېدلے، او نه تکړه فوجى تښتېدلے شى. او هغوئ په شمال کښې د فرات د سيند سره، تيندک خورى او راغورزيږى."}, {"ref": "None Jeremiah 4:6", "text": "تاسو چغې وهئ، اے د مالِک خُدائ تُورې، ترڅو پورې به تۀ زخمى کول کوې؟ خپل کاش ته واپس لاړه شه، او هلته په آرام پرته اوسه."}, {"ref": "None Jeremiah 4:6", "text": "هغوئ وائى چې، منډه کړئ او ځان بچ کړئ او په صحرا کښې د ځنګلى بوټو په شان شئ."}, {"ref": "None Jeremiah 4:6", "text": "خو وروستو به زۀ عمونيان يو ځل بيا بحال کړم. دا د مالِک خُدائ فرمان دے.“"}, {"ref": "None Jeremiah 4:7", "text": "د يهوداه څۀ فوجى آفسران چې په کلى والو علاقو کښې پټ شوى وُو، هغوئ دا واورېدل چې په يهوداه کښې جدلياه د اخيقام زوئ په غريبانانو خلقو باندې د بابل بادشاه حکمران مقرر کړے دے. په هغوئ کښې نارينه، زنانه، او ماشومان شامل دى څوک چې بابل ته جلاوطن کړے شوى نۀ وُو او په يهوداه کښې پاتې وُو."}, {"ref": "None Jeremiah 4:7", "text": "خو چې څنګه هغوئ ښار ته ورننوتل، نو فوراً اِسمٰعيل او د هغۀ ملګرو ټول ووژل او د هغوئ لاشونه يې په يوه ډيګۍ کښې وروغورزول."}, {"ref": "None Jeremiah 4:7", "text": "لس ورځې وروستو د مالِک خُدائ کلام په يرمياه نازل شو."}, {"ref": "None Jeremiah 4:7", "text": "خلقو د مالِک خُدائ د حکم نه اِنکار وکړو او د مِصر تحفنحيس ښار ته ورسېدل."}, {"ref": "None Jeremiah 4:7", "text": "نو اوس مالِک خُدائ ربُ الافواج د بنى اِسرائيلو خُدائ پاک فرمائى چې زۀ تاسو نه تپوس کوم چې، تاسو ولې خپل ځانونه تباه کوئ؟ په تاسو کښې به نۀ نارينه، نۀ زنانه، نۀ ماشومان او نۀ تې خوړونکى هيڅوک هم ژوندى پاتې نۀ شى څوک چې دلته د يهوداه نه راغلى يئ."}, {"ref": "None Jeremiah 4:7", "text": "څوک دے دا چې لکه د نيل درياب په شان موجونه وهى، لکه د هغه سيند په شان چې اوبۀ يې په بره موجونه وهى او ټوله زمکه لاندې کوى؟"}, {"ref": "None Jeremiah 4:7", "text": "خو دا به څنګه په آرام شى چې ورته مالِک خُدائ حکم کړے دے، کله چې هغۀ ورته په اسقلون او په ساحل د حملې کولو حکم کړے دے؟“"}, {"ref": "None Jeremiah 4:7", "text": "دا چې تا اے موآبه په خپلو اعمالو او دولت باندې باور کولو، نو تاسو به هم ګرفتار شئ، او ستا بُت کموس به هم د خپلو اِمامانو او نورو خادِمانو سره جلاوطن کړے شى."}, {"ref": "None Jeremiah 4:7", "text": "د ادوميانو په حقله مالِک خُدائ ربُ الافواج داسې فرمائى چې، ”ولې په تيمان کښې نور حکمت او عقل نشته څۀ؟ آيا هوښياران ورته صحيح مشوره نۀ شى ورکولے څۀ؟ ولې د هغوئ عقل خوړلے شوے دے څۀ؟"}, {"ref": "None Jeremiah 4:8", "text": "په هغوئ کښې دا آفسران شامل دى، اِسمٰعيل د نتنياه زوئ، يوحانان او يونتن د قريح زامن، شراياه د تنحومت زوئ، د عيفاى نطوفاتى زامن، يزنياه د معکاتى زوئ او د هغوئ فوجيان. هغوئ د جدلياه د ليدو دپاره مصفاه ته لاړل."}, {"ref": "None Jeremiah 4:8", "text": "خو په هغه ډله کښې لس کسان وُو چې هغوئ اِسمٰعيل سره دا خبره وکړه او ورته يې ووئيل چې، ”کۀ چرې تۀ مونږ ونۀ وژنې نو کوم غنم، اوربشې، او د زيتون تېل او شات چې مونږ پټ ذخيره کړى دى هغه به تا له راوړُو.“ نو په دې خبره هغۀ هغوئ ژوندى پرېښودل."}, {"ref": "None Jeremiah 4:8", "text": "نو بيا هغۀ يوحنان د قريح زوئ او نورو فوجى آفسرانو ته، او ټولو خلقو لويو او وړو ته آواز وکړو،"}, {"ref": "None Jeremiah 4:8", "text": "په تحفنحيس کښې مالِک خُدائ يرمياه ته بل پېغام ورکړو. هغۀ وفرمائيل چې،"}, {"ref": "None Jeremiah 4:8", "text": "تاسو په مِصر کښې نورو معبودانو او بُتانو ته د خوشبويۍ نذرانې پېش کولو سره ما ولې غصه کوئ؟ تاسو به په دې کار کولو سره صرف خپل ځان تباه کړئ او د دُنيا د نورو خلقو د لعنت، خندا او مسخرو به وګرځوئ."}, {"ref": "None Jeremiah 4:8", "text": "دا د مِصر فوج دے چې د نيل درياب په شان راوچت شوے دے او لافې وهى چې زۀ به راوچت شم او د سېلاب په شان به ټوله زمکه پټه کړم، زۀ به ټول ښارونه تباه کړم او په هغې کښې ټول خلق به هلاک کړم."}, {"ref": "None Jeremiah 4:8", "text": "تباه کوونکے دشمن به د هر يو ښار خلاف حمله وکړى، او يو ښار به هم ترې بچ نۀ شى. هره وادى به تباه شى او هر هوار مېدان به تباه شى. ځکه چې مالِک خُدائ دا حکم کړے دے."}, {"ref": "None Jeremiah 4:8", "text": "اے د ددان خلقو، واپس شئ او وتښتئ، او په غارونو کښې خپل ځان پټ کړئ، ځکه چې زۀ په عِيسو افت نازلوم نو په دغه وخت کښې به زۀ هغۀ ته هم سزا ورکړم."}, {"ref": "None Jeremiah 4:9", "text": "جدلياه د اخيقام زوئ او د سافن نمسى هغوئ سره په قسم خوړلو وعده وکړه چې، ”د خپل ځان په حواله کېدو بابليانو نه مۀ يرېږئ. د هغوئ د خِدمت کولو نه مۀ يرېږئ. په دې مُلک کښې اوسېږئ، او د بابل د بادشاه خِدمت کوئ او هر څۀ به ستاسو دپاره د خير وى."}, {"ref": "None Jeremiah 4:9", "text": "هغه د اوبو ډيګۍ چې اِسمٰعيل په کښې د هغه مړو لاشونه ورګزار کړل کوم چې هغۀ وژلى وُو هم هغه لويه ډيګۍ وه چې آسا بادشاه جوړه کړې وه چې کله هغۀ د مصفاه دفاع مضبوطه کړه چې خپل ځان د اِسرائيلو د بعشا بادشاه نه وساتى. اِسمٰعيل د نتنياه زوئ هغه د مړو نه ډکه کړه."}, {"ref": "None Jeremiah 4:9", "text": "هغۀ هغوئ ته وفرمائيل چې، ”تاسو زۀ مالِک خُدائ، د بنى اِسرائيلو خُدائ پاک ته د خپل درخواست سره ولېږلم، هغه داسې فرمائى چې،"}, {"ref": "None Jeremiah 4:9", "text": "”کله چې د يهوداه خلق درته ګورى، نو دلته په تحفنحيس کښې يو څو غټ کاڼى راواخله او د فِرعون د محل په دروازه کښې يې د فرش لاندې ښخ کړه."}, {"ref": "None Jeremiah 4:9", "text": "ولې تاسو د خپل پلار نيکۀ ګناهونه، د يهوداه د بادشاهانو او د مَلِکو ګناهونه، او هغه ګناهونه چې تاسو او ستاسو ښځو په يهوداه او يروشلم کښې کړى دى هېر کړل؟"}, {"ref": "None Jeremiah 4:9", "text": "اے آسونو او جنګى ګاډو روان شئ، اے د مِصر تکړه سپاهيانو په دشمن حمله وکړئ، اے د ايتهوپيا، ليبيا، خلقو ډال راواخلئ او د لِديه خلقو څوک چې په غشو ليندو کښې تکړه يې."}, {"ref": "None Jeremiah 4:9", "text": "په موآب باندې مالګه ودوړوه، ځکه چې هغه به په ښوره او صحرا بدل شى، د هغې ښارونه به وران شى، او هيڅ څوک به په کښې نۀ اوسيږى."}, {"ref": "None Jeremiah 4:9", "text": "هغوئ څوک چې انګور راټولوى لږ څۀ غريبانانو ته پرېږدى. کۀ چرې په شپه کښې ورباندې غلۀ راشى، نو هغوئ به ورنه هر څۀ نۀ جارُو کوى."}, {"ref": "None Jeremiah 4:10", "text": "زۀ به په خپله په مصفاه کښې اوسېږم او کله چې د بابليانو وفد دلته راشى نو زۀ به ستاسو د طرف نه نمائنده يم. خو په دې وخت کښې تاسو انګور، او د ګرمۍ مېوې، او د زيتُونو تېل په چاټو کښې جمع کړئ، او په کومو ښارونو مو چې قبضه کړې ده په هغوئ کښې اوسېږئ.“"}, {"ref": "None Jeremiah 4:10", "text": "بيا اِسمٰعيل د بادشاه لوڼه او هغه ټول کسان چې نبوزردان د فوج مشر په مصفاه کښې جدلياه ته پرېښى وُو هغوئ ټول يې ګېر کړل او ځان سره يې د عمون د علاقې په طرف روان کړل."}, {"ref": "None Jeremiah 4:10", "text": "کۀ تاسو په دې مُلک کښې پاتې شئ، نو زۀ به تاسو بيا آباد کړم او نۀ به مو خرابوم، زۀ به تاسو وکرم او تاسو به د بېخ نه نۀ وباسم. زۀ ستاسو په هغه افت کوم چې ما په تاسو نازل کړے دے پښېمانه يم."}, {"ref": "None Jeremiah 4:10", "text": "نو بيا د يهوداه خلقو ته ووايه چې، مالِک خُدائ ربُ الافواج د بنى اِسرائيلو خُدائ پاک داسې فرمائى چې زۀ به په يقين سره خپل خِدمتګار نبوکدنضر د بابل بادشاه دلته مِصر ته راولم. زۀ به د هغۀ تخت په دې کاڼو دپاسه جوړ کړم کوم چې يرمياه دلته ښخ کړل. هغه به په دې کاڼو خپل شاهى تمبو وغوړوى."}, {"ref": "None Jeremiah 4:10", "text": "خو تر ننه پورې نۀ تاسو په خپل ځان کښې خاکسارى راوستې ده او نۀ مو په خپلو بدو کارونو پښېمانى ښکاره کړې ده. په تاسو کښې هيچا، نۀ زما د شريعت په مطابق او نۀ زما د اصُولو په مطابق ژوند کړے دے کوم چې ما ستاسو نه وړاندې ستاسو پلار نيکۀ ته ورکړى وُو."}, {"ref": "None Jeremiah 4:10", "text": "ځکه چې دا د مالِک خُدائ ربُ الافواج ورځ ده، د انتقام ورځ، ځکه چې هغه به د خپلو دشمنانو نه انتقام واخلى. د هغۀ تُوره به تر هغې خوړل کوى ترڅو پورې چې مړه شوى نۀ وى، او ترڅو چې د هغوئ په وينو تنده ماته نۀ کړى. په نن ورځ به هغوئ مالِک خُدائ ربُ الافواج خُدائ پاک ته په شمال کښې د فرات د سيند سره د قربانۍ په شان پېش کړے شى."}, {"ref": "None Jeremiah 4:10", "text": "لعنت دې په هغه کسانو وى څوک چې د مالِک خُدائ په کار کښې غفلت کوى، او خپله تُوره د وينو توېدو نه بچ ساتى."}, {"ref": "None Jeremiah 4:10", "text": "خو زۀ به د عِيسو نه هر څۀ جارُو کړم او د هغۀ پټ ځايونه به ښکاره کړم، نو هغه به يو ځائ هم خپل ځان پټولے نۀ شى. د هغۀ ماشومان، خپلوان، او ګاونډيان به تباه کړے شى، او هغه به نور په دُنيا کښې ژوندى پاتې نۀ شى."}, {"ref": "None Jeremiah 4:11", "text": "په دې دوران کښې چې کوم د يهوديانو خلق چې موآب، عمون، ادوم او نورو مُلکونو ته مسافر شوى وُو نو هغوئ ټول په دې خبر شول چې د بابل بادشاه د يهوداه پاتې شوى خلقو له په يهوداه کښې د اوسېدو اجازت ورکړے دے او جدلياه يې د هغوئ حکمران جوړ کړے دے،"}, {"ref": "None Jeremiah 4:11", "text": "خو کله چې يوحانان د قريح زوئ او نور د فوج مشران د اِسمٰعيل د جرم نه خبر شول،"}, {"ref": "None Jeremiah 4:11", "text": "مالِک خُدائ فرمائى چې، د بابل بادشاه نه نور مۀ يرېږئ. ځکه چې زۀ تاسو سره يم او د هغۀ نه به مو بچ کړم او د هغۀ د لاس نه به خلاصون درکړم."}, {"ref": "None Jeremiah 4:11", "text": "او کله چې هغه راشى، نو هغه به د مِصر مُلک تباه کړى. هغه څوک به مړ کړى د چا دپاره چې د مرګ سزا مقرر شوې وى، د قېد سزا به هغۀ ته ورکړى چا ته چې د قېد سزا مقرر شوې وى، او څوک به په تُوره مړۀ کړى د چا دپاره چې په تُوره مړ کېدل مقرر شوى وى."}, {"ref": "None Jeremiah 4:11", "text": "نو په دې وجه، مالِک خُدائ ربُ الافواج د بنى اِسرائيلو خُدائ پاک فرمائى چې، ما په خپله دا کلکه اراده وکړه چې ټوله يهوداه تباه او هلاکه کړم."}, {"ref": "None Jeremiah 4:11", "text": "اے د مِصر پېغلې لورې، جِلعاد ته لاړه شه او هلته دارو ولټوه. خو ستاسو رنګارنګ دوائى به تاسو ته شفا درنۀ کړى."}, {"ref": "None Jeremiah 4:11", "text": "موآب د ځوانۍ نه واخله تر اوسه پورې په امن او سکون سره وخت تېر کړے دے، هغه جلاوطن شوے نۀ دے. لکه څنګه چې مے په خپل لوښى کښې ځائ په ځائ پراتۀ وى، او د يو لوښى نه بل لوښى ته نۀ وى اړولے شوى. نو د هغې ذائقه هم هغه شان ده لکه څنګه چې يې د اول نه وه، او د هغې خوشبو بدله شوې نۀ ده."}, {"ref": "None Jeremiah 4:11", "text": "خو زۀ به ستاسو د يتيمانو خيال ساتم او ستاسو کونډې دې هم په ما د مدد دپاره باور وکړى.“"}, {"ref": "None Jeremiah 4:12", "text": "نو بيا هغوئ ټول د يهوداه مُلک ته واپس راغلل، په مصفاه کښې جدلياه ته، د هغه ټولو مُلکونو نه کوم ته چې هغوئ خوارۀ شوى وُو. او هغوئ د اوړى ډيرې مېوې او انګور راټول کړل."}, {"ref": "None Jeremiah 4:12", "text": "نو هغوئ خپل ټول سپاهيان راټول کړل او هغۀ پسې راووتل او په جبعون کښې د لوئ تالاب سره نزدې هغوئ هغه پېدا کړو."}, {"ref": "None Jeremiah 4:12", "text": "زۀ به په تاسو دا رحم وکړم چې هغه به درباندې مهربانه کړم، نو بيا به هغه تاسو ته په خپل مُلک کښې د پاتې کېدو اجازت درکړى."}, {"ref": "None Jeremiah 4:12", "text": "هغه به د مِصر د معبودانو په مندرونو اور بل کړى، هغه به مندرونه وسوزوى او بُتان به قبضه کړى او د غنيمت په توګه به يې يوسى. هغه به د مِصر مال متاع داسې صفا کړى لکه څنګه چې يو شپون د خپلې چُوغې نه ورَږې صفا کوى. او بې‌نقصانه به هغه خپل مُلک ته واپس شى."}, {"ref": "None Jeremiah 4:12", "text": "زۀ به د يهوداه هغه ژوندى پاتې شوى خلق راواخلم هغه څوک چا چې په مِصر کښې په پناه اخستو او اوسېدو زور راوړے وو. زۀ به هغوئ تباه کړم. هغوئ ټول لوئ او واړۀ به په مِصر کښې په جنګ، قحط او وبا باندې مړۀ او تباه کړم. او هغوئ به نورو خلقو ته د تهمت، وحشت، لعنت او حقارت مثال وګرځيږى."}, {"ref": "None Jeremiah 4:12", "text": "قومونه به ستاسو د شرم په حقله خبر شى. زمکه به ستاسو دردناکه ژړا ډکه کړى. ستا تکړه فوجيان به په يو بل تيندک وخورى، او په يو ځائ به راپرېوځى.“"}, {"ref": "None Jeremiah 4:12", "text": "خو هغه ورځې راروانې دى، مالِک خُدائ فرمائى چې، کله به زۀ خلق ورولېږم چې موآب د لوښى نه رابهر کړى. او هغوئ به هغه د لوښى نه لکه د ميو په شان توئ کړى او لوښى به زره زره کړى."}, {"ref": "None Jeremiah 4:12", "text": "مالِک خُدائ فرمائى چې، ”کۀ چرې بې‌ګناه خلقو ته سزا ملاويږى، نو بيا به تاسو د څومره سزا لائق يئ. تاسو به بې‌سزا پاتې نۀ شئ. نو تاسو به ضرور د غضب د دې پيالۍ نه خوند واخلئ.“"}, {"ref": "None Jeremiah 4:13", "text": "د هغې نه پس، د قريح زوئ يوحانان او هغه فوجى آفسران څوک چې په کلى والو علاقو کښې وُو، په مصفاه کښې جدلياه له راغلل،"}, {"ref": "None Jeremiah 4:13", "text": "کله چې د اِسمٰعيل سره قېديانو يوحانان او ورسره نور فوجى مشران وليدل نو هغوئ ډېر خوشحاله شول."}, {"ref": "None Jeremiah 4:13", "text": "خو کۀ چرې تاسو د مالِک خُدائ ستاسو خُدائ پاک د دې پېغام نه اِنکار وکړئ، او کۀ چرې تاسو ووايئ چې، نه، مونږ به دلته نۀ پاتې کيږُو،"}, {"ref": "None Jeremiah 4:13", "text": "هغه به د مِصر په بيت‌شمس مندر کښې مقدسې ستنې راوغورزوى کومې چې په هغې کښې ولاړې دى، او هغه به د مِصر د معبودانو مندرونه وسوزوى.“"}, {"ref": "None Jeremiah 4:13", "text": "زۀ به هغوئ ته په مِصر کښې سزا ورکړم لکه څنګه چې مې ورته په يروشلم کښې په جنګ، قحط او وبا سزا ورکړې وه."}, {"ref": "None Jeremiah 4:13", "text": "دا هغه خبر دے چې مالِک خُدائ د يرمياه نبى په وسيله د نبوکدنضر يعنې د بابل د بادشاه د راتلو او د هغۀ په مِصر باندې د حملې په حقله ورکړو،"}, {"ref": "None Jeremiah 4:13", "text": "نو په آخر کښې به بيا د موآب خلق د کموس بُت نه شرميږى، لکه څنګه چې بنى اِسرائيل په بيت‌ايل کښې په بُت باندې په يقين کولو شرمېدل."}, {"ref": "None Jeremiah 4:13", "text": "مالِک خُدائ فرمائى چې، ”زۀ په خپل ذات قسم خورم چې، د بُصره ښار به تباه شى او د خاورو ډېرے به جوړ شى او د ټولو خلقو دپاره به د وحشت، سپکوالى او د لعنت مثال وګرځى، او د هغۀ ټول ښارونه به د تل دپاره تباه او برباد شى.“"}, {"ref": "None Jeremiah 4:14", "text": "هغوئ هغۀ ته ووئيل چې، ”تا ته دا پته شته چې بعليس د عمون بادشاه اِسمٰعيل د نتنياه زوئ ستا د قتلولو دپاره رالېږلے دے؟“ خو جدلياه په دې خبره باندې يقين ونۀ کړلو."}, {"ref": "None Jeremiah 4:14", "text": "او د مصفاه نه ټول قېديان وتښتېدل او د يوحانان مدد يې شروع کړو."}, {"ref": "None Jeremiah 4:14", "text": "خو د دې په ځائ به مِصر ته لاړ شُو، چرته چې به مونږ د جنګونو، د جنګ د بيګل آوازونو او قحط نه آزاد شُو،"}, {"ref": "None Jeremiah 4:14", "text": "د يهوداه څومره خلق چې دلته مِصر ته پناه اخستو دپاره راغلى دى هغه ټول به دلته هلاک شى. څوک به هم يهوداه ته واپس لاړ نۀ شى. تر دې چې هغوئ به د دوباره هلته د تلو او آبادېدو ډېر خواهش هم کوى. خو په هغوئ کښې به صرف يو څو کسان واپس شى.“"}, {"ref": "None Jeremiah 4:14", "text": "”د مِصر په ښارونو په مجدال، ميمفِس او تحفنحيس کښې به دا اعلان وکړئ چې، د جنګ دپاره تيار شئ، ځکه چې تُوره به ستاسو خوا او شا کښې هر څۀ وخورى."}, {"ref": "None Jeremiah 4:14", "text": "نو بيا تاسو څنګه لافې وهلې چې، مونږ په جنګ کښې ډېر تکړه او باتور فوجيان يُو؟"}, {"ref": "None Jeremiah 4:14", "text": "ما د مالِک خُدائ له طرفه پېغام واورېدو، يو قاصد قومونو ته ولېږلے شو چې هغوئ ته ووائى چې، ”د ادوم په خلاف لښکر راجمع کړئ او د جنګ دپاره تيارى وکړئ."}, {"ref": "None Jeremiah 4:15", "text": "نو د قريح زوئ يوحانان هغۀ ته پټ غوندې ووئيل، ”ما پرېږده چې د نتنياه زوئ اِسمٰعيل ووژنم او هيچا ته به د دې پته ونۀ لګى. ولې مونږ هغۀ ته اجازت ورکړُو چې هغه راشى او تا ووژنى؟ د يهوداه د هغه خلقو به څۀ حال وى څوک چې واپس خپل مُلک ته راغلل او ستا په مشرۍ کښې راټول شول؟ نو بيا ولې دې مونږ د يهوداه دا لږ کسان کوم چې ژوندى يُو خوارۀ وارۀ او ورک شُو؟“"}, {"ref": "None Jeremiah 4:15", "text": "خو اِسمٰعيل سره د خپلو هغه اتو کسانو دوستانو د عمون مُلک ته وتښتېدلو."}, {"ref": "None Jeremiah 4:15", "text": "نو بيا تاسو د مالِک خُدائ پېغام د يهوداه پاتې خلقو ته واوروئ. مالِک خُدائ ربُ الافواج داسې فرمائى چې، کۀ چرې تاسو دا ضرور غوره کړئ چې مِصر ته لاړ شئ او هلته پاتې شئ"}, {"ref": "None Jeremiah 4:15", "text": "د سړو او ښځو يوه لويه ډله چې په هغوئ کښې ځينې کسان په دې موضوع خبر وُو چې د هغوئ ښځو بُتانو ته خوشبويۍ سوزولې او ورسره هغوئ هم څوک چې په شمالى او جنوبى مِصر کښې اوسېدل يرمياه ته يې ووئيل چې،"}, {"ref": "None Jeremiah 4:15", "text": "ستاسو جنګيالى ولې راغورزېدلى دى؟ هغوئ د مالِک خُدائ مخې ته نۀ شى ټينګېدلے ځکه چې هغه به هغوئ راوغورزوى."}, {"ref": "None Jeremiah 4:15", "text": "موآب به تباه شى او د هغۀ ښارونه به قبضه کړے شى. د هغۀ ښائسته زلمى به حلالېدو دپاره بوتلے شى، دا د هغه بادشاه فرمان دے چې د چا نوم مالِک خُدائ ربُ الافواج دے."}, {"ref": "None Jeremiah 4:15", "text": "مالِک خُدائ ادوميانو ته فرمائى چې، اوس به زۀ تا د نورو قومونو په مينځ کښې کمزورے کړم. او ټول به تا ته په سپکه سترګه ګورى."}, {"ref": "None Jeremiah 4:16", "text": "خو جدلياه يوحانان ته په جواب کښې ووئيل، ”زۀ تا په سختۍ سره منع کوم دا کار مۀ کوه. تۀ چې د اِسمٰعيل په حقله څۀ وائې نو هغه رښتيا نۀ دى.“"}, {"ref": "None Jeremiah 4:16", "text": "نو بيا يوحانان د قريح زوئ او نورو فوجى مشرانو، هغه ټول کسان د ځان سره روان کړل کوم چې هغوئ په جبعون کښې د اِسمٰعيل نه خلاص کړى وُو چې په هغوئ کښې سپاهيان، زنانه، ماشومان او د دربار خصيان شامل وُو، څوک چې د جدلياه د قتلولو نه وروستو اِسمٰعيل ګرفتار کړى وُو."}, {"ref": "None Jeremiah 4:16", "text": "د کوم جنګ او قحط نه چې تاسو يرېږئ نو هم هغه به تاسو راګېر کړى، او تاسو به هلته مړۀ شئ."}, {"ref": "None Jeremiah 4:16", "text": "”کومه خبره چې تا مونږ ته د مالِک خُدائ په نوم وکړه هغې ته به مونږ غوږ نۀ نيسو."}, {"ref": "None Jeremiah 4:16", "text": "هغوئ به ټول تيندکونه خورى، او هغوئ به په يو بل راغورزيږى. هغوئ به يو بل ته وائى، پاڅه، راځئ چې خپلو خلقو او خپل مُلکونو ته واپس لاړ شُو، چرته به چې مونږ د ظالم د تُورې نه بچ شُو."}, {"ref": "None Jeremiah 4:16", "text": "د موآب د ختمېدو اَنجام رانزدې شوے دے، او د هغۀ بربادى زر راتلونکى ده."}, {"ref": "None Jeremiah 4:16", "text": "ستا خپل دهشت او کوم کبر چې ستا په زړۀ کښې وو تۀ دوکه کړې، تاسو څوک چې د ګټانو په درزونو کښې اوسېږئ، او د غرونو اوچتې څوکې ستا په قبضه کښې دى. کۀ څۀ هم چې تۀ د باز په شان په اوچتو ځايونو کښې خپلې جالې جوړې کړې نو د هلته نه به زۀ تا لاندې راکوز کړم. دا د مالِک خُدائ فرمان دے."}, {"ref": "None Jeremiah 4:17", "text": "هغوئ مِصر ته د تللو وخت کښې د کِمهام سرائى چې بيت‌لحم سره نزدې وو هلته ايسار شُو."}, {"ref": "None Jeremiah 4:17", "text": "نو په حقيقت کښې چې څوک هم په تلو کلک ولاړ وى او هلته د اوسېدو اراده لرى نو هغه به په جنګ، قحط او په وبا مړ شى. په تاسو کښې به يو کس هم د هغه افت نه ونۀ تښتى کوم چې زۀ په تاسو باندې هلته راولم."}, {"ref": "None Jeremiah 4:17", "text": "مونږ به ضرور په خپلو هغه ټولو خبرو عمل کوُو د کومې خبرې چې مونږه منښته کړې ده، مونږ به آسمانې مَلِکې ته خوشبو سوزوُو او هغې ته به د انګورو د شيرې نذرانې پېش کوُو. مونږ به هغه کارونه کوُو لکه څنګه چې به زمونږ پلار نيکۀ، بادشاهانو، سرکارى کسانو د يهوداه په ښارونو او د يروشلم په کوڅو کښې کول. مونږ سره په هغه وخت کښې خوراک ډېر تېر وو او زندګى مو ښۀ وه او مونږ ته هيڅ قسمه تکليف او مصيبت نۀ وو."}, {"ref": "None Jeremiah 4:17", "text": "نو هغوئ به وائى چې د مِصر بادشاه فِرعون خو تش په خولۀ لوئيږى، هغۀ نه اوس خپله موقع خطا شوې ده."}, {"ref": "None Jeremiah 4:17", "text": "اے د موآب دوستانو او ګاونډيانو په دۀ باندې ماتم وکړئ، تاسو څومره چې د هغۀ د شُهرت او نوم نه واقف يئ، نو ووايئ چې، افسوس د موآب د شان او شوکت امسا ماته شوه او د هغې ټول طاقت تس نس شو."}, {"ref": "None Jeremiah 4:17", "text": "ادوم به د خلقو دپاره د يرې مثال وګرځى، او څوک هم چې په دې لار تېريږى د هغوئ د ټولو افتونو پورې به حق حېران شى."}, {"ref": "None Jeremiah 4:18", "text": "نو د دې يرې نه چې کۀ بابليان په دې موضوع خبر شى چې اِسمٰعيل جدلياه قتل کړے دے، هغه څوک چې د بابل بادشاه د يهوداه ګورنر مقررولو، نو هغوئ به بيا څۀ کوى."}, {"ref": "None Jeremiah 4:18", "text": "مالِک خُدائ ربُ الافواج د بنى اِسرائيلو خُدائ پاک فرمائى، لکه څنګه چې زما قهر او غضب د يروشلم په خلقو نازل شوے وو، نو کۀ تاسو مِصر ته لاړئ نو زما غضب به په تاسو هم نازل شى. نو ستاسو نوم به د تل دپاره د لعنت، يرې او مسخرې په توګه اخستلے کيږى او خپل مُلک به دوباره ونۀ وينئ."}, {"ref": "None Jeremiah 4:18", "text": "خو چې د کوم وخت نه مونږ آسمانې مَلِکې ته د خوشبو سوزول او د څښلو نذرانې پېش کولو رسم بند کړے دے نو مونږ سره هيڅ هم نۀ وُو او په جنګ او قحط باندې مړۀ کېدلوُ.“"}, {"ref": "None Jeremiah 4:18", "text": "د دُنيا بادشاه د چا نوم چې مالِک خُدائ ربُ الافواج دے فرمائى چې، زما دې په خپل ذات قسم وى چې، يو کس څوک چې د مِصر خلاف راروان دے هغه لکه څنګه چې د تبور غر لوړ دے، او لکه څنګه چې د کرمل غر د سمندر په غاړه لوړ دے."}, {"ref": "None Jeremiah 4:18", "text": "اے د ديبون اوسېدونکو د خپل شاندار تخت نه راکوز شئ او په خشکه زمکه او خاورو کښېنئ، ځکه هغه چا چې موآب تباه کړو هغه به ديبون هم ټوټه ټوټه کړى. او هغه به ستاسو ټولې قلعه ګانې راوغورزوى."}, {"ref": "None Jeremiah 4:18", "text": "لکه څنګه چې سدوم او عموره، او د دې نه ګېرچاپېره ښارونو باندې تباهى راغلې وه، نو ادوم به هم هغه شان تباه شى، هلته به هيڅ څوک نۀ ژوند کوى او نۀ به اوسيږى. مالِک خُدائ داسې فرمائى."}, {"ref": "None Jeremiah 4:19", "text": "اے د يهوداه ژوندى پاتې شوى خلقو، مالِک خُدائ تاسو ته فرمائيلى دى چې مِصر ته مۀ ځئ. زۀ چې دا خبردارے نن تاسو ته درکوم دا مۀ هېروئ."}, {"ref": "None Jeremiah 4:19", "text": "نو ښځو خپله خبره جارى وساتله او وې وئيل چې، ”ولې ستاسو دا خيال دے چې ګنې زمونږ خاوندانو ته دا پته نشته چې مونږ آسمانې مَلِکې ته خوشبوئى وسوزوله، د څښلو نذرانه او هغه روټۍ چې پرې مو د هغې شکل جوړ کړے وو پېش کړه؟ نه، بلکل داسې نۀ ده.“"}, {"ref": "None Jeremiah 4:19", "text": "اے د مِصر اوسېدونکو، خپل مال حال راواخلئ او د جلاوطنۍ دپاره تيار شئ، ځکه د ميمفِس ښار به تباه او کنډرې شى، او يو کس به هم په کښې نۀ اوسيږى."}, {"ref": "None Jeremiah 4:19", "text": "اے د عروعير اوسېدونکو د سړک په غاړه ودرېږئ او خلقو ته وګورئ. د هغه نارينه او زناناؤ نه څوک چې تښتى تپوس وکړئ چې څۀ چل وشو؟"}, {"ref": "None Jeremiah 4:19", "text": "لکه څنګه چې يو زمرے د اُردن د جاړو بوټو نه د څرن زمکې ته راځى او په ګډو ورټوپ کوى، نو دغه شان به زۀ ادوميان د هغوئ د خپل مُلک نه وشړم، او زۀ به د خپلې خوښې مشر په کښې مقرر کړم. نو هغه به په دوئ حکومت وکړى. څوک زما په شان کېدلے شى؟ او يو مشر به هم زما خلاف ونۀ دريږى."}, {"ref": "None Jeremiah 4:20", "text": "ځکه تاسو چې کله زۀ مالِک خُدائ ته د خواست کولو دپاره ولېږلم نو تاسو غټه غلطى وکړه، ځکه چې تاسو ووئيل، د څۀ چې مالِک خُدائ مونږ ته حکم کړے دے هغه مونږ ته ووايه، مونږ به په هغې باندې پوره عمل کوُو."}, {"ref": "None Jeremiah 4:20", "text": "نو بيا يرمياه هغه ټولو سړو او ښځو ته وفرمائيل چا چې يو شان جواب ورکړے وو،"}, {"ref": "None Jeremiah 4:20", "text": "مِصر لکه د يوې ځوانې سخۍ په شان ښائسته دے، خو د شمال د خوا نه د هغۀ خلاف د غوباړى په شان مچ راروان دے."}, {"ref": "None Jeremiah 4:20", "text": "هغوئ به په جواب کښې ووائى چې، د ارنون د سيند په غاړه موآب تباه شو او په شرمونو وشرمېدو، په چغو او سورو په هغۀ ماتم او ژړا وکړئ."}, {"ref": "None Jeremiah 4:20", "text": "نو بيا هغې منصوبې ته غوږ شه کومه چې مالِک خُدائ د ادوم په خلاف جوړه کړې ده، او څۀ چې هغه د تيمان د خلقو سره کول غواړى. د هغوئ د رمې نه به واړۀ ګډورى راکاږى او هغه به په پوره توګه د هغوئ د څرن ځائ د دوئ په وجه وران کړى."}, {"ref": "None Jeremiah 4:21", "text": "خو ما تاسو ته نن د هغۀ حکم واورولو، خو تاسو تر اوسه پورې د مالِک خُدائ د هغه پېغام پيروى نۀ کوئ د کوم دپاره چې تاسو زۀ استولے وم."}, {"ref": "None Jeremiah 4:21", "text": "”ولې ستاسو هم دا خيال دے چې ګنې مالِک خُدائ ته دا پته نشته څۀ چې تاسو او ستاسو پلار نيکۀ، ستاسو بادشاهانو او سرکارى کسانو، او ټولو خلقو بُتانو ته د يهوداه په ښارونو او د يروشلم په کوڅو کښې خوشبوئى سوزولې ده؟"}, {"ref": "None Jeremiah 4:21", "text": "د مِصر د کرايه فوجيان لکه د کمزورو سخو په شان دى. هغوئ به هم په يو ځائ راوګرځى او په شريکه به وتښتى، هغوئ به په خپل ځائ باندې ونۀ دريږى. ځکه چې په هغوئ د تباهۍ او افت ورځ راروانه ده، دا د هغوئ دپاره د سزا ورکولو ورځ ده."}, {"ref": "None Jeremiah 4:21", "text": "د مالِک خُدائ عدالت په دې غريزه مُلکونو لکه حولون، يهض، مفعت،"}, {"ref": "None Jeremiah 4:21", "text": "د ادوم د راغورزېدو په آواز به زمکه ټوله په لړزان شى، او د هغوئ د چغو او سورو آواز به د بحرِقُلزمه پورې اورېدلے شى."}, {"ref": "None Jeremiah 4:22", "text": "نو اوس په دې خبره باندې يقين ساتئ چې، تاسو چې کوم ځائ ته تلل او اوسېدل غواړئ نو تاسو به هلته په جنګ، قحط او وبا مړۀ شئ.“"}, {"ref": "None Jeremiah 4:22", "text": "دا ځکه وشُو چې، نور مالِک خُدائ ستاسو د شرارت نه ډک او حرام کارونه نۀ شو برداشت کولے، نو د دې په وجه ستاسو زمکه د لعنت مثال وګرځېده، او په صحرا او کنډرو بدله شوه چې تر ننه پورې هيڅ څوک په کښې نۀ اوسيږى."}, {"ref": "None Jeremiah 4:22", "text": "مِصر به لکه د مار په شان کشار وکړى او په وروستو به وتښتى کله چې د دشمن فوج ورباندې حمله وکړى، هغوئ به د دوئ خلاف تبر په لاس راشى او په دوئ به داسې حمله وکړى لکه څنګه چې يو سړے ونې وهى."}, {"ref": "None Jeremiah 4:22", "text": "ديبون، نبو، بيت‌دبلاتايم،"}, {"ref": "None Jeremiah 4:22", "text": "ګورئ، دشمن لکه د باز په شان راغوټه شوے دے، او خپل وزرونه يې په بُصره باندې خوارۀ کړى دى، تر دې چې په هغه ورځ به د ادوم د تکړه فوجيانو زړۀ داسې په تکليف او يره کښې وى لکه چې د يوې ښځې زړۀ په لنګون کښې وى.“"}, {"ref": "None Jeremiah 4:23", "text": "دا مصيبتونه ځکه په تاسو باندې راغلل چې تاسو بُتانو ته خوشبو وسوزوله او د مالِک خُدائ خلاف مو ګناه وکړه. تاسو د هغۀ د حکمونو منلو نه اِنکار وکړو او نۀ مو د هغۀ په لارښودنو، اصُولو او شريعت باندې عمل وکړو.“"}, {"ref": "None Jeremiah 4:23", "text": "مالِک خُدائ فرمائى چې، هغوئ به د مِصر خلق د ځنګلى ونو په شان ووهى، ځکه چې د هغوئ شمېر د مُولخانو نه هم ډېر بې‌شمېره دے."}, {"ref": "None Jeremiah 4:23", "text": "قِريَتائم، بيت‌جمول، بيت‌معون،"}, {"ref": "None Jeremiah 4:23", "text": "مالِک خُدائ د دمشق په حقله دا پېغام ورکړو چې، ”د حمات او ارفاد ښارونه د يرې نه اوبۀ شول، ځکه چې هغوئ د خپل ځان د تباهۍ پېغام واورېدو. د هغوئ زړونه داسې بې‌سکونه شول لکه څنګه چې د سمندر چپې نا آرامه او بې‌سکونه وى او هيڅ سکون ورته نۀ ملاويږى."}, {"ref": "None Jeremiah 4:24", "text": "نو بيا يرمياه ټولو ناريناؤ او زناناؤ ته وفرمائيل چې، ”اے د يهوداه خلقو تاسو څوک چې په مِصر کښې اوسېږئ د مالِک خُدائ کلام ته غوږ ونيسئ."}, {"ref": "None Jeremiah 4:24", "text": "د مِصر خلق به وشرميږى، او د شمال خلقو ته به حواله کړے شى.“"}, {"ref": "None Jeremiah 4:24", "text": "قريوت او بُصره او د موآب په ټولو لرې او نزدې ښارونو نازل شوے دے."}, {"ref": "None Jeremiah 4:24", "text": "د دمشق ښاريه د هغې ښځې په شان ده چې بې‌همته شوه، او د هغې ټول خلق وتښتېدل. يرې، وارخطايۍ، او درد هغه رانيولې ده لکه څنګه چې يوه ښځه د لنګون په وخت کښې نيولې وى."}, {"ref": "None Jeremiah 4:25", "text": "مالِک خُدائ ربُ الافواج د بنى اِسرائيلو خُدائ پاک داسې فرمائى چې، تاسو او ستاسو ښځو ووئيل چې، مونږ به ضرور خپلې وعدې پوره کوُو او آسمانې مَلِکې ته به د خوشبو سوزولو او د څښلو نذرانې پېش کوُو. نو تاسو چې څۀ کول نو هغه وکړئ او خپله وعده او منښته هغې ته پوره کړئ."}, {"ref": "None Jeremiah 4:25", "text": "مالِک خُدائ ربُ الافواج د بنى اِسرائيلو خُدائ پاک فرمائى، ”زۀ به امون د مِصر د تيبس معبود او د مِصر نورو معبودانو ته سزا ورکړم. زۀ به د مِصر بادشاهانو او فِرعون ته او هغوئ ټولو ته سزا ورکړم څوک چې په هغۀ يقين کوى."}, {"ref": "None Jeremiah 4:25", "text": "مالِک خُدائ دا اعلان وکړو چې، د موآب ښکر مات شو، او د هغۀ طاقت ختم شو.“"}, {"ref": "None Jeremiah 4:25", "text": "دا مشهور ښار به څومره وران ويجاړ وى، کوم ښار چې په يو وخت کښې د خوشحالۍ ډک وو."}, {"ref": "None Jeremiah 4:26", "text": "خو اوس تاسو ټول د مالِک خُدائ دې پېغام ته غوږ ونيسئ، تاسو د يهوداه ټولو خلقو څوک چې اوس په مِصر کښې اوسېږئ، زۀ په ژوندى مالِک قادر مطلق خُدائ قسم خورم، مالِک خُدائ فرمائى چې، زما نوم به نور هيڅکله په مِصر کښې د يو يهودى په خولۀ وانۀ خستلے شى. په تاسو کښې به يو هم زما نوم د دُعا او د قسم خوړلو دپاره استعمال نۀ کړى، هغه دا چې، په يقين سره مالِک قادر مطلق خُدائ ژوندے دے."}, {"ref": "None Jeremiah 4:26", "text": "مالِک خُدائ فرمائى چې، زۀ به هغوئ هغه خلقو ته حواله کړم څوک چې دوئ وژل غواړى، نبوکدنضر د بابل بادشاه او د هغۀ آفسرانو ته. خو وروستو به مِصر کښې د وړاندې په شان خلق بيا آباد شى. دا مالِک خُدائ فرمائى.“"}, {"ref": "None Jeremiah 4:26", "text": "مالِک خُدائ فرمائى چې، ”په موآب باندې مے وڅښئ او نشه يې کړئ، ځکه چې هغۀ خپل ځان په ما اوچت ګڼلو، پرېږده چې اوس هغه په خپلو اولټو کښې ورغړى، او پرېږده چې هغه د خلقو د خندا شى."}, {"ref": "None Jeremiah 4:26", "text": "مالِک خُدائ ربُ الافواج فرمائى چې، د هغۀ ځوانان به په کوڅو کښې راپرېوځى او قتل به شى، او د هغوئ فوجيان به په هغه ورځ ټول ختم کړے شى."}, {"ref": "None Jeremiah 4:27", "text": "زۀ به په تاسو ضرور افتونه نازل کړم، نه چې آبادى. د يهوداه هر يو کس څوک چې اوس په مِصر کښې اوسيږى ټول به جنګ او يا په قحط کښې مړۀ شى ترڅو چې يو هم ژوندے پاتې نۀ شى."}, {"ref": "None Jeremiah 4:27", "text": "”اے زما خِدمتګاره يعقوبه مۀ يرېږه، اے اِسرائيله مۀ يرېږه. زۀ به تاسو د هغه لرې مُلک نه دوباره خپلو کورونو ته راولم، چرته چې تاسو جلاوطن شوى يئ. ستا اولاد به زۀ خپلو کورونو ته د جلاوطنۍ نه واپس راولم. يعقوب به دوباره خپل مُلک ته راشى او په امن او سکون سره به ژوند کوى، او تاسو به څوک هم نۀ يروى."}, {"ref": "None Jeremiah 4:27", "text": "اے موآبه، آيا تا به بنى اِسرائيلو پورې خندا نۀ کوله څۀ؟ آيا ستاسو په خيال هغوئ غلۀ وُو، چې کله به تاسو د هغوئ په حقله خبرې کولې نو په مسخره آميزه توګه به مو خپل سرونه خوځول؟"}, {"ref": "None Jeremiah 4:27", "text": "زۀ به د دمشق په دېوالونو باندې اور ولګوم، او تر دې چې دا به د بِن‌حدد محلونه وسوزوى.“"}, {"ref": "None Jeremiah 4:28", "text": "صرف يو څو کسان به د مرګ نه وتښتى او د مِصر نه به يهوداه ته واپس شى. نو بيا ټول هغه کسان چې مِصر ته راغلى دى نو هغوئ ته به دا پته ولګى چې د چا خبره رښتيا ده، زما او کۀ د هغوئ."}, {"ref": "None Jeremiah 4:28", "text": "مالِک خُدائ فرمائى چې، اے زما خِدمتګاره يعقوبه مۀ يرېږه، ځکه زۀ تا سره يم. زۀ به په پوره توګه هغه قومونه تباه کړم کومو ته چې تاسو ما جلا وطن کړى وئ، خو زۀ به تاسو په مکمل توګه نۀ تباه کوم. زۀ به ستاسو په اِنصاف سره تنبيه وکړم، زۀ به تاسو بې‌سزا نۀ پرېږدم.“"}, {"ref": "None Jeremiah 4:28", "text": "اے د موآب اوسېدونکو، تاسو خپل ښارونه پرېږدئ او په ګټانو کښې اوسېږئ. لکه د ګوګوشتکو په شان شئ، چې د غارونو په خولۀ کښې خپل ځان له جاله جوړوى."}, {"ref": "None Jeremiah 4:28", "text": "د قيدار او د حاضور د علاقې په حقله کوم چې د بابل بادشاه نبوکدنضر ورباندې حمله وکړه، مالِک خُدائ فرمائى چې، ”راپاڅئ او په قيدار باندې حمله وکړئ او د مشرق اوسېدونکى تباه کړئ."}, {"ref": "None Jeremiah 4:29", "text": "مالِک خُدائ فرمائى چې، دا به تاسو دپاره نښه وى چې زۀ په دې ځائ کښې تاسو ته سزا درکړم، نو تاسو به په دې پوهه شئ چې ما ستاسو خلاف صرف خبرې نۀ دى کړې بلکې ضرور به سزا هم درکوم."}, {"ref": "None Jeremiah 4:29", "text": "مونږ د موآب د کبر په حقله واورېدل، ځکه چې د هغۀ بې‌حده کبر او سوچ، د هغۀ کبر او غرور او د هغۀ د زړۀ د خود غرضۍ نه خبر يُو."}, {"ref": "None Jeremiah 4:29", "text": "د هغوئ خېمې او رمې به قبضه کړے شى، د هغوئ د سر سورے به ترې نه سره د سامانه او اوښانو واخستلے شى. او خلق به د هرې خوا نه چغې سورې وهى. او هر چرته به يره خوره شوې وى."}, {"ref": "None Jeremiah 4:30", "text": "مالِک خُدائ فرمائى چې، لکه څنګه چې ما د يهوداه بادشاه صدقياه د بابل بادشاه نبوکدنضر ته حواله کړو، دغه شان به زۀ د فِرعون حفرع د مِصر بادشاه هم د هغۀ دشمنانو ته حواله کړم څوک چې د دۀ مرګ پسې ګرځى.“"}, {"ref": "None Jeremiah 4:30", "text": "مالِک خُدائ فرمائى چې، زۀ د هغوئ د غرور نه خبر يم خو دا بې‌مطلبه دے، او د هغوئ عملونه عبث دى."}, {"ref": "None Jeremiah 4:30", "text": "مالِک خُدائ فرمائى چې، اے د حاضور خلقو په منډه وتښتئ. او خپل ځانونه په ژورو غارونو کښې پټ کړئ. ځکه چې د بابل بادشاه نبوکدنضر ستا خلاف منصوبه تياره کړې ده. او ستاسو د تباهۍ تيارے کوى."}, {"ref": "None Jeremiah 4:31", "text": "نو په دې وجه زۀ په موآب ماتم کوم، زۀ د ټولو موآبيانو دپاره ژړا کوم، او زۀ د قير‌حراست د خلقو دپاره ژړا کوم."}, {"ref": "None Jeremiah 4:31", "text": "مالِک خُدائ فرمائى، راپاڅه او په هغه ښارونو باندې حمله وکړه څوک چې په آرام او سکون کښې ژوند کوى. د چا چې نۀ دروازې شته او نۀ دېوالونه او يواځې اوسيږى."}, {"ref": "None Jeremiah 4:32", "text": "سبماه، زۀ به په تا وير وکړم د دې نه هم زيات چې مې په يعزير کړى وُو، سبماه ستا د انګورو څانګې تر سمندر پورې رسېدلى دى، خو تباه کوونکے ستا په مېوو او انګورو راپرېوتلے دے."}, {"ref": "None Jeremiah 4:32", "text": "د هغوئ اوښان تالا کړه او د هغوئ رَمې لوټ کړه. او زۀ به هغوئ څوک چې په دشتو او ميرو کښې اوسيږى د هوا په مخکښې خوارۀ کړم او د هرې خوا نه به پرې افت نازل کړم. دا د مالِک خُدائ فرمان دے."}, {"ref": "None Jeremiah 4:33", "text": "د موآب د زرخېزه پټو او مُلک نه د خندا او خوشحالۍ آوازونه تلى دى، ما د انګورو د لنګرو نه مے جوړول بند کړى دى، هيڅ څوک هم انګور په خوشحالۍ سره نۀ نچوړوى. تر دې چې هلته شور او چغې اورېدلے شى، خو د خوشحالۍ نه بلکې د جنګ."}, {"ref": "None Jeremiah 4:33", "text": "حاضور به د ګيدړانو د اوسېدو ځائ شى او د همېشه دپاره به وران او شاړ پروت وى. هيڅ څوک به هلته نۀ ژوند کوى او نۀ به اوسيږى.“"}, {"ref": "None Jeremiah 4:34", "text": "د هغوئ د ژړا آوازونه د حسبون نه 