ef": "2 Samuel 2:16", "text": "نو هغو درېو زړورو کسانو د فلسطینیانو کرښې ماتې کړې، د څاه څخه یې اوبه راوویستلې او داود ته یې راوړلې، خو داود هغه ونه څښلې او هغه یې د نذرانې په توګه څښتن ته توی کړې."}, {"ref": "2 Samuel 2:16", "text": "کله چې د څښتن فرښته نژدې وه چې اورشلیم ښار وران کړي، څښتن خپله اراده خلکو ته د سزا ورکولو په هکله بدله کړه او هغې فرښتې ته چې هغوی یې وژل، وویل: «ودرېږه! بس دی! دوی پوره ستونزه وزغمله.» دا په داسې وخت کې پېښ شو کله چې فرښته د یبوسي ارونه له درمند ځای سره ولاړه وه."}, {"ref": "2 Samuel 2:17", "text": "یوآب ورغی او هغې ورڅخه پوښتنه وکړه: «ایا یوآب تاسو یئ؟» هغه ځواب ورکړ: «هو، زه یم.» هغې وویل: «باداره! زما خبره واورئ.» هغه ځواب ورکړ: «زه یې اورم.»"}, {"ref": "2 Samuel 2:17", "text": "خو د زرویه زوی ابیشای د داود د مرستې دپاره راغی. په هغه فلسطیني جنګیالي باندې یې حمله وکړه او ویې واژه. نو د داود کسانو هغه ته قسم ورکړ او ویې ویل: «له دې نه وروسته به زمونږ سره جنګ ته نه راځئ. تاسو د اسراییلو دپاره د څراغ په شان یئ او مونږ نه غواړو چې دا څراغ مړ شي.»"}, {"ref": "2 Samuel 2:17", "text": "له اسمانه څښتن لاس خپل کړ را اوږد ویې نیولم له ژورو اوبو ده راوویستلم"}, {"ref": "2 Samuel 2:17", "text": "داود وویل: «ای څښتنه، زه دا هېڅکله نه شم څښلی! دا به د هغو کسانو د وینو د څښلو په شان وي چې خپل ژوند یې په خطر کې اچولی ؤ!» نو هغه دا اوبه ونه څښلې. دا د هغو درېو زړورو کسانو کارونه وو."}, {"ref": "2 Samuel 2:17", "text": "کله چې داود هغه فرښته ولیدله چې خلک یې وژل، نو څښتن ته یې وویل: «زه ګناهکار یم. ما ګناه کړې ده، دا خلک لکه د بې ګناه پسونو په شان دي. هغوی څه کړي دي؟ مهرباني وکړه ما او زما کورنۍ ته سزا راکړه.»"}, {"ref": "2 Samuel 2:18", "text": "هغې وویل: «په پخوا زمانه کې به یې داسې ویل: لاړ شه او خپل ځواب د آبل په ښار کې تر لاسه کړه او موضوع به حل کېدله."}, {"ref": "2 Samuel 2:18", "text": "د وخت په تېرېدلو سره د فلسطینیانو سره په جوب کې یوه بله جګړه وشوه. حوشاتي سبکای د رافا د لوړ قدو اولادې څخه یو تن چې ساف نومېده، وواژه."}, {"ref": "2 Samuel 2:18", "text": "زه یې کړمه له قوي دښمنه خلاص او له هغو چې نفرت یې کړ له ما نه دوی وو ډېر قوي له ما نه"}, {"ref": "2 Samuel 2:18", "text": "ابیشای د یوآب ورور، چې مور یې زرویه وه، د دېرش کسیزې ډلې مشر ؤ. هغه په خپلې نېزې باندې د درې سوه کسانو سره وجنګېده او هغوی یې ووژل. نو په دې ډول هغه هم لکه د هغو درېو جنګیالیو په شان مشهور شو."}, {"ref": "2 Samuel 2:18", "text": "په هماغه ورځ جاد داود ته ورغی او ورته ویې ویل: «د یبوسي ارونه درمند ځای ته لاړ شه او هلته د څښتن دپاره د قربانۍ ځای جوړ کړه.»"}, {"ref": "2 Samuel 2:19", "text": "زمونږ ښار په اسراییلو کې یو ډېر سوله ییز ښار دی او خلک یې وفادار دي. تاسو ولې د دې کوښښ کوئ چې داسې ښار له منځه یوسئ چې په اسراییلو کې د مور په شان دی؟ ایا تاسو غواړئ هغه څه چې د څښتن دي هغه وران کړئ؟»"}, {"ref": "2 Samuel 2:19", "text": "په جوب کې د فلسطینیانو سره په یوه بله جګړه کې د یاییر زوی الحانان چې د بیت لحم څخه ؤ جتي جلیات وواژه چې د هغه سره یوه نېزه وه چې د هغې لاستی د اوبدلو د دستګاه د میلې په شان ؤ."}, {"ref": "2 Samuel 2:19", "text": "هغه وخت کې چې زه ومه په تکلیف کې دوی حمله وکړه په ما خو څښتن راڅخه وکړ ملاتړ"}, {"ref": "2 Samuel 2:19", "text": "که څه هم هغه په هغې دېرش کسیزې ډلې کې ډېر زیات مشهور او د هغوی مشر شو، خو د هغو درېو تنو په شان مشهور نه شو."}, {"ref": "2 Samuel 2:19", "text": "نو لکه څنګه چې څښتن د جاد په وسیله امر کړی ؤ، داود هغه ځای ته لاړ."}, {"ref": "2 Samuel 2:20", "text": "یوآب ځواب ورکړ: «هېڅکله نه! زه به هېڅکله ستاسو ښار وران نه کړم او نه به یې له منځه یوسم!"}, {"ref": "2 Samuel 2:20", "text": "بیا په جت کې یوه بله جګړه وشوه. په هغه ځای کې یو ډېر غټ سړی ؤ چې لاسونو او پښو یې شپږ، شپږ ګوتې درلودلې چې ټولې څلورویشت ګوتې وې، هغه هم د رافا د لوړ قدو د اولادې څخه ؤ."}, {"ref": "2 Samuel 2:20", "text": "زه یې راوستلم د امن ځای ته ځکه یې بچ کړم چې ؤ راضي له ما"}, {"ref": "2 Samuel 2:20", "text": "بنایاه د یهویاداع زوی چې د قبصییل څخه ؤ، یو توریالی عسکر ؤ. هغه ډېر د زړورتوب کارونه کړي وو چې په هغو کې د دوو قوي موآبي جنګیالیو وژل شامل وو. یوځل هغه د واورې په ورځ یوې کندې ته ورښکته شو او یو زمری یې وواژه."}, {"ref": "2 Samuel 2:20", "text": "کله چې ارونه وکتل، پاچا او د هغه کسان یې ولیدل چې د ده خواته راروان دي. هغه راووت او د پاچا په مخکې د درناوي په خاطر په ځمکه باندې پړمخې پرېوت."}, {"ref": "2 Samuel 2:21", "text": "دا زمونږ پلان نه دی. یو سړی چې شبع نومیږي او د بکري زوی دی او د افرایم د غرنۍ سیمې څخه دی د داود پاچا په وړاندې یاغي شوی دی. یوازې همدا یو سړی راوسپارئ، نو زه به ښار پرېږدم.» هغې وویل: «ډېر ښه، مونږ به د هغه سر د دېوال څخه تاسو ته درګوزار کړو.»"}, {"ref": "2 Samuel 2:21", "text": "کله چې هغه اسراییلیانو ته پېغور ورکړ، د داود وراره یوناتان چې د شمعي زوی ؤ، هغه وواژه."}, {"ref": "2 Samuel 2:21", "text": "څښتن اجر راکوي ځکه کړم کارونه نېک یم بې ګناه ځکه انعام راکوي ماته"}, {"ref": "2 Samuel 2:21", "text": "همدارنګه هغه یو ډېر غټ مصری چې په نېزه باندې سمبال ؤ، وواژه. بنایاه په خپل ډانګ باندې په هغه حمله وکړه، د هغه مصري د لاس څخه یې نېزه واخیستله او هغه یې ورباندې وواژه."}, {"ref": "2 Samuel 2:21", "text": "ارونه پوښتنه وکړه: «اعلیحضرته، تاسو ولې ماته راغلئ؟» داود ځواب ورکړ: «زه د دې دپاره راغلی یم چې ستا درمند ځای په بیه واخلم او په هغه کې د څښتن دپاره د قربانۍ ځای جوړ کړم، ځکه زه غواړم چې وبا بنده شي.»"}, {"ref": "2 Samuel 2:22", "text": "بیا هغه ښځه د خپلې حکیمانه مشورې سره د ښار خلکو ته ورغله او هغوی د شبع سر پرې کړ او هغه یې یوآب ته وروغورځاوه. نو یوآب سرنی وغږاوه چې د هغه کسان ښار پرېږدي. هر یو خپل کور ته ستون شو، یوآب هم بېرته اورشلیم ته ستون شو او پاچا ته ورغی."}, {"ref": "2 Samuel 2:22", "text": "دغه څلور کسان په جت کې د رافا د لوړ قدو اولادې څخه وو او هغوی د داود او د هغه د کسانو له خوا ووژل شول."}, {"ref": "2 Samuel 2:22", "text": "ما د څښتن د قوانینو اطاعت کړی دی نه مې مخ دی اړولی له خپل خدای نه د بدۍ په خاطر"}, {"ref": "2 Samuel 2:22", "text": "بنایاه داسې د زړورتوب کارونه وکړل چې د درېو جنګیالیو په شان مشهور شو."}, {"ref": "2 Samuel 2:22", "text": "ارونه وویل: «اعلیحضرته! هرڅه چې تاسو غواړئ هغه واخلئ او څښتن ته یې وړاندې کړئ. دا دي غویان د سوځېدونکې قربانۍ دپاره او دا دي د هغوی جغونه او د غوبل کولو څپرونه چې د سوځولو د موادو په توګه ورڅخه کار واخیستل شي."}, {"ref": "2 Samuel 2:23", "text": "یوآب د اسراییلو د ټولو لښکرو قوماندان ؤ او د یهویاداع زوی بنایاه د داود د ساتونکو مشر، یعنې د کریتیانو او فلیتیانو قوماندان ؤ."}, {"ref": "2 Samuel 2:23", "text": "ما عمل کړی د هغه ټولو حکمونو باندې نافرماني مې کړې نه ده د هغه له قوانینو څخه"}, {"ref": "2 Samuel 2:23", "text": "د هغه عزت د هغې دېرش کسیزې ډلې څخه ډېر زیات شو، خو په درېو جنګیالیو کې نه شمېرل کېده. داود هغه د خپلو ساتونکو مشر وټاکه."}, {"ref": "2 Samuel 2:23", "text": "ای پاچا، دا ټول تاسو ته درکوم.» همدارنګه ارونه پاچا ته وویل: «ستاسو څښتن خدای دې ستا قرباني قبوله کړي.»"}, {"ref": "2 Samuel 2:24", "text": "ادورام د بېګارۍ کارونو مشر ؤ او یهوشافاط د اخیلود زوی د پېښو د ثبتولو مسوول ؤ."}, {"ref": "2 Samuel 2:24", "text": "هغه پوهیږي زه بې عیبه یمه بدو کارو نه مې ساتلی دی ځان"}, {"ref": "2 Samuel 2:24", "text": "په دېرش کسیزه ډله کې دغه کسان وو: عساهیل د یوآب ورور. الحانان د دودو زوی د بیت لحم څخه"}, {"ref": "2 Samuel 2:24", "text": "خو پاچا ارونه ته په ځواب کې وویل: «نه، زه په دې باندې ټینګار کوم چې د هغې بیه درکړم. زه به خپل څښتن خدای ته هغه سوځېدونکې قربانۍ وړاندې نه کړم چې ماته وړیا تمامې شوې وي.» نو داود هغه درمند ځای او غویان د سپینو زرو په پنځوسو سکو باندې واخیستل."}, {"ref": "2 Samuel 2:25", "text": "شیوا د دربار منشي ؤ، صادوق او ابیاتار کاهنان وو"}, {"ref": "2 Samuel 2:25", "text": "نو اجر راکړی څښتن ځکه کړم کارونه نېک هغه پوهیږي بې ګناه یمه زه"}, {"ref": "2 Samuel 2:25", "text": "شمه او الیقا د حرود څخه."}, {"ref": "2 Samuel 2:25", "text": "بیا داود په هغه ځای کې څښتن ته د قربانۍ ځای جوړ کړ او سوځېدونکې او د سلامتۍ نذرانې یې وړاندې کړې. نو څښتن د هېواد دپاره د هغه دعا قبوله کړه او په اسراییلو باندې وبا بنده شوه."}, {"ref": "2 Samuel 2:26", "text": "او یایري عیرا هم د داود کاهن ؤ."}, {"ref": "2 Samuel 2:26", "text": "ای څښتنه، وفادار یې هغه چاته چې وي تاته وفادار تل نېکي کړې د هغو سره چې وي بې عیبه"}, {"ref": "2 Samuel 2:26", "text": "حالز فلتي. عیرا د عقیش زوی د تقوع څخه."}, {"ref": "2 Samuel 2:27", "text": "پاک ته ښکاري خپل ځان پاک ټګمار ته ځان پېچلی"}, {"ref": "2 Samuel 2:27", "text": "ابیعزر د عناتوت څخه. مبونای د حوشا څخه."}, {"ref": "2 Samuel 2:28", "text": "ته عاجزانو ته نجات ورکوې خو کبرجن ټیټوې"}, {"ref": "2 Samuel 2:28", "text": "صلمون د اخوخ څخه. مهرای د نطوفې څخه."}, {"ref": "2 Samuel 2:29", "text": "ته څراغ یې زما ای څښتنه چې بدلوې زما تیارې په رڼا"}, {"ref": "2 Samuel 2:29", "text": "حالب د بعنه زوی د نطوفې څخه. اتای د ریبای زوی د بنیامین د جبعې څخه."}, {"ref": "2 Samuel 2:30", "text": "راکوې راته قوت چې کړم حمله په دښمن راکوې راته قدرت په دېوالونو د ختلو"}, {"ref": "2 Samuel 2:30", "text": "بنایاه د فرعاتون څخه. هدای د جاعش د خوړونو څخه."}, {"ref": "2 Samuel 2:31", "text": "ګوره زما خدای څومره کامل یې عملونه دي څومره د باور یې ټول لوظونه دي هغه دی سپر هغوی ته ټول چې پناه راوړي هغه ته"}, {"ref": "2 Samuel 2:31", "text": "ابي علبون د عربات څخه. عزموت د بحوریم څخه."}, {"ref": "2 Samuel 2:32", "text": "ځکه څوک دی خدای بې له څښتنه؟ څوک کړي دفاع زمونږه بې له هغه نه؟"}, {"ref": "2 Samuel 2:32", "text": "الیحبا د شعلبون څخه. د یاشن زامن. یوناتان."}, {"ref": "2 Samuel 2:33", "text": "هغه خدای دی چې دی زما ځواکمن پناه ځای هغه خدای دی چې خوندي مې ساتي لاره"}, {"ref": "2 Samuel 2:33", "text": "شمه د حرار څخه. اخیام د شارر زوی د حرار څخه."}, {"ref": "2 Samuel 2:34", "text": "کړم یې زه ثابت قدم لکه هوسۍ په شان او په غرونو کې مې ساتي خوندي"}, {"ref": "2 Samuel 2:34", "text": "الیفلط د احسبای زوی د معکې څخه. الیعام د اخیتوفل زوی د جیلوه څخه."}, {"ref": "2 Samuel 2:35", "text": "هغه ما تیاروي د جنګ دپاره ترڅو زه کړمه راکش لینده د برنجو"}, {"ref": "2 Samuel 2:35", "text": "حزرای د کرمل څخه. فعرای اربي."}, {"ref": "2 Samuel 2:36", "text": "سپر راکوې د خپل خلاصون ماته زه قوي کړی ستا کومک یمه"}, {"ref": "2 Samuel 2:36", "text": "یجال د ناتان زوی د صوبې څخه. باني د جاد څخه."}, {"ref": "2 Samuel 2:37", "text": "پراخوې ته زما د پښو لاره ځکه پښې زما هېڅکله نه ښوییږي"}, {"ref": "2 Samuel 2:37", "text": "صالق د عمون څخه نحرای د بیروت څخه چې د زرویه د زوی یعنې د یوآب وسلې به یې وړلې."}, {"ref": "2 Samuel 2:38", "text": "دښمنان تعقیبوم او ورکومه ورته ماتې نه راګرځم تر هغې چې یې نابود کړم"}, {"ref": "2 Samuel 2:38", "text": "عیرا او جارب له یتر څخه"}, {"ref": "2 Samuel 2:39", "text": "داسې یې وهم چې پاڅېدلی نه شي نسکور پراته دي زما د پښو لاندې"}, {"ref": "2 Samuel 2:39", "text": "اوریا حیتي. دا ټول اووه دېرش کسان وو."}, {"ref": "2 Samuel 2:40", "text": "راکوې ما له ته قوت د جګړې غورځوې ماته په پښو کې دښمنان"}, {"ref": "2 Samuel 2:41", "text": "مجبوروې دښمنان زما تېښتې ته تباه کوم هغه چې کرکه کړي له ما نه"}, {"ref": "2 Samuel 2:42", "text": "هغوی فریاد کړي د کومک دپاره نشته څوک چې کړي دوی خلاص وهي چیغې دوی څښتن ته هغه نه ورکوي دوی ته ځوابونه"}, {"ref": "2 Samuel 2:43", "text": "لکه د دوړې میده کومه یې زه داسې تر پښو لاندې کومه یې زه لکه د خټو د کوڅو په شان"}, {"ref": "2 Samuel 2:44", "text": "تا زه خلاص کړمه د خپلو سرکښانو او په قومونو دې سردار کړمه اوس هغه خلک مې خدمتونه کوي څوک چې پخوا نه پېژندل ما کله"}, {"ref": "2 Samuel 2:45", "text": "هم بېګانه خلک زما په مخکې ټیټوي سرونه چې کله اوري زما په هکله اطاعت مې کوي"}, {"ref": "2 Samuel 2:46", "text": "دوی بایلي خپل همتونه په لړزه باندې راوځي دوی له خپلو کلاګانو"}, {"ref": "2 Samuel 2:47", "text": "څښتن ژوندی دی! وي دې ثنا زما ساتونکي ته! د هغه ځواکمن خدای لویي کړئ اعلان چې مې ژغوري چې مې ژغوري"}, {"ref": "2 Samuel 2:48", "text": "راکوي ماته توفیق چې بدل واخلم له دښمنه راولي زما د قدرت لاندې قومونه"}, {"ref": "2 Samuel 2:49", "text": "او خلاصوي ما له خپلو دښمنانو راکوې راته بریا په دښمنانو ای څښتنه او ما ساتې ته له ظالمو انسانانو څخه"}, {"ref": "2 Samuel 2:50", "text": "نو ځکه ای څښتنه، کوم ستاینه ستا د قومونو منځ کې ثنا او صفت ستا د نامه کومه"}, {"ref": "2 Samuel 2:51", "text": "خدای ورکوي لویې بریاوې خپل پاچا ته کوي تلپاتې مینه د خپل غوره کړای شوي سره تل ترتله د داود او د هغه د اولادې سره"}, {"ref": "Acts 1:1", "text": "په قیصریه کې یو سړی ؤ چې کورنیلیوس نومېده او د رومي لښکرو د کنډک چې د «ایټالوي کنډک» په نوم یادېده، مشر ؤ."}, {"ref": "Acts 1:1", "text": "په ټوله یهودیه کې رسولان او ایمانداران خبر شول چې غیریهودیانو هم د خدای پیغام منلی دی."}, {"ref": "Acts 1:1", "text": "په هماغه وخت کې هیرودیس پاچا د کلیسا د ځینو غړو په ځورولو پیل وکړ."}, {"ref": "Acts 1:1", "text": "د انطاکیې په کلیسا کې ځینې پیغمبران او استاذان وو لکه برناباس، شمعون چې د تور په نوم یادېده، لوکیوس قیرواني او مناحم چې د هیرودیس پاچا سره لوی شوی ؤ او شاوول هم د هغوی سره ؤ."}, {"ref": "Acts 1:1", "text": "په همدې ډول په قونیه کې پولوس او برناباس د یهودیانو کنیسې ته ورغلل او داسې خبرې یې وکړې چې زیات شمېر یهودیانو او غیریهودیانو ایمان راوړ."}, {"ref": "Acts 1:1", "text": "ځینې خلک د یهودیې څخه انطاکیې ته راغلل او ایماندارانو ته یې تعلیم ورکاوه او ویل یې: «که تاسو د موسی د شریعت له مخې سنت نه شئ، نو خلاصون نه شئ موندلی.»"}, {"ref": "Acts 1:1", "text": "پولوس دربې او لسترې ته ورسېده او په لستره کې یې ولیدل چې د تیموتاوس په نوم یو ایماندار اوسېده چې مور یې یهودۍ ایمانداره وه، خو پلار یې یوناني ؤ."}, {"ref": "Acts 1:1", "text": "پولوس او سیلاس د امفیپولیس او اپولونیا د ښارونو څخه تېر شول او تسالونیکیې ته چې د یهودیانو کنیسه په کې وه، ورسېدل."}, {"ref": "Acts 1:1", "text": "له هغې وروسته پولوس له آتن څخه روان شو او قرنتوس ته لاړ."}, {"ref": "Acts 1:1", "text": "کوم وخت چې اپولوس په قرنتوس کې ؤ، نو پولوس د هغه ولایت له داخلي سیمو څخه تېر شو او افسیس ته ورسېده او هلته د څو ایماندارانو سره مخامخ شو."}, {"ref": "Acts 1:2", "text": "کورنیلیوس او د هغه کورنۍ دینداره خلک وو او د خدای څخه وېرېدل. هغه به غریبو یهودیانو ته ډېر خیراتونه ورکول او تل به یې دعا کوله."}, {"ref": "Acts 1:2", "text": "کله چې پطروس بېرته اورشلیم ته راغی، نو یوې ډلې چې د غیریهودیانو د سنتولو غوښتونکي وو په هغه باندې اعتراض وکړ"}, {"ref": "Acts 1:2", "text": "هغه د یوحنا ورور یعقوب په توره باندې وواژه."}, {"ref": "Acts 1:2", "text": "یوه ورځ چې هغوی د څښتن عبادت کاوه او روژه یې نیولې وه، روح القدس ورته وویل: «برناباس او شاوول د هغه کار دپاره چې ما راغوښتي دي، وقف کړئ.»"}, {"ref": "Acts 1:2", "text": "خو هغو یهودیانو چې ایمان یې نه ؤ راوړی، غیریهودیان ولمسول او د هغوی ذهنونه یې د ایماندارانو په وړاندې خراب کړل."}, {"ref": "Acts 1:2", "text": "پولوس او برناباس د هغوی سره موافق نه وو او ډېر سخت بحث یې ورسره وکړ او پرېکړه یې وکړه چې پولوس او برناباس دې د نورو ایماندارانو سره اورشلیم ته لاړ شي او د دې موضوع په هکله دې د رسولانو او نورو مشرانو سره خبرې وکړي."}, {"ref": "Acts 1:2", "text": "د لسترې او قونیې ایماندارانو د هغه صفت کاوه."}, {"ref": "Acts 1:2", "text": "پولوس د خپل عادت له مخې کنیسې ته لاړ او درې هفتې یې د هر سبت په ورځ د خدای د کلام په هکله د هغوی سره بحثونه وکړل"}, {"ref": "Acts 1:2", "text": "په هغه ځای کې هغه د یو یهودي سره چې اکیلا نومېده او په اصل کې د پونتوس څخه ؤ، مخامخ شو. اکیلا د خپلې ښځې پریسکیلا سره نوی له ایټالیې څخه راغلی ؤ، ځکه چې کلودیوس امپراتور امر کړی ؤ چې ټول یهودیان دې له روم څخه ووځي. پولوس لاړ چې د هغوی سره وګوري"}, {"ref": "Acts 1:2", "text": "د هغوی څخه یې پوښتنه وکړه: «کله چې تاسو ایمان راوړ، نو روح القدس مو تر‌لاسه کړ؟» هغوی ځواب ورکړ: «نه، مونږ لا خبر هم نه یو چې روح القدس شته.»"}, {"ref": "Acts 1:3", "text": "یوه ورځ د ماسپښین شاوخوا درې بجې هغه رویا ولیدله چې د خدای فرښته د هغه خواته راغله او ورته ویې ویل: «ای کورنیلیوسه!»"}, {"ref": "Acts 1:3", "text": "او ویل یې: «ته ولې د ناسنت شویو خلکو کور ته لاړې او د هغوی سره دې ډوډۍ هم وخوړله؟»"}, {"ref": "Acts 1:3", "text": "کله چې هیرودیس ولیدل چې یهودیان په دې کار خوشحاله شول، نو پطروس یې هم ونیوه. دا کار د فطیرې ډوډۍ د اختر په ورځو کې وشو."}, {"ref": "Acts 1:3", "text": "بیا هغوی د روژې نیولو او دعا کولو څخه وروسته د هغو دواړو په سرونو باندې لاس کېښود او هغوی یې د هغه کار دپاره ولېږل. برناباس او شاوول په قبرس کې"}, {"ref": "Acts 1:3", "text": "نو پولوس او برناباس د اوږدې مودې دپاره هلته پاتې شول او په زړورتیا سره یې د څښتن عیسی په هکله خبرې کولې. څښتن عیسی هغوی ته د حیرانوونکو کارونو او معجزو د ښودلو قدرت ورکړ او ثابته یې کړه چې د هغوی پیغام د هغه د فضل په هکله رښتیا ؤ."}, {"ref": "Acts 1:3", "text": "هغوی د انطاکیې د کلیسا له خوا ولېږل شول او په داسې حال کې چې هغوی د فنیقیې او سامرې نه تېرېدل، ایمانداران یې خبرول چې څنګه غیریهودیانو ایمان راوړ. نو د دې خبر په اورېدلو ټول ایمانداران ډېر خوشحاله شول."}, {"ref": "Acts 1:3", "text": "پولوس غوښتل چې تیموتاوس د ځان سره بوځي، نو هغه یې د هغو ځایونو د یهودیانو په خاطر سنت کړ. هغه ځکه داسې وکړل چې ټولو ته معلومه وه چې د تیموتاوس پلار یوناني ؤ."}, {"ref": "Acts 1:3", "text": "او دا یې ورته بیان او ثابت کړل چې مسیح باید تکلیفونه وزغمي او د مړینې څخه وروسته به بیا راژوندی شي. پولوس وویل: «همدا عیسی چې زه د هغه په هکله تاسو سره خبرې کوم، هماغه مسیح دی.»"}, {"ref": "Acts 1:3", "text": "او په دې خاطر چې هغه هم د هغوی په شان خېمه جوړوونکی ؤ، نو د هغوی سره پاتې شو او یوځای یې ورسره کار کاوه."}, {"ref": "Acts 1:3", "text": "پولوس پوښتنه وکړه: «بیا تاسو ته د تعمید کوم ډول غسل درکړل شوی دی؟» هغوی په ځواب کې وویل: «د یحیی د تعمید غسل.»"}, {"ref": "Acts 1:4", "text": "هغه له وېرې په ځیر سره فرښتې ته وکتل او پوښتنه یې ترې وکړه: «ښاغلیه څه وایې؟» فرښتې ځواب ورکړ: «ستا دعاګانې او خیراتونه چې تا ورکړي وو، هغه د خدای حضور ته ورسېدل او قبول یې کړل."}, {"ref": "Acts 1:4", "text": "نو څه چې پېښ شوي وو، پطروس ټکي په ټکي هغوی ته بیان کړل."}, {"ref": "Acts 1:4", "text": "کله چې هغه پطروس ونیوه، نو په زندان کې یې واچاوه او هغه یې څلورو ډلګیو ته چې په هر یو کې څلور څلور عسکره وو، وسپاره چې ساتنه یې وکړي. هیرودیس د دې نیت درلود چې د فسحې د اختر څخه وروسته هغه د ټولو خلکو په مخکې محاکمه کړي."}, {"ref": "Acts 1:4", "text": "نو برناباس او شاوول دواړه د روح القدس په وسیله ولېږل شول. هغوی چلندیې ته لاړل او له هغه ځای څخه په کشتۍ کې قبرس ته لاړل."}, {"ref": "Acts 1:4", "text": "خو د ښار خلک په دوو ډلو ووېشل شول: ځینې د یهودیانو په خوا او ځینې د رسولانو په خوا شول."}, {"ref": "Acts 1:4", "text": "کله چې پولوس او برناباس اورشلیم ته ورسېدل، نو د کلیسا د غړو، رسولانو او مشرانو له خوا ورته تود هرکلی وویل شو او بیا یې هغوی د هغو ټولو کارونو څخه خبر کړل چې خدای د هغوی په وسیله سرته رسولي وو."}, {"ref": "Acts 1:4", "text": "کله چې هغوی د یو ښار نه بل ښار ته سفر کاوه، نو کومې پرېکړې چې رسولانو او مشرانو په اورشلیم کې کړې وې، هغه یې ایماندارانو ته رسولې، ترڅو عمل ورباندې وکړي."}, {"ref": "Acts 1:4", "text": "ځینې یهودیان او زیات شمېر دینداره یونانیان او نامتو ښځې قانع شوې او پولوس او سیلاس سره یوځای شول."}, {"ref": "Acts 1:4", "text": "د هر سبت په ورځ هغه په کنیسه کې بحث کاوه او کوښښ یې کاوه چې یهودیانو او یونانیانو ته قناعت ورکړي."}, {"ref": "Acts 1:4", "text": "پولوس وویل: «یحیی چې د تعمید کوم غسل ورکاوه، هغه د ګناهونو څخه د توبې ویستلو نښه وه او خلکو ته به یې ویل چې په هغه چا باندې ایمان راوړئ چې د هغه څخه وروسته راروان دی یعنې په عیسی باندې ایمان راوړئ.»"}, {"ref": "Acts 1:5", "text": "اوس یو څو کسان یافا ته د شمعون پسې چې پطروس ورته ویل کیږي، ولېږه چې هغه راولي."}, {"ref": "Acts 1:5", "text": "هغه وویل: «زه د یافا په ښار کې وم او دعا مې کوله چې بې‌هوشه شوم او رویا مې ولیدله چې د یو لوی دسترخوان په شان یو شی چې د څلورو څنډو څخه راځوړند ؤ او د اسمان نه د ځمکې خواته راښکته کېده او ما پورې راورسېده."}, {"ref": "Acts 1:5", "text": "نو پطروس یې په زندان کې وساته، خو ایماندارانو د زړه له کومي د هغه دپاره خدای ته دعاګانې کولې. پطروس له زندان څخه خلاصیږي"}, {"ref": "Acts 1:5", "text": "کله چې هغوی سلامیس ته ورسېدل، نو د یهودیانو په کنیسو کې یې د خدای د کلام وعظ کاوه. یوحنا د هغوی مرستیال ؤ."}, {"ref": "Acts 1:5", "text": "بیا ځینو غیریهودیانو او یهودیانو د خپلو مشرانو سره یوځای دا پرېکړه وکړه چې رسولان وځوروي او سنګسار یې کړي."}, {"ref": "Acts 1:5", "text": "خو د فریسیانو د ډلې ځینې ایمانداران راپاڅېدل او ویې ویل: «غیریهودیان باید سنت کړای شي او هغوی ته دې امر وشي چې د موسی په شریعت باندې عمل وکړي.»"}, {"ref": "Acts 1:5", "text": "نو کلیساګانې په ایمان کې قوي کېدلې او د ایماندارانو شمېر ورځ په ورځ زیاتېده. په ترواس کې د پولوس رویا"}, {"ref": "Acts 1:5", "text": "خو په دې کار د ځینو یهودیانو سره بخیلي راپیدا شوه. هغوی څو بېکاره او لوچک خلک د کوڅو څخه راټول کړل او یوه ډله یې جوړه کړه او په ښار کې یې شور او غوغا جوړه کړه. هغوی د یاسون په کور حمله وکړه او کوښښ یې کاوه چې پولوس او سیلاس پیدا کړي او خلکو ته یې راولي."}, {"ref": "Acts 1:5", "text": "کله چې سیلاس او تیموتاوس د مقدونیې څخه راغلل، نو پولوس خپل ټول وخت د کلام په بیانولو تېر کړ. هغه یهودیانو ته دا شاهدي ورکوله چې عیسی هماغه مسیح دی."}, {"ref": "Acts 1:5", "text": "کله چې هغوی دا واورېدل، نو د څښتن عیسی مسیح په نوم ورته د تعمید غسل ورکړل شو."}, {"ref": "Acts 1:6", "text": "هغه د شمعون څرمن جوړوونکي په کور کې چې د بحیرې په غاړه دی، مېلمه دی.»"}, {"ref": "Acts 1:6", "text": "کله چې ما ورته په غور سره وکتل، نو په هغه کې کورني حیوانات او وحشي ځناور، خزندې او مرغان وو."}, {"ref": "Acts 1:6", "text": "یوه شپه مخکې چې هیرودیس غوښتل پطروس د محاکمې دپاره راولي، پطروس د دوو عسکرو په منځ کې په دوو زنځیرونو تړلی ویده پروت ؤ او ساتونکو د زندان په دروازه کې پهره کوله."}, {"ref": "Acts 1:6", "text": "هغوی تر پافوس پورې په ټوله جزیره کې وګرځېدل او په هغه ځای کې هغوی د یو یهودي جادوګر سره مخامخ شول چې بریشوع نومېده او د پیغمبرۍ دعوه یې کوله."}, {"ref": "Acts 1:6", "text": "کله چې رسولان له دې څخه خبر شول، نو د لیکاونیا د لستره او دربې ښارونو او شاوخوا سیمو ته وتښتېدل."}, {"ref": "Acts 1:6", "text": "رسولان او مشران سره راټول شول چې د دې موضوع په هکله خبرې وکړي."}, {"ref": "Acts 1:6", "text": "هغوی د فریجیې او غلاتیې د سیمو څخه تېر شول، ځکه چې روح القدس هغوی د اسیا په ولایت کې د څښتن عیسی د پیغام ورکولو څخه منع کړي وو."}, {"ref": "Acts 1:6", "text": "خو چې کله یې هغوی پیدا نه کړل، نو یاسون او ځینې نور ایمانداران یې د ښار واکمنانو ته په راښکلو راوستل او چیغې یې وهلې: «دې خلکو نړۍ په بل مخ اړولې ده او اوس دلته راغلي"}, {"ref": "Acts 1:6", "text": "خو کله چې یهودیانو د هغه سره مخالفت وکړ او هغه ته یې بد رد وویل، نو پولوس خپل کالي وڅنډل او هغوی ته یې وویل: «ستاسو خون ستاسو په خپله غاړه دی. زه یې د مسوولیت څخه خلاص یم. زه به له دې وروسته غیریهودیانو ته ورځم.»"}, {"ref": "Acts 1:6", "text": "کله چې پولوس د هغوی په سر باندې خپل لاس کېښود، نو روح القدس ورباندې نازل شو او هغوی په نا‌اشنا ژبو خبرې پیل کړلې او د خدای پیغام یې رساوه."}, {"ref": "Acts 1:7", "text": "کله چې هغې فرښتې د هغه سره خبرې وکړې نو لاړه، بیا کورنیلیوس خپل دوه نوکران او یو عسکر چې یو دینداره سړی ؤ او د هغه د کور د خدمتګارانو څخه ؤ، راوغوښتل."}, {"ref": "Acts 1:7", "text": "بیا مې یو اواز واورېد چې ویل یې: ‹ای پطروسه! پاڅېږه، هغه حلال کړه او ویې خوره.›"}, {"ref": "Acts 1:7", "text": "ناڅاپه د څښتن فرښته راښکاره شوه او په کوټه کې رڼا وځلېدله. فرښتې د پطروس اوږه وخوځوله او هغه یې راویښ کړ او ورته ویې ویل: «زر شه، پاڅېږه.» سمدلاسه د پطروس د لاسونو څخه زنځیرونه ولوېدل."}, {"ref": "Acts 1:7", "text": "هغه د قبرس د والي سرګیوس پولوس ملګری ؤ چې یو هوښیار سړی ؤ. هغه برناباس او شاوول خپل حضور ته راوغوښتل، ځکه چې غوښتل یې د هغوی څخه د خدای کلام واوري."}, {"ref": "Acts 1:7", "text": "هلته هغوی د زېري رسولو ته دوام ورکړ. په لستره کې شل سړي ته شفا ورکول"}, {"ref": "Acts 1:7", "text": "د یو اوږد بحث څخه وروسته پطروس پاڅېده او هغوی ته یې وویل: «ای ورونو، تاسو پوهېږئ چې څه موده مخکې زه خدای ستاسو له منځ څخه غوره کړم چې غیریهودیان زما د خولې نه د عیسی مسیح په هکله زېری واوري او ایمان راوړي."}, {"ref": "Acts 1:7", "text": "کله چې هغوی د میسیه سرحد ته ورسېدل، نو کوښښ یې وکړ چې د بتونیې ولایت ته لاړ شي، خو د عیسی روح یعنې روح القدس هغوی ته اجازه ورنه کړه."}, {"ref": "Acts 1:7", "text": "او یاسون هغوی په خپل کور کې مېلمانه کړي دي. دوی ټولو د امپراتور قانون مات کړی او وایي چې دلته یو بل پاچا دی چې عیسی نومیږي.»"}, {"ref": "Acts 1:7", "text": "نو پولوس له هغه ځای څخه لاړ او د تیتیوس یوستوس په نوم د یو غیریهودي کور ته چې د خدای عبادت به یې کاوه، لاړ. د هغه کور د کنیسې په څنګ کې ؤ."}, {"ref": "Acts 1:7", "text": "هغوی ټول شاوخوا دولس تنه وو."}, {"ref": "Acts 1:8", "text": "هرڅه چې شوي وو، هغوی ته یې وویل او هغوی یې یافا ته ولېږل. پطروس رویا ویني"}, {"ref": "Acts 1:8", "text": "خو ما ورته وویل: ‹څښتنه! هېڅکله نه، ما هېڅکله هم کوم حرام یا ناپاکه شی خولې ته نه دی وروړی.›"}, {"ref": "Acts 1:8", "text": "بیا فرښتې هغه ته وویل: «ملا دې وتړه او څپلۍ دې په پښو کړه.» پطروس همداسې وکړل. بیا فرښتې هغه ته وویل: «خپله چپنه دې واغونده او ما پسې راځه.»"}, {"ref": "Acts 1:8", "text": "خو هغه جادوګر چې یوناني نوم یې الیما ؤ، د هغوی سره مخالفت وکړ او کوښښ یې کاوه چې والي ایمان رانه وړي."}, {"ref": "Acts 1:8", "text": "په لستره کې یو سړی ؤ چې له مور نه شل پیدا شوی ؤ او هېڅکله په خپلو پښو نه ؤ ګرځېدلی."}, {"ref": "Acts 1:8", "text": "خدای چې د هرچا د زړه څخه خبر دی، هغوی ته یې د روح القدس د ورکولو په وسیله دا ثابته کړه چې خدای هغوی هم منلي دي لکه څنګه یې چې مونږ منلي یو."}, {"ref": "Acts 1:8", "text": "نو هغوی د میسیه څخه تېر شول او د ترواس ښار ته لاړل."}, {"ref": "Acts 1:8", "text": "کله چې خلکو او د ښار واکمنانو دا خبرې واورېدلې، نو ډېر نا‌ارامه شول."}, {"ref": "Acts 1:8", "text": "کرسپوس چې د کنیسې مشر ؤ، د خپلې ټولې کورنۍ سره په څښتن عیسی باندې ایمان راوړ. همدارنګه د قرنتوس ډېرو خلکو چې د پولوس پیغام یې اورېده، نو ایمان یې راوړ او د تعمید غسل ورته ورکړل شو."}, {"ref": "Acts 1:8", "text": "پولوس تر درې میاشتو پورې کنیسې ته تللو او په زړورتیا سره به یې د خلکو سره خبرې کولې او د خدای د پاچاهۍ په هکله به یې هغوی ته دلیل ویلو او بحث به یې کاوه چې هغوی قانع کړي."}, {"ref": "Acts 1:9", "text": "بله ورځ د غرمې په وخت کې چې هغه دوه نوکران او عسکر په لاره کې روان وو او یافا ته ورسېدل، نو په همدې وخت کې پطروس د دعا کولو دپاره پاس بام ته وخوت."}, {"ref": "Acts 1:9", "text": "د اسمان څخه یوځل بیا اواز راغی چې ویل یې: ‹کوم شیان چې خدای حلال ګرځولي دي، ته یې باید حرام ونه ګڼې.›"}, {"ref": "Acts 1:9", "text": "پطروس راووت او په هغې پسې روان شو. هغه نه پوهېده چې دا هرڅه رښتیا دي، ځکه هغه فکر کاوه چې رویا ویني."}, {"ref": "Acts 1:9", "text": "خو شاوول چې د پولوس په نوم هم مشهور ؤ، د روح القدس څخه ډک شو او جادوګر ته یې په ځیر سره وکتل"}, {"ref": "Acts 1:9", "text": "هغه هلته ناست ؤ او د پولوس خبرو ته یې غوږ نیولی ؤ. پولوس هغه ته په ځیر سره کتل او ویې لیدل چې هغه په دې ایمان لري چې روغ به شي،"}, {"ref": "Acts 1:9", "text": "خدای زمونږ او د غیریهودیانو ترمنځ هېڅ فرق ونه کړ او د ایمان د راوړلو په وسیله یې د هغوی زړونه پاک کړل."}, {"ref": "Acts 1:9", "text": "په هماغه شپه پولوس رویا ولیدله چې یو مقدونی سړی ولاړ دی او هغه ته زاري کوي او وایي: «مقدونیې ته راپورې وځه او زمونږ سره مرسته وکړه.»"}, {"ref": "Acts 1:9", "text": "نو هغوی د یاسون او نورو ایماندارانو څخه ضمانت واخیست او هغوی یې پرېښودل چې لاړ شي. پولوس او سیلاس په بیریه کې"}, {"ref": "Acts 1:9", "text": "یوه شپه څښتن په رویا کې د پولوس سره خبرې وکړې او ورته ویې ویل: «مه وېرېږه، بلکې خپل وعظ کوه او غلی مه پاتې کېږه،"}, {"ref": "Acts 1:9", "text": "خو د هغوی څخه ځینې سرزورو خلکو ایمان نه راوړلو او د کنیسې د خلکو په مخکې به یې د څښتن عیسی مسیح لارې ته بد ویل. نو پولوس له هغوی څخه لاړ او شاګردان یې له ځان سره بوتلل او هره ورځ به یې د تیرانوس د غونډو په تالار کې بحثونه کول."}, {"ref": "Acts 1:10", "text": "هغه وږی شو او غوښتل یې چې څه وخوري، کله چې ډوډۍ تیارېدله، نو هغه رویا ولیدله."}, {"ref": "Acts 1:10", "text": "درې ځلې داسې وشول او بیا هغه ټول شیان بېرته اسمان ته یووړل شول."}, {"ref": "Acts 1:10", "text": "هغوی د لومړۍ او دوهمې پوستې څخه تېر شول او د اوسپنې هغې دروازې ته ورسېدل چې د ښار خواته وتلې وه. دروازه په خپله خلاصه شوه او هغوی دباندې راووتل. هغوی په یوه کوڅه کې روان وو او ناڅاپه فرښته د پطروس له سترګو پناه شوه."}, {"ref": "Acts 1:10", "text": "او ویې ویل: «ای د شیطان زویه! ای د ټولو نېکیو دښمنه! ای ټګ انسانه او د هر ډول شرارت څخه ډکه! ایا ته به هېڅکله هم د څښتن د سمې لارې څخه د خلکو د بې‌لارې کولو څخه لاس وانه اخلې؟"}, {"ref": "Acts 1:10", "text": "نو په لوړ اواز یې هغه ته وویل: «په خپلو پښو باندې سم ودرېږه.» هغه سړی زر پاڅېده او په ګرځېدلو یې پیل وکړ."}, {"ref": "Acts 1:10", "text": "نو بیا ولې تاسو اوس خدای ازمایئ او د دې ایماندارانو په اوږو باندې داسې بار ږدئ چې نه یې مونږ او نه یې زمونږ نیکونه وړلی شي؟"}, {"ref": "Acts 1:10", "text": "څنګه چې پولوس دا رویا ولیدله، نو مونږ سمدلاسه تیار شولو چې مقدونیې ته لاړ شو. ځکه مونږ دې نتیجې ته ورسېدلو چې خدای مونږ رابللي یو چې د هغه ځای خلکو ته زېری ورسوو. په فیلیپي کې د لیدیه ایمان راوړل"}, {"ref": "Acts 1:10", "text": "څنګه چې شپه شوه، نو ایماندارانو پولوس او سیلاس بیریې ته ولېږل. کله چې هلته ورسېدل، نو د یهودیانو کنیسې ته لاړل."}, {"ref": "Acts 1:10", "text": "ځکه چې زه درسره مل یم او هېڅوک به ونه شي کولای چې په تا باندې حمله وکړي او زیان درته ورسوي، ځکه چې په دې ښار کې ډېر داسې خلک شته چې زما دي.»"}, {"ref": "Acts 1:10", "text": "دا کار تر دوو کالو پورې روان ؤ، ترڅو د اسیا د ولایت ټولو اوسېدونکو یعنې یهودیانو او یونانیانو دواړو د څښتن عیسی پیغام واورېد. د اسکیوا زامن"}, {"ref": "Acts 1:11", "text": "هغه ولیدل چې د اسمان دروازې خلاصې شوې او د یو لوی دسترخوان په شان یو شی چې د څلورو څنډو څخه راځوړند ؤ او ښکته د ځمکې خواته راروان ؤ."}, {"ref": "Acts 1:11", "text": "په هماغه شېبه کې درې تنه چې د قیصریې څخه رالېږل شوي وو، هغه کور ته راورسېدل چې مونږ په کې اوسېدلو."}, {"ref": "Acts 1:11", "text": "بیا پطروس په هوش راغی او ویې ویل: «اوس پوره باور لرم چې څښتن خپله فرښته راولېږله او زه یې د هیرودیس او له هغه څه نه چې یهودیانو یې تمه درلودله، خلاص کړم.»"}, {"ref": "Acts 1:11", "text": "اوس ګوره، څښتن به تاته سزا درکړي او ته به ړوند شې او تر یو وخته پورې به د لمر رڼا نه وینې.» نو سمدلاسه د هغه په سترګو باندې خړه او تیاره راغله او لاس او پښې یې تپولې چې څوک راشي او له لاسه یې ونیسي او هغه بوځي."}, {"ref": "Acts 1:11", "text": "کله چې خلکو د پولوس دا کار ولیده، نو په خپله لیکاونیایي ژبه یې چیغې ووهلې: «خدایان د انسانانو په څېره کې مونږ ته راښکته شوي دي.»"}, {"ref": "Acts 1:11", "text": "خو مونږ په دې عقیده یو چې مونږ یهودیانو د څښتن عیسی په فضل خلاصون موندلی دی، همدا ډول غیریهودیانو هم خلاصون موندلی دی.»"}, {"ref": "Acts 1:11", "text": "په ترواس کې په کشتۍ کې سپاره شو او سیده د ساموتراکې جزیرې ته لاړو او په بله ورځ د نیاپولیس ښار ته لاړو."}, {"ref": "Acts 1:11", "text": "د بیریې یهودیان د تسالونیکیې د یهودیانو څخه د روښانه فکر خاوندان وو. ځکه چې هغوی په ډېر شوق سره پیغام ومنلو او هره ورځ به یې په غور سره د خدای کلام لوسته، ترڅو په دې پوه شي چې کوم څه چې پولوس وایي هغه رښتیا دي که نه."}, {"ref": "Acts 1:11", "text": "نو پولوس د یو کال او شپږو میاشتو دپاره هلته پاتې شو او خلکو ته یې د خدای د کلام تعلیم ورکاوه."}, {"ref": "Acts 1:11", "text": "خدای به د پولوس په وسیله لویې لویې معجزې ښودلې."}, {"ref": "Acts 1:12", "text": "په هغه کې هر ډول حیوانات، خزندې او مرغان وو."}, {"ref": "Acts 1:12", "text": "روح القدس راته وویل چې په دې هکله اندېښنه مه کوه چې هغوی غیریهودیان دي. بیا دا شپږ ایمانداران هم زما سره لاړل او مونږ ټول د کورنیلیوس کور ته ورننوتلو."}, {"ref": "Acts 1:12", "text": "کله چې هغه پوه شو، نو هغه د مریم کور ته لاړ چې د یوحنا مرقوس مور وه. هلته زیات شمېر خلک د دعا دپاره راټول شوي وو."}, {"ref": "Acts 1:12", "text": "کله چې والي دا هرڅه ولیدل نو ایمان یې راوړ، ځکه چې هغه د څښتن په هکله په دې تعلیم ډېر حیران شو. پولوس او برناباس د پیسیدیه په انطاکیه کې"}, {"ref": "Acts 1:12", "text": "هغوی برناباس د مشتري او پولوس یې د عطارد په نوم یاد کړ، ځکه چې پولوس د هغوی مشر ویاند ؤ."}, {"ref": "Acts 1:12", "text": "د غونډې ټول خلک غلي پاتې شول او د برناباس او پولوس خبرو ته یې غوږ ونیوه چې د هغو ټولو معجزو او حیرانوونکي کارونو په هکله یې کولې چې خدای د هغوی په وسیله په غیریهودیانو کې ښودلي وو."}, {"ref": "Acts 1:12", "text": "له هغه ځای څخه فیلیپي ته چې د مقدونیې د لومړۍ ناحیې یو ښار ؤ او د رومیانو مستعمره وه، لاړو او د یو څو ورځو دپاره په هغه ښار کې پاتې شو."}, {"ref": "Acts 1:12", "text": "نو له همدې امله په هغوی کې ډېرو خلکو ایمان راوړ او همدارنګه ډېرو نامتو یوناني ښځو او سړیو هم ایمان راوړ."}, {"ref": "Acts 1:12", "text": "خو کله چې ګالیون د جنوبي یونان د اخیې د ولایت والي وټاکل شو، نو یهودیان سره راټول شول او پولوس یې ونیوه او محکمې ته یې راوست"}, {"ref": "Acts 1:12", "text": "خلکو به هغه دستمالونه او پېشبندونه چې د پولوس په بدن باندې وهل شوي وو، وړل او هغه به یې د ناروغانو په بدن باندې وهل او هغوی به روغېدل او پېریان به ورڅخه وتل."}, {"ref": "Acts 1:13", "text": "بیا یو اواز راغی او هغه ته یې وویل: «ای پطروسه، پاڅېږه! هغه حلال کړه او ویې خوره.»"}, {"ref": "Acts 1:13", "text": "هغه مونږ ته وویل چې څنګه یې په خپل کور کې یوه فرښته ولیدله چې ولاړه وه او هغه ته یې وویل: ‹یو څوک یافا ته ولېږه او شمعون چې پطروس ورته ویل کیږي، راوله."}, {"ref": "Acts 1:13", "text": "کله چې پطروس د کور دروازه وټکوله، نو د رودا په نوم یوه وینځه راغله چې دروازه خلاصه کړي."}, {"ref": "Acts 1:13", "text": "پولوس او د هغه ملګري د پافوس څخه روان شول او په کشتۍ کې پرجې ته چې په پمفیلیه کې ده، لاړل. خو یوحنا د هغوی څخه بېل شو او بېرته اورشلیم ته ستون شو."}, {"ref": "Acts 1:13", "text": "د مشتري کاهن چې د عبادت ځای یې ښار ته مخامخ ؤ، د ښار دروازې ته غویان راوستل او د ګلانو امېلونه یې راوړل، ځکه چې هغه او د ښار خلکو غوښتل چې برناباس او پولوس ته قربانۍ وړاندې کړي."}, {"ref": "Acts 1:13", "text": "کله چې د برناباس او پولوس خبرې پای ته ورسېدلې، یعقوب وویل: «ای ورونو، زما خبرو ته غوږ ونیسئ."}, {"ref": "Acts 1:13", "text": "د سبت په ورځ مونږ د ښار له دروازې نه ووتلو او د سیند غاړې ته چې مونږ فکر کاوه د یهودیانو د دعا کولو ځای به وي، لاړو. هلته کښېناستلو او په هغه ځای کې مو د راټولو شویو ښځو سره خبرې وکړې."}, {"ref": "Acts 1:13", "text": "خو کله چې د تسالونیکیې یهودیان خبر شول چې پولوس په بیریه کې هم د خدای کلام بیانوي، نو هلته راغلل چې خلک ولمسوي او د پولوس په خلاف یې راپورته کړي."}, {"ref": "Acts 1:13", "text": "او ویې ویل: «دا سړی خلک په داسې ډول د خدای عبادت ته هڅوي چې د قانون خلاف دی.»"}, {"ref": "Acts 1:13", "text": "ځینو یهودیانو چې یوځای او بل ځای به ګرځېدل، کوښښ کاوه چې د څښتن عیسی په نوم پېریان وباسي. هغوی به پېریانو ته ویل: «زه د هغه عیسی په نوم چې پولوس یې وعظ کوي، امر کوم چې راووځه.»"}, {"ref": "Acts 1:14", "text": "خو پطروس وویل: «څښتنه! هېڅکله نه، ما هېڅکله هم حرام او ناپاکه شی نه دی خوړلی.»"}, {"ref": "Acts 1:14", "text": "هغه به تاته یو پیغام واوروي چې د هغه په وسیله به ته او ستا ټوله کورنۍ خلاصون ومومئ.›"}, {"ref": "Acts 1:14", "text": "هغې د پطروس اواز واورېد او دومره خوشحاله شوه چې د دې په ځای چې دروازه ورته خلاصه کړي، هغې بېرته دننه منډه کړه او هغوی یې خبر کړل چې پطروس دباندې په دروازه کې ولاړ دی."}, {"ref": "Acts 1:14", "text": "پولوس او برناباس د پرجې څخه روان شول او انطاکیې ته چې په پیسیدیه کې ده، ورسېدل. د سبت په ورځ هغوی کنیسې ته لاړل او هلته کښېناستل."}, {"ref": "Acts 1:14", "text": "کله چې رسولان یعنې برناباس او پولوس له دې نه خبر شول، نو خپل کالي یې وشکول او د خلکو منځ ته یې منډې کړې او چیغې یې ووهلې:"}, {"ref": "Acts 1:14", "text": "شمعون مونږ ته ویلي وو چې خدای څنګه د لومړي ځل دپاره د غیریهودیانو سره علاقه وښودله او د هغوی له منځ نه یې د خپل ځان دپاره یو قوم غوره کړ."}, {"ref": "Acts 1:14", "text": "په هغو ښځو کې چې زمونږ خبرو ته یې غوږ ایښی ؤ د یوې نوم لیدیه وه چې د بانجاني قیمتي ټوټو سوداګره او د تیاتیرا د ښار اوسېدونکې وه. هغه داسې ښځه وه چې د خدای عبادت یې کاوه او څښتن د هغې ذهن جوړ کړ څه چې پولوس وایي هغه ومني."}, {"ref": "Acts 1:14", "text": "نو ایماندارانو سمدلاسه پولوس د بحیرې غاړې ته ولېږه، خو سیلاس او تیموتاوس په بیریه کې پاتې شول."}, {"ref": "Acts 1:14", "text": "څنګه چې پولوس خبرې پیل کړلې، نو ګالیون یهودیانو ته وویل: «ای یهودیانو، که چېرې په دې خبره کې کومه غلطي او یا کوم سخت جرم وای چې هغه کړی وي، نو ما به ستاسو دعوه اورېدلې وای."}, {"ref": "Acts 1:14", "text": "د یهودي لوی کاهن اسکیوا اووه زامنو به دا کار کاوه."}, {"ref": "Acts 1:15", "text": "په دوهم ځل بیا اواز راغی: «کوم شیان چې خدای حلال ګرځولي دي، هغه حرام مه ګڼه.»"}, {"ref": "Acts 1:15", "text": "کله چې ما خبرې پیل کړې، نو په هغوی باندې روح القدس نازل شو لکه څنګه چې لومړی ځل په مونږ باندې نازل شوی ؤ."}, {"ref": "Acts 1:15", "text": "هغوی ورته وویل: «ته لېونۍ شوې یې.» خو هغه په خپله خبره باندې ټینګه ولاړه وه چې همداسې ده. بیا هغوی وویل: «دا به د هغه فرښته وي!»"}, {"ref": "Acts 1:15", "text": "د تورات او پیغمبرانو د لیکنو د لوستلو څخه وروسته د کنیسې مشرانو هغوی ته دا پیغام ورولېږه: «ای ورونو، که چېرې تاسو د خلکو د هڅولو دپاره کوم پیغام لرئ، نو هغه ووایئ.»"}, {"ref": "Acts 1:15", "text": "«ای خلکو! تاسو ولې داسې کار کوئ؟ مونږ هم ستاسو په شان انسانان یو. مونږ ستاسو دپاره یو زېری لرو، ترڅو د دې بې‌ګټې شیانو څخه لاس واخلئ او ژوندي خدای ته راوګرځئ چې اسمان، ځمکه، بحیرې او هرڅه چې په هغو کې دي پیدا کړي دي."}, {"ref": "Acts 1:15", "text": "دا د پیغمبرانو د خبرو سره سمون خوري، لکه څنګه چې د خدای په کلام کې لیکل شوي دي:"}, {"ref": "Acts 1:15", "text": "بیا هغې او د هغې کورنۍ ته د تعمید غسل ورکړل شو او هغې مونږ خپل کور ته راوبللو او ویې ویل: «که چېرې تاسو ما د څښتن عیسی رښتینې ایمانداره ګڼئ، نو راشئ او زمونږ په کور کې پاتې شئ.» هغې ټینګار وکړ چې ورسره لاړ شو. پولوس او سیلاس د فیلیپيې په زندان کې"}, {"ref": "Acts 1:15", "text": "کومو خلکو چې پولوس یې بدرګه کاوه، د هغه سره د آتن تر ښاره پورې لاړل. بیا پولوس هغوی ته لارښوونه وکړه چې کله بېرته خپل کور ته ورسېدلئ، نو سیلاس او تیموتاوس ته ووایئ چې زر تر ژره آتن ته راشي. پولوس په آتن کې"}, {"ref": "Acts 1:15", "text": "خو څرنګه چې دا ستاسو د بحثونو موضوع، اصطلاحګانو او ستاسو د خپل شریعت خبره ده، نو تاسو خپله یې باید حل کړئ. زه نه غواړم چې د دې شیانو په هکله قضاوت وکړم.»"}, {"ref": "Acts 1:15", "text": "خو یوه ورځ پېري هغوی ته ځواب ورکړ: «زه عیسی پېژنم او د پولوس په هکله مې هم اورېدلي دي، خو تاسو څوک یئ؟»"}, {"ref": "Acts 1:16", "text": "درې ځلې همداسې وشول او بیا هغه دسترخوان بېرته پورته اسمان ته یووړل شو."}, {"ref": "Acts 1:16", "text": "بیا ماته را په یاد شول څه چې څښتن عیسی ویلي وو: ‹یحیی به په اوبو باندې د تعمید غسل ورکاوه، خو تاسو ته به په روح القدس د تعمید غسل درکول کیږي.›"}, {"ref": "Acts 1:16", "text": "خو پطروس په پرله پسې توګه دروازه ټکوله او کله چې هغوی دروازه خلاصه کړه او هغه یې ولیده، نو حیران پاتې شول."}, {"ref": "Acts 1:16", "text": "پولوس پاڅېده، په لاس یې اشاره وکړه او ویې ویل: «ای د اسراییلو خلکو او ای غیریهودیانو چې له خدایه وېرېږئ، زما خبرو ته غوږ ونیسئ."}, {"ref": "Acts 1:16", "text": "په تېرو زمانو کې خدای ټول قومونه پرېښودل چې څه ورته ښه ښکاري هماغه کار وکړي."}, {"ref": "Acts 1:16", "text": "له هغې وروسته به زه بېرته راستون شم. بېرته به د داود وران شوی کور اباد او قوي کړم،"}, {"ref": "Acts 1:16", "text": "یوه ورځ مونږ د دعا کولو ځای ته تللو چې د یوې وینځې سره مخامخ شولو چې داسې پېریان یې لرل چې د هغو په مرسته به یې فال کتلو. هغې به له دې لارې خپلو بادارانو ته ډېرې پیسې ګټلې."}, {"ref": "Acts 1:16", "text": "په هغه وخت کې چې پولوس په آتن کې د سیلاس او تیموتاوس دپاره انتظار کاوه، نو کله چې هغه ولیدل چې هغه ښار د بتانو څخه ډک دی، ډېر خفه شو."}, {"ref": "Acts 1:16", "text": "نو هغوی یې له محکمې څخه وویستل."}, {"ref": "Acts 1:16", "text": "نو بیا هغه پېریانو نیولي سړي په هغوی ورټوپ کړ او هغوی ټول یې تر‌پښو لاندې کړل او دومره یې ووهل چې د هغه کور څخه لوڅ او ژوبل شوي وتښتېدل."}, {"ref": "Acts 1:17", "text": "پطروس حیران پاتې ؤ چې د دې رویا معنی څه ده، چې په دې وخت کې هغو کسانو چې کورنیلیوس لېږلي وو، د شمعون کور پیدا کړ او هغوی د دروازې په مخکې ودرېدل."}, {"ref": "Acts 1:17", "text": "که خدای هغوی ته هماغه نعمت ورکړی دی چې مونږ ته یې په هغه وخت کې راکړ چې په څښتن عیسی مسیح باندې مو ایمان راوړ، نو بیا زه څوک وم چې خدای مې د دې کار نه منع کړی وای؟»"}, {"ref": "Acts 1:17", "text": "خو پطروس د لاس په اشاره هغوی ته وویل چې غلي شئ او هغوی ته یې دا کیسه وکړه چې څښتن څنګه هغه د زندان څخه راوویست. هغه وویل چې یعقوب او نور ایمانداران له دې څخه خبر کړئ. بیا هغه روان شو او بل ځای ته لاړ."}, {"ref": "Acts 1:17", "text": "د اسراییلو د خلکو خدای زمونږ نیکونه غوره کړل او کوم وخت چې هغوی په مصر کې د پردیو په شان اوسېدل، نو د هغوی څخه یې یو لوی قوم جوړ کړ. بیا یې په خپل لوی قدرت سره هغوی د مصر څخه راوویستل"}, {"ref": "Acts 1:17", "text": "خو بیاهم هغه تل په خپلو نېکو کارونو سره خپل شتون ثابت کړی دی، یعنې هغه په تاسو باندې د اسمان څخه باران وروي او په خپل موسم کې فصلونه درکوي. هغه تاسو ته پرېمانه خواړه هم درکوي او ستاسو زړونه د خوشحالۍ څخه ډکوي.»"}, {"ref": "Acts 1:17", "text": "ترڅو نور انسانان څښتن ته رجوع وکړي یعنې ټول غیریهودیان چې ما خپل کړي دي. دا هغه څه دي چې څښتن یې وایي"}, {"ref": "Acts 1:17", "text": "هغه پولوس او مونږ پسې راروانه وه او چیغې به یې وهلې: «دا د خدای تعالی خدمتګاران دي. هغوی تاسو ته د خلاصون لاره ښایي.»"}, {"ref": "Acts 1:17", "text": "هغه به په کنیسه کې د یهودیانو او دینداره غیریهودیانو سره بحثونه کول او هره ورځ به یې د ښار په بازارونو کې د هغو خلکو سره چې هلته ورسره مخامخ کېدل، هم بحثونه کول."}, {"ref": "Acts 1:17", "text": "خلکو سوستینیس چې د کنیسې مشر ؤ، راونیوه او د محکمې په مخکې یې وواهه. خو ګالیون یې کومه پروا ونه کړه. پولوس د قرنتوس څخه د سوریې انطاکیې ته سفر کوي"}, {"ref": "Acts 1:17", "text": "کله چې د افسیس ټول اوسېدونکي یهودیان او یونانیان د دې پېښې څخه خبر شول، نو په هغوی ټولو باندې وېره راغله او د څښتن عیسی نوم نور هم سرلوړی شو."}, {"ref": "Acts 1:18", "text": "هغوی نارې کړې او پوښتنه یې وکړه: «ایا شمعون چې پطروس ورته هم وایي، دلته مېلمه دی؟»"}, {"ref": "Acts 1:18", "text": "کله چې هغوی دا خبرې واورېدلې، نو غلي پاتې شول. هغوی د خدای په ثنا او صفت کولو پیل وکړ او ویل یې: «نو بیا خدای حتی غیریهودیانو ته هم دا موقعه ورکړې ده چې توبه وباسي او تلپاتې ژوندون ولري.» د سوریې په انطاکیه کې کلیسا"}, {"ref": "Acts 1:18", "text": "کله چې سهار شو، نو هغه ساتونکي عسکر ډېر وارخطا شول چې په پطروس باندې څه وشول."}, {"ref": "Acts 1:18", "text": "او نژدې څلوېښت کاله یې په دښته کې د هغوی چلند وزغملو."}, {"ref": "Acts 1:18", "text": "په دې خبرو رسولانو په سختۍ سره وکولای شول چې خلک د قربانۍ کولو څخه منع کړي."}, {"ref": "Acts 1:18", "text": "چې دا شیان یې له پخوا نه ښکاره کړي دي.»"}, {"ref": "Acts 1:18", "text": "هغې هره ورځ دا کار کاوه، تر هغې چې پولوس دومره تنګ شو چې مخ یې راواړاوه او هغو پېریانو ته یې وویل: «زه درته د عیسی مسیح په نوم امر کوم چې د هغې نه راووځئ.» نو په هماغه ساعت پېریان د هغې څخه راووتل."}, {"ref": "Acts 1:18", "text": "ځینو اپیکوري او رواقي فیلسوفانو هم د هغه سره بحث کاوه. ځینو خلکو به پوښتنه کوله: «دا جاهل غواړي څه ووایي؟» نورو به ویل: «داسې ښکاري چې هغه د نورو خدایانو په هکله خبرې کوي.» دا یې ځکه وویل چې پولوس د عیسی او د قیامت په هکله زېری ورکاوه."}, {"ref": "Acts 1:18", "text": "پولوس د څه وخت دپاره د ایماندارانو سره په قرنتوس کې پاتې شو او بیا یې د هغوی سره خدای پاماني وکړه او په کشتۍ کې د پریسکیلا او اکیلا سره سوریې ته لاړ. د کينخریې په ښار کې هغه خپل سر وخرایه، ځکه چې نذر یې ایښی ؤ."}, {"ref": "Acts 1:18", "text": "ډېرو خلکو چې ایمان یې راوړی ؤ، راغلل او دا اقرار یې وکړ چې هغوی جادوګري کوله."}, {"ref": "Acts 1:19", "text": "پطروس لا د دې رویا په هکله فکر کاوه چې روح القدس ورته وویل: «ګوره، درې سړي تا لټوي."}, {"ref": "Acts 1:19", "text": "د هغې ځورونې له امله چې د استیفان د مړینې نه وروسته پیل شوه، ځینې ایمانداران خواره واره شول او د فنیقیې، قبرس او انطاکیې پورې لاړل. هغوی خپل پیغام یوازې یهودیانو ته ورساوه."}, {"ref": "Acts 1:19", "text": "هیرودیس امر وکړ چې پطروس ولټوي، خو هغه یې پیدا نه کړ. هغه د ساتونکو څخه پوښتنې وکړې او د هغوی د اعدام حکم یې ورکړ. له هغې وروسته هیرودیس د یهودیې څخه لاړ او د څه مودې دپاره په قیصریه کې پاتې شو. د هیرودیس مړینه"}, {"ref": "Acts 1:19", "text": "هغه په کنعان کې اووه قومونه له منځه یووړل او د هغوی خاوره یې د میراث په توګه خپل قوم ته ورکړه."}, {"ref": "Acts 1:19", "text": "بیا له انطاکیې او قونیې څخه ځینې یهودیان راغلل او خلک یې خپل طرفداران کړل او پولوس یې سنګسار کړ. هغوی فکر کاوه چې مړ دی، نو په راښکلو یې د ښار څخه دباندې وویست."}, {"ref": "Acts 1:19", "text": "یعقوب زیاته کړه: «دا زما پرېکړه ده چې مونږ باید هغه غیریهودیان په تکلیف نه کړو چې د خدای خواته راګرځي،"}, {"ref": "Acts 1:19", "text": "کله چې د هغې وینځې باداران پوه شول چې د هغوی د پیسو ګټلو هیله له منځه لاړه، نو هغوی پولوس او سیلاس ونیول او په راښکلو یې حاکمانو ته د محاکمې دپاره د بازار چوک ته راوستل."}, {"ref": "Acts 1:19", "text": "نو هغوی پولوس شورا ته چې د مریخ په غونډۍ کې وه، راوست او ویې ویل: «مونږ غواړو پوه شو چې دا نوی تعلیم چې ته یې ورکوې هغه د څه شي په هکله دی؟"}, {"ref": "Acts 1:19", "text": "کله چې هغوی افسیس ته ورسېدل، نو پولوس پرسکیلا او اکیلا هلته پرېښودل. بیا یوازې کنیسې ته لاړ او هلته یې د یهودیانو سره بحث وکړ."}, {"ref": "Acts 1:19", "text": "ډېرو جادوګرانو خپل د جادوګرۍ کتابونه راټول کړل او د خلکو په مخکې یې وسوځول. کله چې هغوی د کتابونو قیمتونه حساب کړل، نو د هغو بیه پنځوس زره د سپینو زرو سکې شوې."}, {"ref": "Acts 1:20", "text": "پاڅېږه او لاندې راښکته شه او د هغوی سره په تللو کې زړه نازړه کېږه مه، ځکه چې هغوی ما درلېږلي دي.»"}, {"ref": "Acts 1:20", "text": "خو د قبرس او قیروان ځینې ایمانداران چې انطاکیې ته لاړل، د یونانیانو سره یې هم خبرې وکړې او هغوی ته یې د څښتن عیسی په هکله زېری ورساوه."}, {"ref": "Acts 1:20", "text": "هیرودیس د صور او صیدون په خلکو ډېر په قهر ؤ. هغوی سره راټول شول او هغه ته ورغلل. لومړی هغوی بلاستوس چې د پاچا د ماڼۍ ناظر ؤ، په دې راضي کړ چې د هغوی سره به مرسته وکړي. بیا هغوی د هیرودیس څخه وغوښتل چې روغه جوړه ورسره وکړي، ځکه چې د دوی وطن ته خوراکي شیان د هیرودیس پاچا د وطن څخه راتلل."}, {"ref": "Acts 1:20", "text": "دا هرڅه نژدې څلور سوه او پنځوس کالو کې وشول. له هغې وروسته یې د سموییل پیغمبر تر زمانې پورې د هغوی دپاره قاضیان وټاکل."}, {"ref": "Acts 1:20", "text": "خو کله چې ایمانداران د پولوس په شاوخوا راټول شول، نو هغه راپاڅېده او بېرته ښار ته لاړ او بله ورځ هغه د برناباس سره دربې ته لاړ. د پیسیدیه انطاکیې ته د پولوس او برناباس بېرته راستنېدل"}, {"ref": "Acts 1:20", "text": "بلکې د دې په ځای هغوی ته لیک ولیکو او ورته ووایو چې داسې خواړه ونه خوري چې په مذهبي توګه ناپاک وي، ځکه چې هغه بتانو ته وړاندې شوي دي او خپل ځانونه د جنسي بدو اړیکو څخه وساتي او د داسې حیواناتو غوښه ونه خوري چې زندۍ شوي وي او همدارنګه وینه ونه خوري."}, {"ref": "Acts 1:20", "text": "هغوی یې رومي لوړ‌رتبه مامورینو ته راوستل او ویې ویل: «دا خلک یهودیان دي او دوی زمونږ په ښار کې ګډوډي جوړوي."}, {"ref": "Acts 1:20", "text": "ځینې خبرې چې ته یې کوې هغه مونږ ته حیرانوونکې ښکاري. مونږ غواړو چې د هغو په معنی پوه شو.»"}, {"ref": "Acts 1:20", "text": "هغوی ورڅخه وغوښتل چې د ډېر وخت دپاره پاتې شي، خو هغه ونه منله."}, {"ref": "Acts 1:20", "text": "په دې ډول د څښتن عیسی پیغام خپرېده او په خلکو یې ډېره اغېزه کوله. په افسیس کې شور او غوغا"}, {"ref": "Acts 1:21", "text": "نو پطروس لاندې ښکته شو او هغوی ته یې وویل: «زه هماغه سړی یم چې تاسو یې لټوئ. تاسو د څه دپاره راغلي یئ؟»"}, {"ref": "Acts 1:21", "text": "د څښتن قدرت د هغوی سره ؤ او زیات شمېر خلکو ایمان راوړ او د څښتن عیسی پیروان شول."}, {"ref": "Acts 1:21", "text": "نو په یوې ټاکلې ورځ هیرودیس خپل د پاچاهۍ کالي واغوستل، په تخت باندې کښېناست او هغوی ته یې وینا پیل کړه."}, {"ref": "Acts 1:21", "text": "او کله چې هغوی د خپل ځان دپاره پاچا وغوښت، نو خدای ورته د قیس زوی شاوول چې د بنیامین د قبیلې څخه ؤ، ورکړ او هغه څلوېښت کاله پاچاهي وکړه."}, {"ref": "Acts 1:21", "text": "کله چې پولوس او برناباس په دربه کې زېری ووراوه، نو ډېر خلک یې د عیسی پیروان کړل. بیا هغوی بېرته لسترې، قونیې او انطاکیې ته لاړل."}, {"ref": "Acts 1:21", "text": "ځکه چې د پخوا زمانې راهیسې په هر ښار کې د موسی د قانون په هکله وعظ کیږي او هغه په کنیسو کې د هر سبت په ورځ لوستل کیږي.» غیریهودي ایماندارانو ته لیک لېږل"}, {"ref": "Acts 1:21", "text": "دوی د هغو دودونو او دستورونو په هکله تعلیم ورکوي چې منل او په هغو باندې عمل کول یې مونږ رومیانو دپاره روا نه دي.»"}, {"ref": "Acts 1:21", "text": "(ځکه چې د آتن خلکو او هغو پردیو خلکو چې هلته اوسېدل، دا خوښول چې خپل ټول وخت د نویو نظرونو په هکله په خبرو کولو او اورېدلو تېر کړي.)"}, {"ref": "Acts 1:21", "text": "نو د هغوی سره یې خدای پاماني وکړه او ویې ویل: «که د خدای رضا وي، نو بېرته به راشم.» نو هغه د افسیس څخه په کشتۍ کې روان شو."}, {"ref": "Acts 1:21", "text": "د دې ټولو پېښو نه وروسته پولوس د روح القدس په لارښوونه پرېکړه وکړه چې مقدونیې او جنوبي یونان ته سفر وکړي او وروسته بیا اورشلیم ته لاړ شي. هغه وویل: «هغه ځای ته د تللو نه وروسته باید د روم ښار هم ووینم.»"}, {"ref": "Acts 1:22", "text": "هغوی ځواب ورکړ: «مونږ قوماندان کورنیلیوس رالېږلي یو. هغه یو نېک او داسې سړی دی چې له خدایه وېریږي او د ټولو یهودیانو په نظر کې ډېر عزتمن سړی دی. د خدای فرښتې هغه ته ویلي وو چې تا خپل کور ته راوغواړي او څه چې وایې هغه یې واوري.»"}, {"ref": "Acts 1:22", "text": "دا خبر د اورشلیم کلیسا ته ورسېد او هغوی برناباس انطاکیې ته ولېږه."}, {"ref": "Acts 1:22", "text": "خلکو چیغې وهلې: «دا د خدای اواز دی، نه د انسان.»"}, {"ref": "Acts 1:22", "text": "کله چې خدای شاوول لېرې کړ، نو داود یې د اسراییلو پاچا کړ. خدای د داود په هکله داسې وویل: ‹ما ولیدل چې د یسي زوی داود داسې سړی دی چې زما د زړه نه خبر دی او هرڅه چې زه وغواړم هغه به یې سرته رسوي.›"}, {"ref": "Acts 1:22", "text": "هغوی د ایماندارانو زړونه کلکول او هغوی یې هڅول چې په خپل ایمان کې ټینګ پاتې شي او هغوی ته به یې ویل چې د خدای پاچاهۍ ته د ورننوتلو دپاره باید ډېر تکلیفونه وزغمو."}, {"ref": "Acts 1:22", "text": "بیا رسولانو، مشرانو او د کلیسا ټولو غړو دا پرېکړه وکړه چې د خپل منځ نه یو څو کسان غوره کړي او هغوی د پولوس او برناباس سره انطاکیې ته ولېږي. نو هغوی دوه کسان یعنې یهودا چې د برسابا په نوم یادېده او سیلاس چې د ایماندارانو له خوا یې ډېر درناوی کېده، غوره کړل"}, {"ref": "Acts 1:22", "text": "خلک د هغې وینځې د بادارانو سره یوځای شول او په پولوس او سیلاس باندې یې حمله وکړه او مامورینو امر وکړ چې د دوی کالي وباسي او په کوتکونو یې ووهي."}, {"ref": "Acts 1:22", "text": "پولوس د مریخ د غونډۍ د شورا په مخکې ودرېده او ویې ویل: «ای د آتن خلکو! زه پوه شوم چې تاسو ډېر مذهبي خلک یئ."}, {"ref": "Acts 1:22", "text": "کله چې هغه په قیصریه کې د کشتۍ څخه راښکته شو، نو اورشلیم ته لاړ او د کلیسا د خلکو سره د سلام او احوال اخیستنې څخه وروسته انطاکیې ته لاړ."}, {"ref": "Acts 1:22", "text": "هغه خپل دوه ملګري یعنې تیموتاوس او اراستوس مقدونیې ته ولېږل او په خپله د یو څه وخت دپاره د اسیا په ولایت کې پاتې شو."}, {"ref": "Acts 1:23", "text": "نو پطروس هغوی کور ته راوستل او مېلمانه یې کړل. د کورنیلیوس او پطروس لیدنه بله ورځ پطروس پاڅېده او د هغوی سره روان شو او د یافا څو ایمانداران هم ورسره ملګري وو."}, {"ref": "Acts 1:23", "text": "کله چې هغه راورسېده او ویې لیدل چې خدای څنګه خلکو ته برکت ورکړ، نو ډېر خوشحاله شو او هغوی یې وهڅول چې ټول د زړه له کومي څښتن ته وفادار پاتې شي،"}, {"ref": "Acts 1:23", "text": "سمدلاسه د څښتن فرښتې هیرودیس وواهه، ځکه چې کوم جلال چې باید خدای ته ورکړل شوی وای، هغه خپل ځان ته ورکړ. هغه چینجیو وخوړ او مړ شو."}, {"ref": "Acts 1:23", "text": "نو د همدې داود د نسل څخه خدای د خپلې وعدې له مخې عیسی د اسراییلو د قوم د خلاصوونکي په توګه راولېږه."}, {"ref": "Acts 1:23", "text": "پولوس او برناباس په هره کلیسا کې مشران وټاکل او په دعا کولو او روژې نیولو یې هغوی هغه څښتن عیسی ته وسپارل چې ایمان یې ورباندې راوړی ؤ."}, {"ref": "Acts 1:23", "text": "او د هغوی په لاس یې دغه لیک ولېږه: «مونږ رسولان او مشران تاسو ټولو غیریهودي ایماندارانو ته چې په انطاکیه، سوریه او قیلیقیه کې اوسېږئ، خپل سلامونه وایو."}, {"ref": "Acts 1:23", "text": "د سختو وهلو او ټکولو څخه وروسته یې پولوس او سیلاس په زندان کې واچول او د زندان مشر ته یې وویل چې د هغوی کلکه څارنه وکړي."}, {"ref": "Acts 1:23", "text": "ځکه کله چې زه ستاسو په ښار کې ګرځېدم او ستاسو د عبادت شیانو ته مې کتل، نو د قربانۍ یو ځای مې ولیده چې پرې لیکل شوي وو: ‹د یو نامعلوم خدای دپاره.› تاسو چې د کوم شي عبادت کوئ او نه یې پېژنئ، د هغه په هکله تاسو ته خبرې کوم."}, {"ref": "Acts 1:23", "text": "په انطاکیه کې د څه مودې تېرولو څخه وروسته پولوس بیا په سفر روان شو او د غلاتیې او فریجیې په ټوله سیمه کې یې د یو ځای څخه بل ځای ته سفر کاوه او د ټولو ایماندارانو زړونه یې غښتلي کول. اپولوس په افسیس او قرنتوس کې"}, {"ref": "Acts 1:23", "text": "په دې وخت کې د څښتن عیسی د لارې له امله سخت شور او غوغا پیدا شوه."}, {"ref": "Acts 1:24", "text": "په بله ورځ هغوی قیصریې ته ورسېدل. کورنیلیوس هغوی ته په تمه ؤ او خپل خپلوان او خپل نژدې ملګري یې هم راغوښتي وو."}, {"ref": "Acts 1:24", "text": "ځکه چې برناباس یو مهربانه سړی او د روح القدس څخه ډک او د ټینګ ایمان خاوند ؤ. په دې ځای کې ډېرو خلکو په څښتن باندې ایمان راوړ."}, {"ref": "Acts 1:24", "text": "خو په همدې وخت کې د خدای کلام خپرېده او ډېر خلک ایمانداران شول."}, {"ref": "Acts 1:24", "text": "د عیسی د راتللو څخه مخکې یحیی د اسراییلو ټول قوم ته وعظ وکړ چې د خپلو ګناهونو څخه توبه وباسي او د تعمید غسل واخلي."}, {"ref": "Acts 1:24", "text": "بیا هغوی د پیسیدیې څخه تېر شول او پمفیلیې ته راغلل."}, {"ref": "Acts 1:24", "text": "مونږ اورېدلي چې ځینو خلکو چې زمونږ د ډلې څخه تللي دي، تاسو په خپلو خبرو پرېشانه کړي یئ او ستاسو فکرونه یې ګډوډ کړي دي، خو هغوی مونږ نه دي درلېږلي."}, {"ref": "Acts 1:24", "text": "د دې امر له مخې د زندان مشر هغوی په یوې ډېرې خوندي کوټه کې واچول او پښې یې ورته د لرګیو په کوندو پورې په زنځیرونو وتړلې."}, {"ref": "Acts 1:24", "text": "هغه خدای چې نړۍ او هرڅه چې په هغې کې دي، پیدا کړي دي، هغه د ځمکې او اسمان څښتن دی او د انسانانو په لاس جوړ شویو عبادتځایونو کې نه اوسیږي."}, {"ref": "Acts 1:24", "text": "په دې وخت کې یو یهودي چې اپولوس نومېده او په اصل کې د سکندریې څخه ؤ، افسیس ته راغی. هغه یو ښه ویاند ؤ او د خدای په کلام ډېر ښه پوهېده."}, {"ref": "Acts 1:24", "text": "هلته د دیمیتریوس په نوم یو زرګر ؤ چې د ارتیمیسې د بت د عبادت ځای د سپینو زرو نمونې به یې جوړولې او په دې ډول یې د کسبګرو دپاره یو ښه او ګټور کاروبار برابر کړی ؤ."}, {"ref": "Acts 1:25", "text": "څنګه چې پطروس کور ته ورننوت، کورنیلیوس د هغه مخې ته ورووت او د هغه په پښو کې پرېوت او سجده یې ورته وکړه."}, {"ref": "Acts 1:25", "text": "بیا برناباس د ترسوس ښار ته لاړ چې شاوول ولټوي."}, {"ref": "Acts 1:25", "text": "نو برناباس او شاوول خپله وظیفه سرته ورسوله او د اورشلیم څخه بېرته انطاکیې ته راستانه شول او د ځان سره یې یوحنا چې بل نوم یې مرقوس ؤ، بوتلو."}, {"ref": "Acts 1:25", "text": "کله چې یحیی خپله وظیفه سرته ورسوله، هغه وویل: ‹تاسو څه فکر کوئ چې زه څوک یم؟ زه هغه څوک نه یم چې تاسو یې انتظار کوئ. خو زما څخه وروسته هغه څوک راروان دی چې زه د هغه د څپلیو د تسمو د خلاصولو لیاقت هم نه لرم.›"}, {"ref": "Acts 1:25", "text": "کله چې هغوی په پرجه کې د خدای کلام ووراوه، نو بیا اتالیې ته لاړل."}, {"ref": "Acts 1:25", "text": "نو مونږ ټولو په ګډه پرېکړه وکړه چې یو څو کسان غوره کړو او د خپلو ګرانو دوستانو برناباس او پولوس سره یې تاسو ته درولېږو،"}, {"ref": "Acts 1:25", "text": "نژدې نیمه شپه وه چې پولوس او سیلاس دعا کوله او خدای ته یې روحاني سندرې ویلې او نورو بندیانو ورته غوږ نیولی ؤ"}, {"ref": "Acts 1:25", "text": "همدارنګه نه هغو شیانو ته کومه اړتیا لري چې انسانان یې په خپلو لاسونو هغه ته تیاروي، ځکه چې خدای په خپله انسانانو ته ژوند، ساه او هرڅه ورکوي."}, {"ref": "Acts 1:25", "text": "هغه ته د څښتن د لارې تعلیم ورکړل شوی ؤ او په زیات شور او شوق سره یې خبرې کولې او په سمه توګه یې د عیسی په هکله تعلیم ورکاوه، که څه هم هغه یوازې د یحیی د تعمید د غسل څخه خبر ؤ."}, {"ref": "Acts 1:25", "text": "نو دیمیتریوس هغوی او د هغوی په شان نور کسبګر سره راټول کړل او ورته یې وویل: «ای ملګرو، تاسو پوهېږئ چې مونږ له همدې کاروبار څخه ښه ګټه تر‌لاسه کوو."}, {"ref": "Acts 1:26", "text": "خو پطروس هغه د ځمکې څخه راپورته کړ او ورته ویې ویل: «راپاڅېږه، زه هم ستا په شان یو انسان یم.»"}, {"ref": "Acts 1:26", "text": "چې کله یې شاوول پیدا کړ، نو هغه یې انطاکیې ته راوست او برناباس او شاوول پوره یو کال هلته د ایماندارانو سره یوځای کېدل او ډېرو خلکو ته یې تعلیم ورکاوه. او همدلته په انطاکیه کې ؤ چې د لومړي ځل دپاره ایمانداران د مسیحیانو په نوم یاد شول."}, {"ref": "Acts 1:26", "text": "ای ورونو! ای د ابراهیم اولادې، او ای غیریهودیانو چې له خدایه وېرېږئ! مونږ هغه خلک یو چې د خلاصون دا پیغام راته رالېږل شوی دی."}, {"ref": "Acts 1:26", "text": "له هغه ځای څخه په کشتۍ کې بېرته انطاکیې ته لاړل، یعنې هماغه ځای ته چې هغوی په کې د هغې وظیفې دپاره د خدای فضل ته سپارل شوي وو چې اوس یې سرته ورسوله."}, {"ref": "Acts 1:26", "text": "یعنې هغه خلک چې خپل ځانونه یې زمونږ د څښتن عیسی مسیح ته د خدمت دپاره په خطر کې اچولي دي."}, {"ref": "Acts 1:26", "text": "چې ناڅاپه یوه سخته زلزله وشوه چې د زندان بنیادونه یې ولړزول. سمدلاسه د زندان ټولې دروازې خلاصې شوې او د ټولو بندیانو زنځیرونه مات شول."}, {"ref": "Acts 1:26", "text": "هغه ټول قومونه د یو انسان د نسل څخه پیدا کړل چې په ټولې نړۍ کې واوسیږي. د هغوی دپاره یې وختونه او د ځایونو حدونه وټاکل چې چېرته به اوسیږي."}, {"ref": "Acts 1:26", "text": "هغه په کنیسه کې په زړورتیا سره خبرې پیل کړې. کله چې پریسکیلا او اکیلا د هغه خبرې واورېدلې، نو هغه یې ګوښه کړ او په سمه توګه یې ورته د خدای لاره بیان کړه."}, {"ref": "Acts 1:26", "text": "لکه څنګه چې تاسو وینئ او اورئ چې دې پولوس یوازې په افسیس کې نه، بلکې د اسیا په ټول ولایت کې ګڼ شمېر خلک په خپلو خبرو ځان ته را‌اړولي او بې‌لارې کړي دي. هغه وایي چې د انسان په لاس جوړ شوي خدایان بالکل خدایان نه دي."}, {"ref": "Acts 1:27", "text": "په داسې حال کې چې پطروس د هغه سره خبرې کولې، کور ته ننوت او ویې لیدل چې هلته ډېر خلک راټول شوي وو."}, {"ref": "Acts 1:27", "text": "په همدې وخت کې ځینې پیغمبران د اورشلیم څخه انطاکیې ته راغلل."}, {"ref": "Acts 1:27", "text": "د اورشلیم خلکو او د هغوی مشرانو نه عیسی وپېژانده او نه هغوی د پیغمبرانو په پیغام باندې پوه شول چې د هر سبت په ورځ لوستل کیږي. خو هغوی د عیسی په محکومولو سره د پیغمبرانو پېشګویانې پوره کړلې."}, {"ref": "Acts 1:27", "text": "کله چې هغوی انطاکیې ته ورسېدل، نو د کلیسا خلک یې راټول کړل او هغوی یې د هغو کارونو څخه خبر کړل چې خدای د هغوی په وسیله سرته رسولي وو او دا چې خدای څنګه غیریهودیانو ته د ایمان راوړلو دپاره لاره خلاصه کړې وه."}, {"ref": "Acts 1:27", "text": "نو له دې امله مونږ یهودا او سیلاس تاسو ته درولېږل چې هغوی په خپله خوله باندې تاسو ته هغه څه ووایي چې مونږ لیکلي دي."}, {"ref": "Acts 1:27", "text": "کله چې د زندان مشر راویښ شو او ویې لیدل چې د زندان دروازې خلاصې دي، نو فکر یې وکړ چې بندیان به تښتېدلي وي، نو خپله توره یې راوویستله او نژدې ؤ چې خپل ځان ووژني."}, {"ref": "Acts 1:27", "text": "د هغه مقصد دا ؤ چې هغوی د خدای په لټه کې اوسي، هغه ته ځانونه ورسوي او پیدا یې کړي، که څه هم هغه زمونږ هر یو څخه لېرې نه دی."}, {"ref": "Acts 1:27", "text": "اپولوس جنوبي یونان ته د تګ په هکله فکر کاوه، نو د افسیس ایماندارانو هغه وهڅاوه چې لاړ شي. هغوی د اخیې ایماندارانو ته لیک ولېږه چې هغه ته تود هرکلی ووایي. کله چې هغه هلته ورسېده، نو د هغو خلکو سره یې ډېره مرسته وکړه چې د خدای په فضل سره یې ایمان راوړی ؤ."}, {"ref": "Acts 1:27", "text": "نو دا خطر شته چې نه یوازې دا چې زمونږ کاروبار به بدنام شي بلکې د دې خطر هم شته چې زمونږ د لوی خدای ارتیمیسې د عبادت ځای به هم بې‌اعتباره شي او د هغې شان او شوکت چې په اسیا او ټوله نړۍ کې ورته عبادت کیږي، هم له منځه لاړ شي.»"}, {"ref": "Acts 1:28", "text": "پطروس هغوی ته وویل: «تاسو ته ښه معلومه ده چې د یهودیانو دپاره دا ناروا ده چې د غیریهودیانو سره ناسته ولاړه او یا ملګرتیا وکړي. خو خدای ماته دا راښودلي دي چې زه باید هېڅوک هم ناپاکه او نجس ونه ګڼم."}, {"ref": "Acts 1:28", "text": "په هغوی کې یو تن چې اګابوس نومېده، ودرېده او د روح القدس په وسیله یې پېشګویي وکړه چې په ټوله نړۍ کې به سخته قحطي راشي. دا قحطي د کلودیوس امپراتور په زمانه کې راغله."}, {"ref": "Acts 1:28", "text": "سره له دې چې کوم داسې جرم یې پیدا نه کړ چې هغه ته دې د مرګ سزا ورکړل شي، خو د پیلاتوس څخه یې وغوښتل چې هغه اعدام کړي."}, {"ref": "Acts 1:28", "text": "برناباس او پولوس هلته د ډېر وخت دپاره د ایماندارانو سره پاتې شول."}, {"ref": "Acts 1:28", "text": "دا د روح القدس او زمونږ په نظر کې ښه ښکاره شوه چې پرته له دې لاندېنیو ضروري شیانو په تاسو باندې نور بار وانه چوو:"}, {"ref": "Acts 1:28", "text": "خو پولوس په زوره چیغې ووهلې: «خپل ځان ته دې زیان ونه رسوې، ځکه چې مونږ ټول دلته یو.»"}, {"ref": "Acts 1:28", "text": "لکه څنګه چې یو چا ویلي دي: په هغه کې زمونږ ژوند، زمونږ حرکت او زمونږ شتون دی. لکه څنګه چې ستاسو ځینو شاعرانو ویلي دي: مونږ هم د هغه اولادونه یو."}, {"ref": "Acts 1:28", "text": "هغه د یهودیانو سره سخت بحث وکړ او د خلکو په مخکې یې د خدای د کلام څخه دا ثابته کړه چې عیسی هماغه مسیح دی."}, {"ref": "Acts 1:28", "text": "کله چې هغوی دا خبرې واورېدلې، نو ډېر په قهر شول او چیغې یې ووهلې: «لویه ده د افسیسیانو ارتیمیسه!»"}, {"ref": "Acts 1:29", "text": "کله چې زه تاسو راوغوښتلم، نو پرته له کوم اعتراضه راغلم. خو اوس پوښتنه کوم چې تاسو ولې زه راوغوښتلم؟»"}, {"ref": "Acts 1:29", "text": "د انطاکیې ایماندارانو پرېکړه وکړه چې هر یو به د خپل توان سره سم هغو ایماندارانو ته چې په یهودیه کې اوسیږي، مرسته ورلېږي."}, {"ref": "Acts 1:29", "text": "کله چې هغوی هغه ټول شیان چې د هغه په هکله لیکل شوي وو سرته ورسول، نو هغه یې د صلیب څخه راښکته کړ او په قبر کې یې کېښود."}, {"ref": "Acts 1:29", "text": "تاسو باید هغه خواړه چې بتانو ته وړاندې کیږي ونه خورئ، وینه او د هغو حیواناتو غوښه ونه خورئ چې زندۍ شوي وي او خپل ځانونه د جنسي بد‌اخلاقۍ څخه وساتئ. که تاسو خپل ځانونه د دې شیانو څخه وساتئ، نو دا به ښه کوئ. د خدای پامان.»"}, {"ref": "Acts 1:29", "text": "د زندان مشر څراغ راوغوښت او دننه یې منډه کړه او په داسې حال کې چې له وېرې رپېده، هغه د پولوس او سیلاس په پښو کې پرېوت."}, {"ref": "Acts 1:29", "text": "نو څرنګه چې مونږ د خدای اولادونه یو، نو باید داسې فکر ونه کړو چې د خدای ذات د یوې مجسمې په شان دی چې د انسان په هنر او مهارت د سرو زرو، سپینو زرو یا تیږو څخه جوړه شوې وي."}, {"ref": "Acts 1:29", "text": "په ټول ښار کې شور او غوغا پیدا شوه. خلکو ګایوس او ارسترخوس چې د مقدونیې څخه وو او د پولوس د سفر ملګري وو، ونیول او په راښکلو راښکلو یې د ښار د غونډې ځای ته یووړل."}, {"ref": "Acts 1:30", "text": "کورنیلیوس وویل: «څلور ورځې کیږي چې په همدې وخت کې یعنې د ماسپښین په درې بجو زه په خپل کور کې په دعا کولو بوخت وم چې ناڅاپه یو سړی چې ځلېدونکي کالي یې اغوستي وو، زما په مخکې ودرېده"}, {"ref": "Acts 1:30", "text": "هغوی همداسې وکړل او خپلې مرستې یې د برناباس او شاوول په لاس د اورشلیم د کلیسا مشرانو ته ولېږلې."}, {"ref": "Acts 1:30", "text": "خو خدای هغه بېرته راژوندی کړ"}, {"ref": "Acts 1:30", "text": "نو کله چې یهودا او سیلاس رخصت کړای شول، انطاکیې ته لاړل او د کلیسا ټول غړي یې سره راټول کړل او هغه لیک یې ورته ورکړ."}, {"ref": "Acts 1:30", "text": "بیا یې هغوی دباندې راوویستل او پوښتنه یې ترې وکړه: «ای ښاغلو! زه باید څه وکړم چې خلاصون ومومم؟»"}, {"ref": "Acts 1:30", "text": "په هغه وخت کې چې خلکو خدای نه پېژانده، خدای په دې شیانو سترګې پټولې. خو اوس هغه په هرځای کې ټولو خلکو ته حکم کوي چې توبه وباسي."}, {"ref": "Acts 1:30", "text": "پولوس غوښتل چې دننه ورشي او د خلکو سره خبرې وکړي، خو ایماندارانو هغه پرېنښود."}, {"ref": "Acts 1:31", "text": "او ویې ویل: ‹ای کورنیلیوسه! خدای ستا دعاګانې قبولې کړې دي او هغه خیراتونه یې قبول کړي دي چې غریبانو ته یې ورکوې."}, {"ref": "Acts 1:31", "text": "او کوم خلک چې د هغه سره د جلیل څخه اورشلیم ته راغلي وو، تر ډېرو ورځو پورې هغوی ته ورښکاره شو او هغوی اوس د اسراییلو د خلکو په مخکې د هغه شاهدان دي."}, {"ref": "Acts 1:31", "text": "کله چې خلکو هغه ولوست، نو هغوی په دې تشویق کوونکي پیغام باندې ډېر خوشحاله شول."}, {"ref": "Acts 1:31", "text": "هغوی ځواب ورکړ: «په څښتن عیسی باندې ایمان راوړه چې ته او ستا کورنۍ خلاصون ومومئ.»"}, {"ref": "Acts 1:31", "text": "ځکه چې خدای یوه ورځ ټاکلې ده چې هغه به د عدالت له مخې د نړۍ قضاوت د هغه چا په وسیله کوي چې هغه غوره کړی دی. او د هغه کس په بیا راژوندي کولو سره یې دا خبره ټولو خلکو ته ثابته کړې ده.»"}, {"ref": "Acts 1:31", "text": "د ولایت ځینو واکمنانو چې د پولوس ملګري وو هم هغه ته پیغام ورولېږه او هغه ته یې زاري وکړه چې د غونډې ځای ته لاړ نه شي."}, {"ref": "Acts 1:32", "text": "اوس یو څو کسان د شمعون پسې چې پطروس ورته ویل کیږي، یافا ته ولېږه چې هغه راولي. هغه د بحیرې په غاړه د شمعون څرمن جوړوونکي په کور کې مېلمه دی.›"}, {"ref": "Acts 1:32", "text": "اوس مونږ تاسو ته هغه زېری اوروو چې خدای زمونږ د نیکونو سره وعده کړې وه."}, {"ref": "Acts 1:32", "text": "یهودا او سیلاس چې په خپله پیغمبران وو، په خپلو زیاتو خبرو هغوی تشویق او تکړه کړل."}, {"ref": "Acts 1:32", "text": "بیا هغوی د څښتن عیسی پیغام هغه او د هغه د کورنۍ ټولو خلکو ته بیان کړ."}, {"ref": "Acts 1:32", "text": "کله چې هغوی د پولوس څخه د مړو نه د راژوندي کېدلو خبره واورېدله، نو ځینو ورباندې ملنډې ووهلې، خو نورو وویل: «مونږ به په دې هکله په کوم بل وخت کې ستا خبرې بیا واورو.»"}, {"ref": "Acts 1:32", "text": "په دې وخت کې غونډه ګډه وډه شوه او ځینو به په چیغو چیغو کې یو څه او ځینو به بل څه ویل، ځکه چې په هغوی کې ډېر خلک په دې هم نه پوهېدل چې د څه دپاره دلته راټول شوي دي."}, {"ref": "Acts 1:33", "text": "نو سمدلاسه مې تا پسې سړي درولېږل او تا ډېر ښه کار وکړ چې دلته راغلې. نو اوس مونږ ټول دلته د خدای په حضور کې حاضر یو چې د هرڅه په هکله چې څښتن تاته حکم کړی دی، هغه واورو.» غیریهودیانو ته د پطروس وینا"}, {"ref": "Acts 1:33", "text": "خدای دا وعده زمونږ دپاره چې د هغوی اولاده یو، د مړو نه د عیسی په بیا راژوندي کولو سره پوره کړه. لکه څنګه چې په دوهم زبور کې لیکل شوي دي: ته مې زوی، زه دې نن پلار شوم."}, {"ref": "Acts 1:33", "text": "هلته د څه وخت تېرولو نه وروسته هغوی د ایماندارانو له خوا په خیریت سره رخصت شول او بېرته هغو خلکو ته ورغلل چې دوی یې لېږلي وو."}, {"ref": "Acts 1:33", "text": "د شپې په هماغه ساعت د زندان مشر هغوی بوتلل او د هغوی زخمونه یې ووینځل او سمدلاسه هغه او د هغه ټولې کورنۍ ته د تعمید غسل ورکړل شو."}, {"ref": "Acts 1:33", "text": "نو په دې ډول پولوس د هغوی څخه لاړ."}, {"ref": "Acts 1:33", "text": "ځینو یهودي مشرانو د سکندر په نوم سړی د خلکو د ګڼې ګوڼې مخې ته ورټېله کړ او هغه ته یې وویل چې یو‌څه باید ووایي. هغه په خپل لاس اشاره وکړه چې خلک غلي شي او کوښښ یې وکړ چې هر هغه څه چې شوي وو، هغه بیان کړي."}, {"ref": "Acts 1:34", "text": "پطروس خپلې خبرې پیل کړې او ویې ویل: «زه اوس پوه شوم چې دا رښتیا دي چې خدای د هېچا طرفداري نه کوي."}, {"ref": "Acts 1:34", "text": "خدای هغه د مړو څخه راژوندی کړ او دې ته یې پرېنښود چې مړی یې په قبر کې خراب شي. او په دې هکله خدای داسې وویل: زه به تاته هغه ځانګړي او یقیني برکتونه درکړم چې د داود سره مې وعده کړې وه."}, {"ref": "Acts 1:34", "text": "‏-۳۵ خو پولوس او برناباس په انطاکیه کې پاتې شول او هلته یې د ډېرو نورو سره یوځای تعلیم ورکاوه او د څښتن عیسی پیغام یې اوراوه. د پولوس او برناباس بېلېدل"}, {"ref": "Acts 1:34", "text": "بیا هغه پولوس او سیلاس خپل کور ته راوستل او هغوی ته یې ډوډۍ راوړه. په دې خاطر چې هغه او ټولې کورنۍ یې په خدای باندې ایمان راوړ، نو ډېر خوشحاله شول."}, {"ref": "Acts 1:34", "text": "خو یو څو تنه د پولوس سره یوځای شول او ایمان یې راوړ، چې دیونیسوس چې د مریخ د غونډۍ د شورا غړی ؤ او همدارنګه یوه ښځه چې دامریس نومېدله او ځینې نور خلک هم ورسره وو."}, {"ref": "Acts 1:34", "text": "خو کله چې خلک پوه شول چې سکندر یهودي دی، نو ټولو په یو اواز دوه ساعته چیغې ووهلې: «لویه ده د افسیسیانو خدای ارتیمیسه!»"}, {"ref": "Acts 1:35", "text": "په هر قوم کې چې هرڅوک ‎له خدایه وېریږي او سم کارونه کوي، خدای هغه مني."}, {"ref": "Acts 1:35", "text": "او د زبور په بل ځای کې داود وایي: ته به پرېنږدې مړی د خپل سپېڅلي خادم چې شي خراب"}, {"ref": "Acts 1:35", "text": "کله چې سهار شو، نو رومي مامورینو خپل د پولیسو منصبداران د زندان مشر ته ورولېږل او امر یې ورته وکړ: «هغه سړي پرېږدئ چې لاړ شي.»"}, {"ref": "Acts 1:35", "text": "په پای کې ښاروال خلک غلي کړل او ویې ویل: «ای د افسیس خلکو، ټولو ته معلومه ده چې د افسیس ښار د لویې ارتیمیسې د عبادتځای او د هغې سپېڅلې تیږې ساتونکی دی چې د اسمان څخه راغورځېدلې ده."}, {"ref": "Acts 1:36", "text": "تاسو پوهېږئ چې خدای خپل پیغام د اسراییلو قوم ته ورولېږه او د سولې او سلامتۍ زېری یې د عیسی مسیح په وسیله چې د ټولو څښتن دی، اعلان کړ."}, {"ref": "Acts 1:36", "text": "ځکه چې داود په خپله زمانه کې د خدای اراده پوره کړه او بیا مړ شو او د خپلو نیکونو سره ښخ کړای شو او مړی یې په قبر کې خراب شو."}, {"ref": "Acts 1:36", "text": "څه موده وروسته پولوس برناباس ته وویل: «راځئ چې بېرته لاړ شو او په هغو ټولو ښارونو کې چې مونږ په کې د څښتن عیسی پیغام اورولی ؤ، د ایماندارانو سره لیدنه کتنه وکړو او وګورو چې هغوی څنګه دي.»"}, {"ref": "Acts 1:36", "text": "نو د زندان مشر پولوس ته وویل: «رومي مامورینو امر کړی چې ته او سیلاس به ازاد شئ. نو اوس تاسو کولای شئ چې راووځئ او په خیر لاړ شئ.»"}, {"ref": "Acts 1:36", "text": "نو څرنګه چې هېڅوک د دې حقیقتونو څخه انکار نه شي کولای، تاسو باید غلي شئ او بې‌سنجشه کار ونه کړئ."}, {"ref": "Acts 1:37", "text": "تاسو پوهېږئ چې په ټوله یهودیه کې څه وشول. دا پېښه د یحیی د تعمید د غسل د اعلانولو څخه وروسته له جلیل څخه پیل شوه."}, {"ref": "Acts 1:37", "text": "خو کوم کس چې خدای د مړو څخه راژوندی کړ، د هغه مړی خراب نه شو."}, {"ref": "Acts 1:37", "text": "برناباس غوښتل چې یوحنا چې د مرقوس په نوم یادېده هم د ځان سره بوځي."}, {"ref": "Acts 1:37", "text": "خو پولوس د پولیسو منصبدارانو ته وویل: «سره له دې چې مونږ رومي تابعیت لرو، خو بیاهم هغو خلکو مونږ بې له کومې محاکمې څخه د ټولو خلکو په مخکې ووهلو او په زندان کې یې واچولو او اوس غواړي مونږ په پټه وباسي؟ نه، پرېږده چې هغوی خپله راشي او مونږ وباسي.»"}, {"ref": "Acts 1:37", "text": "دا خلک چې تاسو دلته راوستلي دي هغوی نه د عبادتځای څخه غلا کړې ده او نه یې زمونږ خدای ارتیمیسې ته کفر ویلی دی."}, {"ref": "Acts 1:38", "text": "او تاسو خبر یئ چې خدای څنګه ناصري عیسی په روح القدس او په خپل قدرت سره مسح کړ. هغه به هرځای ته تللو او د خلکو سره به یې نېکي کوله او کوم خلک چې د شیطان په بند کې وو هغوی ته به یې شفا ورکوله، ځکه چې خدای ورسره مل ؤ."}, {"ref": "Acts 1:38", "text": "‏-۳۹ نو ای زما ورونو! تاسو باید په دې پوه شئ چې د ګناهونو د بخښنې پیغام د عیسی په وسیله تاسو ته اعلانیږي او هرڅوک چې په هغه باندې ایمان راوړي، هغه به د هغو ټولو ګناهونو څخه خلاص شي چې د موسی شریعت ونه شو کولای هغه ته خلاصون ورکړي."}, {"ref": "Acts 1:38", "text": "خو پولوس دا مناسبه نه ګڼله چې مرقوس د ځان سره بوځي، ځکه چې هغوی یې په پمفیلیا کې پریښي وو او د کار تر پایه پورې د هغوی سره پاتې نه شو."}, {"ref": "Acts 1:38", "text": "د پولیسو منصبدارانو دا خبرې رومي مامورینو ته ورسولې او کله چې هغوی خبر شول چې پولوس او سیلاس رومیان دي، نو ووېرېدل"}, {"ref": "Acts 1:38", "text": "که چېرې دیمیتریوس او د هغه نور کسبګران د هغوی په خلاف دعوه چلول غواړي، نو د محکمو دروازې خلاصې دي او قاضیان هم شته، نو هغوی کولای شي چې په یو بل باندې دعوه وکړي."}, {"ref": "Acts 1:39", "text": "مونږ د هغو ټولو کارونو شاهدان یو چې عیسی د یهودیانو په وطن او اورشلیم کې وکړل. هغوی عیسی په صلیب باندې ځوړند کړ او ویې واژه."}, {"ref": "Acts 1:39", "text": "د پولوس او برناباس ترمنځ یوه داسې سخته شخړه راپیدا شوه چې د یو بل نه بېل شول. برناباس مرقوس د ځان سره واخیست او په کشتۍ کې قبرس ته روان شول."}, {"ref": "Acts 1:39", "text": "او راغلل او د هغوی څخه یې بخښنه وغوښتله او هغوی یې د زندان څخه راوویستل او غوښتنه یې ورڅخه وکړه چې د ښار نه لاړ شي."}, {"ref": "Acts 1:39", "text": "که تاسو نور څه غواړئ، نو د هغې په هکله دې په یوه رسمي غونډه کې پرېکړه وشي."}, {"ref": "Acts 1:40", "text": "خو خدای هغه په درېمه ورځ بېرته راژوندی کړ او خلکو ته یې ښکاره کړ،"}, {"ref": "Acts 1:40", "text": "نو پام کوئ چې پیغمبرانو چې څه ویلي دي هغه په تاسو عملي نه شي:"}, {"ref": "Acts 1:40", "text": "خو پولوس سیلاس خوښ کړ او وروسته له هغې چې ایماندارانو هغوی د څښتن فضل ته وسپارل، هغوی روان شول."}, {"ref": "Acts 1:40", "text": "نو پولوس او سیلاس د زندان څخه ووتل او د لیدیه کور ته لاړل او هلته یې د ایماندارانو سره ولیدل او یوځل بیا یې هغوی ته تسلي ورکړه او بیا لاړل."}, {"ref": "Acts 1:40", "text": "ځکه چې دا خطر شته چې مونږ د نن ورځې د شور او غوغا په خاطر تورن شو او د دې ګډوډۍ دپاره کومه بهانه نشته او مونږ به ونه شو کولای چې د دې دپاره کوم سم دلیل وړاندې کړو.»"}, {"ref": "Acts 1:41", "text": "ټولو خلکو ته نه، بلکې یوازې هغو شاهدانو ته چې خدای له مخکې نه غوره کړي وو، یعنې مونږ ته چې د هغه د بیا راژوندي کېدلو څخه وروسته مو ورسره وخوړل او وڅښل."}, {"ref": "Acts 1:41", "text": "ګورئ ای ملنډو وهونکو! حیران او تباه شئ، ځکه چې زه به ستاسو په ژوندانه کې یو داسې کار وکړم، که څوک یې تاسو ته بیان هم کړي، نو باور به ورباندې ونه کړئ.»"}, {"ref": "Acts 1:41", "text": "کله چې پولوس د سوریې او قیلیقیې له لارې تېرېده، نو کلیساګانو ته یې ډاډګېرنه ورکوله."}, {"ref": "Acts 1:41", "text": "کله چې هغه دا خبره وکړه، نو د غونډې خلک یې رخصت کړل."}, {"ref": "Acts 1:42", "text": "عیسی مونږ ته حکم کړی چې خلکو ته وعظ وکړو او دا شهادت ورکړو چې دا هغه څوک دی چې خدای په مړو او ژوندیو باندې قاضي ټاکلی دی."}, {"ref": "Acts 1:42", "text": "کله چې پولوس او برناباس د کنیسې څخه وتل، نو خلکو ورڅخه وغوښتل چې د راتلونکي سبت په ورځ بیا راشي او د دې شیانو په هکله دوی ته خبرې وکړي."}, {"ref": "Acts 1:43", "text": "د هغه په هکله ټول پیغمبران شاهدي ورکوي او وایي چې هرڅوک چې په هغه باندې ایمان راوړي، نو د هغه په نوم به یې ګناهونه وبخښل شي.» په غیریهودیانو باندې د روح القدس نازلېدل"}, {"ref": "Acts 1:43", "text": "کله چې غونډه پای ته ورسېدله، نو ډېر یهودیان او هغه دینداره خلک چې یهودیان شوي وو، د پولوس او برناباس سره روان شول. پولوس او برناباس د هغوی سره خبرې وکړې او هغوی یې وهڅول چې تل د خدای په فضل باندې توکل ولري."}, {"ref": "Acts 1:44", "text": "پطروس لا خبرې کولې چې په هغو ټولو خلکو باندې چې د هغه خبرې یې اورېدلې، روح القدس نازل شو."}, {"ref": "Acts 1:44", "text": "د راتلونکي سبت په ورځ د ښار نژدې ټول اوسېدونکي راغلل چې د څښتن عیسی پیغام واوري."}, {"ref": "Acts 1:45", "text": "هغه یهودي ایمانداران چې د پطروس سره راغلي وو، په دې حیران شول چې د روح القدس نعمت په غیریهودیانو هم نازل شو."}, {"ref": "Acts 1:45", "text": "کله چې ځینو یهودیانو دا ګڼه‌ګوڼه ولیدله، نو بخیلي ورسره پیدا شوه. هغوی د پولوس د خبرو سره مخالفت پیل کړ او هغه ته یې سپکاوی وکړ."}, {"ref": "Acts 1:46", "text": "ځکه چې دوی اورېدل چې هغوی په نا‌اشنا ژبو خبرې کولې او د خدای لویي یې بیانوله. بیا پطروس وویل:"}, {"ref": "Acts 1:46", "text": "خو پولوس او برناباس په زړورتیا سره خبرې کولې او ویل یې: «دا ضروري وه چې د خدای پیغام لومړی تاسو ته واورول شي. خو څرنګه چې تاسو هغه ونه مانه او خپل ځانونه مو د تلپاتې ژوندون وړ ونه ګڼل، نو مونږ به اوس تاسو پرېږدو او غیریهودیانو ته به ورشو."}, {"ref": "Acts 1:47", "text": "«ایا داسې څوک شته چې دا خلک چې زمونږ په شان یې روح القدس تر‌لاسه کړی دی په اوبو باندې د تعمید غسل د اخیستلو څخه منع کړي؟»"}, {"ref": "Acts 1:47", "text": "نو ځکه څښتن مونږ ته داسې حکم وکړ: زه به ستا څخه د غیریهودیانو دپاره رڼا جوړه کړم، ترڅو ته ټولې نړۍ ته د خلاصون وسیله وګرځې.»"}, {"ref": "Acts 1:48", "text": "نو پطروس امر وکړ چې هغوی ته دې د عیسی مسیح په نوم د تعمید غسل ورکړل شي. بیا هغوی د پطروس څخه وغوښتل چې یو څو ورځې د هغوی سره پاتې شي."}, {"ref": "Acts 1:48", "text": "کله چې غیریهودیانو دا خبرې واورېدلې، نو ډېر خوشحاله شول او د څښتن عیسی د پیغام ستاینه یې وکړه او کوم خلک چې د تلپاتې ژوندون دپاره غوره کړای شوي وو، هغوی ایمان راوړ."}, {"ref": "Acts 1:49", "text": "د څښتن پیغام په هغه ټوله سیمه کې خپور شو."}, {"ref": "Acts 1:50", "text": "خو یهودیانو دینداره او عزتمندې ښځې او د ښار مشران د پولوس او برناباس په خلاف داسې ولمسول چې د هغوی په ځورولو یې پیل وکړ او د خپلې سیمې څخه یې وشړل."}, {"ref": "Acts 1:51", "text": "نو پولوس او برناباس د خپلو پښو خاورې د هغه ښار د خلکو په وړاندې د نښې په توګه وڅنډلې او د قونیې ښار ته لاړل."}, {"ref": "Acts 1:52", "text": "خو د هغه ځای ایمانداران د خوشحالۍ او روح القدس څخه ډک شول."}, {"ref": "Acts 2:1", "text": "کله چې شور او غوغا پای ته ورسېدله، نو پولوس ایمانداران راوغوښتل، هغوی یې وهڅول او خدای پاماني یې ورسره وکړه او مقدونیې ته روان شو."}, {"ref": "Acts 2:1", "text": "مونږ د افسیسانو د مشرانو سره خدای پاماني وکړه او له هغه ځای څخه روان شولو او په کشتۍ کې مخامخ د کاس جزیرې ته لاړو. په بله ورځ د رودوس جزیرې ته ورسېدلو او له هغه ځای څخه د پاترا د ښار بندر ته لاړو."}, {"ref": "Acts 2:1", "text": "پولوس هغوی ته وویل: «ای زما یهودي ورونو او پلرونو! زه چې اوس تاسو ته د خپل ځان څخه د دفاع دپاره څه وایم، ورته غوږ ونیسئ.»"}, {"ref": "Acts 2:1", "text": "پولوس په ځیر سره د شورا غړو ته وکتل او ویې ویل: «ای ورونو! ما تر نن ورځې پورې په پاک وجدان سره د خدای په حضور کې ژوند تېر کړی دی.»"}, {"ref": "Acts 2:1", "text": "پنځه ورځې وروسته لوی کاهن حنانیا د څو تنو مشرانو او د ترتولوس په نوم د یو وکیل سره قیصریې ته راورسېدل او د پولوس په ضد یې خپله دعوه والي ته وړاندې کړه."}, {"ref": "Acts 2:1", "text": "کله چې فستوس قیصریې ته د والي په توګه راغی، نو درې ورځې وروسته اورشلیم ته لاړ."}, {"ref": "Acts 2:1", "text": "اګریپاس پولوس ته وویل: «تاته اجازه درکول کیږي چې د خپل ځان څخه دفاع وکړې.» نو پولوس خپل لاس پورته کړ او د خپل ځان څخه یې داسې دفاع وکړه:"}, {"ref": "Acts 2:1", "text": "کله چې دا پرېکړه وشوه چې مونږ به په کشتۍ کې ایټالیا ته ځو، نو هغوی پولوس او ځینې نور بندیان یولیوس ته چې د روم د امپراتور د لښکرو د کنډک یو منصبدار ؤ، وسپارل."}, {"ref": "Acts 2:1", "text": "کله چې مونږ روغ رمټ د بحیرې غاړې ته ورسېدلو، نو پوه شولو چې دا د مالتا په نوم جزیره ده."}, {"ref": "Acts 2:2", "text": "هغه د مقدونیې د سیمو له لارې تېرېده او ایماندارانو ته یې ډاډګېرنه ورکوله او بیا یونان ته ورسېده."}, {"ref": "Acts 2:2", "text": "په هغه ځای کې مونږ یوه کشتۍ پیدا کړه چې فنیقیې ته روانه وه، نو مونږ په کې سپاره شولو او لاړو."}, {"ref": "Acts 2:2", "text": "کله چې هغوی واورېدل پولوس په عبراني ژبه خبرې کوي، نو هغوی نور هم غلي شول. بیا پولوس وویل:"}, {"ref": "Acts 2:2", "text": "په دې خبره لوی کاهن حنانیا هغو خلکو ته چې د پولوس په خوا کې ولاړ وو، امر وکړ چې په خوله یې ووهئ."}, {"ref": "Acts 2:2", "text": "کله چې پولوس راوغوښتل شو، نو ترتولوس خپله دعوه داسې پیل کړه: «ښاغلیه، ستاسو د ښه مشرتوب له امله مونږ د دوامدارې سولې څخه برخمن شولو او زمونږ د وطن د ښېګڼې دپاره ډېر ضروري اصلاحات روان دي."}, {"ref": "Acts 2:2", "text": "‏-۳ هلته مشرانو کاهنانو او د یهودیانو مشرانو د پولوس په خلاف خپله دعوه هغه ته وړاندې کړه. هغوی د فستوس څخه غوښتنه وکړه چې ورباندې مهرباني وکړي او پولوس اورشلیم ته راوغواړي. ځکه چې هغوی ورته دسیسه جوړه کړې وه چې کمین ورته ونیسي او په لاره کې یې ووژني."}, {"ref": "Acts 2:2", "text": "«ای پاچا، زه خپل ځان بختور ګڼم چې نن ستاسو په حضور کې ولاړ یم او د هغو ټولو تورونو په خلاف چې د یهودیانو له خوا په ما لګېدلي دي، د خپل ځان څخه دفاع کوم."}, {"ref": "Acts 2:2", "text": "بیا مونږ د ادرامیتینې په کشتۍ کې چې د اسیا د ولایت بندرونو ته روانه وه، سپاره شولو. زمونږ سره یو مقدوني سړی چې ارسترخوس نومېده او د تسالونیکیې څخه ؤ، هم ملګری ؤ."}, {"ref": "Acts 2:2", "text": "د هغه ځای خلکو په مونږ ډېره مهرباني وکړه او څرنګه چې هوا سړه وه او باران ورېده، نو اور یې راته بل کړ او مونږ ټولو ته یې تود هرکلی ووایه."}, {"ref": "Acts 2:3", "text": "درې میاشتې هلته پاتې شو. هغه تیاری ونیوه چې په کشتۍ کې سوریې ته لاړ شي، خو کله چې پوه شو چې یهودیانو د هغه په خلاف دسیسه جوړه کړې ده، نو پرېکړه یې وکړه چې د مقدونیې په لاره بېرته ستون شي."}, {"ref": "Acts 2:3", "text": "کله چې قبرس د لېرې نه ښکاره شو، نو مونږ د هغه د جنوب خوا څخه تېر شولو او د سوریې خواته روان شولو او د صور د ښار په بندر کې ښکته شولو، ځکه چې هلته یې د کشتۍ څخه بار ښکته کاوه."}, {"ref": "Acts 2:3", "text": "«زه یهودي یم او د قیلیقیې په ترسوس کې پیدا شوی یم، خو دلته په اورشلیم کې لوی شوی یم او د غمالاییل شاګرد وم. د هغه څخه مې په ډېرې سختې طریقې سره زده کړل چې څنګه د خپلو نیکونو د شریعت څخه پیروي وکړم او په غیرت او شوق سره مې د خدای خدمت وکړ لکه څنګه چې تاسو یې کوئ."}, {"ref": "Acts 2:3", "text": "بیا پولوس هغه ته وویل: «خدای به دې ووهي، ای په چونه باندې سپین شوی دېواله. ته ناست یې چې د شریعت له مخې زما په هکله قضاوت وکړې، خو اوس د شریعت خلاف امر کوې چې ما ووهي.»"}, {"ref": "Acts 2:3", "text": "مونږ په هرځای کې او په هر وخت کې ستاسو د دې کارونو دپاره د زړه له کومي ډېره مننه کوو."}, {"ref": "Acts 2:3", "text": "په ځانګړې توګه څرنګه چې تاسو د یهودیانو د ټولو دودونو او د هغوی ترمنځ چې کوم اختلافات موجود دي، د هغو ټولو سره بلد یئ. نو تاسو ته سوال کوم چې په پوره صبر او حوصلې سره زما خبرو ته غوږ ونیسئ."}, {"ref": "Acts 2:3", "text": "په بله ورځ مونږ د صیدون د ښار بندر ته ورسېدلو. یولیوس په پولوس مهربانه شو او هغه ته یې اجازه ورکړه چې خپلو ملګرو ته ورشي او چې کوم شي ته اړتیا ولري، هغوی یې ورته ورکړي."}, {"ref": "Acts 2:3", "text": "پولوس یو څه لرګي راټول کړل او هغه یې اور ته واچول او د اور د ګرموالي له امله یو زهرجن مار راووت او د هغه د لاس پورې ونښته."}, {"ref": "Acts 2:4", "text": "د پیروس زوی سوپاتروس چې د بیریې څخه ؤ، ارسترخوس او سکندوس د تسالونیکې څخه، ګایوس له دربې څخه، تیخیکاس او تروفیموس چې د اسیا د ولایت څخه او تیموتاوس د هغه د سفر ملګري وو."}, {"ref": "Acts 2:4", "text": "په هغه ځای کې مو ایمانداران پیدا کړل او یوه هفته د هغوی سره پاتې شولو. هغوی د روح القدس په لارښوونه پولوس ته وویل چې اورشلیم ته لاړ نه شي."}, {"ref": "Acts 2:4", "text": "ما د مرګ تر حده د څښتن عیسی مسیح د لارې پیروان ځورول. ښځې او نران دواړه به مې نیول او په زندان کې به مې اچول."}, {"ref": "Acts 2:4", "text": "نو هغو خلکو چې د پولوس په خوا کې ولاړ وو، وویل: «ته د خدای لوی کاهن ته سپکاوی کوې؟»"}, {"ref": "Acts 2:4", "text": "زه نه غواړم چې ستاسو ډېر وخت ونیسم، نو ستاسو څخه غوښتنه کوم چې د مهربانۍ له مخې زمونږ څو خبرو ته غوږ ونیسئ."}, {"ref": "Acts 2:4", "text": "فستوس ځواب ورکړ: «پولوس په قیصریه کې بندي ساتل شوی دی او زه په خپله ډېر زر بېرته هلته ورځم."}, {"ref": "Acts 2:4", "text": "ټول یهودیان پوهیږي چې ما د ځوانۍ د وخت نه د خپلو خلکو سره او په اورشلیم کې څنګه ژوند تېر کړی دی."}, {"ref": "Acts 2:4", "text": "مونږ د صیدون څخه روان شولو، خو له دې امله چې باد مونږ ته مخامخ لګېده، نو د قبرس د جزیرې په بلې خوا لاړو، ځکه چې هلته باد نه لګېده."}, {"ref": "Acts 2:4", "text": "کله چې د هغه ځای خلکو ولیدل چې د پولوس په لاس پورې مار ځوړند دی، نو یو بل ته یې سره وویل: «دا سړی به خامخا قاتل وي. که څه هم هغه له بحیرې څخه وژغورل شو، خو الهي عدالت به هغه ژوندی پرېنږدي.»"}, {"ref": "Acts 2:5", "text": "هغوی مخکې لاړل او په ترواس کې یې زمونږ انتظار کاوه."}, {"ref": "Acts 2:5", "text": "خو کله چې هفته پوره شوه، نو مونږ بیا په سفر روان شولو. هغوی ټول د خپلو ښځو او ماشومانو سره زمونږ سره ملګري شول او د ښار څخه ووتلو او د بحیرې په غاړه په ګونډو شولو او دعا مو وکړه."}, {"ref": "Acts 2:5", "text": "لوی کاهن او د یهودیانو د شورا ټول غړي کولای شي شاهدي ورکړي چې زه رښتیا وایم. هغوی ماته په دمشق کې د یهودي ورونو دپاره رسمي لیکونه راکړي وو. نو زه دمشق ته لاړم چې هغه خلک لاس تړلي اورشلیم ته راولم چې سزا ورته ورکړل شي."}, {"ref": "Acts 2:5", "text": "پولوس ځواب ورکړ: «ای ورونو، زه نه پوهېدم چې هغه لوی کاهن دی. ځکه چې د خدای په کلام کې لیکل شوي دي: چې د خپل قوم مشر ته بدې خبرې مه کوئ.»"}, {"ref": "Acts 2:5", "text": "مونږ ته معلومه شوې ده چې دا یو شر جوړوونکی سړی دی او په ټوله نړۍ کې د یهودیانو ترمنځ شور او غوغا راپیدا کوي او د ناصریانو د مذهبي ډلې مشر دی."}, {"ref": "Acts 2:5", "text": "نو ستاسو مشران دې زما سره قیصریې ته لاړ شي او که هغه کوم غلط کار کړی وي، نو دعوه دې پرې وکړي.»"}, {"ref": "Acts 2:5", "text": "هغوی ما له پخوا څخه پېژني او که چېرې هغوی وغواړي، نو کولای شي تصدیق کړي چې زه د فریسیانو د ډلې غړی وم چې دا زمونږه یوه ډېره سرسخته مذهبي ډله ده."}, {"ref": "Acts 2:5", "text": "کله چې مونږ د قیلیقیې او پمفیلیې د بحیرو څخه تېر شولو، نو د میرا ښار ته چې د لیکیا په ولایت کې دی، ورسېدلو."}, {"ref": "Acts 2:5", "text": "خو پولوس هغه مار اور ته ورګوزار کړ او کوم زیان ورته ونه رسېده."}, {"ref": "Acts 2:6", "text": "کله چې د فطیرې ډوډۍ د اختر ورځې تېرې شوې، نو مونږ د فیلیپیې څخه په کشتۍ کې روان شولو او په پنځو ورځو کې د هغوی سره په ترواس کې یوځای شولو او یوه هفته هلته پاتې شولو. په ترواس کې د پولوس وروستنۍ لیدنه او کتنه"}, {"ref": "Acts 2:6", "text": "بیا مو یو د بل سره خدای پاماني وکړه. مونږ په کشتۍ کې سپاره شو او هغوی بېرته خپلو کورونو ته لاړل."}, {"ref": "Acts 2:6", "text": "کله چې زه په سفر روان وم او دمشق ته نژدې شوم او د غرمې وخت نژدې ؤ، نو ناڅاپه د اسمان څخه یوه لویه رڼا زما شاوخوا وځلېدله."}, {"ref": "Acts 2:6", "text": "کله چې پولوس پوه شو چې د شورا ځینې غړي صدوقیان او ځینې یې فریسیان دي، نو په لوړ اواز یې وویل: «ای ورونو! زه فریسي یم او پلار مې هم فریسي ؤ. زه په دې خاطر محاکمه کېږم چې په دې هیله یم چې مړي به بیا راژوندي کیږي.»"}, {"ref": "Acts 2:6", "text": "همدارنګه هغه کوښښ کاوه چې د خدای د کور بې‌عزتي وکړي، خو مونږ هغه ونیوه. [مونږ غوښتل چې د خپل شریعت له مخې هغه محاکمه کړو."}, {"ref": "Acts 2:6", "text": "فستوس د اتو یا لسو ورځو دپاره په اورشلیم کې پاتې شو او بیا قیصریې ته لاړ. په بله ورځ هغه په محکمه کې په خپلې چوکۍ باندې کښېناست او امر یې وکړ چې پولوس راولي."}, {"ref": "Acts 2:6", "text": "اوس د دې دپاره چې د خدای د هغې وعدې په هیله یم چې زمونږ د نیکونو سره یې کړې ده، محاکمه کېږم."}, {"ref": "Acts 2:6", "text": "په هغه ځای کې هغه منصبدار د سکندریې یوه کشتۍ پیدا کړه چې ایټالیا ته روانه وه او مونږ یې په هغې کې سپاره کړو."}, {"ref": "Acts 2:6", "text": "هغوی په دې تمه وو چې پولوس به زر وپړسیږي او یا به ناڅاپه راولویږي او مړ به شي. خو کله چې هغوی ډېر انتظار وویست او ویې لیدل چې په هغه باندې هېڅ هم ونه شول، نو فکرونه یې بدل شول او ویې ویل: «دا هم یو خدای دی.»"}, {"ref": "Acts 2:7", "text": "د شنبې ورځې په ماښام مونږ د غوره ماښامي د مراسمو د لمانځلو دپاره سره راټول شولو. پولوس ایماندارانو ته خبرې وکړې، څرنګه چې هغه غوښتل بله ورځ په سفر لاړ شي، نو تر نیمې شپې پورې یې خپلو خبرو ته دوام ورکړ."}, {"ref": "Acts 2:7", "text": "مونږ په بحیره کې د صور څخه خپل سفر ته دوام ورکړ او د پتولاماییس ښار ته ورسېدلو. هلته مو د ایماندارانو سره ستړي مشي وکړه او د یوې ورځې دپاره د هغوی سره پاتې شولو."}, {"ref": "Acts 2:7", "text": "زه په ځمکه راولوېدم او یو اواز مې واورېد چې ویل یې: ‹شاووله، شاووله! ته ولې ما ځوروې؟›"}, {"ref": "Acts 2:7", "text": "څنګه چې هغه دا خبره وکړه، نو د فریسیانو او صدوقیانو ترمنځ مخالفت پیدا شو او غونډه په دوو ډلو ووېشل شوه."}, {"ref": "Acts 2:7", "text": "خو لیسیاس قوماندان راغی او په زوره یې هغه زمونږ نه خلاص کړ"}, {"ref": "Acts 2:7", "text": "کله چې پولوس راغی، نو هغه یهودیان چې د اورشلیم څخه راغلي وو د هغه څخه شاوخوا راتاو شول او په هغه باندې یې ډېر سخت تورونه ولګول چې ثابتولی یې نه شول."}, {"ref": "Acts 2:7", "text": "دا هغه وعده ده چې زمونږ د خلکو دولس قبیلې د هغې د پوره کېدلو په هیله شپه او ورځ عبادت کوي. ای پاچا! د همدې هیلې په خاطر یهودیان په ما باندې تورونه لګوي."}, {"ref": "Acts 2:7", "text": "تر ډېرو ورځو پورې مونږ ورو ورو تللو او په ډېر تکلیف سره قنیدوس ته ورسېدلو. څرنګه چې باد مونږ ته مخامخ لګېده، نو بلې خواته مو حرکت وکړ او د کریت د جزیرې په هغې خوا چې د باد څخه پناه وه، روان شولو او د سلمونې د سیمې څخه تېر شولو."}, {"ref": "Acts 2:7", "text": "هغه ځای ته نژدې د هغې جزیرې د حاکم پوبلیوس ځمکې وې. هغه په مهربانۍ سره مونږ ته هرکلی ووایه او درې ورځې یې په خپل کور کې مېلمانه کړو."}, {"ref": "Acts 2:8", "text": "پاس په بالاخانه کې چې مونږ په کې راټول شوي وو، ډېر څراغونه لګېدلي وو."}, {"ref": "Acts 2:8", "text": "په بله ورځ له هغه ځای څخه روان شولو او قیصریې ته ورسېدلو او هلته د فیلیپوس په کور کې چې زېری رسوونکی ؤ، پاتې شولو. هغه د هغو اوو کسانو څخه ؤ چې په اورشلیم کې د خوړو د وېشلو دپاره ټاکل شوي وو."}, {"ref": "Acts 2:8", "text": "ما پوښتنه وکړه: ‹ای څښتنه، ته څوک یې؟› هغه ځواب راکړ: ‹زه ناصري عیسی یم، یعنې هغه څوک چې ته یې ځوروې.›"}, {"ref": "Acts 2:8", "text": "(ځکه چې صدوقیان د قیامت د ورځې، فرښتو او پېریانو څخه منکر دي، خو فریسیان دا ټول مني.)"}, {"ref": "Acts 2:8", "text": "او د هغه مدعیانو ته یې امر وکړ چې ستاسو حضور ته راشي.] که تاسو خپله د پولوس څخه پوښتنه وکړئ، نو پوه به شئ چې زمونږ دعوه رښتیا ده.»"}, {"ref": "Acts 2:8", "text": "پولوس د خپل ځان څخه دفاع وکړه او ویې ویل: «ما نه د یهودیانو د شریعت په خلاف، نه مې د خدای د کور او نه مې د امپراتور په خلاف کوم غلط کار کړی دی.»"}, {"ref": "Acts 2:8", "text": "تاسو هر یو ته دا ولې ناشونې ښکاري چې خدای مړي راژوندي کولای شي؟"}, {"ref": "Acts 2:8", "text": "په سختۍ سره د بحیرې په غاړه تللو او یو ځای ته ورسېدلو چې د «خوندي بندر» په نوم یادېده او د لسایې ښار ته نژدې ؤ."}, {"ref": "Acts 2:8", "text": "هغه وخت د پوبلیوس پلار ناروغه پروت ؤ. هغه تبه لرله او د پېچ په ناروغۍ اخته ؤ. پولوس د هغه کوټې ته ننوت، د هغه دپاره یې دعا وکړه، خپل لاس یې ورباندې کېښود او هغه ته یې شفا ورکړه."}, {"ref": "Acts 2:9", "text": "هلته په کړکۍ کې یو ځوان ناست ؤ چې افتیخوس نومېده. کله چې پولوس خبرې کولې، نو په هغه ځوان باندې خوب راغی او په درانه خوب ویده شو او د درېم منزل څخه لاندې ځمکې ته راولوېد. کله یې چې راپورته کړ، نو هغه مړ شوی ؤ."}, {"ref": "Acts 2:9", "text": "فیلیپوس څلور پېغلې لورګانې لرلې چې د خدای پیغام به یې رساوه."}, {"ref": "Acts 2:9", "text": "زما ملګرو رڼا ولیدله، خو چا چې زما سره خبرې کولې د هغه اواز یې نه اورېدلو."}, {"ref": "Acts 2:9", "text": "په غونډه کې ډېر شورماشور او غوغا پیدا شوه او د فریسیانو د ډلې څخه د شریعت یو څو عالمان راپاڅېدل او په کلکه یې وویل: «مونږ په دې سړي کې هېڅ غلطي نه وینو. کېدای شي چې کوم روح یا فرښتې ورسره خبرې کړې وي.»"}, {"ref": "Acts 2:9", "text": "بیا نورو حاضرو یهودیانو هم په پولوس باندې همدا تورونه ولګول او ویې ویل چې د ترتولوس ټولې خبرې رښتیا دي. د فیلیکس په حضور کې د پولوس دفاع"}, {"ref": "Acts 2:9", "text": "خو فستوس غوښتل چې یهودیان خوشحاله کړي، نو د پولوس څخه یې پوښتنه وکړه: «ایا ته غواړې چې اورشلیم ته لاړ شې او د دې تورونو له امله چې درباندې لګېدلي دي په هغه ځای کې زما په حضور کې ستا محاکمه وشي؟»"}, {"ref": "Acts 2:9", "text": "یو وخت ما خپله داسې فکر کاوه هرڅه چې کولای شم باید د ناصري عیسی د نوم سره د مخالفت کولو دپاره یې وکړم."}, {"ref": "Acts 2:9", "text": "هلته مونږ زیات وخت له لاسه ورکړ او زمونږ دپاره نور سفر کول خطرناک ؤ، ځکه چې د کفارې ورځ تېره شوې وه. نو پولوس هغوی ته دا مشوره ورکړه:"}, {"ref": "Acts 2:9", "text": "کله چې دا کار وشو، نو د جزیرې نور ناروغان هم راغلل او روغ شول."}, {"ref": "Acts 2:10", "text": "پولوس لاندې ورښکته شو او خپل ځان یې په هغه ځوان باندې وروغورځاوه او هغه یې په غېږ کې ونیوه او هغوی ته یې وویل: «مه پرېشانه کېږئ، هغه ژوندی دی.»"}, {"ref": "Acts 2:10", "text": "کله چې مونږ څو ورځې هلته وو، نو د یهودیې څخه د اګابوس په نوم یو پیغمبر راغی."}, {"ref": "Acts 2:10", "text": "ما پوښتنه وکړه: ‹څښتنه، زه څه وکړم؟› څښتن راته وویل: ‹پاڅېږه او دمشق ته لاړ شه. کله چې هلته ورسېدلې، نو په هغه ځای کې به د هغو ټولو کارونو په هکله چې ستا دپاره ټاکل شوي دي، درته وویل شي.›"}, {"ref": "Acts 2:10", "text": "دا مخالفت دومره سخت شو چې قوماندان ووېرېده چې هسې نه هغوی پولوس ټوټې ټوټې کړي، نو عسکرو ته یې امر وکړ چې غونډې ته ورننوځي او پولوس په زوره د هغوی له منځ نه راوباسي او نظامي‌قلعه ته یې بوځي."}, {"ref": "Acts 2:10", "text": "والي پولوس ته اشاره وکړه چې خبرې وکړي او پولوس وویل: «زه خبر یم چې ډېر کلونه کیږي تاسو د دې قوم قاضي یئ، نو زه په خوشحالۍ سره ستاسو په مخکې د خپل ځان څخه دفاع کوم."}, {"ref": "Acts 2:10", "text": "پولوس په ځواب کې وویل: «زه همدا‌اوس د امپراتور په محکمه کې یعنې هغه ځای کې چې باید زما قضیه په کې وچلیږي، ولاړ یم. تاسو ته ښه معلومه ده چې ما د یهودیانو په خلاف کوم جرم نه دی کړی."}, {"ref": "Acts 2:10", "text": "ما په اورشلیم کې همداسې وکړل. د مشرانو کاهنانو څخه مې واک او اختیار تر‌لاسه کړ او ډېر ایمانداران مې زندان ته واچول او کله به چې هغوی ته د مرګ سزا ورکول کېدله، نو ما به هم د هغوی په خلاف رایه ورکوله."}, {"ref": "Acts 2:10", "text": "«ای ملګرو، ماته ښکاري چې د دې ځای نه وروسته به زمونږ سفر خطرناک وي. یوازې کشتۍ او د هغې بار ته به لوی تاوان ونه رسیږي بلکې زمونږ ژوند ته به هم خطر وي.»"}, {"ref": "Acts 2:10", "text": "هغوی مونږ ته ډېر سوغاتونه راکړل او کله چې مونږ غوښتل لاړ شو، نو کومو شیانو ته چې په سفر کې مو ورته اړتیا لرله، هغه یې مونږ ته کشتۍ ته راوړل. روم ته د پولوس رسېدل"}, {"ref": "Acts 2:11", "text": "بیا پولوس بېرته بالاخانې ته وخوت، ډوډۍ یې ماته کړه او ویې خوړله. هغه تر لمرخاته پورې د هغوی سره خبرو ته دوام ورکړ او بیا روان شو."}, {"ref": "Acts 2:11", "text": "هغه مونږ ته راغی، د پولوس کمربند یې واخیست او په هغه باندې یې خپل لاسونه او پښې وتړلې او ویې ویل: «روح القدس داسې وایي: ‹په اورشلیم کې به یهودیان د دې کمربند خاوند همدا شان وتړي او غیریهودیانو ته به یې وسپاري.›»"}, {"ref": "Acts 2:11", "text": "زه د هغې سختې رڼا له لاسه ړوند شوی وم، نو ملګرو مې له لاسه ونیولم او دمشق ته یې بوتلم."}, {"ref": "Acts 2:11", "text": "په هماغه شپه څښتن د پولوس په خوا کې ودرېده او ویې ویل: «زړور اوسه! لکه څنګه چې تا په اورشلیم کې زما په هکله شاهدي ورکړه، نو په روم کې هم باید شاهدي ورکړې.» د پولوس په ضد دسیسه"}, {"ref": "Acts 2:11", "text": "تاسو ته به خپله معلومه شي چې د دولسو ورځو څخه زیات وخت نه کیږي چې زه اورشلیم ته د عبادت کولو دپاره تللی وم."}, {"ref": "Acts 2:11", "text": "که چېرې زه مجرم یم او داسې کار مې کړی وي چې د مرګ د سزا لایق یم، نو د مرګ څخه نه تښتم. خو که چېرې هغه تورونه چې د دې یهودیانو له خوا په ما لګېدلي دي رښتیا نه وي، نو هېڅوک حق نه لري چې ما هغوی ته په لاس ورکړي. زه امپراتور ته عرض کوم چې خپله دې زما د قضیې په هکله پرېکړه وکړي.»"}, {"ref": "Acts 2:11", "text": "څو څو ځلې مې هغوی ته په کنیسو کې سزا ورکړې ده او کوښښ مې کاوه چې هغوی دې ته مجبور کړم چې د خپلې عقیدې څخه منکر شي. زما قهر او غضب تر دې حده پورې ورسېده چې حتی هغوی پسې به د نورو هېوادونو ښارونو ته تللم چې هغوی وځوروم. پولوس د خپل ایمان راوړلو په هکله خبرې کوي"}, {"ref": "Acts 2:11", "text": "خو هغه منصبدار د پولوس په ځای د کشتۍ د مشر او د کشتۍ د خاوند خبرو ته زیات غوږ نیوه."}, {"ref": "Acts 2:11", "text": "درې میاشتې وروسته د سکندریې په یوه کشتۍ کې چې د دوه غبرګوني خدایانو کیستر او پولوکس توږل شوې مجسمې ورباندې لګېدلې وې او ژمی یې په هغې جزیرې کې تېر کړی ؤ، لاړو."}, {"ref": "Acts 2:12", "text": "بیا خلکو هغه ځوان خپل کور ته ژوندی بوته او هغوی ډېر ارام شول. د ترواس څخه میلیتوس ته د پولوس سفر"}, {"ref": "Acts 2:12", "text": "کله چې مو دا خبرې واورېدلې، نو مونږ او د هغه ځای خلکو پولوس ته زارۍ وکړې چې اورشلیم ته لاړ نه شي."}, {"ref": "Acts 2:12", "text": "په هغه ښار کې یو سړی اوسېده چې حنانیا نومېده چې یو پرهېزګاره او په شریعت باندې ټینګ ولاړ ؤ او د هغه ځای ټولو یهودیانو د هغه ډېر درناوی کاوه."}, {"ref": "Acts 2:12", "text": "کله چې ورځ شوه، نو ځینې یهودیان سره راټول شول او یوه دسیسه یې جوړه کړه او قسم یې وخوړ چې ترڅو پورې مو پولوس نه وي وژلی، نو نه به څه خورو او نه به څه څښو."}, {"ref": "Acts 2:12", "text": "هېچا زه نه یم لیدلی چې د خدای په کور کې مې د چا سره بحث کړی وي یا مې په کنیسې یا مې د ښار په کوم بل ځای کې خلک راپارولي وي."}, {"ref": "Acts 2:12", "text": "بیا فستوس د خپلو مشاورانو سره د مشورې کولو نه وروسته په ځواب کې وویل: «دا چې تا امپراتور ته عرض کړی دی، نو امپراتور ته به لاړ شې.» پولوس د اګریپاس او برنیکۍ په حضور کې"}, {"ref": "Acts 2:12", "text": "یوه ورځ زه د هغه واک او حکم له مخې چې د مشرانو کاهنانو له خوا راکړل شوی ؤ، د یو کار پسې دمشق ته روان وم."}, {"ref": "Acts 2:12", "text": "څرنګه چې هغه بندر د ژمي تېرولو دپاره مناسب نه ؤ، نو د هغوی څخه زیاتو یې دا پرېکړه وکړه چې له هغه ځای څخه حرکت وکړي او کوښښ وکړي چې فینکاس ته ورسیږي او ژمی هلته تېر کړي. فینکاس په کریت کې یو بندر دی چې جنوب لوېدیځ او شمال لوېدیځ خواته مخامخ دی. په بحیره کې توفان"}, {"ref": "Acts 2:12", "text": "مونږ د سراکیوس ښار ته ورسېدلو او درې ورځې هلته پاتې شولو."}, {"ref": "Acts 2:13", "text": "مونږ مخکې لاړو او په کشتۍ کې کښېناستو او د اسوس ښار ته روان شولو، چېرته چې مونږ غوښتل پولوس هم راسره په کشتۍ کې سپور شي. ځکه چې هغه نیت کړی ؤ چې د وچې لارې نه هغه ځای ته لاړ شي."}, {"ref": "Acts 2:13", "text": "خو پولوس په ځواب کې وویل: «تاسو څه کوئ؟ تاسو ولې ژاړئ او زما زړه ماتوئ؟ زه نه یوازې دې ته تیار یم چې بندي شم، بلکې دې ته هم تیار یم چې د څښتن عیسی په خاطر په اورشلیم کې مړ شم.»"}, {"ref": "Acts 2:13", "text": "هغه راغی، زما په څنګ کې ودرېده او ویې ویل: ‹ای شاووله وروره، سترګې وغړوه.› په هماغه شېبه زه بینا شوم او هغه مې ولیده."}, {"ref": "Acts 2:13", "text": "کومو خلکو چې دا دسیسه جوړه کړې وه، شمېر یې د څلوېښتو تنو څخه زیات ؤ."}, {"ref": "Acts 2:13", "text": "کوم تورونه چې هغوی په ما لګولي دي د هغو په هکله تاسو ته کوم ثبوت نه شي وړاندې کولای."}, {"ref": "Acts 2:13", "text": "څو ورځې وروسته اګریپاس پاچا او د هغه خور برنیکۍ قیصریې ته راغلل چې فستوس ته هرکلی ووایي."}, {"ref": "Acts 2:13", "text": "ای پاچا! کله چې زه د غرمې په وخت کې په لاره روان وم، نو ما یوه رڼا ولیدله چې د لمر څخه هم زیاته روښانه وه او د اسمان څخه راروانه وه او په ما او زما د سفر په ملګرو باندې وځلېدله."}, {"ref": "Acts 2:13", "text": "کله چې د جنوب له خوا نری نری باد راوالوت، نو هغوی فکر وکړ چې خپل مقصد ته ورسېدل. نو هغوی د کشتۍ لنګر راکش کړ او د کریت په غاړه روان شول."}, {"ref": "Acts 2:13", "text": "بیا د هغه ځای څخه په کشتۍ کې روان شولو او د ریغیون ښار ته ورسېدلو. بیا یوه ورځ وروسته جنوبي بادونه پیل شول او په دوو ورځو کې د پوتیولي بندر ته ورسېدلو."}, {"ref": "Acts 2:14", "text": "کله چې پولوس په اسوس کې زمونږ سره مخامخ شو، نو هغه مو په کشتۍ کې سپور کړ او میتیلینې ته راغلو."}, {"ref": "Acts 2:14", "text": "مونږ ونه شو کولای چې هغه ته قناعت ورکړو، نو غلي شولو او ومو ویل: «څه چې د څښتن رضا وي هماغسې دې وشي.»"}, {"ref": "Acts 2:14", "text": "هغه وویل: ‹زمونږ د نیکونو خدای ته د دې دپاره غوره کړی یې چې د هغه رضا وپېژنې، د هغه نېک خدمتګار ووینې او د هغه اواز د هغه د خپلې خولې څخه واورې."}, {"ref": "Acts 2:14", "text": "بیا هغوی مشرانو کاهنانو او د قوم مشرانو ته ورغلل او ویې ویل: «مونږ قسم خوړلی دی تر هغې پورې چې پولوس مو نه وي وژلی، نو مونږ به هېڅ شی ونه خورو."}, {"ref": "Acts 2:14", "text": "خو زه ستاسو په حضور کې اقرار کوم چې زه د خپلو نیکونو د خدای په عبادت کولو کې د څښتن عیسی د لارې څخه پیروي کوم چې هغوی یې غلطه بولي. زه په هغو ټولو شیانو چې د موسی په شریعت او د پیغمبرانو په کتابونو کې لیکل شوي دي، عقیده لرم."}, {"ref": "Acts 2:14", "text": "هغوی د څو ورځو دپاره هلته پاتې شول، نو فستوس د پولوس قضیه پاچا ته وړاندې کړه او ویې ویل: «دلته یو سړی دی چې فیلیکس په زندان کې پریښی دی."}, {"ref": "Acts 2:14", "text": "مونږ ټول په ځمکه باندې راولوېدلو. بیا مې په عبراني ژبه کې یو اواز واورېد چې ماته یې وویل: ‹ای شاووله، ای شاووله، ته ولې ما ځوروې؟ دا یو بې‌ګټې کار دی چې د خپل بادار په وړاندې ودرېږې.›"}, {"ref": "Acts 2:14", "text": "خو ډېر وخت نه ؤ تېر شوی چې یو توفاني باد چې د «شمال ختیځ» د باد په نوم یادیږي، د جزیرې څخه زمونږ خواته راوالوت."}, {"ref": "Acts 2:14", "text": "په هغه ځای کې مونږ ځینې ایمانداران ولیدل او هغوی زمونږ څخه وغوښتل چې د یوې هفتې دپاره ورسره پاتې شو. په دې ډول مونږ روم ته ورسېدلو."}, {"ref": "Acts 2:15", "text": "د هغه ځای څخه په کشتۍ کې روان شو او په بله ورځ د خیوس جزیرې ته ورسېدلو. بله ورځ ساموس ته راغلو او د هغې ورځې په سبا میلیتوس ته ورسېدلو."}, {"ref": "Acts 2:15", "text": "څو ورځې وروسته مونږ سفر ته تیاری ونیوه او اورشلیم ته روان شولو."}, {"ref": "Acts 2:15", "text": "ځکه چې ته به د ټولو خلکو دپاره د هغه شاهد اوسې او څه چې دې لیدلي او اورېدلي دي، د هغو شاهدي به ورکوې."}, {"ref": "Acts 2:15", "text": "نو اوس تاسو او د شورا غړي په دې بهانه چې غواړئ د هغه په هکله سم معلومات تر‌لاسه کړئ، د قوماندان څخه وغواړئ چې پولوس تاسو ته راولي. مونږ دې ته تیار یو چې دلته د رارسېدلو څخه مخکې هغه مړ کړو.»"}, {"ref": "Acts 2:15", "text": "زه خدای ته همداسې هیله لرم چې دوی یې لري او هغه دا چې نېک او بد خلک به دواړه د قیامت په ورځ له مړو نه راژوندي کیږي."}, {"ref": "Acts 2:15", "text": "کله چې زه اورشلیم ته لاړم، نو د مشرانو کاهنانو او نورو یهودي مشرانو په هغه باندې تورونه ولګول او زما څخه یې وغوښتل چې هغه ته سزا ورکړم."}, {"ref": "Acts 2:15", "text": "ما پوښتنه وکړه: ‹ای څښتنه، ته څوک یې؟› او څښتن وویل: ‹زه عیسی یم، یعنې هغه څوک چې ته یې ځوروې."}, {"ref": "Acts 2:15", "text": "کشتۍ په توفان کې راګېره شوه او د دې امکان نه ؤ چې د باد مخالف طرف ته لاړه شي، نو مونږ نوره هڅه ونه کړه او پرې مو ښودله چې کوم طرف ته چې باد لګیږي هماغې خواته کشتۍ بوځي."}, {"ref": "Acts 2:15", "text": "کله چې د روم ایمانداران زمونږ د راتللو څخه خبر شول، نو هغوی د اپیاس تر بازاره او هغه ځای پورې چې د درې مېلمستونونو په نوم یادېده، زمونږ لیدلو ته راغلل. کله چې پولوس هغوی ولیدل، نو د خدای شکر یې وویست او زړور شو."}, {"ref": "Acts 2:16", "text": "ځکه چې پولوس پرېکړه کړې وه چې په کشتۍ کې د افسیس څخه تېر شي، ترڅو د اسیا په ولایت کې د وخت د ضایع کېدلو څخه مخنیوی وشي. هغه بیړه کوله چې که چېرې امکان ولري د پنتیکاست د ورځې نه مخکې اورشلیم ته ورسیږي. د افسیس د کلیسا د مشرانو سره د پولوس خدای پاماني"}, {"ref": "Acts 2:16", "text": "د قیصریې څو شاګردان زمونږ سره ملګري شول او مونږ یې د مناسون کور ته چې د قبرس څخه ؤ او د لومړنیو ایماندارانو څخه ؤ، د اوسېدلو دپاره بوتلو. د یعقوب او د کلیسا د مشرانو سره د پولوس لیدنه"}, {"ref": "Acts 2:16", "text": "اوس څه شي ته انتظار کوې؟ پاڅېږه، د تعمید غسل واخله او څښتن ته دعا وکړه چې ګناهونه دې وبخښل شي.›"}, {"ref": "Acts 2:16", "text": "خو د پولوس د خور زوی د دې دسیسې څخه خبر شو او نظامي‌قلعه ته لاړ او پولوس یې خبر کړ."}, {"ref": "Acts 2:16", "text": "نو زه تل کوښښ کوم چې د خدای او انسانانو په حضور کې پاک وجدان ولرم."}, {"ref": "Acts 2:16", "text": "خو ما هغوی ته ځواب ورکړ چې دا د رومیانو دود او دستور نه دی چې یو تورن سړی دې خپلو مدعیانو ته په لاس ورکړي، تر هغې چې هغه د خپلو مدعیانو سره مخامخ نه کړي او هغه ته دا موقعه ورنه کړي چې د لګول شویو تورونو په وړاندې د خپل ځان څخه دفاع وکړي."}, {"ref": "Acts 2:16", "text": "خو اوس پاڅېږه او په خپلو پښو ودرېږه. زه تاته د دې دپاره راښکاره شوم چې تا خپل خدمتګار وټاکم او څه چې دې زما څخه ولیدل او هغه څه چې په راتلونکې کې به یې درته وښایم د هغو په هکله به شاهدي ورکړې."}, {"ref": "Acts 2:16", "text": "مونږ د کاودا په نوم د یوې کوچنۍ جزیرې طرف ته چې د باد څخه پناه وه، روان شولو. په ډېرې سختۍ سره مو وکولای شول چې هغه کوچنۍ کشتۍ خوندي وساتو."}, {"ref": "Acts 2:16", "text": "کله چې مونږ روم ته ورسېدلو، نو پولوس ته اجازه ورکړل شوه چې د یو رومي عسکر سره چې د هغه ساتنه یې کوله، په یو شخصي کور کې واوسیږي. پولوس په روم کې وعظ کوي"}, {"ref": "Acts 2:17", "text": "پولوس د میلیتوس څخه افسیس ته پیغام ولېږه او د کلیسا د مشرانو څخه یې وغوښتل چې راشي او د هغه سره وویني."}, {"ref": "Acts 2:17", "text": "کله چې مونږ اورشلیم ته ورسېدلو، نو ایماندارانو مونږ ته تود هرکلی ووایه."}, {"ref": "Acts 2:17", "text": "کله چې زه بېرته اورشلیم ته راغلم او د خدای په کور کې مې دعا کوله، نو رویا مې ولیدله."}, {"ref": "Acts 2:17", "text": "بیا پولوس یو منصبدار راوغوښت او ورته ویې ویل: «دا ځوان سړی قوماندان ته بوځه، ځکه هغه غواړي چې قوماندان ته کوم څه ووایي.»"}, {"ref": "Acts 2:17", "text": "وروسته له څو کلونو زه اورشلیم ته راغلم چې خپل قوم ته خیرات یوسم او قرباني وکړم."}, {"ref": "Acts 2:17", "text": "کله چې هغوی دلته راغلل، نو ځنډ مې ونه کړ او په بله ورځ په محکمه کې کښېناستم او امر مې وکړ چې هغه راولي."}, {"ref": "Acts 2:17", "text": "زه به تا د اسراییلو د قوم او غیریهودیانو څخه وژغورم. زه تا هغوی ته لېږم"}, {"ref": "Acts 2:17", "text": "هغه کوچنۍ کشتۍ یې لویې کشتۍ ته وخېژوله او لویه کشتۍ یې ګردچاپېره په رسیو باندې وتړله. هغوی وېرېدل چې د سیرتیس په شګو کې به ونښلي. هغوی د کشتۍ لنګر راښکته کړ او کشتۍ یې پرېښودله چې باد یې بوځي."}, {"ref": "Acts 2:17", "text": "درې ورځې وروسته پولوس د هغه ځای د یهودیانو مشران غونډې ته راوغوښتل. کله چې هغوی سره راټول شول، نو ورته ویې ویل: «ای زما ورونو، که څه هم ما د خپلو خلکو او د خپلو نیکونو د دودونو او دستورونو په خلاف کوم کار نه دی کړی، خو بیاهم زه په اورشلیم کې بندي شوم او رومیانو ته وسپارل شوم."}, {"ref": "Acts 2:18", "text": "کله چې هغوی راورسېدل، نو هغه ورته وویل: «تاسو ته معلومه ده چې د هماغې لومړۍ ورځې څخه چې زه د اسیا ولایت ته راورسېدم او څومره وخت چې ستاسو سره وم، نو تاسو سره مې څنګه ژوند تېر کړ."}, {"ref": "Acts 2:18", "text": "بله ورځ پولوس زمونږ سره د یعقوب د لیدلو دپاره لاړ او د کلیسا ټول مشران هم په هغه ځای کې حاضر وو."}, {"ref": "Acts 2:18", "text": "په دې رویا کې مې څښتن ولیده چې راته ویل یې: ‹زر شه او سمدلاسه د اورشلیم څخه لاړ شه، ځکه چې د دې ښار خلک به زما په هکله ستا شاهدي ونه مني.›"}, {"ref": "Acts 2:18", "text": "نو منصبدار هغه ځوان سړی قوماندان ته بوته او ورته ویې ویل: «زنداني شوي پولوس زه راوغوښتلم او زما څخه یې وغوښتل چې دا ځوان تاسو ته راولم، ځکه چې هغه غواړي تاسو ته څه ووایي.»"}, {"ref": "Acts 2:18", "text": "زه د خدای په کور کې د پاکوالي د مراسمو د سرته رسولو څخه وروسته هغوی ولیدم. هلته نه د خلکو ګڼه‌ګوڼه او نه کومه شور او غوغا وه."}, {"ref": "Acts 2:18", "text": "کله چې د هغه مدعیان پاڅېدل چې خبرې وکړي، هغوی ونه شو کولای چې هغه په هغو جرمونو باندې چې زما په خیال کې هم نه وو، ملامته کړي."}, {"ref": "Acts 2:18", "text": "چې د هغوی سترګې خلاصې کړې، ترڅو هغوی د تیارې څخه رڼا ته او د شیطان د واکمنۍ څخه یې د خدای خواته راواړوې، ترڅو په ما باندې د ایمان راوړلو په وسیله د هغوی ګناهونه وبخښل شي او د خدای په سپېڅلو خلکو کې شامل شي.› پولوس د خپلو خدمتونو په هکله خبرې کوي"}, {"ref": "Acts 2:18", "text": "په بله ورځ چې ډېر سخت توفان ؤ، نو هغوی د کشتۍ یو څه بار اوبو ته وغورځاوه."}, {"ref": "Acts 2:18", "text": "کله چې رومیانو زما څخه څېړنې وکړې نو غوښتل یې چې ما ازاد کړي، ځکه هغوی پوه شول چې ما داسې کوم کار نه دی کړی چې د مرګ سزا دې راته راکړل شي."}, {"ref": "Acts 2:19", "text": "که څه هم د یهودیانو د دسیسو له امله په ما سختې ورځې راغلې، خو ما په پوره عاجزۍ او اوښکو تویولو سره د څښتن خدمت کړی دی."}, {"ref": "Acts 2:19", "text": "پولوس په هغوی باندې سلام واچاوه او هغوی ته یې د هغو کارونو په هکله پوره راپور ورکړ چې خدای د هغه په وسیله په غیریهودیانو کې کړي وو."}, {"ref": "Acts 2:19", "text": "ما وویل: ‹څښتنه، هغوی په دې ښه پوهیږي چې زه هغه سړی یم چې ستا ایمانداران به مې زندان ته اچول او په هرې کنیسې کې به مې وهل."}, {"ref": "Acts 2:19", "text": "قوماندان هغه له لاسه ونیو او یو ګوښه ځای ته یې بوته او پوښتنه یې ترې وکړه: «ته څه غواړې چې ماته یې ووایې؟»"}, {"ref": "Acts 2:19", "text": "خو د اسیا د ولایت ځینې یهودیان چې هلته موجود وو، باید په خپله دلته حاضر شي او که زما په خلاف کوم څه لري، نو خپل تورونه دې وړاندې کړي."}, {"ref": "Acts 2:19", "text": "هغوی د خپل دین او د یو سړي په هکله چې عیسی نومیږي او مړ شوی دی، د نظر اختلاف درلود او پولوس دعوه کوي چې هغه ژوندی دی."}, {"ref": "Acts 2:19", "text": "نو ای پاچا! ما د هغه حکم څخه چې په اسماني رویا کې راته وشو، سرغړونه نه ده کړې."}, {"ref": "Acts 2:19", "text": "خو په درېمه ورځ یې د کشتۍ سامان په خپلو لاسونو بحیرې ته وغورځاوه."}, {"ref": "Acts 2:19", "text": "خو کله چې د یهودیانو مشرانو مخالفت وکړ، نو زه دې ته مجبور شوم چې امپراتور ته عرض وکړم. بې له شکه ما سره هېڅ داسې څه نشته چې د خپل قوم په خلاف یې ووایم."}, {"ref": "Acts 2:20", "text": "تاسو ته معلومه ده چې ما ستاسو د ښېګڼې دپاره د هېڅ شي څخه ډډه نه ده کړې او تاسو ته مې د خلکو په مخکې او کور په کور تعلیم درکړی دی."}, {"ref": "Acts 2:20", "text": "کله چې هغوی دا واورېدل، نو د خدای ثنا یې وویله. بیا هغوی پولوس ته وویل: «ای وروره، ته وینې چې په یهودیانو کې په زرګونو خلکو ایمان راوړی دی او هغوی د موسی په شریعت باندې ټینګ ولاړ دي."}, {"ref": "Acts 2:20", "text": "کله چې ستا شاهد استیفان ووژل شو، نو زه هلته ولاړ وم او په دې کار کې ورسره زما رضا وه او د هغه د قاتلانو د چپنو ساتنه مې کوله.›"}, {"ref": "Acts 2:20", "text": "هغه وویل: «ځینو یهودیانو دسیسه جوړه کړې چې ستاسو څخه وغواړي چې پولوس سبا شورا ته بوځئ. هغوی به داسې یوه بهانه وکړي چې غواړي د هغه په هکله سم معلومات تر‌لاسه کړي."}, {"ref": "Acts 2:20", "text": "یا پرېږدئ چې په خپله دا خلک ووایي کله چې زه د شورا په مخکې ولاړ وم په ما کې کوم جرم پیدا کړ،"}, {"ref": "Acts 2:20", "text": "زه زړه نازړه وم چې څنګه د دې موضوع په هکله څېړنه وکړم، نو د پولوس څخه مې پوښتنه وکړه چې ایا ته غواړې چې اورشلیم ته لاړ شې او هلته دې قضیه وڅېړل شي."}, {"ref": "Acts 2:20", "text": "ما لومړی په دمشق او اورشلیم کې او بیا په ټوله یهودیه کې او همدارنګه غیریهودیانو ته مې اعلان وکړ چې د خپلو ګناهونو څخه توبه وباسي، د خدای خواته راوګرځي او داسې کارونه وکړي چې ثابته کړي چې هغوی توبه ویستلې ده."}, {"ref": "Acts 2:20", "text": "تر ډېرو ورځو پورې مونږ نه لمر ولیده او نه ستوري او سخت باد لګېده او نور زمونږ د خلاصون هېڅ هیله نه وه."}, {"ref": "Acts 2:20", "text": "نو له دې امله مې راوغوښتلئ چې تاسو ووینم او خبرې درسره وکړم چې زه د هغه چا په خاطر په زولنو تړل شوی یم چې د اسراییلو خلک ورته هیله‌مند دي.»"}, {"ref": "Acts 2:21", "text": "ما یهودیانو او غیریهودیانو دواړو ته په کلکه خبرداری ورکړ چې باید د خپلو ګناهونو څخه توبه وباسي او خدای ته رجوع وکړي او زمونږ په څښتن عیسی ایمان راوړي."}, {"ref": "Acts 2:21", "text": "هغوی ته ستا په هکله ویل شوي دي چې ته هغو یهودیانو ته چې د غیریهودیانو په هېوادونو کې اوسیږي، تعلیم ورکوې چې د موسی شریعت پرېږدي. همدارنګه هغوی ته وایې چې خپل اولادونه مه سنتوئ او د یهودیانو د رواجونو څخه پیروي مه کوئ."}, {"ref": "Acts 2:21", "text": "نو څښتن راته وویل: ‹لاړ شه، ځکه چې زه تا د لېرې ځایونو غیریهودیانو ته لېږم.›» پولوس رسول او رومي قوماندان"}, {"ref": "Acts 2:21", "text": "خو د هغوی خبرو ته غوږ مه نیسه، ځکه چې تر څلوېښتو زیات کسان هغه ته په کمین کې ناست دي او قسم یې خوړلی، ترڅو پورې یې چې پولوس مړ کړی نه وي، نو هغوی به نه څه خوري او نه به څه څښي. هغوی همدا‌اوس دې کار ته تیار دي او ستا ځواب ته انتظار وباسي.»"}, {"ref": "Acts 2:21", "text": "بې له یو شي چې کله زه د هغوی په مخکې ولاړ وم او په لوړ اواز مې وویل: ‹زه نن له دې امله محاکمه کېږم چې په دې عقیده یم چې مړي به بیا راژوندي کیږي.›»"}, {"ref": "Acts 2:21", "text": "خو پولوس غوښتنه وکړه تر هغې پورې چې امپراتور د هغه د قضیې په هکله خپله پرېکړه نه وي کړې، هغه دې تر نظارت لاندې وساتل شي. نو ما امر وکړ، ترڅو پورې چې هغه امپراتور ته لېږم هغه دې بندي وساتل شي.»"}, {"ref": "Acts 2:21", "text": "له همدې امله ځینو یهودیانو زه د خدای په کور کې ونیولم او کوښښ یې کاوه چې ما ووژني."}, {"ref": "Acts 2:21", "text": "په کشتۍ کې ناستو خلکو تر ډېره وخته پورې هېڅ شی نه وو خوړلي، نو پولوس د هغوی په مخکې ودرېده او ویې ویل: «ای ملګرو، تاسو باید زما خبره منلې وای او د کریت څخه مو حرکت نه وای کړی، نو د دې زیان او تاوان څخه به ساتل شوي وای."}, {"ref": "Acts 2:21", "text": "یهودي مشرانو ځواب ورکړ: «مونږ ته ستا په هکله له یهودیې څخه کوم لیک نه دی رارسېدلی او نه زمونږ د یهودي ورونو څخه کوم څوک دلته راغلی دی چې ستا په هکله یې مونږ ته خبر راوړی وي او یا یې ستا په هکله کومه بده خبره کړې وي."}, {"ref": "Acts 2:22", "text": "زه اوس د روح القدس څخه په اطاعت کولو سره اورشلیم ته روان یم، خو نه پوهېږم چې هلته به زما سره څه کیږي."}, {"ref": "Acts 2:22", "text": "هغوی خامخا ستاسو د راتللو څخه خبریږي، نو بیا څه وکړو؟"}, {"ref": "Acts 2:22", "text": "خلکو تر دې ځای پورې د پولوس خبرو ته غوږ ونیوه، خو هغوی چیغې پیل کړې: «داسې سړی د دې نړۍ څخه ورک کړئ! هغه د دې لایق نه دی چې ژوندی پاتې شي.»"}, {"ref": "Acts 2:22", "text": "نو قوماندان هغه ځوان رخصت کړ او هغه ته یې حکم وکړ: «څه چې دې ماته وویل هغه هېچا ته ونه وایې.» پولوس فیلیکس والي ته لېږل کیږي"}, {"ref": "Acts 2:22", "text": "خو فیلیکس چې د څښتن عیسی د لارې نه ښه خبر ؤ، نو محاکمه یې وځنډوله او ویې ویل: «کله چې لیسیاس قوماندان راورسېده، نو بیا به زه ستاسو د دعوې په هکله خپله پرېکړه وکړم.»"}, {"ref": "Acts 2:22", "text": "اګریپاس فستوس ته وویل: «زه غواړم چې په خپله د دې سړي خبرې واورم.» فستوس ځواب ورکړ: «سبا به د هغه خبرې واورې.»"}, {"ref": "Acts 2:22", "text": "خو تر نن ورځې پورې خدای وساتلم او دلته ولاړ یم او ټولو لویو او وړو ته شاهدي ورکوم. زه یوازې هغه څه وایم چې موسی او نورو پیغمبرانو ویلي دي چې پېښ به شي،"}, {"ref": "Acts 2:22", "text": "خو اوس تاسو ته مشوره درکوم چې زړور اوسئ! په تاسو کې به هېڅوک هم خپل ژوند له لاسه ورنه کړي، خو کشتۍ به ټوټې ټوټې شي،"}, {"ref": "Acts 2:22", "text": "خو مونږ غواړو چې ستا نظر واورو، ځکه مونږ پوهېږو چې خلک په هرځای کې د دې ډلې په خلاف خبرې کوي.»"}, {"ref": "Acts 2:23", "text": "زه یوازې په دې پوهېږم چې روح القدس په هر ښار کې ما خبروي چې زندان او تکلیفونه زما په انتظار کې دي."}, {"ref": "Acts 2:23", "text": "بیا هرڅه چې مونږ درته وایو هماغسې وکړه. دلته څلور کسان دي چې نذر یې منلی دی."}, {"ref": "Acts 2:23", "text": "هغوی چیغې وهلې، خپل څادرونه یې له ځمکې وهل او خاورې یې پورته بادولې."}, {"ref": "Acts 2:23", "text": "بیا قوماندان خپل دوه تنه منصبداران راوغوښتل او هغوی ته یې وویل: «دوه سوه پیاده او اویا تنه سپاره عسکر او دوه سوه نېزه لرونکي تیار کړئ چې نن شپه نهه بجې قیصریې ته لاړ شي."}, {"ref": "Acts 2:23", "text": "هغه یو منصبدار ته امر وکړ چې پولوس تر نظارت لاندې ونیسي او هغه ته لږ څه ازادي ورکړي او د هغه ملګرو ته چې د هغه د اړتیاوو د پوره کولو دپاره ځي او راځي، اجازه ورکړي. پولوس د فیلیکس او دروسیلې په حضور کې"}, {"ref": "Acts 2:23", "text": "په بله ورځ اګریپاس او برنیکۍ په زیات شان او شوکت سره راغلل او د قوماندانانو او د ښار د مشرانو سره دربار ته ننوتل. بیا فستوس امر وکړ او پولوس یې حاضر کړ."}, {"ref": "Acts 2:23", "text": "یعنې دا چې مسیح باید کړاوونه وزغمي او لومړنی کس به وي چې د مړو څخه به راژوندی شي او یهودیانو او غیریهودیانو دواړو ته به د خلاصون د رڼا اعلان وکړي.» پولوس اګریپاس ته د مسیحیت بلنه ورکوي"}, {"ref": "Acts 2:23", "text": "ځکه چې پرون شپه د هغه خدای فرښته چې زه د هغه یم او د هغه عبادت کوم، ماته راغله او زما په څنګ کې ودرېدله"}, {"ref": "Acts 2:23", "text": "نو هغوی د پولوس سره یوه ورځ وټاکله او ډېر خلک د هغه کور ته راغلل. د سهار نه تر ماښامه پورې پولوس د هغوی سره د خدای د پاچاهۍ په هکله خپل پیغام بیان کړ او شاهدي یې ورکړه او کوښښ یې وکړ چې د موسی د شریعت او د پیغمبرانو له کتابونو څخه په کار اخیستلو سره هغوی د عیسی په هکله قانع کړي."}, {"ref": "Acts 2:24", "text": "خو زه د خپل ژوند هېڅ پروا نه لرم او هغه ماته کوم ارزښت نه لري. زه یوازې دا غواړم چې خپله وظیفه سرته ورسوم کومه چې څښتن عیسی راته سپارلې ده، هغه تر‌سره کړم چې هغه د خدای د فضل په هکله د خلکو خبرول دي."}, {"ref": "Acts 2:24", "text": "د هغوی سره لاړ شه او په ګډه ورسره د پاکوالي مراسم په ځای کړه او هغوی ته پیسې ورکړه چې خپل سرونه وخرایي. نو په دې ډول به هغوی ټول په دې پوه شي څه چې ستا په هکله ویل شوي وو هغه رښتیا نه دي، بلکې ته په خپله هم د موسی د شریعت سره سم خپل ژوند تېروې."}, {"ref": "Acts 2:24", "text": "رومي قوماندان امر وکړ چې پولوس دننه نظامي‌قلعه ته بوځئ او په دورو یې ووهئ او پوښتنه ترې وکړئ، ترڅو دا معلومه شي چې خلک ولې د هغه په خلاف داسې چیغې وهي."}, {"ref": "Acts 2:24", "text": "د پولوس دپاره هم یو څو اسونه تیار کړئ چې ورباندې سپور شي او روغ رمټ یې فیلیکس والي ته ورسوئ.»"}, {"ref": "Acts 2:24", "text": "څو ورځې وروسته فیلیکس د خپلې ښځې دروسیلې سره چې یهودۍ وه، راغی. هغه پولوس راوغوښت او د هغه خبرې یې چې په عیسی مسیح باندې د ایمان راوړلو په هکله کولې، واورېدلې."}, {"ref": "Acts 2:24", "text": "بیا فستوس وویل: «ای اګریپاس پاچا او ټولو حاضرینو! تاسو دا سړی وینئ چې ټولو یهودیانو که دلته دي او که په اورشلیم کې دي، ورڅخه ماته شکایت کړی دی. هغوی چیغې وهلې چې دا سړی باید ژوندی پاتې نه شي."}, {"ref": "Acts 2:24", "text": "پولوس لا د خپل ځان څخه د دفاع په خاطر خبرې کولې چې فستوس چیغې کړې: «ای پولوسه، ته لېونی یې! په ډېرو لوستلو لېونی شوی یې.»"}, {"ref": "Acts 2:24", "text": "او ویې ویل: ‹پولوسه! مه وېرېږه، ځکه چې ته باید د امپراتور په مخکې ودرېږې او خدای به په خپل فضل سره ستا په خاطر د هغو ټولو کسانو ژوند چې تا سره په کشتۍ کې دي، وژغوري.›"}, {"ref": "Acts 2:24", "text": "ځینې د هغه په خبرو قانع شول، خو نورو ورباندې باور ونه کړ."}, {"ref": "Acts 2:25", "text": "زه ستاسو ټولو په منځ کې ګرځېدلی یم او د خدای د پاچاهۍ په هکله مې وعظ کړی دی. اوس پوهېږم چې ستاسو څخه به یو کس هم نور زما مخ ونه ویني."}, {"ref": "Acts 2:25", "text": "خو د هغو غیریهودیانو په هکله چې ایمانداران شوي دي، مونږ هغوی ته خپله پرېکړه په لیکلې توګه لېږلې ده چې هغوی باید د هغو خوړو څخه چې بتانو ته وړاندې کیږي، د وینې د خوړلو څخه، د هغه حیوان د غوښې د خوړلو څخه چې زندۍ شوی وي او د جنسي بد‌اخلاقۍ څخه خپل ځانونه وساتي.»"}, {"ref": "Acts 2:25", "text": "خو کله چې هغوی پولوس وتاړه چې په دورو یې ووهي، نو پولوس د هغه منصبدار څخه چې په هغه ځای کې ولاړ ؤ، پوښتنه وکړه: «ایا تاسو ته قانون دا اجازه درکوي چې یو رومي سړی چې جرم هم ورباندې ثابت شوی نه وي، ووهئ؟»"}, {"ref": "Acts 2:25", "text": "بیا قوماندان هغه ته یو لیک ولیکه چې په کې داسې لیکل شوي وو:"}, {"ref": "Acts 2:25", "text": "خو کله چې پولوس د عدالت، په خپل نفس باندې د واک لرلو او د قیامت د ورځې په هکله خبرې کولې، نو فیلیکس ووېرېده او ویې ویل: «د اوس دپاره همدومره بس دی. کله چې یو مناسب وخت پیدا شو بیا به دې راوغواړم.»"}, {"ref": "Acts 2:25", "text": "خو زما په نظر هغه کوم داسې کار نه دی کړی چې د مرګ سزا دې ورکړای شي. څرنګه چې هغه خپله عرض وکړ چې امپراتور دې د هغه د قضیې په هکله پرېکړه وکړي، نو ما پرېکړه وکړه چې هغه روم ته ولېږم."}, {"ref": "Acts 2:25", "text": "پولوس په ځواب کې وویل: «نه ښاغلیه! زه لېونی نه یم. زه په هوش یم او رښتیا او معقولې خبرې کوم."}, {"ref": "Acts 2:25", "text": "نو ای خلکو، زړور اوسئ! ځکه چې زه په خدای ایمان لرم. لکه څنګه چې ماته ویل شوي دي، همداسې به وشي."}, {"ref": "Acts 2:25", "text": "هغوی په خپل منځ کې سره بې‌اتفاقه شول او روان شول. خو له تګ څخه مخکې پولوس دا خبره وکړه: «روح القدس د اشعیا نبي په وسیله ستاسو نیکونو ته څنګه ښه ویلي دي:"}, {"ref": "Acts 2:26", "text": "نو له دې امله زه همدا‌نن تاسو خبروم چې که ستاسو څخه کوم څوک د تلپاتې ژوندون څخه بې‌برخې شي، نو زه به یې مسوول نه یم،"}, {"ref": "Acts 2:26", "text": "نو بله ورځ پولوس هغه څلور تنه د ځان سره بوتلل او د هغوی سره یې د پاکوالي مراسم سرته ورسول. بیا هغه د خدای کور ته لاړ چې هغوی ته خبر ورکړي چې په څو ورځو کې به د پاکوالي مراسم پوره کیږي او له هغې وروسته به د هر یو دپاره قرباني وړاندې کړای شي. پولوس د خدای په کور کې نیول کیږي"}, {"ref": "Acts 2:26", "text": "کله چې هغه منصبدار دا خبره واورېدله، نو قوماندان ته ورغی او پوښتنه یې ترې وکړه: «ته پوهېږې چې څه کوې؟ دا سړی خو رومي دی.»"}, {"ref": "Acts 2:26", "text": "«د کلودیوس لیسیاس له خوا دې ښاغلي فیلیکس والي ته سلام وي."}, {"ref": "Acts 2:26", "text": "په همدې وخت کې هغه په دې هیله ؤ چې پولوس به ورته رشوت ورکړي او له همدې امله به یې هغه هر وخت راغوښته او خبرې به یې ورسره کولې."}, {"ref": "Acts 2:26", "text": "خو د هغه په هکله زما سره کوم ځانګړی څه شی نشته چې امپراتور ته یې ولیکم. نو هغه مې تاسو ټولو او په ځانګړې توګه ستاسې اګریپاس پاچا حضور ته راوست، ترڅو د هغه د قضیې تر څېړلو وروسته وکولای شم هغه ته یو څه ولیکم."}, {"ref": "Acts 2:26", "text": "پاچا په دې ښه خبر دی او زه د هغه سره په زړورتیا سره خبرې کوم. زه په دې باندې ډاډه یم چې دا ټولې پېښې تاسو ته معلومې دي، ځکه چې هغه په کوم پټ ځای کې نه دي شوې."}, {"ref": "Acts 2:26", "text": "خو مونږ به د جزیرې په غاړه وغورځول شو.»"}, {"ref": "Acts 2:26", "text": "دې قوم ته ورشه او ورته ووایه: تاسو به بیا بیا اورئ، خو پوه به نه شئ. تاسو به ګورئ، خو څه به نه وینئ،"}, {"ref": "Acts 2:27", "text": "ځکه چې ما تاسو ته هغه ټول شیان وویل چې خدای یې غواړي."}, {"ref": "Acts 2:27", "text": "د پاکوالي د مراسمو اووه ورځنۍ دوره لا پای ته نه وه رسېدلې چې د اسیا د ولایت ځینو یهودیانو پولوس د خدای په کور کې ولیده. هغوی خلک ولمسول او پولوس یې ونیوه"}, {"ref": "Acts 2:27", "text": "نو قوماندان پولوس ته ورغی او پوښتنه یې ترې وکړه: «ماته ووایه چې ته رومي یې؟» پولوس ځواب ورکړ: «هو.»"}, {"ref": "Acts 2:27", "text": "دا سړی یهودیانو نیولی ؤ او نژدې ؤ چې وژلی یې وای. خو کله چې زه خبر شوم هغه یو رومي دی، نو د خپلو عسکرو سره ورغلم او هغه مې ترې خلاص کړ."}, {"ref": "Acts 2:27", "text": "کله چې دوه کاله تېر شول، نو پورکیوس فستوس د فیلیکس په ځای والي وټاکل شو. فیلیکس د یهودیانو د خوشحالولو دپاره پولوس په زندان کې پرېښود."}, {"ref": "Acts 2:27", "text": "ځکه چې زما په نظر دا خبره سمه نه ده چې یو بندي بې له کومو ښکاره تورونو امپراتور ته ولېږم.»"}, {"ref": "Acts 2:27", "text": "ای پاچا! ایا تاسو په پیغمبرانو باندې عقیده لرئ؟ زه پوهېږم چې تاسو ورباندې عقیده لرئ.»"}, {"ref": "Acts 2:27", "text": "دا څوارلسمه شپه وه چې مونږ د مدیترانې په بحیره کې د توفان له امله یوې خوا او بلې خواته وړل کېدلو. خو نژدې نیمه شپه وه چې کشتیوانانو دا ګومان وکړ چې وچې ته ورنژدې کیږي."}, {"ref": "Acts 2:27", "text": "ځکه چې د دې خلکو زړونه سخت شوي دي او په غوږونو درانه شوي او سترګې یې پټې شوې دي. که نه، نو سترګو به یې لیدل، غوږونو به یې اورېدل، په زړونو کې به پوهېدل او ماته به بېرته راګرځېدلي وای او ما به شفا ورکړې وای."}, {"ref": "Acts 2:28", "text": "په خپلو ځانونو او هغو ټولو خلکو باندې پام کوئ چې روح القدس تاسو د هغو د ساتنې دپاره ټاکلي یئ. د خدای په کلیسا باندې چې عیسی د خپلې وینې په بیه اخیستې ده، داسې پام کوئ لکه څنګه چې شپانه په خپلو رمو پام کوي."}, {"ref": "Acts 2:28", "text": "او چیغې یې ووهلې: «ای د اسراییلو خلکو، مرسته وکړئ او د دې سړي په خلاف زمونږ سره یوځای شئ. دا هغه سړی دی چې هر‌چېرته ځي او زمونږ د قوم، د موسی د شریعت او د خدای د کور په ضد هرچا ته تعلیم ورکوي. برسېره پر‌دې هغه یونانیان هم د خدای کور ته راوستلي دي او دا سپېڅلی ځای یې ورباندې ناپاکه کړی دی.»"}, {"ref": "Acts 2:28", "text": "قوماندان وویل: «ما په ډېره لوړه بیه دا تابعیت حاصل کړی دی.» پولوس ورته وویل: «خو زه رومي یم، ځکه چې مور او پلار مې رومیان دي.»"}, {"ref": "Acts 2:28", "text": "ما غوښتل په دې پوه شم چې هغوی پرې ولې تور لګولی دی، نو هغه مې د هغوی شورا ته بوته."}, {"ref": "Acts 2:28", "text": "اګریپاس پولوس ته وویل: «ته فکر کوې چې دومره زر به ما مسیحي کړې؟»"}, {"ref": "Acts 2:28", "text": "هغوی د اوبو ژوروالی اندازه کړ او ویې لیدل چې څلوېښت متره ؤ او د لږې فاصلې څخه وروسته یې چې بیا اندازه واخیستله، نو دېرش متره وه."}, {"ref": "Acts 2:28", "text": "نو بیا پوه شئ چې دغه د خلاصون پیغام د خدای له خوا غیریهودیانو ته لېږل شوی دی او هغوی به یې مني.» ["}, {"ref": "Acts 2:29", "text": "زه پوهېږم چې زما د تګ څخه وروسته به داړونکي لېوان ستاسو منځ ته درشي او رمه به په امان کې پرېنږدي."}, {"ref": "Acts 2:29", "text": "هغوی د دې دپاره دا خبرې وکړې چې له مخکې څخه یې تروفیموس چې د افسیس څخه ؤ، په ښار کې د پولوس سره لیدلی ؤ او فکر یې کاوه چې پولوس هغه د خدای کور ته راوستلی دی."}, {"ref": "Acts 2:29", "text": "نو کومو عسکرو چې غوښتل د پولوس څخه پوښتنې وکړي، هغه یې زر پرېښود او قوماندان هم ووېرېده، ځکه هغه پوه شو چې پولوس یو رومي سړی دی او د هغه په امر تړل شوی ؤ. پولوس د شورا په مخکې"}, {"ref": "Acts 2:29", "text": "زه پوه شوم چې هغه داسې کار نه دی کړی چې د مرګ لایق وي او یا دې په زندان کې واچول شي. کوم تور چې په هغه باندې لګېدلی دی هغه د هغوی د خپل شریعت پورې تړلې خبرې وې."}, {"ref": "Acts 2:29", "text": "پولوس وویل: «که لږ وخت ونیسي یا ډېر، خو زه خدای ته دعا کوم چې یوازې تاسو نه بلکې هغه ټول خلک چې نن زما خبرې اوري، زما په شان شي، بې له شکه زما په شان په زولنو کې نه.»"}, {"ref": "Acts 2:29", "text": "هغوی وېرېدل هسې نه چې د ګټانو سره ولګیږي، نو د کشتۍ له شا نه یې څلور لنګرونه واچول او دعا یې وکړه چې زر سبا شي."}, {"ref": "Acts 2:29", "text": "کله چې پولوس خپلې خبرې پای ته ورسولې، نو یهودیان لاړل او په خپل منځ کې یې سره بحث وکړ.]"}, {"ref": "Acts 2:30", "text": "حتی ستاسو په منځ کې به داسې خلک پیدا شي چې د حقیقت په ځای به دروغ وایي، ترڅو ایمانداران خپل ځان ته راواړوي."}, {"ref": "Acts 2:30", "text": "په ټول ښار کې ګډوډي رامنځته شوه او خلکو د هرې خوا څخه رامنډې کړې، پولوس یې ونیو او په راښکلو یې د خدای د کور څخه دباندې راوویست او سمدلاسه د خدای د کور دروازې بندې شوې."}, {"ref": "Acts 2:30", "text": "په بله ورځ قوماندان وغوښتل په دې پوه شي چې په کوم معقول دلیل یهودیان په پولوس تور لګوي، نو پولوس یې ازاد کړ او مشرانو کاهنانو او ټولې شورا ته یې امر وکړ چې سره راټول شي. بیا هغه پولوس راوست او د هغوی په مخکې یې ودراوه."}, {"ref": "Acts 2:30", "text": "خو کله چې زه خبر شوم چې د هغه د وژلو دپاره دسیسه جوړه شوې ده، نو سمدلاسه مې پرېکړه وکړه چې تاسو ته یې درولېږم او د هغه مدعیانو ته مې امر وکړ چې خپله دعوه دې تاسو ته وړاندې کړي.»"}, {"ref": "Acts 2:30", "text": "بیا پاچا پاڅېد او والي، برنیکۍ او نور خلک چې د هغوی سره ناست وو، هم پاڅېدل."}, {"ref": "Acts 2:30", "text": "کشتیوانانو کوښښ کاوه چې د کشتۍ څخه وتښتي او هغوی په دې بهانه چې غواړي د کشتۍ د مخکینۍ برخې یو څو لنګرونه واچوي، کوچنۍ کشتۍ یې بحیرې ته ښکته کړه."}, {"ref": "Acts 2:30", "text": "پولوس دوه کاله په یو کرایي کور کې اوسېده او هرڅوک چې به د هغه د لیدلو دپاره راتللو، نو هرکلی به یې ورته ویل."}, {"ref": "Acts 2:31", "text": "نو بېداره اوسئ او دا خبره یاد ساتئ چې درې کاله مې شپه او ورځ تاسو هر یو ته نصیحت کاوه او ستاسو دپاره مې اوښکې تویې کړې."}, {"ref": "Acts 2:31", "text": "کله چې خلکو هڅه کوله پولوس ووژني، په دې وخت کې د رومي لښکرو قوماندان ته خبر ورسېده چې په ټول اورشلیم کې غوغا جوړه شوې ده."}, {"ref": "Acts 2:31", "text": "نو عسکرو د حکم سره سم په هماغه شپه پولوس د انتیپاتریس ښار ته بوته."}, {"ref": "Acts 2:31", "text": "کله چې هغوی ووتل، نو یو بل ته یې سره وویل: «دې سړي داسې کوم کار نه دی کړی چې د مرګ یا زندان ته د اچولو وړ وي.»"}, {"ref": "Acts 2:31", "text": "خو پولوس هغه منصبدار او عسکرو ته وویل: «که چېرې کشتیوانان په کشتۍ کې پاتې نه شي، نو ستاسو څخه به هېڅوک هم ونه ژغورل شي.»"}, {"ref": "Acts 2:31", "text": "هغه د خدای د پاچاهۍ په هکله وعظ کاوه او د څښتن عیسی مسیح په هکله یې په زړورتیا او په ازادانه توګه تعلیم ورکاوه."}, {"ref": "Acts 2:32", "text": "اوس زه تاسو خدای او د هغه د فضل نه ډک کلام ته سپارم، هغه کلام ته چې کولای شي تاسو ته قوت درکړي او هغه برکتونه درکړي چې خدای یې خپلو ټولو سپېڅلو خلکو د میراث په توګه ورکوي."}, {"ref": "Acts 2:32", "text": "قوماندان سمدلاسه خپل عسکر او منصبداران د ځان سره واخیستل او د ګڼې ګوڼې خواته یې ورمنډې کړې. کله چې خلکو قوماندان او عسکر ولیدل، نو د پولوس د وهلو نه یې لاس واخیست."}, {"ref": "Acts 2:32", "text": "په بله ورځ پیاده عسکر بېرته خپلې نظامي‌قلعه ته راستانه شول او سپاره عسکر یې پرېښودل چې د پولوس سره لاړ شي."}, {"ref": "Acts 2:32", "text": "اګریپاس فستوس ته وویل: «که چېرې دې سړي امپراتور ته عرض نه وای کړی، نو ازادېدلی شو.»"}, {"ref": "Acts 2:32", "text": "نو عسکرو د کوچنۍ کشتۍ طنابونه پرې کړل او هغه یې پرېښودله چې په بحیره کې لاړه شي."}, {"ref": "Acts 2:33", "text": "ما هېڅکله د چا نه د سپینو زرو، سرو زرو او کالیو تمه نه ده کړې."}, {"ref": "Acts 2:33", "text": "بیا قوماندان پولوس ته نژدې ورغی او هغه یې ونیو او امر یې وکړ چې هغه په دوو زنځیرونو باندې وتړئ. بیا هغه پوښتنه وکړه: «دا سړی څوک دی او څه یې کړي دي؟»"}, {"ref": "Acts 2:33", "text": "کله چې هغوی قیصریې ته ورسېدل، نو هغه لیک یې والي ته ورساوه او پولوس یې ورته وروسپاره."}, {"ref": "Acts 2:33", "text": "د لمرخاته څخه مخکې پولوس د ټولو څخه وغوښتل چې یو څه شی وخوري. هغه وویل: «نن څوارلسمه ورځ ده چې تاسو دومره پرېشانه یئ چې هېڅ شی مو نه دي خوړلي."}, {"ref": "Acts 2:34", "text": "تاسو خپله پوهېږئ چې ما په خپلو لاسونو زیار ویستلی او د خپل ځان او خپلو ملګرو اړتیاوې مې پوره کړې دي."}, {"ref": "Acts 2:34", "text": "ځینو خلکو به په چیغو کې یو څه ویل او ځینو به بل څه. هلته دومره شور او غوغا وه چې قوماندان پوه نه شو چې حقیقت څه دی. نو امر یې وکړ چې هغه نظامي‌قلعه ته بوځي."}, {"ref": "Acts 2:34", "text": "والي لیک ولوست او د پولوس څخه یې پوښتنه وکړه چې د کوم ولایت څخه دی. کله چې پوه شو چې هغه د قیلیقیې څخه دی،"}, {"ref": "Acts 2:34", "text": "نو له دې امله تاسو ته سوال کوم چې لږ خواړه وخورئ، ځکه چې تاسو ورته اړتیا لرئ د دې دپاره چې ژوندي پاتې شئ. په تاسو کې به د هېچا د سر یو ویښته هم کم نه شي.»"}, {"ref": "Acts 2:35", "text": "ما په خپلو سختو کارونو سره تاسو ته وښودل چې په دې ډول کولای شو چې د غریبانو سره مرسته وکړو او باید د څښتن عیسی هغه خبرې په یاد وساتو چې ویلي یې دي: ‹د اخیستلو څخه په ورکولو کې برکتونه ډېر دي.›»"}, {"ref": "Acts 2:35", "text": "کله چې هغوی د نظامي‌قلعه زینو ته ورسېدل، نو خلکو دومره زور راوړ چې عسکر مجبور شول پولوس په خپلو اوږو باندې یوسي،"}, {"ref": "Acts 2:35", "text": "نو والي ورته وویل: «زه به هغه وخت ستا دعوه واورم چې کله ستا مدعیان راورسیږي.» بیا هغه امر وکړ چې پولوس دې د هیرودیس په ماڼۍ کې وساتل شي."}, {"ref": "Acts 2:35", "text": "کله چې پولوس دا خبره وکړه، بیا یې لږه ډوډۍ راواخیستله، د ټولو په مخکې یې د خدای شکر وکړ، هغه یې ماته کړه او په خوړلو یې پیل وکړ."}, {"ref": "Acts 2:36", "text": "کله چې پولوس خپلې خبرې پای ته ورسولې، نو د هغوی سره یوځای په ګونډو شو او د هغوی ټولو سره یې دعا وکړه."}, {"ref": "Acts 2:36", "text": "ځکه چې خلک ورپسې وو او چیغې یې وهلې: «هغه ووژنئ.» پولوس د خپل ځان څخه دفاع کوي"}, {"ref": "Acts 2:36", "text": "هغوی ټولو همت پیدا کړ او خواړه یې وخوړل."}, {"ref": "Acts 2:37", "text": "بیا هغوی ټولو وژړل، هغه یې په غېږ کې ونیوه، ښکل یې کړ او خدای پاماني یې ورسره وکړه."}, {"ref": "Acts 2:37", "text": "عسکرو لا پولوس نظامي‌قلعه ته نه ؤ رسولی چې قوماندان ته یې وویل: «ایا زه کولای شم تاته یو څه ووایم؟» قوماندان ورته وویل: «نو ته په یوناني ژبه هم خبرې کولای شې؟"}, {"ref": "Acts 2:37", "text": "په کشتۍ کې مونږ ټول دوه سوه او شپږ اویا تنه وو."}, {"ref": "Acts 2:38", "text": "هغوی په دې ډېر زیات غمجن شول، ځکه چې پولوس ویلي وو چې دوی به نور هېڅکله د هغه مخ ونه ویني. نو هغوی ورسره تر کشتۍ پورې لاړل."}, {"ref": "Acts 2:38", "text": "نو بیا ته هغه مصری نه یې چې څه موده مخکې یې اله‌ګوله جوړه کړې وه او څلور زره قاتلان یې د ځان سره دښتې ته بیولي وو؟»"}, {"ref": "Acts 2:38", "text": "کله چې هغوی ټول ماړه شول، نو ټول غنم یې بحیرې ته ورګوزار کړل چې کشتۍ سپکه شي. د کشتۍ ټوټې ټوټې کېدل"}, {"ref": "Acts 2:39", "text": "پولوس ځواب ورکړ: «زه یهودي یم او په قیلیقیه کې د ترسوس د ښار څخه یم چې یو مهم ښار دی. مهرباني وکړه اجازه راکړه چې د خلکو سره خبرې وکړم.»"}, {"ref": "Acts 2:39", "text": "کله چې سهار شو، نو کشتیوانانو وچه ځمکه ونه پېژندله، خو هغوی د خلیج غاړه ولیدله او پرېکړه یې وکړه چې که کېدای شي نو کشتۍ به په هغه ځای باندې وخېژوو."}, {"ref": "Acts 2:40", "text": "قوماندان ورته اجازه ورکړه، نو پولوس په زینې باندې ودرېده او د لاس په پورته کولو سره یې خلکو ته اشاره وکړه چې غلي شي. کله چې هغوی غلي شول، نو په عبراني یعنې د هغوی په ژبه یې د هغوی سره خبرې پیل کړې."}, {"ref": "Acts 2:40", "text": "نو هغوی هغه طنابونه چې لنګرونه پرې تړل شوي وو، پرېکړل او هغه یې په بحیره کې پرېښودل او په هماغه وخت کې یې د کشتۍ د راشپېلونو طنابونه سست کړل. بیا هغوی د کشتۍ د مخکینۍ برخې بادوان د باد خواته پورته کش کړ او کشتۍ د بحیرې غاړې ته روانه شوه."}, {"ref": "Acts 2:41", "text": "خو کشتۍ د اوبو لاندې د شګو د غونډۍ سره ولګېدله او هلته ونښتله. د کشتۍ مخکینۍ برخه ډېره سخته ولګېدله او حرکت یې نه شو کولای، خو وروستنۍ برخه یې د سختو څپو له امله ټوټې ټوټې شوه."}, {"ref": "Acts 2:42", "text": "عسکرو پرېکړه وکړه چې ټول بندیان به ووژنو، هسې نه چې په لامبو وهلو وتښتي."}, {"ref": "Acts 2:43", "text": "خو هغه منصبدار غوښتل چې پولوس وژغوري، نو هغوی یې د دې کار څخه منع کړل. هغه امر وکړ چې اول دې هغه کسان چې لامبو وهلی شي، ځانونه اوبو ته وغورځوي او وچې ته دې ځانونه ورسوي."}, {"ref": "Acts 2:44", "text": "او نورو ته یې وویل چې په تختو او یا د کشتۍ په ټوټو باندې دې هغوی پسې ورشي. په دې ډول مونږ ټول روغ رمټ وچې ته ورسېدلو."}, {"ref": "Hebrews 1:1", "text": "د موسی شریعت د راتلونکو ښو شیانو یوازې یو تصویر دی او د هغو شیانو رښتینی شکل نه دی. دغه شریعت چې د هغه له مخې کومې قربانۍ چې هر کال به وړاندې کېدلې، هېڅکله نه شو کولای هغه خلک کامل کړي چې د خدای عبادت یې کاوه."}, {"ref": "Hebrews 1:1", "text": "ایمان په هغو شیانو باندې باور لرل دي چې مونږ ورته هیله‌من یو او په هغو شیانو باندې ټینګه عقیده لرل چې مونږ یې نه شو لیدلی."}, {"ref": "Hebrews 1:1", "text": "نو اوس چې د شاهدانو دومره لویه ګڼه‌ګوڼه زمونږ څخه راچاپېره ده، نو راځئ چې هر اضافي بار یعنې هره ګناه چې په اسانۍ سره مو راګېروي، د خپل ځان نه لېرې کړو او په صبر او زغم سره په هغې سیالۍ کې منډه ووهو چې زمونږ په وړاندې پرته ده."}, {"ref": "Hebrews 1:1", "text": "د خویندو او ورونو په شان یو د بل سره مینه کوئ."}, {"ref": "Hebrews 1:2", "text": "که چېرې عبادت کوونکي په یوځل او د تل دپاره پاکېدلی، نو نور به هغوی خپل ځانونه ګناهکار نه ګڼلی او چا به نورې قربانۍ نه کولای."}, {"ref": "Hebrews 1:2", "text": "د ایمان په وسیله ؤ چې د پخوانۍ زمانې خلک د خدای له خوا ومنل شول."}, {"ref": "Hebrews 1:2", "text": "خپلې سترګې د عیسی یعنې زمونږ د ایمان د بنیاد ایښودونکي او کامل کوونکي خواته ونیسو. هغه په صلیب باندې د مړ کېدلو شرم وزغملو خو شرم یې مهم ونه ګڼلو، ځکه چې په دې پوهېده چې په دې کار سره به هغه په راتلونکې کې خوشحاله وي او اوس هغه د خدای د تخت ښي لاس ته ناست دی."}, {"ref": "Hebrews 1:2", "text": "دا مه هېروئ چې باید د مسافرو مېلمه‌پالنه وکړئ، ځکه چې ځینو خلکو داسې کړي دي او هغوی د فرښتو مېلمه‌پالنه کړې ده که څه هم هغوی یې نه دي پېژندلې."}, {"ref": "Hebrews 1:3", "text": "بلکې دې قربانیو به هر کال هغوی ته خپل ګناهونه ور په یادول،"}, {"ref": "Hebrews 1:3", "text": "مونږ د ایمان له مخې پوهېږو چې ټول کاینات د خدای د کلام په وسیله پیدا شو، نو څه چې مونږ وینو هغه د هغو شیانو څخه جوړ شوي دي چې نه شي لیدل کېدای."}, {"ref": "Hebrews 1:3", "text": "د هغه په هکله فکر وکړئ چې د ګناهکارانو له خوا د څومره مخالفتونو سره مخ شو، نو خپله حوصله له لاسه مه ورکوئ او بې‌زړه کېږئ مه."}, {"ref": "Hebrews 1:3", "text": "هغه کسان چې په زندان کې دي داسې یادوئ لکه چې تاسو ورسره په زندان کې یئ. هغه کسان در په یادوئ چې ظلم ورسره کیږي، نو داسې وګڼئ لکه تاسو چې کړاوونه وینئ."}, {"ref": "Hebrews 1:4", "text": "ځکه چې د غویانو او وزو وینه هېڅکله نه شي کولای ګناهونه لېرې کړي."}, {"ref": "Hebrews 1:4", "text": "د ایمان په وسیله ؤ چې هابیل د قاین نه ډېره ښه قرباني خدای ته وړاندې کړه. هغه د خپل ایمان له لارې د خدای په نظر کې عادل وګنل شو، ځکه چې خدای د هغه نذرانې قبولې کړې او سره له دې چې هابیل مړ شوی دی، خو د خپل ایمان له لارې تر‌اوسه زمونږ سره خبرې کوي."}, {"ref": "Hebrews 1:4", "text": "تاسو لا تر‌اوسه د ګناه په خلاف جنګ کې تر دې حده نه یئ رسېدلي چې وینه مو په کې تویه شوې وي."}, {"ref": "Hebrews 1:4", "text": "ټول باید واده ته درناوی ولري او ښځې او مېړونه باید یو بل ته وفادار اوسي، ځکه چې خدای به بد‌اخلاقه او زناکاره خلک محکوم کړي."}, {"ref": "Hebrews 1:5", "text": "له همدې امله کله چې مسیح نړۍ ته راتللو، نو خدای ته یې وویل: تا نه غوښتلې قربانۍ او نذرانې نو ماته دې راکړ بدن"}, {"ref": "Hebrews 1:5", "text": "د ایمان په وسیله ؤ چې خنوخ مړ نه شو او اسمان ته پورته کړای شو او هېچا هغه پیدا نه کړ، ځکه چې خدای هغه پورته یووړ. مخکې له دې چې هغه پورته یووړل شي، د خدای کلام د هغه په هکله شاهدي ورکوي چې خدای د هغه څخه راضي ؤ."}, {"ref": "Hebrews 1:5", "text": "ایا تاسو دا هېر کړي دي چې خدای درته لکه د خپلو اولادونو په شان نصیحت کوي: ای زما زویه! کله چې تا اصلاح کوي څښتن نو هغه مه ګڼه سپک او کله چې هغه رټي تا، نو نا‌امیده کېږه مه"}, {"ref": "Hebrews 1:5", "text": "په خپل ژوند کې د پیسو سره د مینې کولو نه ځان لېرې وساتئ او څه چې لرئ په هغو باندې قناعت وکړئ، ځکه چې خدای ویلي دي: «زه به هېڅکله تاسو یوازې پرېنږدم او هېڅکله به مو نه هېروم.»"}, {"ref": "Hebrews 1:6", "text": "په سوځېدونکو نذرانو او د ګناه په نذرانو ته خوشحاله نه وې"}, {"ref": "Hebrews 1:6", "text": "نو پرته له ایمانه دا ناشونې ده چې انسان دې خدای خوشحاله کړي، ځکه څوک چې غواړي خدای ته ورنژدې شي، نو باید په دې ایمان ولري چې هغه موجود دی او څوک چې هغه لټوي، نو هغه ته اجر ورکوي."}, {"ref": "Hebrews 1:6", "text": "ځکه څښتن چې کوي مینه د کوم چا سره نو اصلاح کوي هغه او هغه چاته ورکوي سزا چې قبلوي یې د خپل زوی په توګه"}, {"ref": "Hebrews 1:6", "text": "نو مونږ په ډاډه زړه ویلی شو: زما مرستندوی دی څښتن نه به وېرېږمه زه څه کولای شي انسان ما سره؟"}, {"ref": "Hebrews 1:7", "text": "بیا ما وویل: «ای خدایه، زه حاضر یم چې ستا رضا پوره کړم، لکه څنګه چې د تورات په کتاب کې زما په هکله لیکل شوي دي.»"}, {"ref": "Hebrews 1:7", "text": "د نوح د ایمان په وسیله ؤ چې هغه ته د هغو شیانو په هکله خبرداری ورکړل شو چې لا تر هغه وخته نه وو پېښ شوي. هغه اطاعت وکړ او د خپلې کورنۍ د ژغورلو دپاره یې یوه لویه کشتۍ جوړه کړه. هغه د خپل ایمان له لارې دنیا محکومه کړه او د ایمان له مخې عادل وګڼل شو."}, {"ref": "Hebrews 1:7", "text": "تاسو اصلاح وزغمئ، ځکه چې دا زغم دا ښایي چې خدای تاسو سره د خپلو اولادونو په شان چلند کوي. ایا تاسو کله داسې اولاد لیدلی دی چې د خپل پلار له خوا اصلاح شوی نه وي؟"}, {"ref": "Hebrews 1:7", "text": "خپل مشران چې تاسو ته یې د خدای کلام بیان کړ، په یاد ساتئ. د هغوی د ژوند د لارو او څرنګوالي په هکله فکر وکړئ او د هغوی ایمان د ځان دپاره مثال وګرځوئ."}, {"ref": "Hebrews 1:8", "text": "لکه څنګه چې مسیح مخکې وویل: «تا نه قربانۍ، نه نذرانې، نه سوځېدونکې نذرانې او نه د ګناه نذرانې غوښتلې او نه په هغو باندې خوشحالېدلې» که څه هم هغه د شریعت له مخې وړاندې کېدلې."}, {"ref": "Hebrews 1:8", "text": "کله چې خدای ابراهیم ته امر وکړ چې خپل کور پرېږدي او هغه ځای ته لاړ شي چې خدای به یې ورته د میراث په توګه ورکړي، د ایمان په وسیله ؤ چې هغه اطاعت وکړ او بې له دې چې پوه شي چېرته ځي، د خپل وطن نه ووت."}, {"ref": "Hebrews 1:8", "text": "که چېرې تاسو د هغه د نورو اولادونو په شان اصلاح نه شئ، نو دا په دې معنی ده چې تاسو د هغه رښتیني اولادونه نه یئ، بلکې حرامیان یئ."}, {"ref": "Hebrews 1:8", "text": "عیسی مسیح پرون، نن او د تل دپاره یوشان دی."}, {"ref": "Hebrews 1:9", "text": "بیا هغه زیاته کړه: «زه راغلم چې ستا رضا پوره کړم.» بیا خدای مخکینۍ قربانۍ باطلې کړلې، ترڅو د هغو په ځای د عیسی قرباني رامنځته کړي."}, {"ref": "Hebrews 1:9", "text": "د ایمان په وسیله لکه د یو پردي په شان په هغه وطن کې چې خدای ورسره وعده کړې وه، اوسېده او د اسحاق او یعقوب سره هم چې د دې وعدې وارثان وو، په خېمو کې اوسېدل."}, {"ref": "Hebrews 1:9", "text": "برسېره پر‌دې، مونږ ټولو پلرونه درلودل چې مونږ یې اصلاح کولو او مونږ د هغوی درناوی کاوه. نو مونږ به د دې نه څومره زیاته د هغه چا تابعداري وکړو چې زمونږ روحاني پلار دی او مونږ ته ژوند راکوي."}, {"ref": "Hebrews 1:9", "text": "د هر ډول عجیبه تعلیمونو له امله مه بې‌لارې کېږئ. دا ښه ده چې زمونږ زړونه د خدای په فضل باندې قوي شي، نه په مذهبي قوانینو پورې تړلي خوړو باندې، ځکه کوم خلک چې دا قانون په مخ وړي هېڅ ګټه ورته نه رسیږي."}, {"ref": "Hebrews 1:10", "text": "نو په دې ډول مونږ د خدای په ارادې او د عیسی مسیح د بدن په قربانولو سره یوځل او د تل دپاره د ګناه څخه پاک شولو."}, {"ref": "Hebrews 1:10", "text": "ځکه چې ابراهیم د هغه ښار د لیدلو هیله درلودله چې ټینګ بنیاد لري او نقشه جوړوونکی او ودانوونکی یې خدای دی."}, {"ref": "Hebrews 1:10", "text": "زمونږ دنیاوي پلرونه لکه څنګه چې هغوی ته ښه ښکاري، مونږ اصلاح کړي یو، خو د خدای اصلاح زمونږ د ښېګڼې دپاره ده، ترڅو مونږ د هغه په پاکوالي کې شریک شو."}, {"ref": "Hebrews 1:10", "text": "مونږ داسې د قربانۍ ځای لرو چې حتی هغه کاهنان چې هلته په سپېڅلې خېمه کې خدمت کوي، د هغې قربانۍ د خوړلو حق نه لري."}, {"ref": "Hebrews 1:11", "text": "هر کاهن هره ورځ د قربانۍ د ځای په مخکې ودریږي او خپل کار کوي او هماغه یو ډول قرباني بیا بیا وړاندې کوي چې دا قربانۍ هېڅکله نه شي کولای چې ګناهونه له منځه یوسي."}, {"ref": "Hebrews 1:11", "text": "د ایمان په وسیله ؤ چې ساره وکولای شول ماشوم وزېږوي، که څه هم هغه شنډه او ډېره زړه وه، ځکه چې هغې باور درلود چې خدای په خپله وعده باندې وفا کوي."}, {"ref": "Hebrews 1:11", "text": "هره اصلاح په خپل وخت کې خوشحالوونکې او خوندوره نه وي بلکې دردناکه وي، خو وروسته بیا د هغو خلکو دپاره چې په دې ډول روزل شوي دي، د یو رښتیني ژوند د ارامۍ یوه مېوه وي."}, {"ref": "Hebrews 1:11", "text": "ځکه چې لوی کاهن به د حیواناتو وینه د ګناه د قربانۍ په توګه ډېر سپېڅلي ځای ته وړله، خو د هغوی مړي د کمپ نه دباندې سوځول کېدل."}, {"ref": "Hebrews 1:12", "text": "خو کله چې مسیح د تل دپاره د ګناهونو د له منځه وړلو په خاطر یوځل قرباني ورکړه، نو بیا هغه د خدای ښي لاس ته کښېناست"}, {"ref": "Hebrews 1:12", "text": "له همدې امله د یو سړي نه چې د مړي په شان ؤ، لکه په اسمان کې د ډېرو زیاتو ستورو او د بحیرې د غاړې د شګو په شان یې بې‌شمېره اولادونه پیدا شول."}, {"ref": "Hebrews 1:12", "text": "نو له دې امله خپل ناتوانه لاسونه او کمزورې پښې قوي کړئ."}, {"ref": "Hebrews 1:12", "text": "نو له دې امله عیسی هم د ښار د دروازې نه دباندې کړاوونه وزغمل او مړ شو، ترڅو د خپلې وینې په وسیله خلک د ګناه څخه پاک کړي."}, {"ref": "Hebrews 1:13", "text": "او د هماغه وخت نه هغه په دې انتظار دی، ترڅو د هغه دښمنان تر پښو لاندې کړای شي."}, {"ref": "Hebrews 1:13", "text": "هغه ټول خلک مړه شول، خو تر مرګه پورې په خپل ايمان کې پاتې شول، که څه هم هغوی هغه څه تر‌لاسه نه کړل چې وعده ورسره شوې وه. هغوی هغه شیان د لېرې څخه ولیدل، خو بیاهم خوشحاله وو او اقرار یې وکړ چې دوی په دې دنیا کې پردي او مسافر دي."}, {"ref": "Hebrews 1:13", "text": "د خپلو قدمونو دپاره لاره سمه کړئ، ترڅو په تاسو کې د ځینو ګوډې پښې کمزورې او ناتوانه نه شي بلکې روغې شي. لارښوونې او خبردارۍ"}, {"ref": "Hebrews 1:13", "text": "نو راځئ چې هغه ته د کمپ نه دباندې ورشو او هغه بې‌عزتي وزغمو چې هغه زغملې وه."}, {"ref": "Hebrews 1:14", "text": "ځکه چې هغه د هغې یوې قربانۍ په ورکولو سره هغه خلک د تل دپاره کامل کړل چې د ګناه څخه پاک شوي دي."}, {"ref": "Hebrews 1:14", "text": "ځکه کوم خلک چې داسې خبرې کوي، د هغو نه دا معلومیږي چې هغوی د خپل ځان دپاره د یو وطن په لټه کې دي."}, {"ref": "Hebrews 1:14", "text": "کوښښ وکړئ چې د هرچا سره په سوله او سلامتۍ کې ژوند وکړئ او پاک او سپېڅلي اوسئ، ځکه چې د هغه پرته به هېڅوک څښتن ونه ویني."}, {"ref": "Hebrews 1:14", "text": "ځکه چې په دې دنیا کې زمونږ دپاره هېڅ داسې ښار نشته چې د تل دپاره پاتې وي، خو مونږ د هغه ښار په لټه کې یو چې په راتلونکې کې به موجود وي."}, {"ref": "Hebrews 1:15", "text": "مونږ ته روح القدس هم شاهدي راکوي، ځکه چې هغه اول وایي:"}, {"ref": "Hebrews 1:15", "text": "که چېرې هغوی د هغه وطن ارمان کاوه چې ورڅخه راوتلي وو، نو د هغوی دپاره دا موقعه وه چې بېرته هلته لاړ شي."}, {"ref": "Hebrews 1:15", "text": "پام کوئ، هسې نه چې په تاسو کې څوک د خدای د فضل نه بې‌برخې شي او ستاسو په منځ کې کوم څوک ترخې او زهرجنې ریښې وځغلوي چې د تکلیف سبب شي او د هغه له امله ډېر خلک فاسد شي"}, {"ref": "Hebrews 1:15", "text": "نو راځئ چې د عیسی په وسیله د قربانیو په توګه تل د خدای ثنا او صفت وکړو، یعنې په خپلو خولو د هغه د نوم اقرار وکړو."}, {"ref": "Hebrews 1:16", "text": "دا هغه لوظ دی چې کوم به یې د هغوی سره په هغه ورځ بیا څښتن وایي: د هغوی زړونو کې به واچوم زه خپل شریعت او وبه یې لیکم د هغوی ذهنونو کې"}, {"ref": "Hebrews 1:16", "text": "خو هغوی د یو ډېر ښه ځای یعنې اسماني وطن په لټه کې وو. نو له همدې امله خدای په دې نه شرمیږي چې د هغوی د خدای په نوم یادیږي، ځکه چې د هغوی دپاره یې یو ښار تیار کړی دی."}, {"ref": "Hebrews 1:16", "text": "او ګورئ چې په تاسو کې دې څوک زناکار یا د عیسو په شان بې‌دینه نه شي چې د یوې مړۍ ډوډۍ دپاره یې د خپل مشرتوب حق خرڅ کړ."}, {"ref": "Hebrews 1:16", "text": "نېکي کول او د نورو سره مرسته کول مه هېروئ، ځکه چې خدای په داسې قربانیو خوشحالیږي."}, {"ref": "Hebrews 1:17", "text": "بیا هغه وایي: نور به زه نه یادوم هېڅکله ګناهونه او بد کارونه د هغوی"}, {"ref": "Hebrews 1:17", "text": "د ایمان په وسیله ؤ چې کله خدای ابراهیم ازمایه، نو هغه اسحاق د قربانۍ په توګه خدای ته وړاندې کړ. دا سړی چې خدای ورسره وعده کړې وه، دې ته تیار شو چې خپل یوازېنی زوی خدای ته قرباني کړي،"}, {"ref": "Hebrews 1:17", "text": "نو تاسو پوهېږئ سره له دې چې وروسته هغه غوښتل چې د برکت میراث تر‌لاسه کړي، خو هغه رد شو، ځکه چې د هغه دپاره د توبې ویستلو موقعه پیدا نه شوه، که څه هم هغه د اوښکو په تویولو سره د هغه برکت په لټه کې ؤ."}, {"ref": "Hebrews 1:17", "text": "د خپلو مشرانو اطاعت کوئ او څه چې درته وایي هماغسې کوئ. هغوی په تاسو باندې پام کوي او خدای ته به حساب ورکوي. نو پرېږدئ چې هغوی دا کار په خوشحالۍ سره وکړي، نه په خفګان. که نه، نو تاسو ته به یې ګټه ونه رسیږي."}, {"ref": "Hebrews 1:18", "text": "نو څرنګه چې دا ګناهونه بخښل شوي دي، نور د ګناهونو دپاره د قربانۍ وړاندې کولو اړتیا نشته. راځئ چې د خدای حضور ته ورنژدې شو"}, {"ref": "Hebrews 1:18", "text": "که څه هم خدای هغه ته ویلي وو: «ستا نسل به د اسحاق څخه حساب شي.»"}, {"ref": "Hebrews 1:18", "text": "تاسو لکه د اسراییلو د خلکو په شان د موسی په وخت کې د سینا غره ته چې د اور لمبې، سخته تیاره او توفان ؤ، راغلي نه یئ."}, {"ref": "Hebrews 1:18", "text": "زمونږ دپاره دعا کوئ. مونږ ډاډمن یو چې زمونږ وجدان پاک دی او غواړو چې په هر لحاظ د عزت ژوند وکړو."}, {"ref": "Hebrews 1:19", "text": "نو ای خویندو او ورونو! مونږ د عیسی مسیح د وینې په وسیله کولای شو په زړورتیا سره ډېر سپېڅلي ځای ته ورننوځو."}, {"ref": "Hebrews 1:19", "text": "ابراهیم په دې فکر ؤ چې خدای کولای شي اسحاق د مرګ نه بېرته راژوندی کړي، نو خدای ابراهیم ته خپل زوی هماغسې بېرته ورکړ."}, {"ref": "Hebrews 1:19", "text": "کله چې خلکو د سرني او یو ډېر وېروونکی اواز واورېد، نو زارۍ یې وکړې چې خدای دې نور زمونږ سره خبرې ونه کړي."}, {"ref": "Hebrews 1:19", "text": "زه ستاسو نه په کلکه غوښتنه کوم چې دعا وکړئ، ترڅو ډېر زر بېرته تاسو ته راشم. وروستۍ دعاګانې"}, {"ref": "Hebrews 1:20", "text": "هغه مونږ ته یوه نوې او د ژوندون لاره د پردې له منځ نه چې د هغه بدن دی، خلاصه کړه."}, {"ref": "Hebrews 1:20", "text": "د ایمان په وسیله ؤ چې اسحاق خپلو دوو زامنو، یعقوب او عیسو ته د هغوی د راتلونکي په پام کې نیولو سره برکت ورکړ."}, {"ref": "Hebrews 1:20", "text": "ځکه چې هغوی د خدای دا حکم ونه شو زغملی چې وایي: «که چېرې یو حیوان هم په دې غره باندې پښه کېږدي، نو هغه باید سنګسار شي.»"}, {"ref": "Hebrews 1:20", "text": "اوس دې د سولې او سلامتۍ خدای چې د تلپاتې لوظ د وینې په وسیله یې زمونږ څښتن عیسی چې لوی شپون دی، د مړو نه بېرته راژوندی کړ،"}, {"ref": "Hebrews 1:21", "text": "څرنګه چې مونږ یو لوی کاهن لرو چې د خدای د کور مسوولیت یې په غاړه دی،"}, {"ref": "Hebrews 1:21", "text": "د ایمان په وسیله ؤ چې کله یعقوب مړ کېده، نو د یوسف دواړو زامنو ته یې برکت ورکړ او په داسې حال کې چې په خپله امسا باندې یې تکیه وهلې وه، د خدای عبادت یې وکړ."}, {"ref": "Hebrews 1:21", "text": "هغه منظره دومره وېروونکې وه چې موسی وویل: «زه د وېرې نه رپېږم.»"}, {"ref": "Hebrews 1:21", "text": "نو هغه دې د خپلې رضا پوره کولو دپاره په خپلو ټولو ښو کارونو کې تیار کړي او د عیسی مسیح په وسیله دې په مونږ کې هغه کارونه وکړي چې هغه پرې خوشحالیږي. د هغه جلال دې تل ترتله وي. امین. وروستني سلامونه"}, {"ref": "Hebrews 1:22", "text": "نو راځئ چې د زړه د اخلاصه او په پوره باور سره د خدای حضور ته ورنژدې شو، ځکه چې زمونږ په ګناهکارو وجدانونو باندې د مسیح وینه شیندل شوې ده، ترڅو مونږ پاک کړي او زمونږ بدنونه یې په پاکو اوبو وینځلي دي."}, {"ref": "Hebrews 1:22", "text": "د ایمان په وسیله ؤ چې کله یوسف مړ کېده، نو د مصر څخه یې د اسراییلو د وتلو په هکله خبرې وکړې او د خپل مړي د ښخولو په اړه یې هغوی ته لارښوونې وکړې."}, {"ref": "Hebrews 1:22", "text": "خو تاسو د صهیون غره او د ژوندي خدای ښار یعنې اسماني اورشلیم ته چې بې‌شمېره فرښتې په کې خوشحالي کوي، راغلي یئ."}, {"ref": "Hebrews 1:22", "text": "ای خویندو او ورونو! ستاسو نه په کلکه غوښتنه کوم چې زما نصیحت په صبر او حوصلې سره واورئ، ځکه چې هغه مې درته په لنډ ډول لیکلی دی."}, {"ref": "Hebrews 1:23", "text": "راځئ چې هغه هیله چې مونږ پرې اقرار کوو ټینګه وساتو، ځکه چا چې زمونږ سره وعده کړې ده، هغه وفادار دی."}, {"ref": "Hebrews 1:23", "text": "د ایمان په وسیله ؤ چې کله موسی وزېږېده، مور او پلار یې ولیدل چې هغه یو ښکلی ماشوم دی، نو هغوی د پاچا د حکم څخه ونه وېرېدل او هغه ماشوم یې درې میاشتې پټ وساته."}, {"ref": "Hebrews 1:23", "text": "تاسو د خدای د لومړني زېږول شویو اولادونو غونډې ته چې نومونه یې په جنت کې لیکل شوي دي، راغلي یئ. تاسو خدای ته چې د ټولو قاضي دی او د نېکانو روحونو ته چې کامل شوي دي، راغلي یئ."}, {"ref": "Hebrews 1:23", "text": "زه غواړم تاسو خبر شئ چې زمونږ ورور تیموتاوس د زندان نه خلاص شوی دی. که هغه زر دلته راشي، نو هغه به زما سره ستاسو لیدو ته درشي."}, {"ref": "Hebrews 1:24", "text": "راځئ فکر وکړو چې څنګه یو بل مینې او نېکو کارونو ته وهڅوو."}, {"ref": "Hebrews 1:24", "text": "د ایمان په وسیله ؤ کله چې موسی لوی شو، نو د دې نه یې انکار وکړ چې هغه دې د فرعون د لور د زوی په نوم یاد شي."}, {"ref": "Hebrews 1:24", "text": "تاسو عیسی ته چې د خدای او خلکو ترمنځ د نوي لوظ منځګړی دی او د هغه وینه د هابیل د وینې نه ډېر ښه پیغام ورکوي، راغلي یئ."}, {"ref": "Hebrews 1:24", "text": "خپلو ټولو مشرانو او ایماندارانو ته زمونږ سلامونه ووایئ. د ایټالیې ایمانداران هم تاسو ته خپل سلامونه وایي."}, {"ref": "Hebrews 1:25", "text": "مونږ باید د ایماندارانو په غونډو کې یو د بل سره په راټولېدلو کې بې‌پروایي ونه کړو، لکه څنګه چې ځینې خلک داسې عادت لري، بلکې یو بل وهڅوو، په ځانګړې توګه اوس چې مونږ وینو چې د خدای ورځ رانژدې کېدونکې ده."}, {"ref": "Hebrews 1:25", "text": "هغه د یو لنډ‌محاله مودې د عیش او عشرت او د ګناه څخه ډک ژوند په ځای د خدای د خلکو سره د بد چلند زغمل غوره وګڼل."}, {"ref": "Hebrews 1:25", "text": "نو پام کوئ چې د هغه چا نه انکار ونه کړئ چې تاسو ته خبرې کوي. کله چې خلکو د هغه د اطاعت کولو نه انکار وکړ چې د ځمکې نه یې هغوی ته خبرې کولې او تېښته یې ونه کړه، نو که تاسو د هغه چا نه انکار وکړئ چې د اسمان نه ستاسو سره خبرې کوي، نو فکر کوئ چې تاسو به وکولای شئ وتښتئ؟"}, {"ref": "Hebrews 1:25", "text": "په تاسو ټولو دې د خدای فضل وي."}, {"ref": "Hebrews 1:26", "text": "ځکه که چېرې مونږ په حقیقت باندې په پوهېدلو سره بیاهم په قصدي توګه ګناهونه کوو، نو بیا هېڅ ډول قرباني نه شي کولای زمونږ ګناهونه لېرې کړي."}, {"ref": "Hebrews 1:26", "text": "هغه د مسیح په خاطر د بې‌عزتۍ زغمل د مصر د ټولو خزانو نه بهتر وګڼل، ځکه چې هغه خپل راتلونکي اجر ته سترګې په لاره ؤ."}, {"ref": "Hebrews 1:26", "text": "په هغه وخت کې د خدای اواز ځمکه ولړزوله، خو اوس هغه وعده کړې ده: «یوځل بیا به زه یوازې ځمکه نه بلکې اسمان هم ولړزوم.»"}, {"ref": "Hebrews 1:27", "text": "خو یوازې د قضاوت د ورځې وېروونکی انتظار او غضبناکه اور پاتې دی چې د خدای دښمنان به سوځوي."}, {"ref": "Hebrews 1:27", "text": "د ایمان په وسیله ؤ چې موسی د مصر څخه راووت او د فرعون د قهر څخه ونه وېرېده او په حوصله یې خپلې لارې ته دوام ورکړ، ځکه چې د هغه نظر په نه‌لیدونکي خدای ؤ."}, {"ref": "Hebrews 1:27", "text": "د هغه دا خبره یعنې «یوځل بیا» دې ته اشاره کوي چې هغه شیان چې خلق شوي دي هغه به ولړزول شي، ترڅو نه لړزېدونکي شیان پاتې شي."}, {"ref": "Hebrews 1:28", "text": "هرچا چې به د موسی شریعت نه منلو، هغه به په بې‌رحمۍ سره د دوه یا درې شاهدانو په شاهدۍ ورکولو سره وژل کېده."}, {"ref": "Hebrews 1:28", "text": "د ایمان په وسیله ؤ چې موسی د اسراییلو خلکو ته حکم وکړ چې د فسحې اختر جوړ کړي او د حیواناتو وینه د دروازو په چوکاټونو باندې وشیندي، ترڅو د مرګ فرښته د اسراییلو لومړني زېږېدلي اولادونه ونه وژني."}, {"ref": "Hebrews 1:28", "text": "نو راځئ چې د هغې نه لړزېدونکې پاچاهۍ په خاطر چې خدای یې مونږ ته راکوي، شکرګزاري وکړو او په درناوي او وېرې سره داسې عبادت وکړو چې هغه ته د منلو وړ وي."}, {"ref": "Hebrews 1:29", "text": "نو بیا فکر وکړئ چې څومره سخته سزا به ورکړل شي هغه چاته چې د خدای زوی تر پښو لاندې کوي او د لوظ د وینې چې هغه یې پاک کړی دی، بې‌عزتي کوي او د فضل د روح سپکاوی کوي."}, {"ref": "Hebrews 1:29", "text": "د ایمان په وسیله ؤ چې د اسراییلو قوم د سرې بحیرې نه داسې پورې وتل لکه په وچه ځمکه چې تېر شي، خو کله چې مصریانو د پورې وتلو کوښښ وکړ، نو ډوب شول."}, {"ref": "Hebrews 1:29", "text": "ځکه چې زمونږ خدای تباه کوونکی اور دی."}, {"ref": "Hebrews 1:30", "text": "ځکه مونږ پوهېږو چې خدای وویل: بدل اخیستل زما کار دی، زه به بدل اخلم. او همدارنګه هغه وویل: څښتن به د خپلو خلکو په هکله قضاوت کوي."}, {"ref": "Hebrews 1:30", "text": "د ایمان په وسیله ؤ چې د اسراییلو خلک د اریحا د ښار نه اووه ورځې ګردچاپېره وګرځېدل او وروسته بیا د ښار دېوالونه راوغورځېدل."}, {"ref": "Hebrews 1:31", "text": "د ژوندي خدای په لاسونو کې غورځېدل ډېر هیبتناکه دی."}, {"ref": "Hebrews 1:31", "text": "د ایمان په وسیله ؤ چې بدلمنه راحاب د نورو نافرمانه خلکو سره یوځای ونه وژل شوه، ځکه چې هغې اسراییلي جاسوسانو ته دوستانه هرکلی ویلی ؤ."}, {"ref": "Hebrews 1:32", "text": "خو هغه تېر وختونه در په یاد کړئ چې د خدای نور درباندې وځلېده، نو په هغو ورځو کې تاسو سخت کړاوونه وزغمل او ټینګ پاتې شوئ."}, {"ref": "Hebrews 1:32", "text": "نور زه څه ووایم؟ ځکه چې زما زیات وخت نشته چې د جدعون، باراق، شمشون، یفتاح، داود، سموییل او نورو پیغمبرانو په هکله خبرې وکړم."}, {"ref": "Hebrews 1:33", "text": "تاسو به کله کله د خلکو په مخکې بې‌عزته کېدلئ او ځورېدلئ، او کله به د نورو سره په دې شیانو کې شریکېدلئ."}, {"ref": "Hebrews 1:33", "text": "هغوی د ایمان په وسیله پاچاهي‌ګانې فتح کړې او عدالت یې ټینګ کړ او هغه شیان یې تر‌لاسه کړل چې خدای ورسره وعده کړې وه. هغوی د زمریانو خولې بندې کړې،"}, {"ref": "Hebrews 1:34", "text": "تاسو د بندیانو سره چې په زندان کې وو، خواخوږي لرله او کله به چې ستاسو مال او دولت ستاسو نه په زور اخیستل کېده، نو په خوشحالۍ سره به مو منل، ځکه چې تاسو پوهېدلئ چې تاسو سره له دې نه ډېر ښه او تلپاتې مال او دولت شته."}, {"ref": "Hebrews 1:34", "text": "د اور لمبې یې مړې کړې او د تورې د خولې نه خلاص شول. هغوی کمزوري وو، خو قوي شول. په جنګ کې زورور شول او د پردیو لښکرې یې تېښتې ته مجبورې کړې."}, {"ref": "Hebrews 1:35", "text": "نو خپله زړورتیا له لاسه مه ورکوئ، ځکه که چېرې تاسو همداسې باور ولرئ، نو لوی اجر به تر‌لاسه کړئ."}, {"ref": "Hebrews 1:35", "text": "ښځو خپل مړي بیا ژوندي وموندل. ځینو نورو ډېر کړاوونه ولیدل، خو ازادي یې ونه منله، ترڅو د قیامت په ورځ له دې نه ډېر ښه ژوند ومومي."}, {"ref": "Hebrews 1:36", "text": "تاسو ته د صبر او زغم اړتیا ده، ترڅو د خدای اراده پوره کړئ، نو بیا به هغه څه تر‌لاسه کړئ چې هغه یې وعده کړې ده."}, {"ref": "Hebrews 1:36", "text": "په ځینو باندې ملنډې ووهل شوې، په دورو ووهل شول، نور په زنځیرونو وتړل شول او بندیان شول."}, {"ref": "Hebrews 1:37", "text": "ځکه لکه څنګه چې د خدای کلام وایي: پاتې دی ډېر لږ وخت او هغه څوک چې باید راشي هغه به راشي او وبه نه کړي ځنډ"}, {"ref": "Hebrews 1:37", "text": "هغوی سنګسار شول، په ارې باندې نیم کړای شول او په تورو باندې یې مړه کړل. هغوی د پسونو او وزو پوستکي اغوستي وو او د ډېرې غریبۍ، ظلم او کړاوونو له امله سرګردانه وو."}, {"ref": "Hebrews 1:38", "text": "د ایمان په وسیله به کوي ژوند زما نېکان او څوک چې مخ واړوي ما نه نو زه به نه یمه خوشحاله د هغه نه"}, {"ref": "Hebrews 1:38", "text": "دنیا د دې خلکو لیاقت نه درلود. هغوی په دښتو او غرونو کې سرګردانه ګرځېدل او په غارونو او سمڅو کې اوسېدل."}, {"ref": "Hebrews 1:39", "text": "خو مونږ هغه خلک نه یو چې د خدای څخه مخ اړوي او تباه کیږي، بلکې مونږ ایمان لرو او ژغورل کېږو."}, {"ref": "Hebrews 1:39", "text": "د خپل ایمان په وسیله د هغوی ټولو ښه ستاینه وشوه، خو بیا یې هم هغه څه تر‌لاسه نه کړل چې خدای یې وعده کړې وه."}, {"ref": "Hebrews 1:40", "text": "ځکه چې خدای زمونږ دپاره له مخکې نه ډېر ښه شی درلود چې وروسته به یې راکړي، هغه دا چې هغوی به زمونږ سره کامل کړای شي."}, {"ref": "John 1:1", "text": "په یقین سره زه تاسو ته دا وایم چې هرڅوک چې د پسونو پنډغالي ته د دروازې په لاره نه ورننوځي، بلکې د کومې بلې لارې نه ورننوځي هغه غل او داړه مار دی."}, {"ref": "John 1:1", "text": "د ایلعازر په نوم یو سړی ؤ چې ناروغه ؤ. د هغه کور په بیت‌عنیا کې ؤ، یعنې په هغه کلي کې چې مریم او د هغې خور مرتا اوسېدله."}, {"ref": "John 1:1", "text": "د فسحې د اختر نه شپږ ورځې مخکې عیسی بیت‌عنیا ته چې ایلعازر په کې اوسېده، یعنې هماغه سړی چې هغه د مرګ نه وروسته بېرته راژوندی کړی ؤ، راغی."}, {"ref": "John 1:1", "text": "د فسحې د اختر نه یوه ورځ مخکې ؤ چې عیسی په دې پوه شو چې هغه وخت راورسېد چې د دې نړۍ نه لاړ شي او پلار ته ورشي. هغه د خپلو پیروانو سره چې د دې نړۍ سره یې تړاو درلود، مینه کوله او تر اخره پورې یې د هغوی سره مینه وکړه."}, {"ref": "John 1:1", "text": "عیسی خپلو شاګردانو ته وویل: «خپل زړونه مه نا‌ارامه کوئ. په خدای باندې ایمان ولرئ او په ما باندې هم ایمان ولرئ."}, {"ref": "John 1:1", "text": "زه د انګورو اصلي تاک یم او زما پلار باغوان دی."}, {"ref": "John 1:1", "text": "ما دا شیان تاسو ته د دې دپاره وویل چې ایمان له لاسه ورنه کړئ."}, {"ref": "John 1:1", "text": "د دې خبرو نه وروسته عیسی پورته اسمان ته وکتل او ویې ویل: «پلاره، هغه ساعت رارسېدلی دی. خپل زوی ته جلال ورکړه ترڅو چې زوی دې هم تاته جلال درکړي،"}, {"ref": "John 1:1", "text": "کله چې عیسی دعا وکړه نو هغه د خپلو شاګردانو سره د ښار نه ووت او د قدرون د درې بلې خواته لاړ. هلته یو باغ ؤ چې عیسی او شاګردان یې ورننوتل."}, {"ref": "John 1:1", "text": "وروسته بیا پیلاتوس عسکرو ته امر وکړ چې عیسی په دورو باندې ووهي."}, {"ref": "John 1:2", "text": "خو کوم سړی چې په دروازه ورننوځي هغه د پسونو شپون دی."}, {"ref": "John 1:2", "text": "دا هغه مریم ده چې ورسته د عیسی په پښو باندې عطر اچوي او د هغه پښې په خپلو ویښتانو وچوي. د هغې ورور ایلعازر ناروغه ؤ."}, {"ref": "John 1:2", "text": "هغوی هلته د عیسی دپاره د ماښام ډوډۍ تیاره کړې وه. مرتا د هغوی خدمت کاوه او ایلعازر هم د عیسی سره ډوډۍ ته ناست ؤ."}, {"ref": "John 1:2", "text": "د ماښام د ډوډۍ وخت ؤ او شیطان له مخکې نه د شمعون اسخریوتي د زوی یهودا په زړه کې دا فکر اچولی ؤ چې د عیسی سره خیانت وکړي."}, {"ref": "John 1:2", "text": "زما د پلار په کور کې ډېرې کوټې دي. که داسې نه وای نو ما به تاسو ته ویلي نه وای چې زه ځم چې ستاسو دپاره ځای تیار کړم."}, {"ref": "John 1:2", "text": "زما هره څانګه چې مېوه نه نیسي هغه پرې کوي او هره څانګه چې مېوه نیسي هغه اصلاح کوي، ترڅو ډېره مېوه ونیسي."}, {"ref": "John 1:2", "text": "هغوی به تاسو د کنیسو نه وشړي او داسې وخت به راشي څوک چې تاسو ووژني، نو هغوی به ګومان کوي چې په دې کار سره یې خدای ته خدمت کړی دی."}, {"ref": "John 1:2", "text": "ځکه چې تا هغه ته په ټولو انسانانو باندې واک او اختیار ورکړی دی ترڅو هغو ټولو خلکو ته چې هغه ته دې ورسپارلي دي، تلپاتې ژوندون ورکړي."}, {"ref": "John 1:2", "text": "یهودا خاین ته هغه ځای معلوم ؤ چې عیسی او شاګردان به یې اکثره وختونه په هغه ځای کې سره راټولېدل."}, {"ref": "John 1:2", "text": "عسکرو د اغزو نه تاج جوړ کړ او د هغه په سر یې کېښود او بانجاني چپنه یې ورته ورواغوستله."}, {"ref": "John 1:3", "text": "څوکیدار هغه ته دروازه خلاصوي او کله چې هغه خپلو پسونو ته نوم اخلي او نارې ورته وهي نو پسونه د هغه اواز پېژني او هغه یې دباندې وباسي."}, {"ref": "John 1:3", "text": "نو خویندو یې عیسی ته خبر ورولېږه او ورته ویې ویل: «استاذه، ستا ګران دوست ناروغه دی.»"}, {"ref": "John 1:3", "text": "په دې وخت کې مریم یو بوتل قیمتي عطر چې نیم لیتر ؤ او د یو ډول خالصه خوشبویه ملهمو څخه جوړ شوي وو، راواخیستل او د عیسی په پښو باندې یې واچول او د هغه پښې یې په خپلو ویښتانو باندې وچې کړلې او ټول کور د عطرو د خوشبویۍ نه ډک شو."}, {"ref": "John 1:3", "text": "عیسی په دې پوهېده چې پلار ورته د ټولو شیانو اختیار ورکړی دی او هغه د خدای له خوا راغلی دی او بېرته خدای ته ورځي."}, {"ref": "John 1:3", "text": "کله چې زه لاړم او تاسو دپاره مې ځای تیار کړ، نو بېرته راځم او تاسو د ځان سره وړم، ترڅو په کوم ځای کې چې زه یم هلته به تاسو هم یئ."}, {"ref": "John 1:3", "text": "تاسو لا د مخکې نه په هغه تعلیم باندې چې درکړی مې دی، پاک شوي یئ."}, {"ref": "John 1:3", "text": "هغوی به تاسو سره داسې کارونه کوي، ځکه چې هغوی نه پلار پېژني او نه ما."}, {"ref": "John 1:3", "text": "او تلپاتې ژوندون دا دی چې هغوی تا وپېژني چې ته یوازېنی رښتینی خدای یې او عیسی مسیح چې تا رالېږلی دی، وپېژني."}, {"ref": "John 1:3", "text": "یهودا یوه ډله رومي عسکر او د خدای د کور ساتونکي چې د مشرانو کاهنانو او فریسیانو له خوا رالېږل شوي وو، د ځان سره واخیستل او باغ ته ورغلل. د هغوی سره لاټینونه اوڅراغونه وو او په وسلو باندې سمبال وو."}, {"ref": "John 1:3", "text": "هغوی به په وار وار هغه ته راتلل او ویل به یې: «ژوندی دې وي د یهودیانو پاچا!» او په مخ به یې څپېړه ورکوله."}, {"ref": "John 1:4", "text": "کله چې هغه خپل ټول پسونه وباسي نو شپون یې مخکې روان وي او پسونه ورپسې وي، ځکه چې د هغه اواز پېژني."}, {"ref": "John 1:4", "text": "کله چې عیسی دا واورېدل نو ویې ویل: «ایلعازر به د دې ناروغۍ څخه نه مړ کیږي بلکې دا د خدای د جلال ښکاره کولو دپاره یوه وسیله ده، ترڅو د خدای زوی هم له دې لارې جلال ومومي.»"}, {"ref": "John 1:4", "text": "خو یهودا اسخریوتي چې د عیسی د شاګردانو څخه ؤ او وروسته یې د هغه سره خیانت وکړ، وویل:"}, {"ref": "John 1:4", "text": "نو هغه د ډوډۍ نه راپاڅېده، خپله چپنه یې لېرې کړله او یو دستمال یې راواخیست او د خپلې ملا نه یې راتاو کړ."}, {"ref": "John 1:4", "text": "تاسو پوهېږئ زه چې چېرته ځم هغه لاره درته معلومه ده.»"}, {"ref": "John 1:4", "text": "په ما کې پاتې شئ لکه څنګه چې زه په تاسو کې پاتې کېږم. لکه څنګه چې یوه څانګه په خپله مېوه نه شي نیولی ترڅو هغه په تاک کې پاتې نه وي، تاسو هم مېوه نه شئ نیولی ترڅو چې په ما کې پاتې نه شئ."}, {"ref": "John 1:4", "text": "دا شیان مې د دې دپاره تاسو ته وویل چې کله د هغوی د واک وخت راورسیږي، نو تاسو ته به زما خبرې در په یاد شي. د روح القدس کار ما دا شیان په پیل کې تاسو ته ونه ویل ځکه زه په خپله تاسو سره وم،"}, {"ref": "John 1:4", "text": "ما د هغه کار په سرته رسولو سره چې تا راته راسپارلی ؤ په دې نړۍ کې تاته جلال درکړ."}, {"ref": "John 1:4", "text": "که څه هم عیسی په دې پوهېده چې څه به ورته پېښیږي، خو بیاهم مخکې ورغی او د هغوی نه یې پوښتنه وکړه: «تاسو څوک لټوئ؟»"}, {"ref": "John 1:4", "text": "پیلاتوس یوځل بیا دباندې راووت او یهودیانو ته یې وویل: «ګورئ، زه هغه تاسو ته راولم ترڅو تاسو خبر شئ چې زه په هغه کې کوم جرم نه وینم.»"}, {"ref": "John 1:5", "text": "هغوی د پردي سړي پسې نه ځي بلکې د هغه نه تښتي، ځکه چې هغوی د پردي سړي اواز نه پېژني.»"}, {"ref": "John 1:5", "text": "په عیسی باندې مرتا، د هغې خور او ایلعازر ګران وو."}, {"ref": "John 1:5", "text": "«دا عطر ولې د درېو سوو سپینو زرو په سکو باندې خرڅ نه شول چې پیسې یې غریبانو ته ورکړل شوې وای؟»"}, {"ref": "John 1:5", "text": "بیا یې په لګن کې اوبه واچولې او د خپلو شاګردانو د پښو په وینځلو یې پیل وکړ او هغه یې په هغه دستمال باندې چې د خپلې ملا نه یې تاو کړی ؤ، وچې کړې."}, {"ref": "John 1:5", "text": "توما وویل: «څښتنه، مونږ نه پوهېږو چې ته چېرته ځې، نو لاره به څنګه وپېژنو؟»"}, {"ref": "John 1:5", "text": "زه د انګورو تاک یم او تاسو څانګې یئ. هرڅوک چې په ما کې پاتې شي او زه په هغه کې پاتې شم نو هغه به ډېره مېوه ونیسي، ځکه چې تاسو بې له ما هېڅ نه شئ کولای."}, {"ref": "John 1:5", "text": "خو زه اوس هغه چاته ورځم چې زه یې رالېږلی یم او تاسو یو هم زما نه دا پوښتنه نه کوئ چې ته چېرته ځې؟"}, {"ref": "John 1:5", "text": "ای پلاره! اوس ماته دې په خپل حضور کې جلال راکړه، هماغه جلال چې د نړۍ د پیدایښت نه مخکې مې ستا په حضور کې درلود."}, {"ref": "John 1:5", "text": "هغوی ځواب ورکړ: «ناصري عیسی.» عیسی وویل: «هماغه زه یم.» او یهودا خاین هم هلته د هغوی سره ولاړ ؤ."}, {"ref": "John 1:5", "text": "نو عیسی په داسې حال کې چې د اغزو تاج یې په سر ؤ او بانجاني چپنه یې اغوستې وه دباندې راووت. پیلاتوس هغوی ته وویل: «وګورئ، هغه سړی دلته دی.»"}, {"ref": "John 1:6", "text": "عیسی هغوی ته دا مثال راوړ، خو هغوی په دې پوه نه شول چې د هغه مقصد څه دی. عیسی نېک شپون دی"}, {"ref": "John 1:6", "text": "سره له دې چې هغه د ایلعازر د ناروغۍ نه خبر شو، خو دوه ورځې نور هم په هغه ځای کې چې ؤ، هلته پاتې شو."}, {"ref": "John 1:6", "text": "هغه دا خبره د دې دپاره ونه کړه چې ګنې د هغه سره د غریبانو غم ؤ، بلکې په دې خاطر چې هغه خپله غل ؤ او څرنګه چې هغه د پیسو د ساتلو مسوولیت په غاړه درلود، نو اکثره وخت به یې یو څه پیسې د خپل ځان دپاره پټولې"}, {"ref": "John 1:6", "text": "هغه شمعون پطروس ته ورغی نو پطروس هغه ته وویل: «ای څښتنه، ایا ته غواړې چې زما پښې ووینځې؟»"}, {"ref": "John 1:6", "text": "عیسی ځواب ورکړ: «زه لاره یم، زه حقیقت یم او زه ژوندون یم. هېڅوک نه شی کولای چې زما د وسیلې نه پرته پلار ته ورشي."}, {"ref": "John 1:6", "text": "که چېرې څوک په ما کې پاتې نه شي هغه به لکه بېکاره څانګه لېرې وغورځول شي او وچ به شي. هغه څانګې راټولیږي، په اور کې اچول کیږي ترڅو وسوځي"}, {"ref": "John 1:6", "text": "ما چې تاسو ته کوم څه وویل په هغې باندې ستاسو زړونه غمجن شول."}, {"ref": "John 1:6", "text": "ما ستا نوم هغو خلکو ته چې په نړۍ کې دې غوره کړل او ماته دې راکړل، وروپېژانده. هغوی ستا وو او تا ماته راکړل او هغوی ستا په کلام باندې عمل کړی دی."}, {"ref": "John 1:6", "text": "کله چې عیسی هغوی ته وویل: «هماغه زه یم.» هغوی شاته شول او په ځمکه راوغورځېدل."}, {"ref": "John 1:6", "text": "کله چې مشرانو کاهنانو او د خدای د کور ساتونکو هغه ولیده، نو په چیغو یې پیل وکړ او ویل یې: «هغه په صلیب باندې ځوړند کړه! هغه په صلیب باندې ځوړند کړه!» پیلاتوس هغوی ته وویل: «هغه بوځئ او په خپله یې په صلیب باندې ځوړند کړئ، ځکه چې زه په هغه کې کوم جرم نه وینم.»"}, {"ref": "John 1:7", "text": "عیسی یوځل بیا هغوی ته وویل: «په یقین سره زه تاسو ته دا وایم چې زه د پسونو دپاره د دروازې په شان یم."}, {"ref": "John 1:7", "text": "بیا هغه خپلو شاګردانو ته وویل: «راځئ چې بېرته یهودیې ته لاړ شو.»"}, {"ref": "John 1:7", "text": "عیسی وویل: «د هغې سره کار مه لرئ، هغې زه د ښخولو دپاره تیار کړم."}, {"ref": "John 1:7", "text": "عیسی په ځواب کې وویل: «ته اوس نه پوهېږې چې زه څه کوم، خو وروسته به پوه شې.»"}, {"ref": "John 1:7", "text": "که چېرې تاسو زه پېژندلی، نو زما پلار به مو هم پېژانده. نو له دې نه وروسته تاسو هغه پېژنئ او هغه مو لیدلی دی. څرنګه چې تاسو زه وپېژندلم، نو زما پلار به هم وپېژنئ او هغه مو لیدلی دی.»"}, {"ref": "John 1:7", "text": "که چېرې تاسو په ما کې پاتې شئ او زما خبرې په تاسو کې پاتې شي، نو هرڅه چې غواړئ د هغو دپاره سوال وکړئ او هغه به درکړل شي."}, {"ref": "John 1:7", "text": "خو زه تاسو ته حقیقت وایم چې زما تګ ستاسو دپاره ښه دی، ځکه که زه لاړ نه شم نو تاسو ته به مرسته کوونکی رانه شي. خو که زه لاړ شم، نو هغه به تاسو ته درولېږم."}, {"ref": "John 1:7", "text": "اوس هغوی پوهیږي چې هرڅه چې تا راکړي دي هغه ستا له خوا دي."}, {"ref": "John 1:7", "text": "عیسی یوځل بیا د هغوی نه پوښتنه وکړه: «تاسو څوک لټوئ؟» هغوی ځواب ورکړ: «ناصري عیسی.»"}, {"ref": "John 1:7", "text": "خلکو ځواب ورکړ: «مونږ قانون لرو او د هغه له مخې باید هغه ووژل شي، ځکه چې هغه دعوه کوي چې د خدای زوی دی.»"}, {"ref": "John 1:8", "text": "هغه ټول نور چې زما نه مخکې راغلي وو، غله او داړه ماران وو او پسونو د هغوی اواز ته غوږ نه دی نیولی."}, {"ref": "John 1:8", "text": "شاګردانو ورته وویل: «ای استاذه، لږه موده مخکې د هغه ځای خلکو غوښتل تا سنګسار کړي، خو ته بیاهم غواړې چې هلته لاړ شې؟»"}, {"ref": "John 1:8", "text": "ځکه چې غریبان به تل ستاسو سره وي، خو زه به تل تاسو سره نه یم.» د ایلعازر په ضد دسیسه"}, {"ref": "John 1:8", "text": "پطروس ورته وویل: «ته به هېڅکله هم زما پښې نه وینځې.» عیسی وویل: «که زه ستا پښې ونه وینځم، نو ته به نور زما سره ملګرتیا ونه لرې.»"}, {"ref": "John 1:8", "text": "د عیسی بل شاګرد فیلیپوس هغه ته وویل: «استاذه، مونږ ته پلار وښایه نو زمونږ قناعت به حاصل شي.»"}, {"ref": "John 1:8", "text": "زما د پلار جلال په دې کې دی چې تاسو ډېره مېوه ونیسئ او دا ثابته کړئ چې زما شاګردان یئ."}, {"ref": "John 1:8", "text": "کله چې هغه راشي، نو د دې نړۍ خلکو ته به د ګناه او د خدای د عدالت او قضاوت په هکله حقیقت ښکاره کړي."}, {"ref": "John 1:8", "text": "ځکه چې هغه پیغام چې تا ماته راکړی دی هغه مې هغوی ته رسولی دی او هغوی قبول کړی دی. هغوی پوهیږي چې دا رښتیا دي چې زه ستا له خوا راغلی یم او په دې باندې ایمان لري چې زه تا رالېږلی یم."}, {"ref": "John 1:8", "text": "عیسی وویل: «ما تاسو ته وویل چې هماغه زه یم. که تاسو ما لټوئ نو دا نور پرېږدئ چې لاړ شي.»"}, {"ref": "John 1:8", "text": "کله چې پیلاتوس دا خبره واورېدله نو نور هم ووېرېده،"}, {"ref": "John 1:9", "text": "زه د دروازې په شان یم. هرڅوک چې زما له لارې ننوځي نو هغوی به وژغورل شي. هغوی به ځي او راځي او ښه څړځای به پیدا کوي."}, {"ref": "John 1:9", "text": "عیسی ځواب ورکړ: «ایا په ورځ کې دولس ساعته رڼا نه وي؟ څوک چې د ورځې ګرځي نه راغورځیږي، ځکه چې د دې نړۍ رڼا ویني."}, {"ref": "John 1:9", "text": "زیات شمېر خلک خبر شول چې عیسی په بیت‌عنیا کې دی، نو هغوی هلته ورغلل. یوازې د دې دپاره نه چې عیسی وویني بلکې ایلعازر چې عیسی راژوندی کړی ؤ، هم وویني."}, {"ref": "John 1:9", "text": "شمعون پطروس وویل: «بیا نو څښتنه، یوازې پښې مې نه بلکې لاسونه او سر مې هم ووینځه.»"}, {"ref": "John 1:9", "text": "عیسی هغه ته وویل: «ای فیلیپوسه، دومره موده زه ستاسو سره وم خو بیاهم ما نه پېژنې؟ هرچا چې زه لیدلی یم نو پلار یې هم لیدلی دی. نو بیا ته څنګه وایې چې مونږ ته پلار وښایه؟"}, {"ref": "John 1:9", "text": "لکه څنګه چې پلار زما سره مینه کړې ده ما هم ستاسو سره مینه کړې ده. نو زما په مینه کې پاتې شئ."}, {"ref": "John 1:9", "text": "د نړۍ خلک د ګناه په هکله غلط فکر لري، ځکه چې هغوی په ما باندې ایمان نه راوړي."}, {"ref": "John 1:9", "text": "زه د هغوی دپاره دعا کوم، د نړۍ دپاره یې نه کوم. زه د هغو خلکو دپاره دعا کوم چې تا راته راکړي دي ځکه چې هغوی ستا دي."}, {"ref": "John 1:9", "text": "هغه دا وویل ترڅو هغه څه چې هغه ویلي وو هغه رښتیا شي: «ای پلاره، تا چې څوک ماته راسپارلي وو چې پام ورباندې وکړم د هغو نه مې یو هم له لاسه نه دی ورکړی.»"}, {"ref": "John 1:9", "text": "او بېرته ماڼۍ ته لاړ او د عیسی نه یې پوښتنه وکړه: «ته د کوم ځای یې؟» خو عیسی ورته ځواب ورنه کړ."}, {"ref": "John 1:10", "text": "غل یوازې د غلا، قتل او بربادۍ دپاره راځي. زه د دې دپاره راغلی یم چې زما پسونه ژوندون ومومي او د هغوی په ژوند کې هرڅه پرېمانه وي."}, {"ref": "John 1:10", "text": "خو که څوک د شپې ګرځي نو غورځیږي، ځکه چې د هغه سره رڼا نه وي.»"}, {"ref": "John 1:10", "text": "نو مشرانو کاهنانو پرېکړه وکړه چې ایلعازر هم ووژني،"}, {"ref": "John 1:10", "text": "عیسی ورته وویل: «چا چې ځان وینځلی وي نو هغه بیخي پاک وي او وینځلو ته اړتیا نه لري، یوازې پښې یې باید ووینځل شي. تاسو ټول پاک یئ، خو په تاسو کې یو کس پاک نه دی.»"}, {"ref": "John 1:10", "text": "ایا په دې باندې باور نه لرې چې زه په پلار کې یم او پلار په ما کې دی؟ زه چې تاسو ته کومې خبرې کوم هغه د خپل ځانه نه کوم، بلکې زما پلار چې په ما کې دی زما په وسیله خپل کارونه کوي."}, {"ref": "John 1:10", "text": "که چېرې تاسو زما په حکمونو باندې عمل وکړئ، نو زه به تاسو سره مینه کوم لکه څنګه چې ما د خپل پلار په حکمونو باندې عمل کړی دی او زه د هغه په مینه کې اوسېږم."}, {"ref": "John 1:10", "text": "هغوی د عدالت په هکله غلط فکر لري، ځکه چې زه پلار ته ځم او نور به مې ونه وینئ،"}, {"ref": "John 1:10", "text": "زه چې کوم خلک لرم هغه ستا دي او تا سره چې کوم خلک دي هغه زما دي او د هغو په وسیله زما جلال څرګند شوی دی."}, {"ref": "John 1:10", "text": "بیا شمعون پطروس چې توره ورسره وه، هغه یې راوویستله او د لوی کاهن په نوکر یې چې ملخوس نومېده، ګوزار وکړ او د هغه ښي غوږ یې پرې کړ."}, {"ref": "John 1:10", "text": "پیلاتوس هغه ته وویل: «ولې زما سره خبرې نه کوې؟ ایا ته په دې نه پوهېږې چې زه دا واک او اختیار لرم چې تا ازاد کړم او یا دې په صلیب باندې ځوړند کړم؟»"}, {"ref": "John 1:11", "text": "زه نېک شپون یم، داسې شپون چې د خپلو پسونو په خاطر خپل ځان قربانوي."}, {"ref": "John 1:11", "text": "عیسی دا خبرې وکړې او بیا یې هغوی ته وویل: «زمونږ دوست ایلعازر ویده پروت دی، خو زه ورځم چې راویښ یې کړم.»"}, {"ref": "John 1:11", "text": "ځکه چې د هغه له امله ډېرو خلکو هغوی پرېښودل او په عیسی باندې یې ایمان راوړ. په بریالیتوب سره اورشلیم ته د عیسی ننوتل (متي ۲۱‏:‌۱‌‏-‌۱۱ او مرقوس ۱۱‏:‌۱‌‏-‌۱۱ او لوقا ۱۹‏:‌۲۸‌‏-‌۴۰)"}, {"ref": "John 1:11", "text": "ځکه چې عیسی ته معلومه وه چې څوک به ورسره خیانت کوي، نو ځکه یې وویل: «تاسو ټول پاک یئ پرته د یو کس نه.»"}, {"ref": "John 1:11", "text": "کله چې زه وایم چې زه په پلار کې یم او پلار په ما کې دی، نو په دې باندې باور وکړئ. که زما په خبرو باندې باور نه کوئ نو کوم کارونه چې ما کړي دي د هغو دپاره باور وکړئ."}, {"ref": "John 1:11", "text": "ما دا شیان تاسو ته وویل ترڅو ستاسو زړونه زما د خوشحالۍ نه ډک شي او ستاسو خوشحالي پوره شي."}, {"ref": "John 1:11", "text": "هغوی د خدای د قضاوت په هکله هم غلط فکر لري، ځکه چې د دې نړۍ واکمن لا پخوا محکوم کړای شوی دی."}, {"ref": "John 1:11", "text": "زه نور په دې نړۍ کې نه پاتې کېږم او هغوی به لا په دې نړۍ کې پاتې وي او زه تاته درروان یم. ای سپېڅلی پلاره، د خپل نوم په قدرت سره هغه خلک چې ماته دې راکړي وساته، ترڅو هغوی سره یو وي لکه څنګه چې مونږ سره یو یو."}, {"ref": "John 1:11", "text": "عیسی پطروس ته وویل: «خپله توره دې بېرته په خپل ځای کې کېږده. ایا د مصیبت هغه پیاله چې پلار راته راکړې ده ونه څښم؟» عیسی د حناس په مخکې"}, {"ref": "John 1:11", "text": "عیسی ځواب ورکړ: «که چېرې خدای تاته واک او اختیار نه وای درکړی، نو تا به زما سره هېڅ هم نه شوی کولای. نو چا چې زه تاته په لاس درکړم، نو په دې کې زیاته ګناه د هغه ده.»"}, {"ref": "John 1:12", "text": "خو یو مزدور چې شپون نه دی او پسونه یې خپل نه دي، نو کله چې وویني چې لېوه راروان دی، پسونه پرېږدي او تښتي. لېوه به په پسونو باندې حمله وکړي، پسونه به په زوره بوځي او خواره واره به یې کړي."}, {"ref": "John 1:12", "text": "شاګردانو وویل: «ای استاذه، که هغه ویده وي نو هغه به راپاڅیږي.»"}, {"ref": "John 1:12", "text": "په بله ورځ ګڼ شمېر خلک چې د اختر دپاره راغلي وو، خبر شول چې عیسی اورشلیم ته راروان دی."}, {"ref": "John 1:12", "text": "کله چې عیسی د هغوی پښې ووینځلې، نو خپله چپنه یې بېرته واغوستله او بېرته دسترخوان ته کښېناست او د هغوی نه یې پوښتنه وکړه: «ما چې ستاسو دپاره څه وکړل ایا تاسو د هغې په معنی باندې پوه شوئ؟"}, {"ref": "John 1:12", "text": "په یقین سره زه تاسو ته دا وایم چې هرڅوک چې په ما باندې ایمان راوړي، نو کوم کارونه چې ما کړي دي، هغه به یې هم وکړي او له دې نه به هم لوی لوی کارونه وکړي، ځکه چې زه خپل پلار ته ورځم."}, {"ref": "John 1:12", "text": "زما حکم دا دی: د یو بل سره مینه کوئ لکه څنګه چې ما تاسو سره مینه کړې ده."}, {"ref": "John 1:12", "text": "ډېرې نورې خبرې دي چې باید تاسو ته یې وکړم خو اوس یې تاسو د اورېدلو توان نه لرئ."}, {"ref": "John 1:12", "text": "هغه وخت چې زه د هغوی سره وم هغوی مې په هغه نوم چې تا راته راکړی ؤ وساتل او د هغوی نه یو هم هلاک نه شو، پرته له یو نه چې باید هلاک شي، ترڅو د خدای د کلام وینا رښتیا شي."}, {"ref": "John 1:12", "text": "رومي عسکرو د خپل قوماندان او د یهودي ساتونکو سره عیسی ونیوه او کلک یې وتاړه."}, {"ref": "John 1:12", "text": "کله چې پیلاتوس دا خبره واورېدله، نو کوښښ یې وکړ چې هغه ازاد کړي خو یهودیانو به بیا چیغې وهلې او ویل یې: «که چېرې تا دا سړی ازاد کړ نو ته د امپراتور دوست نه یې. هرڅوک چې دعوه کوي چې زه پاچا یم، نو هغه د امپراتور په خلاف سرکښي کوي.»"}, {"ref": "John 1:13", "text": "هغه تښتي، ځکه چې هغه مزدور دی او د پسونو پروا نه لري."}, {"ref": "John 1:13", "text": "خو د عیسی د خبرې مقصد دا ؤ چې ایلعازر مړ شوی دی، خو هغوی فکر وکړ چې د هغه مقصد عادي خوب دی."}, {"ref": "John 1:13", "text": "نو هغوی د خرما د ونو څانګې واخیستلې او د هغه مخې ته ورووتل او چیغې یې وهلې: «ژوندی دې وي! مبارک دی وي هغه څوک چې د څښتن په نوم راځي! مبارک دي وي د اسراییلو پاچا!»"}, {"ref": "John 1:13", "text": "تاسو ماته استاذ او بادار وایئ او تاسو ښه کوئ چې داسې وایئ، ځکه چې زه همداسې یم."}, {"ref": "John 1:13", "text": "او تاسو چې هرڅه زما په نوم وغواړئ زه به هغه کوم، ترڅو د پلار جلال د زوی په وسیله ښکاره شي."}, {"ref": "John 1:13", "text": "د دې نه نوره زیاته مینه نشته چې یو سړی دې د خپلو ملګرو په خاطر خپل ځان قربان کړي."}, {"ref": "John 1:13", "text": "خو کله چې د حقیقت روح راشي نو تاسو ته به د حقیقت طرف ته بوځي. هغه به له خپله ځانه خبرې نه کوي بلکې څه چې هغه اوري هغه به وایي او په راتلونکي کې چې کوم څه کیږي تاسو به ورباندې خبر کړي."}, {"ref": "John 1:13", "text": "خو زه اوس تاته درروان یم او ترڅو پورې چې زه په دې نړۍ کې یم دا خبرې کوم د دې دپاره چې هغوی په خپلو زړونو کې په پوره توګه داسې خوشحالي ولري لکه زما خوشحالي."}, {"ref": "John 1:13", "text": "هغه یې لومړی حناس ته چې د قیافا خسر ؤ او په هغه کال کې لوی کاهن ؤ، بوته."}, {"ref": "John 1:13", "text": "کله چې پیلاتوس دا خبرې واورېدلې، نو عیسی یې دباندې راوویست او بیا پیلاتوس په هغه ځای کې د قضاوت په چوکۍ باندې کښېناست چې د تیږو د فرش په نوم یادېده او په آرامي ژبه کې ورته جباتا وایي."}, {"ref": "John 1:14", "text": "زه نېک شپون یم. زه خپل پسونه پېژنم او هغوی ما پېژني."}, {"ref": "John 1:14", "text": "نو عیسی هغوی ته ښکاره وویل: «ایلعازر مړ شوی دی."}, {"ref": "John 1:14", "text": "عیسی یو کوټی پیدا کړ او په هغه باندې سپور شو، لکه څنګه چې د خدای په کلام کې لیکل شوي دي:"}, {"ref": "John 1:14", "text": "که چېرې ما چې ستاسو بادار او استاذ یم ستاسو پښې ووینځلې، نو تاسو هم باید د یو بل پښې ووینځئ."}, {"ref": "John 1:14", "text": "که چېرې تاسو کوم څه زما په نوم زما نه وغواړئ نو زه به یې سرته رسوم. د روح القدس ورکولو وعده"}, {"ref": "John 1:14", "text": "که چېرې تاسو زما په حکمونو باندې عمل وکړئ نو بیا به تاسو زما ملګري یئ."}, {"ref": "John 1:14", "text": "هغه چې زما نه کوم تعلیم تر‌لاسه کوي، نو تاسو به ورباندې خبروي او په دې ډول به زما جلال ښکاره کوي."}, {"ref": "John 1:14", "text": "ما ستا کلام هغوی ته ورساوه خو د نړۍ خلکو د هغه نه کرکه وکړه، ځکه چې هغوی د دې نړۍ نه دي لکه څنګه چې زه د دې نړۍ نه یم."}, {"ref": "John 1:14", "text": "قیافا هماغه سړی ؤ چې یهودیانو مشرانو ته یې مشوره ورکړې وه چې په دې کې به د هغوی خیر وي چې یو کس د ټول قوم په خاطر مړ شي. پطروس د عیسی څخه انکار کوي (متي ۲۶‏:‌۶۹‌‏-‌۷۰ او مرقوس ۱۴‏:‌۶۶‌‏-‌۶۸ او لوقا ۲۲‏:‌۵۵‌‏-‌۵۷)"}, {"ref": "John 1:14", "text": "دا د فسحې د تیارولو ورځ وه او شاوخوا غرمه وه چې پیلاتوس خلکو ته وویل: «ګورئ، دا دی ستاسو پاچا!»"}, {"ref": "John 1:15", "text": "لکه څنګه چې ما پلار پېژني، زه هم پلار پېژنم او زه خپل ځان د پسونو دپاره قربانوم."}, {"ref": "John 1:15", "text": "خو زه ستاسو په خاطر خوشحاله یم چې هلته نه وم، ځکه چې تاسو به اوس په رښتیا ایمان راوړئ. راځئ چې هغه ته ورشو.»"}, {"ref": "John 1:15", "text": "«ای د صهیون خلکو، نور مه وېرېږئ! ګوره، ستا پاچا دی راروان هغه سپور دی په کوټي باندې.»"}, {"ref": "John 1:15", "text": "ما تاسو ته یو مثال درکړ، ترڅو تاسو د یو بل سره همداسې وکړئ لکه څنګه چې ما ستاسو دپاره وکړل."}, {"ref": "John 1:15", "text": "که چېرې تاسو زما سره مینه کوئ نو زما په حکمونو باندې به عمل کوئ"}, {"ref": "John 1:15", "text": "زه نور تاسو ته نوکران نه وایم، ځکه چې نوکران په دې نه پوهیږي چې بادار یې څه کوي، خو ما تاسو ته ملګري ویلي دي، ځکه ما چې هرڅه د خپل پلار نه اورېدلي دي هغه مې تاسو ته ویلي دي."}, {"ref": "John 1:15", "text": "څه چې د پلار سره دي هغه زما دي، نو په دې خاطر ما وویل هغه تعلیم چې روح القدس یې زما نه حاصلوي، تاسو به ورباندې خبروي.» ستاسو غم به په خوشحالۍ بدل شي"}, {"ref": "John 1:15", "text": "زه تاته دا دعا نه کوم چې هغوی د دې نړۍ نه لېرې کړې بلکې دا سوال کوم چې هغوی د شیطان نه وساتې."}, {"ref": "John 1:15", "text": "شمعون پطروس او یو بل شاګرد د لوی کاهن د کور تر حوېلۍ پورې عیسی پسې روان وو. څرنګه چې هغه شاګرد د لوی کاهن سره آشنایي لرله، نو هغه د عیسی سره د لوی کاهن د کور حوېلۍ ته ورننوت."}, {"ref": "John 1:15", "text": "هغوی بیا چیغې کړې: «هغه دې ووژل شي! هغه دې ووژل شي! په صلیب یې ځوړند کړه!» پیلاتوس د هغوی نه پوښتنه وکړه: «ایا غواړئ چې ستاسو پاچا په صلیب باندې ځوړند کړم؟» مشرانو کاهنانو ځواب ورکړ: «مونږ د امپراتور نه پرته بل پاچا نه لرو.»"}, {"ref": "John 1:16", "text": "زه نور پسونه هم لرم خو هغه د دې شپول نه دي، هغه هم باید راولم. هغوی به هم زما اواز اوري او یوه رمه به شي او شپون به یې هم یو وي."}, {"ref": "John 1:16", "text": "توما چې د غبرګوني په نوم هم یادېده، نورو شاګردانو ته وویل: «راځئ چې مونږ هم لاړ شو او د هغه سره مړه شو.» عیسی قیامت او ژوندون دی"}, {"ref": "John 1:16", "text": "په پیل کې شاګردان د دې شیانو په معنی باندې پوه نه شول، خو کله چې عیسی خپل جلال ته ورسېده، نو هغوی ته ور په یاد شول چې دا شیان د هغه په هکله لیکل شوي وو او د هغه سره همداسې وشول."}, {"ref": "John 1:16", "text": "په یقین سره زه تاسو ته دا وایم چې هېڅ یو نوکر د خپل بادار څخه لوی نه دی او هېڅ یو استازی د خپل رالېږونکي څخه لوی نه دی."}, {"ref": "John 1:16", "text": "او زه به د پلار نه غوښتنه وکړم او هغه به تاسو ته یو بل مرسته کوونکی درولېږي چې تل ترتله به ستاسو سره وي،"}, {"ref": "John 1:16", "text": "تاسو زه نه یم غوره کړی، بلکې ما تاسو غوره کړي یئ او دا کار مې درته سپارلی دی چې لاړ شئ او مېوه ونیسئ، داسې مېوه چې دوامداره وي. نو بیا چې تاسو هرڅه زما په نوم د پلار نه وغواړئ هغه به تاسو ته درکړي."}, {"ref": "John 1:16", "text": "عیسی خپلو شاګردانو ته وویل: «د لږ وخت دپاره به تاسو نور ما نه وینئ، خو لږه موده وروسته به مې بیا ووینئ.»"}, {"ref": "John 1:16", "text": "لکه څنګه چې زه د دې نړۍ نه یم نو هغوی هم د دې نړۍ نه دي."}, {"ref": "John 1:16", "text": "خو پطروس دباندې په دروازه کې ودرېده. بیا هغه بل شاګرد چې د لوی کاهن سره یې آشنایي لرله بېرته راووت او د هغې ښځې سره یې چې د دروازې ساتونکې وه خبرې وکړې او پطروس یې دننه بوته."}, {"ref": "John 1:16", "text": "نو بیا پیلاتوس عیسی هغوی ته وروسپاره چې په صلیب باندې یې ځوړند کړي. په صلیب باندې د عیسی مېخ کول (متي ۲۷‏:‌۳۲‌‏-‌۴۴ او مرقوس ۱۵‏:‌۲۱‌‏-‌۳۲ او لوقا ۲۳‏:‌۲۶‌‏-‌۴۳) نو هغوی عیسی لېرې بوتلو."}, {"ref": "John 1:17", "text": "پلار زما سره مینه کوي ځکه چې زه خپل ځان قربانوم د دې دپاره چې هغه بیا ومومم."}, {"ref": "John 1:17", "text": "کله چې عیسی هغه ځای ته ورسېده، څلور ورځې کېدلې چې د ایلعازر مړی په قبر کې ایښودل شوی ؤ."}, {"ref": "John 1:17", "text": "کله چې عیسی ایلعازر ته غږ وکړ او هغه یې راژوندی کړ او د قبر څخه یې راوویست، نو زیات شمېر خلک هلته موجود وو. هغوی چې څه لیدلي او اورېدلي وو د هغې په هکله یې نورو خلکو ته شاهدي ورکوله."}, {"ref": "John 1:17", "text": "اوس چې تاسو په دې شیانو باندې پوه شوئ، نو که عمل ورباندې وکړئ، نو تاسو بختور یئ."}, {"ref": "John 1:17", "text": "یعنې د حقیقت روح چې د نړۍ خلک یې نه شي منلی، ځکه چې هغه نه ویني او نه یې پېژني. خو تاسو یې پېژنئ، ځکه چې هغه ستاسو سره اوسي او په تاسو کې به وي."}, {"ref": "John 1:17", "text": "نو زه تاسو ته دا حکم کوم چې د یو بل سره مینه کوئ. د نړۍ خلک به ستاسو نه کرکه کوي"}, {"ref": "John 1:17", "text": "ځینو شاګردانو یو بل ته سره وویل: «د دې خبرې نه د هغه مقصد څه دی چې وایي: ‹د لږ وخت دپاره به تاسو ما ونه وینئ، خو لږه موده وروسته به مې ووینئ› او ‹دا ځکه چې زه پلار ته ورځم؟›»"}, {"ref": "John 1:17", "text": "هغوی د خپل کلام په وسیله چې رښتینی کلام دی، وقف کړه چې ستا خدمت وکړي."}, {"ref": "John 1:17", "text": "هغې چوکیدارې ښځې د پطروس نه پوښتنه وکړه: «ایا ته هم د دې سړي د شاګردانو څخه نه یې؟» پطروس ځواب ورکړ: «نه، زه نه یم.»"}, {"ref": "John 1:17", "text": "عیسی په داسې حال کې چې خپل صلیب یې په اوږه ؤ د ښار نه ووت او هغه ځای ته چې د سر د کوپړۍ په نوم یادېده او په آرامي ژبه ورته جلجتا وایي، لاړ."}, {"ref": "John 1:18", "text": "هېڅوک زما نه زما ژوند نه اخلي بلکې په خپله خوښه یې قرباني کوم. دا زما اختیار دی چې ځان قربان کړم او دا واک او اختیار لرم چې هغه بېرته لاسته راوړم. دا هغه څه دي چې پلار مې راته حکم کړی چې ویې کړم.»"}, {"ref": "John 1:18", "text": "بیت‌عنیا د اورشلیم نه شاوخوا درې کیلومتره لېرې ؤ"}, {"ref": "John 1:18", "text": "نو ګڼ شمېر خلک د هغه هرکلي ته ورغلل، ځکه چې هغوی اورېدلي وو چې عیسی دا معجزه ښودلې وه."}, {"ref": "John 1:18", "text": "زه ستاسو ټولو په هکله خبرې نه کوم، کوم خلک چې ما غوره کړي دي زه هغوی پېژنم. خو د خدای د کلام دا وینا باید رښتیا شي چې وایي: ‹هغه چا چې زما سره یې ډوډۍ خوړله زما په ضد راپورته شو.›"}, {"ref": "John 1:18", "text": "زه به تاسو لکه د یتیمانو په شان پرېنږدم، زه بېرته تاسو ته راځم."}, {"ref": "John 1:18", "text": "که چېرې د نړۍ خلک ستاسو نه کرکه کوي، نو پوه شئ چې ستاسو نه لومړی یې زما نه کرکه کړې ده."}, {"ref": "John 1:18", "text": "هغوی وویل: «د دې لږې مودې نه چې عیسی د هغې په هکله خبرې کوي مقصد څه دی؟ مونږ نه پوهېږو چې هغه د څه شي په هکله خبرې کوي.»"}, {"ref": "John 1:18", "text": "لکه څنګه چې تا زه نړۍ ته راولېږلم نو ما هم هغوی نړۍ ته لېږلي دي."}, {"ref": "John 1:18", "text": "نوکرانو او ساتونکو د سکرو اور بل کړی ؤ او ګردچاپېره ترې ولاړ وو او ځانونه یې تودول ځکه چې هوا سړه وه. پطروس هم د هغوی په څنګ کې ولاړ ؤ او ځان یې توداوه. لوی کاهن د عیسی نه څېړنې کوي (متي ۲۶‏:‌۵۹‌‏-‌۶۶ او مرقوس ۱۴‏:‌۵۵‌‏-‌۶۴ او لوقا ۲۲‏:‌۶۶‌‏-‌۷۱)"}, {"ref": "John 1:18", "text": "په هغه ځای کې هغوی عیسی په صلیب باندې مېخ کړ او د هغه سره یې دوه کسه نور هم چې یو یې یو اړخ او بل یې بل اړخ ته په صلیب باندې ځوړند کړل او عیسی د هغوی په منځ کې ؤ."}, {"ref": "John 1:19", "text": "د عیسی په دې خبرو یوځل بیا د یهودیانو ترمنځ اختلاف پیدا شو."}, {"ref": "John 1:19", "text": "او د اورشلیم نه د یهودیې ډېر خلک مرتا او مریم ته راغلي وو چې د هغوی د ورور د مړینې په خاطر ورته تسلي ورکړي،"}, {"ref": "John 1:19", "text": "نو بیا فریسیانو یو بل ته سره وویل: «تاسو ګورئ چې مونږ هېڅ نه شو کولای، ټوله نړۍ هغه پسې روانه ده.» ځینې یونانیان غواړي چې د عیسی سره خبرې وکړي"}, {"ref": "John 1:19", "text": "اوس زه تاسو ته د هغې پېښې د رامنځته کېدلو نه مخکې وایم، د دې دپاره کله چې هغه پېښه وشي، نو تاسو به په دې ایمان راوړئ چې زه هماغه یم."}, {"ref": "John 1:19", "text": "لږ وخت وروسته به د نړۍ خلک نور ما ونه ویني خو تاسو به مې بیا وینئ. ځکه چې زه به راژوندی کېږم نو تاسو به هم ژوندي یئ."}, {"ref": "John 1:19", "text": "که چېرې تاسو د دې نړۍ وای نو تاسو به د دې نړۍ د خلکو سره مینه کولی، خو څرنګه چې تاسو د دې نړۍ نه یئ او تاسو مې د دې نړۍ نه غوره کړي یئ نو له همدې امله نړۍ ستاسو نه کرکه کوي."}, {"ref": "John 1:19", "text": "عیسی پوه شو چې هغوی غواړي په دې هکله ترې پوښتنه وکړي، نو هغوی ته یې وویل: «ایا تاسو په دې خاطر د یو بل نه پوښتنه کوئ چې زما د دې خبرې نه مقصد څه دی چې تاسو به د لږ وخت دپاره نور ما ونه وینئ، خو لږه موده وروسته به بیا ما ووینئ؟"}, {"ref": "John 1:19", "text": "ما خپل ځان وقف کړ چې ستا خدمت وکړم، د دې دپاره چې هغوی هم په رښتیا سره ستا خدمت ته وقف شي."}, {"ref": "John 1:19", "text": "لوی کاهن د عیسی نه د هغه د شاګردانو او د هغه د تعلیم په هکله پوښتنه وکړه."}, {"ref": "John 1:19", "text": "پیلاتوس امر وکړ چې په یوه تخته باندې دې ولیکل شي: «عیسی ناصري د یهودیانو پاچا» او د صلیب په سر باندې دې ولګول شي."}, {"ref": "John 1:20", "text": "په هغو کې ډېرو وویل: «هغه پېرانو نیولی دی او لېونی دی. ولې د هغه خبرو ته غوږ نیسئ؟»"}, {"ref": "John 1:20", "text": "نو کله چې مرتا د عیسی د راتللو څخه خبره شوه، د هغه مخې ته ورغله، خو مریم په کور کې پاتې شوه."}, {"ref": "John 1:20", "text": "په اختر کې چې د عبادت دپاره اورشلیم ته کوم خلک راغلي وو په هغوی کې ځینې یونانیان هم وو."}, {"ref": "John 1:20", "text": "په یقین سره زه تاسو ته دا وایم څوک چې هغه کس قبول کړي چې زه یې لېږم، نو زه یې قبول کړی یم او هرڅوک چې ما قبول کړي، نو هغه څوک یې قبول کړی چې زه یې رالېږلی یم.» د یهودا د خیانت په هکله د عیسی پېشګویي (متي ۲۶‏:‌۲۰‌‏-‌۲۵ او مرقوس ۱۴‏:‌۱۷‌‏-‌۲۱ او لوقا ۲۲‏:‌۲۱‌‏-‌۲۳)"}, {"ref": "John 1:20", "text": "کله چې هغه ورځ راشي نو تاسو به پوه شئ چې زه په پلار کې یم، تاسو په ما کې یئ او زه په تاسو کې یم."}, {"ref": "John 1:20", "text": "ما چې کوم تعلیم تاسو ته درکړې دی هغه در په یاد کړئ چې یو نوکر د خپل بادار نه لوی نه دی. که هغوی زه ځورولی یم نو تاسو به هم وځوروي. که چېرې هغوی زما په تعلیم باندې عمل کړی وي نو ستاسو په تعلیم باندې به یې هم وکړي."}, {"ref": "John 1:20", "text": "په یقین سره زه تاسو ته دا وایم چې تاسو به ژاړئ او ویر به کوئ خو نړۍ به خوشحاله وي. تاسو به غمجن یئ، خو ستاسو غم به په خوشحالۍ بدل شي."}, {"ref": "John 1:20", "text": "زه یوازې د دې شاګردانو دپاره دعا نه کوم بلکې د هغو خلکو دپاره یې هم کوم چې د دوی د پیغام په وسیله په ما باندې ایمان راوړي."}, {"ref": "John 1:20", "text": "عیسی ځواب ورکړ: «ما د ټولو په مخکې ښکاره خبرې کړي دي. ما تل په کنیسو او د خدای په کور کې چې خلک په کې راټولیږي تعلیم ورکړی دی او هېڅکله مې پټې خبرې نه دي کړي."}, {"ref": "John 1:20", "text": "ډېرو یهودیانو دا لیکنه ولوستله، ځکه په کوم ځای کې چې عیسی په صلیب باندې ځوړند کړای شو هغه ښار ته نژدې ؤ. دا لوحه په آرامي، لاتینۍ او یونانۍ ژبو لیکل شوې وه."}, {"ref": "John 1:21", "text": "خو نورو به ویل: «څوک چې پېریانو نیولی وي هغه داسې خبرې نه شي کولای. ایا پېری کولای شي چې ړانده بینا کړي؟» یهودیان عیسی نه مني"}, {"ref": "John 1:21", "text": "مرتا عیسی ته وویل: «استاذه، که ته دلته وای، نو زما ورور به نه وای مړ شوی."}, {"ref": "John 1:21", "text": "هغوی فیلیپوس ته چې د جلیل د بیت‌صیدا ؤ، راغلل او ورته ویې ویل: «ای ښاغلیه، مونږ غواړو چې عیسی ووینو.»"}, {"ref": "John 1:21", "text": "کله چې عیسی دا خبرې وکړې، نو د هغه روح نا‌ارامه شو او په ښکاره یې وویل: «په یقین سره زه تاسو ته دا وایم چې په تاسو کې به یو کس زما سره خیانت وکړي.»"}, {"ref": "John 1:21", "text": "هرڅوک چې زما حکمونه مني او عمل ورباندې کوي نو دا هغه څوک دی چې زما سره مینه کوي. څوک چې زما سره مینه کوي نو زما پلار به ورسره مینه وکړي، او زه به هم د هغه سره مینه وکړم او خپل ځان به ورته ښکاره کړم.»"}, {"ref": "John 1:21", "text": "هغوی به ستاسو سره زما د نوم په خاطر دا هرڅه وکړي، ځکه چا چې زه رالېږلی یم هغوی هغه نه پېژني."}, {"ref": "John 1:21", "text": "یوه ښځه د ماشوم د زېږولو په وخت کې ډېر دردونه زغمي، خو کله چې ماشوم پیدا شي، نو هغه خپل دردونه هېروي، ځکه چې هغه خوشحاله وي چې یو انسان یې نړۍ ته راوړی دی."}, {"ref": "John 1:21", "text": "زه دعا کوم چې هغوی دې سره یو وي. ای پلاره، لکه څنګه چې ته په ما کې یې نو پرېږده چې هغوی دې هم په مونږ کې وي، ترڅو د نړۍ خلک په دې باندې ایمان ولري چې زه تا رالېږلی یم."}, {"ref": "John 1:21", "text": "نو بیا ولې زما نه پوښتنه کوې؟ د هغو خلکو نه پوښتنه وکړه چې زما خبرې یې اورېدلي دي. هغوی پوهیږي چې ما څه ویلي دي.»"}, {"ref": "John 1:21", "text": "د یهودیانو مشرانو کاهنانو پیلاتوس ته وویل: «تا ولې ولیکل چې هغه د یهودیانو پاچا دی؟ تا باید لیکلي وای چې هغه دعوه کوي چې د یهودیانو پاچا دی.»"}, {"ref": "John 1:22", "text": "دا د ژمي وخت ؤ او په اورشلیم کې د خدای د کور د وقف کېدلو اختر ؤ."}, {"ref": "John 1:22", "text": "خو زه اوس هم په دې پوهېږم چې که ته د خدای څخه هرڅه وغواړې، نو خدای به یې درکړي.»"}, {"ref": "John 1:22", "text": "فیلیپوس لاړ او اندریاس ته یې وویل او هغوی دواړه لاړل چې عیسی خبر کړي."}, {"ref": "John 1:22", "text": "شاګردانو یو بل ته وکتل او شکمن شول چې هغه د چا په هکله خبرې کوي."}, {"ref": "John 1:22", "text": "یهودا (دا اسخریوتي یهودا نه دی) هغه ته وویل: «استاذه، ته ولې غواړې چې خپل ځان دې یوازې مونږ ته ښکاره کړې او د نړۍ خلکو ته نه؟»"}, {"ref": "John 1:22", "text": "که چېرې زه نه وای راغلی او د هغوی سره مې خبرې نه وای کړې نو هغوی به ګناهکار نه وای. خو اوس د هغوی سره د خپلې ګناه دپاره کومه بهانه نشته."}, {"ref": "John 1:22", "text": "تاسو هم اوس غمجن یئ، خو زه به بیا تاسو ووینم او زړونه به مو خوشحاله شي او هېڅوک نه شي کولای چې دا خوشحالي ستاسو نه واخلي."}, {"ref": "John 1:22", "text": "کوم جلال چې تا ماته راکړی ؤ هغه ما هغوی ته ورکړ، ترڅو هغوی سره یو وي لکه څنګه چې زه او ته سره یو یو."}, {"ref": "John 1:22", "text": "کله چې عیسی دا خبره وکړه نو د خدای د کور یو ساتونکي چې په هغه ځای کې ولاړ ؤ، عیسی ته په مخ څپېړه ورکړه او ویې ویل: «ته څنګه لوی کاهن ته داسې ځواب ورکوې؟»"}, {"ref": "John 1:22", "text": "پیلاتوس ځواب ورکړ: «هرڅه چې ما لیکلي دي، لیکلي مې دي.»"}, {"ref": "John 1:23", "text": "عیسی د خدای د کور په یوځای کې چې د سلیمان د برنډې په نوم یادېده، ګرځېده."}, {"ref": "John 1:23", "text": "عیسی هغې ته وویل: «ستا ورور به بېرته راژوندی شي.»"}, {"ref": "John 1:23", "text": "عیسی هغوی ته وویل: «اوس هغه وخت رارسېدلی دی چې د انسان زوی جلال ومومي."}, {"ref": "John 1:23", "text": "په شاګردانو کې یو یې چې په عیسی باندې ډېر ګران ؤ د هغه په څنګ کې ناست ؤ."}, {"ref": "John 1:23", "text": "عیسی په ځواب کې وویل: «هرڅوک چې زما سره مینه کوي نو هغه به زما په تعلیم باندې عمل کوي. زما پلار به د هغه سره مینه کوي او زه او پلار به هغه ته ورځو او د هغه سره به اوسېږو."}, {"ref": "John 1:23", "text": "څوک چې زما نه کرکه کوي نو هغه زما د پلار نه هم کرکه کوي."}, {"ref": "John 1:23", "text": "کله چې هغه ورځ راشي نو تاسو به زما نه هېڅ سوال نه کوئ. په یقین سره زه تاسو ته دا وایم چې که چېرې تاسو زما په نوم د پلار نه هرڅه وغواړئ نو تاسو ته به یې درکړي."}, {"ref": "John 1:23", "text": "زه په هغوی کې اوسېږم او ته په ما کې اوسېږې، ترڅو هغوی په پوره توګه سره یو وي او د نړۍ خلک په دې پوه شي چې زه تا رالېږلی یم او د هغوی سره دومره مینه کوې لکه څنګه چې زما سره یې کوې."}, {"ref": "John 1:23", "text": "عیسی ځواب ورکړ: «که غلطه خبره مې کړې وي نو ثابته یې کړه او که سمه خبره مې کړې وي نو ولې مې وهې؟»"}, {"ref": "John 1:23", "text": "کله چې عسکرو عیسی په صلیب باندې ځوړند کړ نو د هغه کالي یې راواخیستل او په څلورو برخو یې سره ووېشل، هر یو عسکر یوه برخه واخیستله او د هغه کمیس یې هم واخیست. دا کمیس د پاس نه نیولې تر ښکته پورې د یوې ټوټې نه اوبدل شوې ؤ او هېڅ درز په کې نه ؤ."}, {"ref": "John 1:24", "text": "خلک د هغه نه ګردچاپېره راټول شول او ورته ویې ویل: «ترڅو پورې به مونږ پرېږدې چې شکمن واوسو؟ که چېرې ته مسیح یې نو مونږ ته یې ښکاره ووایه.»"}, {"ref": "John 1:24", "text": "مرتا وویل: «زه پوهېږم چې هغه به د قیامت په ورځ راژوندی شي.»"}, {"ref": "John 1:24", "text": "په یقین سره زه تاسو ته دا وایم چې که د غنمو یوه دانه په خاوره کې ونه لویږي او له منځه لاړه نه شي، نو هغه به هماغه یوه دانه پاتې شي. خو که چېرې هغه له منځه لاړه شي نو ډېرې غلې دانې به راوړي."}, {"ref": "John 1:24", "text": "شمعون پطروس هغه شاګرد ته اشاره وکړه او ورته ویې ویل: «د عیسی نه پوښتنه وکړه چې هغه د چا په هکله خبرې کوي.»"}, {"ref": "John 1:24", "text": "خو څوک چې زما سره مینه نه کوي هغه زما په تعلیم باندې عمل نه کوي. کوم تعلیم چې تاسو یې اورئ هغه زما تعلیم نه دی بلکې زما د پلار تعلیم دی چې زه یې رالېږلی یم."}, {"ref": "John 1:24", "text": "که چېرې ما د هغوی په منځ کې داسې کارونه چې کوم بل چا هېڅکله کړي نه دي، نه وای کړي نو هغوی به ګناهکاره نه وای، خو هغوی دا کارونه لیدلي دي او بیاهم هغوی زما او زما د پلار نه کرکه کوي."}, {"ref": "John 1:24", "text": "تر‌اوسه پورې تاسو زما په نوم هېڅ شی نه دی غوښتی، وغواړئ نو تاسو ته به درکړل شي، ترڅو ستاسو خوشحالي پوره شي. په نړۍ باندې بری موندل"}, {"ref": "John 1:24", "text": "ای پلاره، کوم خلک چې تا ماته راکړي دي زه غواړم چېرته چې زه یم هغوی دې هم زما سره وي، ترڅو زما جلال وویني چې تا ماته راکړی، ځکه تا د نړۍ د پیدایښت نه مخکې ما سره مینه کړې ده."}, {"ref": "John 1:24", "text": "بیا حناس هغه لاس تړلی لوی کاهن قیافا ته ولېږه. پطروس یوځل بیا د عیسی نه انکار کوي (متي ۲۶‏:‌۷۱‌‏-‌۷۵ او مرقوس ۱۴‏:‌۶۹‌‏-‌۷۲ او لوقا ۲۲‏:‌۵۸‌‏-‌۶۲)"}, {"ref": "John 1:24", "text": "نو عسکرو یو بل ته سره وویل: «راځئ چې دا څېرې نه کړو او پچه ورباندې واچوو او وګورو چې د چا کیږي.» داسې وشول ترڅو د خدای کلام هغه لیکنه رښتیا شي: «اچوي پچه دوی زما په جامو او وېشي یې په خپل منځ کې.» نو عسکرو همدا کار وکړ."}, {"ref": "John 1:25", "text": "عیسی ځواب ورکړ: «ما تاسو ته وویل خو تاسو پرې باور نه کوئ. زه چې د خپل پلار په نوم کوم کارونه کوم هغه زما په هکله شاهدي ورکوي."}, {"ref": "John 1:25", "text": "عیسی هغې ته وویل: «زه قیامت او ژوندون یم. که څوک په ما باندې ایمان راوړي که هغه مړ هم شي، خو بیا به هم ژوندی وي،"}, {"ref": "John 1:25", "text": "په چا باندې چې په دې نړۍ کې خپل ځان ګران وي نو هغه به له لاسه ورکړي. خو که څوک په نړۍ کې د خپل ځان نه تېر شي، نو هغه به تل ترتله خپل ژوند وساتي."}, {"ref": "John 1:25", "text": "نو هغه شاګرد عیسی ته ورنژدې شو او پوښتنه یې ترې وکړه: «استاذه، هغه څوک دی؟»"}, {"ref": "John 1:25", "text": "تر هغې پورې چې زه ستاسو سره یم دا خبرې درته کوم."}, {"ref": "John 1:25", "text": "خو د هغوی په شریعت کې چې کوم څه لیکل شوي دي هغه باید رښتیا شي: هغوی بې له کوم دلیله زما نه کرکه کوله."}, {"ref": "John 1:25", "text": "ما تاسو ته په مثالونو کې خبرې کولې، خو داسې وخت به راشي چې نور به تاسو ته په مثالونو کې خبرې نه کوم، بلکې په ښکاره توګه به تاسو ته د پلار په هکله خبرې کوم."}, {"ref": "John 1:25", "text": "ای عادل پلاره! نړۍ ته ونه پېژندلې، خو ما پېژندلی یې او دوی پوهیږي چې تا زه رالېږلی یم."}, {"ref": "John 1:25", "text": "په دې وخت کې شمعون پطروس په هغه ځای کې ولاړ ؤ او ځان یې توداوه، نو ځینو خلکو چې هلته ولاړ وو ورڅخه پوښتنه وکړه: «ایا ته هم د هغه د شاګردانو څخه نه یې؟» خو پطروس منکر شو او ویې ویل: «نه، زه نه یم»"}, {"ref": "John 1:25", "text": "د هغه صلیب څنګ ته چې عیسی ورباندې مېخ کړای شوی ؤ، د عیسی مور، د هغه ترور، مریم چې د کلوپاس ښځه وه او مریم مجدلیه ولاړې وې."}, {"ref": "John 1:26", "text": "خو تاسو پرې باور نه کوئ ځکه چې تاسو زما پسونه نه یئ."}, {"ref": "John 1:26", "text": "او که څوک ژوندی وي او په ما باندې ایمان راوړي، نو هغه به هېڅکله هم مړ نه شي. ایا په دې باندې باور کوې؟»"}, {"ref": "John 1:26", "text": "که څوک غواړي چې زما خدمت وکړي، نو هغه دې ما پسې راځي او چېرته چې زه یم نو زما خدمتګار به هم هلته وي. څوک چې زما خدمت کوي نو زما پلار به هغه سرلوړی کړي. عیسی د خپل مرګ په هکله خبرې کوي"}, {"ref": "John 1:26", "text": "عیسی ځواب ورکړ: «دا هغه سړی دی چې زه لږه ډوډۍ په کاسه کې لمدوم او ورته یې ورکوم.» نو هغه لږه ډوډۍ په کاسه کې لمده کړه او د شمعون اسخریوتي زوی یهودا ته یې ورکړه."}, {"ref": "John 1:26", "text": "خو ستاسو مرسته کوونکی یعنې روح القدس چې پلار به یې زما په نوم راولېږي، هغه به ټول شیان تاسو ته درزده کړي او هرڅه چې ما درته ویلي دي هغه به در په یاد کړي."}, {"ref": "John 1:26", "text": "خو کله چې ستاسو مرسته کوونکی چې زه به یې د پلار له خوا نه تاسو ته درلېږم، راشي یعنې د حقیقت روح چې د خدای له خوا راځي، هغه به زما په هکله شاهدي ورکړي."}, {"ref": "John 1:26", "text": "کله چې هغه ورځ راشي نو تاسو به زما په نوم هغه ته سوال کوئ او ماته به د دې اړتیا نه وي چې ستاسو په خاطر هغه ته خواست وکړم،"}, {"ref": "John 1:26", "text": "ما ته هغوی ته وروپېژندلې چې ته څوک یې او نور به دې هم وروپېژنم، ترڅو هغه مینه چې ته یې په ما کې لرې په هغوی کې یې هم ولرې او زه به په هغوی کې اوسم.»"}, {"ref": "John 1:26", "text": "د لوی کاهن د نوکرانو نه یو کس چې د هغه سړي خپلوان ؤ چې پطروس یې ورته غوږ پرې کړی ؤ، هغه ته وویل: «ایا ته مې د هغه سره په باغ کې ونه لیدلې؟»"}, {"ref": "John 1:26", "text": "کله چې عیسی خپله مور ولیدله چې د هماغه شاګرد په خوا کې چې په هغه باندې ګران ؤ ولاړه وه، نو هغې ته یې وویل: «مور جانې! دا ستا زوی دی.»"}, {"ref": "John 1:27", "text": "زما پسونه زما اواز پېژني او زه هغوی پېژنم او هغوی ما پسې راځي."}, {"ref": "John 1:27", "text": "هغې وویل: «هو، استاذه! زه په دې ایمان لرم چې ته مسیح یعنې د خدای زوی یې، د چا په هکله چې خدای ویلي دي چې هغه باید نړۍ ته راشي.» عیسی ژاړي"}, {"ref": "John 1:27", "text": "اوس زما زړه نا‌ارامه دی. څه ووایم؟ ایا ووایم: ‹ای پلاره، ما د دې ساعت د کړاو او ځورېدنې نه وساته؟› خو زه دې نړۍ ته د دې دپاره راغلی یم چې وکړېږم."}, {"ref": "John 1:27", "text": "څنګه چې یهودا هغه لږه ډوډۍ واخیستله، نو شیطان یې وجود ته ورننوت. عیسی ورته وویل: «هرڅه چې کوې زر یې وکړه.»"}, {"ref": "John 1:27", "text": "زه تاسو ته سوله درکوم داسې سوله چې یوازې زه یې ورکولای شم. دا د هغې سولې په شان نه ده چې نړۍ یې ورکولای شي. نو څه چې پېښیږي، د هغې په هکله مه نا‌ارامه کېږئ او مه وېرېږئ."}, {"ref": "John 1:27", "text": "او تاسو به هم زما په هکله شاهدي ورکوئ، ځکه چې تاسو له پیل نه زما سره وئ."}, {"ref": "John 1:27", "text": "ځکه چې پلار په خپله تاسو سره مینه لري. ځکه چې تاسو ما سره مینه کوئ او په دې باندې تاسو ایمان راوړی دی چې زه د خدای له خوا راغلی یم."}, {"ref": "John 1:27", "text": "پطروس یوځل بیا منکر شو او په هماغه وخت کې چرګ اذان وکړ. د پیلاتوس په حضور کې د عیسی محاکمه کېدل (متي ۲۷‏:‌۱‌‏-‌۲، ۲۷‏:‌۱۱‌‏-‌۱۴ او مرقوس ۱۵‏:‌۱‌‏-‌۵ او لوقا ۲۳‏:‌۱‌‏-‌۵)"}, {"ref": "John 1:27", "text": "بیا یې هغه شاګرد ته وویل: «دا ستا مور ده.» او د هماغه وخت نه هغه شاګرد هغه د خپلې کورنۍ غړې وګڼله. د عیسی مړینه (متي ۲۷‏:‌۴۵‌‏-‌۵۶ او مرقوس ۱۵‏:‌۳۳‌‏-‌۴۱ او لوقا ۲۳‏:‌۴۴‌‏-‌۴۹)"}, {"ref": "John 1:28", "text": "زه هغوی ته تلپاتې ژوندون ورکوم او هغوی به هېڅکله هم هلاک نه شي او هېڅوک نه شي کولای چې هغوی په زوره راڅخه بوځي."}, {"ref": "John 1:28", "text": "کله چې مرتا دا خبره وکړه، نو لاړه او خپلې خور ته یې غږ وکړ او په پټه یې ورته وویل: «استاذ راغلی دی او تا غواړي.»"}, {"ref": "John 1:28", "text": "ای پلاره، خپل نوم ته جلال ورکړه!» هغه وخت د اسمان نه یو اواز راغی او ویې ویل: «ما جلال ورکړی دی او بیا به هم جلال ورکړم.»"}, {"ref": "John 1:28", "text": "کوم خلک چې ډوډۍ ته ناست وو د هغوی څخه هېڅوک پوه نه شو چې د دې خبرې نه د هغه مقصد څه ؤ."}, {"ref": "John 1:28", "text": "تاسو واورېدل چې ما وویل زه ځم خو بېرته تاسو ته راځم. که چېرې تاسو زما سره مینه کولای نو د دې خبرې په اورېدلو سره چې زه پلار ته ورځم، تاسو به خوشحاله شوي وای، ځکه چې پلار زما نه ډېر لوی دی."}, {"ref": "John 1:28", "text": "زه د پلار له خوا دې نړۍ ته راغلی یم او اوس نړۍ پرېږدم او پلار ته ورځم.»"}, {"ref": "John 1:28", "text": "سهار وختي هغوی عیسی د قیافا د کور نه د روم د والي ماڼۍ ته یووړ. یهودیان ماڼۍ ته وردننه نه شول، ځکه چې هغوی نه غوښتل چې په مذهبي توګه ناپاکه شي او وکولای شي د فسحې ډوډۍ وخوري."}, {"ref": "John 1:28", "text": "د هغه نه وروسته عیسی پوه شو چې ټول کارونه سرته رسېدلي دي او هغه وویل: «زه تږی یم.» په دې ډول د خدای د کلام وینا رښتیا شوه."}, {"ref": "John 1:29", "text": "زما پلار چې هغه خلک یې ماته راکړي دي هغه د ټولو نه لوی دی او هېڅوک نه شي کولای چې هغوی زما د پلار نه په زوره بوځي."}, {"ref": "John 1:29", "text": "کله چې مریم دا واورېدل، نو زر راپاڅېدله او عیسی ته ورغله."}, {"ref": "John 1:29", "text": "کوم خلک چې په هغه ځای کې ولاړ وو او دا اواز یې واورېد، نو ځینو یې وویل: «دا د تندر اواز ؤ.» خو نورو وویل: «فرښتې د هغه سره خبرې وکړې.»"}, {"ref": "John 1:29", "text": "څرنګه چې یهودا سره د پیسو ساتلو کڅوړه وه، نو ځینو شاګردانو دا ګومان وکړ چې عیسی هغه ته وویل چې لاړ شي او د اختر دپاره چې کوم څه په کار دي واخلي او یا غریبانو ته کوم څه ورکړي."}, {"ref": "John 1:29", "text": "مخکې له دې چې دا کار وشي تاسو ته مې وویل نو کله چې دا کار وشي، تاسو به ایمان راوړئ."}, {"ref": "John 1:29", "text": "بیا د عیسی شاګردانو وویل: «ته اوس ښکاره خبرې کوې او د مثالونو نه کار نه اخلې."}, {"ref": "John 1:29", "text": "نو والي پیلاتوس دباندې راووت او د هغوی نه یې پوښتنه وکړه: «تاسو په دې سړي باندې د څه شي تور لګوئ؟»"}, {"ref": "John 1:29", "text": "په هغه ځای کې د عادي شرابو نه ډک یو لوښی پروت ؤ. هغوی یو اسفنج په تروو شرابو باندې لوند کړ او د وېلنې د څانګې په سر یې کېښود او د هغه خولې ته یې ونیوه."}, {"ref": "John 1:30", "text": "زه او پلار یو یو.»"}, {"ref": "John 1:30", "text": "عیسی لا کلي ته رسېدلی نه ؤ او لا په هماغه ځای کې ؤ چې مرتا یې لیدلو ته ورغلې وه."}, {"ref": "John 1:30", "text": "خو عیسی هغوی ته وویل: «دا اواز زما په خاطر نه بلکې ستاسو په خاطر ؤ."}, {"ref": "John 1:30", "text": "څنګه چې یهودا هغه لږه ډوډۍ واخیستله نو سمدلاسه دباندې ووت. دا شپه وه. نوی حکم"}, {"ref": "John 1:30", "text": "زه نور زیات وخت نه لرم چې ستاسو سره خبرې وکړم، ځکه چې د دې نړۍ واکمن راروان دی. هغه په ما باندې هېڅ واک او اختیار نه لري،"}, {"ref": "John 1:30", "text": "اوس مونږ پوهېږو چې ته د هرڅه نه خبر یې او لازمه نه ده چې کوم څوک ستا نه د کوم شي په هکله پوښتنه وکړي. نو له همدې امله مونږ ایمان لرو چې ته د خدای له خوا راغلی یې.»"}, {"ref": "John 1:30", "text": "هغوی په ځواب کې وویل: «که هغه مجرم نه وای نو تاته به مو نه راوست.»"}, {"ref": "John 1:30", "text": "کله چې عیسی هغه تروه شراب وڅښل نو ویې ویل: «پوره شو!» بیا یې سر ټیټ کړ او خپل روح یې خدای ته وسپاره. عسکر عیسی په بغل کې په نېزه وهي"}, {"ref": "John 1:31", "text": "خلکو یوځل بیا تیږې راواخیستې چې هغه سنګسار کړي."}, {"ref": "John 1:31", "text": "کوم خلک چې مریم ته د تسلۍ ورکولو دپاره راغلي وو او د هغې په کور کې وو، نو کله یې چې ولیدل چې هغه په بیړه له کوره وځي نو هغې پسې روان شول. هغوی فکر کاوه چې هغه قبر ته روانه ده چې هلته وژاړي."}, {"ref": "John 1:31", "text": "اوس د دې وخت رارسېدلی چې خدای به د نړۍ د خلکو په هکله قضاوت کوي او د دې نړۍ واکمن یعنې شیطان به شړل کیږي."}, {"ref": "John 1:31", "text": "کله چې یهودا لاړ، نو عیسی وویل: «اوس به د خدای زوی جلال ومومي او د هغه په وسیله به خدای جلال مومي."}, {"ref": "John 1:31", "text": "خو نړۍ باید په دې پوه شي چې زه د پلار سره مینه کوم، نو هماغه کار کوم چې هغه یې راته حکم کوي. اوس راځئ چې د دې ځای نه لاړ شو."}, {"ref": "John 1:31", "text": "عیسی هغوی ته وویل: «ایا تاسو اوس په ما باندې پوره ایمان لرئ؟"}, {"ref": "John 1:31", "text": "پیلاتوس وویل: «هغه بوځئ او د خپل قانون له مخې یې محاکمه کړئ.» یهودیانو ورته وویل: «مونږ ته اجازه نشته چې څوک مړ کړو.»"}, {"ref": "John 1:31", "text": "څرنګه چې دا د فسحې د تیارلو ورځ وه او یهودیانو نه غوښتل چې په صلیب باندې د ځوړند شویو مړي د هغه ځانګړي سبت په ورځ پاتې شي، نو هغوی د پیلاتوس نه وغوښتل چې د هغوی پښې ماتې کړي او کله چې هغوی مړه شي نو د صلیب نه یې راښکته کړي."}, {"ref": "John 1:32", "text": "عیسی هغوی ته وویل: «ما تاسو ته د پلار له خوا ډېر ښه کارونه وکړل. تاسو د هغو نه د کومې یوې په خاطر ما سنګساروئ؟»"}, {"ref": "John 1:32", "text": "مریم هغه ځای ته ورسېدله چې عیسی په کې ؤ او څنګه یې چې هغه ولیده، نو پښو ته یې پرېوتله او ویې ویل: «استاذه، که ته دلته وای، نو زما ورور به نه وای مړ شوی.»"}, {"ref": "John 1:32", "text": "کله چې زه د ځمکې نه پورته وخېژول شم، نو ټول انسانان به خپل ځان ته راکاږم.»"}, {"ref": "John 1:32", "text": "څرنګه چې خدای د هغه په وسیله جلال مومي نو خدای به په خپله هم هغه ته جلال ورکړي او ډېر زر به ورته جلال ورکړي."}, {"ref": "John 1:32", "text": "ګورئ، هغه وخت راروان دی او بلکې رارسېدلی دی چې تاسو ټول به خواره واره شئ او خپلو کورونو ته به لاړ شئ او ما به یوازې پرېږدئ. خو بیاهم زه یوازې نه یم، ځکه چې پلار راسره دی."}, {"ref": "John 1:32", "text": "په دې ډول د عیسی هغه خبره رښتیا شوه چې ویلي یې وو چې هغه به په کوم ډول مرګ مړ شي."}, {"ref": "John 1:32", "text": "نو عسکر راغلل او د لومړني سړي پښې یې چې د عیسی سره په صلیب ځوړند کړای شوی ؤ، ماتې کړې او بیا یې د هغه بل سړي پښې ماتې کړې."}, {"ref": "John 1:33", "text": "هغوی ورته ځواب ورکړ: «مونږ تا د کوم نېک کار په خاطر نه سنګساروو، بلکې د کفر ویلو په خاطر. ځکه چې ته یوازې یو انسان یې، خو د خدایۍ دعوه کوې.»"}, {"ref": "John 1:33", "text": "کله چې عیسی هغه ولیدله چې ژاړي او همدارنګه کوم خلک چې د هغې سره راغلي وو هم ژاړي، نو سوړ اوسېلی یې وویست او ډېر خفه شو"}, {"ref": "John 1:33", "text": "د عیسی د خبرې اشاره دې ته وه چې هغه به په څه قسم مرګ مړ کیږي."}, {"ref": "John 1:33", "text": "زما بچیانو! زه به د لږ نور وخت دپاره ستاسو سره یم. بیا به ما پسې ګرځئ او پیدا کولای به مې نه شئ او لکه څنګه چې مې یهودي مشرانو ته وویل، اوس یې تاسو ته هم وایم، زه چې چېرته ځم هلته تاسو نه شئ تللی."}, {"ref": "John 1:33", "text": "ما دا هرڅه د دې دپاره تاسو ته وویل ترڅو په ما کې ارامي ولرئ. په دې نړۍ کې به تاسو ځورېږئ او کړېږئ. خو زړور اوسئ! ځکه چې زه په نړۍ باندې بریالی شوی یم.»"}, {"ref": "John 1:33", "text": "پیلاتوس بېرته ماڼۍ ته ننوت او عیسی یې راوغوښت او پوښتنه یې ترې وکړه: «ایا ته د یهودیانو پاچا یې؟»"}, {"ref": "John 1:33", "text": "خو کله چې عیسی ته راغلل نو ویې لیدل چې هغه لا مخکې مړ شوی دی، نو د هغه پښې یې ماتې نه کړې."}, {"ref": "John 1:34", "text": "عیسی هغوی ته په ځواب کې وویل: «ایا ستاسو په شریعت کې نه دي لیکل شوي چې خدای وویل: ‹تاسو خدایان یئ؟›"}, {"ref": "John 1:34", "text": "او د هغوی نه یې پوښتنه وکړه: «د هغه قبر چېرته دی؟» هغوی ځواب ورکړ: «ښاغلیه، راشه او ویې ګوره.»"}, {"ref": "John 1:34", "text": "خلکو عیسی ته وویل: «زمونږ شریعت وایي چې مسیح به تل ترتله ژوندی وي. نو بیا ته څنګه ویلی شې چې د انسان زوی باید پورته وخېژول شي؟ دا د انسان زوی څوک دی؟»"}, {"ref": "John 1:34", "text": "زه تاسو ته نوی حکم درکوم: د یو بل سره مینه کوئ، لکه څنګه چې ما ستاسو سره کړې ده، نو تاسو هم باید د یو بل سره مینه وکړئ."}, {"ref": "John 1:34", "text": "عیسی ځواب ورکړ: «ایا ته د خپل ځانه دا خبره کوې یا نورو درته زما په هکله ویلي دي؟»"}, {"ref": "John 1:34", "text": "خو یو عسکر عیسی په نېزه باندې په بغل کې وواهه او سمدلاسه یې د بدن نه وینې او اوبه راوبهېدلې."}, {"ref": "John 1:35", "text": "مونږ پوهېږو چې د خدای کلام نه شي بدلېدلی. نو که چېرې خدای هغه خلک چې د هغه پیغام ورته رسېدلی دی خدایان بللي دي،"}, {"ref": "John 1:35", "text": "عیسی په ژړا شو."}, {"ref": "John 1:35", "text": "عیسی هغوی ته وویل: «ستاسو سره د لږ نور وخت دپاره رڼا شته. ترڅو پورې چې دا رڼا ستاسو سره ده نو تاسو ګرځئ، هسې نه چې تیاره درباندې راشي. ځکه څوک چې په تیاره کې ګرځي هغه نه پوهیږي چې چېرته روان دی."}, {"ref": "John 1:35", "text": "که تاسو یو د بل سره مینه ولرئ، نو بیا به ټول په دې پوه شي چې تاسو زما شاګردان یئ.» د پطروس د منکرېدلو په هکله د عیسی پېشګویي"}, {"ref": "John 1:35", "text": "پیلاتوس وویل: «ایا زه یهودي یم؟ ته دې خپل قوم او مشرانو کاهنانو ماته راوستلی یې. تا څه کړي دي؟»"}, {"ref": "John 1:35", "text": "یو سړی چې په خپله د دې پېښې شاهد ؤ دغه شاهدي ورکوي او د هغه شاهدي رښتیا ده. هغه پوهیږي چې د څه په هکله خبرې کوي او هغه رښتیا وایي ترڅو تاسو هم ایمان راوړئ."}, {"ref": "John 1:36", "text": "نو بیا تاسو ولې په ما باندې د کفر ویلو تور لګوئ چې کله وایم چې زه د خدای زوی یم؟ لکه څنګه چې پلار زه وقف کړی یم او نړۍ ته یې رالېږلی یم."}, {"ref": "John 1:36", "text": "بیا خلکو وویل: «وګورئ هغه ورباندې څومره ګران ؤ.»"}, {"ref": "John 1:36", "text": "تر هغې پورې چې رڼا درسره ده، نو په رڼا باندې ایمان راوړئ د دې دپاره چې تاسو د رڼا بچیان شئ.» کله چې عیسی خپلې خبرې پای ته ورسولې، نو لاړ او د هغوی نه پټ شو. ډېرو خلکو په عیسی باندې ایمان رانه وړ"}, {"ref": "John 1:36", "text": "شمعون پطروس د هغه نه پوښتنه وکړه: «استاذه، ته چېرته ځې؟» عیسی ځواب ورکړ: «زه چې کوم ځای ته ځم ته اوس هلته ما پسې نه شې راتللی، خو وروسته به راشې.»"}, {"ref": "John 1:36", "text": "عیسی وویل: «زما پاچاهي د دې نړۍ پاچاهي نه ده. که زما پاچاهي د دې نړۍ پاچاهي وای، نو زما پیروانو به جنګ کړی وای، ترڅو زه یهودي مشرانو ته تسلیم نه شم. خو زما پاچاهي دنیاوي پاچاهي نه ده.»"}, {"ref": "John 1:36", "text": "همداسې وشول ترڅو د خدای د کلام وینا رښتیا شي چې وایي: «د هغه یو هډوکی به هم مات نه شي.»"}, {"ref": "John 1:37", "text": "که چېرې زه د خپل پلار کارونه نه کوم نو په ما باندې ایمان مه راوړئ."}, {"ref": "John 1:37", "text": "خو ځینو یې وویل: «دې سړي چې د هغه ړوند سړي سترګې بینا کړلې، ایا دا یې نه شو کولای چې ایلعازر یې د مرګ نه ژغورلی وای؟» ایلعازر راژوندی کیږي"}, {"ref": "John 1:37", "text": "سره له دې چې عیسی د هغوی په مخکې ډېرې معجزې وښودلې خو هغوی په هغه باندې ایمان رانه وړ،"}, {"ref": "John 1:37", "text": "پطروس وویل: «استاذه، اوس درپسې ولې نه شم درتلی؟ زه دې ته حاضر یم چې ستا په خاطر خپل ځان قربان کړم.»"}, {"ref": "John 1:37", "text": "پیلاتوس هغه ته وویل: «نو ته پاچا یې؟» عیسی ځواب ورکړ: «ته خپله وایې چې زه پاچا یم. زه د دې دپاره پیدا شوی یم او نړۍ ته راغلی یم چې د حقیقت په هکله شاهدي ورکړم او څوک چې حقیقت خوښوي هغه زما خبرو ته غوږ نیسي.»"}, {"ref": "John 1:37", "text": "او په بل ځای کې وایي: «هغوی به هغه سړي ته ګوري چې په نېزه باندې یې سوری کړ.» د عیسی ښخول (متي ۲۷‏:‌۵۷‌‏-‌۶۱ او مرقوس ۱۵‏:‌۴۲‌‏-‌۴۷ او لوقا ۲۳‏:‌۵۰‌‏-‌۵۶)"}, {"ref": "John 1:38", "text": "خو که چېرې زه هغه کارونه کوم چې پلار یې کوي، که بیاهم په ما باندې ایمان نه راوړئ نو لږ تر لږه زما په کارونو باندې خو ایمان راوړئ. بیا تاسو دا ومنئ او په دې پوه شئ چې پلار په ما کې دی او زه په پلار کې یم.»"}, {"ref": "John 1:38", "text": "عیسی یوځل بیا سوړ اوسېلی وویست او قبر ته ورغی. دا قبر یو غار ؤ چې خولې ته یې یوه تیږه ایښودل شوې وه."}, {"ref": "John 1:38", "text": "ترڅو د اشعیا پیغمبر هغه خبرې رښتیا شي چې ویلي یې وو: «ای څښتنه، چا زمونږ په پیغام باندې باور کړی دی؟ چاته څښتن خپل قدرت ښودلی دی؟»"}, {"ref": "John 1:38", "text": "عیسی ځواب ورکړ: «ایا ته حاضر یې چې زما په خاطر خپل ځان قربان کړې؟ په یقین سره زه تاته دا وایم چې د چرګ د اذان نه مخکې به درې ځلې ووایې چې ته ما نه پېژنې.»"}, {"ref": "John 1:38", "text": "پیلاتوس پوښتنه وکړه: «حقیقت څه دی؟» په عیسی باندې د مرګ حکم (متي ۲۷‏:‌۱۵‌‏-‌۳۱ او مرقوس ۱۵‏:‌۶‌‏-‌۲۰ او لوقا ۲۳‏:‌۱۳‌‏-‌۲۵) کله چې پیلاتوس دا وویل، هغه بېرته دباندې راووت، یهودي مشرانو ته لاړ او اعلان یې وکړ: «زه په ده کې کوم جرم نه وینم."}, {"ref": "John 1:38", "text": "وروسته له هغې یوسف چې د رامه د ښار څخه ؤ او په پټه د عیسی پیرو ؤ ځکه چې هغه د یهودیانو نه وېرېده، پیلاتوس ته ورغی او د هغه نه یې وغوښتل چې اجازه ورته ورکړي چې د عیسی مړی واخلي او ښخ یې کړي. پیلاتوس ورته اجازه ورکړه. نو هغه راغی او د عیسی مړی یې یووړ."}, {"ref": "John 1:39", "text": "هغوی یوځل بیا هڅه وکړه چې عیسی ونیسي، خو هغه د هغوی له نظره پناه شو."}, {"ref": "John 1:39", "text": "عیسی خلکو ته امر وکړ: «تیږه لېرې کړئ.» مرتا د مړ شوي سړي خور هغه ته وویل: «استاذه، اوس خو د هغه د مرګ څلور ورځې شوې دي او بوی به یې کړی وي.»"}, {"ref": "John 1:39", "text": "نو هغوی ونه شو کولای چې ایمان راوړي. اشعیا پیغمبر دا هم ویلي دي:"}, {"ref": "John 1:39", "text": "لکه څرنګه چې زه هر کال د فسحې د اختر په ورځ تاسو ته د زندان نه یو بندي خلاصوم. ایا تاسو غواړئ چې د یهودیانو پاچا درته ازاد کړم؟»"}, {"ref": "John 1:39", "text": "نیکودیموس یعنې هماغه سړی چې د شپې له خوا وختي د عیسی لیدلو ته ورغلی ؤ، هم راغی او د ځان سره یې د مر کنډ او د عود د بوټي څخه جوړه شوې مساله چې شاوخوا څلوردېرش کیلو وه، راوړه."}, {"ref": "John 1:40", "text": "بیا عیسی د اردن د سیند بلې غاړې ته پورې وت او هغه ځای ته لاړ چې مخکې یحیی په کې د تعمید غسل ورکاوه او هلته پاتې شو."}, {"ref": "John 1:40", "text": "عیسی هغې ته وویل: «ایا تاته مې نه وو ویلي چې که چېرې ته ایمان ولرې، نو د خدای جلال به ووینې؟»"}, {"ref": "John 1:40", "text": "«خدای د هغوی سترګې ړندې کړې دي، او د هغوی زړونه یې سخت کړي دي، چې په سترګو باندې څه ونه ویني او په زړونو کې ورباندې پوه نه شي او ماته را ونه ګرځي چې زه یې روغ کړم.»"}, {"ref": "John 1:40", "text": "هغوی بیا چیغې ووهلې: «نه، دا سړی نه غواړو، مونږ باراباس غواړو!» او باراباس یو داړه مار ؤ."}, {"ref": "John 1:40", "text": "هغوی دواړو د عیسی مړی یووړ او د یهودیانو د مړو د ښخولو د مراسمو له مخې یې د خوشبویه تېلو سره په کفن کې تاو کړ."}, {"ref": "John 1:41", "text": "ډېر خلک ورته راغلل او هغوی وویل: «یحیی هېڅکله کومه معجزه ونه ښودله، خو هغه چې هرڅه د دې سړي په هکله ویلي وو هغه رښتیا ؤ.»"}, {"ref": "John 1:41", "text": "نو خلکو تیږه لېرې کړه. بیا عیسی پورته اسمان ته وکتل او ویې ویل: «ای پلاره، زه ستا شکر کوم چې زما دعا دې واورېدله."}, {"ref": "John 1:41", "text": "اشعیا دا د دې دپاره وویل چې د عیسی جلال یې لیدلی ؤ او د هغه په هکله یې خبرې وکړې."}, {"ref": "John 1:41", "text": "په کوم ځای کې چې عیسی په صلیب باندې ځړول شوی ؤ هلته یو باغ ؤ او په هغه باغ کې یو نوی قبر ؤ چې تر هغه وخته پورې په کې څوک نه ؤ ښخ شوی."}, {"ref": "John 1:42", "text": "او په هغه ځای کې ډېرو خلکو په عیسی باندې ایمان راوړ."}, {"ref": "John 1:42", "text": "زه پوهېدم چې ته تل زما دعا اورې، خو ما دا د دې خلکو په خاطر چې دلته ولاړ دي وویل، ترڅو هغوی په دې باندې ایمان راوړي چې زه تا رالېږلی یم.»"}, {"ref": "John 1:42", "text": "سره له دې بیاهم ډېرو یهودي مشرانو په هغه باندې ایمان راوړ، خو د فریسیانو له وېرې یې د خپل ایمان راوړلو اقرار نه کاوه، هسې نه چې د کنیسې څخه یې وشړي،"}, {"ref": "John 1:42", "text": "څرنګه چې دا د فسحې د تیارولو ورځ وه او قبر هلته نژدې ؤ، نو هغوی د عیسی مړی هلته ښخ کړ."}, {"ref": "John 1:43", "text": "کله چې عیسی دعا خلاصه کړه، نو په لوړ اواز یې چیغه کړه: «ای ایلعازره، راووځه.»"}, {"ref": "John 1:43", "text": "ځکه چې هغوی د خدای له خوا د ستاینې په ځای د انسان ستاینه زیاته خوښوله. د عیسی د کلام په وسیله قضاوت"}, {"ref": "John 1:44", "text": "نو هغه مړی چې لاسونه او پښې یې په کفن کې تاو شوې وې او مخ یې په دستمال کې پټ ؤ، راووت. عیسی هغوی ته وویل: «هغه راخلاص کړئ او پرېږدئ چې لاړ شي.» د عیسی په خلاف دسیسه (متي ۲۶‏:‌۱‌‏-‌۵ او مرقوس ۱۴‏:‌۱‌‏-‌۲ او لوقا ۲۲‏:‌۱‌‏-‌۲)"}, {"ref": "John 1:44", "text": "نو عیسی په لوړ اواز وویل: «هرڅوک چې په ما باندې ایمان راوړي، نو هغه نه یوازې دا چې په ما باندې یې ایمان راوړی بلکې په هغه چا باندې یې هم راوړی دی چې زه یم رالېږلی یم."}, {"ref": "John 1:45", "text": "نو ډېرو خلکو چې د مریم لیدلو ته راغلي وو، کله چې هغوی هغه څه چې عیسی وکړل ولیدل، نو په هغه باندې یې ایمان راوړ."}, {"ref": "John 1:45", "text": "هرڅوک چې ما ویني، نو هغه څوک هم ویني چې زه یې رالېږلی یم."}, {"ref": "John 1:46", "text": "خو د هغوی څخه ځینې یې فریسیانو ته ورغلل او کوم کارونه چې عیسی کړي وو هغوی ته یې وویل."}, {"ref": "John 1:46", "text": "زه نړۍ ته لکه د یوې رڼا په شان راغلی یم د دې دپاره چې هرڅوک چې په ما باندې ایمان راوړي هغه په تیاره کې پاتې نه شي."}, {"ref": "John 1:47", "text": "بیا فریسیانو او مشرانو کاهنانو شورا راوغوښتله او ویې ویل: «څه باید وکړو؟ ځکه چې دا سړی ډېرې معجزې ښکاره کوي."}, {"ref": "John 1:47", "text": "خو که چېرې څوک زما خبرې واوري او عمل ورباندې ونه کړي، نو زه هغه نه محکوموم. زه نړۍ ته د دې دپاره راغلی یم چې خلک وژغورم، د دې دپاره نه یم راغلی چې هغوی محکوم کړم."}, {"ref": "John 1:48", "text": "که مونږ هغه پرېږدو چې همداسې کارونه وکړي نو ټول خلک به ورباندې ایمان راوړي، بیا به رومیان راشي او زمونږ د خدای کور او زمونږ ټول قوم به له منځه یوسي.»"}, {"ref": "John 1:48", "text": "هرڅوک چې ما رد کړي او زما خبرې ونه مني، نو د هغه دپاره قاضي شته، یعنې هغه تعلیم چې ما ورکړی دی هغه به د اخرت په ورځ ملامته کړي."}, {"ref": "John 1:49", "text": "خو په هغوی کې یو تن چې قیافا نومېده او په هغه کال لوی کاهن ؤ، وویل: «تاسو نه پوهېږئ!"}, {"ref": "John 1:49", "text": "ځکه چې زه له خپله ځانه خبرې نه کوم بلکې هغه پلار چې زه یې رالېږلی یم ماته دا حکم کړی دی چې څه ووایم او څنګه خبرې وکړم."}, {"ref": "John 1:50", "text": "په دې نه پوهېږئ چې ستاسو دپاره دا ښه ده چې یو کس د ټول قوم په خاطر مړ شي، نه دا چې ټول قوم تباه شي.»"}, {"ref": "John 1:50", "text": "زه پوهېږم چې د هغه حکم خلکو ته تلپاتې ژوندون ورکوي، نو ځکه زه چې څه وایم هماغه څه دي چې پلار راته ویلي دي چې ویې وایم.»"}, {"ref": "John 1:51", "text": "هغه دا خبره له خپله ځانه ونه کړه بلکې د دې دپاره چې هغه په هغه کال لوی کاهن ؤ، نو هغه پېشګویي وکړه چې عیسی به د یهودو د قوم په خاطر مړ شي،"}, {"ref": "John 1:52", "text": "او یوازې د هغه قوم دپاره نه بلکې د خدای ټول خواره واره اولادونه چې په مختلفو ځایونو کې اوسیږي سره یوځای کړي."}, {"ref": "John 1:53", "text": "نو د هماغې ورځې نه هغوی د عیسی د وژلو پرېکړه وکړه."}, {"ref": "John 1:54", "text": "له هغې وروسته عیسی نور د خلکو په منځ کې ښکاره نه ګرځېده بلکې د هغه ځای نه یوې سیمې ته چې دښتې ته نژدې وه، یعنې د افرایم په نوم ښار ته لاړ او د خپلو شاګردانو سره هلته پاتې شو."}, {"ref": "John 1:55", "text": "د یهودیانو د فسحې اختر نژدې ؤ او ډېر خلک د کلیوالي سیمو نه اورشلیم ته راغلل چې د اختر نه مخکې د پاکوالي مراسم سرته ورسوي."}, {"ref": "John 1:56", "text": "هغوی عیسی لټاوه او څنګه چې هغوی د خدای په کور کې سره راټول شول نو یو بل ته یې وویل: «تاسو څه فکر کوئ، ایا هغه به د اختر جشن ته رانه شي؟»"}, {"ref": "John 1:57", "text": "مشرانو کاهنانو او فریسیانو دا حکم کړی ؤ، که هرڅوک پوه شي چې عیسی چېرته دی، نو دوی ته دې خبر ورکړي چې هغه ونیسي."}, {"ref": "John 2:1", "text": "د یکشنبې په ورځ سهار وختي چې لا تیاره وه مریم مجدلیه قبر ته راغله او ویې لیدل چې د قبر د خولې نه تیږه لېرې شوې ده."}, {"ref": "John 2:1", "text": "څه موده وروسته عیسی یوځل بیا د تبریې د بحیرې په غاړه شاګردانو ته خپل ځان ښکاره کړ. هغه خپل ځان په دې ډول ښکاره کړ:"}, {"ref": "John 2:2", "text": "نو هغه په منډه منډه شمعون پطروس او هغه شاګرد ته چې په عیسی باندې ډېر ګران ؤ ورغله او هغوی ته یې وویل: «هغوی زمونږ د عیسی مړی د قبر نه وړی او مونږ نه پوهېږو چې په کوم ځای کې یې اچولی دی.»"}, {"ref": "John 2:2", "text": "شمعون پطروس او توما چې د غبرګوني په نوم یادېده، نتناییل چې د جلیل د قانا څخه ؤ، د زبدي دوه زامن او دوه نور شاګردان هم هلته وو."}, {"ref": "John 2:3", "text": "نو پطروس او هغه بل شاګرد ووتل او د قبر خواته لاړل."}, {"ref": "John 2:3", "text": "شمعون پطروس هغوی ته وویل: «زه ځم چې ماهیان ونیسم.» هغوی وویل: «مونږ هم درسره ځو.» هغوی روان شول او په کشتۍ کې سپاره شول، خو په هغه شپه یې هېڅ ونه نیول."}, {"ref": "John 2:4", "text": "هغوی دواړو منډې وهلې، خو هغه بل شاګرد د پطروس نه مخکې شو او د هغه نه لومړی قبر ته ورسېده."}, {"ref": "John 2:4", "text": "کله چې سهار شو نو عیسی د بحیرې په غاړه ولاړ ؤ، خو شاګردانو ونه پېژانده چې هغه عیسی دی."}, {"ref": "John 2:5", "text": "هغه قبر ته ورټیټ شو او دننه یې وکتل او کفن یې ولیده چې هلته پروت ؤ، خو قبر ته وردننه نه شو."}, {"ref": "John 2:5", "text": "عیسی هغوی ته نارې کړې: «ای ملګرو، کوم څه مو نیولي دي؟» هغوی ځواب ورکړ: «نه.»"}, {"ref": "John 2:6", "text": "بیا شمعون پطروس راورسېد او قبر ته ورننوت. هغه هم کفن ولیده چې هلته پروت ؤ،"}, {"ref": "John 2:6", "text": "عیسی هغوی ته وویل: «خپل جال مو د کشتۍ ښي خواته ورواچوئ نو یو څه ماهیان به ونیسئ.» نو هغوی جال ورواچاوه او دومره ډېر ماهیان یې ونیول چې دوی نه شو کولای چې جال بېرته کشتۍ ته راکاږي."}, {"ref": "John 2:7", "text": "او هغه دستمال چې د عیسی د سر نه تاو ؤ، هغه د کفن سره نه ؤ، بلکې هغه په خپله قات شوی ؤ او په بل ځای کې پروت ؤ."}, {"ref": "John 2:7", "text": "بیا هغه شاګرد چې په عیسی باندې ډېر ګران ؤ پطروس ته وویل: «هغه سړی چې د بحیرې په غاړه ولاړ دی، هغه زمونږ استاذ دی!» کله چې شمعون پطروس دا خبره واورېدله چې هغه عیسی دی، نو خپل لنګ یې وتاړه، ځکه چې هغه خپل لنګ ویستلی ؤ او اوبو ته یې ورټوپ کړ."}, {"ref": "John 2:8", "text": "بیا هغه بل شاګرد چې مخکې قبر ته رسېدلی ؤ، هم قبر ته ورننوت او چې کله یې هغه ولیده، نو باور یې وکړ،"}, {"ref": "John 2:8", "text": "نور شاګردان په کشتۍ کې د بحیرې غاړې ته راغلل او د ماهیانو ډک جال یې راکش کړ، ځکه چې هغوی د وچې نه شاوخوا سل متره لېرې وو."}, {"ref": "John 2:9", "text": "ځکه چې هغوی لا تر دې وخته پورې د خدای په کلام باندې پوه شوي نه وو چې ویلي یې وو چې عیسی باید د مړو نه بیا راژوندی شي."}, {"ref": "John 2:9", "text": "کله چې هغوی وچې ته راووتل، نو هلته یې د سکرو اور ولیده چې ماهي ورباندې پروت ؤ او لږه ډوډۍ هم وه."}, {"ref": "John 2:10", "text": "نو بیا هغه دواړه شاګردان بېرته کور ته لاړل. عیسی مریم مجدلیې ته ښکاره کیږي (متي ۲۸‏:‌۹، ۱۰ او مرقوس ۱۶‏:‌۹‌‏-‌۱۱)"}, {"ref": "John 2:10", "text": "عیسی هغوی ته وویل: «د خپلو ماهیانو نه چې همدا‌اوس مو ونیول لږ څه راوړئ.»"}, {"ref": "John 2:11", "text": "خو مریم د قبر نه دباندې ولاړه وه او ژړل یې. هغې لا ژړل چې ټیټه شوه او دننه قبر ته یې وکتل"}, {"ref": "John 2:11", "text": "شمعون پطروس بېرته کشتۍ ته وخوت او جال یې وچې ته راوویست چې په کې یوسلو دري پنځوس غټ ماهیان وو، خو د دومره زیاتو ماهیانو سره بیاهم جال ونه شلېده."}, {"ref": "John 2:12", "text": "او دوه فرښتې یې په سپینو کالیو کې ولیدلې چې په هغه ځای کې چې د عیسی مړی پروت ؤ یوه یې سرته او بله یې پښو ته ناسته وه."}, {"ref": "John 2:12", "text": "عیسی هغوی ته وویل: «راشئ د سهار ډوډۍ وخورئ.» په شاګردانو کې هېچا هم دا جرات ونه کړ چې د هغه نه پوښتنه وکړي: «ته څوک یې؟» ځکه چې هغوی پوهېدل چې دا د هغوی استاذ دی."}, {"ref": "John 2:13", "text": "هغوی د هغې نه پوښتنه وکړه: «ای ښځې، ته ولې ژاړې؟» هغې ورته وویل: «ځکه چې هغوی زما د استاذ مړی وړی دی او زه نه پوهېږم چې چېرته یې اچولی دی.»"}, {"ref": "John 2:13", "text": "نو عیسی راوړاندې شو، ډوډۍ یې راواخیستله او هغوی ته یې ورکړه او ماهیان یې هم ورکړل."}, {"ref": "John 2:14", "text": "کله چې هغې دا خبره وکړه نو مخ یې راواړاوه او عیسی یې ولیده چې هلته ولاړ دی، خو هغې ونه پېژانده چې دا عیسی دی."}, {"ref": "John 2:14", "text": "دا درېم ځل ؤ چې عیسی د مړو نه د راژوندي کېدلو نه وروسته شاګردانو ته ښکاره شو. عیسی او پطروس"}, {"ref": "John 2:15", "text": "عیسی هغې ته وویل: «ای خورې، ته ولې ژاړې؟ څوک لټوې؟» هغې دا ګومان وکړ چې ګوندې هغه باغوان دی نو ورته ویې ویل: «ښاغلیه، که چېرې تا د هغه مړی وړی وي نو ماته ووایه چې هغه دې په کوم ځای کې اچولی دی چې زه لاړه شم او هغه راپیدا کړم.»"}, {"ref": "John 2:15", "text": "د ډوډۍ خوړلو نه وروسته عیسی د شمعون پطروس نه پوښتنه وکړه: «ای د یوحنا زویه شمعونه، ته د دې نورو نه زما سره زیاته مینه کوې؟» پطروس ځواب ورکړ: «هو، استاذه، ته پوهېږې چې په ما باندې ګران یې.» عیسی وویل: «زما په وریو باندې پام کوه.»"}, {"ref": "John 2:16", "text": "عیسی هغې ته وویل: «مریمې!» مریم هغه ته مخ ورواړاوه او په آرامي ژبه کې یې ورته وویل: «ربوني!» چې معنی یې ده «استاذه!»"}, {"ref": "John 2:16", "text": "عیسی په دوهم ځل هغه نه پوښتنه وکړه: «ای د یوحنا زویه شمعونه، ایا زما سره مینه کوې؟» پطروس ځواب ورکړ: «هو، استاذه، ته پوهېږې چې زه ستا سره مینه کوم.» عیسی هغه ته وویل: «زما په پسونو باندې پام کوه.»"}, {"ref": "John 2:17", "text": "عیسی هغې ته وویل: «ماته لاس مه راوړه، ځکه چې زه لا تر‌اوسه پلار ته نه یم تللی. خو زما ورونو یعنې زما شاګردانو ته ورشه او هغوی ته ووایه چې زه اوس خپل پلار ته چې ستاسو پلار هم دې او خپل خدای ته چې ستاسو خدای هم دی، پورته ورځم.»"}, {"ref": "John 2:17", "text": "په درېم ځل عیسی د هغه نه پوښتنه وکړه: «ای د یوحنا زویه شمعونه، ایا ته زما سره مینه کوې؟» پطروس غمجن شو ځکه چې هغه ترې په درېم ځل دا پوښتنه وکړه: «ایا ته زما سره مینه کوې؟» نو پطروس هغه ته وویل: «استاذه، ته د هرڅه نه خبر یې، ته پوهېږې چې په ما باندې ګران یې.» عیسی هغه ته وویل: «زما په پسونو باندې پام کوه."}, {"ref": "John 2:18", "text": "نو مریم مجدلیه لاړه او شاګردانو ته یې وویل چې ما عیسی لیدلی دی. بیا هغوی ته یې د هغه پیغام ورساوه. عیسی خپلو شاګردانو ته ځان ښکاره کوي (متي ۲۸‏:‌۱۶‌‏-‌۲۰ او مرقوس ۱۶‏:‌۱۴‌‏-‌۱۸ او لوقا ۲۴‏:‌۳۶‌‏-‌۴۹)"}, {"ref": "John 2:18", "text": "په یقین سره زه تاته دا وایم کله چې ته ځوان وې، نو خپله ملا به دې خپله تړله او هر‌چېرته چې دې غوښتل نو هلته به تللې، خو کله چې زوړ شې، نو لاسونه به دې بل چاته غځولي وي چې ملا دې وتړي او هغه ځای ته به دې بوځي چې ته ورته تلل نه غواړې.»"}, {"ref": "John 2:19", "text": "د هماغې یکشنبې په ماښام کله چې شاګردان د یهودیانو د مشرانو له وېرې د تړلو دروازو شاته سره راټول شوي وو، عیسی راغی او د هغوی په منځ کې ودرېده او ویې ویل: «سلام دې وي په تاسو باندې!»"}, {"ref": "John 2:19", "text": "عیسی دا خبره د دې دپاره وکړه چې دا ښکاره کړي چې پطروس به په څه ډول مړ کیږي، ترڅو خدای ته جلال ورکړي. بیا عیسی هغه ته وویل: «ما پسې راځه.» عیسی او د هغه ګران شاګرد"}, {"ref": "John 2:20", "text": "کله چې هغه دا وویل، نو هغوی ته یې خپل لاسونه او خپل بغل وروښودل. کله چې شاګردانو خپل استاذ ولیده نو ډېر خوشحاله شول."}, {"ref": "John 2:20", "text": "پطروس مخ راواړاوه او ویې لیدل چې هغه شاګرد ورپسې شاته راروان دی چې په عیسی باندې ډېر ګران ؤ، یعنې هغه شاګرد چې د ماښام ډوډۍ په وخت کې د عیسی په څنګ کې ناست ؤ او پوښتنه یې ترې کړې وه: «استاذه، هغه څوک دی چې تا به خپلو دښمنانو ته تسلیموي؟»"}, {"ref": "John 2:21", "text": "عیسی یوځل بیا وویل: «سلام دې وي په تاسو باندې! لکه څنګه چې پلار زه رالېږلی یم نو همداسې زه هم تاسو لېږم.»"}, {"ref": "John 2:21", "text": "کله چې پطروس هغه شاګرد ولیده، نو د عیسی نه یې پوښتنه وکړه: «په هغه باندې به څه کیږي؟»"}, {"ref": "John 2:22", "text": "بیا یې په هغوی وپوکل او ویې ویل: «زما له خوا روح القدس قبول کړئ."}, {"ref": "John 2:22", "text": "عیسی ځواب ورکړ: «که زه وغواړم چې هغه دې زما تر راتګ پورې ژوندی پاتې شي، نو په دې کې ستا څه کار دی؟ ته ما پسې راځه.»"}, {"ref": "John 2:23", "text": "که چېرې تاسو د چا ګناهونه وبخښئ، نو هغوی به وبخښل شي. که تاسو هغوی ونه بخښئ نو هغوی به ونه بخښل شي.» عیسی او توما"}, {"ref": "John 2:23", "text": "نو د عیسی د پیروانو په منځ کې دا خبره خپره شوه چې هغه شاګرد به نه مړ کیږي، خو عیسی داسې ونه ویل چې هغه به نه مړ کیږي، هغه یوازې دا ویلي وو: «که زه وغواړم چې هغه دې زما تر راتګ پورې ژوندی پاتې شي، نو په دې کې ستا څه کار دی؟»"}, {"ref": "John 2:24", "text": "د دولسو شاګردانو څخه توما چې بل نوم یې غبرګونی ؤ، په هغه وخت کې چې عیسی راغی د نورو سره هلته موجود نه ؤ."}, {"ref": "John 2:24", "text": "دا هماغه شاګرد دی چې دا شیان یې لیکلي دي او د هغو په هکله شاهدي ورکوي او مونږ پوهېږو چې د هغه شاهدي رښتیا ده. پای"}, {"ref": "John 2:25", "text": "نو نورو شاګردانو هغه ته وویل: «مونږ استاذ لیدلی دی.» خو هغه ورته وویل: «ترڅو پورې چې زه د هغه په لاسونو باندې د مېخونو نښې ونه وینم او خپلې ګوتې ورباندې کېنږدم او خپل لاس د هغه د بدن په بغل کېنږدم نو هېڅکله به باور ونه کړم.»"}, {"ref": "John 2:25", "text": "عیسی ډېر نور کارونه هم کړي دي. که هغه ټول په کتابونو کې لیکل شوي وای، نو زه ګومان کوم چې په ټوله نړۍ کې به د دې لیکل شویو کتابونو دپاره هېڅ ځای نه وای."}, {"ref": "John 2:26", "text": "یوه هفته وروسته د هغه شاګردان یوځل بیا په کور کې سره راټول شوي وو او توما هم د هغوی سره ؤ. سره له دې چې دروازې بندې وې، خو عیسی راغی او د هغوی په منځ کې ودرېده او ویې ویل: «سلام دې وي په تاسو باندې!»"}, {"ref": "John 2:27", "text": "بیا یې توما ته وویل: «خپلې ګوتې دې دلته کېږده، زما لاسونو ته وګوره او خپل لاسونه راوړاندې کړه او زما په بغل باندې یې کېږده او نور شک مه کوه بلکې ایمان ولره.»"}, {"ref": "John 2:28", "text": "توما وویل: «ای زما استاذه او زما خدایه.»"}, {"ref": "John 2:29", "text": "عیسی هغه ته وویل: «په دې خاطر چې زه دې ولیدم نو ایمان دې راوړ؟ بختور دي هغه خلک چې زه یې نه یم لیدلی او ایمان راوړي.» د دې کتاب مقصد"}, {"ref": "John 2:30", "text": "عیسی د خپلو شاګردانو په حضور کې ډېرې نورې معجزې وښودلې چې په دې کتاب کې نه دي لیکل شوي."}, {"ref": "John 2:31", "text": "خو دا نښې د دې دپاره لیکل شوي دي چې تاسو په دې ایمان راوړئ چې عیسی هماغه مسیح دی او د خدای زوی دی او په هغه باندې په ایمان راوړلو سره به د هغه په نوم تلپاتې ژوندون ولرئ."}, {"ref": "Luke 1:1", "text": "له هغې وروسته عیسی نور دوه اویا شاګردان وټاکل او هغوی یې دوه دوه تنه د خپل ځان نه مخکې هر ښار او کلي ته چې غوښتل یې هلته لاړ شي، ولېږل."}, {"ref": "Luke 1:1", "text": "یوه ورځ عیسی په یو ځای کې دعا کوله. کله چې هغه خپله دعا خلاصه کړه، نو د شاګردانو څخه یو تن هغه ته وویل: «ای استاذه! لکه څنګه چې یحیی خپلو شاګردانو ته دعا کول زده کړي وو، ته یې هم مونږ ته رازده کړه.»"}, {"ref": "Luke 1:1", "text": "په دې وخت کې په زرګونو خلک راټول شول او دومره زیات وو چې یو بل یې تر‌پښو لاندې کول، نو عیسی لومړی خپلو شاګردانو ته خبرې پیل کړې: «د فریسیانو د خمیرې یعنې د هغوی د منافقت څخه ځانونه ساتئ."}, {"ref": "Luke 1:1", "text": "په همدې وخت کې په هغه ځای کې ځینو حاضرینو عیسی د هغو جلیلیانو څخه خبر کړ چې پیلاتوس هغوی خدای ته د قرباني وړاندې کولو په وخت کې وژلي وو."}, {"ref": "Luke 1:1", "text": "د سبت په یوه ورځ عیسی د ډوډۍ خوړلو دپاره د فریسیانو د ډلې د یو مشر کور ته لاړ او هلته خلکو په ځیر هغه ته کتل."}, {"ref": "Luke 1:1", "text": "په دې وخت کې ډېر مالیه ټولوونکي او ګناهکاران عیسی ته ورنژدې شول چې د هغه خبرې واوري."}, {"ref": "Luke 1:1", "text": "عیسی خپلو شاګردانو ته وویل: «یو شتمن سړي یو ناظر درلود. دا سړی خبر شو چې ناظر د هغه شتمني بېځایه لګوي."}, {"ref": "Luke 1:1", "text": "عیسی خپلو شاګردانو ته وویل: «هرڅوک وسوسه کیږي چې ګناه وکړي، خو افسوس د هغه چا په حال چې د وسوسې سبب کیږي."}, {"ref": "Luke 1:1", "text": "عیسی خپلو شاګردانو ته دا مثال راوړ چې هغوی ته وروښایي چې تل باید دعا وکړي او هېڅکله ناهیلي نه شي."}, {"ref": "Luke 1:1", "text": "عیسی اریحا ته ننوت او د ښار له منځه تېرېده،"}, {"ref": "Luke 1:2", "text": "هغوی ته یې وویل: «فصل ډېر دی خو مزدوران لږ دي، نو تاسو د فصل د خاوند څخه وغواړئ چې د حاصلاتو د راټولولو دپاره نور مزدوران راولېږي."}, {"ref": "Luke 1:2", "text": "عیسی هغوی ته وویل: «کله چې تاسو دعا کوئ، نو داسې ووایئ: ‹ای اسماني پلاره! ستا نوم دې پاک وي، ستا پاچاهي دې راشي."}, {"ref": "Luke 1:2", "text": "داسې پټ شی نشته چې ښکاره به نه شي او نه داسې پټ راز شته چې څرګند به نه شي."}, {"ref": "Luke 1:2", "text": "عیسی هغوی ته په ځواب کې وویل: «ایا ګومان کوئ چې دغه جلیلیان د جلیل له نورو ټولو اوسېدونکو څخه ډېر ګناهکاران وو چې په دې ډول ووژل شول؟"}, {"ref": "Luke 1:2", "text": "هلته عیسی ته مخامخ یو سړی ولاړ ؤ چې د پړسوب په ناروغۍ اخته ؤ."}, {"ref": "Luke 1:2", "text": "خو فریسیانو او د شریعت عالمانو په خپلو کې په ګورېدلو پیل وکړ او ویل یې: «دا سړی د ګناهکارانو سره ناسته ولاړه کوي او حتی د هغوی سره یوځای ډوډۍ خوري.»"}, {"ref": "Luke 1:2", "text": "نو هغه یې راوغوښت او ورته ویې ویل: ‹دا څه دي چې ستا په هکله یې اورم؟ څه چې دې اخیستي او څه چې دې لګولي دي د هغو حساب راکړه، ځکه چې ته نور نه شې کولای زما ناظر اوسې.›"}, {"ref": "Luke 1:2", "text": "د هغه دپاره به دا ښه وي چې د ژرندې پل ورته په غاړه کې واچول شي او بحیرې ته وغورځول شي، له دې نه چې د دې خلکو څخه چې د ماشوم په شان په ما باندې ایمان لري، د کوم یو د ګناهکارولو سبب شي."}, {"ref": "Luke 1:2", "text": "هغه وویل: «په یو ښار کې یو قاضي ؤ چې نه له خدایه وېرېده او نه یې د خلکو پروا لرله."}, {"ref": "Luke 1:2", "text": "نو هلته د زکي په نوم یو سړی ؤ چې د مالیه ټولوونکو مشر او ډېر شتمن ؤ."}, {"ref": "Luke 1:3", "text": "لاړ شئ، خو ګورئ، زه تاسو لکه د وریو په شان د لېوانو منځ ته لېږم."}, {"ref": "Luke 1:3", "text": "زمونږ ورځنی رزق هره ورځ مونږ ته راکړه."}, {"ref": "Luke 1:3", "text": "نو هرڅه چې تاسو په تیاره کې ویلي هغه به په رڼا ورځ واورېدل شي او هرڅه چې تاسو د تړلو دروازو شاته یو بل ته په غوږ کې پټ پټ ویلي دي هغه به د بامونو څخه په لوړ اواز واورېدل شي. د چا نه ووېرېږو (متي ۱۰‏:‌۲۸‌‏-‌۳۱)"}, {"ref": "Luke 1:3", "text": "نه، زه تاسو ته وایم که چېرې تاسو توبه ونه باسئ، نو تاسو ټول به د هغوی په شان تباه شئ."}, {"ref": "Luke 1:3", "text": "عیسی د شریعت د عالمانو او فریسیانو څخه پوښتنه وکړه: «ایا د سبت په ورځ د ناروغانو روغول روا دي که نه؟»"}, {"ref": "Luke 1:3", "text": "نو عیسی هغوی ته دا مثال راوړ:"}, {"ref": "Luke 1:3", "text": "ناظر له ځان سره وویل: ‹زما بادار ما د خپل کار څخه شړي، نو اوس به زه څه کوم؟ زه خو دومره تکړه نه یم چې لاړ شم او چېرته لښتي وکینم او په خیر غوښتلو هم شرمېږم."}, {"ref": "Luke 1:3", "text": "پام کوئ! که چېرې ورور دې درسره بدي وکړي، نو هغه ورټه او که توبه وباسي، نو ویې بخښه."}, {"ref": "Luke 1:3", "text": "په همدې ښار کې یوه کونډه وه چې هر وخت به هغه ته راتله او د خپل حق په خاطر به یې ورته زارۍ کولې او ویل به یې چې زما او زما د دښمن ترمنځ په شخړه کې زما سره انصاف وکړه."}, {"ref": "Luke 1:3", "text": "هغه غوښتل وګوري چې عیسی به څنګه سړی وي، خو د هغه قد ډېر ټیټ ؤ او د خلکو د ګڼې‌ګوڼې له امله یې نه شو کولای هغه وویني."}, {"ref": "Luke 1:4", "text": "د ځان سره د پیسو کڅوړه یا خورجین او یا څپلۍ مه وړئ. او په لاره کې د چا سره خبرې مه کوئ."}, {"ref": "Luke 1:4", "text": "زمونږ ګناهونه وبخښه ځکه چې مونږ هم هغه خلک بخښو چې زمونږ سره بدي کوي او مونږ په ازمېښت کې مه اچوه.›»"}, {"ref": "Luke 1:4", "text": "ای زما ملګرو! زه تاسو ته وایم د هغو خلکو څخه مه وېرېږئ چې بدن وژني او له هغې وروسته نور هېڅ نه شي کولای."}, {"ref": "Luke 1:4", "text": "یا هغه اتلس تنه چې په سیلوام کې ورباندې برج راوغورځېده او مړه شول، ایا ګومان کوئ چې هغوی د هغو نورو ټولو خلکو څخه چې په اورشلیم کې اوسیږي ډېر ګناهکاران وو؟"}, {"ref": "Luke 1:4", "text": "خو هغوی غلي پاتې شول. نو عیسی هغه سړی له لاسه ونیوه، هغه یې روغ کړ او رخصت یې کړ."}, {"ref": "Luke 1:4", "text": "«که چېرې په تاسو کې څوک سل پسونه ولري او یو پسه ورڅخه ورک شي، نو هغه به څه کوي؟ ایا هغه به هغه نهه نوي پسونه په دښته کې پرېنږدي او د هغه ورک پسه پسې به لاړ نه شي، ترڅو هغه پیدا کړي؟"}, {"ref": "Luke 1:4", "text": "اوس پوه شوم چې څه وکړم. کله چې ما د دندې څخه لېرې کړي، نو زه باید ملګري ولرم چې ماته په خپلو کورونو کې ځای راکړي.›"}, {"ref": "Luke 1:4", "text": "او که هغه د ورځې اووه ځلې درسره بدي وکړي او هر ځل راشي او درته ووایي چې زما توبه ده، نو هغه وبخښه.» قوي ایمان"}, {"ref": "Luke 1:4", "text": "قاضي ډېره موده نه غوښتل چې کوم کار وکړي، خو اخر هغه د خپل ځان سره وویل: ‹که څه هم زه نه له خدایه وېرېږم او نه د خلکو پروا لرم،"}, {"ref": "Luke 1:4", "text": "نو مخکې یې منډه کړه او د چنار ونې ته وخوت، ترڅو عیسی وویني ځکه چې هغه په هغه لاره تېرېده."}, {"ref": "Luke 1:5", "text": "کله چې کوم کور ته ننوځئ، نو لومړی داسې ووایئ: ‹په دې کور کې دې سلامتي وي.›"}, {"ref": "Luke 1:5", "text": "بیا عیسی خپلو شاګردانو ته وویل: «فرض کړئ که په تاسو کې یو کس په نیمه شپه د خپل ملګري کور ته ورشي او ورته ووایي: ‹ای ملګریه! ماته درې ډوډۍ په پور راکړه."}, {"ref": "Luke 1:5", "text": "خو زه تاسو خبروم چې د چا څخه باید ووېرېږئ. له هغه چا څخه ووېرېږئ چې د وژلو څخه وروسته دا واک او اختیار لري چې تاسو په دوزخ کې واچوي. هو، زه تاسو ته وایم چې باید د هغه څخه ووېرېږئ."}, {"ref": "Luke 1:5", "text": "نه، زه تاسو ته وایم که چېرې توبه ونه باسئ، نو تاسو ټول به د هغوی په شان تباه شئ.» د بې‌مېوې انځر د ونې مثال"}, {"ref": "Luke 1:5", "text": "بیا عیسی د هغوی څخه پوښتنه وکړه: «که چېرې د سبت په ورځ په تاسو کې د کوم چا زوی یا غویی په څاه کې ولویږي، نو ایا هغه به یې سمدلاسه راونه باسي؟»"}, {"ref": "Luke 1:5", "text": "کله چې هغه راپیدا کړي، نو په خوشحالۍ سره به یې خپلو اوږو ته پورته کړي."}, {"ref": "Luke 1:5", "text": "نو د خپل بادار هر یو پوروړی یې راوغوښت. لومړي ته یې وویل: ‹زما د بادار څومره پوروړی یې؟›"}, {"ref": "Luke 1:5", "text": "رسولانو عیسی ته وویل: «زمونږ ایمان قوي کړه.»"}, {"ref": "Luke 1:5", "text": "خو دا چې دې کونډې ماته سرخوږی پیدا کړی دی، نو زه به د هغې سره انصاف وکړم. که نه، نو هغه به هر وخت راځي او ما به تنګوي.›»"}, {"ref": "Luke 1:5", "text": "کله چې عیسی هغه ځای ته ورسېده، نو پورته یې وکتل او زکي ته یې وویل: «ای زکي! زر راښکته شه، ځکه چې زه باید نن ستا په کور کې مېلمه شم.»"}, {"ref": "Luke 1:6", "text": "که چېرې هلته کوم سوله خوښوونکی کس وي، نو ستاسو سلام به په هغه باندې وي او که نه، نو هغه سلام به بېرته تاسو ته راوګرځي."}, {"ref": "Luke 1:6", "text": "زما یو ملګری چې په سفر کې ؤ زما کور ته راغلی دی او زما سره څه نشته چې د هغه په مخکې یې کېږدم چې ویې خوري.›"}, {"ref": "Luke 1:6", "text": "ایا پنځه مرغۍ په دوه روپۍ نه خرڅیږي؟ خو بیاهم له دوی څخه یوه یې هم خدای نه هېروي."}, {"ref": "Luke 1:6", "text": "بیا عیسی هغوی ته دا مثال راوړ: «یو سړي خپل د انګورو په باغ کې د انځر یوه ونه کرلې وه. کله چې راغی چې انځران راټول کړي، هېڅ یې په کې پیدا نه کړل."}, {"ref": "Luke 1:6", "text": "خو د هغوی سره د دې خبرې ځواب نه ؤ. عاجزي او مېلمه‌پالنه"}, {"ref": "Luke 1:6", "text": "او کله چې کور ته راشي، خپل ټول ملګري او ګاونډیان به سره راټول کړي او هغوی ته به ووایي: ‹زما سره په دې خوشحالۍ کې شریک شئ، ځکه چې خپل ورک شوی پسه مې وموند.›"}, {"ref": "Luke 1:6", "text": "هغه ځواب ورکړ: ‹سل پیمانې د زیتونو تېل.› ناظر ورته وویل: ‹خپل حساب راواخله، زر کښېنه او د هغې په ځای پنځوس ولیکه.›"}, {"ref": "Luke 1:6", "text": "عیسی وویل: «که چېرې تاسو د شړشمو د دانې په اندازه ایمان لرلی، نو تاسو کولای شول د توت دې ونې ته ووایئ چې له بېخه راووځه او په بحیرې کې راشنه شه. نو هغې به ستاسو خبره منلې وای. د یو نوکر وظیفه"}, {"ref": "Luke 1:6", "text": "بیا عیسی وویل: «واورئ چې دا بې‌انصافه قاضي څه وایي."}, {"ref": "Luke 1:6", "text": "نو زکي په بیړه راښکته شو او په ډېرې خوشحالۍ سره یې د هغه هرکلی وکړ."}, {"ref": "Luke 1:7", "text": "په هماغه کور کې پاتې شئ او هغوی چې هرڅه درکوي ویې خورئ او ویې وڅښئ، ځکه چې مزدور د خپلې مزدورۍ حقدار دی. کور په کور مه ګرځئ."}, {"ref": "Luke 1:7", "text": "او ستاسو ملګری د کور له دننه څخه تاسو ته ځواب درکړي: ‹ما مه نا‌ارامه کوه، دروازه اوس بنده ده او زه او زما بچیان په خپلو بسترو کې پراته یو. زه نه شم کولای چې راپاڅېږم او تاته کوم څه درکړم.›"}, {"ref": "Luke 1:7", "text": "تر دې پورې چې ستاسو د سر ویښتان هم شمېرل شوي دي. نو هېڅ مه وېرېږئ، تاسو د بې‌شمېره مرغیو څخه زیات ارزښت لرئ.» د خلکو په مخکې د مسیح په هکله اقرار کول (متي ۱۰‏:‌۳۲‌‏-‌۳۳، ۱۲‏:‌۳۲، ۱۰‏:‌۱۹‌‏-‌۲۰)"}, {"ref": "Luke 1:7", "text": "نو خپل باغوان ته یې وویل: ‹ګوره، درې کاله کیږي چې راځم او په دې ونه کې مېوه لټوم، خو هېڅ مې په کې پیدا نه کړ. دا ونه ووهه. دې ونې ولې هسې ځای نیولی دی؟›"}, {"ref": "Luke 1:7", "text": "کله چې عیسی ولیدل چې ځینو مېلمنو کوښښ کاوه د ځانونو دپاره تر ټولو لوړ ځایونه ونیسي، نو هغوی ته یې دا مثال راوړ:"}, {"ref": "Luke 1:7", "text": "زه تاسو ته وایم چې په همدې ډول کله چې یو ګناهکار توبه وباسي، نو په جنت کې به د هغه دپاره د نهه نوي نېکانو په پرتله چې توبې ته اړتیا نه لري، ډېره خوشحالي وي.» د ورکې شوې سکې مثال"}, {"ref": "Luke 1:7", "text": "بیا یې بل ته وویل: ‹ته څومره پوروړی یې؟› هغه ځواب ورکړ: ‹سل جواله غنم.› ناظر ورته وویل: ‹خپل حساب راواخله او د هغې په ځای اتیا ولیکه.›"}, {"ref": "Luke 1:7", "text": "فرض کړئ په تاسو کې کوم څوک نوکر لري چې قلبه کوي یا پسونه ساتي. کله چې هغه د پټي نه راشي ایا بادار به ورته ووایي چې زر راشه، کښېنه او ډوډۍ وخوره؟"}, {"ref": "Luke 1:7", "text": "ایا خدای به د خپلو غوره شویو خلکو سره چې شپه او ورځ ورته د مرستې په خاطر فریادونه کوي، انصاف ونه کړي؟ ایا د هغوی سره به په مرسته کولو کې ځنډ وکړي؟"}, {"ref": "Luke 1:7", "text": "کله چې خلکو دا ولیدل، نو په ګورېدلو یې پیل وکړ او ویل یې: «هغه د یو ګناهکار سړي کور ته ورغی چې مېلمه یې شي.»"}, {"ref": "Luke 1:8", "text": "کله چې تاسو کوم ښار ته ننوځئ او هغوی درته هرکلی ووایي، نو څه چې یې ستاسو په مخکې کېښودل هغه وخورئ."}, {"ref": "Luke 1:8", "text": "زه تاسو ته وایم که چېرې هغه د ملګرتیا په خاطر راپانڅیږي او ډوډۍ درنه کړي، خو بیاهم په دې خاطر چې تاسو په سوال کولو نه شرمېږئ، نو هغه به راپاڅیږي او هرڅه ته چې اړتیا ولرئ تاسو ته به یې درکړي."}, {"ref": "Luke 1:8", "text": "عیسی زیاته کړه: «زه تاسو ته وایم هرڅوک چې د خلکو په مخکې په دې اقرار وکړي چې هغه زما د پیروانو څخه دی، نو د انسان زوی به هم د خدای د فرښتو په مخکې اقرار وکړي چې هغه زما د پیروانو څخه دی."}, {"ref": "Luke 1:8", "text": "خو باغوان ورته ځواب ورکړ: ‹باداره! دا کال یې هم پرېږده، زه به د هغې شاوخوا ځمکه وکینم او سره به ورته واچوم."}, {"ref": "Luke 1:8", "text": "«کله چې څوک تاسو ته د واده د مېلمستیا دپاره بلنه درکړي نو د مجلس په سر کې مه کښېنئ، ځکه کېدای شي چې ستاسو څخه کوم بل ډېر مهم سړی رابلل شوی وي،"}, {"ref": "Luke 1:8", "text": "عیسی زیاته کړه: «فرض کړئ د یوې ښځې سره د سپینو زرو لس سکې وي او یوه ترې ورکه شي. ایا هغه به څراغ بل نه کړي، خپل کور به جارو نه کړي او ټول ځایونه به ونه لټوي، ترڅو هغه راپیدا کړي؟"}, {"ref": "Luke 1:8", "text": "نو بادار یې هغه بې‌ایمانه ناظر وستایه، په دې خاطر چې هغه په ځیرکۍ سره داسې کار وکړ، ځکه چې د دې نړۍ خلک په خپلو کې په راکړه ورکړه کې د ایماندارانو نه ډېر ځیرک دي.»"}, {"ref": "Luke 1:8", "text": "هېڅکله نه! د دې په ځای به هغه ته ووایي: ‹ماته د ماښام ډوډۍ تیاره کړه، ملا دې وتړه او ترڅو پورې چې زه ډوډۍ خورم زما خدمت کوه، له هغې وروسته کولای شې چې خپله ډوډۍ وخورې.›"}, {"ref": "Luke 1:8", "text": "زه درته وایم چې هغه به زر د هغوی سره انصاف وکړي. خو کله چې د انسان زوی راشي، نو ایا هغه به د ځمکې په مخ داسې څوک پیدا کړي چې ایمان ولري؟» د یو فریسي او مالیه ټولوونکي مثال"}, {"ref": "Luke 1:8", "text": "خو زکي ودرېده او عیسی ته یې وویل: «وګوره ښاغلیه! زه مې خپله نیمه شتمني غریبانو ته ورکوم او که د چا څخه مې په ناحقه کوم څه اخیستي وي، نو څلور چنده ورته بېرته ورکوم.»"}, {"ref": "Luke 1:9", "text": "د هغه ځای ناروغان روغ کړئ او خلکو ته ووایئ چې د خدای پاچاهي تاسو ته نژدې شوې ده."}, {"ref": "Luke 1:9", "text": "همدارنګه تاسو ته وایم چې وغواړئ نو تاسو ته به درکړل شي، ولټوئ نو پیدا به یې کړئ، دروازه وټکوئ نو درته خلاصه به شي."}, {"ref": "Luke 1:9", "text": "خو هرڅوک چې د خلکو په مخکې زما څخه انکار وکړي، نو د انسان زوی به هم د خدای د فرښتو په مخکې د هغه څخه انکار وکړي."}, {"ref": "Luke 1:9", "text": "که په راتلونکي فصل کې یې مېوه ونیوله نو ډېره ښه به وي، که نه نو بیا کولای شې چې ویې وهې.›» عیسی د سبت په ورځ یوې ښځې ته شفا ورکوي"}, {"ref": "Luke 1:9", "text": "او ستاسو کوربه چې تاسو دواړه یې رابللي یئ راشي او درته ووایي: ‹خپل ځای دې سړي ته پرېږده.› نو بیا به وشرمېږې او مجبوره به شې چې تر ټولو وروستني ځای کې کښېنې."}, {"ref": "Luke 1:9", "text": "کله چې هغه راپیدا کړي، نو خپل ملګري او ګاونډیان به سره راټول کړي او هغوی ته به ووایي: ‹زما سره خوشحالي وکړئ، ځکه چې ما خپله ورکه شوې سکه راپیدا کړه.›"}, {"ref": "Luke 1:9", "text": "عیسی زیاته کړه: «زه تاسو ته وایم چې په خپلې دنیاوي شتمنۍ د نورو سره مرسته وکړئ چې خپلو ځانونو ته ملګري پیدا کړئ، نو کله چې هغه شتمني خلاصه شي تاسو ته به په تلپاتې کورونو کې ځای درکړل شي."}, {"ref": "Luke 1:9", "text": "ایا بادار به د هغه نوکر څخه چې د هغه امر یې په ځای کړی دی، مننه وکړي؟"}, {"ref": "Luke 1:9", "text": "همدارنګه عیسی د هغو خلکو دپاره چې په خپل ځان ډاډمن وو چې نېک خلک دي او نور یې سپک ګڼل، دا مثال راوړ:"}, {"ref": "Luke 1:9", "text": "بیا عیسی وویل: «نن دې کور ته خلاصون راغلی دی، ځکه چې دا سړی هم د ابراهیم د اولادې څخه دی."}, {"ref": "Luke 1:10", "text": "خو کله چې تاسو کوم ښار ته ورننوځئ او هغوی درته هرکلی ونه وایي، نو د هغه ښار کوڅو ته ووځئ او ووایئ:"}, {"ref": "Luke 1:10", "text": "ځکه هرڅوک چې څه وغواړي، نو لاسته به یې راوړي او هرڅوک چې څه ولټوي، نو پیدا به یې کړي او هرڅوک چې دروازه وټکوي، نو ورته خلاصه به شي."}, {"ref": "Luke 1:10", "text": "هرڅوک چې د انسان د زوی په خلاف کومه خبره وکړي نو هغه به وبخښل شي، خو که څوک د روح القدس په ضد کفر ووایي هغه به ونه بخښل شي."}, {"ref": "Luke 1:10", "text": "د سبت په یوه ورځ عیسی په کنیسه کې تعلیم ورکاوه."}, {"ref": "Luke 1:10", "text": "خو کله چې د چا مېلمه شې، نو لاړ شه او تر ټولو وروستني ځای کې کښېنه، ترڅو کله چې کوربه راشي او درته ووایي: ‹ای زما ملګریه! پاس کښېنئ.› په دې به د نورو ټولو مېلمنو په مخکې ستا عزت وشي،"}, {"ref": "Luke 1:10", "text": "په همدې ډول زه تاسو ته وایم کله چې یو ګناهکار توبه وباسي، نو د خدای فرښتې به د هغه دپاره خوشحالي کوي.» د ورک شوي زوی مثال"}, {"ref": "Luke 1:10", "text": "څوک چې په لږو شیانو کې صادق وي، نو هغه به په ډېرو شیانو کې هم صادق وي او څوک چې په لږو شیانو کې صادق نه وي، نو هغه به په ډېرو شیانو کې هم صادق نه وي."}, {"ref": "Luke 1:10", "text": "او په همدې ډول کله چې تاسو هم خپل ټول کارونه چې درته حکم شوی دی سرته ورسوئ، نو ووایئ: ‹مونږ نوکران د شاباسي وړ نه یو، مونږ یوازې خپله وظیفه سرته رسولې ده.›» عیسی لسو جذامیانو ته شفا ورکوي"}, {"ref": "Luke 1:10", "text": "«یو وخت دوه تنه چې یو یې فریسي او بل یې مالیه ټولوونکی ؤ د دعا دپاره د خدای کور ته لاړل."}, {"ref": "Luke 1:10", "text": "ځکه چې د انسان زوی راغلی دی چې ورک شوي ولټوي او هغوی وژغوري.» د لسو نوکرانو مثال (متي ۲۵‏:‌۱۴‌‏-‌۳۰)"}, {"ref": "Luke 1:11", "text": "‹مونږ به ستاسو د ښار خاورې هم چې زمونږ په پښو باندې پرېوتې دي وڅنډو او دا به ستاسو په خلاف شاهدي ورکوي. خو په دې پوه شئ چې د خدای پاچاهي نژدې شوې ده.›"}, {"ref": "Luke 1:11", "text": "ایا په تاسو کې داسې پلار شته چې زوی یې ورڅخه ماهي وغواړي او هغه د ماهي په ځای ورته مار ورکړي؟"}, {"ref": "Luke 1:11", "text": "کله چې هغوی تاسې د محاکمې دپاره کنیسو یا والیانو یا واکمنانو ته راولي، نو په دې هکله اندېښنه مه کوئ چې د خپل ځان څخه به څنګه دفاع کوئ یا څه به وایئ."}, {"ref": "Luke 1:11", "text": "هلته یوه ښځه وه چې اتلس کاله کېدل چې پېریانو نیولې وه او هغه یې کمزورې کړې وه. ملا یې ورته داسې کړوپه کړې وه چې بیخي سمه ودرېدلی نه شوه."}, {"ref": "Luke 1:11", "text": "ځکه څوک چې خپل ځان لوی ګڼي، هغه به خوار شي او څوک چې خپل ځان عاجز کړي، هغه به سرلوړی شي.»"}, {"ref": "Luke 1:11", "text": "بیا عیسی وویل: «یو سړي دوه زامن لرل."}, {"ref": "Luke 1:11", "text": "که چېرې په دنیاوي شتمنۍ باندې په تاسو اعتبار ونه شي، نو په اصلي شتمنۍ به څوک په تاسو اعتبار وکړي؟"}, {"ref": "Luke 1:11", "text": "کله چې عیسی اورشلیم ته تللو، نو د جلیل او سامرې ترمنځ په پوله تېر شو."}, {"ref": "Luke 1:11", "text": "فریسي ودرېده او د خپل ځان سره یې داسې دعا وکړه: ‹ای خدایه! ستا شکر کوم چې د نورو په شان حریص، بې‌ایمانه او زناکار نه یم او نه د دې مالیه ټولوونکي په شان یم."}, {"ref": "Luke 1:11", "text": "هغوی د عیسی خبرو ته غوږ نیولی ؤ چې هغه ورته یو بل مثال هم راوړ، ځکه چې هغه اورشلیم ته نژدې ؤ او هغوی ګومان کاوه چې د خدای پاچاهي به همدا‌اوس راښکاره شي."}, {"ref": "Luke 1:12", "text": "زه تاسو ته وایم چې د قیامت په ورځ به د سدوم د خلکو سزا د دې ښار د خلکو د سزا څخه کمه وي. هغه ښارونه چې خلک یې توبه نه وباسي (متي ۱۱‏:‌۲۰‌‏-‌۲۴)"}, {"ref": "Luke 1:12", "text": "یا هغه ورڅخه هګۍ وغواړي او هغه ورته لړم ورکړي؟"}, {"ref": "Luke 1:12", "text": "ځکه چې په هماغه ساعت به روح القدس تاسو ته وښایي چې څه باید ووایئ.» د یو کم‌عقل شتمن مثال"}, {"ref": "Luke 1:12", "text": "کله چې عیسی هغه ښځه ولیدله، نو هغه یې راوغوښتله او ورته ویې ویل: «ای خورې! ته د خپلې ناروغۍ څخه خلاصه شوې.»"}, {"ref": "Luke 1:12", "text": "بیا عیسی خپل کوربه ته وویل: «کله چې د غرمې یا د ماښام ډوډۍ دپاره څوک راغواړې، نو خپلو ملګرو یا خپلو ورونو یا خپلوانو یا خپلو شتمنو ګاونډیانو ته بلنه مه ورکوه، ځکه چې هغوی به هم بېرته تاته بلنه درکړي او په دې ډول به ستا بدل پوره کړي."}, {"ref": "Luke 1:12", "text": "کشر زوی یې خپل پلار ته وویل: ‹پلاره! ماته مې خپله برخه جایداد راکړه.› نو هغه سړي خپل جایداد د خپلو دواړو زامنو ترمنځ ووېشه."}, {"ref": "Luke 1:12", "text": "که چېرې تاسو د نورو خلکو د شتمنۍ په اړه صادق ونه اوسئ، نو څوک به تاسو ته هغه شتمني چې ستاسو به وي، درکړي؟"}, {"ref": "Luke 1:12", "text": "هغه یو کلي ته د ننوتلو په وخت کې د لسو تنو سره چې د جذام په ناروغۍ اخته وو، مخامخ شو. هغوی لېرې ودرېدل"}, {"ref": "Luke 1:12", "text": "زه په هفته کې دوه ورځې روژه نیسم او څه چې ګټم د هغې لسمه برخه ورکوم.›"}, {"ref": "Luke 1:12", "text": "عیسی وویل: «د یوې لویې کورنۍ یو سړی یو لېرې هېواد ته په سفر لاړ چې د پاچاهۍ مقام تر‌لاسه کړي او بېرته خپل وطن ته راشي."}, {"ref": "Luke 1:13", "text": "افسوس دې وي په تا ای د خورزین ښاره! افسوس دې وي په تا ای د بیت‌صیدا ښاره! ځکه که چېرې دا معجزې چې په تاسو کې وښودل شوې، که هغه په صور او صیدون کې ښودل شوې وای نو هغوی به ډېر پخوا د ویر کالي اغوستي وای، په خپلو سرونو باندې به یې ایرې بادولې او توبه به یې ویستلې وای."}, {"ref": "Luke 1:13", "text": "نو تاسو چې دومره بد خلک یئ، په دې پوهېږئ چې خپلو اولادونو ته څنګه ښه شیان ورکړئ، نو ستاسو اسماني پلار به څومره زیات روح القدس هغو خلکو ته ورکړي چې ورڅخه یې وغواړي.» عیسی او د پېریانو مشر بعلزبول (متي ۱۲‏:‌۲۲‌‏-‌۳۰ او مرقوس ۳‏:‌۱۴‌‏-‌۲۳)"}, {"ref": "Luke 1:13", "text": "د ګڼې‌ګوڼې له منځ څخه یو سړي عیسی ته وویل: «استاذه! زما ورور ته ووایه چې زمونږ د پلار میراث زما سره ووېشي.»"}, {"ref": "Luke 1:13", "text": "بیا یې خپل لاسونه په هغې باندې کېښودل او هغه سمدلاسه نېغه ودرېدله او د خدای ثنا یې وویله."}, {"ref": "Luke 1:13", "text": "خو کله چې مېلمستیا ورکوې، نو غریبانو، شلانو، ګوډانو او ړندو ته بلنه ورکړه."}, {"ref": "Luke 1:13", "text": "څو ورځې وروسته کشر زوی خپله برخه جایداد خرڅ کړ او پیسې یې واخیستلې او یو لېرې وطن ته لاړ او خپلې پیسې یې هلته په عیاشۍ کې بېځایه برباد کړلې."}, {"ref": "Luke 1:13", "text": "هېڅ غلام نه شي کولای چې د دوو بادارانو خدمت وکړي، ځکه چې داسې غلام به د یو څخه کرکه کوي او د بل سره به مینه او یا دا چې یو ته به وفادار وي او بل ته به په سپکه سترګه ګوري. تاسو نه شئ کولای چې هم د خدای بندګي وکړئ او هم د پیسو بندګي وکړئ.» شریعت او د خدای پاچاهي (متي ۱۱‏:‌۱۲‌‏-‌۱۳، ۵‏:‌۳۱‌‏-‌۳۲ او مرقوس ۱۰‏:‌۱۱‌‏-‌۱۲)"}, {"ref": "Luke 1:13", "text": "او په لوړ اواز یې نارې کړې: «ای عیسی باداره! په مونږ رحم وکړه.»"}, {"ref": "Luke 1:13", "text": "خو هغه مالیه ټولوونکی لېرې ولاړ ؤ او تر دې چې نه یې غوښتل پاس اسمان ته وګوري، خو خپله سینه یې وهله او ویل یې: ‹ای خدایه! په ما ګناهکار رحم وکړه.›»"}, {"ref": "Luke 1:13", "text": "مخکې له دې چې لاړ شي خپل لس نوکران یې راوغوښتل او هر یو ته یې یوه یوه د سرو زرو سکه ورکړه او ورته ویې ویل: ‹زما تر بېرته راتللو پورې ورباندې کاروبار وکړئ.›"}, {"ref": "Luke 1:14", "text": "خو د قیامت په ورځ به د صیدون او صور د خلکو سزا ستاسو د سزا څخه کمه وي‎."}, {"ref": "Luke 1:14", "text": "عیسی د یو سړي څخه ګونګی پېری وویست او کله چې هغه پېری ووت، نو هغه ګونګي سړي په خبرو پیل وکړ او خلک حیران شول."}, {"ref": "Luke 1:14", "text": "عیسی هغه ته ځواب ورکړ: «ای وروره! زه چا ستاسو ترمنځ قاضي ټاکلی یم چې ستاسو میراث ووېشم؟»"}, {"ref": "Luke 1:14", "text": "خو د کنیسې مشر د عیسی په دې کار چې د سبت په ورځ یې ناروغ ته شفا ورکړې وه، خفه شو او خلکو ته یې وویل: «په هفته کې شپږ ورځې دي چې باید کار وشي، نو په همدې ورځو کې راځئ او شفا مومئ، خو د سبت په ورځ نه.»"}, {"ref": "Luke 1:14", "text": "نو ته به بختور یې، ځکه چې هغوی ستا بدل نه شي پوره کولای. خو د قیامت په ورځ به خدای تاته د نېکانو سره اجر درکړي.» د لویې مېلمستیا مثال (متي ۲۲‏:‌۱‌‏-‌۱۰)"}, {"ref": "Luke 1:14", "text": "کله چې هغه خپل هرڅه مصرف کړل، په هغه وطن کې سخته قحطي راغله او هغه محتاج شو."}, {"ref": "Luke 1:14", "text": "فریسیانو چې دا خبرې واورېدلې نو په عیسی باندې یې ملنډې ووهلې، ځکه چې هغوی د پیسو سره مینه لرله."}, {"ref": "Luke 1:14", "text": "عیسی هغوی ته وکتل او ورته ویې ویل: «لاړ شئ او خپل ځانونه کاهنانو ته وښایئ.» څنګه چې هغوی روان شول، نو پاک او روغ شول."}, {"ref": "Luke 1:14", "text": "عیسی وویل: «زه تاسو ته وایم چې هغه مالیه ټولوونکی چې خپل کور ته لاړ بخښل شوی دی، نه هغه فریسي. ځکه هرڅوک چې خپل ځان لوی ګڼي، هغه به خوار شي او هرڅوک چې خپل ځان عاجز کړي، نو هغه به سرلوړی شي.» عیسی ماشومانو ته برکت ورکوي (متي ۱۹‏:‌۱۳‌‏-‌۱۵ او مرقوس ۱۰‏:‌۱۳‌‏-‌۱۶)"}, {"ref": "Luke 1:14", "text": "خو وطندارانو یې چې د هغه څخه یې کرکه کوله، په هغه پسې خپل استازي ولېږل چې ورته ووایي: ‹مونږ نه غواړو چې دا سړی زمونږ پاچا شي.›"}, {"ref": "Luke 1:15", "text": "خو ای کپرناحومه! تا غوښتل چې اسمان ته پورته کړای شې؟ خو ته به دوزخ ته وغورځول شې.»"}, {"ref": "Luke 1:15", "text": "خو ځینو خلکو وویل چې هغه د پېریانو د مشر بعلزبول یعنې شیطان په مرسته پېریان وباسي."}, {"ref": "Luke 1:15", "text": "بیا یې خلکو ته وویل: «پام کوئ او خپل ځانونه د هر ډول حرص څخه وساتئ، ځکه چې د انسان ژوند په دې نه جوړیږي چې هغه دې ډېره شتمني ولري.»"}, {"ref": "Luke 1:15", "text": "خو عیسی هغه ته ځواب ورکړ: «ای منافقانو! ایا تاسو هر یو د سبت په ورځ خپل غویی یا خر د آخور څخه نه ایله کوئ او د اوبو دپاره یې نه بیایئ؟"}, {"ref": "Luke 1:15", "text": "کله چې د حاضرو خلکو څخه یو تن چې په دسترخوان ورسره ناست ؤ دا واورېدل، نو عیسی ته یې وویل: «بختور دي هغه خلک چې د خدای په پاچاهۍ کې به په مېلمستیا کې کښېني.»"}, {"ref": "Luke 1:15", "text": "نو هغه لاړ او د هغه وطن د یو سړي سره نوکر شو او هغه سړي هغه خپلو پټیو ته ولېږه چې خوګان وساتي."}, {"ref": "Luke 1:15", "text": "عیسی هغوی ته وویل: «تاسو داسې خلک یئ چې خپل ځانونه د نورو په مخکې عادلان ښکاره کوئ، خو خدای ستاسو زړونه ښه پېژني. ځکه کوم شیان چې د انسانانو په نظر کې ډېر ارزښت لري، خدای هغه بد ګڼي."}, {"ref": "Luke 1:15", "text": "کله چې په هغوی کې یو تن ولیدل چې روغ شوی دی، نو بېرته راوګرځېد او په لوړ اواز یې د خدای ثنا وویله."}, {"ref": "Luke 1:15", "text": "ځینو خلکو به عیسی ته خپل ماشومان راوستل چې خپل لاس په هغوی باندې کېږدي. کله چې شاګردانو دا ولیدل نو هغوی یې ورټل،"}, {"ref": "Luke 1:15", "text": "څه موده وروسته هغه د پاچا په توګه بېرته راستون شو، بیا یې هغه نوکران راوغوښتل چې سکې یې ورته ورکړې وې، ترڅو معلومه کړي چې په دوی کې هر یو په هغو سیکو باندې څومره ګټه کړې ده."}, {"ref": "Luke 1:16", "text": "عیسی خپلو شاګردانو ته وویل: «څوک چې ستاسو خبرو ته غوږ نیسي، هغوی زما خبرو ته غوږ نیسي. څوک چې تاسې نه مني، هغوی ما نه مني او څوک چې ما نه مني نو هغه څوک نه مني چې زه یې رالېږلی یم.» د دوه اویا شاګردانو بېرته راستنېدل"}, {"ref": "Luke 1:16", "text": "نورو د ازمېښت په ډول د عیسی څخه اسماني معجزه وغوښتله."}, {"ref": "Luke 1:16", "text": "بیا عیسی هغوی ته دا مثال راوړ: «یو شتمن سړی ؤ چې ځمکه یې لرله او هغې ځمکې ښه حاصل ورکړ."}, {"ref": "Luke 1:16", "text": "نو دا ښځه د ابراهیم لور ده او اتلس کاله کیږي چې د شیطان په بند کې وه. ایا هغه باید د سبت په ورځ د بند څخه ازاده نه شي؟»"}, {"ref": "Luke 1:16", "text": "عیسی هغه ته وویل: «یو سړي یوه لویه مېلمستیا جوړه کړه او ډېر خلک یې راوبلل."}, {"ref": "Luke 1:16", "text": "هغه په دې ارمان ؤ چې خپله ګېډه په هغو خوړو باندې مړه کړي چې خوګانو به خوړل، خو هېچا هغه ته څه نه ورکول."}, {"ref": "Luke 1:16", "text": "د یحیی تر راتللو پورې خلکو د تورات او د پیغمبرانو په لیکنو عمل کاوه. له هغې وروسته د خدای د پاچاهۍ زېری خپور شو او هرڅوک زیات کوښښ کوي چې هغې ته وردننه شي."}, {"ref": "Luke 1:16", "text": "هغه د عیسی په پښو کې پرېوت او د هغه څخه یې مننه وکړه. دا سړی یو سامری ؤ."}, {"ref": "Luke 1:16", "text": "خو عیسی هغه ماشومان خپل ځان ته راوغوښتل او ویې ویل: «پرېږدئ چې ماشومان ماته راشي، هغوی مه منع کوئ، ځکه چې د خدای پاچاهي د همداسې خلکو ده."}, {"ref": "Luke 1:16", "text": "لومړی نوکر راغی او ویې ویل: ‹باداره! ستا په یوې سکې ما لس نورې سکې ګټلې دي.›"}, {"ref": "Luke 1:17", "text": "بیا هغه دوه اویا شاګردان په خوشحالۍ سره بېرته راستانه شول او ویې ویل: «استاذه! حتی پېریان هم ستا د نوم په یادولو سره زمونږ تابع کیږي.»"}, {"ref": "Luke 1:17", "text": "خو عیسی د هغوی په خیالونو پوهېده، نو هغوی ته یې وویل: «په هرې پاچاهۍ کې چې په خپل منځ کې بې‌اتفاقي رامنځته شي هغه له منځه ځي. په هره کورنۍ کې چې بې‌اتفاقي رامنځته شي، نو هغه کورنۍ ټوټې ټوټې کیږي."}, {"ref": "Luke 1:17", "text": "هغه د خپل ځان سره فکر وکړ او ویې ویل: ‹څه وکړم؟ ما سره دومره ځای نشته چې خپلې غلې دانې په کې وساتم.›"}, {"ref": "Luke 1:17", "text": "د عیسی په دې خبرو د هغه مخالفین خجالته شول، خو خلک د هغه په دې حیرانوونکي کارونو چې کول یې، خوشحاله شول. د شړشمو د تخم مثال (متي ۱۳‏:‌۳۱‌‏-‌۳۲ او مرقوس ۴‏:‌۳۰‌‏-‌۳۲)"}, {"ref": "Luke 1:17", "text": "کله چې د ډوډۍ وخت شو، نو خپل نوکر یې مېلمنو پسې ولېږه چې ورته ووایي: ‹راشئ، هرڅه تیار دي.›"}, {"ref": "Luke 1:17", "text": "په پای کې د هغه عقل سر ته راغی او ویې ویل: ‹زما د پلار مزدوران دومره زیات خواړه لري چې ورڅخه پاتې کیږي او زه دلته د لوږې له لاسه مړ کېږم."}, {"ref": "Luke 1:17", "text": "د ځمکې او اسمان له منځه تلل اسانه دي، له دې نه چې د شریعت یو ټکی هم له منځه لاړ شي."}, {"ref": "Luke 1:17", "text": "عیسی وویل: «ایا ټول لس تنه پاک او روغ نه شول؟ نو بیا هغه نور نهه تنه چېرته دي؟"}, {"ref": "Luke 1:17", "text": "په یقین سره زه تاسو ته دا وایم چې هرڅوک چې د خدای پاچاهي د یو ماشوم په څېر ونه مني، نو هېڅکله به هغې ته وردننه نه شي.» شتمن خلک او د خدای پاچاهي (متي ۱۹‏:‌۱۶‌‏-‌۳۰ او مرقوس ۱۰‏:‌۱۷‌‏-‌۳۱)"}, {"ref": "Luke 1:17", "text": "هغه وویل: ‹شاباس، ته ښه نوکر یې. څرنګه چې تا په لږ شي کې خپل ځان اعتباري ثابت کړ، نو ته به په لسو ښارونو باندې حکومت کوې.›"}, {"ref": "Luke 1:18", "text": "عیسی هغوی ته په ځواب کې وویل: «ما ولیدل چې شیطان څنګه لکه د برېښنا په شان له اسمانه راوغورځېد."}, {"ref": "Luke 1:18", "text": "او که چېرې شیطان د خپل ځان په خلاف شي، نو د هغه پاچاهي به څنګه پاتې شي؟ خو بیاهم تاسو وایئ چې زه د بعلزبول په مرسته پېریان وباسم."}, {"ref": "Luke 1:18", "text": "بیا هغه وویل: ‹اوس پوه شوم چې څه وکړم. زه به خپل ګودامونه وران کړم او د هغو نه به لوی لوی ګودامونه جوړ کړم او خپلې غلې دانې او نور شیان به په کې ذخیره کړم."}, {"ref": "Luke 1:18", "text": "بیا عیسی پوښتنه وکړه: «د خدای پاچاهي د څه شي په شان ده او هغه د څه شي سره پرتله کړم؟"}, {"ref": "Luke 1:18", "text": "خو هغوی ټولو بهانې پیل کړې. لومړني وویل: ‹ما لږه ځمکه اخیستې ده، باید لاړ شم او هغه ووینم. مهرباني وکړه زما عذر ومنه.›"}, {"ref": "Luke 1:18", "text": "زه به لاړ شم او خپل پلار ته به ورشم او ورته به ووایم چې پلاره! ما د خدای او ستا په وړاندې ګناه کړې ده."}, {"ref": "Luke 1:18", "text": "هرڅوک چې خپله ښځه طلاقه کړي او د بلې ښځې سره واده وکړي، نو هغه زنا کوي او هرڅوک چې د طلاقې شوې ښځې سره واده وکړي، هغه هم زنا کوي.» د شتمن سړي او ایلعازر مثال"}, {"ref": "Luke 1:18", "text": "ایا له دې پردي سړي پرته بل څوک نه ؤ چې بېرته راغلی وای او د خدای ثنا یې ویلې وای؟»"}, {"ref": "Luke 1:18", "text": "یو یهودي مشر د عیسی څخه پوښتنه وکړه: «ای نېک استاذه! زه باید څه وکړم چې تلپاتې ژوندون وګټم؟»"}, {"ref": "Luke 1:18", "text": "دوهم نوکر راغی او ویې ویل: ‹باداره! ستا د سرو زرو یوې سکې نورې پنځه سکې ګټه کړې ده.›"}, {"ref": "Luke 1:19", "text": "واورئ! ما تاسو ته واک او اختیار درکړی چې ماران او لړمان تر‌پښو لاندې کړئ او د دښمن ټول قوت مات کړئ. هېڅ شی تاسو ته زیان نه شي رسولی."}, {"ref": "Luke 1:19", "text": "که چېرې زه د بعلزبول په مرسته پېریان وباسم، نو ستاسو خپل پیروان یې د چا په مرسته وباسي؟ نو هغوی به ستاسو په هکله قضاوت وکړي."}, {"ref": "Luke 1:19", "text": "بیا به خپل ځان ته ووایم: ای بختور انسانه! تا ډېر زیات ښه ښه شیان راټول کړي دي چې د ډېرو کلونو دپاره دې بس دي. اوس ارام ژوند تېروه، خوره، څښه او خوشحاله ګرځه.›"}, {"ref": "Luke 1:19", "text": "دا د شړشمو د تخم په شان ده چې یو سړي هغه راواخیست او په خپل پټي کې یې وکرلو. هغه لوی شو او بوټی ترې جوړ شو او مرغان راغلل او د هغه په څانګو یې ځالې جوړې کړې.» د خمیرې مثال (متي ۱۳‏:‌۳۳)"}, {"ref": "Luke 1:19", "text": "بل وویل: ‹ما پنځه جوړې غویان اخیستي دي او روان یم چې هغه امتحان کړم، مهرباني وکړه زما عذر ومنه.›"}, {"ref": "Luke 1:19", "text": "زه نور د دې وړ نه یم چې ته راته خپل زوی ووایې. ما هم یو له خپلو مزدورانو څخه وشمېره.›"}, {"ref": "Luke 1:19", "text": "عیسی وویل: «یو شتمن سړی ؤ چې هره ورځ به یې تر ټولو قیمتي کالي اغوستل او په عیش او عشرت کې یې ژوند تېراوه."}, {"ref": "Luke 1:19", "text": "عیسی هغه سړي ته وویل: «پاڅېږه او لاړ شه، خپل ایمان ته روغ کړې.» د خدای د پاچاهۍ راتګ (متي ۲۴‏:‌۲۳‌‏-‌۲۸،‌۳۷‌‏-‌۴۱)"}, {"ref": "Luke 1:19", "text": "عیسی هغه ته وویل: «ولې ماته نېک وایې؟ پرته له خدایه بل هېڅوک نېک نه دی."}, {"ref": "Luke 1:19", "text": "هغه ته یې وویل: ‹ته په پنځو ښارونو باندې حکومت کوه.›"}, {"ref": "Luke 1:20", "text": "خو په دې مه خوشحالېږئ چې پېریان تاسو ته تابع کیږي، بلکې په دې خوشحاله اوسئ چې ستاسو نومونه په جنت کې لیکل شوي دي.» د عیسی خوشحالي (متي ۱۱‏:‌۲۵‌‏-‌۲۷، ۱۳‏:‌۱۶‌‏-‌۱۷)"}, {"ref": "Luke 1:20", "text": "خو که چېرې زه د خدای په قدرت سره پېریان وباسم، نو په دې پوه شئ چې د خدای پاچاهي تاسو ته راغلې ده."}, {"ref": "Luke 1:20", "text": "خو خدای هغه ته وویل: ‹ای کم‌عقله! همدا نن شپه به دې ساه ووځي، نو دا ټول شیان چې تا د خپل ځان دپاره ساتلي دي هغه به د چا شي؟›"}, {"ref": "Luke 1:20", "text": "عیسی یوځل بیا پوښتنه وکړه: «د خدای پاچاهي د څه شي سره پرتله کړم؟"}, {"ref": "Luke 1:20", "text": "او بل یې وویل: ‹ما نوی واده کړی دی، نو له دې امله نه شم درتللی.›"}, {"ref": "Luke 1:20", "text": "نو هغه پاڅېد او د خپل پلار کور ته روان شو. هغه لا کور ته نه ؤ رسېدلی چې پلار یې هغه د لېرې نه ولیده، زړه یې ورباندې وسوځېده او په منډه منډه د خپل زوی خواته ورغی. هغه یې په غېږ کې ونیوه او ښکل یې کړ."}, {"ref": "Luke 1:20", "text": "د هغه د دروازې په مخکې به یو سوالګر چې ایلعازر نومېده او بدن یې له ټپونو څخه ډک ؤ، پروت ؤ"}, {"ref": "Luke 1:20", "text": "ځینو فریسیانو د عیسی څخه پوښتنه وکړه چې د خدای پاچاهي به کله راشي. عیسی ځواب ورکړ: «د خدای پاچاهي په داسې ډول نه راځي چې هغه ولیدل شي."}, {"ref": "Luke 1:20", "text": "ته په حکمونو باندې پوهېږې: زنا مه کوه، قتل مه کوه، غلا مه کوه، د دروغو شاهدي مه ورکوه او د خپل مور او پلار عزت کوه.»"}, {"ref": "Luke 1:20", "text": "بیا بل نوکر راغی او ویې ویل: ‹باداره! دا ده ستا د سرو زرو سکه، هغه مې په دستمال کې تاوه کړې وه او ساتلې مې ده."}, {"ref": "Luke 1:21", "text": "په هغه وخت کې عیسی په روح القدس کې خوشحالي وکړه او ویې ویل: «ای پلاره، ای د ځمکې او اسمان څښتنه! زه ستا شکر کوم چې دا خبرې دې د پوهو او هوښیارو خلکو څخه پټې کړې او ناپوهو خلکو ته دې ښکاره کړي دي. هو پلاره، دا ستا رضا وه."}, {"ref": "Luke 1:21", "text": "کله چې یو زورور سړی چې په وسله سمبال وي د خپل کور ساتنه کوي، نو د هغه مال او جایداد به خوندي وي،"}, {"ref": "Luke 1:21", "text": "داسې به د هغو خلکو سره کیږي چې د ځانونو دپاره شتمني راټولوي، خو د خدای په نظر کې به غریب وي.» په خدای توکل کول (متي ۶‏:‌۲۵‌‏-‌۳۴)"}, {"ref": "Luke 1:21", "text": "دا د هغې خمیرې په شان ده چې یوه ښځه هغه واخلي او د درې پیمانې اوړو سره یې ګډه کړي، ترڅو هغه ټول خمیره شي.» د تنګې دروازې مثال (متي ۷‏:‌۱۳‌‏-‌۱۴،‌۲۱‌‏-‌۲۳)"}, {"ref": "Luke 1:21", "text": "نوکر بېرته راغی او خپل بادار ته یې دا هرڅه وویل. بادار ډېر په قهر شو او خپل نوکر ته یې وویل: ‹زر زر د ښار لارو او کوڅو ته ووځه او غریبان، شلان، ړانده او ګوډان راوله.›"}, {"ref": "Luke 1:21", "text": "زوی یې وویل: ‹پلاره! ما د خدای او ستا په وړاندې ګناه کړې ده. زه نور د دې وړ نه یم چې ستا زوی وګڼل شم.›"}, {"ref": "Luke 1:21", "text": "او په دې تمه به ؤ چې د هغه شتمن سړي د دسترخوان څخه په پاتې شویو ټوټو باندې ځان موړ کړي. حتی سپي به راتلل او د هغه ټپونه به یې څټل."}, {"ref": "Luke 1:21", "text": "نه به هم څوک ووایي چې ګورئ، دلته ده‎ یا هلته ده. ځکه چې په حقیقت کې د خدای پاچاهي ستاسو په منځ کې ده.»"}, {"ref": "Luke 1:21", "text": "هغه سړي ځواب ورکړ: «ما د ځوانۍ له وخته په دې ټولو حکمونو عمل کړی دی.»"}, {"ref": "Luke 1:21", "text": "زه ستا څخه وېرېدم، ځکه چې ته یو سخت سړی یې. هغه څه تر‌لاسه کوې چې تا نه دي ګټلي او هغه څه رېبې چې کرلي دې نه دي.›"}, {"ref": "Luke 1:22", "text": "زما پلار هرڅه ماته راسپارلي دي. هېڅوک له پلاره پرته زوی نه پېژني او نه څوک پلار بې له زویه پېژني او پرته له هغه چا چې زوی وغواړي ورته ویې ښایي.»"}, {"ref": "Luke 1:22", "text": "خو کله چې د هغه څخه کوم زیات زورور سړی په هغه باندې حمله وکړي او هغه ته ماتې ورکړي، نو د هغه څخه به هغه ټوله وسله چې ورباندې ډاډه ؤ، واخلي او کوم شیان چې هغه غلا کړي دي هغه به په خپلو کې سره ووېشي."}, {"ref": "Luke 1:22", "text": "بیا عیسی خپلو شاګردانو ته وویل: «نو تاسو ته وایم چې د خپل ژوند په هکله دا اندېښنه مه کوئ چې څه شی به خورئ او هم د خپل بدن په خاطر چې څه به اغوندئ،"}, {"ref": "Luke 1:22", "text": "عیسی اورشلیم ته روان ؤ او په لاره یې په ښارونو او کلیو کې خلکو ته تعلیم ورکاوه."}, {"ref": "Luke 1:22", "text": "کله چې نوکر بېرته راستون شو، نو ویې ویل: ‹باداره! ستاسو امر په ځای شو، خو بیاهم د نورو خلکو دپاره ځای شته.›"}, {"ref": "Luke 1:22", "text": "خو پلار یې خپلو نوکرانو ته وویل: ‹زر شئ. تر ټولو ښه چپنه راوړئ او هغه ته یې واغوندئ. ګوته ورته په لاس کړئ او څپلۍ ورته په پښو کړئ."}, {"ref": "Luke 1:22", "text": "داسې وشول چې هغه غریب سړی مړ شو او فرښتو هغه د ابراهیم څنګ ته یووړ. بیا هغه شتمن سړی هم مړ شو او خاورو ته وسپارل شو."}, {"ref": "Luke 1:22", "text": "بیا یې شاګردانو ته وویل: «داسې وخت به راشي چې تاسو به په دې ارمان یئ چې هغه ورځ وګورئ چې د انسان زوی پاچاهي کوي، خو وبه یې نه وینئ."}, {"ref": "Luke 1:22", "text": "کله چې عیسی دا واورېدل، نو هغه ته یې وویل: «په تا کې اوس هم د یو شي کمی شته. هرڅه چې لرې هغه خرڅ کړه او پیسې یې په غریبانو باندې ووېشه، نو ته به په اسمان کې خزانې ولرې، بیا راشه او زما پیروي وکړه.»"}, {"ref": "Luke 1:22", "text": "بادار یې ځواب ورکړ: ‹ای بېکاره نوکره! زه تا په خپلو خبرو ملامتوم. ته په دې پوهېدلې چې زه یو سخت سړی یم او هغه څه تر‌لاسه کوم چې زما نه دي او هغه څه رېبم چې کرلي مې نه دي،"}, {"ref": "Luke 1:23", "text": "کله چې هغوی یوازې وو، نو عیسی هغوی ته مخ راواړاوه او ورته ویې ویل: «بختورې دي هغه سترګې چې هغه څه ویني چې تاسو یې وینئ."}, {"ref": "Luke 1:23", "text": "څوک چې زما سره نه دی، هغه زما په خلاف دی او څوک چې زما سره د خلکو په راټولولو کې مرسته نه کوي، هغه یې خواره واره کوي. د پېري بېرته راتلل (متي ۱۲‏:‌۴۳‌‏-‌۴۵)"}, {"ref": "Luke 1:23", "text": "ځکه چې ژوند د خوړو څخه او بدن د کالیو څخه ډېر ارزښتناک دی."}, {"ref": "Luke 1:23", "text": "یو چا ورڅخه پوښتنه وکړه: «استاذه! ایا یوازې لږ خلک به خلاصون ومومي؟» عیسی ځواب ورکړ:"}, {"ref": "Luke 1:23", "text": "بیا بادار خپل نوکر ته وویل: ‹د ښار څخه دباندې سرکونو او کوڅو ته ووځه او خلک په زوره راوله، ترڅو زما کور ډک شي."}, {"ref": "Luke 1:23", "text": "یو چاغ خوسی راولئ او حلال یې کړئ او راځئ چې مېله جوړه کړو او خوشحالي وکړو."}, {"ref": "Luke 1:23", "text": "هغه د مړو دنیا ته لاړ او هلته ډېر په عذاب ؤ. هغه چې پورته وکتل د لېرې نه یې ابراهیم ولیده چې ایلعازر یې په خوا کې ؤ."}, {"ref": "Luke 1:23", "text": "خلک به تاسو ته ووایي چې وګورئ دلته دی یا وګورئ هلته دی. خو تاسو هغوی پسې مه ځئ."}, {"ref": "Luke 1:23", "text": "کله چې هغه سړي دا خبره واورېدله نو ډېر غمجن شو، ځکه چې هغه ډېر شتمن سړی ؤ."}, {"ref": "Luke 1:23", "text": "نو زما د سرو زرو سکه دې ولې د صرافانو سره نه ده ایښې چې د بېرته راستنېدلو په وخت کې مې د سود سره اخیستې وای؟›"}, {"ref": "Luke 1:24", "text": "زه تاسو ته وایم چې ډېرو پیغمبرانو او پاچاهانو دا ارمان درلود چې هغه څه وویني چې تاسو یې وینئ، خو ویې نه لیدل او هغه څه واوري چې تاسو یې اورئ، خو هغوی وانه ورېدل.» د یو نېک سامري مثال"}, {"ref": "Luke 1:24", "text": "کله چې د یو سړي څخه پېری راوځي، نو په دښتو کې سرګردانه ګرځي او د ارام کولو دپاره ځای لټوي، خو کله چې داسې ځای پیدا نه کړي، نو د خپل ځان سره وایي: ‹زه به بېرته هغه کور ته لاړ شم چې ورڅخه راوتلی وم.›"}, {"ref": "Luke 1:24", "text": "کارغانو ته وګورئ. هغوی نه څه کري او نه څه رېبي، نه د ساتلو دپاره ځایونه لري او نه ګودامونه، خو خدای ورته روزي رسوي. تاسو د مرغانو څخه ډېر زیات ارزښت لرئ."}, {"ref": "Luke 1:24", "text": "«زیات کوښښ وکړئ چې له تنګې دروازې څخه وردننه شئ، ځکه زه تاسو ته وایم چې ډېر خلک به د ننوتلو هڅه وکړي، خو وبه نه شي کړای."}, {"ref": "Luke 1:24", "text": "زه تاسو ته وایم چې د هغو خلکو څخه چې لومړی مې ورته بلنه ورکړې وه هېڅوک به هم زما د دې مېلمستیا خوند ونه څکي.›» د مسیح د شاګردۍ بیه (متي ۱۰‏:‌۳۷‌‏-‌۳۸)"}, {"ref": "Luke 1:24", "text": "ځکه چې زما دا زوی مړ شوی ؤ او بېرته راژوندی شوی دی. هغه ورک شوی ؤ، خو اوس پیدا شوی دی.› نو هغوی جشن پیل کړ."}, {"ref": "Luke 1:24", "text": "بیا هغه چیغې کړې او ویې ویل: ‹ای زما نیکه ابراهیمه! په ما رحم وکړه او ایلعازر راولېږه چې خپله ګوته په اوبو کې لمده کړي او زما ژبه پرې یخه کړي، ځکه چې زه په دې اور کې ډېر په عذاب یم.›"}, {"ref": "Luke 1:24", "text": "ځکه په کومه ورځ چې د انسان زوی راځي د هغې برېښنا په شان به وي چې د اسمان له یو سر څخه تر بله سره پورې ځلیږي."}, {"ref": "Luke 1:24", "text": "کله چې عیسی ولیدل چې هغه غمجن شو، نو ویې ویل: «د شتمنو خلکو دپاره د خدای په پاچاهۍ کې ننوتل څومره ګران کار دی."}, {"ref": "Luke 1:24", "text": "بیا یې په هغه ځای کې ولاړو کسانو ته وویل: ‹له هغه څخه د سرو زرو سکه واخلئ او هغه نوکر ته یې ورکړئ چې لس سکې ورسره دي.›"}, {"ref": "Luke 1:25", "text": "یوه ورځ د شریعت یو عالم راغی او د عیسی څخه یې د ازمېښت دپاره یو سوال وکړ: «استاذه! زه باید څه وکړم چې تلپاتې ژوندون وګټم؟»"}, {"ref": "Luke 1:25", "text": "نو کله چې بېرته راشي، نو هغه کور جارو شوی او منظم وویني."}, {"ref": "Luke 1:25", "text": "ایا په تاسو کې څوک کولای شي چې په اندېښنو سره د خپل عمر یو ساعت هم زیات کړي؟"}, {"ref": "Luke 1:25", "text": "کله چې یوځل د کور خاوند راپاڅیږي او دروازه بنده کړي، نو تاسو به دباندې پاتې شئ او دروازه به ټکوئ او وایئ به چې ای ښاغلیه! دروازه خلاصه کړه. خو هغه به ځواب درکړي چې زه تاسو نه پېژنم چې له کوم ځای نه راغلي یئ."}, {"ref": "Luke 1:25", "text": "یوځل چې د خلکو یوه لویه ډله د عیسی سره روانه وه، عیسی هغوی ته مخ راواړاوه او ورته ویې ویل:"}, {"ref": "Luke 1:25", "text": "خو د هغه مشر زوی په دې وخت کې په پټي کې ؤ. کله چې راغی او کور ته رانژدې شو، نو د ساز او نڅا اواز یې واورېد."}, {"ref": "Luke 1:25", "text": "خو ابراهیم وویل: ‹زویه! در په یاد کړه، تا په خپل ژوند کې ټول ښه شیان تر‌لاسه کړل او ټول بد شیان د ایلعازر په نصیب کې وو. خو اوس هغه دلته ارام دی او ته په عذاب کې یې."}, {"ref": "Luke 1:25", "text": "خو لومړی باید هغه ډېر کړاوونه وزغمي او د دې زمانې د خلکو له خوا به رد شي."}, {"ref": "Luke 1:25", "text": "د ستنې د سوري څخه د اوښ تېرېدل اسانه دي، له دې نه چې یو شتمن سړی دې د خدای پاچاهۍ ته ورننوځي.»"}, {"ref": "Luke 1:25", "text": "خو هغوی ورته وویل: ‹باداره! د هغه سره خو لا د مخکې نه لس سکې شته.›"}, {"ref": "Luke 1:26", "text": "عیسی هغه ته ځواب ورکړ: «په شریعت کې څه لیکل شوي دي؟ هغه څنګه تعبیروې؟»"}, {"ref": "Luke 1:26", "text": "بیا هغه لاړ شي او تر ځان بد نور اووه پېریان راولي او هغوی ټول راشي، په هغه کس کې ورننوځي او هلته اوسیږي. نو د هغه حال له مخکې څخه هم خراب شي.» رښتینې خوشحالي"}, {"ref": "Luke 1:26", "text": "که چېرې تاسو داسې یو کوچنی کار نه شئ کولای، نو بیا ولې د نورو شیانو په هکله اندېښنه کوئ؟"}, {"ref": "Luke 1:26", "text": "نو بیا به تاسو وایئ: ‹مونږ تا سره په یو دسترخوان خوړلې او څښلې او تا زمونږ په کوڅو کې تعلیم ورکاوه.›"}, {"ref": "Luke 1:26", "text": "«که څوک ماته راځي او هغه د خپل مور، پلار، خپلې ښځې او اولادونو، خویندو او ورونو او حتی د خپل ځان څخه هم زما سره زیاته مینه ونه کړي، هغه نه شي کولای چې زما شاګرد شي."}, {"ref": "Luke 1:26", "text": "نو یو نوکر یې راوغوښت او پوښتنه یې ترې وکړه: ‹دا څه دي؟›"}, {"ref": "Luke 1:26", "text": "برسېره پر‌دې، زمونږ او ستاسو په منځ کې یوه لویه کنده شته چې له هغې څخه نه څوک درپورې وتلی شي او نه څوک ترې راپورې وتلی شي.›"}, {"ref": "Luke 1:26", "text": "لکه څنګه چې د نوح په زمانه کې شوي وو، همداسې به د انسان د زوی په زمانه کې هم وشي."}, {"ref": "Luke 1:26", "text": "کومو خلکو چې دا واورېدل، نو د هغه نه یې پوښتنه وکړه: «نو بیا څوک کولای شي چې خلاصون ومومي؟»"}, {"ref": "Luke 1:26", "text": "بادار یې وویل: ‹زه تاسو ته وایم چې د چا سره چې څه وي نو هغه ته به نور هم ورکړل شي، خو د چا سره چې څه نه وي، نو څه چې لري هغه به هم ترې واخیستل شي."}, {"ref": "Luke 1:27", "text": "هغه په ځواب کې وویل: «د خپل څښتن خدای سره د زړه له کومي، په خپل ټول روح او خپل ټول قوت او ټول عقل سره مینه کوه او د خپل ګاونډي سره د خپل ځان په شان مینه کوه.»"}, {"ref": "Luke 1:27", "text": "کله چې عیسی دا خبرې کولې، د خلکو له منځ څخه یوې ښځې په لوړ اواز هغه ته وویل: «بختوره ده هغه ښځه چې ته ورڅخه پیدا شوی یې او تاته یې شیدې درکړې دي.»"}, {"ref": "Luke 1:27", "text": "ځنګلي ګلانو ته وګورئ چې څنګه لوییږي. هغوی نه کار کوي او نه د ځانونو دپاره کالي جوړوي. خو تاسو ته وایم چې حتی سلیمان پاچا هم د خپل ټول شان او شوکت سره د دې ګلانو په شان ښکلی او سینګار شوی نه ؤ."}, {"ref": "Luke 1:27", "text": "خو هغه به بیا درته ووایي: ‹زه تاسو نه پېژنم چې له کوم ځای نه راغلي یئ. ای بدکارانو! زما د مخې نه لېرې شئ.›"}, {"ref": "Luke 1:27", "text": "که چېرې څوک خپل صلیب راوانخلي او ما پسې رانه شي، نو هغه زما شاګرد کېدای نه شي."}, {"ref": "Luke 1:27", "text": "نوکر ځواب ورکړ: ‹ستا ورور راغلی دی او پلار دې یو چاغ خوسی حلال کړی دی، ځکه چې هغه روغ رمټ بېرته راغلی دی.›"}, {"ref": "Luke 1:27", "text": "هغه شتمن سړي وویل: ‹ای زما پلاره ابراهیمه! زه تاته زارۍ کوم چې ایلعازر زما د پلار کور ته ولېږه،"}, {"ref": "Luke 1:27", "text": "خلکو تر هغې ورځې پورې خوړل، څښل او ودونه به یې کول، ترڅو چې نوح کشتۍ ته ننوت او سېلاب راغی او ټول یې تباه کړل."}, {"ref": "Luke 1:27", "text": "عیسی ځواب ورکړ: «هغه څه چې د انسانانو دپاره ناشوني دي، هغه د خدای دپاره ممکن دي.»"}, {"ref": "Luke 1:27", "text": "اوس زما هغه دښمنان چې نه یې غوښتل زه یې پاچا شم، دلته راولئ او زما په مخکې یې ووژنئ.›» عیسی په بریالیتوب سره اورشلیم ته ننوځي (متي ۲۱‏:‌۱‌‏-‌۱۱ او مرقوس ۱۱‏:‌۱‌‏-‌۱۱ او یوحنا ۱۲‏:‌۱۲‌‏-‌۱۹)"}, {"ref": "Luke 1:28", "text": "عیسی ورته وویل: «تا سم ځواب ورکړ. همداسې کوه، نو ته به ژوندی اوسې.»"}, {"ref": "Luke 1:28", "text": "خو عیسی ځواب ورکړ: «هو، هغه څوک بختور دی چې د خدای کلام اوري او عمل ورباندې کوي.» د معجزې غوښتنه (متي ۱۲‏:‌۳۸‌‏-‌۴۲)"}, {"ref": "Luke 1:28", "text": "که چېرې خدای د صحرا واښو ته چې نن دلته دي او سبا ته په تنور کې سوځول کیږي داسې ښکلا ورکوي، نو هغه به تاسو ته د هغو څخه ښه کالي در نه کړي؟ ستاسو ایمان ولې دومره کمزوری دی؟"}, {"ref": "Luke 1:28", "text": "کله چې تاسو ووینئ چې ابراهیم، اسحاق، یعقوب او ټول پیغمبران د خدای په پاچاهۍ کې دي خو تاسو ورڅخه شړل شوي یئ، نو بیا به ژاړئ او خپل غاښونه به چیچئ."}, {"ref": "Luke 1:28", "text": "فرض کړئ چې په تاسو کې کوم څوک غواړي یو برج جوړ کړي، ایا هغه به لومړی نه کښېني چې لګښت یې وسنجوي، ترڅو وویني چې د هغه سره دومره پیسې شته چې هغه ورباندې سرته ورسوي یا نه؟"}, {"ref": "Luke 1:28", "text": "خو مشر ورور دومره په قهر شو چې نه یې غوښتل کور ته ننوځي. پلار یې دباندې راووت او هغه ته یې زاري وکړه چې کور ته ننوځي."}, {"ref": "Luke 1:28", "text": "ځکه چې زه پنځه ورونه لرم. پرېږده چې هغه لاړ شي او هغوی خبر کړي، هسې نه چې هغوی هم دې د عذاب ځای ته راشي.›"}, {"ref": "Luke 1:28", "text": "د لوط په زمانه کې همداسې شوي وو چې هغوی به خوړل، څښل، اخیستل او خرڅول، کرنه یې کوله او ودانۍ به یې جوړولې."}, {"ref": "Luke 1:28", "text": "پطروس وویل: «وګوره، مونږ خپل هرڅه پریښي دي او تا پسې روان شو.»"}, {"ref": "Luke 1:28", "text": "کله چې عیسی دا خبرې وکړې، نو د خپلو شاګردانو څخه مخکې شو او د اورشلیم په لور روان شو."}, {"ref": "Luke 1:29", "text": "خو د دې دپاره چې د شریعت عالم دا وښایي چې هغه په حقه دی، نو د عیسی څخه یې پوښتنه وکړه: «زما ګاونډی څوک دی؟»"}, {"ref": "Luke 1:29", "text": "کله چې د عیسی په شاوخوا ډېر خلک راټول شول، هغه داسې وویل: «د دې زمانې خلک څومره بدکاره دي. هغوی معجزه غواړي، خو یوازېنۍ معجزه چې هغوی ته به وښودل شي هغه د یونس پیغمبر معجزه ده."}, {"ref": "Luke 1:29", "text": "نو اندېښنه مه کوئ چې تاسو به څه خورئ او څه به څښئ."}, {"ref": "Luke 1:29", "text": "خلک به د ختیځ او لوېدیځ او شمال او جنوب څخه راشي او د خدای د پاچاهۍ په مېلمستیا کې به کښېني."}, {"ref": "Luke 1:29", "text": "که نه، نو بنیاد به یې کېږدي، خو وبه نه شي کولای چې سرته یې ورسوي، نو هرڅوک چې هغه وګوري ورپورې وبه خاندي."}, {"ref": "Luke 1:29", "text": "خو هغه خپل پلار ته په ځواب کې وویل: ‹ګوره، کلونه کلونه کیږي چې ما لکه د غلام په شان ستا خدمت کړی دی او هېڅکله مې ستا د امر څخه سرغړونه نه ده کړې. خو ماته دې یو سېرلی هم نه دی راکړی چې خپلو ملګرو ته مې مېلمستیا ورکړې وای."}, {"ref": "Luke 1:29", "text": "ابراهیم وویل: ‹د هغوی سره د موسی او نورو پیغمبرانو لیکنې شته، نو باید د هغوی خبرو ته غوږ ونیسي او عمل پرې وکړي.›"}, {"ref": "Luke 1:29", "text": "خو په هغه ورځ چې لوط د سدوم څخه لاړ، نو د اسمان څخه اور او د ګوګړو باران راواورېد او هغوی ټول یې تباه کرل."}, {"ref": "Luke 1:29", "text": "عیسی هغوی ته وویل: «هو، په یقین سره زه تاسو ته دا وایم هرڅوک چې د خدای د پاچاهۍ دپاره خپل کور، خپله ښځه، ورونه، مور او پلار او اولادونه پرېږدي،"}, {"ref": "Luke 1:29", "text": "څنګه چې بیت‌فاجي او بیت‌عنیا ته چې د زیتونو په غره کې وو نژدې شو، نو خپل دوه شاګردان یې ولېږل،"}, {"ref": "Luke 1:30", "text": "عیسی داسې ځواب ورکړ: «په یو وخت کې یو سړی د اورشلیم څخه اریحا ته روان ؤ چې په لاره کې داړه مارانو ته په لاس ورغی. غلو هغه سړی لوڅ کړ، ویې واهه او د مرګ په حالت کې یې پرېښود او لاړل."}, {"ref": "Luke 1:30", "text": "لکه څنګه چې یونس پیغمبر د نینوا د خلکو دپاره یوه نښه وه، نو همداسې به د انسان زوی د دې زمانې د خلکو دپاره یوه نښه وي."}, {"ref": "Luke 1:30", "text": "ځکه چې د دې نړۍ خلک د دې شیانو په هکله اندېښنه کوي. خو ستاسو اسماني پلار پوهیږي چې تاسو دې شیانو ته اړتیا لرئ."}, {"ref": "Luke 1:30", "text": "څوک چې اوس وروستي دي، هغوی به اول شي او څوک چې اول وي هغوی به وروستي شي.» د اورشلیم دپاره د عیسی خفګان (متي ۲۳‏:‌۳۷‌‏-‌۳۹)"}, {"ref": "Luke 1:30", "text": "هغوی به وایي چې دې سړي د ودانۍ کار پیل کړ، خو ویې نه شو کولای چې سرته یې ورسوي."}, {"ref": "Luke 1:30", "text": "خو دې زوی دې خپل ټول جایداد په فاحشو باندې برباد کړ او کله چې بېرته کور ته راغی، نو تا ورته چاغ خوسی حلال کړ.›"}, {"ref": "Luke 1:30", "text": "شتمن سړي ځواب ورکړ: ‹نه، ای زما نیکه ابراهیمه! خو که له مړو څخه څوک هغوی ته ورشي، نو هغوی به توبه وباسي.›"}, {"ref": "Luke 1:30", "text": "په هغه ورځ چې د انسان زوی راښکاره شي، نو همداسې به وشي."}, {"ref": "Luke 1:30", "text": "نو هغه به په دې نړۍ کې د هغې څو چنده بدل تر‌لاسه کړي او په اخرت کې به تلپاتې ژوندون ولري.» عیسی د درېم ځل دپاره د خپل مرګ په هکله پېشګويي کوي (متي ۲۰‏:‌۱۷‌‏-‌۱۹ او مرقوس ۱۰‏:‌۳۲‌‏-‌۳۴)"}, {"ref": "Luke 1:30", "text": "او ورته ویې ویل: «دغه مخامخ کلي ته لاړ شئ. کله چې هغه کلي ته ننوتلئ، نو هلته به یو کوټی ووینئ چې تړل شوی به وي او تر‌اوسه پورې څوک ورباندې سپور شوی نه دی. هغه را‌ایله کړئ او دلته یې راولئ."}, {"ref": "Luke 1:31", "text": "ناڅاپه یو کاهن په هغه لاره تېرېده، کله یې چې هغه سړی ولیده، نو خپله لاره یې پرېښوده او ورڅخه تېر شو."}, {"ref": "Luke 1:31", "text": "د شیبا ملکه به د قیامت په ورځ راپاڅیږي او د دې زمانې خلک به ملامته کړي، ځکه چې هغه د نړۍ د بل سر څخه راغلې وه چې د سلیمان د حکمت څخه ډکې خبرې واوري. خو ګورئ اوس دلته یو څوک شته چې د سلیمان څخه لوی دی."}, {"ref": "Luke 1:31", "text": "د دې په ځای تاسو خپلو ځانونو ته د خدای پاچاهي وغواړئ، نو هغه به تاسو ته دا شیان هم درکړي. اسماني شتمني (متي ۶‏:‌۱۹‌‏-‌۲۱)"}, {"ref": "Luke 1:31", "text": "په هماغه وخت کې یو څو فریسیان عیسی ته راغلل او ورته ویې ویل: «دا ځای پرېږده او کوم بل ځای ته لاړ شه، ځکه چې هیرودیس غواړي تا ووژني.»"}, {"ref": "Luke 1:31", "text": "یا کوم داسې پاچا به وي چې د بل پاچا سره د جګړې دپاره ځي او پرته له دې چې لومړی کښېني او فکر وکړي چې ایا د خپل لسو زرو عسکرو سره به وکولای شي د هغه بل پاچا سره چې شل زره لښکر لري، وجنګیږي؟"}, {"ref": "Luke 1:31", "text": "پلار یې ورته وویل: ‹زما زویه! ته تل زما سره یې او زه چې هرڅه لرم هغه ستا دي."}, {"ref": "Luke 1:31", "text": "خو ابراهیم ورته وویل: ‹که چېرې هغوی د موسی او نورو پیغمبرانو خبرو ته غوږ ونه نیسي، نو که د مړو څخه هم څوک راپاڅیږي، هغوی به قانع نه شي.›»"}, {"ref": "Luke 1:31", "text": "په هغه ورځ څوک چې د بام په سر وي او سامان یې په کوټه کې وي، نو هغه دې د خپل سامان د وړلو دپاره راښکته نه شي. همدارنګه څوک چې په پټي کې وي، نو خپل کور ته دې ته بېرته لاړ نه شي."}, {"ref": "Luke 1:31", "text": "بیا هغه خپل دولس شاګردان ګوښه کړل او هغوی ته یې وویل: «واورئ! مونږ اوس اورشلیم ته ځو او هغه څه چې پیغمبرانو د انسان د زوی په هکله لیکلي دي، هغه به پوره شي."}, {"ref": "Luke 1:31", "text": "که څوک درڅخه پوښتنه وکړي: ‹هغه ولې ایله کوئ؟› نو داسې ورته ووایئ چې هغه زمونږ د استاذ په کار دی.»"}, {"ref": "Luke 1:32", "text": "همدارنګه یو لاوي چې کله هغه ځای ته راورسېد او هغه سړی یې ولیده، نو هغه هم ترې په بله خوا تېر شو او لاړ."}, {"ref": "Luke 1:32", "text": "د قیامت په ورځ به د نینوا خلک راپورته شي او د دې زمانې خلک به ملامته کړي، ځکه چې هغوی د یونس د وعظ په اورېدلو سره توبه وویستله، خو ګورئ څوک چې اوس دلته دی هغه د یونس نه ډېر لوی دی. د بدن څراغ (متي ۵‏:‌۱۵، ۶‏:‌۲۲‌‏-‌۲۳)"}, {"ref": "Luke 1:32", "text": "ای د شاګردانو کوچنۍ ډلې! مه وېرېږئ، ځکه چې ستاسو د اسماني پلار دا خوښه ده چې تاسو ته پاچاهي درکړي."}, {"ref": "Luke 1:32", "text": "عیسی هغوی ته وویل: «لاړ شئ او هغه ګیدړ ته ووایئ چې زه نن او سبا پېریان وباسم او خلک روغوم او په درېمه ورځ به خپل کار پای ته ورسوم."}, {"ref": "Luke 1:32", "text": "که چېرې هغه ونه شي کولای، نو مخکې له دې چې دښمن ورته راورسیږي، هغه به استازي ولېږي او د سولې د شرطونو په هکله به ورڅخه غوښتنه وکړي."}, {"ref": "Luke 1:32", "text": "خو اوس باید جشن ونیسو او خوشحالي وکړو، ځکه چې ستا دا ورور مړ شوی ؤ، خو اوس بېرته راژوندی شوی دی. هغه ورک شوی ؤ، خو اوس پیدا شوی دی.›»"}, {"ref": "Luke 1:32", "text": "د لوط ښځه در په یاد کړئ چې د هغې سره څه وشول."}, {"ref": "Luke 1:32", "text": "هغه به غیریهودیانو ته په لاس ورکړل شي. هغوی به ورباندې ملنډې ووهي، سپکاوی به یې وکړي او لاړې به ورباندې تو کړي."}, {"ref": "Luke 1:32", "text": "هغه دوه شاګردان لاړل او لکه څنګه چې عیسی ورته ویلي وو، هرڅه یې هماغه شان ولیدل."}, {"ref": "Luke 1:33", "text": "خو یو سامری چې په هغه لاره تېرېده هغه ته ورغی او کله یې چې هغه سړی ولیده نو زړه یې ورباندې وسوځېد."}, {"ref": "Luke 1:33", "text": "هېڅوک څراغ د دې دپاره نه بلوي چې هغه په یو پټ ځای کې کېږدي او یا یې د یوې کاسې لاندې کېږدي، بلکې هغه په څراغدان باندې ږدي چې کله خلک راشي، نو رڼا یې وویني."}, {"ref": "Luke 1:33", "text": "هرڅه چې لرئ هغه خرڅ کړئ او پیسې یې غریبانو ته ورکړئ. د خپلو ځانونو دپاره د پیسو داسې کڅوړې تیارې کړئ چې هېڅکله نه زړیږي یعنې په اسمان کې داسې خزانې جوړې کړئ چې هېڅکله نه کمیږي، ځکه چې هېڅ یو غل ورته نژدې کېدای نه شي او نه یې چینجي خوړلی شي."}, {"ref": "Luke 1:33", "text": "په هر حال، زه باید نن او سبا او بل سبا خپل سفر ته دوام ورکړم، ځکه چې دا ناشونې ده چې یو پیغمبر دې د اورشلیم څخه پرته په بل ځای کې ووژل شي."}, {"ref": "Luke 1:33", "text": "په همدې ډول په تاسو کې هېڅوک تر هغې زما شاګرد کېدای نه شي، ترڅو هر څه چې لري د هغو ټولو څخه تېر نه شي. د بې‌خونده مالګې مثال (متي ۵‏:‌۱۳ او مرقوس ۹‏:‌۵۰)"}, {"ref": "Luke 1:33", "text": "هرڅوک چې د خپل ځان د ساتلو کوښښ وکړي، نو هغه به له لاسه ورکړي او څوک چې خپل ځان له لاسه ورکړي، نو هغه به یې وژغوري."}, {"ref": "Luke 1:33", "text": "هغه به په دورو ووهي او وبه یې وژني، خو په درېمه ورځ به بیا راژوندی شي.»"}, {"ref": "Luke 1:33", "text": "کله چې هغوی هغه کوټی ایله کاوه، نو خاوندانو یې ورڅخه پوښتنه وکړه: «دا کوټی ولې ایله کوئ؟»"}, {"ref": "Luke 1:34", "text": "هغه ته ورغی، ټپونه یې ورته په شرابو ووینځل او تېل یې ورباندې واچول او پټۍ یې ورباندې کېښودله. بیا یې هغه په خپل خره باندې سپور کړ او یوې مسافرخانې ته یې یووړ او هلته یې ورباندې پام کاوه."}, {"ref": "Luke 1:34", "text": "ستا سترګې ستا د بدن دپاره لکه د څراغ په شان دي. کله چې دې سترګې روغې وي نو ټول بدن به دې هم رڼا وي، خو کله چې دې سترګې خرابې وي، نو ستا بدن به هم تیاره وي."}, {"ref": "Luke 1:34", "text": "ځکه په هرځای کې چې ستاسو خزانه وي، نو ستاسو زړونه به هم هلته وي. بېداره نوکران"}, {"ref": "Luke 1:34", "text": "ای اورشلیمه! ای اورشلیمه! ای هغه ښاره چې پیغمبران وژنې او کوم کسان چې د خدای له خوا درلېږل کیږي، هغه سنګساروې. ما څو څو ځلې وغوښتل چې ستا خلک داسې سره راټول کړم لکه چرګه چې خپل بچي د خپلو وزرونو لاندې راټولوي، خو تا ونه غوښتل."}, {"ref": "Luke 1:34", "text": "مالګه ښه شی دی، خو که په خپله مالګه بې‌خونده شي، نو هغه به څنګه بېرته خپل خوند پیدا کړي؟"}, {"ref": "Luke 1:34", "text": "زه تاسو ته وایم، په هغه شپه که چېرې دوه تنه په یو کټ کې پراته وي، یو به یې بوتلل شي او بل به پرېښودل شي."}, {"ref": "Luke 1:34", "text": "خو شاګردان په دې خبرو پوه نه شول، ځکه چې د دې خبرو معنی د هغوی څخه پټه ساتل شوې وه او هغوی نه پوهېدل چې عیسی د څه شي په هکله خبرې کولې. عیسی یو ړوند سوالګر بینا کوي (متي ۲۰‏:‌۲۹‌‏-‌۳۴ او مرقوس ۱۰‏:‌۴۶‌‏-‌۵۲)"}, {"ref": "Luke 1:34", "text": "هغوی ځواب ورکړ: «دا زمونږ د استاذ په کار دی.»"}, {"ref": "Luke 1:35", "text": "سبا سهار هغه د سپینو زرو دوه سکې واخیستې او د مسافرخانې خاوند ته یې ورکړې او ورته ویې ویل: ‹په هغه باندې پام کوه او که نورې پیسې دې ورباندې ولګولې نو کله چې بېرته راغلم هغه به هم درکړم.›»"}, {"ref": "Luke 1:35", "text": "نو پام کوه، هسې نه په تا کې چې کومه رڼا ده هغه تیاره وي."}, {"ref": "Luke 1:35", "text": "خپلې ملاګانې وتړئ، د کار دپاره تیار اوسئ او څراغونه مو بل وساتئ."}, {"ref": "Luke 1:35", "text": "ګوره، ستاسو کور تاسو ته خالي پرېښودل کیږي. زه تاسو ته وایم چې نور به ما تر هغې ونه وینئ ترڅو هغه وخت راشي چې دا ووایئ: ‹مبارک دی هغه څوک چې د څښتن په نوم راځي.›»"}, {"ref": "Luke 1:35", "text": "د هغې څخه نور نه د ځمکې دپاره او نه د سرې دپاره کار اخیستل کیږي او خلک هغه لېرې غورځوي. که څوک غوږونه لري، نو هغه دې واوري.»"}, {"ref": "Luke 1:35", "text": "د دوو ښځو څخه چې یوځای سره میچن کوي، یوه به یې بوتلل شي او بله به پرېښودل شي."}, {"ref": "Luke 1:35", "text": "کله چې عیسی د اریحا ښار ته نژدې شو، نو یو ړوند سړی په لاره کې ناست ؤ او خیر یې غوښته."}, {"ref": "Luke 1:35", "text": "او هغوی هغه کوټی عیسی ته راوست، خپلې چپنې یې ورباندې واچولې او عیسی یې ورباندې سپور کړ."}, {"ref": "Luke 1:36", "text": "بیا عیسی پوښتنه وکړه: «اوس څه فکر کوې چې په دې درې واړو کې د هغه سړي چې د داړه مارانو لاس ته ورغلی ؤ، ګاونډی څوک دی؟»"}, {"ref": "Luke 1:36", "text": "که چېرې ستا ټول بدن د روښنایۍ څخه ډک وي او یوه برخه یې هم په تیاره کې نه وي، نو ټول بدن به دې داسې روښانه وي لکه څراغ چې په خپله رڼا تا روښانه کړي.» عیسی فریسیان او د شریعت عالمان ملامتوي (متي ۲۳‏:‌۱‌‏-‌۳۶ او مرقوس ۱۲‏:‌۳۸‌‏-‌۴۰)"}, {"ref": "Luke 1:36", "text": "د هغو نوکرانو په شان اوسئ چې خپل بادار ته د واده د مېلمستیا څخه د بېرته راتللو په انتظار وي. کله چې هغه راشي او دروازه وټکوي، نو سمدلاسه یې ورته خلاصه کړي."}, {"ref": "Luke 1:36", "text": "که چېرې دوه سړي په پټي کې وي، نو یو به یې بوتلل شي او بل به پرېښودل شي.»"}, {"ref": "Luke 1:36", "text": "کله چې هغه سړي د ګڼ شمېر خلکو اوازونه چې له هغه ځای څخه تېرېدل واورېدل، نو پوښتنه یې وکړه: «څه خبره ده؟»"}, {"ref": "Luke 1:36", "text": "کله چې هغه په لاره تللو، نو خلکو خپل کالي ورته په لاره کې غوړول."}, {"ref": "Luke 1:37", "text": "د شریعت عالم ځواب ورکړ: «هغه څوک چې په هغه باندې یې رحم وکړ.» عیسی ورته وویل: «لاړ شه او ته هم همداسې کوه.» عیسی د مرتا او مریم سره لیدنه کوي"}, {"ref": "Luke 1:37", "text": "کله چې عیسی خپلې خبرې خلاصې کړې، نو یو فریسي هغه ته د ډوډۍ دپاره بلنه ورکړه. عیسی د هغه کور ته ورغی او دسترخوان ته کښېناست."}, {"ref": "Luke 1:37", "text": "بختور دي هغه نوکران چې کله یې بادار راشي او وویني چې هغوی بېداره ناست دي. په یقین سره زه تاسو ته دا وایم چې بادار به خپله ملا وتړي، هغوی به دسترخوان ته کښېنوي او رابه شي او د هغوی خدمت به وکړي."}, {"ref": "Luke 1:37", "text": "شاګردانو د هغه څخه پوښتنه وکړه: «چېرته، ای استاذه؟» عیسی په ځواب کې وویل: «چېرته چې مرداره وي، هلته ټپوسان راټولیږي.»"}, {"ref": "Luke 1:37", "text": "هغوی ورته وویل: «ناصري عیسی په دې لاره تېریږي.»"}, {"ref": "Luke 1:37", "text": "کله چې عیسی هغې لارې ته نژدې شو چې د زیتون د غره څخه راښکته شوې وه، نو ټولو پیروانو یې په خوشحالۍ او لوړ اواز سره د هغو معجزو په خاطر چې هغوی لیدلې وې د خدای د ثنا په ویلو پیل وکړ."}, {"ref": "Luke 1:38", "text": "کله چې عیسی او شاګردان یې په خپله لاره روان شول، هغوی یو کلي ته ورسېدل او هلته یوې ښځې چې مرتا نومېدله عیسی په خپل کور کې مېلمه کړ."}, {"ref": "Luke 1:38", "text": "کله چې فریسي ولیدل چې عیسی د خوراک څخه مخکې لاسونه ونه وینځل، نو حیران شو."}, {"ref": "Luke 1:38", "text": "بختور دي هغه نوکران چې کله یې بادار په نیمه شپه یا حتی سهار وختي راشي او وویني چې هغوی بېداره ناست دي."}, {"ref": "Luke 1:38", "text": "نو هغه چیغې ووهلې: «ای عیسی د داود زویه! په ما رحم وکړه.»"}, {"ref": "Luke 1:38", "text": "او ویل یې: «مبارک دی هغه پاچا چې د څښتن په نوم راځي. سلامتي دې وي په اسمان کې او جلال دې وي څښتن تعالی ته.»"}, {"ref": "Luke 1:39", "text": "هغې د مریم په نوم یوه خور درلودله. هغه راغله او د عیسی پښو ته کښېناستله او د هغه خبرو ته یې غوږ نیولی ؤ."}, {"ref": "Luke 1:39", "text": "عیسی هغه ته وویل: «تاسو فریسیان د خپلو پیالو او قابونو باندینۍ برخې پاکوئ، خو ستاسو زړونه د حرص او بدیو څخه ډک دي."}, {"ref": "Luke 1:39", "text": "خو تاسو باید په دې پوه شئ چې که چېرې د کور خاوند پوهېدلی چې غل به کله راځي، نو نه به یې پرېښوده چې د هغه کور ته ورننوځي."}, {"ref": "Luke 1:39", "text": "کوم خلک چې د عیسی څخه مخکې روان وو، هغه سړی ورټلو او ورته ویې ویل: «غلی شه.» خو هغه نور هم په لوړ اواز چیغې کړې: «ای د داود زویه! په ما رحم وکړه.»"}, {"ref": "Luke 1:39", "text": "د خلکو له منځ څخه ځینو فریسیانو عیسی ته وویل: «استاذه! خپلو شاګردانو ته ووایه چې غلي شي.»"}, {"ref": "Luke 1:40", "text": "مرتا د ډېرو کارونو له لاسه ستړې او پرېشانه شوه، نو عیسی ته راغله او ورته ویې ویل: «استاذه! ستا دې ته پام نه دی چې ټول کارونه زه کوم او خور مې راسره مرسته نه کوي؟ هغې ته ووایه چې راشي او مرسته راسره وکړي.»"}, {"ref": "Luke 1:40", "text": "ای کم‌عقلو خلکو! چا چې باندینۍ برخه جوړه کړې ده ایا هغه دنننۍ برخه نه ده جوړه کړې؟"}, {"ref": "Luke 1:40", "text": "نو تاسو هم باید تیار اوسئ، ځکه چې د انسان زوی به په داسې وخت کې راشي چې تاسو به یې د راتللو انتظار هم نه لرئ.» وفادار او بې‌وفا نوکر (متي ۲۴‏:‌۴۵‌‏-‌۵۱)"}, {"ref": "Luke 1:40", "text": "نو عیسی ودرېده او امر یې وکړ چې هغه سړی هغه ته راولي. کله چې ورنژدې شو، نو عیسی ورڅخه پوښتنه وکړه:"}, {"ref": "Luke 1:40", "text": "عیسی په ځواب کې وویل: «زه تاسو ته وایم که هغوی غلي شي، نو تیږې به په چیغو پیل وکړي.» عیسی د اورشلیم په حال ژاړي"}, {"ref": "Luke 1:41", "text": "عیسی هغې ته په ځواب کې وویل: «مرتا، مرتا! ته د ډېرو شیانو دپاره اندېښنه کوې او نا‌ارامه یې،"}, {"ref": "Luke 1:41", "text": "خو څه چې ستاسو په پیالو او قابونو کې دي هغه غریبانو ته خیرات ورکړئ، نو بیا به ټول شیان ستاسو دپاره پاک شي."}, {"ref": "Luke 1:41", "text": "پطروس وویل: «ای استاذه! ایا دا مثال یوازې زمونږ دپاره دی او که د ټولو دپاره؟»"}, {"ref": "Luke 1:41", "text": "«څه غواړې چې درته ویې وکړم؟» هغه وویل: «ای ښاغلیه! غواړم چې بینا شم.»"}, {"ref": "Luke 1:41", "text": "کله چې عیسی اورشلیم ته نژدې شو او ښار یې ولیده، نو ورته په ژړا شو"}, {"ref": "Luke 1:42", "text": "خو یوازې یو شی ضروري دی. څه چې مریم خوښ کړي دي هغه ښه دي او دا به له هغې څخه وانخیستل شي.»"}, {"ref": "Luke 1:42", "text": "خو ای فریسیانو! ستاسو په حال دې افسوس وي. تاسو د وېلني او سپېلني او نورو بوټو لسمه برخه ورکوئ، خو په انصاف کولو او د خدای سره په مینه کولو کې بې‌پروایي کوئ. تاسو باید په دې ټولو باندې عمل کولای او هغه نور مو هم له نظره نه غورځولی."}, {"ref": "Luke 1:42", "text": "عیسی ځواب ورکړ: «نو هغه وفادار او هوښیار نوکر څوک دی چې بادار یې د خپلو نوکرانو په سر وټاکي، ترڅو په خپل وخت هغوی ته خپله برخه خواړه ورکړي؟"}, {"ref": "Luke 1:42", "text": "عیسی هغه ته وویل: «بینا شه، ته خپل ایمان روغ کړې.»"}, {"ref": "Luke 1:42", "text": "او ویې ویل: «کاشکې نن تاته هم د سولې او سلامتۍ لار معلومه وای. خو نه، اوس دا لاره ستا د نظر څخه پټه ده."}, {"ref": "Luke 1:43", "text": "ای فریسیانو! ستاسو په حال دې افسوس وي. تاسو دا خوښوئ چې په کنیسو کې مخکې ځایونه ونیسئ، او دا خوښوئ چې په بازارونو کې دې درته سلامونه واچول شي."}, {"ref": "Luke 1:43", "text": "بختور دی هغه نوکر چې بادار یې راشي او هغه په خپل کار کې بوخت وویني."}, {"ref": "Luke 1:43", "text": "او هغه سمدلاسه بینا شو او په داسې حال کې چې د خدای ثنا یې ویله، د عیسی پسې روان شو. کله چې خلکو دا هرڅه ولیدل، نو ټولو د خدای ثنا وویله."}, {"ref": "Luke 1:43", "text": "ځکه چې داسې ورځې به درباندې راشي چې ستا دښمنان به ستا څخه ګردچاپېره مورچلې جوړې کړي، ستا نه به راتاو شي او د هرې خوا نه به دې را‌ایسار کړي."}, {"ref": "Luke 1:44", "text": "ستاسو په حال دې افسوس وي. تاسو د هغو بې‌نښو او بې‌شناختو قبرونو په شان یئ چې خلک ورباندې ګرځي او نه یې پېژني.»"}, {"ref": "Luke 1:44", "text": "په رښتیا سره زه وایم چې بادار به د خپل ټول مال او جایداد مسوولیت هغه ته وسپاري."}, {"ref": "Luke 1:44", "text": "هغوی به تا او ستا خلک د ځمکې سره هوار کړي او په تا کې به یوه تیږه هم د بلې دپاسه پرېنږدي، ځکه چې تا د خدای د راتللو وخت ونه پېژانده.» عیسی د خدای د کور څخه سوداګران شړي (متي ۲۱‏:‌۱۲‌‏-‌۱۷ او مرقوس ۱۱‏:‌۱۵‌‏-‌۱۹ او یوحنا ۲‏:‌۱۳‌‏-‌۲۲)"}, {"ref": "Luke 1:45", "text": "د شریعت د عالمانو څخه یو تن عیسی ته په ځواب کې وویل: «استاذه! کله چې داسې خبرې کوې، نو زمونږ هم سپکاوی کوې.»"}, {"ref": "Luke 1:45", "text": "خو که هغه نوکر د خپل ځان سره ووایي چې بادار به مې دومره زر رانه شي او د نورو ټولو نوکرانو په وهلو ټکولو پیل وکړي، وخوري، وڅښي او نشې وکړي،"}, {"ref": "Luke 1:45", "text": "کله چې عیسی د خدای کور ته ننوت، نو د هغو خلکو په ویستلو یې پیل وکړ چې هلته یې شیان خرڅول."}, {"ref": "Luke 1:46", "text": "عیسی ځواب ورکړ: «ای د شریعت عالمانو! ستاسو په حال دې هم افسوس وي. تاسو خلکو ته داسې بارونه ور په شا کوئ چې په سختۍ سره یې وړي، خو خپله ورته ګوتې هم نه وروړئ."}, {"ref": "Luke 1:46", "text": "نو بادار به یې په داسې ورځ راشي چې هغه به یې انتظار هم نه لري او په داسې وخت کې به راشي چې هغه به خبر هم نه وي. نو بادار به هغه ته سخته سزا ورکړي او هغه به په بې‌ایمانانو کې وشمېرل شي."}, {"ref": "Luke 1:46", "text": "هغوی ته یې وویل: «د خدای په کلام کې لیکل شوي دي: زما کور به د دعا کور وي. خو تاسو ورڅخه د غلو د پټېدلو ځای جوړ کړی دی.»"}, {"ref": "Luke 1:47", "text": "ستاسو په حال دې افسوس وي. تاسو د هغو پیغمبرانو دپاره زیارتونه جوړوئ چې ستاسو نیکونو وژلي وو."}, {"ref": "Luke 1:47", "text": "هغه نوکر چې په دې پوهیږي چې خپل بادار یې ترې څه غواړي، خو بیاهم تیار نه دی چې هغه کار وکړي، نو هغه به سخت ووهل شي."}, {"ref": "Luke 1:47", "text": "عیسی هره ورځ د خدای په کور کې تعلیم ورکاوه. خو مشرانو کاهنانو، د شریعت عالمانو او قومي مشرانو هڅه کوله چې هغه ووژني،"}, {"ref": "Luke 1:48", "text": "ستاسو نیکونو چې کوم کارونه کړي دي تاسو په خپله هغه منئ او تصدیقوئ. هغوی پیغمبران ووژل او تاسو ورته زیارتونه جوړوئ،"}, {"ref": "Luke 1:48", "text": "خو هغه نوکر چې په دې نه پوهیږي چې بادار یې څه غواړي او کوم غلط کار وکړي چې د سزا وړ وي، نو لږ به ووهل شي. چاته چې ډېر ورکړل شي، نو ډېر به ورڅخه غوښتل کیږي. څومره ډېر چې چاته سپارل کیږي هماغومره ډېر ورڅخه غوښتل کیږي.» د عیسی په سبب بېلتون (متي ۱۰‏:‌۳۴‌‏-‌۳۶)"}, {"ref": "Luke 1:48", "text": "خو هېڅ یې له لاسه پوره نه ؤ، ځکه چې ټولو خلکو په ډېر شوق سره د هغه خبرو ته غوږ نیولی ؤ."}, {"ref": "Luke 1:49", "text": "له دې امله خدای په خپل حکمت سره وویل: ‹زه به هغوی ته پیغمبران او رسولان ورولېږم. خو هغوی به له دوی څخه ځینې ووژني او نور به وځوروي.›"}, {"ref": "Luke 1:49", "text": "عیسی زیاته کړه: «زه د دې دپاره راغلی یم چې په ځمکه اور ولګوم او کاشکې دا اور لا پخوا لګېدلی وای."}, {"ref": "Luke 1:50", "text": "نو د دې زمانې د خلکو څخه به د هغو پیغمبرانو د وینو ځواب چې د نړۍ د پیدایښت راهیسې توی شوي دي وغوښتل شي."}, {"ref": "Luke 1:50", "text": "زه به د یو سخت تعمید څخه تېرېږم او ترڅو پورې چې هغه تر‌سره شوی نه وي، زما زړه به څومره نا‌ارامه وي."}, {"ref": "Luke 1:51", "text": "د هابیل له وژلو نیولې د زکریا تر وژلو پورې چې د قربانۍ د ځای او سپېڅلي ځای ترمنځ ووژل شو. هو، زه تاسو ته وایم چې د دې زمانې خلک به د دې هرڅه دپاره ځواب ورکوي."}, {"ref": "Luke 1:51", "text": "ایا تاسو ګومان کوئ چې زه د دې دپاره راغلی یم چې نړۍ ته سوله راولم؟ نه، د سولې دپاره نه بلکې د بې‌اتفاقۍ اچولو دپاره راغلی یم."}, {"ref": "Luke 1:52", "text": "ای د شریعت عالمانو! ستاسو په حال دې افسوس وي. تاسو د علم د کور د دروازې کیلي اخیستې ده، په خپله هم نه ورننوځئ او څوک چې ورننوځي هغوی هم نه پرېږدئ.»"}, {"ref": "Luke 1:52", "text": "ځکه له دې وروسته چې پنځه تنه په یو کور کې وي سره بېل به شي، درې تنه به د دوه تنو او دوه تنه به د درې تنو په خلاف شي."}, {"ref": "Luke 1:53", "text": "کله چې عیسی له هغه کوره ووت، د شریعت عالمانو او فریسیانو د هغه سره ډېر سخت مخالفت پیل کړ او د ډېرو شیانو په هکله یې ورڅخه سختې پوښتنې کولې."}, {"ref": "Luke 1:53", "text": "پلار به د زوی په خلاف شي او زوی به د پلار په خلاف، مور به د لور او لور به د مور په خلاف، خواښې به د انږور او انږور به د خواښې په خلاف شي.» د وخت پېژندل (متي ۱۶‏:‌۲‌‏-‌۳)"}, {"ref": "Luke 1:54", "text": "هغوی کوښښ کاوه چې هغه په خپلو خبرو کې راونیسي."}, {"ref": "Luke 1:54", "text": "همدارنګه عیسی خلکو ته وویل: «کله چې تاسو ووینئ چې ورېځې د لمر پرېواته له خوا راپورته کیږي، نو سمدلاسه وایئ چې باران به وشي او همداسې کیږي."}, {"ref": "Luke 1:55", "text": "کله چې باد د جنوب له خوا ولګیږي، نو تاسو وایئ چې سخته ګرمي به شي او همداسې کیږي."}, {"ref": "Luke 1:56", "text": "ای منافقانو! تاسو کولای شئ چې ځمکې او اسمان ته په کتلو سره د هوا د حالت پېشګویي وکړئ، نو بیا څنګه اوسنۍ زمانه نه شئ پېژندلی؟ د خپل مدعي سره روغه جوړه کول (متي ۵‏:‌۲۵‌‏-‌۲۶)"}, {"ref": "Luke 1:57", "text": "تاسو خپله ولې دا پرېکړه نه شئ کولای چې کومه لاره سمه ده؟"}, {"ref": "Luke 1:58", "text": "کله چې له خپل مدعي سره قاضي ته ځئ، نو په لاره کې کوښښ وکړئ چې د هغه سره روغه وکړئ. که نه، نو هغه به مو قاضي ته راکاږي او قاضي به تاسو پولیس ته وسپاري او په زندان کې به واچول شئ."}, {"ref": "Luke 1:59", "text": "زه تاسو ته وایم چې تر هغې پورې به له زندان څخه راخلاص نه شئ چې ترڅو پورې مو د خپل پور یوه یوه پیسه نه وي ورکړې.»"}, {"ref": "Luke 2:1", "text": "یوه ورځ کله چې عیسی د خدای په کور کې خلکو ته تعلیم ورکاوه او زېری یې ورته رسولو، مشران کاهنان او د شریعت عالمان د نورو یهودي مشرانو سره راغلل"}, {"ref": "Luke 2:1", "text": "عیسی شاوخوا وکتل او ویې لیدل چې شتمن خلک خپلې نذرانې د خدای د کور په خزانه کې اچوي،"}, {"ref": "Luke 2:1", "text": "د فطیرې ډوډۍ اختر چې د فسحې په نامه مشهور ؤ، نژدې شو."}, {"ref": "Luke 2:1", "text": "بیا د شورا ټول غړي پاڅېدل او عیسی یې پیلاتوس ته بوته"}, {"ref": "Luke 2:1", "text": "د یکشنبې په ورځ سهار وختي ښځو هغه تیار کړي خوشبویه تېل د ځان سره واخیستل او قبر ته لاړې."}, {"ref": "Luke 2:2", "text": "او هغه ته یې وویل: «ته څه حق لرې چې دا کارونه کوې؟ چا تاته دا اختیار درکړی دی؟»"}, {"ref": "Luke 2:2", "text": "او همدارنګه هغه یوه غریبه کونډه ولیدله چې خپلې دوه روپۍ یې په هغې خزانه کې واچولې."}, {"ref": "Luke 2:2", "text": "مشرانو کاهنانو او د شریعت عالمانو هڅه کوله چې یوه لاره پیدا کړي چې عیسی ووژني، خو له خلکو څخه وېرېدل. یهودا اسخریوتي دې ته راضي کیږي چې د عیسی سره خیانت وکړي (متي ۲۶‏:‌۱۴‌‏-‌۱۶ او مرقوس ۱۴‏:‌۱۰‌‏-‌۱۱)"}, {"ref": "Luke 2:2", "text": "او په هغه باندې یې په تور لګولو پیل وکړ او ویې ویل: ‎«مونږ ولیدل چې دې سړي زمونږ قوم بې‌لارې کاوه او خلک یې امپراتور ته د مالیې ورکولو څخه منع کول او دعوه کوي چې هغه خپله مسیح یعنې پاچا دی.»"}, {"ref": "Luke 2:2", "text": "هغوی ولیدل چې تیږه د قبر د خولې نه رغړول شوې وه."}, {"ref": "Luke 2:3", "text": "عیسی هغوی ته په ځواب کې وویل: «زه هم ستاسو څخه یوه پوښتنه کوم، ماته ووایئ چې"}, {"ref": "Luke 2:3", "text": "عیسی وویل: «زه تاسو ته رښتیا وایم چې دې غریبې کونډې د نورو ټولو څخه زیاتې پیسې واچولې،"}, {"ref": "Luke 2:3", "text": "بیا شیطان د یهودا اسخریوتي په زړه کې چې د هغو دولسو شاګردانو څخه ؤ، ننوت."}, {"ref": "Luke 2:3", "text": "پیلاتوس د هغه څخه پوښتنه وکړه: «ایا ته د یهودیانو پاچا یې؟» عیسی ځواب ورکړ: «ته په خپله وایې.»"}, {"ref": "Luke 2:3", "text": "کله چې دننه ورغلې، نو د عیسی مسیح مړی یې هلته پیدا نه کړ."}, {"ref": "Luke 2:4", "text": "د یحیی د تعمید ورکول د خدای له خوا ؤ یا د انسان له خوا؟»"}, {"ref": "Luke 2:4", "text": "ځکه چې هغوی ټولو هغه پیسې واچولې چې د هغوی د اړتیاوو څخه زیاتې وې، خو دې ښځې د خپلې غریبۍ سره بیاهم هرڅه چې یې لرل واچول.» د خدای د کور د ورانېدلو پېشګویي (متي ۲۴‏:‌۱‌‏-‌۲ او مرقوس ۱۳‏:‌۱‌‏-‌۲)"}, {"ref": "Luke 2:4", "text": "یهودا لاړ او د مشرانو کاهنانو او د خدای د کور د ساتونکو د آمرانو سره یې په دې هکله خبرې وکړې چې څنکه عیسی هغوی ته په لاس ورکړي."}, {"ref": "Luke 2:4", "text": "بیا پیلاتوس مشرانو کاهنانو او حاضرو خلکو ته وویل: «زه په دې سړي کې هېڅ ډول جرم نه وینم.»"}, {"ref": "Luke 2:4", "text": "هغوی لا حیرانې ولاړې وې چې ناڅاپه دوه سړي چې ځلېدونکي کالي یې اغوستي وو د هغوی په خوا کې ودرېدل."}, {"ref": "Luke 2:5", "text": "هغوی په خپل منځ کې بحث وکړ او ویل یې: «که چېرې ووایو چې د خدای له خوا ؤ، نو هغه به ووایي چې بیا تاسو ولې په هغه باندې ایمان رانه وړ؟"}, {"ref": "Luke 2:5", "text": "ځینو شاګردانو د خدای د کور په هکله خبرې کولې او د هغو ښکلو تیږو او نذرانو صفتونه یې کول چې د خدای کور ورباندې ښکلی شوی ؤ. عیسی وویل:"}, {"ref": "Luke 2:5", "text": "هغوی ډېر خوشحاله شول او د هغه سره یې د پیسو وعده وکړه."}, {"ref": "Luke 2:5", "text": "خو هغوی ډېر ټینګار کاوه او ویل یې: «هغه په ټوله یهودیه کې په تعلیم ورکولو سره خلک راپاروي. هغه د جلیل څخه پیل وکړ او تر دې ځایه راورسېد.» عیسی هیرودیس ته لېږل کیږي"}, {"ref": "Luke 2:5", "text": "ښځې ووېرېدلې او هغوی خپل سرونه ښکته ونیول، نو هغو سړیو ورته وویل: «تاسو ولې ژوندي په مړو کې لټوئ؟"}, {"ref": "Luke 2:6", "text": "خو که چېرې ووایو چې د انسان له خوا ؤ، نو ټول خلک به مونږ سنګسار کړي، ځکه چې هغوی په دې عقیده دي چې یحیی پیغمبر ؤ.»"}, {"ref": "Luke 2:6", "text": "«دا شیان چې تاسو یې وینئ، داسې وخت به راشي چې په دې کې به یوه تیږه هم په بله تیږه پاتې نه شي او ټولې به راونړیږي.» د اخرې زمانې نښې (متي ۲۴‏:‌۳‌‏-‌۱۴ او مرقوس ۱۳‏:‌۳‌‏-‌۱۳)"}, {"ref": "Luke 2:6", "text": "نو یهودا ورسره ومنله او د یوې ښې موقعې په لټه کې شو چې کله د عیسی سره نور خلک نه وي هغوی ته یې په لاس ورکړي. د فسحې د اختر تیاری (متي ۲۶‏:‌۱۷‌‏-‌۲۵ او مرقوس ۱۴‏:‌۱۲‌‏-‌۲۱)"}, {"ref": "Luke 2:6", "text": "کله چې پیلاتوس دا واورېدل، نو پوښتنه یې وکړه: «ایا دا سړی جلیلي دی؟»"}, {"ref": "Luke 2:6", "text": "هغه دلته نشته، هغه راژوندی شوی دی. څه چې هغه درته په جلیل کې ویلي وو، هغه در په یاد کړئ"}, {"ref": "Luke 2:7", "text": "نو ځواب یې ورکړ: «مونږ نه پوهېږو چې د کوم ځای ؤ.»"}, {"ref": "Luke 2:7", "text": "هغوی پوښتنه وکړه: «ای استاذه! دا هرڅه به کله پېښیږي او د دې پېښو د رانژدې کېدلو نښې به څه وي؟»"}, {"ref": "Luke 2:7", "text": "بیا د فطیرې ډوډۍ د اختر ورځ چې په هغه کې به د فسحې وری قرباني کېده، راورسېدله."}, {"ref": "Luke 2:7", "text": "کله چې هغه خبر شو چې عیسی د هغې سیمې څخه دی چې د هیرودیس تر واکمنۍ لاندې ده، نو هغه یې هیرودیس ته چې په هغه وخت کې په اورشلیم کې ؤ، ولېږه."}, {"ref": "Luke 2:7", "text": "چې د انسان زوی باید ګناهکارانو ته په لاس ورکړل شي، په صلیب به وځړول شي او په درېمه ورځ به بیا راژوندی شي.»"}, {"ref": "Luke 2:8", "text": "عیسی هغوی ته وویل: «زه هم تاسو ته نه وایم چې په کوم اختیار دا کارونه کوم.» د انګورو د باغ او باغوانانو مثال (متي ۲۱‏:‌۳۳‌‏-‌۴۶ او مرقوس ۱۲‏:‌۱‌‏-‌۱۲)"}, {"ref": "Luke 2:8", "text": "عیسی وویل: «پام کوئ چې بې‌لارې نه شئ. ځکه چې ډېر به زما په نوم راشي او وایي به: ‹زه مسیح یم› او ‹هغه وخت رارسېدلی دی‎.› خو د هغوی پسې مه ځئ."}, {"ref": "Luke 2:8", "text": "نو عیسی پطروس او یوحنا ولېږل او ورته ویې ویل: «لاړ شئ او زمونږ دپاره د فسحې ډوډۍ تیاره کړئ چې ویې خورو.»"}, {"ref": "Luke 2:8", "text": "کله چې هیرودیس عیسی ولیده نو ډېر خوشحاله شو، ځکه چې د هغه په هکله یې ډېر څه اورېدلي وو او له ډېرې مودې راهیسې یې غوښتل چې عیسی وویني. هغه په دې تمه ؤ چې د هغه څخه کومه معجزه وویني."}, {"ref": "Luke 2:8", "text": "بیا هغو ښځو ته د عیسی خبرې ور په یاد شوې."}, {"ref": "Luke 2:9", "text": "بیا عیسی خلکو ته دا مثال راوړ: «یو سړي د انګورو باغ جوړ کړ او هغه یې باغوانانو ته په اجاره ورکړ او په خپله د اوږدې مودې دپاره یو بل وطن ته لاړ."}, {"ref": "Luke 2:9", "text": "کله چې د جنګونو او ګډوډیو په هکله کوم څه اورئ، نو مه وېرېږئ. ځکه چې لومړی به دا شیان خامخا پېښیږي، خو دا د دې معنی نه لري چې دا هرڅه به سمدلاسه پای ته ورسیږي.»"}, {"ref": "Luke 2:9", "text": "هغوی ورڅخه پوښتنه وکړه: «په کوم ځای کې غواړې چې تیاره یې کړو؟»"}, {"ref": "Luke 2:9", "text": "نو هیرودیس د عیسی څخه ډېرې پوښتنې وکړې، خو عیسی هېڅ ځواب ورنه کړ."}, {"ref": "Luke 2:9", "text": "کله چې هغوی بېرته د قبر څخه راغلې، نو یوولس رسولان او نور ټول یې د دې پېښې څخه خبر کړل."}, {"ref": "Luke 2:10", "text": "کله چې د انګورو د راټولولو وخت راورسېد، نو هغه خپل یو نوکر باغوانانو ته ورولېږه چې د باغ د حاصلاتو څخه د هغه برخه راوړي. خو باغوانانو هغه وواهه او تش لاس یې بېرته ولېږه."}, {"ref": "Luke 2:10", "text": "بیا یې هغوی ته وویل: «یو قوم به د بل قوم سره جنګیږي، یوه پاچاهي به د بلې پاچاهۍ سره جنګیږي."}, {"ref": "Luke 2:10", "text": "هغه ځواب ورکړ: «ګورئ، څنګه چې ښار ته ننوځئ، نو یو سړی به ستاسو سره مخامخ شي چې د اوبو منګی به و‌ړي. هغه چې کوم کور ته ننوځي، تاسو هم ورپسې لاړ شئ."}, {"ref": "Luke 2:10", "text": "مشران کاهنان او د شریعت عالمان ولاړ وو او په عیسی یې سخت تورونه ولګول."}, {"ref": "Luke 2:10", "text": "دا ښځې مریم مجدلیه، یونا او د یعقوب مور مریم وې او نورو ښځو هم چې د هغوی سره وې، رسولانو ته دا خبرې وکړې."}, {"ref": "Luke 2:11", "text": "بیا هغه بل نوکر ورولېږه، خو باغوانانو هغه هم وواهه، هغه یې بې‌عزته کړ او تش لاس یې بېرته ولېږه."}, {"ref": "Luke 2:11", "text": "سختې زلزلې به وشي، په ډېرو ځایونو کې به قحطي او وباګانې راشي او په اسمان کې به وېروونکې او لویې نښې راښکاره شي."}, {"ref": "Luke 2:11", "text": "او د کور خاوند ته ووایئ: ‹استاذ وایي د مېلمنو کوټه چېرته ده چې زه په کې د خپلو شاګردانو سره د فسحې ډوډۍ وخورم؟›"}, {"ref": "Luke 2:11", "text": "هیرودیس او د هغه عسکرو په عیسی باندې ملنډې ووهلې او د هغه سپکاوی یې وکړ، بیا یې د پاچاهۍ چپنه ورته ورواغوستله او بېرته یې پیلاتوس ته ورولېږه."}, {"ref": "Luke 2:11", "text": "خو د هغوی خبرې رسولانو ته بې‌معنی ښکاره شوې او په هغوی یې باور ونه کړ."}, {"ref": "Luke 2:12", "text": "بیا یې درېم نوکر ورولېږه، خو هغه یې هم ټپي کړ او دباندې یې وغورځاوه."}, {"ref": "Luke 2:12", "text": "خو له دې هرڅه نه مخکې به هغوی تاسو ونیسي او وبه مو ځوروي. تاسو به د محاکمې دپاره کنیسو ته وسپارل شئ او په زندانونو کې به واچول شئ او زما د نوم په خاطر به د محاکمې دپاره پاچاهانو او والیانو ته بوتلل شئ."}, {"ref": "Luke 2:12", "text": "هغه به تاسو ته پاس په بالاخانه کې یوه لویه فرش شوې کوټه دروښایي، نو هلته ډوډۍ تیاره کړئ.»"}, {"ref": "Luke 2:12", "text": "په هماغه ورځ هیرودیس او پیلاتوس یو د بل سره ملګري شول، ځکه چې له دې څخه مخکې د هغو دواړو ترمنځ دښمني وه. عیسی ته د مرګ سزا ورکول کیږي (متي ۲۷‏:‌۱۵‌‏-‌۲۶ او مرقوس ۱۵‏:‌۶‌‏-‌۱۵ او یوحنا ۱۸‏:‌۳۹ ‏- ۱۹‏:‌۱۶)"}, {"ref": "Luke 2:12", "text": "خو پطروس پاڅېده او د قبر خواته یې منډه کړه. کله چې ورټیټ شو او دننه یې وکتل، نو له کفن پرته یې نور هېڅ هم ونه لیدل. نو په دې شوې پېښې حیران شو او خپل کور ته لاړ. د عماوس په لاره کې د عیسی لیدل (مرقوس ۱۶‏:‌۱۲‌‏-‌۱۳)"}, {"ref": "Luke 2:13", "text": "د باغ خاوند د خپل ځان سره وویل: ‹اوس څه وکړم؟ زه به خپل ګران زوی ورولېږم، کېدای شي چې د هغه لحاظ وکړي.›"}, {"ref": "Luke 2:13", "text": "دا به ستاسو دپاره د شاهدۍ ورکولو یوه موقعه وي."}, {"ref": "Luke 2:13", "text": "هغوی لاړل او ټول شیان یې لکه څنګه چې عیسی ورته ویلي وو په هماغه ډول ولیدل او د فسحې ډوډۍ یې تیاره کړه. د څښتن غوره ماښامی (متي ۲۶‏:‌۲۶‌‏-‌۳۰ او مرقوس ۱۴‏:‌۲۲‌‏-‌۲۶ او لومړی قرنتیان ۱۱‏:‌۲۳‌‏-‌۲۵)"}, {"ref": "Luke 2:13", "text": "بیا پیلاتوس مشران کاهنان، د قوم مشران او خلک راوغوښتل"}, {"ref": "Luke 2:13", "text": "په هماغه ورځ د عیسی د پیروانو څخه دوه تنه د عماوس په نوم یو کلي ته چې د اورشلیم څخه یوولس کیلومتره لېرې دی روان وو."}, {"ref": "Luke 2:14", "text": "خو کله چې باغوانانو هغه ولیده، نو یو بل ته یې سره وویل: ‹دا یې وارث دی. راځئ چې مړ یې کړو، نو میراث به یې زمونږ شي.›"}, {"ref": "Luke 2:14", "text": "په دې هکله ډېر فکر مه کوئ چې د خپلو ځانونو څخه به څنګه دفاع کوئ."}, {"ref": "Luke 2:14", "text": "کله چې هغه ساعت راورسېد، عیسی د خپلو رسولانو سره دسترخوان ته کښېناست."}, {"ref": "Luke 2:14", "text": "او هغوی ته یې وویل: «تاسو دا سړی ماته راوستلی دی او وایئ چې هغه خلک بې‌لارې کوي. خو اوس ما ستاسو په مخکې د هغه څخه پوښتنې وکړې او په هغه کې مې هغه جرم ونه مونده چې تاسو پرې تور لګولی دی."}, {"ref": "Luke 2:14", "text": "هغوی له یو بل سره د دې ټولو پېښو په هکله خبرې کولې."}, {"ref": "Luke 2:15", "text": "نو هغه یې د انګورو د باغ څخه دباندې وویست او ویې واژه.» عیسی پوښتنه وکړه: «د باغ خاوند به اوس د هغوی سره څه کوي؟"}, {"ref": "Luke 2:15", "text": "ځکه چې زه به تاسو ته د خبرو کولو حکمت درکړم چې ستاسو له دښمنانو څخه به هېڅوک ونه شي کولای ستاسو په وړاندې ودریږي او یا مخالفت وکړي."}, {"ref": "Luke 2:15", "text": "هغوی ته یې وویل: «زړه مې ډېر غوښتل چې د کړاوونو د زغملو څخه مخکې ستاسو سره د فسحې ډوډۍ وخورم."}, {"ref": "Luke 2:15", "text": "او نه هم هیرودیس په هغه کې کومه ګناه ولیدله، نو ځکه یې بېرته مونږ ته راولېږه. ښکاره ده چې هغه داسې کوم کار نه دی کړی چې د مرګ لایق وي."}, {"ref": "Luke 2:15", "text": "هغوی لا یو د بل سره خبرې او بحث کاوه چې خپله عیسی راغی او د هغوی سره یوځای شو."}, {"ref": "Luke 2:16", "text": "هغه به راشي او دا باغوانان به مړه کړي او د انګورو باغ به نورو ته ورکړي.» کله چې خلکو دا واورېدل، نو ویې ویل: «خدای دې نه کړي.»"}, {"ref": "Luke 2:16", "text": "تر دې چې ستاسو مور او پلار، ورونه، خپلوان او ملګري به ستاسو سره خیانت وکړي او ستاسو څخه به ځینې ووژل شي"}, {"ref": "Luke 2:16", "text": "ځکه زه تاسو ته وایم چې ترڅو پورې د فسحې د قربانۍ مقصد د خدای په پاچاهۍ کې پوره نه شي، تر هغې پورې به نور دا ډوډۍ ونه خورم.»"}, {"ref": "Luke 2:16", "text": "نو زه به هغه د یو څو دورو وهلو وروسته پرېږدم چې لاړ شي.» ["}, {"ref": "Luke 2:16", "text": "دوی عیسی ولیده، خو د هغوی سترګې داسې شوې لکه چې وتړل شي او هغه یې ونه پېژانده."}, {"ref": "Luke 2:17", "text": "عیسی هغوی ته په ځیر سره وکتل او پوښتنه یې وکړه: «نو بیا د زبور د کتاب د دې برخې معنی څه ده؟ کومه تیږه چې رد کړې ګلکارانو وه هغه اوس شوه اصلي تیږه د تهداب"}, {"ref": "Luke 2:17", "text": "او زما د نوم له امله به ټول خلک ستاسو څخه کرکه کوي."}, {"ref": "Luke 2:17", "text": "بیا عیسی پیاله راواخیستله، شکر یې وویست او ویې ویل: «دا واخلئ او په خپل منځ کې یې ووېشئ."}, {"ref": "Luke 2:17", "text": "ځکه په هغه وخت کې داسې رواج ؤ چې په هر اختر کې یو بندي ازاد شي.]"}, {"ref": "Luke 2:17", "text": "عیسی هغوی ته وویل: «تاسو په لاره کې د څه شي په هکله یو د بل سره بحث کاوه؟» هغوی ودرېدل او غمجن ښکاره کېدل."}, {"ref": "Luke 2:18", "text": "هرڅوک چې په دې تیږه راولویږي، نو ټوټې ټوټې به شي او که هغه تیږه په چا باندې راولویږي، نو هغه به ذرې ذرې کړي.» د مالیې ورکولو په هکله پوښتنه (متي ۲۲‏:‌۱۵‌‏-‌۲۲ او مرقوس ۱۲‏:‌۱۳‌‏-‌۱۷)"}, {"ref": "Luke 2:18", "text": "خو ستاسو د سر یو ویښته به هم کم نه شي."}, {"ref": "Luke 2:18", "text": "ځکه زه تاسو ته وایم چې له دې وروسته به تر هغې پورې د انګورو شربت ونه څښم، ترڅو د خدای پاچاهي رانه شي.»"}, {"ref": "Luke 2:18", "text": "خو ټولو خلکو په یو اواز چیغې کړې: «دا سړی ووژنه! باراباس مونږ ته ازاد کړه.»"}, {"ref": "Luke 2:18", "text": "په دوی کې یو تن چې کلیوپاس نومېده د هغه څخه پوښتنه وکړه: «ایا ته په اورشلیم کې یوازېنی مسافر یې چې له دې څخه خبر نه یې چې په تېرو څو ورځو کې هلته څه پېښ شوي دي؟»"}, {"ref": "Luke 2:19", "text": "د شریعت عالمانو او مشرانو کاهنانو غوښتل چې په هماغه ساعت عیسی ونیسي، ځکه چې هغوی پوه شول چې دا مثال یې د دوی په هکله ووایه، خو د خلکو څخه وېرېدل."}, {"ref": "Luke 2:19", "text": "ټینګ ودرېږئ، نو تلپاتې ژوندون به وګټئ. د اورشلیم د ورانېدلو پېشګويي (متي ۲۴‏:‌۱۵‌‏-‌۲۱ او مرقوس ۱۳‏:‌۱۴‌‏-‌۱۹)"}, {"ref": "Luke 2:19", "text": "بیا هغه یوه ډوډۍ راواخیستله، شکر یې پرې وویست، هغه یې ماته کړه او هغوی ته یې ورکړه او ویې ویل: «دا زما بدن دی چې ستاسو دپاره ورکول کیږي. زما په یاد همداسې کوئ.»"}, {"ref": "Luke 2:19", "text": "باراباس یو سړی ؤ چې په ښار کې د بغاوت او قتل په تور زندان ته اچول شوی ؤ."}, {"ref": "Luke 2:19", "text": "عیسی پوښتنه وکړه: «څه شوي دي؟» هغوی ځواب ورکړ: «دا هغه څه دي چې د ناصري عیسی سره وشول. هغه د خدای او ټولو خلکو په حضور کې په وینا او عمل کې یو زورور پیغمبر ؤ."}, {"ref": "Luke 2:20", "text": "بیا هغوی د موقعې په لټه کې وو او ځینې جاسوسان یې چې خپل ځانونه یې صادقان ښودل ولېږل، ترڅو عیسی په خپلو خبرو کې راونیسي او هغه د روم والي ته چې د قدرت او واک خاوند دی وسپاري."}, {"ref": "Luke 2:20", "text": "خو کله چې تاسو ووینئ چې اورشلیم د لښکرو له خوا کلابند شوی دی، نو بیا پوه شئ چې د هغه د ورانېدلو وخت رانژدې شوی دی."}, {"ref": "Luke 2:20", "text": "په همدې ډول د ماښام ډوډۍ څخه وروسته یې پیاله راواخیستله او ویې ویل: «دا پیاله د خدای او انسانانو ترمنځ نوی لوظ دی چې زما د وینې په وسیله جوړیږي چې ستاسو دپاره توییږي."}, {"ref": "Luke 2:20", "text": "پیلاتوس چې غوښتل یې عیسی خلاص کړي یوځل بیا هغوی ته خبرې وکړې."}, {"ref": "Luke 2:20", "text": "خو زمونږ مشرانو کاهنانو او واکمنانو هغه پیلاتوس ته وسپاره چې د مرګ سزا ورته ورکړل شي او هغه یې په صلیب ځوړند کړ."}, {"ref": "Luke 2:21", "text": "جاسوسانو عیسی ته وویل: «استاذه! مونږ پوهېږو ته چې څه وایې او کوم تعلیم چې ورکوې هغه سم دی. ته د هېچا طرفداري نه کوې، بلکې په رښتینولۍ سره د خدای د لارې تعلیم ورکوې."}, {"ref": "Luke 2:21", "text": "نو په هغه وخت کې چې څوک په یهودیه کې وي هغه دې غرونو ته وتښتي. څوک چې په ښار کې وي، نو د ښار څخه دې ووځي او څوک چې د ښار څخه دباندې وي هغوی دې ښار ته نه ننوځي."}, {"ref": "Luke 2:21", "text": "خو ګورئ، هغه څوک چې زما سره به خیانت کوي هغه دلته زما سره په دسترخوان ناست دی."}, {"ref": "Luke 2:21", "text": "خو هغوی چیغې وهلې: «په صلیب باندې یې ځوړند کړه، په صلیب باندې یې ځوړند کړه.»"}, {"ref": "Luke 2:21", "text": "مونږ هیله درلودله چې همدا سړی به اسراییلو ته خلاصون ورکوي، خو نن درېمه ورځ ده چې دا کار شوی دی."}, {"ref": "Luke 2:22", "text": "ایا مونږ ته روا ده چې امپراتور ته مالیه ورکړو که نه؟»"}, {"ref": "Luke 2:22", "text": "ځکه چې دا به د سزا ورکولو ورځې وي، ترڅو هغه څه چې د خدای په کلام کې لیکل شوي دي پوره شي."}, {"ref": "Luke 2:22", "text": "لکه څنګه چې د خدای له خوا مقرره وه چې د انسان زوی باید مړ شي، خو افسوس د هغه چا په حال چې د هغه سره خیانت کوي.»"}, {"ref": "Luke 2:22", "text": "پیلاتوس د درېم ځل دپاره هغوی ته وویل: «ولې؟ څه جرم یې کړی دی؟ ما په هغه کې داسې کوم جرم ونه مونده چې د مرګ لایق وګڼل شي. نو زه به هغه د یو څو دورو وهلو وروسته پرېږدم چې لاړ شي.»"}, {"ref": "Luke 2:22", "text": "برسېره پر‌دې، زمونږ د ډلې څو ښځو مونږ حیران کړو. هغوی نن سهار وختي د هغه قبر ته تللې وې،"}, {"ref": "Luke 2:23", "text": "عیسی پوه شو چې هغوی ورسره چل کوي، نو ورته ویې ویل:"}, {"ref": "Luke 2:23", "text": "افسوس دې وي د هغو ښځو په حال چې په هغو ورځو کې امیدوارې وي او په هغو میندو باندې چې خپلو ماشومانو ته شیدې ورکوي. ځکه چې د ځمکې په مخ به سخت مصیبت راشي او په دې خلکو به د خدای غضب نازل شي."}, {"ref": "Luke 2:23", "text": "بیا هغوی په خپلو کې یو د بل څخه پوښتنې پیل کړې چې په دوی کې به څوک دا کار کوي. د لویۍ په هکله بحث"}, {"ref": "Luke 2:23", "text": "خو هغوی ټینګار کاوه او په لوړ اواز سره یې چیغې وهلې چې هغه باید په صلیب وځړول شي. خلکو دومره چیغې ووهلې چې په پای کې د هغوی چیغې بریالۍ شوې."}, {"ref": "Luke 2:23", "text": "خو د هغه مړی یې پیدا نه کړ. هغوی بېرته راغلې او ویل یې چې په رویا کې یې فرښتې ولیدلې چې دوی ته یې وویل چې هغه ژوندی دی."}, {"ref": "Luke 2:24", "text": "«ماته د سپینو زرو یوه سکه وښایئ. په هغې باندې د چا تصویر او د چا نوم دی؟» هغوی ځواب ورکړ: «د امپراتور.»"}, {"ref": "Luke 2:24", "text": "هغوی به په تورو ووژل شي او ټولو هېوادونو ته به د اسیرانو په توګه بوتلل شي او اورشلیم به د غیریهودیانو له خوا تر‌پښو لاندې کیږي، ترڅو د غیریهودیانو دوران پای ته ونه رسیږي. د انسان د زوی راتګ (متي ۲۴‏:‌۲۹‌‏-‌۳۱ او مرقوس ۱۳‏:‌۲۴‌‏-‌۲۷)"}, {"ref": "Luke 2:24", "text": "بیا د هغوی ترمنځ ناندرۍ پیل شوې چې په دوی کې به څوک د ټولو څخه لوی وګڼل شي."}, {"ref": "Luke 2:24", "text": "نو پیلاتوس د هغوی د غوښتنې سره سم پرېکړه وکړه"}, {"ref": "Luke 2:24", "text": "بیا زمونږ یو څو کسان قبر ته لاړل او څه چې هغو ښځو ویلي وو هغه یې ولیدل، خو عیسی یې ونه لیده.»"}, {"ref": "Luke 2:25", "text": "عیسی وویل: «نو بیا څه چې د امپراتور دي هغه امپراتور ته ورکړئ او څه چې د خدای دي هغه خدای ته ورکړئ.»"}, {"ref": "Luke 2:25", "text": "په لمر، سپوږمۍ او ستورو کې به نښې راښکاره شي او قومونه به د ځمکې په مخ د بحیرو د شور او څپو څخه تنګ او پرېشانه شي."}, {"ref": "Luke 2:25", "text": "عیسی هغوی ته وویل: «د غیریهودیانو پاچاهان په خپلو خلکو باداري کوي او واکمنان د خلکو خیرخواه ګڼل کیږي."}, {"ref": "Luke 2:25", "text": "او باراباس یې چې د بغاوت او قتل له امله زنداني شوی ؤ، د زندان څخه خلاص کړ او عیسی یې هغوی ته په لاس ورکړ چې هرڅه وغواړي ورسره ویې کړي. عیسی په صلیب باندې مېخ کیږي (متي ۲۷‏:‌۳۲‌‏-‌۴۴ او مرقوس ۱۵‏:‌۲۱‌‏-‌۳۲ او یوحنا ۱۹‏:‌۱۷‌‏-‌۲۷)"}, {"ref": "Luke 2:25", "text": "عیسی هغوی ته وویل: «تاسو څومره ناپوهه یئ او د پیغمبرانو د ویناوو په منلو کې زړه نازړه یئ."}, {"ref": "Luke 2:26", "text": "هغوی ونه شو کولای چې عیسی د خلکو په مخکې په خپلو خبرو کې راونیسي او د هغه په ځواب حیران شول، نو غلي پاتې شول. د قیامت د ورځې په هکله پوښتنه (متي ۲۲‏:‌۲۳‌‏-‌۳۳ او مرقوس ۱۲‏:‌۱۸‌‏-‌۲۷)"}, {"ref": "Luke 2:26", "text": "خلک به د دې پېښې له وېرې او اندېښنې څخه چې په نړۍ کې رامنځته کیږي بې‌هوشه شي، ځکه چې اسماني موجودات به ولړزول شي."}, {"ref": "Luke 2:26", "text": "خو تاسو داسې مه اوسئ، بلکې په تاسو کې دې تر ټولو لوی خپل ځان کوچنی وګڼي او مشر دې د خدمتګار په شان وي."}, {"ref": "Luke 2:26", "text": "کله چې عسکرو هغه په صلیب باندې د ځوړندولو دپاره بیولو، نو هغوی د شمعون په نامه یو سړی چې د قیروان څخه ؤ او د ښار دباندې سیمې څخه ښار ته راروان ؤ، راونیوه. هغه یې مجبور کړ چې صلیب په اوږه کړي او د عیسی پسې یې یوسي."}, {"ref": "Luke 2:26", "text": "ایا دا ضروري نه وه چې مسیح دا کړاوونه وویني او بیا دې خپل جلال ته ورسیږي؟»"}, {"ref": "Luke 2:27", "text": "بیا ځینې صدوقیان چې د مرګ څخه وروسته د بیا راژوندي کېدلو څخه منکر وو، عیسی ته راغلل او د هغه څخه یې یو سوال وکړ:"}, {"ref": "Luke 2:27", "text": "بیا به هغوی د انسان زوی وویني چې په ورېځ کې به د قدرت او زیات جلال سره راروان وي."}, {"ref": "Luke 2:27", "text": "خلک څه فکر کوي چې په دوی دواړو کې کوم یو لوی دی، هغه څوک چې ډوډۍ ته ناست دی او یا هغه څوک چې خدمت کوي؟ په یقین سره هغه څوک چې ډوډۍ ته ناست دی. خو زه ستاسو په منځ کې د یو خدمتګار په شان یم."}, {"ref": "Luke 2:27", "text": "ګڼ شمېر خلک په عیسی پسې روان وو چې په هغو کې ښځې هم وې چې ځانونه یې وهل او د هغه دپاره یې ژړا او انګولا کوله."}, {"ref": "Luke 2:27", "text": "بیا عیسی د موسی د تورات څخه نیولې د ټولو پیغمبرانو تر لیکنو پورې چې د خدای په کلام کې خپله د هغه په هکله لیکل شوي وو، هغوی ته بیان کړل."}, {"ref": "Luke 2:28", "text": "«استاذه! موسی په شریعت کې مونږ ته لیکلي دي چې که چېرې د چا ورور مړ شي او ښځه یې ترې پاتې شي او اولاد یې نه وي، نو د دې سړي ورور باید د هغې کونډې سره واده وکړي، ترڅو د هغه اولادونه پیدا شي او هغه یې د مړه ورور اولادونه وګڼل شي."}, {"ref": "Luke 2:28", "text": "کله چې دا شیان پیل شي نو تاسو نېغ ودرېږئ او زړور اوسئ، ځکه چې ستاسو خلاصون نژدې دی.» د انځر د ونې څخه عبرت اخیستل (متي ۲۴‏:‌۳۲‌‏-‌۳۵ او مرقوس ۱۳‏:‌۲۸‌‏-‌۳۱)"}, {"ref": "Luke 2:28", "text": "خو تاسو زما د ازمېښتونو په وخت کې زما سره ولاړ وئ."}, {"ref": "Luke 2:28", "text": "عیسی هغوی ته مخ راواړاوه او ورته ویې ویل: «ای د اورشلیم ښځو! زما دپاره مه ژاړئ، خو د خپلو ځانونو او خپلو اولادونو دپاره وژاړئ."}, {"ref": "Luke 2:28", "text": "کله چې دوی د عماوس کلي ته ورنژدې شول، نو عیسی داسې وښودل چې ګوندې هغه نور هم مخکې ځي."}, {"ref": "Luke 2:29", "text": "نو داسې وشول چې اووه ورونه وو، لومړني یې ښځه وکړه او بې‌اولاده مړ شو."}, {"ref": "Luke 2:29", "text": "بیا عیسی هغوی ته دا مثال راوړ: «د انځر ونې او نورو ونو ته وګورئ."}, {"ref": "Luke 2:29", "text": "لکه څنګه چې زما پلار ماته د پاچاهۍ حق راکړی دی، زه هم تاسو ته دا حق درکوم."}, {"ref": "Luke 2:29", "text": "ځکه چې داسې ورځې راتلونکې دي چې خلک به وایي چې هغه ښځې بختورې دي چې شنډې دي او هېڅکله یې ماشومان نه دي زېږولي او هېڅکله یې تی نه دی ورکړی."}, {"ref": "Luke 2:29", "text": "خو هغوی ټینګار وکړ او ویې ویل: «زمونږ سره پاتې شه، ځکه چې ورځ په تېرېدلو ده او ماښام نژدې دی.» نو عیسی کور ته ننوت چې د هغوی سره پاتې شي."}, {"ref": "Luke 2:30", "text": "بیا دوهم یې هماغه ښځه وکړه، هغه هم بې‌اولاده مړ شو."}, {"ref": "Luke 2:30", "text": "کله چې هغه غوټۍ وسپړي، نو تاسو خپله وینئ او پوهېږئ چې اوړی رانژدې شوی دی."}, {"ref": "Luke 2:30", "text": "تاسو به زما په پاچاهۍ کې زما په دسترخوان خورئ او څښئ او په تختونو باندې به کښېنئ او د اسراییلو په دولسو قبیلو باندې به حکومت کوئ.» د پطروس د انکار په هکله د عیسی پېشګويي (متي ۲۶‏:‌۳۱‌‏-‌۳۵ او مرقوس ۱۴‏:‌۲۷‌‏-‌۳۱ او یوحنا ۱۳‏:‌۳۶‌‏-‌۳۸)"}, {"ref": "Luke 2:30", "text": "په هغه وخت کې به خلک غرونو ته وایي چې په مونږ باندې راولوېږئ او غونډیو ته به وایي چې مونږ پټ کړئ."}, {"ref": "Luke 2:30", "text": "کله چې عیسی د هغوی سره دسترخوان ته کښېناست نو ډوډۍ یې راواخیستله، شکر یې پرې وویست، ماته یې کړه او هغوی ته یې ورکړه."}, {"ref": "Luke 2:31", "text": "بیا درېم هغه وکړه او په همدې ډول اووه واړو د هغې سره ودونه وکړل او هر یو مړ شو، خو د یو هم اولاد ونه شو،"}, {"ref": "Luke 2:31", "text": "په همدې ډول کله چې د دې شیانو پېښېدل ووینئ، نو پوه شئ چې د خدای پاچاهي نژدې شوې ده."}, {"ref": "Luke 2:31", "text": "عیسی وویل: «ای شمعونه، ای شمعونه! واوره، شیطان وغوښتل چې تاسو ټول وازمایي، ښه او بد سره بېل کړي لکه څنګه چې بزګر د غنمو څخه بوس بېل کوي."}, {"ref": "Luke 2:31", "text": "ځکه که چېرې هغوی د شنې ونې سره داسې کار کوي، نو د وچې ونې سره به څه کیږي؟»"}, {"ref": "Luke 2:31", "text": "ناڅاپه د هغوی سترګې وغړېدلې او عیسی یې وپېژانده، خو هغه د هغوی د نظر څخه پناه شو."}, {"ref": "Luke 2:32", "text": "او له ټولو وروسته هغه ښځه هم مړه شوه."}, {"ref": "Luke 2:32", "text": "په یقین سره زه تاسو ته دا وایم چې دا نسل به تر هغې پورې له منځه لاړ نه شي، ترڅو دا ټولې پېښې رامنځته شوې نه وي."}, {"ref": "Luke 2:32", "text": "خو شمعونه! ما ستا دپاره دعا کړې ده چې ایمان دې له منځه لاړ نه شي. کله چې دې توبه وویستله او بېرته ماته راوګرځېدلې، نو خپل ورونه دې قوي کړه.»"}, {"ref": "Luke 2:32", "text": "دوه نور مجرمان یې هم د عیسی سره روان کړي وو چې د هغه سره یوځای اعدام شي."}, {"ref": "Luke 2:32", "text": "هغوی یو بل ته وویل: «کله چې په لاره کې هغه زمونږ سره خبرې کولې او د خدای د کلام لیکنې یې راته بیانولې، ایا زمونږ زړونه په جوش رانغلل؟»"}, {"ref": "Luke 2:33", "text": "نو د قیامت په ورځ به هغه د کوم یو ښځه وي؟ ځکه چې اووه واړو د هغې سره ودونه کړي وو.»"}, {"ref": "Luke 2:33", "text": "ځمکه او اسمان به له منځه لاړ شي، خو زما خبرې به هېڅکله له منځه لاړې نه شي. بېداره اوسئ"}, {"ref": "Luke 2:33", "text": "پطروس ځواب ورکړ: «ای استاذه! زه ستا سره زندان او مرګ ته هم تیار یم.»"}, {"ref": "Luke 2:33", "text": "کله چې هغوی هغه ځای ته چې د سر د کوپړۍ په نوم یادېده ورسېدل، نو عسکرو عیسی هلته په صلیب باندې مېخ کړ او هغه دوه مجرمان یې هم ورسره په صلیب وځړول، یو یې د هغه ښي لاس ته او بل یې د هغه چپ لاس ته."}, {"ref": "Luke 2:33", "text": "هغوی سمدلاسه راپاڅېدل او بېرته اورشلیم ته لاړل. هلته یې ولیدل چې یوولس رسولان او نور خلک سره راټول شوي وو"}, {"ref": "Luke 2:34", "text": "عیسی ځواب ورکړ: «په دې نړۍ کې نر او ښځې ودونه کوي،"}, {"ref": "Luke 2:34", "text": "پام کوئ، خپل زړونه په مېلو، نشو او دنیاوي اندېښنو مه اخته کوئ، هسې نه چې هغه ورځ به ناڅاپه په تاسو راشي،"}, {"ref": "Luke 2:34", "text": "عیسی وویل: «ای پطروسه! زه تاته وایم چې نن شپه به د چرګ د اذان څخه مخکې درې ځلې ووایې چې ته ما نه پېژنې.» د پیسو کڅوړه، خورجین او توره"}, {"ref": "Luke 2:34", "text": "عیسی وویل: «ای پلاره! دوی وبخښه، ځکه دوی نه پوهیږي چې څه کوي.» عسکرو د عیسی په کالیو باندې پچه واچوله او په خپل منځ کې یې سره ووېشل."}, {"ref": "Luke 2:34", "text": "او ویل یې چې عیسی په رښتیا راژوندی شوی او شمعون ته ښکاره شوی دی."}, {"ref": "Luke 2:35", "text": "خو کوم خلک چې د راتلونکې نړۍ او د مرګ څخه د بیا راژوندي کېدلو لایق ګڼل شوي دي، هغوی یو د بله سره ودونه نه کوي."}, {"ref": "Luke 2:35", "text": "او لکه د دام په شان به د نړۍ ټول خلک چې په هرځای کې وي راګېر کړي."}, {"ref": "Luke 2:35", "text": "عیسی د هغوی څخه پوښتنه وکړه: «کله چې ما تاسو بې د پیسو له کڅوړې، بې‌خورجینې او بې له څپلیو ولېږلئ، ایا په هغه وخت کې ستاسو سره د کوم شي کمی ؤ؟» هغوی ځواب ورکړ: «نه.»"}, {"ref": "Luke 2:35", "text": "خلک د سیل دپاره هلته ولاړ وو او د یهودیانو مشرانو په هغه باندې ملنډې وهلې او ویل یې: «هغه نور خلک ژغورل، که چېرې هغه په رښتیا سره د خدای غوره شوی مسیح وي، نو اوس دې خپل ځان وژغوري.»"}, {"ref": "Luke 2:35", "text": "نو په لاره کې چې څه شوي وو هغو دواړو شاګردانو هغوی ته بیان کړل او ورته ویې ویل چې څنګه یې عیسی د ډوډۍ ماتولو په وخت کې وپېژانده. عیسی خپلو شاګردانو ته ځان ښکاره کوي (متي ۲۸‏:‌۱۶‌‏-‌۲۰ او مرقوس ۱۶‏:‌۱۴‌‏-‌۱۸ او یوحنا ۲۰‏:‌۱۹‌‏-‌۲۳ او د رسولانو عملونه ۱‏:‌۶‌‏-‌۸)"}, {"ref": "Luke 2:36", "text": "هغوی به نور نه مړه کیږي، ځکه چې د فرښتو په شان به وي. هغوی د خدای اولادونه دي، ځکه چې د مړو څخه د تل دپاره راژوندي شوي دي."}, {"ref": "Luke 2:36", "text": "نو بېدار اوسئ او هر وخت دعا کوئ، ترڅو دا توان پیدا کړئ چې د دې ټولو شیانو څخه چې ډېر زر به پېښ شي، وژغورل شئ او د انسان د زوی په مخکې ودرېدلی شئ.»"}, {"ref": "Luke 2:36", "text": "عیسی وویل: «خو اوس هرڅوک چې د پیسو کڅوړه لري هغه دې د ځان سره واخلي او همدارنګه خپل خورجین هم. او د هرچا سره چې توره نه وي، نو خپله چپنه دې خرڅه کړي او یوه توره دې واخلي."}, {"ref": "Luke 2:36", "text": "عسکرو هم په هغه باندې ملنډې ووهلې او هغوی د عیسی خواته ورنژدې شول او تروه شراب یې ورته ورکړل"}, {"ref": "Luke 2:36", "text": "هغوی لا د دې پېښو په هکله خبرې کولې چې ناڅاپه عیسی د هغوی په منځ کې ودرېده او هغوی ته یې وویل: «په تاسو دې سلامتي وي.»"}, {"ref": "Luke 2:37", "text": "او دا چې مړي بیا راژوندي کیږي، موسی دا په خپله د سوځېدونکي بوټي په پېښه کې وښودله او هلته یې څښتن د ابراهیم خدای، د اسحاق خدای او د یعقوب خدای وباله."}, {"ref": "Luke 2:37", "text": "عیسی به د ورځې له خوا د خدای په کور کې تعلیم ورکاوه. ماښام به وتلو او شپه به یې د زیتون په غره کې تېروله"}, {"ref": "Luke 2:37", "text": "ځکه زه تاسو ته وایم چې د خدای د کلام دا لیکنه باید پوره شي چې وایي: هغه به په مجرمانو کې وشمېرل شي. ځکه هرڅه چې زما په هکله لیکل شوي دي هغه به رښتیا شي.»"}, {"ref": "Luke 2:37", "text": "او ورته ویې ویل: «که چېرې ته د یهودیانو پاچا یې، نو خپل ځان دې وژغوره.»"}, {"ref": "Luke 2:37", "text": "هغوی ټکان وخوړ او سخت ووېرېدل، ځکه ګومان یې کاوه چې د مړي ارواح ویني."}, {"ref": "Luke 2:38", "text": "هغه د مړو نه بلکې د ژوندیو خدای دی، ځکه چې د هغه په نظر کې ټول ژوندي دي.»"}, {"ref": "Luke 2:38", "text": "او سهار وختي به ټول خلک د خدای کور ته ورتلل چې د هغه خبرې واوري."}, {"ref": "Luke 2:38", "text": "شاګردانو وویل: «ګوره استاذه! زمونږ سره دلته دوه تورې دي.» عیسی ځواب ورکړ: «دا بس دي.» عیسی د زیتون په غره کې دعا کوي (متي ۲۶‏:‌۳۶‌‏-‌۴۶ او مرقوس ۱۴‏:‌۳۲‌‏-‌۴۲)"}, {"ref": "Luke 2:38", "text": "د هغه د سر دپاسه یوه تخته لګول شوې وه چې ورباندې لیکل شوي وو: «دا د یهودیانو پاچا دی.»"}, {"ref": "Luke 2:38", "text": "خو عیسی هغوی ته وویل: «ولې دومره وارخطا یئ؟ ستاسو په زړونو کې ولې داسې شکونه پیدا کیږي؟"}, {"ref": "Luke 2:39", "text": "د شریعت ځینو عالمانو وویل: «استاذه! ډېر ښه ځواب دې ورکړ.»"}, {"ref": "Luke 2:39", "text": "عیسی دباندې ووت او د خپل عادت له مخې د زیتون غره ته روان شو او شاګردان یې هم ورپسې لاړل."}, {"ref": "Luke 2:39", "text": "یو له هغو مجرمانو څخه چې هلته ځړول شوی ؤ عیسی ته پېغور ورکړ او ویې ویل: «ایا ته مسیح نه یې؟ نو بیا خپل ځان او مونږ وژغوره.»"}, {"ref": "Luke 2:39", "text": "زما لاسونو او پښو ته وګورئ او وګورئ چې دا زه خپله یم. په ما لاس کېږدئ نو بیا به پوه شئ، ځکه چې ارواح غوښه او هډوکي نه لري او لکه څنګه چې تاسو یې وینئ، زه یې لرم.»"}, {"ref": "Luke 2:40", "text": "له هغې وروسته نور چا جرات ونه کړ چې د هغه څخه بله پوښتنه وکړي. مسیح د چا زوی دی؟ (متي ۲۲‏:‌۴۱‌‏-‌۴۶ او مرقوس ۱۲‏:‌۳۵‌‏-‌۳۷)"}, {"ref": "Luke 2:40", "text": "کله چې هغه ځای ته ورسېده، نو هغوی ته یې وویل: «دعا وکړئ چې په ازمېښت کې ونه لوېږئ.»"}, {"ref": "Luke 2:40", "text": "خو هغه بل مجرم هغه ورټلو او ورته ویې ویل: «ایا ته له خدایه نه وېرېږې؟ ځکه چې په تا باندې هم د هغه په شان د مرګ حکم شوی دی."}, {"ref": "Luke 2:40", "text": "کله چې هغه دا وویل، نو خپل لاسونه او پښې یې هغوی ته وښودلې."}, {"ref": "Luke 2:41", "text": "بیا عیسی د هغوی څخه پوښتنه وکړه: «هغوی څنګه ویلی شي چې مسیح د داود زوی دی؟"}, {"ref": "Luke 2:41", "text": "بیا عیسی د هغوی څخه یو څو ګامه لېرې لاړ، په ګونډو شو او دعا یې وکړه."}, {"ref": "Luke 2:41", "text": "زمونږ سره انصاف شوی دی، ځکه چې مونږ ته د خپلو عملونو سزا راکول کیږي. خو دې سړي کوم غلط کار نه دی کړی.»"}, {"ref": "Luke 2:41", "text": "هغوی د ډېرې خوشحالۍ او حیرانتیا له امله نه شو کولای چې بیاهم په دې باور وکړي، نو عیسی د هغوی څخه پوښتنه وکړه: «ایا ستاسو سره دلته د خوړلو دپاره څه شته؟»"}, {"ref": "Luke 2:42", "text": "ځکه چې خپله داود د زبور په کتاب کې وایي: څښتن وویل زما بادار ته: ‹کښېنه زما ښي لاس ته"}, {"ref": "Luke 2:42", "text": "هغه وویل: «ای پلاره! که چېرې ستا رضا وي، نو دا پیاله زما څخه لېرې کړه. خو زما رضا نه، بلکې ستا رضا دې پوره شي.»"}, {"ref": "Luke 2:42", "text": "بیا هغه وویل: «ای عیسی! کله چې خپلې پاچاهۍ ته ورسېدې، نو ما هم در په یاد کړه.»"}, {"ref": "Luke 2:42", "text": "هغوی ورته یوه ټوټه کباب شوی ماهي ورکړ،"}, {"ref": "Luke 2:43", "text": "ترڅو چې ستا دښمنان ستا د پښو لاندې کړم.›"}, {"ref": "Luke 2:43", "text": "بیا د اسمان څخه یوه فرښته هغه ته راښکاره شوه او هغه ته یې قوت ورکړ."}, {"ref": "Luke 2:43", "text": "عیسی هغه ته وویل: «په یقین سره زه تاته وایم چې ته به نن زما سره په جنت فردوس کې اوسې.» د عیسی مړینه (متي ۲۷‏:‌۴۵‌‏-‌۵۶ او مرقوس ۱۵‏:‌۳۳‌‏-‌۴۱ او یوحنا ۱۹‏:‌۲۸‌‏-‌۳۰)"}, {"ref": "Luke 2:43", "text": "نو هغه یې واخیست او د هغوی په مخکې یې وخوړ."}, {"ref": "Luke 2:44", "text": "نو کله چې داود مسیح ته بادار وایي، بیا دا څنګه کېدای شي چې هغه د داود زوی وي؟» عیسی د شریعت د عالمانو په خلاف خبرداری ورکوي (متي ۲۳‏:‌۱‌‏-‌۳۶ او مرقوس ۱۲‏:‌۳۸‌‏-‌۴۰)"}, {"ref": "Luke 2:44", "text": "عیسی په ډېر سخت حالت کې ؤ او په ډېر جوش سره یې دعا وکړه او خولې یې د وینو د څاڅکو په شان په ځمکه باندې څڅېدلې."}, {"ref": "Luke 2:44", "text": "‏-۴۵ د غرمې شاوخوا دولس بجې وې چې لمر ورک شو او د ماسپښین تر درې بجو پورې په ټوله سیمه کې تیاره خپره شوه او د خدای د کور پرده په منځ کې دوه ټوټې شوه."}, {"ref": "Luke 2:44", "text": "بیا عیسی هغوی ته وویل: «دا زما هغه خبرې دي چې کله زه ستاسو سره وم او تاسو ته به مې ویل چې هغه څه چې د موسی په تورات، د پیغمبرانو په لیکنو او د زبور په کتاب کې زما په هکله لیکل شوي دي، باید رښتیا شي.»"}, {"ref": "Luke 2:45", "text": "په داسې حال کې چې ټولو خلکو د عیسی خبرو ته غوږ نیولی ؤ، خپلو شاګردانو ته یې وویل:"}, {"ref": "Luke 2:45", "text": "کله چې عیسی د دعا څخه راپاڅېده، نو شاګردانو ته راغی او ویې لیدل چې هغوی له غمه ستومانه او ویده شوي وو."}, {"ref": "Luke 2:45", "text": "بیا یې د هغوی ذهنونه روښانه کړل، ترڅو د خدای په کلام پوه شي"}, {"ref": "Luke 2:46", "text": "«د شریعت د عالمانو سره احتیاط کوئ. هغوی دا خوښوي چې په اوږدو چپنو کې وګرځي او په بازارونو کې ورته خلک سلام واچوي او غواړي چې په کنیسو کې په مخکې ځایونو او په مېلمستیاوو کې په لوړو ځایونو کې کښېني."}, {"ref": "Luke 2:46", "text": "هغوی ته یې وویل: «تاسو ولې ویده یئ؟ پاڅېږئ او دعا وکړئ چې په ازمېښت کې ونه لوېږئ.» د عیسی سره خیانت کول او نیول (متي ۲۶‏:‌۴۷‌‏-‌۵۶ او مرقوس ۱۴‏:‌۴۳‌‏-‌۵۰ او یوحنا ۱۸‏:‌۳‌‏-‌۱۱)"}, {"ref": "Luke 2:46", "text": "عیسی په لوړ اواز چیغه ووهله او ویې ویل: «ای پلاره! زه خپل روح تاته سپارم.» دا یې وویل او ساه یې ورکړه."}, {"ref": "Luke 2:46", "text": "او هغوی ته یې وویل: «همدارنګه لیکل شوي دي چې مسیح باید کړاوونه وویني او مړ شي او په درېمه ورځ به بیا راژوندی شي،"}, {"ref": "Luke 2:47", "text": "هغوی د کونډو مالونه خوري او د ځان ښودنې دپاره اوږدې اوږدې دعاګانې کوي. د داسې خلکو سزا به د ټولو نه سخته وي.»"}, {"ref": "Luke 2:47", "text": "عیسی لا خبرې کولې چې یوه ډله راغله او یهودا چې د هغو دولسو شاګردانو څخه ؤ، د هغوی څخه مخکې روان ؤ. هغه عیسی ته ورنژدې شو چې ښکل یې کړي."}, {"ref": "Luke 2:47", "text": "کله چې رومي منصبدار دا هرڅه ولیدل، نو د خدای ثنا یې وویله او ویې ویل: «بې له شکه چې دا سړی بې‌ګناه ؤ.»"}, {"ref": "Luke 2:47", "text": "او د هغه په نوم به ټولو قومونو ته دا پیغام ورسول شي چې توبه وباسي او خدای به یې ګناهونه وبخښي او پیل به یې له اورشلیم څخه وي."}, {"ref": "Luke 2:48", "text": "خو عیسی وویل: «ای یهودا! ایا په ښکلولو سره د انسان زوی دښمنانو ته په لاس ورکوې؟»"}, {"ref": "Luke 2:48", "text": "هغه خلک چې دې نندارې ته راټول شوي وو، کله یې چې دا پېښه ولیدله، نو له غمه یې خپل ځانونه وهل او بېرته خپلو کورونو ته لاړل."}, {"ref": "Luke 2:48", "text": "تاسو د دې ټولو شیانو شاهدان یئ."}, {"ref": "Luke 2:49", "text": "کله چې د عیسی شاګردانو ولیدل چې څه کیږي، نو ویې ویل: «استاذه! ایا په تورو یې ووهو؟»"}, {"ref": "Luke 2:49", "text": "د عیسی ټول اشنایان او هغه ښځې چې د جلیل څخه هغه پسې راغلې وې په لېرې فاصله کې ولاړې وې او دا هرڅه یې لیدل. د عیسی ښخېدل (متي ۲۷‏:‌۵۷‌‏-‌۶۱ او مرقوس ۱۵‏:‌۴۲‌‏-‌۴۷ او یوحنا ۱۹‏:‌۳۸‌‏-‌۴۲)"}, {"ref": "Luke 2:49", "text": "او ګورئ، هغه څه چې زما پلار یې وعده کړې ده، درلېږم. خو باید تر هغې پورې په دې ښار کې پاتې شئ، ترڅو په تاسو باندې اسماني قوت نازل شي.» اسمان ته د عیسی ختل (مرقوس ۱۶‏:‌۱۹‌‏-‌۲۰ او د رسولانو عملونه ۱‏:‌۹‌‏-‌۱۱)"}, {"ref": "Luke 2:50", "text": "د هغوی څخه یو تن د لوی کاهن په نوکر ګوزار وکړ او د هغه ښي غوږ یې پرې کړ."}, {"ref": "Luke 2:50", "text": "هلته د یوسف په نوم یو سړی ؤ چې په یهودیه کې د رامه د ښار څخه ؤ او د یهودیانو د شورا غړی ؤ. هغه یو نېک او عادل سړی ؤ."}, {"ref": "Luke 2:50", "text": "بیا عیسی هغوی د ښار څخه دباندې تر بیت‌عنیا پورې بوتلل، خپل لاسونه یې پورته کړل او هغوی ته یې برکت ورکړ"}, {"ref": "Luke 2:51", "text": "خو عیسی وویل: «بس یې دی.» عیسی د هغه سړي په غوږ باندې خپل لاس کېښود او هغه یې روغ کړ."}, {"ref": "Luke 2:51", "text": "خو د هغوی د دې پرېکړې او دې کار سره جوړ نه ؤ او د خدای د پاچاهۍ په انتظار ؤ."}, {"ref": "Luke 2:51", "text": "او په داسې حال کې چې هغوی ته یې برکت ورکاوه د هغوی څخه بېل شو او اسمان ته پورته یووړل شو."}, {"ref": "Luke 2:52", "text": "بیا عیسی مشرانو کاهنانو، د خدای د کور د ساتونکو آمرانو او نورو قومي مشرانو ته چې د هغه د نیولو دپاره راغلي وو، وویل: «ایا زه کوم داړه مار یم چې د تورو او کوتکونو سره زما د نیولو دپاره راغلي یئ؟"}, {"ref": "Luke 2:52", "text": "هغه پیلاتوس ته ورغی او د عیسی مړی یې ترې وغوښت."}, {"ref": "Luke 2:52", "text": "هغوی ورته سجده وکړه او په ډېرې خوشحالۍ سره بېرته اورشلیم ته راستانه شول."}, {"ref": "Luke 2:53", "text": "زه هره ورځ ستاسو سره د خدای په کور کې وم او تاسو زما د نیولو هڅه ونه کړه. خو دا وخت چې تیاره خپره ده، نو ستاسو وخت دی.» پطروس له عیسی څخه انکار کوي (متي ۲۶‏:‌۵۷‌‏-‌۵۸،‌۶۹‌‏-‌۷۵ او مرقوس ۱۴‏:‌۵۳‌‏-‌۵۴،‌۶۶‌‏-‌۷۲ او یوحنا ۱۸‏:‌۱۲‌‏-‌۱۸،‌۲۵‌‏-‌۲۷)"}, {"ref": "Luke 2:53", "text": "بیا هغه د صلیب څخه مړی راښکته کړ او د کتان په کفن کې یې تاو کړ او په ګټ کې کیندل شوي قبر کې یې کېښود چې د دې نه مخکې په کې څوک نه ؤ ښخ شوی."}, {"ref": "Luke 2:53", "text": "هغوی خپل ټول وخت د خدای په کور کې خدای ته په ثنا ویلو تېر کړ."}, {"ref": "Luke 2:54", "text": "هغوی عیسی ونیوه او د لوی کاهن کور ته یې بوته او پطروس د لېرې نه ورپسې روان ؤ."}, {"ref": "Luke 2:54", "text": "دا د جمعې ورځ وه، یعنې سبت ته د تیاري نیولو ورځ وه او د سبت ورځ پیل کېدله."}, {"ref": "Luke 2:55", "text": "هغوی د حوېلۍ په منځ کې اور بل کړ او ګردچاپېره ورڅخه کښېناستل او پطروس هم د هغوی سره کښېناست."}, {"ref": "Luke 2:55", "text": "کومې ښځې چې د جلیل څخه د عیسی سره راغلې وې یوسف پسې روانې وې. هغوی قبر ولیده چې د عیسی مړی په کې څنګه ایښودل شوی ؤ."}, {"ref": "Luke 2:56", "text": "په داسې حال کې چې هغه د اور رڼا ته ناست ؤ یوې وینځې هغه ولیده، نو په ځیر یې ورته وکتل او ویې ویل: «دا سړی هم د عیسی سره ؤ.»"}, {"ref": "Luke 2:56", "text": "بیا هغوی بېرته د اورشلیم ښار ته لاړې او د مړي دپاره یې خوشبویه مسالې او عطر تیار کړل او د شریعت د حکم له مخې یې د سبت په ورځ ارام وکړ."}, {"ref": "Luke 2:57", "text": "خو پطروس منکر شو او ویې ویل: «ای ښځې! زه هغه نه پېژنم.»"}, {"ref": "Luke 2:58", "text": "لږ وروسته یو بل سړي هم هغه ته وکتل او ویې ویل: «ته هم د هغو له ډلې څخه یې.» خو پطروس وویل: «ای وروره! زه نه یم.»"}, {"ref": "Luke 2:59", "text": "شاوخوا یو ساعت وروسته یو بل سړي تایید کړه او ویې ویل: «په دې کې هېڅ شک نشته چې دا سړی هم د عیسی سره ؤ، ځکه چې هغه هم جلیلي دی.»"}, {"ref": "Luke 2:60", "text": "خو پطروس ځواب ورکړ: «ای وروره! زه نه پوهېږم چې ته څه وایې.» هغه لا خبرې کولې چې سمدلاسه چرګ اذان وکړ."}, {"ref": "Luke 2:61", "text": "عیسی مخ راواړاوه او پطروس ته یې وکتل او پطروس ته د عیسی خبرې ور په یاد شوې چې هغه ته یې ویلي وو: «نن شپه به د چرګ د اذان څخه مخکې درې ځلې ووایې چې ته ما نه پېژنې.»"}, {"ref": "Luke 2:62", "text": "پطروس دباندې ووت او په چیغو چیغو یې وژړل. د عیسی سپکاوی او وهل (متي ۲۶‏:‌۶۷‌‏-‌۶۸ او مرقوس ۱۴‏:‌۶۵)"}, {"ref": "Luke 2:63", "text": "کومو خلکو چې د عیسی ساتنه کوله په هغه باندې ملنډې ووهلې او ویې واهه."}, {"ref": "Luke 2:64", "text": "د هغه سترګې یې وتړلې او پوښتنه یې ترې وکړه: «اوس له غیبو ووایه چې ته چا ووهلې؟»"}, {"ref": "Luke 2:65", "text": "او نورې ډېرې سپکې خبرې یې هم ورته وکړې. عیسی د مذهبي شورا په مخکې (متي ۲۶‏:‌۵۹‌‏-‌۶۶ او مرقوس ۱۴‏:‌۵۵‌‏-‌۶۴ او یوحنا ۱۸‏:‌۱۹‌‏-‌۲۴)"}, {"ref": "Luke 2:66", "text": "کله چې ورځ شوه نو قومي مشران، د کاهنانو مشران او د شریعت عالمان سره راټول شول او عیسی یې خپلې شورا ته راوست."}, {"ref": "Luke 2:67", "text": "هغوی وویل: «مونږ ته ووایه چې ته مسیح یې؟» هغه ځواب ورکړ: «که زه تاسو ته ووایم، نو په ما به باور ونه کړئ"}, {"ref": "Luke 2:68", "text": "او که زه درڅخه پوښتنه وکړم، نو تاسو به ځواب رانه کړئ."}, {"ref": "Luke 2:69", "text": "خو له دې وروسته به د انسان زوی د مطلق قادر خدای ښي لاس ته ناست وي.»"}, {"ref": "Luke 2:70", "text": "هغوی ټولو وویل: «نو بیا ته د خدای زوی یې؟» عیسی ځواب ورکړ: «تاسو خپله وایئ چې زه یم.»"}, {"ref": "Luke 2:71", "text": "هغوی وویل: «نور مونږ شاهدانو ته اړتیا نه لرو. مونږ هرڅه د هغه د خپلې خولې څخه واورېدل.»"}, {"ref": "Mark 1:1", "text": "بیا عیسی له هغه ځای نه روان شو او د یهودیې سیمې ته چې د اردن د سیند بلې غاړې پرته ده، لاړ. یوځل بیا ګڼ شمېر خلک ورته راغلل او د خپل عادت له مخې یې هغوی ته تعلیم ورکول پیل کړ."}, {"ref": "Mark 1:1", "text": "کله چې عیسی او د هغه شاګردان اورشلیم ته نژدې شول او بیت‌فاجي او بیت‌عنیا ته چې د زیتون په غره کې وو ورسېدل، نو عیسی خپل دوه شاګردان ولېږل"}, {"ref": "Mark 1:1", "text": "بیا عیسی هغوی ته په مثالونو کې خبرې پیل کړې: «یو سړي د انګورو باغ جوړ کړ او دېوال یې ورڅخه تاو کړ، د انګورو د شربت د ویستلو دپاره یې په کې یو ځای جوړ کړ او د څارنې دپاره یې په کې یو برج هم جوړ کړ. بیا یې هغه باغوانانو ته په اجاره ورکړ او خپله په سفر روان شو."}, {"ref": "Mark 1:1", "text": "کله چې عیسی د خدای د کور څخه وتلو، نو یو شاګرد یې ورته وویل: «ګوره استاذه، څومره ښکلې تیږې او لویې ودانۍ دي.»"}, {"ref": "Mark 1:1", "text": "د فسحې او د فطیرې ډوډۍ اختر ته دوه ورځې پاتې وې. مشران کاهنان او د شریعت عالمان په دې لټه کې وو چې څنګه عیسی په پټه راونیسي او ویې وژني."}, {"ref": "Mark 1:1", "text": "سهار وختي مشرانو کاهنانو د قومي مشرانو او د شریعت د عالمانو او د شورا نورو ټولو غړو سره یوه غونډه جوړه کړه او یوه پرېکړه یې وکړه. هغوی عیسی په زنځیرونو وتاړه او روان یې کړ او پیلاتوس ته یې وسپاره."}, {"ref": "Mark 1:1", "text": "کله چې د سبت ورځ تېره شوه، مریم مجدلیې او د یعقوب مور مریم او سالومې خوشبویه تېل واخیستل او لاړلې چې د عیسی په مړي باندې یې واچوي."}, {"ref": "Mark 1:2", "text": "ځینې فریسیان راغلل او د دې دپاره چې هغه وازمایي، نو پوښتنه یې ترې وکړه: «ایا دا روا ده چې یو سړی دې خپله ښځه طلاقه کړي؟»"}, {"ref": "Mark 1:2", "text": "او هغوی ته یې وویل: «مخامخ کلي ته ورشئ. څنګه چې هلته ورننوتلئ، نو هلته به یو کوټی ووینئ چې تړل شوی به وي او تر‌اوسه پورې څوک ورباندې سپور شوی نه دی. هغه را‌ایله کړئ او دلته یې راولئ."}, {"ref": "Mark 1:2", "text": "کله چې د انګورو د راټولولو وخت راورسېد، نو هغه خپل یو نوکر باغوانانو ته ورولېږه چې خپله برخه انګور ترې واخلي."}, {"ref": "Mark 1:2", "text": "عیسی هغه ته وویل: «ته دا لویې لویې ودانۍ وینې؟ دلته به یوه تیږه هم د بلې تیږې دپاسه پاتې نه شي او ټولې به راونړیږي.» په ایمان کې تر اخره ټینګ پاتې شئ"}, {"ref": "Mark 1:2", "text": "هغوی وویل: «خو دا کار باید د اختر په ورځو کې ونه شي، هسې نه چې خلک شور او غوغا جوړه کړي.» یوه ښخه د عیسی په سر باندې عطر اچوي (متي ۲۶‏:‌۶‌‏-‌۱۳ او یوحنا ۱۲‏:‌۱‌‏-‌۸)"}, {"ref": "Mark 1:2", "text": "پیلاتوس د هغه څخه پوښتنه وکړه: «ایا ته د یهودیانو پاچا یې؟» عیسی ځواب ورکړ: «ته په خپله وایې.»"}, {"ref": "Mark 1:2", "text": "د یکشنبې په ورځ سهار د لمر راختلو نه وروسته هغوی قبر ته ورغلې."}, {"ref": "Mark 1:3", "text": "عیسی په ځواب کې د هغوی څخه پوښتنه وکړه: «موسی په دې هکله تاسو ته څه حکم کړی دی؟»"}, {"ref": "Mark 1:3", "text": "که څوک درڅخه پوښتنه وکړي: دا څه کوئ؟ نو ورته ووایئ چې هغه زمونږ د استاذ په کار دی او سمدلاسه به یې بېرته دلته راولېږي.»"}, {"ref": "Mark 1:3", "text": "خو باغوانانو هغه نوکر ونیوه، هغه یې وواهه او تش لاس یې بېرته ولېږه."}, {"ref": "Mark 1:3", "text": "عیسی د زیتون په غره کې د خدای کور ته مخامخ ناست ؤ، نو کله چې پطروس، یعقوب، یوحنا او اندریاس د هغه سره یوازې پاتې شول، نو د هغه څخه یې پوښتنه وکړه:"}, {"ref": "Mark 1:3", "text": "عیسی په بیت‌عنیا کې د شمعون په کور کې چې مخکې یې د جذام ناروغي لرله، دسترخوان ته ناست ؤ. یوه ښځه راغله او د مرمرو بوتل ورسره ؤ چې د سنبل د قیمتي عطرو څخه ډک ؤ. هغې د بوتل سر مات کړ او د عیسی په سر باندې یې واچول."}, {"ref": "Mark 1:3", "text": "مشرانو کاهنانو په هغه باندې زیات تورونه ولګول،"}, {"ref": "Mark 1:3", "text": "هغوی په خپلو کې یو بل ته وویل: «مونږ ته به د قبر د خولې څخه تیږه څوک ورغړوي؟»"}, {"ref": "Mark 1:4", "text": "هغوی وویل: «موسی اجازه ورکړې ده چې یو سړی کولای شي خپلې ښځې ته طلاق‌نامه ورکړي او هغه پرېږدي.»"}, {"ref": "Mark 1:4", "text": "هغوی لاړل او دباندې په کوڅه کې یې یو کوټی ولیده چې د دروازې په مخکې تړل شوی ؤ. کله چې هغوی هغه کوټی راخلاصولو،"}, {"ref": "Mark 1:4", "text": "بیا هغه یو بل نوکر ورولېږه. هغه یې هم په سر سر وواهه او بې‌عزته یې کړ."}, {"ref": "Mark 1:4", "text": "«مونږ ته ووایه چې دا هرڅه به کله پېښ شي او د دې ټولو کارونو د پوره کېدلو نښه به څه وي؟»"}, {"ref": "Mark 1:4", "text": "په هغه ځای کې د حاضرو خلکو څخه ځینې یې په قهر شول او یو بل ته یې سره وویل: «دا عطر ولې داسې بېځایه ضایع شول؟"}, {"ref": "Mark 1:4", "text": "نو پیلاتوس د هغه څخه بیا پوښتنه وکړه: «ایا تا سره هېڅ ځواب نشته؟ ګوره هغوی په تا باندې څومره تورونه لګوي.»"}, {"ref": "Mark 1:4", "text": "خو کله چې هغوی وکتل، نو ویې لیدل چې هغه تیږه چې ډېره غټه وه شاته رغړېدلې وه."}, {"ref": "Mark 1:5", "text": "خو عیسی هغوی ته وویل: «موسی دا حکم د دې دپاره تاسو ته ولیکه چې ستاسو زړونه سخت وو."}, {"ref": "Mark 1:5", "text": "نو ځینې خلک چې په هغه ځای کې ولاړ وو، د هغوی څخه پوښتنه وکړه: «دا کوټی ولې ایله کوئ؟»"}, {"ref": "Mark 1:5", "text": "بیا هغه بل نوکر ورولېږه او هغه یې مړ کړ. هغه نور ډېر نوکران هم ورولېږل، خو ځینې یې ووهل او ځینې یې مړه کړل."}, {"ref": "Mark 1:5", "text": "عیسی هغوی ته وویل: «پام کوئ چې څوک مو بې‌لارې نه کړي."}, {"ref": "Mark 1:5", "text": "کېدای شول چې دا عطر د سپینو زرو د درې سوه سکو څخه په زیاته بیه خرڅ شوي وای او پیسې یې غریبانو ته ورکړل شوې وای.» نو هغوی هغه ښځه ورټله."}, {"ref": "Mark 1:5", "text": "خو عیسی ځواب ورنه کړ، نو په دې باندې پیلاتوس حیران شو. په عیسی باندې د اعدام حکم (متي ۲۷‏:‌۱۵‌‏-‌۲۶ او لوقا ۲۳‏:‌۱۳‌‏-‌۲۵ او یوحنا ۱۸‏:‌۳۹ ‏- ۱۹‏:‌۱۶)"}, {"ref": "Mark 1:5", "text": "کله چې هغوی قبر ته ورننوتلې، نو هلته یې یو ځوان سړی ولیده چې سپین کالي یې اغوستي وو او د قبر ښي خواته ناست ؤ. نو هغوی ووېرېدلې."}, {"ref": "Mark 1:6", "text": "خو د نړۍ د پیدایښت نه داسې وو: ‹خدای انسانان نر او ښځه پیدا کړل."}, {"ref": "Mark 1:6", "text": "نو لکه څنګه چې عیسی ورته ویلي وو، دوی ورته هماغسې ځواب ورکړ او بیا یې هغوی پرېښودل چې لاړ شي."}, {"ref": "Mark 1:6", "text": "یوازېنی کس چې ورته پاتې ؤ چې ور ویې لېږي هغه یې خپل ګران زوی ؤ. په پای کې یې خپل زوی ورولېږه او فکر یې وکړ چې هغوی به زما د زوی لحاظ وکړي."}, {"ref": "Mark 1:6", "text": "ډېر به زما په نوم راشي او وایي به: ‹زه مسیح یم› او ډېر خلک به بې‌لارې کړي."}, {"ref": "Mark 1:6", "text": "خو عیسی وویل: «د هغې سره کار مه لرئ! هغه ولې تنګوئ؟ هغې زما سره ښه کار کړی دی."}, {"ref": "Mark 1:6", "text": "پیلاتوس به د فسحې په هر اختر کې د خلکو په غوښتنه یو بندي ازادولو."}, {"ref": "Mark 1:6", "text": "خو هغه وویل: «مه وېرېږئ، زه پوهېږم چې تاسو ناصري عیسی لټوئ چې په صلیب باندې ځوړند شوی ؤ. هغه دلته نشته، هغه راژوندی شوی دی. ګورئ، دا هغه ځای دی چې د هغه مړی په کې ایښودل شوی ؤ."}, {"ref": "Mark 1:7", "text": "له همدې امله سړی خپل مور او پلار پرېږدي او د خپلې ښځې سره یوځای شي"}, {"ref": "Mark 1:7", "text": "هغوی هغه کوټی عیسی ته راوست او خپلې چپنې یې ورباندې واچولې او عیسی ورباندې سپور شو."}, {"ref": "Mark 1:7", "text": "خو باغوانانو یو بل ته وویل: ‹دا یې وارث دی، راځئ چې مړ یې کړو او میراث به یې زمونږ شي.›"}, {"ref": "Mark 1:7", "text": "کله چې تاسو د جنګونو په هکله خبرېږئ او د جنګونو اوازې واورئ، نو مه وارخطا کېږئ. دا شیان به خامخا پېښیږي. خو دا د دې معنی نه لري چې اخرنی وخت رارسېدلی دی."}, {"ref": "Mark 1:7", "text": "غریبان به تل ستاسو سره وي او هر وخت چې وغواړئ د هغوی سره مرسته کولای شئ، خو زه به تل ستاسو سره نه یم."}, {"ref": "Mark 1:7", "text": "په هغه وخت کې یو سړی چې باراباس نومېده او د یاغیانو سره یې د اله‌ګولې په وخت کې قتل کړی ؤ بندي ؤ."}, {"ref": "Mark 1:7", "text": "اوس لاړې شئ او د هغه شاګردانو او پطروس ته ووایئ چې هغه ستاسو څخه مخکې جلیل ته روان دی. لکه څنګه چې هغه خپله تاسو ته ویلي وو، تاسو به هغه هلته ووینئ.»"}, {"ref": "Mark 1:8", "text": "او دواړه یو بدن شي.› نو هغوی به نور دوه تنه نه بلکې یو تن وي."}, {"ref": "Mark 1:8", "text": "ډېرو خلکو ورته په لاره کې خپل کالي وغوړول او نورو د ونو څانګې راپرې کړلې او په لاره کې یې ورته واچولې."}, {"ref": "Mark 1:8", "text": "نو هغوی هغه ونیوه او مړ یې کړ او د هغه مړی یې د انګورو د باغ څخه دباندې وغورځاوه.»"}, {"ref": "Mark 1:8", "text": "یو قوم به د بل قوم سره او یوه پاچاهي به د بلې پاچاهۍ سره جنګیږي. د نړۍ په ډېرو ځایونو کې به زلزلې وشي او قحطي به راشي او دا شیان به لکه د لنګون د دردونو د پیل کېدلو په شان وي."}, {"ref": "Mark 1:8", "text": "دې ښځې چې څه کولای شول ویې کړل. هغې زما په بدن باندې عطر واچول چې د ښخولو څخه مې مخکې تیار کړي."}, {"ref": "Mark 1:8", "text": "خلک پیلاتوس ته ورغلل او د هغه څخه یې وغوښتل چې زمونږ دپاره هغه کار وکړه لکه څنګه چې هر وخت دې په اختر کې کاوه."}, {"ref": "Mark 1:8", "text": "هغوی د قبر څخه راووتلې او وتښتېدلې، ځکه چې د ډېرې وېرې لړزېدلې او وارخطا شوې وې. هغوی هېچا ته څه ونه ویل، ځکه چې وېرېدلې وې. عیسی مریم مجدلیې ته ښکاره کیږي (متي ۲۸‏:‌۹‌‏-‌۱۰ او یوحنا ۲۰‏:‌۱۱‌‏-‌۱۸) ["}, {"ref": "Mark 1:9", "text": "نو څرنګه چې خدای هغوی سره یوځای کړي دي، انسان باید هغوی سره بېل نه کړي.»"}, {"ref": "Mark 1:9", "text": "او کوم خلک چې د هغه څخه مخکې روان وو او هغه چې شاته ورپسې روان وو، چیغې وهلې: «ژوندی دې وي! مبارک دې وي هغه څوک چې د څښتن په نوم راځي."}, {"ref": "Mark 1:9", "text": "عیسی پوښتنه وکړه: «د باغ خاوند به اوس څه کوي؟ هغه به راشي او باغوانان به ووژني او باغ به نورو ته ورکړي."}, {"ref": "Mark 1:9", "text": "خو تاسو په خپلو ځانونو باندې پام کوئ. تاسو به د محاکمې دپاره شوراګانو ته سپارل کېږئ، په کنیسو کې به وهل کېږئ او زما په خاطر به د والیانو او پاچاهانو په مخکې درول کېږئ، ترڅو د هغوی په مخکې شاهدي ورکړئ."}, {"ref": "Mark 1:9", "text": "په یقین سره زه تاسو ته دا وایم چې د نړۍ په هرځای کې چې زېری ورکول کیږي، نو دې ښځې چې څه کړي دي خلک به هغه یادوي.» د عیسی سره د خیانت کولو دسیسه (متي ۲۶‏:‌۱۴‌‏-‌۱۶ او لوقا ۲۲‏:‌۳‌‏-‌۶)"}, {"ref": "Mark 1:9", "text": "پیلاتوس د هغوی څخه پوښتنه وکړه: «ایا تاسو غواړئ چې د یهودیانو پاچا درته راخلاص کړم؟»"}, {"ref": "Mark 1:9", "text": "کله چې عیسی د یکشنبې په ورځ سهار وختي د مړو نه راژوندی شو، نو لومړی مریم مجدلیې ته چې هغه ورڅخه اووه پېریان ویستلي وو ښکاره شو."}, {"ref": "Mark 1:10", "text": "کله چې هغوی بېرته کور ته ننوتل، نو شاګردانو د دې موضوع په هکله د عیسی څخه پوښتنه وکړه."}, {"ref": "Mark 1:10", "text": "مبارکه دې وي زمونږ د نیکه داود راتلونکې پاچاهي. ثنا دې وي څښتن تعالی ته.»"}, {"ref": "Mark 1:10", "text": "ایا تاسو د خدای په کلام کې دا نه دي لوستلي: کومه تیږه چې رد کړې ګلکارانو وه هغه اوس شوه اصلي تیږه د تهداب"}, {"ref": "Mark 1:10", "text": "خو مخکې له دې چې اخري وخت راورسیږي، نو اول باید ټولو قومونو ته زېری ورسول شي."}, {"ref": "Mark 1:10", "text": "بیا یهودا اسخریوتي چې د هغو دولسو شاګردانو څخه ؤ، مشرانو کاهنانو ته ورغی چې عیسی هغوی ته په لاس ورکړي."}, {"ref": "Mark 1:10", "text": "ځکه چې پیلاتوس په دې پوهېده چې مشرانو کاهنانو د بخیلۍ له امله عیسی هغه ته په لاس ورکړی دی."}, {"ref": "Mark 1:10", "text": "هغه لاړه او څه چې پېښ شوي وو هغه یې د عیسی نژدې ملګرو ته چې ویر او ژړاګانې یې کولې، وویل."}, {"ref": "Mark 1:11", "text": "هغه ورته وویل: «هرڅوک چې خپله ښځه طلاقه کړي او د بلې ښځې سره واده وکړي، نو هغه د خپلې لومړنۍ ښځې په وړاندې زنا کوي."}, {"ref": "Mark 1:11", "text": "عیسی اورشلیم ته ورسېده او د خدای کور ته ننوت او هلته شاوخوا ټولو شیانو ته یې وکتل. خو څرنګه چې ناوخته ؤ، نو د هغو دولسو شاګردانو سره بیت‌عنیا ته لاړ. عیسی د انځر په ونې لعنت وایي (متي ۲۱‏:‌۱۸‌‏-‌۱۹)"}, {"ref": "Mark 1:11", "text": "دا کار وشو د څښتن له خوا نه او عجیبه ښکاري زمونږ نظر کې»"}, {"ref": "Mark 1:11", "text": "نو کله چې تاسو ونیول شئ او محکمې ته یووړل شئ، نو مخکې له مخکې مه پرېشانه کېږئ چې څه به وایئ بلکې څه چې په هغه ساعت کې د روح القدس په وسیله تاسو ته ویل کیږي ووایئ، ځکه چې هغه به ستاسو خبرې نه بلکې د روح القدس خبرې وي."}, {"ref": "Mark 1:11", "text": "کله چې هغوی دا واورېدل، نو خوشحاله شول او د هغه سره یې د پیسو وعده وکړه. نو یهودا د یوې موقعې په لټه کې ؤ ترڅو عیسی هغوی ته په لاس ورکړي. د فسحې د اختر ډوډۍ (متي ۲۶‏:‌۱۷‌‏-‌۲۵ او لوقا ۲۲‏:‌۷‌‏-‌۱۴،‌۲۱‌‏-‌۲۳ او یوحنا ۱۳‏:‌۲۱‌‏-‌۳۰)"}, {"ref": "Mark 1:11", "text": "خو مشرانو کاهنانو خلک ولمسول چې د پیلاتوس څخه وغواړي چې د عیسی په ځای ورته باراباس ازاد کړي."}, {"ref": "Mark 1:11", "text": "کله چې هغوی واورېدل چې عیسی ژوندی شوی دی او مریم لیدلی دی، نو باور یې ورباندې ونه کړ. عیسی دوو شاګردانو ته ښکاره کیږي (لوقا ۲۴‏:‌۱۳‌‏-‌۳۵)"}, {"ref": "Mark 1:12", "text": "په همدې ډول که یوه ښځه خپل مېړه ته طلاق ورکړي او د بل سړي سره واده وکړي، نو هغه هم زنا کوي.» عیسی ماشومانو ته برکت ورکوي (متي ۱۹‏:‌۱۳‌‏-‌۱۵ او لوقا ۱۸‏:‌۱۵‌‏-‌۱۷)"}, {"ref": "Mark 1:12", "text": "په بله ورځ کله چې عیسی او شاګردان یې د بیت‌عنیا څخه راروان وو، نو عیسی وږی شو."}, {"ref": "Mark 1:12", "text": "د یهودیانو مشرانو هڅه کوله چې عیسی ونیسي، ځکه چې هغوی پوه شول چې هغه دا مثال د هغوی په هکله وویلو. خو هغوی د خلکو څخه وېرېدل، نو هغه یې پرېښود او لاړل. د مالیې ورکولو په هکله پوښتنه (متي ۲۲‏:‌۱۵‌‏-‌۲۲ او لوقا ۲۰‏:‌۲۰‌‏-‌۲۶)"}, {"ref": "Mark 1:12", "text": "ورور به د ورور سره خیانت وکړي چې ووژل شي او پلار به د خپلو اولادونو سره. اولادونه به د خپلو میندو او پلرونو په خلاف راپورته شي او د هغوی د مړینې سبب به شي."}, {"ref": "Mark 1:12", "text": "د فطیرې ډوډۍ د اختر په لومړۍ ورځ یعنې په هغه ورځ چې هغوی د فسحې وری قرباني کاوه، د عیسی شاګردانو هغه ته وویل: «ته چېرته غواړې چې د فسحې ډوډۍ درته تیاره کړو؟»"}, {"ref": "Mark 1:12", "text": "پیلاتوس یوځل بیا هغوی ته وویل: «نو بیا د هغه سړي سره چې تاسو ورته د یهودیانو پاچا وایئ څه وکړم؟»"}, {"ref": "Mark 1:12", "text": "له هغې وروسته عیسی په بله څېره کې خپلو دوو شاګردانو ته چې د اورشلیم څخه کلي ته روان وو، ښکاره شو."}, {"ref": "Mark 1:13", "text": "خلکو عیسی ته خپل ماشومان راوستل چې خپل لاس په هغوی باندې کېږدي، خو شاګردانو هغوی ورټل."}, {"ref": "Mark 1:13", "text": "هغه د لېرې نه د انځر یوه ونه ولیدله چې په پاڼو کې پټه وه، هغه ورغی چې څه انځر په کې پیدا کړي. خو کله چې هلته ورسېده، نو بې له پاڼو یې په کې بل هېڅ شی ونه موندل، ځکه چې دا د انځرو د پخېدلو موسم نه ؤ."}, {"ref": "Mark 1:13", "text": "بیا هغوی ځینې فریسیان او د هیرودیس پلویان ولېږل چې عیسی په خپلو خبرو کې راونیسي."}, {"ref": "Mark 1:13", "text": "ټول خلک به زما د نوم له امله ستاسو څخه کرکه کوي. خو څوک چې تر اخره پورې ټینګ پاتې شي، هغه به خلاصون ومومي. لوی مصیبت (متي ۲۴‏:‌۱۵‌‏-‌۲۸ او لوقا ۲۱‏:‌۲۰‌‏-‌۲۴)"}, {"ref": "Mark 1:13", "text": "نو عیسی خپل دوه شاګردان ولېږل او ورته ویې ویل: «ښار ته لاړ شئ، یو سړی به ووینئ چې د اوبو منګی وړي. په هغه پسې لاړ شئ"}, {"ref": "Mark 1:13", "text": "هغوی بیا چیغې کړې: «هغه په صلیب باندې ځوړند کړئ.»"}, {"ref": "Mark 1:13", "text": "هغوی بېرته لاړل او نور شاګردان یې خبر کړل، خو هغوی یې په خبره باندې باور ونه کړ. عیسی خپلو یوولسو شاګردانو ته ښکاره کیږي (متي ۲۸‏:‌۱۶‌‏-‌۲۰ او لوقا ۲۴‏:‌۳۶‌‏-‌۴۹ او یوحنا ۲۰‏:‌۱۹‌‏-‌۲۳ او د رسولانو عملونه ۱‏:‌۶‌‏-‌۸)"}, {"ref": "Mark 1:14", "text": "خو کله چې عیسی ولیدل چې هغوی څه کوي، نو خفه شو او خپلو شاګردانو ته یې وویل: «ماشومان پرېږدئ چې ماته راشي، هغوی مه منع کوئ، ځکه چې د خدای پاچاهي د همداسې خلکو ده."}, {"ref": "Mark 1:14", "text": "نو هغې ونې ته یې وویل: «نور به هېڅوک هم هېڅکله ستا مېوه ونه خوري.» او د هغه شاګردانو واورېدل چې هغه څه وویل. عیسی د خدای د کور نه سوداګران شړي (متي ۲۱‏:‌۱۲‌‏-‌۱۷ او لوقا ۱۹‏:‌۴۵‌‏-‌۴۸ او یوحنا ۲‏:‌۱۳‌‏-‌۲۲)"}, {"ref": "Mark 1:14", "text": "هغوی راغلل او عیسی ته یې وویل: «استاذه! مونږ پوهېږو چې ته یو رښتینی سړی یې او د هېچا طرفداري نه کوې که هغه هرڅوک وي بلکې په رښتینې توګه د خدای د لارې تعلیم ورکوې. ایا د روم امپراتور ته مالیه ورکول روا دي که نه؟ مونږ باید ورته مالیه ورکړو که نه؟»"}, {"ref": "Mark 1:14", "text": "کله چې تاسو هغه نجس شی چې د بربادۍ سبب ګرځي، په هغه ځای کې ولاړ ووینئ چې باید هلته نه وي، (لوستونکی دې پوه شي چې د دې معنی څه ده) نو څوک چې په یهودیې کې وي هغه دې غرونو ته وتښتي."}, {"ref": "Mark 1:14", "text": "او کوم کور ته چې هغه ورننوت، تاسو هم ورشئ او د کور خاوند ته ووایئ: ‹استاذ وایي د مېلمنو هغه کوټه چېرته ده چې زه او زما شاګردان به په کې د فسحې ډوډۍ وخورو؟›"}, {"ref": "Mark 1:14", "text": "پیلاتوس د هغوی څخه پوښتنه وکړه: «ولې، هغه څه جرم کړی دی؟» خو هغوی چیغې نورې هم زیاتې کړې: «هغه په صلیب باندې ځوړند کړئ.»"}, {"ref": "Mark 1:14", "text": "وروسته بیا عیسی خپل ځان یوولسو شاګردانو ته چې ډوډۍ ته ناست وو، ورښکاره کړ. هغوی یې د بې‌ایمانۍ او سختو زړونو د لرلو په خاطر ورټل، ځکه چې هغوی د هغو خلکو په خبرو یقین ونه کړ چې هغه یې د راژوندي کېدلو څخه وروسته لیدلی ؤ."}, {"ref": "Mark 1:15", "text": "په یقین سره زه تاسو ته دا وایم هرڅوک چې د خدای پاچاهي د یو ماشوم په څېر ونه مني، نو هغه به هېڅکله هم وردننه نه شي.»"}, {"ref": "Mark 1:15", "text": "کله چې هغوی اورشلیم ته ورسېدل، نو عیسی د خدای کور ته ننوت او له هغه ځای څخه یې د خرڅوونکو او اخیستونکو په شړلو پیل وکړ. د صرافانو مېزونه او د کوترو خرڅوونکو چوکۍ‌ګانې یې په بل مخ واړولې،"}, {"ref": "Mark 1:15", "text": "خو عیسی د هغوی په منافقت پوه شو او ورته ویې ویل: «تاسو ولې هڅه کوئ چې ما وازمایئ؟ ماته د سپینو زرو یوه سکه راوړئ چې ویې ګورم.»"}, {"ref": "Mark 1:15", "text": "که څوک د بام په سر وي، نو هغه دې د کوم شي د وړلو دپاره لاندې راښکته نه شي او خپل کور ته دې نه ننوځي."}, {"ref": "Mark 1:15", "text": "هغه به تاسو ته پاس په بالاخانه کې یوه لویه فرش شوې کوټه دروښایي. هلته زمونږ دپاره ډوډۍ تیاره کړئ.»"}, {"ref": "Mark 1:15", "text": "پیلاتوس غوښتل چې خلک خوشحاله کړي، نو باراباس یې ورته ازاد کړ. بیا یې حکم وکړ چې عیسی په دورو باندې ووهي او هغه دې عسکرو ته وسپاري چې په صلیب باندې یې ځوړند کړي. عسکر په عیسی باندې ملنډې وهي (متي ۲۷‏:‌۲۷‌‏-‌۳۱ او یوحنا ۱۹‏:‌۲‌‏-‌۳)"}, {"ref": "Mark 1:15", "text": "نو هغوی ته یې وویل: «په ټوله نړۍ کې وګرځئ او دا زېری ټولو ته ورسوئ."}, {"ref": "Mark 1:16", "text": "بیا عیسی ماشومان په غېږ کې ونیول او خپل لاس یې د هغوی په سرونو باندې کېښود او هغوی ته یې برکت ورکړ. شتمن خلک او د خدای پاچاهي (متي ۱۹‏:‌۱۶‌‏-‌۳۰ او لوقا ۱۸‏:‌۱۸‌‏-‌۳۰)"}, {"ref": "Mark 1:16", "text": "او چاته یې اجازه نه ورکوله چې د خدای د کور د حوېلۍ په لاره کوم شی یوسي."}, {"ref": "Mark 1:16", "text": "هغوی یوه سکه راوړله او هغه ترې پوښتنه وکړه: «په دې باندې د چا تصویر او د چا نوم دی؟» هغوی ځواب ورکړ: «د امپراتور.»"}, {"ref": "Mark 1:16", "text": "او که څوک په پټي کې وي، نو هغه دې د خپلې چپنې پسې بېرته کور ته نه ورځي."}, {"ref": "Mark 1:16", "text": "بیا شاګردان روان شول او ښار ته لاړل نو هغوی ټول شیان هماغه شان ولیدل لکه څنګه چې عیسی ورته ویلي وو، نو هغوی د فسحې ډوډۍ تیاره کړه."}, {"ref": "Mark 1:16", "text": "عسکرو عیسی دننه د والي ماڼۍ ته بوته او ټول کنډک یې راټول کړ."}, {"ref": "Mark 1:16", "text": "هرڅوک چې ایمان راوړي او د تعمید غسل واخلي نو هغه به خلاصون ومومي، خو څوک چې ایمان رانه وړي نو هغه به محکوم کړای شي."}, {"ref": "Mark 1:17", "text": "کله چې عیسی په خپله لاره روان ؤ، نو یو سړي رامنډه کړه او د هغه په مخکې په ګونډو شو او پوښتنه یې ترې وکړه: «ای نېک استاذه! زه باید څه وکړم ترڅو تلپاتې ژوندون وګټم؟»"}, {"ref": "Mark 1:17", "text": "بیا هغه خلکو ته تعلیم ورکاوه او ویل یې: «ایا د خدای په کلام کې دا نه دي لیکل شوي: زما کور به د ټولو قومونو دپاره د دعا کور بلل کیږي خو تاسو ترې د غلو د پټېدلو ځای جوړ کړی دی.»"}, {"ref": "Mark 1:17", "text": "بیا عیسی هغوی ته وویل: «څه چې د امپراتور دي هغه امپراتور ته ورکړئ او څه چې د خدای دي هغه خدای ته ورکړئ.» هغوی د هغه په خبرو حیران شول. د قیامت د ورځې په هکله پوښتنه (متي ۲۲‏:‌۲۳‌‏-‌۳۳ او لوقا ۲۰‏:‌۲۷‌‏-‌۴۰)"}, {"ref": "Mark 1:17", "text": "افسوس د هغو ښځو په حال چې په هغو ورځو کې امیدوارې وي یا په هغو ښځو چې خپلو ماشومانو ته شیدې ورکوي."}, {"ref": "Mark 1:17", "text": "کله چې ماښام شو، نو عیسی د دولسو شاګردانو سره راغی."}, {"ref": "Mark 1:17", "text": "هغوی عیسی ته بانجاني چپنه ورواغوستله او د اغزیو تاج یې ور په سر کړ."}, {"ref": "Mark 1:17", "text": "څوک چې ایمان راوړي، نو هغوی ته به دا نښه ورکړل شي چې زما په نوم به پېریان وباسي او په نویو ژبو به خبرې کوي،"}, {"ref": "Mark 1:18", "text": "عیسی هغه ته وویل: «ولې ماته نېک وایې؟ بې له خدایه بل هېڅوک نېک نه دی."}, {"ref": "Mark 1:18", "text": "مشرانو کاهنانو او د شریعت عالمانو چې دا واورېدل، نو په دې لټه کې شول چې د عیسی د وژلو دپاره کومه لاره پیدا کړي. خو هغوی وېرېدل، ځکه چې ټول خلک د هغه تعلیم ته حیران وو."}, {"ref": "Mark 1:18", "text": "بیا صدوقیان چې د مرګ څخه وروسته د بیا راژوندي کېدلو څخه منکر وو، عیسی ته راغلل او د هغه څخه یې یوه پوښتنه وکړه:"}, {"ref": "Mark 1:18", "text": "دعا کوئ چې دا شیان په ژمي کې پېښ نه شي."}, {"ref": "Mark 1:18", "text": "کله چې هغوی دسترخوان ته کښېناستل او ډوډۍ یې خوړله، عیسی وویل: «په یقین سره زه تاسو ته دا وایم چې په تاسو کې به یو تن چې زما سره ډوډۍ خوري، زما سره خیانت وکړي.»"}, {"ref": "Mark 1:18", "text": "بیا یې هغه ته سلامي وکړه او ویې ویل: «ژوندی دې وي د یهودیانو پاچا.»"}, {"ref": "Mark 1:18", "text": "هغوی به ماران نیسي او که زهر وخوري، نو زیان به ورته نه رسیږي او کله چې په ناروغانو باندې خپل لاسونه ږدي، نو هغوی به ښه کیږي.» اسمان ته د عیسی ختل (لوقا ۲۴‏:‌۵۰‌‏-‌۵۳ او د رسولانو عملونه ۱‏:‌۹‌‏-‌۱۱)"}, {"ref": "Mark 1:19", "text": "ته په حکمونو باندې پوهېږې: زنا مه کوه، قتل مه کوه، غلا مه کوه، په دروغو شاهدي مه ورکوه، ټګي مه کوه او د خپل مور او پلار عزت کوه.»"}, {"ref": "Mark 1:19", "text": "کله چې ماښام شو، نو عیسی او شاګردان یې د ښار څخه ووتل. د انځر د ونې څخه عبرت اخیستل (متي ۲۱‏:‌۲۰‌‏-‌۲۲)"}, {"ref": "Mark 1:19", "text": "«استاذه! موسی په شریعت کې مونږ ته لیکلي دي چې که چېرې د یو سړي ورور مړ شي او بې‌اولاده ښځه ترې پاتې شي، نو د هغه سړي ورور باید د هغې کونډې سره واده وکړي ترڅو اولادونه یې پیدا شي او هغه یې د مړه ورور اولادونه وګڼل شي."}, {"ref": "Mark 1:19", "text": "ځکه چې په هغو ورځو کې به داسې مصیبت رامنځته شي چې د کوم وخت نه چې خدای نړۍ پیدا کړې ده تر‌اوسه پورې نه دی راغلی او نه به بیا راشي."}, {"ref": "Mark 1:19", "text": "په دې خبره شاګردان ډېر غمجن شول او هر یو د عیسی څخه پوښتنه وکړه: «ایا هغه زه یم؟»"}, {"ref": "Mark 1:19", "text": "هغه یې په لرګي باندې په سر سر وهلو او لاړې یې ورباندې تو کولې او د هغه په مخکې په ګونډو شول چې دا وښایي چې ګوندې درناوی یې کوي."}, {"ref": "Mark 1:19", "text": "د هغوی سره د خبرو کولو نه وروسته څښتن عیسی اسمان ته پورته یووړل شو او د خدای ښي لاس ته کښېناست."}, {"ref": "Mark 1:20", "text": "هغه سړي ځواب ورکړ: «استاذه، ما د ځوانۍ له وخته په دې ټولو حکمونو باندې عمل کړی دی.»"}, {"ref": "Mark 1:20", "text": "بله ورځ سهار وختي کله چې هغوی په لاره تېرېدل، نو ویې لیدل چې هغه د انځر ونه له بېخه وچه شوې وه."}, {"ref": "Mark 1:20", "text": "په یو وخت کې اووه ورونه وو، لومړني یې واده وکړ او بې‌اولاده مړ شو."}, {"ref": "Mark 1:20", "text": "که چېرې خدای دغه راتلونکې ورځې لنډې کړې نه وای، نو هېڅوک به ژوندی پاتې نه وای. خو هغه د خپلو غوره شویو خلکو په خاطر هغه ورځې لنډې کړې دي."}, {"ref": "Mark 1:20", "text": "عیسی هغوی ته ځواب ورکړ: «هغه ستاسو دولسو تنو څخه دی چې زما سره په یوه کاسه کې لاس ښکته کوي."}, {"ref": "Mark 1:20", "text": "کله چې هغوی ملنډې وهل بس کړل، نو هغه بانجاني چپنه یې ترې وویستله او خپل کالي یې ورته بېرته ورواغوستل. بیا یې هغه دباندې بوته چې په صلیب باندې یې ځوړند کړي. عیسی په صلیب باندې مېخ کیږي (متي ۲۷‏:‌۳۲‌‏-‌۳۴ او لوقا ۲۳‏:‌۲۶‌‏-‌۴۳ او یوحنا ۱۹‏:‌۱۷‌‏-‌۲۷)"}, {"ref": "Mark 1:20", "text": "بیا شاګردان لاړل او په هرځای کې یې وعظ کاوه او څښتن ورسره مرسته کوله او د معجزو په ښودلو یې دا ثابته کړه چې د هغوی پیغام رښتینی دی.]"}, {"ref": "Mark 1:21", "text": "عیسی هغه ته وکتل او په هغه باندې یې مینه راغله او ورته ویې ویل: «په تا کې د یو شي کمی شته، لاړ شه او هرڅه چې لرې هغه خرڅ کړه او پیسې یې غریبانو ته ورکړه، نو ته به په اسمان کې خزانې ولرې او بیا راشه او زما پیروي وکړه.»"}, {"ref": "Mark 1:21", "text": "پطروس هغه خبره رایاده کړه چې عیسی د انځر ونې ته کړې وه او ویې ویل: «استاذه! ګوره، د انځر په هغې ونې چې تا لعنت ویلی ؤ هغه وچه شوې ده.»"}, {"ref": "Mark 1:21", "text": "بیا دوهم ورور د هغې ښځې سره واده وکړ، خو هغه هم بې‌اولاده مړ شو او د درېم ورور سره هم همداسې وشول."}, {"ref": "Mark 1:21", "text": "که په هغه وخت کې څوک تاسو ته ووایي: ‹ګورئ، مسیح دلته دی یا هلته دی.› نو باور ورباندې مه کوئ."}, {"ref": "Mark 1:21", "text": "لکه څنګه چې د خدای په کلام کې لیکل شوي دي، د انسان زوی باید مړ شي، خو افسوس د هغه چا په حال چې د انسان د زوی سره خیانت کوي! د هغه سړي دپاره به ښه وه چې هېڅ پیدا شوی نه وای.» د څښتن غوره ماښامی (متي ۲۶‏:‌۲۶‌‏-‌۳۰ او لوقا ۲۲‏:‌۱۴‌‏-‌۲۰ او لومړی قرنتیان ۱۱‏:‌۲۳‌‏-‌۲۵)"}, {"ref": "Mark 1:21", "text": "هغوی په لاره کې د شمعون په نوم د یو سړي سره چې د کلیوالي سیمې څخه ښار ته راروان ؤ، مخامخ شول. عسکرو هغه مجبور کړ چې د عیسی صلیب یوسي. شمعون د قیروان څخه ؤ او د سکندر او روفس پلار ؤ."}, {"ref": "Mark 1:22", "text": "په دې خبره د هغه څېره بدله شوه او غمجن لاړ، ځکه چې هغه ډېر شتمن سړی ؤ."}, {"ref": "Mark 1:22", "text": "عیسی ورته په ځواب کې وویل: «په خدای باندې ایمان ولرئ."}, {"ref": "Mark 1:22", "text": "اخر اووه واړه مړه شول او د هېڅ یو اولاد ونه شو. له ټولو نه وروسته هغه ښځه هم مړه شوه."}, {"ref": "Mark 1:22", "text": "ځکه چې داسې کسان به پیدا شي چې په دروغو به دعوه کوي چې مسیح او پیغمبران دي او معجزې به وښایي او حیرانوونکي کارونه به کوي او که امکان ولري، نو د خدای غوره شوي خلک به هم بې‌لارې کړي."}, {"ref": "Mark 1:22", "text": "د ډوډۍ خوړلو په وخت کې عیسی یوه ډوډۍ راواخیستله، شکر یې پرې وویست، هغه یې ماته کړه، شاګردانو ته یې ورکړه او ویې ویل: «دا واخلئ، دا زما بدن دی.»"}, {"ref": "Mark 1:22", "text": "هغوی عیسی د جلجتا په نوم هغه ځای ته بوته چې معنی یې ده د سر د کوپړۍ ځای."}, {"ref": "Mark 1:23", "text": "عیسی شاوخوا ته وکتل او خپلو شاګردانو ته یې وویل: «شتمنو خلکو ته د خدای په پاچاهۍ کې ننوتل څومره ګران کار دی.»"}, {"ref": "Mark 1:23", "text": "په یقین سره زه تاسو ته دا وایم چې که څوک ایمان ولري او په زړه کې شک ونه کړي، نو که دې غره ته ووایي چې د خپل ځای څخه پورته شه او په بحیرې کې وغورځېږه، نو همداسې به وشي."}, {"ref": "Mark 1:23", "text": "نو د قیامت په ورځ چې خلک راژوندي کیږي هغه به د کوم یو ښځه وي؟ ځکه چې اووه واړو ورسره واده کړی ؤ.»"}, {"ref": "Mark 1:23", "text": "نو پام کوئ، تاسو مې له مخکې نه د دې ټولو شیانو نه خبر کړئ. د انسان د زوی راتګ (متي ۲۴‏:‌۲۹‌‏-‌۳۱ او لوقا ۲۱‏:‌۲۵‌‏-‌۲۸)"}, {"ref": "Mark 1:23", "text": "بیا هغه پیاله راواخیستله او د خدای شکر یې وویست او هغوی ته یې ورکړه او د هغې نه ټولو وڅښل."}, {"ref": "Mark 1:23", "text": "هغه ته یې داسې شراب ورکول چې د مر کنډ په نوم یوه دوا په کې ګډه شوې وه، خو هغه ونه څښل."}, {"ref": "Mark 1:24", "text": "شاګردان د هغه په خبرو حیران شول، خو عیسی یوځل بیا هغوی ته وویل: «ای بچیانو، د خدای پاچاهۍ ته ننوتل څومره ګران کار دی."}, {"ref": "Mark 1:24", "text": "نو له دې امله زه تاسو ته وایم هرڅه چې تاسو یې په دعا کې وغواړئ، نو یقین ولرئ چې لاسته به یې راوړئ او هغه به ستاسو شي."}, {"ref": "Mark 1:24", "text": "عیسی هغوی ته وویل: «ستاسو غلطي په دې کې ده چې نه د خدای په کلام پوهېږئ او نه د خدای د قدرت څخه خبر یئ."}, {"ref": "Mark 1:24", "text": "خو په هغو ورځو کې به د هغه مصیبت نه وروسته لمر تیاره شي او سپوږمۍ به نوره رڼا نه ورکوي،"}, {"ref": "Mark 1:24", "text": "عیسی وویل: «دا زما وینه ده چې د خدای او انسان ترمنځ لوظ ټینګوي چې د ډېرو خلکو دپاره توییږي."}, {"ref": "Mark 1:24", "text": "بیا هغوی عیسی په صلیب باندې مېخ کړ او پچه یې واچوله او د هغه کالي یې په خپل منځ کې سره ووېشل چې کوم شی د چا شي."}, {"ref": "Mark 1:25", "text": "د ستنې د سوري څخه د اوښ تېرېدل اسان دي له دې نه چې یو شتمن سړی دې د خدای پاچاهۍ ته ورننوځي.»"}, {"ref": "Mark 1:25", "text": "او هرکله چې تاسو د دعا دپاره ودرېږئ، نو که ستاسو په زړونو کې د چا په خلاف کوم څه شی وي هغه وبخښئ، ترڅو ستاسو اسماني پلار هم ستاسو ګناهونه وبخښي."}, {"ref": "Mark 1:25", "text": "کله چې مړي راژوندي شي، نو نه خو سړي ودونه کوي او نه هم ښځې ورکول کیږي چې واده شي، بلکې هغوی به د اسمان د فرښتو په شان وي."}, {"ref": "Mark 1:25", "text": "ستوري به د اسمان څخه راولویږي او اسماني موجودات به ولړزیږي."}, {"ref": "Mark 1:25", "text": "په یقین سره زه تاسو ته دا وایم چې بیا به تر هغې ورځې پورې دا د انګورو شربت ونه څښم ترڅو د خدای په پاچاهۍ کې یې بیا ونه څښم.»"}, {"ref": "Mark 1:25", "text": "د سهار نهه بجې وې چې هغه یې په صلیب باندې ځوړند کړ."}, {"ref": "Mark 1:26", "text": "شاګردان ډېر زیات حیران شول او یو بل ته یې وویل: «نو بیا څوک کولای شي چې خلاصون ومومي؟»"}, {"ref": "Mark 1:26", "text": "[خو که چېرې تاسو نور خلک ونه بخښئ، نو ستاسو اسماني پلار به هم ستاسو ګناهونه ونه بخښي.]» د عیسی د اختیار په هکله پوښتنه (متي ۲۱‏:‌۲۳‌‏-‌۲۷ او لوقا ۲۰‏:‌۱‌‏-‌۸)"}, {"ref": "Mark 1:26", "text": "ایا تاسو د مړو د بیا راژوندي کېدلو په هکله د موسی په تورات کې د سوځېدونکي بوټي په کیسه کې نه دي لوستلي چې خدای څنګه موسی ته وویل: ‹زه د ابراهیم خدای، د اسحاق خدای او د یعقوب خدای یم.›"}, {"ref": "Mark 1:26", "text": "بیا به هغوی وویني چې د انسان زوی به د لوی قدرت او جلال سره په ورېځو کې راروان وي."}, {"ref": "Mark 1:26", "text": "بیا د یوې روحاني سندرې د ویلو څخه وروسته د زیتون غره ته لاړل. د پطروس د انکار په هکله پېشګویي (متي ۲۶‏:‌۳۱‌‏-‌۳۵ او لوقا ۲۲‏:‌۳۱‌‏-‌۳۴ او یوحنا ۱۳‏:‌۳۶‌‏-‌۳۸)"}, {"ref": "Mark 1:26", "text": "په هغه باندې لګول شوی تور چې په یوه تخته باندې داسې لیکل شوی ؤ: «د یهودیانو پاچا.»"}, {"ref": "Mark 1:27", "text": "عیسی هغوی ته وکتل او ویې ویل: «د انسان دپاره دا ناشونې ده خو د خدای دپاره نه، ځکه چې د خدای دپاره هرڅه ممکن دي.»"}, {"ref": "Mark 1:27", "text": "هغوی یوځل بیا اورشلیم ته راغلل. کله چې عیسی د خدای په کور کې ګرځېده، نو مشران کاهنان، د شریعت عالمان او د قوم مشران ورته راغلل"}, {"ref": "Mark 1:27", "text": "خدای د مړو خدای نه بلکې د ژوندیو خدای دی. تاسو ډېر بې‌لارې شوي یئ.» لوی حکم (متي ۲۲‏:‌۳۴‌‏-‌۴۰ او لوقا ۱۰‏:‌۲۵‌‏-‌۲۸)"}, {"ref": "Mark 1:27", "text": "هغه به فرښتې ولېږي او د ټولې نړۍ د یو سر نه تر بل سر پورې به خپل غوره شوي خلک سره راټول کړي. د انځر د ونې نه عبرت اخیستل (متي ۲۴‏:‌۳۲‌‏-‌۳۵ او لوقا ۲۱‏:‌۲۹‌‏-‌۳۳)"}, {"ref": "Mark 1:27", "text": "عیسی خپلو شاګردانو ته وویل: «تاسو ټول به وتښتئ او ما به پرېږدئ، ځکه چې د خدای په کلام کې لیکل شوي دي: زه به شپون ووهم او پسونه به خواره واره شي."}, {"ref": "Mark 1:27", "text": "د هغه سره یې دوه داړه ماران هم په صلیب باندې ځوړند کړل، یو د هغه ښي لاس ته او بل چپ لاس ته. ["}, {"ref": "Mark 1:28", "text": "بیا پطروس هغه ته وویل: «وګوره، مونږ هرڅه پریښي دي او تا پسې روان شوي یو.»"}, {"ref": "Mark 1:28", "text": "او د هغه څخه یې پوښتنه وکړه: «ته څه حق لرې چې دا کارونه کوې؟ چا تاته دا اختیار درکړی دی چې دا کارونه وکړې؟»"}, {"ref": "Mark 1:28", "text": "د شریعت یو عالم راغی او د هغوی بحث یې واورېد او ویې لیدل چې عیسی صدوقیانو ته ښه ځواب ورکړ، نو د عیسی څخه یې پوښتنه وکړه: «د ټولو حکمونو څخه ډېر مهم حکم کوم یو دی؟»"}, {"ref": "Mark 1:28", "text": "د انځر د ونې څخه عبرت واخلئ. کله چې د هغې څانګې غوټۍ ونیسي او پاڼې وکړي، نو تاسو پوهېږئ چې اوړی رانژدې دی."}, {"ref": "Mark 1:28", "text": "خو کله چې بیا راژوندی شم، نو ستاسو نه مخکې به جلیل ته لاړ شم.»"}, {"ref": "Mark 1:28", "text": "په دې ډول د پیغمبرانو هغه لیکنې پوره شوې چې وایي: «هغه په بدکارانو کې وشمېرل شو.»]"}, {"ref": "Mark 1:29", "text": "عیسی وویل: «په یقین سره زه تاسو ته دا وایم هرچا چې زما او زما د زېري د رسولو په خاطر خپل کور یا خپل ورونه یا خویندې یا مور او پلار یا خپل اولادونه یا خپلې ځمکې پریښي وي،"}, {"ref": "Mark 1:29", "text": "عیسی ځواب ورکړ: «زه هم ستاسو څخه یوه پوښتنه کوم او که تاسو ځواب راکړ، نو زه به هم درته ووایم چې زه په کوم اختیار سره دا کارونه کوم."}, {"ref": "Mark 1:29", "text": "عیسی ځواب ورکړ: «تر ټولو مهم حکم دا دی: ‹ای د اسراییلو خلکو، واورئ! یوازېنی خدای چې وجود لري هغه زمونږ څښتن خدای دی.›"}, {"ref": "Mark 1:29", "text": "په همدې ډول کله چې تاسو دا شیان ووینئ، نو پوه شئ چې هغه وخت نژدې دی بلکې رارسېدلی دی."}, {"ref": "Mark 1:29", "text": "پطروس عیسی ته وویل: «حتی که ټول تا پرېږدي، خو زه به دې هېڅکله هم پرېنږدم.»"}, {"ref": "Mark 1:29", "text": "څوک چې په لاره تېرېدل، نو خپل سرونه به یې خوځول، عیسی ته به یې ښکنځلې کولې او ویل به یې: «واه، تا غوښتل چې د خدای کور وران کړې او په درې ورځو کې یې بېرته جوړ کړې،"}, {"ref": "Mark 1:30", "text": "په دې نړۍ کې به اوس هغوی سل چنده لاسته راوړي. هغوی به سل چنده نور کورونه، ورونه، خویندې، میندې، اولادونه او ځمکې لاسته راوړي او د دې تر‌څنګ به وځوریږي او په اخرت کې به تلپاتې ژوندون ومومي."}, {"ref": "Mark 1:30", "text": "د یحیی د تعمید ورکول د خدای له خوا ؤ یا د انسان له خوا؟ ځواب راکړئ.»"}, {"ref": "Mark 1:30", "text": "د خپل څښتن خدای سره د زړه له کومي، په خپل ټول روح، خپل ټول عقل او خپل ټول قوت سره مینه کوه."}, {"ref": "Mark 1:30", "text": "په یقین سره زه تاسو ته دا وایم چې دا نسل به تر هغې پورې له منځه لاړ نه شي، ترڅو دا ټولې پېښې رامنځته شوې نه وي."}, {"ref": "Mark 1:30", "text": "عیسی پطروس ته وویل: «په یقین سره زه تاته دا وایم چې همدا نن شپه به مخکې له دې چې چرګ دوه ځلې اذان وکړي، ته به درې ځلې ووایې چې ما نه پېژنې.»"}, {"ref": "Mark 1:30", "text": "اوس خپل ځان وژغوره او د صلیب څخه راښکته شه.»"}, {"ref": "Mark 1:31", "text": "خو ډېر چې اوس اول دي هغوی به اخر شي او ډېر چې اوس اخر دي هغوی به اول شي.» عیسی د درېم ځل دپاره د خپل مرګ په هکله پېشګویي کوي (متي ۲۰‏:‌۱۷‌‏-‌۱۹ او لوقا ۱۸‏:‌۳۱‌‏-‌۳۴)"}, {"ref": "Mark 1:31", "text": "هغوی په خپل منځ کې سره بحث وکړ او ویل یې: «که چېرې ووایو چې د خدای له خوا ؤ، نو هغه به ووایي چې بیا تاسو ولې په هغه باندې ایمان رانه وړ؟"}, {"ref": "Mark 1:31", "text": "دوهم حکم دا دی: ‹د خپل ګاونډي سره د خپل ځان په شان مینه کوه.› د دې حکمونو څخه بل لوی حکم نشته.»"}, {"ref": "Mark 1:31", "text": "ځمکه او اسمان به له منځه لاړ شي، خو زما خبرې به هېڅکله له منځه لاړې نه شي. نامعلومه ورځ او وخت (متي ۲۴‏:‌۳۶‌‏-‌۴۴)"}, {"ref": "Mark 1:31", "text": "خو پطروس په ټینګه وویل: «که زه تا سره مړ هم شم، خو هېڅکله به ونه وایم چې تا نه پېژنم.» او نورو ټولو شاګردانو هم همداسې وویل. عیسی په جتسیماني کې دعا کوي (متي ۲۶‏:‌۳۶‌‏-‌۴۶ او لوقا ۲۲‏:‌۳۹‌‏-‌۴۶)"}, {"ref": "Mark 1:31", "text": "همدارنګه مشرانو کاهنانو او د شریعت عالمانو په خپل منځ کې په هغه باندې ملنډې وهلې او ویل یې: «هغه نور خلک ژغورل، خو خپل ځان نه شي ژغورلی."}, {"ref": "Mark 1:32", "text": "عیسی د خپلو دولسو شاګردانو سره د اورشلیم په لاره روان ؤ او هغه د شاګردانو څخه مخکې روان ؤ. شاګردان حیران پاتې وو او کوم خلک چې په هغوی پسې روان وو وېرېدل. عیسی یوځل بیا خپل دولس شاګردان ګوښه کړل او ورته ویې ویل چې په هغه باندې به کومه پېښه کیږي."}, {"ref": "Mark 1:32", "text": "خو که ووایو چې د انسان له خوا ؤ، نو بیا به څه وشي؟» (هغوی د خلکو څخه وېرېدل، ځکه چې ټولو خلکو یحیی پیغمبر ګڼلو.)"}, {"ref": "Mark 1:32", "text": "د شریعت هغه عالم عیسی ته وویل: «استاذه، تا ښه وویل، تا رښتیا وویل چې خدای یو دی او له هغه پرته بل خدای نشته."}, {"ref": "Mark 1:32", "text": "خو د هغې ورځې او هغه ساعت نه هېڅوک خبر نه دي، نه د اسمان فرښتې او نه زوی، یوازې پلار پرې خبر دی."}, {"ref": "Mark 1:32", "text": "هغوی د جتسیماني په نوم یو ځای ته ورسېدل، نو عیسی خپلو شاګردانو ته وویل: «تاسو دلته کښېنئ او زه دعا کوم.»"}, {"ref": "Mark 1:32", "text": "پرېږدئ چې مسیح د اسراییلو پاچا اوس د صلیب څخه راښکته شي، ترڅو مونږ هغه ووینو او ایمان ورباندې راوړو.» هغو دوو کسانو چې د عیسی سره په صلیب ځوړند کړای شوي وو هم هغه ته ښکنځلې کولې. د عیسی مړینه (متي ۲۷‏:‌۴۵‌‏-‌۵۶ او لوقا ۲۳‏:‌۴۴‌‏-‌۴۹ او یوحنا ۱۹‏:‌۲۸‌‏-‌۳۰)"}, {"ref": "Mark 1:33", "text": "او هغوی ته یې وویل: «ګورئ، مونږ اوس اورشلیم ته ځو او د انسان زوی به مشرانو کاهنانو او د شریعت عالمانو ته په لاس ورکړل شي. هغوی به ورباندې د مرګ حکم وکړي او غیریهودیانو ته به یې وسپاري."}, {"ref": "Mark 1:33", "text": "نو هغوی عیسی ته په ځواب کې وویل: «مونږ نه پوهېږو.» عیسی ورته وویل: «نو زه هم تاسو ته نه وایم چې په کوم اختیار دا کارونه کوم.»"}, {"ref": "Mark 1:33", "text": "د خدای سره د زړه له کومي، ټولې پوهې او په ټول قوت سره مینه کول او د خپل ځان په شان د خپل ګاونډي سره مینه کول د ټولو سوځېدونکو نذرانو او قربانیو څخه ډېر مهم دي.»"}, {"ref": "Mark 1:33", "text": "پام کوئ او بېداره اوسئ، ځکه چې تاسو نه پوهېږئ چې هغه وخت به کله راځي."}, {"ref": "Mark 1:33", "text": "بیا هغه پطروس، یعقوب او یوحنا د ځان سره بوتلل. عیسی ډېر غمجن شو او زړه یې تنګ شو،"}, {"ref": "Mark 1:33", "text": "د غرمې د دولسو بجو څخه د ماسپښین تر درې بجو پورې په ټول وطن کې تیاره راخپره شوه"}, {"ref": "Mark 1:34", "text": "هغوی به په هغه باندې ملنډې ووهي، لاړې به ورتو کړي، په دورو به یې ووهي او وبه یې وژني، خو درې ورځې وروسته به بیا راژوندی شي.» د یعقوب او یوحنا غوښتنه (متي ۲۰‏:‌۲۰‌‏-‌۲۸)"}, {"ref": "Mark 1:34", "text": "کله چې عیسی ولیدل چې هغه په هوښیارۍ سره ځواب ورکړ، نو هغه ته یې وویل: «ته د خدای له پاچاهۍ څخه لېرې نه یې.» له هغې وروسته بیا هېچا دا جرات ونه کړ چې له عیسی څخه نورې پوښتنې وکړي. مسیح د داود نه لوی دی (متي ۲۲‏:‌۴۱‌‏-‌۴۶ او لوقا ۲۰‏:‌۴۱‌‏-‌۴۴)"}, {"ref": "Mark 1:34", "text": "دا د هغه سړي په مثال دی چې د کور نه په سفر روان شي او خپلو نوکرانو ته اختیار ورکړي چې هر یو دې خپل کار وکړي او د دروازې ساتونکي ته حکم وکړي چې بېدار اوسي."}, {"ref": "Mark 1:34", "text": "او هغوی ته یې وویل: «زما زړه له غمه چوي او مرګ ته نژدې یم. دلته پاتې شئ او بېداره اوسئ.»"}, {"ref": "Mark 1:34", "text": "او درې بجې عیسی په لوړ اواز چیغه کړه: «ایلي، ایلي، لما‌سبقتني؟» چې معنی یې ده: «ای زما خدایه، ای زما خدایه، زه دې ولې پرېښودم؟»"}, {"ref": "Mark 1:35", "text": "بیا د زبدي زامن یعقوب او یوحنا عیسی ته راغلل او ورته ویې ویل: «استاذه، مونږ چې ستا څخه کوم څه غواړو هغه زمونږ دپاره وکړه.»"}, {"ref": "Mark 1:35", "text": "کله چې عیسی د خدای په کور کې تعلیم ورکاوه، نو ویې ویل: «د شریعت عالمان څنګه کولای شي ووایي چې مسیح د داود زوی دی؟"}, {"ref": "Mark 1:35", "text": "نو تاسو هم بېداره اوسئ، ځکه چې تاسو نه پوهېږئ چې د کور خاوند به کله راځي، ماښام یا په نیمه شپه کې، په چرګ بانګ یا د لمرخاته په وخت کې،"}, {"ref": "Mark 1:35", "text": "عیسی لږ لېرې لاړ او په ځمکه پرېوت او دعا یې وکړه چې که چېرې کېدای شي، نو دا د کړاو ساعت دې زما څخه تېر شي."}, {"ref": "Mark 1:35", "text": "ځینې خلک چې هلته نژدې ولاړ وو دا یې واورېدل او ویې ویل: «ګورئ، هغه الیاس نبي ته نارې وهې.»"}, {"ref": "Mark 1:36", "text": "عیسی د هغوی څخه پوښتنه وکړه: «زما څخه څه غواړئ چې درته ویې کړم؟»"}, {"ref": "Mark 1:36", "text": "داود په خپله د روح القدس په وسیله ویلي دي: څښتن وویل زما بادار ته کښېنه زما ښي لاس ته ترڅو چې ستا دښمنان ستا د پښو لاندې کړم."}, {"ref": "Mark 1:36", "text": "هسې نه چې هغه ناڅاپه راشي او تاسو په خوب ویده وویني."}, {"ref": "Mark 1:36", "text": "هغه وویل: «ابا، یعنې ای پلاره! ستا دپاره هرڅه ممکن دي. دا پیاله زما څخه لېرې کړه، خو زما رضا نه بلکې لکه څنګه چې ستا رضا وي.»"}, {"ref": "Mark 1:36", "text": "د هغوی څخه یو کس منډه کړه او یو اسفنج یې په تروو شرابو کې لوند کړ او هغه یې د لرګي په سر کېښود او عیسی ته یې ورکړ چې ویې څښي او ویې ویل: «صبر وکړئ. پرېږدئ ووینو چې ایا الیاس نبي راځي یا نه، چې هغه د صلیب څخه راښکته کړي.»"}, {"ref": "Mark 1:37", "text": "هغوی ورته وویل: «کله چې ته د خپل جلال څخه ډکې پاچاهۍ په تخت باندې کښېنې، نو مونږ ته اجازه راکړه چې یو ستا ښي لاس ته او بل دې چپ لاس ته کښېنو.»"}, {"ref": "Mark 1:37", "text": "داود په خپله مسیح ته څښتن وایي، نو بیا څنګه کېدای شي چې مسیح د داود زوی وي؟» ګڼ شمېر خلکو په شوق سره د هغه خبرې اورېدلې. د شریعت د عالمانو په خلاف خبرداری (متي ۲۳‏:‌۱‌‏-‌۳۶ او لوقا ۲۰‏:‌۴۵‌‏-‌۴۷)"}, {"ref": "Mark 1:37", "text": "زه چې تاسو ته څه وایم، نو هغه ټولو ته وایم: بېداره اوسئ.»"}, {"ref": "Mark 1:37", "text": "بیا عیسی بېرته شاګردانو ته راغی او ویې لیدل چې هغوی ویده دي. نو پطروس ته یې وویل: «ای شمعونه، ویده یې؟ ایا یو ساعت هم ویښ نه شوې پاتې کېدلی؟"}, {"ref": "Mark 1:37", "text": "بیا عیسی یوه چیغه ووهله او ساه یې ورکړه."}, {"ref": "Mark 1:38", "text": "عیسی هغوی ته وویل: «تاسو نه پوهېږئ چې څه غواړئ. کومه پیاله چې زه یې څښم، تاسو هغه څښلی شئ او یا د تعمید کوم غسل چې ماته راکول کیږي تاسو یې اخیستلی شئ؟»"}, {"ref": "Mark 1:38", "text": "عیسی د تعلیم ورکولو په وخت کې وویل: «د شریعت د عالمانو څخه ځان ساتئ. هغوی دا خوښوي چې په اوږدو چپنو کې وګرځي او په بازارونو کې ورته خلک سلام واچوي"}, {"ref": "Mark 1:38", "text": "بېداره اوسئ او دعا وکړئ چې د وسوسو سره مخامخ نه شئ، زړه غواړي خو بدن کمزوری دی.»"}, {"ref": "Mark 1:38", "text": "د خدای د کور پرده د سر نه تر بېخه پورې وشکېدله او دوه ټوټې شوه."}, {"ref": "Mark 1:39", "text": "هغوی ځواب ورکړ: «هو، مونږ یې کولای شو.» عیسی هغوی ته وویل: «کومه پیاله چې زه څښم، تاسو به یې وڅښئ او د تعمید کوم غسل چې زه یې اخلم، تاسو به یې هم اخلئ."}, {"ref": "Mark 1:39", "text": "او په کنیسو کې په مخکې ځایونو او په مېلمستیاوو کې په لوړو ځایونو کې کښېني."}, {"ref": "Mark 1:39", "text": "عیسی یوځل بیا لاړ او هماغه دعا یې وکړه."}, {"ref": "Mark 1:39", "text": "کله چې هغه رومي منصبدار چې عیسی ته مخامخ ولاړ ؤ ولیدل چې هغه څنګه ساه ورکړه، نو ویې ویل: «دا سړی په رښتیا د خدای زوی ؤ.»"}, {"ref": "Mark 1:40", "text": "خو دا زما په اختیار کې نه ده چې څوک به زما ښي یا چپ لاس ته کښېني. دا ځایونه د هغو خلکو دپاره دي چې له مخکې نه ورته تیار شوي دي.»"}, {"ref": "Mark 1:40", "text": "هغوی د کونډو مالونه خوري او د ځان ښودنې دپاره اوږدې اوږدې دعاګانې کوي. د داسې خلکو سزا به د نورو نه سخته وي.» د یوې کونډې ښځې نذرانه (لوقا ۲۱‏:‌۱‌‏-‌۴)"}, {"ref": "Mark 1:40", "text": "کله چې هغه بېرته راغی، نو هغوی یې بیا په خوب ویده ولیدل، ځکه چې د هغوی سترګې له خوبه ډکې وې او په دې نه پوهېدل چې هغه ته څه ووایي."}, {"ref": "Mark 1:40", "text": "په هغه ځای کې یو څو ښځې هم وې چې د لېرې نه یې کتل. په هغوی کې مریم چې د مجدلیې د ښار څخه وه او مریم د کشر یعقوب، یوشا او سالومې مور وه."}, {"ref": "Mark 1:41", "text": "کله چې نور لس شاګردان له دې نه خبر شول، نو د یعقوب او یوحنا څخه خفه شول."}, {"ref": "Mark 1:41", "text": "عیسی د خدای د کور خزانې ته مخامخ ناست ؤ او کتل یې چې خلکو څنګه په هغې کې پیسې اچولې. ډېرو شتمنو خلکو زیاتې پیسې واچولې."}, {"ref": "Mark 1:41", "text": "کله چې هغه د درېم ځل دپاره راغی، نو هغوی ته یې وویل: «تاسو لا ویده یئ او ارام کوئ؟ بس دی. هغه ساعت رارسېدلی دی چې د انسان زوی به ګناهکارانو ته په لاس ورکول کیږي."}, {"ref": "Mark 1:41", "text": "کوم وخت چې عیسی په جلیل کې ؤ، نو دا ښځې ورسره ملګرې وې او خدمت یې ورته کاوه. ډېرې نورې ښځې چې د هغه سره اورشلیم ته راغلې وې هم په هغه ځای کې وې. د عیسی ښخول (متي ۲۷‏:‌۵۷‌‏-‌۶۱ او لوقا ۲۳‏:‌۵۰‌‏-‌۵۶ او یوحنا ۱۹‏:‌۳۸‌‏-‌۴۲)"}, {"ref": "Mark 1:42", "text": "نو عیسی هغوی راوغوښتل او ورته ویې ویل: «تاسو پوهېږئ چې کوم خلک چې د غیریهودیانو حاکمان ګڼل کیږي، هغوی په خپلو خلکو باندې باداري کوي او مشران یې ورته خپل زور ښایي."}, {"ref": "Mark 1:42", "text": "بیا یوه غریبه کونډه ښځه راغله او دوه سکې چې شاوخوا دوه روپۍ کېدلې په کې واچولې."}, {"ref": "Mark 1:42", "text": "پاڅېږئ، راځئ چې ځو، هغه څوک چې غواړي زما سره خیانت وکړي، رارسېدلی دی.» د عیسی سره خیانت او د هغه نیول (متي ۲۶‏:‌۴۷‌‏-‌۵۶ او لوقا ۲۲‏:‌۴۷‌‏-‌۵۳ او یوحنا ۱۸‏:‌۳‌‏-‌۱۲)"}, {"ref": "Mark 1:42", "text": "دا د جمعې ورځ وه یعنې د سبت څخه یوه ورځ مخکې د اختر دپاره د تیاري نیولو ورځ وه. څنګه چې ماښام شو،"}, {"ref": "Mark 1:43", "text": "خو په تاسو کې دې داسې نه وي، که په تاسو کې څوک غواړي چې تر ټولو لوی وګڼل شي نو هغه دې ستاسو ټولو خدمتګار شي"}, {"ref": "Mark 1:43", "text": "عیسی خپل شاګردان راوغوښتل او ورته ویې ویل: «په یقین سره زه تاسو ته دا وایم چې دې غریبې کونډې د خدای د کور په خزانه کې د نورو ټولو نه زیاتې پیسې واچولې."}, {"ref": "Mark 1:43", "text": "عیسی لا خبرې کولې چې سمدلاسه یهودا چې د هغو دولسو شاګردانو څخه ؤ، د یوې ډلې خلکو سره چې تورې او کوتکونه ورسره وو، راورسېد. هغه د مشرانو کاهنانو، د شریعت د عالمانو او قومي مشرانو له خوا رالېږل شوی ؤ."}, {"ref": "Mark 1:43", "text": "یوسف چې د رامه د ښار څخه ؤ او د شورا یو عزتمن غړی ؤ او د خدای د پاچاهۍ د راتللو انتظار یې کاوه، په زړورتیا سره پیلاتوس ته ورغی او د عیسی مړی یې ترې وغوښت."}, {"ref": "Mark 1:44", "text": "او په تاسو کې چې څوک غواړي مشر شي، نو هغه باید ستاسو ټولو خدمتګار شي."}, {"ref": "Mark 1:44", "text": "ځکه چې هغوی ټولو هغه پیسې واچولې چې د هغوی د اړتیاوو څخه زیاتې وې، خو سره له دې چې هغه غریبه وه نو څه چې یې لرل او هرڅه چې هغې ورباندې خپل ژوند تېراوه، هغه یې ورکړل.»"}, {"ref": "Mark 1:44", "text": "هغه خاین هغوی ته یوه نښه ورکړې وه او ورته ویلي یې وو: «څوک چې زه ښکل کړم، نو دا هماغه سړی دی. هغه ونیسئ او تر پوره څارنې لاندې یې بوځئ.»"}, {"ref": "Mark 1:44", "text": "کله چې پیلاتوس خبر شو چې عیسی مړ شوی دی، نو هغه حیران شو. هغه عسکري منصبدار یې راوغوښت او پوښتنه یې ترې وکړه: «ایا هغه مړ شوی دی؟»"}, {"ref": "Mark 1:45", "text": "ځکه چې د انسان زوی د دې دپاره نه دی راغلی چې خدمت یې وشي بلکې د نورو خدمت وکړي او خپل ژوند د ډېرو خلکو دپاره قربان کړي.» عیسی بارتیماوس بینا کوي (متي ۲۰‏:‌۲۹‌‏-‌۳۴ او لوقا ۱۸‏:‌۳۵‌‏-‌۴۳)"}, {"ref": "Mark 1:45", "text": "کله چې یهودا راورسېد، نو سمدلاسه عیسی ته ورغی او ورته ویې ویل: «استاذه!» او هغه یې ښکل کړ."}, {"ref": "Mark 1:45", "text": "کله چې پیلاتوس د هغه منصبدار له خوا خبر شو چې عیسی وخته مړ شوی دی، نو یوسف ته یې اجازه ورکړه چې مړی یوسي."}, {"ref": "Mark 1:46", "text": "بیا هغوی د اریحا ښار ته راغلل او کله چې عیسی د خپلو شاګردانو او ګڼ شمېر خلکو سره د ښار څخه وتلو، نو یو ړوند سوالګر چې بارتیماوس نومېده او د تیماوس زوی ؤ د سرک په غاړه ناست ؤ."}, {"ref": "Mark 1:46", "text": "نو هغوی عیسی ته لاس ورواچاوه او هغه یې ونیوه."}, {"ref": "Mark 1:46", "text": "نو یوسف د کتان کفن راواخیست، د عیسی مړی یې د صلیب څخه راښکته کړ، په هغه کې یې تاو کړ او په یو قبر کې چې په یو ګټ کې کیندل شوی ؤ کېښود. بیا یې یوه غټه تیږه د غار خولې ته راورغړوله."}, {"ref": "Mark 1:47", "text": "کله چې هغه خبر شو چې دا ناصري عیسی دی، نو په چیغو وهلو یې پیل وکړ: «ای عیسی، د داود زویه! په ما باندې رحم وکړه.»"}, {"ref": "Mark 1:47", "text": "بیا د هغو کسانو څخه چې هلته ولاړ وو یو یې توره راوویستله او د لوی کاهن په نوکر یې ګوزار وکړ او د هغه غوږ یې پرې کړ."}, {"ref": "Mark 1:47", "text": "مریم مجدلیې او د یوشا مور مریم ولیدل چې د عیسی مړی یې په کوم ځای کې ایښی دی."}, {"ref": "Mark 1:48", "text": "ډېرو خلکو هغه ورټلو او ورته ویې ویل چې غلی شه، خو هغه نورې هم چیغې وهلې: «ای د داود زویه، په ما باندې رحم وکړه.»"}, {"ref": "Mark 1:48", "text": "بیا عیسی هغوی ته وویل: «ایا زه کوم داړه مار یم چې د تورو او کوتکونو سره زما د نیولو دپاره راغلي یئ؟"}, {"ref": "Mark 1:49", "text": "عیسی ودرېده او ویې ویل: «هغه ته غږ وکړئ چې راشي.» هغوی هغه ړوند سړي ته غږ وکړ او ورته ویې ویل: «خوشحاله اوسه، پاڅېږه، هغه دې غواړي.»"}, {"ref": "Mark 1:49", "text": "زه هره ورځ ستاسو سره د خدای په کور کې وم او تعلیم به مې ورکاوه او تاسو زه ونه نیولم، خو د خدای کلام چې څه وایي هغه باید پوره شي.»"}, {"ref": "Mark 1:50", "text": "نو هغه خپله چپنه یوې خواته وغورځوله، د خپل ځای څخه راپورته شو او عیسی ته راغی."}, {"ref": "Mark 1:50", "text": "بیا ټولو شاګردانو هغه پرېښود او وتښتېدل."}, {"ref": "Mark 1:51", "text": "عیسی هغه ته وویل: «زما څخه څه غواړې چې درته ویې کړم؟» هغه ړوند سړي ځواب ورکړ: «زما استاذه، زه غواړم چې بېرته بینا شم.»"}, {"ref": "Mark 1:51", "text": "په دې وخت کې یو ځوان چې د کتان یوه ټوټه یې د ځان څخه تاوه کړې وه، د عیسی پسې روان شو. هغوی هغه هم ونیوه،"}, {"ref": "Mark 1:52", "text": "عیسی هغه ته وویل: «ځه، ته خپل ایمان روغ کړې.» نو سمدلاسه هغه بینا شو او په عیسی پسې روان شو."}, {"ref": "Mark 1:52", "text": "خو هغه خپل کالي پرېښودل او لوڅ وتښتېده. د یهودیانو د شورا له خوا د عیسی محاکمه (متي ۲۶‏:‌۵۷‌‏-‌۶۸ او لوقا ۲۲‏:‌۵۴‌‏-‌۵۵،‌۶۳‌‏-‌۷۱ او یوحنا ۱۸‏:‌۱۳‌‏-‌۱۴،‌۱۹‌‏-‌۲۴)"}, {"ref": "Mark 1:53", "text": "هغوی عیسی لوی کاهن ته بوتو او هلته مشران کاهنان، قومي مشران او د شریعت عالمان سره راټول شوي وو."}, {"ref": "Mark 1:54", "text": "پطروس د لوی کاهن تر حوېلۍ پورې په هغه پسې شاته شاته روان ؤ او دننه ورغی او هلته د ساتونکو سره کښېناست او اور ته یې ځان تودولو."}, {"ref": "Mark 1:55", "text": "مشرانو کاهنانو او ټولې شورا هڅه کوله چې د عیسی په خلاف کوم ثبوت پیدا کړي ترڅو هغه ووژل شي، خو هغوی کوم ثبوت پیدا نه کړ."}, {"ref": "Mark 1:56", "text": "ډېرو خلکو د هغه په خلاف په دروغو شاهدي ورکړه، خو د هغوی شهادت د یو بل سره یوشان نه ؤ."}, {"ref": "Mark 1:57", "text": "بیا ځینې خلک پاڅېدل او د هغه په خلاف یې داسې د دروغو شاهدي ورکړه:"}, {"ref": "Mark 1:58", "text": "«مونږ د هغه د خولې نه واورېدل چې ویې ویل: زه به دا د خدای کور چې د انسانانو په لاس جوړ شوی دی ورانوم او په درې ورځو کې به بل داسې کور جوړ کړم چې هغه به د انسانانو په لاسونو نه وي جوړ شوی.»"}, {"ref": "Mark 1:59", "text": "خو بیاهم د دې خلکو شاهدي سره یوشان نه وه."}, {"ref": "Mark 1:60", "text": "بیا لوی کاهن د هغوی ټولو په مخکې ودرېده او د عیسی څخه یې پوښتنه وکړه: «ایا ته دې تورونو ته چې هغوی یې درباندې لګوي، ځواب نه ورکوې؟»"}, {"ref": "Mark 1:61", "text": "خو عیسی غلی پاتې شو او هېڅ ځواب یې ورنه کړ. یوځل بیا لوی کاهن ترې پوښتنه وکړه: «ایا ته مسیح، د مبارک خدای زوی یې؟»"}, {"ref": "Mark 1:62", "text": "عیسی وویل: «هو، زه یم او تاسو به د انسان زوی ووینئ چې د مطلق قادر خدای ښي لاس ته ناست وي او د اسمان په ورېځو کې به راروان وي.»"}, {"ref": "Mark 1:63", "text": "لوی کاهن خپل کالي وشکول او ویې ویل: «مونږ نورو شاهدانو ته څه اړتیا لرو؟"}, {"ref": "Mark 1:64", "text": "تاسو دا کفر ویل واورېدل. ستاسو پرېکړه څه ده؟» نو هغوی ټولو هغه محکوم کړ او ویې ویل چې هغه د مرګ لایق دی."}, {"ref": "Mark 1:65", "text": "ځینو خلکو ورباندې لاړې ورتو کړې او سترګې یې ورته وتړلې او په سوکانو یې واهه او ورته ویل یې: «اوس له غیبو ووایه چې ته چا ووهلې.» بیا ساتونکو هغه ونیوه او ویې واهه. پطروس له عیسی څخه انکار کوي (متي ۲۶‏:‌۶۹‌‏-‌۷۵ او لوقا ۲۲‏:‌۵۶‌‏-‌۶۲ او یوحنا ۱۸‏:‌۱۵‌‏-‌۱۸،‌۲۵‌‏-‌۲۷)"}, {"ref": "Mark 1:66", "text": "په دې وخت کې پطروس لاندې په حوېلۍ کې ؤ چې د لوی کاهن یوه وینځه راغله"}, {"ref": "Mark 1:67", "text": "او ویې لیدل چې پطروس اور ته خپل ځان تودوي، نو هغې ورته په ځیر سره وکتل او ویې ویل: «ته هم د عیسی ناصري سره وې.»"}, {"ref": "Mark 1:68", "text": "خو هغه منکر شو او ویې ویل: «زه هغه نه پېژنم او نه پوهېږم چې ته څه وایې.» بیا هغه دباندې دالان ته ووت او په هماغه وخت کې چرګ اذان وکړ."}, {"ref": "Mark 1:69", "text": "هغې وینځې پطروس هلته ولیده او په هغه ځای کې ولاړو خلکو ته یې بیا وویل: «دا هم د هغوی د ډلې څخه دی.»"}, {"ref": "Mark 1:70", "text": "خو پطروس بیا منکر شو. لږه شېبه وروسته حاضرو خلکو یوځل بیا پطروس ته وویل: «بې له شکه چې ته د هغوی د ډلې څخه یې، ځکه چې ته هم جلیلي یې.»"}, {"ref": "Mark 1:71", "text": "خو پطروس قسم وخوړ: «که زه دروغ وایم، نو په ما دې د خدای لعنت وي، تاسو چې د کوم سړي په هکله خبرې کوئ زه هغه نه پېژنم.»"}, {"ref": "Mark 1:72", "text": "او سمدلاسه د دوهم ځل دپاره چرګ اذان وکړ. او پطروس ته ور په یاد شول چې عیسی ورته ویلي وو: «مخکې له دې چې چرګ دوه ځلې اذان وکړي، نو ته به درې ځلې ووایې چې زه هغه نه پېژنم.» د هغه زړه مات شو او په ژړا شو."}, {"ref": "Matthew 1:1", "text": "عیسی خپل دولس شاګردان راوغوښتل او هغوی ته یې د پېریانو د ویستلو او د هر ډول ناروغیو او کمزورتیاوو د روغولو اختیار ورکړ."}, {"ref": "Matthew 1:1", "text": "کله چې عیسی خپلو دولسو شاګردانو ته دا لارښوونې وکړې، نو له هغه ځای نه روان شو چې د هغې سیمې په نورو ښارونو کې تعلیم ورکړي او وعظ وکړي."}, {"ref": "Matthew 1:1", "text": "په هغه وخت کې عیسی د سبت په یوه ورځ د غنمو په پټیو تېرېده، د هغه شاګردان وږي شوي وو نو هغوی د غنمو د وږو په شکولو او خوړلو پیل وکړ."}, {"ref": "Matthew 1:1", "text": "په هماغه ورځ عیسی د کور څخه ووت او د بحیرې غاړې ته لاړ او هلته کښېناست."}, {"ref": "Matthew 1:1", "text": "په دې وخت کې د جلیل والي هیرودیس د عیسی د کارونو څخه خبر شو."}, {"ref": "Matthew 1:1", "text": "وروسته ځینې فریسیان او د شریعت عالمان د اورشلیم څخه عیسی ته راغلل او د هغه څخه یې پوښتنه وکړه:"}, {"ref": "Matthew 1:1", "text": "فریسیان او صدوقیان عیسی ته راغلل چې هغه وازمایي، نو د هغه نه یې وغوښتل چې دوی ته یوه اسماني معجزه وښایي."}, {"ref": "Matthew 1:1", "text": "شپږ ورځې وروسته عیسی پطروس، یعقوب او د یعقوب ورور یوحنا د ځان سره واخیستل او یو لوړ غره ته یې بوتلل چې هلته یوازې اوسي."}, {"ref": "Matthew 1:1", "text": "په دې وخت کې شاګردان عیسی ته راغلل او پوښتنه یې ترې وکړه: «په اسماني پاچاهۍ کې د ټولو نه لوی څوک دی؟»"}, {"ref": "Matthew 1:1", "text": "کله چې عیسی دا خبرې خلاصې کړې، نو د جلیل څخه روان شو او د یهودیې سیمې ته چې د اردن د سیند په بله غاړه پرته وه لاړ."}, {"ref": "Matthew 1:2", "text": "د هغو دولسو رسولانو نومونه دا دي: لومړنی شمعون چې په پطروس مشهور ؤ او ورور یې اندریاس، یعقوب د زبدي زوی او د هغه ورور یوحنا،"}, {"ref": "Matthew 1:2", "text": "کله چې یحیی په زندان کې د مسیح د کارونو څخه خبر شو، نو خپل څو شاګردان یې هغه ته ورولېږل"}, {"ref": "Matthew 1:2", "text": "خو کله چې فریسیانو دا ولیدل، نو عیسی ته یې وویل: «ګوره! ستا شاګردان داسې کار کوي چې د سبت په ورځ ناروا دی.»"}, {"ref": "Matthew 1:2", "text": "دومره ډېر خلک ورته راټول شول چې هغه ترې کشتۍ ته وخوت او کښېناست او ټول خلک ورته د بحیرې په غاړه ولاړ وو."}, {"ref": "Matthew 1:2", "text": "نو خپلو کسانو ته یې وویل: «دا سړی هماغه تعمید ورکوونکی یحیی دی. هغه بېرته د مرګ نه راژوندی شوی دی، نو له دې امله هغه دا قدرت لري چې معجزې وښایي.»"}, {"ref": "Matthew 1:2", "text": "«ستا شاګردان ولې زمونږ د نیکونو په رواجونو عمل نه کوي او د ډوډۍ خوړلو څخه مخکې خپل لاسونه نه وینځي؟»"}, {"ref": "Matthew 1:2", "text": "عیسی په ځواب کې وویل: «کله چې ماښام شي، نو تاسو وایئ چې هوا به ښه وي، ځکه چې اسمان سور دی"}, {"ref": "Matthew 1:2", "text": "د هغوی په مخکې د هغه څېره بدله شوه او مخ یې لکه د لمر په شان ځلېده او کالي یې د رڼا په شان سپین شول."}, {"ref": "Matthew 1:2", "text": "عیسی یو ماشوم راوغوښت او د خلکو په منځ کې یې ودراوه،"}, {"ref": "Matthew 1:2", "text": "ګڼ شمېر خلک ورپسې روان وو او عیسی هلته هغوی ته شفا ورکړه."}, {"ref": "Matthew 1:3", "text": "فیلیپوس او بارتولما، توما او مالیه ټولوونکی متي، یعقوب د حلفي زوی او تدي،"}, {"ref": "Matthew 1:3", "text": "چې د هغه څخه پوښتنه وکړي: «ایا ته هغه څوک یې چې باید راغلی وای یا د کوم بل چا په تمه واوسو؟»"}, {"ref": "Matthew 1:3", "text": "عیسی ځواب ورکړ: «ایا تاسو دا نه دي لوستلي کله چې داود او د هغه ملګري وږي وو، نو هغه څه وکړل؟"}, {"ref": "Matthew 1:3", "text": "هغوی ته یې په مثالونو کې ډېر شیان وویل. هغه وویل: «یو بزګر د تخم شیندلو دپاره پټي ته لاړ."}, {"ref": "Matthew 1:3", "text": "هیرودیس د خپل ورور فیلیپوس د ښځې هیرودیا په خاطر یحیی نیولی ؤ، په زنځیرونو یې تړلی ؤ او په زندان کې یې اچولی ؤ."}, {"ref": "Matthew 1:3", "text": "عیسی په ځواب کې وویل: «تاسو ولې د خپل رواج په خاطر د خدای حکم ماتوئ؟"}, {"ref": "Matthew 1:3", "text": "او د سهار په وخت کې کله چې اسمان سور او په ورېځو کې پټ وي، نو تاسو وایئ چې نن به باران وشي. تاسو اسمان ته په کتلو سره کولای شئ چې د هوا د حالت پېشګویي وکړئ، خو د دې زمانې د نښو په معنی نه پوهېږئ."}, {"ref": "Matthew 1:3", "text": "بیا ناڅاپه شاګردانو ته موسی او الیاس ښکاره شول چې د عیسی سره یې خبرې کولې."}, {"ref": "Matthew 1:3", "text": "او ویې ویل: «په یقین سره زه تاسو ته دا وایم چې ترڅو پورې چې تاسو په خپل ځان کې بدلون رانه ولئ او د ماشومانو په شان نه شئ، نو هېڅکله به هم اسماني پاچاهۍ ته وردننه نه شئ."}, {"ref": "Matthew 1:3", "text": "ځینې فریسیان هغه ته راغلل او د دې دپاره چې هغه وازمایي، نو پوښتنه یې ترې وکړه: «ایا دا روا ده چې یو سړی دې خپله ښځه چې په هر دلیل وي طلاقه کړي؟»"}, {"ref": "Matthew 1:4", "text": "شمعون سرتېری او یهودا اسخریوتي چې د عیسی سره یې خیانت وکړ. عیسی خپل دولس رسولان لېږي چې خپل کار سرته ورسوي (مرقوس ۶‏:‌۷‌‏-‌۱۳ او لوقا ۹‏:‌۱‌‏-‌۶)"}, {"ref": "Matthew 1:4", "text": "عیسی هغوی ته په ځواب کې وویل: «لاړ شئ او څه چې تاسو اورئ او وینئ یحیی ته ووایئ"}, {"ref": "Matthew 1:4", "text": "هغه څنګه د خدای کور ته ننوت او د خپلو ملګرو سره یې سپېڅلې ډوډۍ وخوړله، که څه هم د هغوی دپاره د هغې خوړل روا نه وو او یوازې د کاهنانو دپاره روا وو؟"}, {"ref": "Matthew 1:4", "text": "کله چې هغه په خپل پټي کې تخم شینده، نو یو څه تخم ترې په لاره کې ولوېد او مرغان راغلل او هغه یې وخوړ."}, {"ref": "Matthew 1:4", "text": "ځکه چې تعمید ورکوونکي یحیی هیرودیس ته ویلي وو: «تاته روا نه ده چې د خپل ورور د ښځې هیرودیا سره واده وکړې.»"}, {"ref": "Matthew 1:4", "text": "ځکه چې خدای حکم کړی دی: ‹د خپل مور او پلار عزت کوه او هرڅوک چې خپل مور او پلار ته ښکنځلې وکړي، باید ووژل شي.›"}, {"ref": "Matthew 1:4", "text": "د دې زمانې بدکاره او بې‌ایمانه خلک معجزه غواړي، خو یوازېنۍ معجزه چې هغوی ته به وښودل شي هغه د یونس نبي معجزه ده.» بیا عیسی هغوی پرېښودل او لاړ. د فریسیانو او صدوقیانو خمیره (مرقوس ۸‏:‌۱۴‌‏-‌۲۱)"}, {"ref": "Matthew 1:4", "text": "نو پطروس عیسی ته وویل: «استاذه! څومره ښه ده چې مونږ دلته یو. که ته غواړې نو زه به دلته درې خېمې جوړې کړم، یوه تاته، یوه موسی ته او یوه الیاس ته.»"}, {"ref": "Matthew 1:4", "text": "هرڅوک چې خپل ځان د دې ماشوم په شان عاجز کړي، نو په اسماني پاچاهۍ کې به د ټولو نه لوی وي"}, {"ref": "Matthew 1:4", "text": "عیسی په ځواب کې وویل: «ایا تاسو نه دي لوستلي چې په پیل کې چې کله خالق انسانان پیدا کړل، نو هغه یې نر او ښځه پیدا کړل؟"}, {"ref": "Matthew 1:5", "text": "عیسی دا دولس شاګردان د دې لارښوونو سره ولېږل: «د غیریهودیانو هېڅ یوې سیمې ته لاړ نه شئ او د سامریانو هېڅ ښار ته مه ننوځئ."}, {"ref": "Matthew 1:5", "text": "چې څنګه ړانده بینا کیږي، ګوډان کولای شي وګرځي، کوم خلک چې په جذام باندې اخته وو هغه پاک او روغ شوي دي، کاڼه اورېدلی شي، مړي راژوندي کیږي او غریبانو ته زېری ورکول کیږي."}, {"ref": "Matthew 1:5", "text": "او تاسو د موسی په شریعت کې نه دي لوستلي چې کاهنان د خدای په کور کې د کار په کولو سره د سبت قانون ماتوي، خو بیاهم ګناهکار نه ګڼل کیږي؟"}, {"ref": "Matthew 1:5", "text": "څه تخم په داسې ځمکه ولوېده چې تیږې یې لرلې، نو هغه تخم زر راشین شو، ځکه چې خاوره یې کمه وه."}, {"ref": "Matthew 1:5", "text": "هیرودیس غوښتل چې هغه مړ کړي، خو د خلکو څخه وېرېده، ځکه چې خلکو هغه پیغمبر ګڼلو."}, {"ref": "Matthew 1:5", "text": "خو تاسو وایئ، که چېرې څوک خپل مور او پلار ته ووایي چې زه تاسو سره مرسته نه شم کولای، ځکه هغه څه چې ما کولای شول تاسو ته یې درکړم، هغه مې خدای ته نذرانه کړل."}, {"ref": "Matthew 1:5", "text": "کله چې شاګردان د بحیرې بلې غاړې ته پورې وتل، نو دا یې هېر کړل چې د ځان سره ډوډۍ یوسي."}, {"ref": "Matthew 1:5", "text": "هغه لا خبرې کولې چې یوه سپینه ورېځ راخپره شوه او په هغوی باندې یې سیوری وکړ او د ورېځې څخه یو اواز راغی او ویل یې: «دا زما ګران زوی دی چې زه ترې خوشحاله یم. هغه ته غوږ ونیسئ.»"}, {"ref": "Matthew 1:5", "text": "او هرڅوک چې داسې یو ماشوم زما په نوم ومني، نو هغه ما مني. د نورو د وسوسو سبب مه کېږئ (مرقوس ۹‏:‌۴۲‌‏-‌۴۸ او لوقا ۱۷‏:‌۱، ۲)"}, {"ref": "Matthew 1:5", "text": "او خدای وویل: نو له همدې امله سړی خپل مور او پلار پرېږدي او د خپلې ښځې سره یوځای کیږي او دواړه یو بدن شي."}, {"ref": "Matthew 1:6", "text": "خو د هغې په ځای د اسراییلو قوم ته چې د ورک شویو پسونو په شان دي ورشئ"}, {"ref": "Matthew 1:6", "text": "بختور دی هغه څوک چې په ما شک ونه کړي.» یحیی څوک دی"}, {"ref": "Matthew 1:6", "text": "زه تاسو ته وایم چې دلته یو څوک شته چې د خدای د کور څخه هم لوی دی."}, {"ref": "Matthew 1:6", "text": "خو کله چې لمر راوخوت نو هغه بوټي وسوځېدل او وچ شول، ځکه چې ریښې یې ژورې نه وې."}, {"ref": "Matthew 1:6", "text": "خو د هیرودیس د زېږېدنې په مېلمستیا کې د هیرودیا لور د مېلمنو په مخکې داسې نڅا وکړه چې هیرودیس دومره خوشحاله شو،"}, {"ref": "Matthew 1:6", "text": "نو هغه نور مجبور نه دی چې د خپل مور او پلار درناوی وکړي. په دې ډول تاسو د خپل دود او دستور په خاطر د خدای حکم بې‌ارزښته ګڼئ."}, {"ref": "Matthew 1:6", "text": "عیسی هغوی ته وویل: «پام کوئ چې د فریسیانو او صدوقیانو د خمیرې نه به ځانونه ساتئ.»"}, {"ref": "Matthew 1:6", "text": "کله چې شاګردانو دا واورېدل، نو له ډېرې وېرې په ځمکه پړمخې پرېوتل."}, {"ref": "Matthew 1:6", "text": "خو هر هغه څوک چې د دې خلکو څخه چې د ماشوم په شان په ما باندې ایمان لري، د کوم یو د ګناهکارېدلو سبب شي، نو د هغه دپاره به دا ښه وي چې په خپله غاړه کې د ژرندې یو لوی پل واچوي او په یو ژورې بحیرې کې ډوب شي."}, {"ref": "Matthew 1:6", "text": "نو هغوی نور دوه تنه نه بلکې یو تن وي. نو څرنګه چې خدای هغوی سره یوځای کړي دي، انسان باید هغوی سره بېل نه کړي.»"}, {"ref": "Matthew 1:7", "text": "او په لاره کې دا پیغام ورکوئ چې اسماني پاچاهي رانژدې شوې ده."}, {"ref": "Matthew 1:7", "text": "څنګه چې د یحیی شاګردان روان شول، نو عیسی خلکو ته د یحیی په هکله داسې خبرې پیل کړې: «تاسو د څه شي د لیدلو دپاره دښتې ته تللي وئ؟ د یوې لوخې د لیدلو دپاره چې باد خوځوله؟"}, {"ref": "Matthew 1:7", "text": "که چېرې تاسو د خدای د کلام په معنی پوهېدلی چې وایي: ‹زه ستاسو څخه غواړم چې په نورو رحم وکړئ، نه قرباني.› نو تاسو به بې‌ګناه خلک نه ملامتول."}, {"ref": "Matthew 1:7", "text": "څه تخم په اغزو کې ولوېد او اغزي لوی شول او بوټي یې لاندې کړل."}, {"ref": "Matthew 1:7", "text": "چې قسم یې وخوړ چې هغه ترې هرڅه وغواړي نو ورته به یې ورکړي."}, {"ref": "Matthew 1:7", "text": "ای منافقانو، اشعیا نبي په حقه ؤ چې ستاسو په هکله یې پېشګویي وکړه چې خدای وایي:"}, {"ref": "Matthew 1:7", "text": "هغوی په خپل منځ کې سره بحث پیل کړ او ویې ویل: «هغه ځکه دا خبره کوي چې مونږ ډوډۍ نه ده راوړې.»"}, {"ref": "Matthew 1:7", "text": "بیا عیسی هغوی ته ورغی او په هغوی باندې یې لاس کېښود او ورته ویې ویل: «پاڅېږئ، مه وېرېږئ.»"}, {"ref": "Matthew 1:7", "text": "افسوس دې وي په دې نړۍ چې د داسې وسوسو سبب ګرځي. دا وسوسې به خامخا راځي خو افسوس د هغه چا په حال چې د دې وسوسو سبب ګرځي."}, {"ref": "Matthew 1:7", "text": "فریسیانو د عیسی نه پوښتنه وکړه: «نو بیا موسی په دې هکله ولې حکم کړی دی چې یو سړی کولای شي خپلې ښځې ته طلاق‌نامه ورکړي او هغه وشړي؟»"}, {"ref": "Matthew 1:8", "text": "ناروغان روغ کړئ، مړي راژوندي کړئ، په جذام اخته خلک پاک او روغ کړئ او پېریان وباسئ. تاسو ته وړیا درکړل شوي او وړیا یې ورکړئ."}, {"ref": "Matthew 1:8", "text": "نو بیا د څه شي د لیدلو دپاره تللي وئ؟ ایا د هغه چا د لیدلو دپاره چې قیمتي او ښکلي کالي یې اغوستي وو؟ ګورئ، کوم خلک چې داسې کالي اغوندي هغوی په شاهانه ماڼیو کې ژوند کوي."}, {"ref": "Matthew 1:8", "text": "ځکه چې د انسان زوی د سبت د ورځې خاوند هم دی.» عیسی یو سړي ته چې لاس یې شل ؤ شفا ورکوي (مرقوس ۳‏:‌۱‌‏-‌۶ او لوقا ۶‏:‌۶‌‏-‌۱۱)"}, {"ref": "Matthew 1:8", "text": "خو نور تخم په حاصلخیزه خاوره کې ولوېد او حاصل یې ورکړ، ځینو بوټو سل چنده، ځینو شپېته چنده او ځینو دېرش چنده حاصل ورکړ."}, {"ref": "Matthew 1:8", "text": "هغې د خپلې مور په لمسون وویل: «د تعمید غسل ورکوونکي یحیی سر راته په پتنوس کې راکړه.»"}, {"ref": "Matthew 1:8", "text": "دا خلک په خوله زما عزت کوي، خو زړونه یې په بل ځای کې دي."}, {"ref": "Matthew 1:8", "text": "عیسی پوه شو چې هغوی څه وایي، نو پوښتنه یې ترې وکړه: «ستاسو ایمان څومره کمزوری دی، ولې په دې هکله بحث کوئ چې ډوډۍ درسره نشته؟"}, {"ref": "Matthew 1:8", "text": "کله چې شاګردانو خپلې سترګې خلاصې کړې نو پرته له عیسی یې بل هېڅوک هلته ونه لیده."}, {"ref": "Matthew 1:8", "text": "که چېرې ستا لاس یا پښه ستا د ګناه سبب ګرځي، نو هغه پرې کړه او لېرې یې وغورځوه، ځکه چې ستا دپاره به دا ښه وي چې د یو لاس او یوې پښې سره تلپاتې ژوندون ته لاره پیدا کړې، نه دا چې په دواړو لاسو او پښو روغ یې او تلپاتې اور ته واچول شې."}, {"ref": "Matthew 1:8", "text": "عیسی ځواب ورکړ: «موسی تاسو ته د دې دپاره اجازه درکړه چې خپلو ښځو ته طلاق ورکړئ، ځکه چې ستاسو زړونه سخت وو. خو د پیدایښت له وخته داسې نه ؤ."}, {"ref": "Matthew 1:9", "text": "د ځان سره د سرو زرو، سپینو زرو او مسو سکې مه وړئ،"}, {"ref": "Matthew 1:9", "text": "نو بیا د څه شي د لیدلو دپاره وتلي وئ؟ ایا د یو پیغمبر د لیدلو دپاره؟ هو، زه تاسو ته وایم چې هغه د یو پیغمبر څخه هم ډېر لوی دی."}, {"ref": "Matthew 1:9", "text": "له هغې وروسته عیسی د هغه ځای څخه لاړ او یوې کنیسې ته ورغی."}, {"ref": "Matthew 1:9", "text": "که څوک غوږونه لري، نو هغه دې واوري.» د مثال مقصد (مرقوس ۴‏:‌۱۰‌‏-‌۱۲ او لوقا ۸‏:‌۹، ۱۰)"}, {"ref": "Matthew 1:9", "text": "پاچا د خپلې خبرې څخه پښېمانه شو، خو هغه د خپل قسم په خاطر چې د مېلمنو په مخکې یې خوړلی ؤ، خپلو کسانو ته حکم وکړ چې د هغې غوښتنه دې پوره کړای شي."}, {"ref": "Matthew 1:9", "text": "د هغوی عبادت ګټه نه لري ځکه چې هغوی د خدای د حکمونو په ځای د انساني حکمونو تعلیم ورکوي.» هغه شیان چې انسان ناپاکه کوي (مرقوس ۷‏:‌۱۴‌‏-‌۲۳)"}, {"ref": "Matthew 1:9", "text": "تاسو لا تر‌اوسه هم نه پوهېږئ؟ ایا هغه پنځه ډوډۍ او پنځه زره کسان مو په یاد نه دي چې د پاتې شویو ډوډیو څخه مو څو ټوکرۍ ډکې کړې؟"}, {"ref": "Matthew 1:9", "text": "کله چې هغوی د غره څخه راښکته کېدل، نو عیسی هغوی ته امر وکړ: «څه چې مو لیدلي دي د هغو په هکله تر هغه وخته پورې چاته څه مه وایئ ترڅو پورې چې د انسان زوی بېرته د مړو ‎څخه راژوندی شوی نه وي.»"}, {"ref": "Matthew 1:9", "text": "او که چېرې ستا سترګه ستا د ګناه سبب وګرځي، نو هغه وباسه او لېرې یې وغورځوه، ځکه چې ستا دپاره به دا ښه وي چې د یوې سترګې سره تلپاتې ژوندون ومومې، نه دا چې د دواړو سترګو سره د دوزخ اور ته وغورځول شې. د ورک شوي پسه مثال (لوقا ۱۵‏:‌۳‌‏-‌۷)"}, {"ref": "Matthew 1:9", "text": "زه تاسو ته وایم چې که څوک خپله ښځه ‎له زنا کولو پرته په کوم بل دلیل طلاقه کړي او د بلې ښځې سره واده وکړي، نو هغه زنا کوي.»"}, {"ref": "Matthew 1:10", "text": "د سفر دپاره کوم خورجین، اضافه کالي، څپلۍ او امسا مه اخلئ، ځکه چې مزدور د خپلې مزدورۍ حقدار دی."}, {"ref": "Matthew 1:10", "text": "دا هغه څوک دی چې د هغه په هکله د خدای په کلام کې لیکل شوي دي: ګوره، زه به خپل استازی ستا څخه مخکې ولېږم چې ستا دپاره لاره تیاره کړي."}, {"ref": "Matthew 1:10", "text": "هلته یو سړی ؤ چې لاس یې وچ شوی ؤ. ځینو خلکو چې غوښتل یې په عیسی باندې تور ولګوي، نو پوښتنه یې ترې وکړه: «ایا د سبت په ورځ د چا روغول روا دي؟»"}, {"ref": "Matthew 1:10", "text": "بیا شاګردان عیسی ته راغلل او پوښتنه یې ترې وکړه: «د هغوی سره ولې په مثالونو کې خبرې کوې؟»"}, {"ref": "Matthew 1:10", "text": "هغه خپل کسان ولېږل او په زندان کې یې د یحیی سر پرې کړ."}, {"ref": "Matthew 1:10", "text": "بیا عیسی خلک راوغوښتل او ورته ویې ویل: «زما خبرو ته غوږ ونیسئ او ځان ورباندې پوه کړئ."}, {"ref": "Matthew 1:10", "text": "یا هغه اووه ډوډۍ د څلور زرو تنو دپاره او دا چې د هغو څخه مو څو ټوکرۍ ډکې کړې؟"}, {"ref": "Matthew 1:10", "text": "شاګردانو د عیسی نه پوښتنه وکړه: «بیا د شریعت عالمان ولې وایي چې لومړی باید الیاس راشي؟»"}, {"ref": "Matthew 1:10", "text": "ګورئ، په دې خلکو کې چې د ماشومانو په شان په ما باندې ایمان لري، یو ته هم په سپکه سترګه مه ګورئ. زه تاسو ته وایم چې د هغوی فرښتې په اسمان کې تل زما د اسماني پلار په حضور کې حاضرې وي. ["}, {"ref": "Matthew 1:10", "text": "شاګردانو عیسی ته وویل: «که د مېړه او ښځې ترمنځ دا حال وي، نو دا به ښه وي چې څوک هېڅ واده ونه کړي.»"}, {"ref": "Matthew 1:11", "text": "کله چې کوم ښار یا کوم کلي ته ننوځئ، نو د یو داسې سړي کور ته ورشئ چې د ورتلو لایق وي او ترڅو پورې چې کوم بل ځای ته ځئ، نو تر هغه وخته پورې د هغه په کور کې پاتې شئ."}, {"ref": "Matthew 1:11", "text": "په یقین سره زه تاسو ته دا وایم چې په دې نړۍ کې له تعمید ورکوونکی یحیی څخه بل څوک لوی نه دی پیدا شوی، خو بیاهم په اسماني پاچاهۍ کې تر ټولو کوچنی د هغه نه ډېر لوی دی."}, {"ref": "Matthew 1:11", "text": "عیسی ځواب ورکړ: «فرض کړئ چې په تاسو کې کوم څوک یو پسه ولري او هغه د سبت په ورځ کندې ته ولویږي نو هغه به راونه نیسي او د هغې کندې څخه به یې راونه باسي؟"}, {"ref": "Matthew 1:11", "text": "عیسی په ځواب کې وویل: «تاسو ته د اسماني پاچاهۍ په پټو رازونو د پوهېدلو دپاره پوهه درکړل شوې ده، خو هغوی ته نه ده ورکړل شوې."}, {"ref": "Matthew 1:11", "text": "نو د هغه سر یې په یو پتنوس کې راوړ او هغې انجلۍ ته یې ورکړ او هغې خپلې مور ته یووړ."}, {"ref": "Matthew 1:11", "text": "انسان چې څه خوري او څه څښي په هغو باندې نه ناپاکه کیږي، خو کومه خبره چې د هغه د خولې څخه راوځي په هغې ناپاکه کیږي.»"}, {"ref": "Matthew 1:11", "text": "تاسو څنګه په دې پوه نه شوئ چې ما د ډوډۍ په هکله خبرې نه کولې؟ بلکې ما تاسو ته ویلي وو چې د فریسیانو او صدوقیانو د خمیرې څخه ځانونه ساتئ.»"}, {"ref": "Matthew 1:11", "text": "عیسی ځواب ورکړ: «دا رښتیا ده چې لومړی به الیاس راځي او هرڅه به سم کړي."}, {"ref": "Matthew 1:11", "text": "ځکه چې د انسان زوی راغلی دی چې ورک شوي وژغوري.]"}, {"ref": "Matthew 1:11", "text": "خو عیسی هغوی ته وویل: «هرڅوک دا خبره نه شي منلی، خو یوازې هغه خلک یې منلی شي چې خدای ورته دا توان ورکړی وي."}, {"ref": "Matthew 1:12", "text": "کوم کور ته چې ننوځئ، نو په هغه سلام واچوئ."}, {"ref": "Matthew 1:12", "text": "د تعمید غسل ورکوونکي یحیی د زمانې څخه تر نن ورځ پورې اسماني پاچاهي تر سختو حملو لاندې راغلې او زورور خلک کوښښ کوي چې هغه په زوره ونیسي."}, {"ref": "Matthew 1:12", "text": "خو انسان د پسه نه ډېر زیات ارزښت لري! نو له دې امله د سبت په ورځ نېک کار کول روا دی.»"}, {"ref": "Matthew 1:12", "text": "ځکه د چا سره چې څه وي نو هغه ته به نور هم ورکړل شي، ترڅو د هغه سره نور هم پرېمانه شي. خو د چا سره چې څه نه وي، نو څه چې ورسره وي هغه به هم ترې واخیستل شي."}, {"ref": "Matthew 1:12", "text": "بیا د یحیی شاګردان راغلل او د هغه مړی یې یووړ او ښخ یې کړ. هغوی لاړل او عیسی یې خبر کړ. عیسی پنځه زره کسانو ته ډوډۍ ورکوي (مرقوس ۶‏:‌۳۰‌‏-‌۴۴ او لوقا ۹‏:‌۱۰‌‏-‌۱۷ او یوحنا ۶‏:‌۱‌‏-‌۱۴)"}, {"ref": "Matthew 1:12", "text": "بیا شاګردان عیسی ته راغلل او ورته ویې ویل: «ایا ته پوهېږې چې فریسیان ستا په خبرو خفه شول؟»"}, {"ref": "Matthew 1:12", "text": "بیا شاګردان پوه شول چې عیسی هغوی ته دا نه وو ویلي چې د هغې خمیرې نه ځانونه وساتئ چې په ډوډۍ کې ترې کار اخیستل کیږي بلکې د فریسیانو او صدوقیانو د تعلیم ‎څخه ځان ساتل ؤ. د مسیح په هکله د پطروس اقرار (مرقوس ۸‏:‌۲۷‌‏-‌۳۰ او لوقا ۹‏:‌۱۸‌‏-‌۲۱)"}, {"ref": "Matthew 1:12", "text": "خو زه تاسو ته وایم چې الیاس لا پخوا راغلی دی، خو خلکو هغه ونه پېژانده او هرڅه چې دوی غوښتل د هغه سره یې وکړل. په همدې ډول به د انسان زوی هم د هغوی د لاسه وکړیږي.»"}, {"ref": "Matthew 1:12", "text": "تاسو څه فکر کوئ؟ فرض کړئ یو سړی سل پسونه لري او د هغو څخه یو ورک شي، نو هغه به څه کوي؟ ایا هغه به دا نهه نوي پسونه د غونډیو په لمنو کې پرېنږدي او د هغه ورک شوي پسه د لټولو دپاره به لاړ نه شي؟"}, {"ref": "Matthew 1:12", "text": "دا چې ځینې خلک ودونه نه شي کولای ډول ډول دلیلونه لري: ځینې داسې دي چې له مور نه نرښځیان پیدا شوي دي او ځینې د انسانانو له خوا خصیان شوي دي او نور د اسماني پاچاهۍ په خاطر ودونه نه کوي. نو څوک چې یې منلی شي هغه دې ومني.» عیسی ماشومانو ته برکت ورکوي (مرقوس ۱۰‏:‌۱۳‌‏-‌۱۶ او لوقا ۱۸‏:‌۱۵‌‏-‌۱۷)"}, {"ref": "Matthew 1:13", "text": "که چېرې د هغه کور خلک ستاسو د سلام لایق وي، نو کومه سوله او سلامتي چې تاسو یې د هغوی دپاره غواړئ هغه به ورباندې پاتې شي، خو که لایق یې نه وي، نو هغه سلام به بېرته تاسو ته راوګرځي."}, {"ref": "Matthew 1:13", "text": "ځکه چې ټولو پیغمبرانو او د موسی شریعت د یحیی تر راتللو پورې د اسماني پاچاهۍ په هکله پېشګویي کړې ده"}, {"ref": "Matthew 1:13", "text": "بیا عیسی هغه سړي ته وویل: «خپل لاس دې وغزوه.» هغه خپل لاس وغزاوه او هغه یې د بل لاس په شان روغ شو."}, {"ref": "Matthew 1:13", "text": "نو په دې خاطر د هغوی سره په مثالونو کې خبرې کوم، ځکه چې هغوی ګوري خو نه یې ویني، هغوی غوږ نیسي خو نه یې اوري او نه پوهیږي."}, {"ref": "Matthew 1:13", "text": "کله چې عیسی د یحیی په هکله دا خبر واورېد، نو د هغه ځای څخه په کشتۍ کې یو ګوښه ځای ته یوازې لاړ. خو کله چې خلک خبر شول، نو د خپلو ښارونو څخه د وچې لارې نه په هغه پسې لاړل."}, {"ref": "Matthew 1:13", "text": "عیسی ځواب ورکړ: «هر نیالګی چې زمونږ اسماني پلار نه وي کرلی هغه به له بېخه وویستل شي."}, {"ref": "Matthew 1:13", "text": "کله چې عیسی د فیلیپوس د قیصریې سیمې ته ورسېده، نو د خپلو شاګردانو څخه یې پوښتنه وکړه: «خلک څه وایي چې د انسان زوی څوک دی؟»"}, {"ref": "Matthew 1:13", "text": "بیا شاګردان پوه شول چې هغه ورته د تعمید غسل ورکوونکي یحیی په هکله خبرې کولې. عیسی یو هلک ته چې پېریانو نیولی ؤ، شفا ورکوي (مرقوس ۹‏:‌۱۴‌‏-‌۲۹ او لوقا ۹‏:‌۳۷‌‏-‌۴۳)"}, {"ref": "Matthew 1:13", "text": "کله چې هغه پیدا کړي، نو په یقین سره زه تاسو ته دا وایم چې هغه سړی به د هغو نهه نوي پسونو څخه چې ورک شوي نه دي په هغه یو باندې ډېر خوشحاله شي."}, {"ref": "Matthew 1:13", "text": "په دې وخت کې ځینو خلکو عیسی ته خپل ماشومان راوستل چې خپل لاس د هغوی په سرونو باندې کېږدي او د هغوی دپاره دعا وکړي، خو شاګردانو هغوی ورټل."}, {"ref": "Matthew 1:14", "text": "خو که چېرې څوک تاسو ته هرکلی ونه وایي او یا ستاسو خبرو ته غوږ ونه نیسي، نو کله چې د هغه کور یا ښار څخه ځئ، نو د خپلو پښو خاورې وڅنډئ."}, {"ref": "Matthew 1:14", "text": "او که تاسو تیار یئ چې دا ومنۍ، نو یحیی هماغه الیاس نبي دی چې باید راغلی وای."}, {"ref": "Matthew 1:14", "text": "خو فریسیان د کنیسې نه ووتل او د عیسی د وژلو دپاره یې دسیسه جوړه کړه. د خدای غوره شوی خدمتګار"}, {"ref": "Matthew 1:14", "text": "نو د اشعیا پیغمبر پېشګویي د هغوی په هکله پوره کیږي چې وایي: تاسو به یې بیا بیا اورئ خو پوه به نه شئ، تاسو به ګورئ خو څه به نه وینئ،"}, {"ref": "Matthew 1:14", "text": "کله چې عیسی د کشتۍ څخه راښکته شو د خلکو یوه لویه ګڼه‌ګوڼه یې ولیدله، نو زړه یې ورباندې وسوځېد او د هغوی ناروغان یې روغ کړل."}, {"ref": "Matthew 1:14", "text": "نو د هغوی پروا مه کوئ. دوی داسې ړانده دي چې نورو ړندو ته لاره ښایي. کله چې یو ړوند بل ړوند ته لاره ښایي، نو دواړه په کنده کې غورځیږي.»"}, {"ref": "Matthew 1:14", "text": "هغوی ځواب ورکړ: «ځینې وایي چې تعمید ورکوونکی یحیی دی، ځینې وایي چې الیاس نبي دی او نور وایي چې ارمیا نبي یا کوم بل پیغمبر دی.»"}, {"ref": "Matthew 1:14", "text": "کله چې عیسی او شاګردان یې بېرته خلکو ته راغلل، نو یو سړی عیسی ته راغی، د هغه په مخکې په ګونډو شو"}, {"ref": "Matthew 1:14", "text": "نو په دې ډول ستاسو اسماني پلار نه غواړي چې د دې خلکو څخه چې د ماشومانو په شان په ما باندې ایمان لري، یو هم له منځه لاړ شي. کله چې یو ایماندار ګناه کوي"}, {"ref": "Matthew 1:14", "text": "خو عیسی هغوی ته وویل: «پرېږدئ چې ماشومان ماته راشي او هغوی مه منع کوئ، ځکه چې اسماني پاچاهي د همداسې خلکو ده.»"}, {"ref": "Matthew 1:15", "text": "په یقین سره زه تاسو ته دا وایم چې د قیامت په ورځ به د سدوم او عموره د ښارونو د خلکو سزا د دی ښار د خلکو د سزا څخه کمه وي. د راتلونکې ځورونې په هکله (مرقوس ۱۳‏:‌۹‌‏-‌۱۳ او لوقا ۲۱‏:‌۱۲‌‏-‌۱۷)"}, {"ref": "Matthew 1:15", "text": "که څوک غوږونه لري، نو هغه دې واوري."}, {"ref": "Matthew 1:15", "text": "کله چې عیسی د هغوی د دسیسې نه خبر شو، نو د هغه ځای څخه لاړ. ډېر خلک ورپسې روان شول او هغه ټول ناروغان روغ کړل"}, {"ref": "Matthew 1:15", "text": "ځکه چې د دې خلکو زړونه سخت شوي دي او په غوږو درانه دي. سترګې یې پټې شوې دي، که نه، نو سترګو به یې لیدل، غوږونو به یې اورېدل، په زړونو کې به پوهېدل او ماته به بېرته راګرځېدلي وای او ما به شفا ورکړې وای."}, {"ref": "Matthew 1:15", "text": "کله چې ماښام شو، شاګردان یې ورته راغلل او ویې ویل: «دا ځای خوشې دښته ده او ډېره ناوخته شوې ده، خلک کلیو ته ولېږه چې خپلو ځانونو ته د خوړلو دپاره کوم څه واخلي.»"}, {"ref": "Matthew 1:15", "text": "بیا پطروس عیسی ته وویل: «مونږ ته د دې مثال معنی ووایه.»"}, {"ref": "Matthew 1:15", "text": "عیسی پوښتنه وکړه: «تاسو څه وایئ چې زه څوک یم؟»"}, {"ref": "Matthew 1:15", "text": "او ویې ویل: «ای ښاغلیه! زما په زوی باندې رحم وکړه. په هغه باندې میرګي راځي او داسې سختې حملې ورباندې راځي چې اکثره وختونه هغه په اور یا اوبو کې غورځیږي."}, {"ref": "Matthew 1:15", "text": "که چېرې ستا ورور ستا په وړاندې کومه بدي وکړي، نو ورشه او خپله غلطي یې ورته وښایه او دا خبره دې یوازې ستا او د هغه ترمنځ وي. که هغه خپله غلطي ومني، نو ورور به دې بېرته خپل کړې."}, {"ref": "Matthew 1:15", "text": "عیسی خپل لاس د هغوی په سرونو باندې کېښود، برکت یې ورته ورکړ او بیا روان شو. په اسماني پاچاهۍ کې د شتمن سړي ننوتل ډېر سخت دي (مرقوس ۱۰‏:‌۱۷‌‏-‌۳۱ او لوقا ۱۸‏:‌۱۸‌‏-‌۳۰)"}, {"ref": "Matthew 1:16", "text": "ګورئ، زه تاسو لکه د پسونو په شان د لېوانو منځ ته لېږم، نو د مارانو په شان هوښیار او د کوترو په شان بې‌آزاره اوسئ."}, {"ref": "Matthew 1:16", "text": "خو زه د دې زمانې خلک د څه شي سره پرتله کړم؟ هغوی د هغو ماشومانو په شان دي چې په بازار کې ناست وي او یو بل ته نارې وهي:"}, {"ref": "Matthew 1:16", "text": "او هغوی ته یې امر وکړ چې هېچا ته ونه وایي چې هغه څوک دی."}, {"ref": "Matthew 1:16", "text": "خو ستاسو سترګې بختورې دي، ځکه چې ویني او غوږونه مو بختور دي ځکه چې اوري."}, {"ref": "Matthew 1:16", "text": "عیسی وویل: «د دوی تګ ته اړتیا نشته، تاسو خپله هغوی ته کوم څه ورکړئ چې ویې خوري.»"}, {"ref": "Matthew 1:16", "text": "عیسی پوښتنه وکړه: «ایا تاسو هم لا تر‌اوسه په دې شیانو نه پوهېږئ؟"}, {"ref": "Matthew 1:16", "text": "شمعون پطروس ځواب ورکړ: «ته مسیح، د ژوندي خدای زوی یې.»"}, {"ref": "Matthew 1:16", "text": "هغه مې ستا شاګردانو ته راوست، خو ویې نه شو کولای چې هغه روغ کړي.»"}, {"ref": "Matthew 1:16", "text": "خو که چېرې هغه ستا خبرو ته غوږ ونه نیسي، نو بیا یو یا دوه نور کسان د ځان سره بوځه، ترڅو څه چې ته وایې هغه د دوو یا درې شاهدانو له خوا تایید شي."}, {"ref": "Matthew 1:16", "text": "داسې وشول چې یو سړی عیسی ته راغی او پوښتنه یې ترې وکړه: «استاذه! زه داسې کوم نېک کار وکړم چې تلپاتې ژوندون وګټم؟»"}, {"ref": "Matthew 1:17", "text": "پام کوئ چې خلک به تاسو محکمو ته وسپاري او په خپلو کنیسو کې به مو په دورو باندې ووهي"}, {"ref": "Matthew 1:17", "text": "‹مونږ درته شپیلۍ ووهله، خو تاسو ګډا ونه کړه، مونږ درته د غم سندرې وویلې، خو تاسو ونه ژړل.›"}, {"ref": "Matthew 1:17", "text": "ترڅو په دې ډول د اشعیا نبي هغه وینا رښتیا شي چې وایي:"}, {"ref": "Matthew 1:17", "text": "په یقین سره زه تاسو ته دا وایم چې ډېرو پیغمبرانو او نېکو خلکو دا ارمان درلود چې هغه څه وویني چې تاسو یې وینئ، خو ویې نه لیدل او هغه څه واوري چې تاسو یې اورئ، خو هغوی وانه ورېدل. د بزګر مثال (مرقوس ۴‏:‌۱۳‌‏-‌۲۰ او لوقا ۸‏:‌۱۱‌‏-‌۱۵)"}, {"ref": "Matthew 1:17", "text": "هغوی ځواب ورکړ: «زمونږ سره یوازې پنځه ډوډۍ او دوه ماهیان دي.»"}, {"ref": "Matthew 1:17", "text": "ایا تاسو نه پوهېږئ چې کوم شی چې خولې ته ننوځي هغه خېټې ته ځي او وروسته بیا د بدن څخه وځي؟"}, {"ref": "Matthew 1:17", "text": "عیسی وویل: «ای د یوحنا زویه شمعونه! ته بختور یې. ځکه چې دا درته انسان نه دي ښودلي بلکې زما اسماني پلار درته ښکاره کړي دي."}, {"ref": "Matthew 1:17", "text": "عیسی په ځواب کې وویل: «ای د دې زمانې بې‌ایمانه او بې‌لارې خلکو، ترڅو پورې به زه ستاسو سره یم؟ ترڅو پورې به تاسو ته حوصله کوم؟ هغه هلک دلته ماته راولئ.»"}, {"ref": "Matthew 1:17", "text": "که چېرې هغه د هغوی خبره هم ونه مني، نو موضوع کلیسا ته وړاندې کړه او که د کلیسا خبره هم ونه مني، نو بیا د هغه سره داسې چلند وکړه لکه چې د یو کافر یا مالیه ټولوونکي سره کیږي."}, {"ref": "Matthew 1:17", "text": "عیسی هغه ته وویل: «د نېکۍ په هکله ولې زما څخه پوښتنه کوې؟ یوازې یو ذات دی چې نېک دی، خو که ته غواړې تلپاتې ژوندون تر‌لاسه کړې، نو د هغه په حکمونو عمل وکړه.»"}, {"ref": "Matthew 1:18", "text": "او زما په خاطر به تاسو والیانو او پاچاهانو ته راوستل شئ چې د هغوی او غیریهودیانو په مخکې شاهدي ورکړئ."}, {"ref": "Matthew 1:18", "text": "ځکه کله چې یحیی راغی، نو نه یې څه خوړل او نه یې څه څښل، خو ټولو به ویل چې هغه پېریانو نیولی دی."}, {"ref": "Matthew 1:18", "text": "دا دی زما خدمتګار چې ما غوره کړی دی. هغه په ما باندې ګران دی او زه ترې خوشحاله یم. زه به په هغه باندې خپل روح نازل کړم او هغه به د نړۍ قومونه د خدای د قضاوت څخه خبروي"}, {"ref": "Matthew 1:18", "text": "نو بیا د بزګر د مثال معنی واورئ:"}, {"ref": "Matthew 1:18", "text": "عیسی وویل: «هغه ماته راوړئ.»"}, {"ref": "Matthew 1:18", "text": "خو څه چې د خولې څخه راوځي هغه د زړه څخه راځي او په هغو باندې انسان ناپاکه کیږي."}, {"ref": "Matthew 1:18", "text": "خو زه تاته وایم چې ته پطروس یې چې معنی یې تیږه ده او زه په دې تیږې باندې خپله کلیسا جوړوم او حتی مرګ هم دومره قدرت نه لري چې په هغې باندې بریالی شي."}, {"ref": "Matthew 1:18", "text": "عیسی هغه پېري ته په کلکه امر وکړ، نو هغه د هلک څخه راووت او په هماغه ساعت هلک روغ شو."}, {"ref": "Matthew 1:18", "text": "په یقین سره زه تاسو ته دا وایم هرڅه چې تاسو د ځمکې په مخ ناروا وګڼئ، نو په اسمان کې به هم ناروا وګڼل شي او هرڅه چې د ځمکې په مخ روا وګڼئ، نو په اسمان کې به هم روا وګڼل شي."}, {"ref": "Matthew 1:18", "text": "هغه سړي پوښتنه وکړه: «کوم حکمونه؟» عیسی وویل: «قتل مه کوه، زنا مه کوه، غلا مه کوه، د دروغو شاهدي مه ورکوه."}, {"ref": "Matthew 1:19", "text": "خو کله چې هغوی تاسو محکمې ته راولي، نو په دې هکله اندېښنه مه کوئ چې تاسو به څه وایئ او څنګه به یې وایئ، ځکه چې په هماغه ساعت به تاسو ته وویل شي چې څه ووایئ."}, {"ref": "Matthew 1:19", "text": "کله چې د انسان زوی راغی او هغه خوړل او څښل، خو هغوی ویل چې هغه ته ګورئ، هغه یو خېټور، شرابي او د مالیه ټولوونکو او نورو ګناهکارانو ملګری دی. خو بیاهم خلکو ته به د خدای حکمت په خپلو عملونو کې رښتینی ثابت شي.» بې‌ایمانه ښارونه (لوقا ۱۰‏:‌۱۳‌‏-‌۱۵)"}, {"ref": "Matthew 1:19", "text": "هغه به نه جنګ جګړې کوي او نه به چیغې وهي او نه به یې په کوڅو کې څوک اواز اوري."}, {"ref": "Matthew 1:19", "text": "کله چې څوک د خدای د پاچاهۍ په هکله پیغام واوري، خو ورباندې پوه نه شي نو هغه د داسې تخم په شان دی چې په لاره کې ولویږي. شیطان راشي او څه چې د هغوی په زړونو کې کرل شوي وي هغه وتښتوي."}, {"ref": "Matthew 1:19", "text": "بیا هغه خلکو ته حکم وکړ چې په واښو باندې کښېني. بیا یې هغه پنځه ډوډۍ او دوه ماهیان راواخیستل، اسمان ته یې وکتل، د خدای شکر یې وویست او ډوډۍ یې ماتې کړې، هغه یې شاګردانو ته ورکړې او شاګردانو هغه په خلکو باندې ووېشلې."}, {"ref": "Matthew 1:19", "text": "ځکه چې خراب خیالونه، قتل، زناکاري، جنسي بد‌اخلاقي، غلا، د دروغو شهادت او تهمت د زړه نه راوځي."}, {"ref": "Matthew 1:19", "text": "زه به تاته د اسماني پاچاهۍ کیلي‌ګانې درکړم، هرڅه چې ته د ځمکې په مخ ناروا وګڼې، نو په اسمان کې به هم ناروا وګڼل شي او هرڅه چې د ځمکې په مخ روا وګڼې، نو په اسمان کې به هم روا وګڼل شي.»"}, {"ref": "Matthew 1:19", "text": "بیا شاګردان عیسی ته راغلل او کله چې هغوی یوازې وو نو پوښتنه یې ترې وکړه: «مونږ ولې ونه شو کولای چې هغه پېری وباسو؟»"}, {"ref": "Matthew 1:19", "text": "په یقین سره زه تاسو ته نور څه هم وایم: که چېرې په تاسو کې دلته د ځمکې په مخ دوه تنه د کوم شي په هکله په یو زړه خدای ته سوال وکړي، نو زما اسماني پلار به یې قبول کړي."}, {"ref": "Matthew 1:19", "text": "د خپل مور او پلار عزت کوه او د خپل ګاونډي سره د خپل ځان په شان مینه کوه.»"}, {"ref": "Matthew 1:20", "text": "ځکه تاسو چې کومې خبرې کوئ هغه به ستاسو خبرې نه وي، بلکې ستاسو د اسماني پلار روح به ستاسو په وسیله خبرې کوي."}, {"ref": "Matthew 1:20", "text": "بیا عیسی د هغو ښارونو خلک ملامته کړل چې زیاتې معجزې یې په کې ښودلې وې، ځکه چې هغوی توبه ونه ویستله."}, {"ref": "Matthew 1:20", "text": "هغه به کږه لوخه هم نه ماتوي او نه به ضعیفه ډېوه مړه کوي، ترڅو هغه انصاف بریالی کړي."}, {"ref": "Matthew 1:20", "text": "په تیږه لرونکې ځمکه کې کرل شوی تخم د هغه چا په مثال دی چې پیغام واوري او سمدلاسه یې په خوشحالۍ سره قبول کړي."}, {"ref": "Matthew 1:20", "text": "هغوی ټولو وخوړل او ماړه شول او څه چې ترې پاتې شوي وو، شاګردانو هغه راټول کړل او دولس ټوکرۍ ترې ډکې شوې."}, {"ref": "Matthew 1:20", "text": "دا هغه شیان دي چې انسان ناپاکه کوي، خو په ناپاکو لاسونو باندې خوراک کول انسان نه ناپاکه کوي.» د یوې کنعانۍ ښځې ایمان (مرقوس ۷‏:‌۲۴‌‏-‌۳۰)"}, {"ref": "Matthew 1:20", "text": "بیا عیسی خپلو شاګردانو ته په کلکه امر وکړ چې هېچا ته ونه وایئ چې هغه مسیح دی. عیسی د خپلو کړاوونو او مړینې په هکله پېشګویي کوي (مرقوس ۸‏:‌۳۱ ‏- ۹‏:‌۱ او لوقا ۹‏:‌۲۲‌‏-‌۲۷)"}, {"ref": "Matthew 1:20", "text": "هغه ورته وویل: «ځکه چې ستاسو ایمان کمزوری دی. په یقین سره زه تاسو ته دا وایم چې که چېرې تاسو د شړشمو د دانې په اندازه ایمان هم ولرئ، نو کولای شئ دې غره ته ووایئ چې د دې ځای څخه هغه ځای ته لاړ شه، نو هغه به لاړ شي او هېڅ کار به ستاسو دپاره ناشونی نه وي. ["}, {"ref": "Matthew 1:20", "text": "ځکه په هرځای کې که دوه یا درې تنه زما په نوم سره راټول شي، نو زه د هغوی په منځ کې حاضر یم.» د نورو د بخښلو په هکله د عیسی تعلیم"}, {"ref": "Matthew 1:20", "text": "هغه ځوان ځواب ورکړ: «په دې ټولو مې عمل کړی دی، نور څه وکړم؟»"}, {"ref": "Matthew 1:21", "text": "ورور به د ورور سره خیانت وکړي چې ووژل شي او پلار به د خپلو اولادونو سره. اولادونه به د خپلو میندو او پلرونو په خلاف راپورته شي او د هغوی د مړینې سبب به شي."}, {"ref": "Matthew 1:21", "text": "هغه وویل: «افسوس دې وي په تا ای د خورزین ښاره! او افسوس دې وي په تا باندې ای د بیت‌صیدا ښاره! ځکه که چېرې دا معجزې چې په تاسو کې وښودل شوې که هغه په صور او صیدون کې ښودل شوې وای نو هغوی به ډېر پخوا د ویر کالي اغوستي وای، په خپلو سرونو باندې به یې ایرې بادولې او توبې به یې ویستلې وای."}, {"ref": "Matthew 1:21", "text": "د ټولو قومونو د هیلې سترګې به د هغه خواته وي. عیسی او بعلزبول یعنې شیطان (مرقوس ۳‏:‌۲۰‌‏-‌۳۰ او لوقا ۱۱‏:‌۱۴‌‏-‌۲۳)"}, {"ref": "Matthew 1:21", "text": "خو څرنګه چې په هغوی کې یې ریښې نه وي نیولې، نو هغه د زیات وخت دپاره نه پاتې کیږي. نو بیا کله چې د پیغام له امله ورباندې سختي راشي یا وځوریږي، نو ز