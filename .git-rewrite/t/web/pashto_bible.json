[{"ref": "1 Chronicles 1:1", "text": "فلسطینیانو د جلبوع په غره کې د اسراییلو سره جګړه وکړه. په هغه ځای کې ډېر اسراییلیان ووژل شول او پاتې یې چې په هغو کې شاوول پاچا او د هغه زامن هم شامل وو، وتښتېدل."}, {"ref": "1 Chronicles 1:1", "text": "وروسته د اسراییلو ټول خلک په حبرون کې د داود حضور ته راټول شول او هغه ته یې وویل: «مونږ ستاسو خپل هډوکي او وینه یو."}, {"ref": "1 Chronicles 1:1", "text": "یو څه موده مخکې داود تللی ؤ چې د صقلغ په ښارګوټي کې واوسیږي او د شاوول پاچا څخه پټ شي. کله چې داود هلته ؤ، ډېرو زړورو جنګیالیو د هغه سره لاس یو کړ چې په جګړه کې ورسره مرسته وکړي."}, {"ref": "1 Chronicles 1:1", "text": "داود د خپلو لښکرو د قوماندانانو سره مشوره وکړه یعنې د هغو سره چې د زر کسیزو فرقو او د سل کسیزو ټولیو قوماندانان وو."}, {"ref": "1 Chronicles 1:1", "text": "نو بیا د صور پاچا حیرام، داود ته خپل استازي ورولېږل، د هغوی سره ګلکاران او نجاران هم وو. هغوی د سبر د ونو لرګي راوړل، ترڅو داود ته ماڼۍ جوړه کړي."}, {"ref": "1 Chronicles 1:1", "text": "داود د خپل ځان دپاره د داود په ښار کې کورونه ودان کړل. هغه د خدای د لوظ د صندوق دپاره هم یو ځای تیار کړ او یوه خېمه یې د هغه دپاره ودروله."}, {"ref": "1 Chronicles 1:1", "text": "هغوی د خدای د لوظ صندوق په هغې خېمې کې کېښود چې داود د هغه دپاره ودرولې وه، بیا یې سوځېدونکې نذرانې او د سلامتۍ نذرانې خدای ته وړاندې کړې."}, {"ref": "1 Chronicles 1:1", "text": "وروسته له دې چې داود خپلې ماڼۍ ته کډه وکړه، هغه ناتان نبي ته وویل: «ګوره، زه دلته په دې ماڼۍ کې اوسېږم چې د سبر د ونې د لرګیو څخه جوړه شوې ده، خو د څښتن د لوظ صندوق په خېمه کې ایښودل شوی دی.»"}, {"ref": "1 Chronicles 1:1", "text": "څه موده وروسته داود بیا فلسطینیانو ته ماتې ورکړه او هغوی یې کمزوري کړل. د هغوی څخه یې د جت ښار او د هغه د شاوخوا کلي ونیول."}, {"ref": "1 Chronicles 1:1", "text": "څه موده وروسته د عمونیانو پاچا ناحاش مړ شو او د هغه زوی حانون د هغه په ځای پاچا شو."}, {"ref": "1 Chronicles 1:2", "text": "خو فلسطینیانو هغوی ډېر سخت تعقیب کړل او د شاوول درې زامن، یوناتان، ابیناداب او ملکیشوع یې ووژل."}, {"ref": "1 Chronicles 1:2", "text": "حتی کله چې شاوول زمونږ پاچا ؤ، همدا تاسو وئ چې په عسکري عملیاتو کې به مو اسراییلو ته لارښوونه کوله او ستاسو څښتن خدای تاسو ته وویل: ته به د یو شپون په توګه زما د قوم لارښوونه کوې او د هغوی ټاکلی مشر به یې.»"}, {"ref": "1 Chronicles 1:2", "text": "دغه جنګیالي د شاوول پاچا له خپلوانو او د بنیامین د قبیلې څخه وو. هغوی د لیندې او د غشو په ویشتلو کې تکړه وو، هغوی په خپل ښي او چپ لاس دواړو باندې غشي ويشتلی شول او هم یې په مچنوغزه کې تیږې ويشتلی شوې."}, {"ref": "1 Chronicles 1:2", "text": "داود د اسراییلو قوم ته وویل: «که ستاسو مشوره او زمونږ د څښتن خدای رضا وي، نو اجازه راکړئ چې ټولو اسراییلیانو ته پیغام ولېږم او د خپلو ټولو هېوادوالو د کاهنانو او لاویانو په شمول چې په ښارګوټو او د هغوی په څړځایونو کې دي، بلنه ورکړم چې راشي او دلته زمونږ سره یوځای شي."}, {"ref": "1 Chronicles 1:2", "text": "نو داود پوه شو چې څښتن د هغه پاچاهي په اسراییلو باندې ټینګه کړې ده او د هغه پاچاهي د خپل قوم یعنې د اسراییلو په خاطر نېکمرغه کیږي."}, {"ref": "1 Chronicles 1:2", "text": "هغه وویل: «یوازې لاویان به دا اجازه ولري چې د لوظ صندوق یوسي، ځکه چې څښتن هغوی غوره کړي دي چې دا کار وکړي او تل د څښتن خدمت وکړي.»"}, {"ref": "1 Chronicles 1:2", "text": "کله چې داود د نذرانو د وړاندې کولو څخه وزګار شو، هغه د خلکو دپاره د څښتن په نوم برکت وغوښت."}, {"ref": "1 Chronicles 1:2", "text": "ناتان ځواب ورکړ: «هرڅه چې ستا په زړه کې دي هغه وکړه، ځکه چې خدای ستا سره مل دی.»"}, {"ref": "1 Chronicles 1:2", "text": "داود موآبیانو ته هم ماتې ورکړه، نو هغوی د هغه رعیت شول او باج به یې ورکاوه."}, {"ref": "1 Chronicles 1:2", "text": "داود پاچا وویل: «زه به د حانون سره په داسې وفاداراۍ سره دوستي وکړم لکه څنګه چې د هغه پلار ناحاش زما سره کړې وه.» نو داود خپل استازي ولېږل چې د خپل ځان له خوا هغه ته خواخوږي وړاندې کړي. خو کله چې هغوی عمون ته ورسېدل او د حانون پاچا سره یې رسمي کتنه وکړه،"}, {"ref": "1 Chronicles 1:3", "text": "په شاوول باندې جګړه ډېره سخته شوه او کله چې د فلسطینیانو غشي ویشتونکي هغه ته ورسېدل، نو هغه یې سخت ټپي کړ."}, {"ref": "1 Chronicles 1:3", "text": "کله چې د اسراییلو ټول مشران په حبرون کې داود پاچا ته ورغلل، داود د څښتن په مخکې د هغوی سره یو تړون وکړ. بیا هغوی د داود سر په تېلو غوړ کړ او هغه یې د اسراییلو د پاچا په توګه غوره کړ، لکه څنګه چې څښتن د سموییل په وسیله دا وعده کړې وه."}, {"ref": "1 Chronicles 1:3", "text": "بیا به لاړ شو او د خدای د لوظ صندوق به راوړو، ځکه چې د شاوول د پاچاهۍ په وخت کې ورته پاملرنه نه وه شوې.»"}, {"ref": "1 Chronicles 1:3", "text": "وروسته له دې چې داود اورشلیم ته کډه وکړه، هغه د نورو ښځو سره ودونه وکړل او نور زامن او لورګانې یې وزېږېدلې."}, {"ref": "1 Chronicles 1:3", "text": "بیا داود د اسراییلو ټول قوم اورشلیم ته راوغوښت د دې دپاره چې د لوظ صندوق هغه ځای ته راوړي چې د هغه دپاره یې تیار کړی ؤ."}, {"ref": "1 Chronicles 1:3", "text": "هغه د اسراییلو ټولو خلکو، هم سړیو او هم ښځو، هر یو ته یوه ډوډۍ، یوه ټوټه غوښه او د ممیزو یوه کلچه ووېشله."}, {"ref": "1 Chronicles 1:3", "text": "خو په هماغه شپه څښتن ناتان ته وویل:"}, {"ref": "1 Chronicles 1:3", "text": "په داسې حال کې چې د صوبې د پاچا هددعزر د فرات د سیند پورتنۍ سیمې ته روان ؤ چې د هغه ځای واکمن شي، داود د حمات په پوله هغه ته ماتې ورکړه."}, {"ref": "1 Chronicles 1:3", "text": "د عمونیانو مشرانو حانون پاچا ته وویل: «ایا تاسو فکر کوئ چې داود په رښتیا دا استازي ستاسو پلار ته د عزت ورکولو دپاره رالېږلي دي؟ ایا هغه ستاسو سره دومره خواخوږي لري؟ بې له شکه چې نه! هغوی یې دلته د جاسوسۍ دپاره رالېږلي چې زمونږ هېواد وګوري، ترڅو هغه فتح کړي.»"}, {"ref": "1 Chronicles 1:4", "text": "شاوول خپل عسکر ته چې د هغه وسله یې لېږدوله وویل: «خپله توره راوباسه او ما ووژنه، ترڅو دا کافر فلسطینیان مې په عذاب نه کړي.» خو هغه ځوان د دې کار څخه ډېر ووېرېد. نو شاوول خپله توره راواخیستله او ځان یې ورباندې وغورځاوه."}, {"ref": "1 Chronicles 1:4", "text": "داود پاچا او ټول اسراییلیان لاړل او د اورشلیم په ښار باندې یې حمله وکړه. په هغه زمانه کې اورشلیم د یبوس په نوم وپېژندل شو او د دې ځای اصلي اوسېدونکي لا تر هغه وخته پورې هلته اوسېدل."}, {"ref": "1 Chronicles 1:4", "text": "ټولو خلکو دا خبره ومنله چې دا سم وړاندیز دی او پرېکړه یې وکړه چې همداسې وکړي."}, {"ref": "1 Chronicles 1:4", "text": "دا د داود اولادونه دي چې په اورشلیم کې زېږېدلي دي: شموع، شوباب، ناتان، سلیمان،"}, {"ref": "1 Chronicles 1:4", "text": "هغه د هارون اولاده او لاویان هم یو ځای راټول کړل. دا هغه لاویان وو چې د داود حضور ته راغلل:"}, {"ref": "1 Chronicles 1:4", "text": "داود ځینې لاویان د دې دپاره وټاکل چې د لوظ صندوق په مخکې خدمت وکړي. هغوی به د اسراییلو څښتن خدای یاداوه، د هغه شکر به یې ادا کاوه او ستاینه به یې کوله."}, {"ref": "1 Chronicles 1:4", "text": "«لاړ شه او زما خدمتګار داود ته ووایه چې څښتن داسې وایي: ته هغه څوک نه یې چې زما د اوسېدلو دپاره کور جوړ کړې."}, {"ref": "1 Chronicles 1:4", "text": "داود د هغه څخه زر جنګي ګاډۍ، اووه زره سپاره او شل زره پیاده عسکر ونیول. هغه د سلو جنګي ګاډیو دپاره اسونه وساتل او نور ټول یې ګوډ کړل."}, {"ref": "1 Chronicles 1:4", "text": "نو حانون د داود استازي ونیول، د هغوی ږیرې یې وخریلې، کالي یې د پښو نه تر ملا پورې وشکول او رخصت یې کړل."}, {"ref": "1 Chronicles 1:5", "text": "کله چې هغه ځوان ولیدل چې شاوول مړ شوی دی، نو هغه هم په خپلې تورې باندې ځان وغورځاوه او مړ شو."}, {"ref": "1 Chronicles 1:5", "text": "یبوسیانو وویل: «ته به ونه شې کولای چې دلته راننوځي!» خو داود د صهیون د غره کلا ونیوله چې وروسته د داود د ښار په نوم یاد شو."}, {"ref": "1 Chronicles 1:5", "text": "نو داود د ټول هېواد څخه د اسراییلو قوم راټول کړ، یعنې د مصر د پولې څخه نیولې چې په جنوب کې ده د حمات د غاښي پورې چې په شمال کې دی، د دې دپاره چې د خدای د لوظ صندوق د قریت یعاریم څخه اورشلیم ته راوړي."}, {"ref": "1 Chronicles 1:5", "text": "ایبحار، الیشوع، الیفالط،"}, {"ref": "1 Chronicles 1:5", "text": "اوري ییل چې د قهات د طایفې مشر ؤ او د هغه یوسلو شل تنه خپلوان،"}, {"ref": "1 Chronicles 1:5", "text": "اساف د هغوی مشر ؤ او زکریا د هغه مرستیال ؤ. یعییل، شمیراموت، یحییل، متتیا، الیاب، بنایاه، عوبید ادوم او یو بل سړی چې یعییل نومېده د دې دپاره ټاکل شوي وو چې چنګونه او ربابونه وغږوي. اساف په خپله شرنګېدونکی زنګ غږاوه"}, {"ref": "1 Chronicles 1:5", "text": "له هغه وخته چې ما د اسراییلو قوم د مصر څخه راخلاص کړ، تر نن ورځې پورې زه په کور کې نه یم اوسېدلی. هر چېرته چې زه د هغوی سره تللم، خېمه به زما کور ؤ."}, {"ref": "1 Chronicles 1:5", "text": "کله چې د دمشق سوریایانو د هددعزر پاچا د مرستې دپاره لښکر ورولېږه، داود په هغوی باندې حمله وکړه او دوه ویشت زره سوریایان یې ووژل."}, {"ref": "1 Chronicles 1:5", "text": "هغوی ډېر شرمېدل چې کور ته راستانه شي. کله چې داود له دې پېښې څخه خبر شو، نو هغوی ته یې خبر ورولېږه: «تر هغې پورې د اریحا په ښار کې پاتې شئ چې ستاسو ږیرې اوږدې شي او بیا بېرته کور ته راشئ.»"}, {"ref": "1 Chronicles 1:6", "text": "نو په دې ډول شاوول او د هغه درې زامن ټول یو ځای مړه شول او د هغه شاهي کورنۍ له منځه لاړه."}, {"ref": "1 Chronicles 1:6", "text": "داود خپلو لښکرو ته ویلي وو: «هغه لومړنی عسکر چې یو یبوسی ووژني، زما د لښکرو قوماندان به شي.» نو له دې امله چې د زرویه زوی یوآب لومړۍ حمله وکړه، هغه قوماندان شو."}, {"ref": "1 Chronicles 1:6", "text": "داود او ټول اسراییلیان د بعله ښار یعنې قریت یعاریم ته لاړل چې د یهودا په سیمه کې دی، د دې دپاره چې د خدای د لوظ صندوق چې د څښتن نوم ورباندې دی، راوړي - هغه څښتن چې تخت یې د اسماني مخلوقاتو د مجسمو دپاسه دی."}, {"ref": "1 Chronicles 1:6", "text": "نوجه، نفج، یافیع،"}, {"ref": "1 Chronicles 1:6", "text": "عسایا چې د مراري د طایفې مشر ؤ او د هغه دوه سوه او شل تنه خپلوان،"}, {"ref": "1 Chronicles 1:6", "text": "او دوو کاهنانو یعنې بنایاه او یحزییل به په دوامداره توګه د لوظ د صندوق په مخکې سرني غږول."}, {"ref": "1 Chronicles 1:6", "text": "ما د قوم مشران غوره کړل او ورته مې وویل چې د شپنو په شان زما د قوم اسراییلو لارښوونه وکړي. خو ایا کله مې د هغوی څخه چاته په ټول سفر کې ویلي دي چې د سبر د ونې د لرګیو څخه دې ولې زما دپاره کور نه دی جوړ کړی؟"}, {"ref": "1 Chronicles 1:6", "text": "بیا هغه د دمشق د سوریې په پاچاهۍ کې عسکري قرارګاوې جوړې کړې او سوریایان د هغه رعیت شول او باج یې ورکاوه. هر چېرته چې به داود لاړ، څښتن هغه ته بری ورکاوه."}, {"ref": "1 Chronicles 1:6", "text": "حانون پاچا او عمونیان په دې پوه شول چې هغوی داود خپل دښمن کړ. نو هغوی څلوردېرش ټنه سپین زر ولېږل د دې دپاره چې د بین النهرین، د سوریې د معکه او د صوبه له سیمو څخه جنګي ګاډۍ او د هغو چلوونکي اجیر کړي."}, {"ref": "1 Chronicles 1:7", "text": "کله چې هغو اسراییلیانو چې د یزرعیل په دره کې اوسېدل، دا خبره واورېدله چې لښکرې تښتېدلې دي او شاوول او د هغه زامن مړه شوي دي، هغوی خپل ښارګوټي پرېښودل او وتښتېدل. نو فلسطینیان راغلل او په دغو ښارونو کې ځای په ځای شول."}, {"ref": "1 Chronicles 1:7", "text": "وروسته داود هماغې کلا ته کډه وکړه، نو ځکه هغه د داود د ښار په نوم یاد شو."}, {"ref": "1 Chronicles 1:7", "text": "هغوی د ابیناداب د کور څخه د لوظ صندوق راوویست او په یوې نوې ګاډۍ باندې یې کېښود. عزه او اخیو د ګاډۍ د لارښوونې دپاره د هغې سره تلل"}, {"ref": "1 Chronicles 1:7", "text": "الیشمع، بعلیاداع او الیفلط."}, {"ref": "1 Chronicles 1:7", "text": "یوییل چې د جرشون د طایفې مشر ؤ او د هغه یو سل او دېرش تنه خپلوان،"}, {"ref": "1 Chronicles 1:7", "text": "داود په هغه ورځ د لومړي ځل دپاره اساف او د هغه ورونو ته دنده ورکړه چې د څښتن په حضور کې د هغه د ستاینې دا سندره ووایي:"}, {"ref": "1 Chronicles 1:7", "text": "نو په دې خاطر زما خدمتګار داود ته ووایه چې مطلق قادر څښتن درته داسې وایي: ما ته د پسونو د ساتلو د څړځای څخه راواخیستلې او د خپل قوم اسراییلو مشر مې وټاکلې."}, {"ref": "1 Chronicles 1:7", "text": "داود د هددعزر د عسکري منصبدارانو د سرو زرو سپرونه واخیستل او هغه یې اورشلیم ته راوړل."}, {"ref": "1 Chronicles 1:7", "text": "دوه دېرش زره جنګي ګاډۍ او د معکه پاچا او د هغه لښکرې راغلې او د میدیبا سره نژدې یې خېمې ودرولې. د عمونیانو لښکرې هم له خپلو ښارګوټو څخه د جګړې دپاره راټولې شولې."}, {"ref": "1 Chronicles 1:8", "text": "له جګړې یوه ورځ وروسته فلسطینیان د مړو د لوټلو دپاره ورغلل، نو هغوی د شاوول او د هغه د زامنو مړي وموندل چې د جلبوع په غره کې پراته وو."}, {"ref": "1 Chronicles 1:8", "text": "هغه د ښار شاوخوا سیمه پراخه کړه، په هغه ځای کې یې کار پیل کړ چې ځمکه یې د غونډۍ له ختیځې خوا ډکه وه او یوآب پاتې ښار بېرته جوړ کړ."}, {"ref": "1 Chronicles 1:8", "text": "ځینې کسان د جاد له قبیلې څخه چې په جګړه کې تجربه لرونکي او زړور خلک وو، د دښتې په خوندي ځای کې چې داود په کې ؤ، هغه ته ورواوښتل. دوی ټولو د سپرونو او نېزو په کارولو کې مهارت درلود. هغوی د زمریو په شان هیبتناک او د غرنیو هوسیو په شان تېز او چالاک وو."}, {"ref": "1 Chronicles 1:8", "text": "او داود او ټولو خلکو په خپل ټول توان سره خدای ته د درناوي په خاطر نڅا ګانې کولې. هغوی سندرې ویلې او د موسیقۍ دغه الې یې غږولې: ربابونه، چنګونه، چمبې، شرنګېدونکی زنګ او سرني."}, {"ref": "1 Chronicles 1:8", "text": "کله چې فلسطینیانو واورېدل چې داود د اسراییلو په ټول هېواد باندې د پاچا په توګه ټاکل شوی دی، هغوی د پوره قوت سره ووتل چې داود ونیسي. خو داود د هغوی د پلان څخه خبر شو او لاړ چې په جګړه کې ورسره مقابله وکړي."}, {"ref": "1 Chronicles 1:8", "text": "شمعیه چې د الیصافان د طایفې مشر ؤ او د هغه دوه سوه تنه خپلوان،"}, {"ref": "1 Chronicles 1:8", "text": "کوئ شکر د څښتن او کړئ دعا د هغه په نوم ووایئ دا نورو قومونو ته څه چې کړي دي هغه"}, {"ref": "1 Chronicles 1:8", "text": "هر چېرې چې ته تللې، زه به درسره وم. څنګه به چې ته پرمخ تللې، ما به ستا ټول دښمنان له منځه وړل. اوس به تاته یو نوم درکړم لکه څنګه چې مې د نړۍ ډېرو لویو مشرانو ته ورکړی دی."}, {"ref": "1 Chronicles 1:8", "text": "داود د طبحت او کونه څخه چې د هددعزر ښارونه وو، په زیاته اندازه برنجي فلز لاسته راوړل. وروسته سلیمان د دې برنجو څخه د خدای د کور د اوبو د ټانکۍ، ستنو او برنجي لوښو په جوړولو کې کار واخیست."}, {"ref": "1 Chronicles 1:8", "text": "داود د دې نه خبر شو او یوآب یې له ټول لښکر سره د هغوی مقابلې ته ورولېږه."}, {"ref": "1 Chronicles 1:9", "text": "دوی د شاوول سر پرې کړ، د هغه څخه یې زغرې وویستلې او د فلسطین ټول هېواد ته یې استازي ولېږل چې دا زېری د خپلو بتانو او خپلو خلکو په منځ کې خپور کړي."}, {"ref": "1 Chronicles 1:9", "text": "داود نور هم قوي شو، ځکه چې مطلق قادر څښتن د هغه سره مل ؤ."}, {"ref": "1 Chronicles 1:9", "text": "څنګه چې دوی د کیدون درمند ځای ته ورسېدل، غویان وښویېدل او عزه خپل لاس وراوږد کړ او د لوظ صندوق یې ونیوه."}, {"ref": "1 Chronicles 1:9", "text": "نو فلسطینیان راغلل او د رفاییم په دره یې حمله وکړه."}, {"ref": "1 Chronicles 1:9", "text": "ایلي ییل چې د حبرون د طایفې مشر ؤ او د هغه اتیا تنه خپلوان،"}, {"ref": "1 Chronicles 1:9", "text": "ووایئ حمد هغه ته هغه ته ووایئ د ثنا او صفت سندره هغه چې کړي عجیبه کارونه کړئ یې بیان خلکو ته"}, {"ref": "1 Chronicles 1:9", "text": "د حمات پاچا توعو واورېدل چې داود د هددعزر ټول لښکر ته ماتې ورکړې ده."}, {"ref": "1 Chronicles 1:9", "text": "عمونیان راووتل او د خپل پایتخت ربه د دروازې په خوله کې ځای په ځای شول. د سوریې لښکرې په صحرا کې ځای په ځای شوې."}, {"ref": "1 Chronicles 1:10", "text": "دوی د شاوول وسلې د خپلو بتانو په عبادت خانه کې کېښودلې او د هغه سر یې د خپل بت یعنې د داجون په عبادت خانه کې ځوړند کړ."}, {"ref": "1 Chronicles 1:10", "text": "دا د هغو نامتو جنګیالیو نومونه دي چې د اسراییلو د خلکو په مرسته یې د داود پاچاهي قوي او ټینګه کړه، ترڅو د څښتن د وعدې سره سم د هغوی پاچا شي:"}, {"ref": "1 Chronicles 1:10", "text": "څښتن په عزه باندې ډېر په قهر شو او هغه یې وواژه، ځکه چې د لوظ صندوق یې لمس کړ. هغه هلته د خدای په حضور کې مړ شو."}, {"ref": "1 Chronicles 1:10", "text": "داود د خدای نه پوښتنه وکړه: «ایا په فلسطینیانو باندې حمله وکړم؟ ایا ماته به بری راکړې؟» څښتن ځواب ورکړ: «هو، ورباندې حمله وکړه! زه به تاته بری درکړم!»"}, {"ref": "1 Chronicles 1:10", "text": "او عمیناداب چې د عزییل د طایفې مشر ؤ او د هغه یو سل او دولس تنه خپلوان."}, {"ref": "1 Chronicles 1:10", "text": "په پاک نوم د هغه وکړئ افتخار وي دې خوشحاله څوک چې کاندي عبادت د هغه"}, {"ref": "1 Chronicles 1:10", "text": "نو هغه خپل زوی هدورام، داود پاچا ته ورولېږه چې هغه ته سلام ووایي او په جګړه کې په هددعزر باندې د هغه د بریالیتوب مبارکي ووایي. هددعزر څو ځلې له توعو سره جنګېدلی ؤ. هدورام داود ته هر ډول سوغاتونه یعنې د سرو زرو، سپینو زرو او برنجي شیان له ځان سره راوړل."}, {"ref": "1 Chronicles 1:10", "text": "یوآب ولیدل چې د دښمن لښکر به په هغه باندې مخامخ او د شا له خوا حمله وکړه، نو هغه د اسراییلو د عسکرو څخه ډېر ښه عسکر وټاکل او هغوی یې سوریایانو ته مخامخ ځای په ځای کړل."}, {"ref": "1 Chronicles 1:11", "text": "کله چې په جلعاد کې د یابیش د ښار ټولو خلکو د هغه څه په اړه چې فلسطینیانو په شاوول باندې کړي وو، واورېدل،"}, {"ref": "1 Chronicles 1:11", "text": "له دغو جنګیالیو څخه لومړنی جنګیالی د حکمون زوی یشوبعام ؤ او هغه د «درېو جنګیالیو» مشر ؤ. هغه په خپلې نېزې باندې له درې سوه کسانو سره جګړه وکړه او هغوی ټول یې په یو وخت کې ووژل."}, {"ref": "1 Chronicles 1:11", "text": "نو داود په قهر شو، ځکه چې څښتن په قهر سره عزه ته سزا ورکړه او تر نن ورځې پورې هغه ځای د فارز عزه په نوم یادیږي."}, {"ref": "1 Chronicles 1:11", "text": "نو داود بعل فراسیم ته لاړ او هلته یې فلسطینیانو ته ماته ورکړه. هغه وویل: «خدای زما په لاسونو د دښمنانو کرښې ماتې کړې.» نو هغه ځای د بعل فراسیم په نوم یاد شو."}, {"ref": "1 Chronicles 1:11", "text": "بیا داود صادوق او ابیاتار کاهنان او شپږ لاویان یعنې اوري ییل، عسایا، یوییل، شمعیه، ایلییل او عمیناداب راوغوښتل."}, {"ref": "1 Chronicles 1:11", "text": "د څښتن څخه کومک وغواړئ تل یې وکړئ عبادت"}, {"ref": "1 Chronicles 1:11", "text": "هغه ورځ چې ستا سترګې د دې نړۍ څخه پټې شوې او د خپلو نیکونو سره ښخ شوې، زه به ستا د زامنو څخه یو پاچا کړم او د هغه پاچاهي به ټینګه وساتم."}, {"ref": "1 Chronicles 1:11", "text": "داود پاچا هغه سامان د هغو سپینو او سرو زرو سره یوځای څښتن ته وقف کړل چې د ادومیانو، موآبیانو، عمونیانو، فلسطینیانو او عمالیقیانو څخه یې د بري په وخت کې نیولي وو."}, {"ref": "1 Chronicles 1:11", "text": "یوآب د خپلو لښکرو پاتې کسان د خپل ورور ابیشای تر قوماندې لاندې ورکړل او ابیشای هغوی د عمونیانو په وړاندې ځای په ځای کړل."}, {"ref": "1 Chronicles 1:12", "text": "تر ټولو زړور سړي لاړل، د شاوول او د هغه د زامنو مړي یې راوړل او یابیش ته یې یووړل. هغوی دا مړي هلته د څېړۍ د ونې لاندې ښخ کړل او اووه ورځې یې روژه ونیوله."}, {"ref": "1 Chronicles 1:12", "text": "دوهم یې العازار ؤ چې د دودو زوی ؤ او د اخوخ د طایفې څخه ؤ."}, {"ref": "1 Chronicles 1:12", "text": "په هغه ورځ داود د څښتن څخه ډېر ووېرېده او ویې ویل: «اوس به څنګه وکولای شم چې د خدای د لوظ صندوق د ځان سره یوسم؟»"}, {"ref": "1 Chronicles 1:12", "text": "کله چې فلسطینیان وتښتېدل، بیا داود خپلو لښکرو ته امر ورکړ: «هغه بتان چې د فلسطینیانو څخه پاتې شوي دي، وسوځوئ.»"}, {"ref": "1 Chronicles 1:12", "text": "هغه دغو لاویانو ته وویل: «تاسو د لاوي د طایفو مشران یئ. تاسو او ستاسو ملګري خپل ځانونه پاک کړئ، ترڅو وکولای شئ چې د اسراییلو د څښتن خدای د لوظ صندوق هغه ځای ته راوړئ چې ما د هغه دپاره تیار کړی دی."}, {"ref": "1 Chronicles 1:12", "text": "هغه به هغه څوک وي چې زما دپاره به یو کور جوړ کړي او د هغه پاچاهي به زه د تل دپاره ټینګه کړم."}, {"ref": "1 Chronicles 1:12", "text": "د زرویه زوی ابیشای د مالګې په دره کې د ادومیانو لښکرو ته ماتې ورکړه او د هغوی د لښکرو اتلس زره تنه یې ووژل."}, {"ref": "1 Chronicles 1:12", "text": "یوآب هغه ته وویل: «که چېرې تا ولیدل چې سوریایانو ماته ماتې راکوله، نو راشه او زما سره مرسته وکړه او که چېرې عمونیانو تاته ماتې درکوله، نو زه به ستا مرستې دپاره درشم."}, {"ref": "1 Chronicles 1:13", "text": "کله چې فلسطینیان هلته د جګړې دپاره راټول شول، العازار د داود سره په فسدمیم کې ؤ. په یو داسې ځای کې چې د اوربشو څخه ډک پټی په کې ؤ، اسراییلي عسکر له فلسطینیانو څخه وتښتېدل."}, {"ref": "1 Chronicles 1:13", "text": "نو هغه صندوق د ځان سره د داود ښار ته یو نه وړ. د هغې په ځای یې هغه د عوبید ادوم جتي کور ته یووړ."}, {"ref": "1 Chronicles 1:13", "text": "څه موده وروسته فلسطینیان بېرته درې ته راستانه شول او بیا یې حمله پیل کړه."}, {"ref": "1 Chronicles 1:13", "text": "دا چې د لومړي ځل دپاره تاسو هلته نه وئ چې هغه یوسئ، زمونږ څښتن خدای مونږ ته سزا د دې دپاره راکړه چې مونږ په مناسب ډول د هغه عبادت ونه کړ.»"}, {"ref": "1 Chronicles 1:13", "text": "زه به د هغه پلار یم او هغه به زما زوی وي. زه به خپله تلپاتې مینه ورڅخه لېرې نه کړم لکه څنګه چې مې د شاوول نه لېرې کړې وه، څوک چې ستا نه مخکې پاچا ؤ."}, {"ref": "1 Chronicles 1:13", "text": "هغه په ټول ادوم کې عسکري قرارګاوې جوړې کړې او ټول ادومیان د داود رعیت شول. داود به چې هر چېرته لاړ، څښتن به ورته بری ورکاوه."}, {"ref": "1 Chronicles 1:13", "text": "قوي او زړور اوسه! راځه چې د خپل قوم او د خدای د ښارونو دپاره په مېړانه او زړورتیا سره وجنګېږو. څه چې د څښتن رضا وي هغه دې وشي!»"}, {"ref": "1 Chronicles 1:14", "text": "خو العازار او د هغه سړیو د پټي په منځ کې ځانونه ټینګ کړل او فلسطینیانو ته یې ماتې ورکړه. څښتن هغوی ته یو لوی بریالیتوب ور په برخه کړ."}, {"ref": "1 Chronicles 1:14", "text": "نوموړي کسان د لښکرو قوماندانان وو. د ټیټې رتبې خاوندان یې د سلو کسانو او لوړ رتبه یې د زرو کسانو قوماندانان وو."}, {"ref": "1 Chronicles 1:14", "text": "د خدای د لوظ صندوق درې میاشتې هلته پاتې شو او څښتن د عوبید ادوم کورنۍ او هر هغه شي ته چې یې درلود، برکت ورکړ."}, {"ref": "1 Chronicles 1:14", "text": "داود یوځل بیا د خدای سره مشوره وکړه، خدای ځواب ورکړ: «د دې ځای نه حمله مه کوه، بلکې د شا له خوا ورباندې راتاو شه او د بلسام ونو ته مخامخ په هغوی باندې حمله وکړه."}, {"ref": "1 Chronicles 1:14", "text": "بیا کاهنانو او لاویانو خپل ځانونه پاک کړل. هغوی تیار شول چې د اسراییلو د څښتن خدای د لوظ صندوق یوسي."}, {"ref": "1 Chronicles 1:14", "text": "دی څښتن زمونږه خدای راولي چې عدالت د ځمکې سر باندې هرځای"}, {"ref": "1 Chronicles 1:14", "text": "زه به د تل دپاره ستا زوی د خپل قوم او پاچاهۍ مشر کړم. د هغه پاچاهي به هېڅکله پای ته ونه رسیږي.»"}, {"ref": "1 Chronicles 1:14", "text": "داود په ټولو اسراییلو باندې پاچاهي کوله او د خپلو ټولو خلکو دپاره یې په عدل او انصاف سره کارونه کول."}, {"ref": "1 Chronicles 1:14", "text": "نو یوآب او د هغه سړي مخکې لاړل چې حمله وکړي او سوریایان وتښتېدل."}, {"ref": "1 Chronicles 1:15", "text": "یوه ورځ له هغو دېرشو مشرانو جنګیالیو څخه درې تنه یو ګټ ته چې د عدولام سمڅې ته نژدې او داود په کې ؤ، راغلل. په هغه وخت کې د فلسطینیانو یوې ډلې د رفاییم په دره کې خېمې درولې وې."}, {"ref": "1 Chronicles 1:15", "text": "د کال په لومړنۍ میاشت کې یعنې په هغه وخت کې چې د اردن د سیند اوبه د سیند له غاړو واوښتلې، هغوی د سیند نه تېر شول او په هغو خلکو پسې شول او خواره واره یې کړل چې د سیند د دواړو غاړو په درو کې اوسېدل."}, {"ref": "1 Chronicles 1:15", "text": "کله چې دې د بلسام د ونو په سر کې د قدمونو اواز واورېده، نو بیا په بیړه حمله وکړه، ځکه چې دا به دا معنی ولري چې زه ستا په مخکې روان یم چې د فلسطینیانو لښکرو ته ماتې ورکړم.»"}, {"ref": "1 Chronicles 1:15", "text": "لاویانو دا صندوق د ستنو په وسیله په خپلو اوږو باندې یووړ لکه څنګه چې څښتن د موسی په وسیله حکم کړی ؤ."}, {"ref": "1 Chronicles 1:15", "text": "تاسې هېڅکله هېر نه کړئ د خدای لوظ نه کړئ وعده د هغه هېره تر زرو نسلونو پورې"}, {"ref": "1 Chronicles 1:15", "text": "ناتان داود ته هر هغه څه بیان کړل چې خدای ورته په رویا کې ښکاره کړي وو."}, {"ref": "1 Chronicles 1:15", "text": "یوآب د زرویه زوی د لښکرو عمومي قوماندان ؤ. یهوشافاط د اخیلود زوی د پېښو د ثبتولو مسوول ؤ."}, {"ref": "1 Chronicles 1:15", "text": "کله چې عمونیانو ولیدل چې سوریایان تښتي، هغوی د ابیشای څخه وتښتېدل او ښار ته ننوتل. بیا یوآب اورشلیم ته راستون شو."}, {"ref": "1 Chronicles 1:16", "text": "داود هغه وخت په خپل خوندي ځای کې ؤ او د فلسطینیانو یوې ډلې بیت لحم نیولی ؤ."}, {"ref": "1 Chronicles 1:16", "text": "یوځل د بنیامین او یهودا د قبیلو څخه یوه ډله سړي هغه خوندي ځای ته لاړل چې داود په کې اوسېده."}, {"ref": "1 Chronicles 1:16", "text": "نو څنګه چې خدای داود ته حکم کړی ؤ، هماغسې یې وکړل او فلسطینیان یې د جبعون نه تر جازر پورې په ټوله لاره کې تعقیب کړل او ویې وژل."}, {"ref": "1 Chronicles 1:16", "text": "همدارنګه داود د لاویانو مشرانو ته وویل: «د خپلو خپلوانو څخه ځینې کسان وټاکئ چې د خوشحالۍ سندرې ووایي او چنګونه، ربابونه او شرنګېدونکی زنګ وغږوي.»"}, {"ref": "1 Chronicles 1:16", "text": "هغه لوظ چې هغه وکړ ابراهیم سره هغه قسم چې هغه وکړ د اسحاق سره"}, {"ref": "1 Chronicles 1:16", "text": "بیا داود پاچا د لوظ د صندوق خېمې ته ورننوت، هلته د څښتن په حضور کې کښېناست او دعا یې وکړه: «ای څښتن خدایه! هغه څه چې تا پخوا زما سره کړي دي زه او زما کورنۍ د هغې وړ نه یو."}, {"ref": "1 Chronicles 1:16", "text": "صادوق د اخیطوب زوی او اخیملک د ابیاتار زوی کاهنان وو. شوشا د دربار منشي ؤ."}, {"ref": "1 Chronicles 1:16", "text": "کله چې سوریایان پوه شول چې دوی ته اسراییلو ماتې ورکړه، هغوی خپل هغه عسکر راوغوښتل چې د فرات د سیند په ختیځه خوا کې ځای په ځای شوي وو. د هددعزر د لښکرو قوماندان شوفک دا سړي عمون ته بوتلل."}, {"ref": "1 Chronicles 1:17", "text": "داود ارمان وکړ او ویې ویل: «کاشکې څوک د هغې څاه څخه چې د بیت لحم دروازې ته نژدې دی، ماته اوبه راوړي.»"}, {"ref": "1 Chronicles 1:17", "text": "داود د هغوی سره دباندې لیدنه او کتنه وکړه او ورته ویې ویل: «که چېرې تاسو د ملګرو په توګه راغلي یئ چې زما په طرفدارۍ جګړه وکړئ، بیا پاتې شئ او زمونږ سره لاس یو کړئ. خو که چېرې تاسو دا هڅه وکړئ چې ما خپلو دښمنانو ته تسلیم کړئ، هغه خدای چې زمونږ نیکونو یې عبادت کاوه، تاسو ته به سزا درکړي، ځکه چې ما کوم ظلم او تېری نه دی کړی.»"}, {"ref": "1 Chronicles 1:17", "text": "نو داود په ټولو هېوادونو کې مشهور شو او څښتن د دې سبب شو چې ټول قومونه د هغه څخه ووېریږي."}, {"ref": "1 Chronicles 1:17", "text": "هغه یې ورکړلو یعقوب ته د یو حکم په شان او اسراییلو ته د ابدي لوظ په توګه"}, {"ref": "1 Chronicles 1:17", "text": "خو بیاهم دا ستا په نظر بس نه وو! تا د راتلونکو ډېرو کلونو دپاره هم زما د اولادې یعنې شاهي کورنۍ په هکله وعدې کړې دي. ای څښتن خدایه، ته زما سره داسې چلند کوې لکه زه چې یو ډېر مهم سړی یم."}, {"ref": "1 Chronicles 1:17", "text": "بنایاه د یهویاداع زوی د داود د ساتونکو یعنې د کریتیانو او د فلیتیانو قوماندان ؤ او د داود زامن د هغه لومړي مرستیالان وو."}, {"ref": "1 Chronicles 1:17", "text": "کله چې داود دا واورېدل، هغه د اسراییلو ټولې لښکرې سره راټولې کړې، د اردن د سیند نه تېر شو او خپل عسکر یې د سوریایانو لښکرو ته مخامخ ځای په ځای کړل. جګړه پیل شوه،"}, {"ref": "1 Chronicles 1:18", "text": "نو هغو درېو زړورو سړیو د فلسطینیانو کرښې ماتې کړې، د څاه څخه یې اوبه راوویستلې او داود ته یې راوړې، خو داود هغه ونه څښلې او هغه یې د نذرانې په توګه څښتن ته توی کړې."}, {"ref": "1 Chronicles 1:18", "text": "بیا په عماسای باندې د خدای روح نازل شو، (هغه څوک چې وروسته د دېرشو جنګیالیو مشر شو) او ویې ویل: د یسي زویه داوده، مونږه ستا یو! بریالی دې اوسې ته او هغه څوک دې بریالی وي چې کوي تا سره مرسته! ځکه چې خدای دی مرستندوی ستا وروسته داود هغوی ته هرکلی ووایه او د خپلو هغو عسکرو مسوولان یې وټاکل چې په دښمنانو باندې یې یرغل کاوه."}, {"ref": "1 Chronicles 1:18", "text": "هغه وویل: تاسو ته در به کړم وطن د کنعان وي به هغه د ستاسو خپل ملکیت"}, {"ref": "1 Chronicles 1:18", "text": "زه ستا خدمتګار یم او ته مې پېژنې. زه نور څه ویلی شم؟ تا زما درناوی کړی دی!"}, {"ref": "1 Chronicles 1:18", "text": "خو د سوریایانو لښکرې د اسراییلیانو څخه وتښتېدلې. داود اووه زره د جنګي ګاډیو چلوونکي او څلوېښت زره پیاده عسکر ووژل. هغه شوفک هم وواژه چې د هغوی قوماندان ؤ."}, {"ref": "1 Chronicles 1:19", "text": "داود وویل: «خدای دې نه کړي چې زه دا اوبه وڅښم! دا به د هغو سړیو د وینو د څښلو په شان وي چې خپل ژوند یې په خطر کې اچولی ؤ!» نو هغه دا اوبه ونه څښلې. دا د هغو درېو زړورو کسانو کارونه وو."}, {"ref": "1 Chronicles 1:19", "text": "هغه وخت چې داود د فلسطینیانو سره د شاوول په ضد جګړې ته لاړ، یو شمېر د منسي خلک د داود په خوا شول. خو کله چې د فلسطینیانو پاچاهان په دې پوه شول چې کېدای شي داود د هغوی سره خیانت وکړي او د پخوا په شان به د شاوول سره لاس یو کړي، هغوی داود بېرته د صقلغ ښارګوټي ته ولېږه."}, {"ref": "1 Chronicles 1:19", "text": "کله چې شمېر د خدای د خلکو کم ؤ وو پردي د کنعان خاوره کې دوی"}, {"ref": "1 Chronicles 1:19", "text": "ای څښتنه! زما په خاطر او د خپل مقصد دپاره دې دا ټول لوی کارونه وکړل او هغه دې ښکاره کړل."}, {"ref": "1 Chronicles 1:19", "text": "هغه پاچاهان چې د هددعزر تابع وو، کله چې هغوی ولیدل چې د اسراییلو له خوا یې ماتې وخوړله، نو د داود سره یې سوله وکړه او د هغه رعیت شول. سوریایانو نه غوښتل چې بیا د عمونیانو سره مرسته وکړي."}, {"ref": "1 Chronicles 1:20", "text": "ابیشای د یوآب ورور د دېرش کسیزې ډلې مشر ؤ. هغه په خپلې نېزې باندې له درې سوه کسانو سره جګړه وکړه او هغوی یې ووژل. نو په دې توګه هغه هم لکه د هغو درېو جنګیالیو په شان مشهور شو."}, {"ref": "1 Chronicles 1:20", "text": "دا د منسي هغه عسکر وو چې په هغه وخت کې یې د داود سره لاس یو کړ: عدناح، یوزاباد، یدیعییل، میکاییل، یوزاباد، الیهو او صلتای. هغوی ټول په منسي کې د زر کسیزو فرقو قوماندانان وو."}, {"ref": "1 Chronicles 1:20", "text": "دوی سرګردانه ګرځېدل به د یو وطن نه بل وطن ته تلل یوې او بلې پاچاهۍ ته هغوی"}, {"ref": "1 Chronicles 1:20", "text": "څښتنه، هېڅوک ستا په شان نه دی. لکه څنګه چې مونږ تل اورېدلي دي، بې له تا بل خدای نشته."}, {"ref": "1 Chronicles 1:21", "text": "که څه هم هغه په هغې دېرش کسیزې ډلې کې ډېر زیات مشهور او د هغوی مشر شو، خو د هغو درېو تنو په شان مشهور نه شو."}, {"ref": "1 Chronicles 1:21", "text": "هغوی د داود سره مرسته کوله چې د یرغلګرو ډلو سره وجنګیږي، ځکه چې هغوی ټول زړور جنګیالي وو. وروسته هغوی د اسراییلو په لښکرو کې قوماندانان شول."}, {"ref": "1 Chronicles 1:21", "text": "خو خدای پرېنښودل هېڅوک چې په دوی ظلم وکړي د دوی دپاره یې شاهان ورټل"}, {"ref": "1 Chronicles 1:21", "text": "د ځمکې په مخ د اسراییلو په شان بل قوم نشته، هغه قوم چې تا هغوی د مصر د غلامۍ څخه وژغورل، د دې دپاره چې هغه ستا خپل قوم شي. د هغوی دپاره دې لوی او حیرانوونکي کارونه وکړل او خپل نوم دې په ټوله نړۍ کې مشهور او لوړ کړ. تا خپل قوم اسراییل د مصر څخه وژغوره او د هغه د وړاندې تګ سره سم دې نور قومونه وشړل."}, {"ref": "1 Chronicles 1:22", "text": "بنایاه د یهویاداع زوی چې د قبصییل څخه ؤ، یو توریالی عسکر ؤ. هغه ډېر د زړورتوب کارونه کړي وو چې په هغو کې د دوو قوي موآبي جنګیالیو وژل شامل وو. یوځل هغه د واورې په ورځ یوې کندې ته ورښکته شو او یو زمری یې وواژه."}, {"ref": "1 Chronicles 1:22", "text": "ورځ په ورځ به نوي کسان راتلل او د داود سره به یې لاس یو کاوه، نو زر هغه د یو لوی او قوي لښکر خاوند شو، چې دا د خدای لښکر ؤ."}, {"ref": "1 Chronicles 1:22", "text": "کننیا د لاوي ساز غږوونکو مسوول وټاکل شو، ځکه چې هغه په خپله یو تکړه ساز غږوونکی ؤ."}, {"ref": "1 Chronicles 1:22", "text": "ویې وویل هغوی ته: زما غوره شویو بنده ګانو ته به لاس نه وروړئ ضرر به نه رسوئ زما پیغمبرانو ته"}, {"ref": "1 Chronicles 1:22", "text": "اسراییل دې د تل دپاره خپل قوم غوره کړ او ای څښتنه، ته د هغوی خدای شوې."}, {"ref": "1 Chronicles 1:23", "text": "همدارنګه هغه یو مصری وواژه چې قد یې له دوو مترو لوړ ؤ او یوه نېزه ورسره وه چې د اوبدلو د کارګاه د میلې په شان غټه وه. بنایاه د خپلې امسا سره په هغه باندې حمله وکړه، د هغه مصري د لاس څخه یې نېزه واخیستله او هغه یې ورباندې وواژه."}, {"ref": "1 Chronicles 1:23", "text": "کله چې داود په حبرون کې ؤ، ډېرو په وسلو سمبال شویو کسانو د هغه له لښکرو سره لاسونه یو کړل، ترڅو هغه د شاوول په ځای پاچا کړي، لکه څنګه چې څښتن وعده کړې وه. د هغوی شمېر په لاندې ډول ؤ:"}, {"ref": "1 Chronicles 1:23", "text": "ای ټولې نړۍ، سندره ووایئ څښتن ته تاسې اعلان کړئ هره ورځ دا زېری چې نجات یې دی راکړی مونږ ته"}, {"ref": "1 Chronicles 1:23", "text": "ای څښتنه! اوس هغه وعده د تل دپاره سرته ورسوه چې زما او زما د کورنۍ سره دې کړې ده. هغه څه چې دې ویلي وو، هماغسې وکړه."}, {"ref": "1 Chronicles 1:24", "text": "بنایاه داسې د زړورتوب کارونه وکړل چې د درېو جنګیالیو په شان مشهور شو."}, {"ref": "1 Chronicles 1:24", "text": "د یهودا د قبیلې څخه: ۶۸۰۰ تنه ښه سمبال شوي کسان چې سپرونه او نېزې ورسره وې."}, {"ref": "1 Chronicles 1:24", "text": "کړئ قومونو ته اعلان د هغه جلال ټولو خلکو ته اعلان کړئ د هغه ډېر عجیبه کارونه"}, {"ref": "1 Chronicles 1:24", "text": "ستا نوم به لوی وي او خلک به د تل دپاره وایي: مطلق قادر څښتن د اسراییلو خدای دی. بیا به زما د اولادې پاچاهي د تل دپاره ټینګه وي."}, {"ref": "1 Chronicles 1:25", "text": "د هغه عزت د هغې دېرش کسیزې ډلې څخه ډېر زیات شو، خو په درېو جنګیالیو کې نه شمېرل کېده. داود هغه د خپلو ساتونکو مشر وټاکه."}, {"ref": "1 Chronicles 1:25", "text": "د شمعون د قبیلې څخه: ۷۱۰۰ تنه زړور جنګیالي."}, {"ref": "1 Chronicles 1:25", "text": "نو داود، د اسراییلو مشران او د لښکرو قوماندانان لاړل چې د څښتن د لوظ صندوق د عوبید ادوم له کوره د جشن په نیولو سره راوړي."}, {"ref": "1 Chronicles 1:25", "text": "ځکه چې لوی دی څښتن او ډېر لایق دی د ثنا او صفت ټولو خدایانو نه دې زیاته وېره وشي له ده"}, {"ref": "1 Chronicles 1:25", "text": "دا ټول تا ماته ښکاره کړي دي او ماته دې وویل چې زما اولاده به ته پاچاهان کړې، نو ځکه مې ای خدایه دا جرات وکړ چې تاته دا دعا وکړم."}, {"ref": "1 Chronicles 1:26", "text": "دا نور نامتو جنګیالي دي: عساهیل د یوآب ورور الحانان د دودو زوی له بیت لحم څخه"}, {"ref": "1 Chronicles 1:26", "text": "د لاوي د قبیلې څخه: ۴۶۰۰ تنه."}, {"ref": "1 Chronicles 1:26", "text": "له دې امله چې څښتن د لوظ د صندوق په وړلو کې د لاویانو سره مرسته وکړه، نو هغوی اووه غویان او اووه پسونه قرباني کړل."}, {"ref": "1 Chronicles 1:26", "text": "نورو قومونو ټول خدایان دي بې ګټې بتان خو څښتن دي پیدا کړي اسمانونه"}, {"ref": "1 Chronicles 1:26", "text": "څښتنه، ته په رښتیا خدای یې او تا د خپل خدمتګار سره د دې ښو شیانو وعده کړې ده."}, {"ref": "1 Chronicles 1:27", "text": "شموت له هرور څخه حالز له فلون څخه"}, {"ref": "1 Chronicles 1:27", "text": "یهویاداع د هارون د کورنۍ مشر د ۳۷۰۰ تنو سره."}, {"ref": "1 Chronicles 1:27", "text": "داود او هغو لاویانو چې صندوق یې لېږداوه، کننیا د موسیقۍ مسوول او ټولو سندرغاړو د ښه کتان چپنې اغوستې وې او داود هم د کتان پېشبند اغوستی ؤ."}, {"ref": "1 Chronicles 1:27", "text": "دی راچاپېره له هغه نه جلال او لویي د اوسېدلو ځای یې ډک دی له خوښۍ او قوت"}, {"ref": "1 Chronicles 1:27", "text": "اوس مهرباني وکړه زما کورنۍ ته د تل دپاره برکت ورکړه او پرېږده چې هغوی تل ستا غوره شوي پاچاهان وي. څښتنه، تا پخوا زما کورنۍ ته برکت ورکړی ؤ او زه پوهېږم چې ته به مونږ ته د تل دپاره برکت راکړې.»"}, {"ref": "1 Chronicles 1:28", "text": "عیرا د عقیش زوی له تقوع څخه ابیعزر له عناتوت څخه"}, {"ref": "1 Chronicles 1:28", "text": "صادوق، یو زړور ځوان او د هغه د پلار د کورنۍ افسران: ۲۲ تنه."}, {"ref": "1 Chronicles 1:28", "text": "نو ټولو اسراییلیانو د خوشحالۍ په چیغو او د سرنیو، شرنګېدونکو زنګونو، چنګونو او د ربابونو په غږولو سره د څښتن د لوظ صندوق اورشلیم ته راوړ."}, {"ref": "1 Chronicles 1:28", "text": "وکړئ ستاینه د څښتن په ځمکه ټولو خلکو هم ستاینه وکړئ د هغه د جلال او قدرت"}, {"ref": "1 Chronicles 1:29", "text": "سبکای له حوشا څخه عیلای له اخوخ څخه"}, {"ref": "1 Chronicles 1:29", "text": "د بنیامین د قبیلې څخه (د شاوول خپله قبیله): ۳۰۰۰ تنه، د دغو څخه اکثره تر هغه وخته پورې د شاوول سره وفادار پاتې شوي وو."}, {"ref": "1 Chronicles 1:29", "text": "کله چې صندوق د داود ښار ته راوړل شو، د شاوول لور میکال د کړکۍ څخه وکتل او ویې لیدل چې داود پاچا د خوشحالۍ څخه ټوپونه وهي او نڅا کوي، نو هغه یې په خپل زړه کې سپک وګاڼه."}, {"ref": "1 Chronicles 1:29", "text": "وکړئ ستاینه د څښتن د جلالي نامه راشئ حضور ته د هغه او نذرانه راوړئ کړئ څښتن ته عبادت په سپېڅلې توګه"}, {"ref": "1 Chronicles 1:30", "text": "مهرای له نطوفې څخه حلد د بعنه زوی له نطوفې څخه"}, {"ref": "1 Chronicles 1:30", "text": "د افرایم د قبیلې څخه: ۲۰۸۰۰ تنه زړور جنګیالي چې په خپلو طایفو کې نومیالي وو."}, {"ref": "1 Chronicles 1:30", "text": "ای ټولې ځمکې ولړزېږه د هغه په مخکې نړۍ یې ټینګه درولې چې خوځیږي نه"}, {"ref": "1 Chronicles 1:31", "text": "اتای د ریبای زوی د بنیامین له جبعې څخه بنایاه له فرعاتون څخه"}, {"ref": "1 Chronicles 1:31", "text": "د لوېدیځې منسي د قبیلې څخه: ۱۸۰۰۰ تنه د دې دپاره غوره شوي وو چې لاړ شي او داود پاچا کړي."}, {"ref": "1 Chronicles 1:31", "text": "پرېږده خوشحاله اسمانونه شي او ځمکه وکړي خوښي او هم قومونه کړئ خبر چې څښتن پاچا دی"}, {"ref": "1 Chronicles 1:32", "text": "حورای د جاعش له خوړونو څخه ابي ییل له عربات څخه"}, {"ref": "1 Chronicles 1:32", "text": "د یساکار د قبیلې څخه: ۲۰۰ مشران د خپلو وطندارانو سره یو ځای چې د هغوی د امر لاندې وو. دا مشران پوهېدل چې اسراییل څه وکړي او په کوم وخت کې یې وکړي،"}, {"ref": "1 Chronicles 1:32", "text": "شي په غړمبار دې بحیره د خپلو ټولو مخلوقاتو سره شي دې خوشحاله پټي هم ټولو فصلونو سره"}, {"ref": "1 Chronicles 1:33", "text": "عزموت له بحروم څخه الیحبا له شعلبون څخه"}, {"ref": "1 Chronicles 1:33", "text": "د زبولون د قبیلې څخه: ۵۰۰۰۰ تنه وفادار او د اعتبار وړ کسان چې د جګړې دپاره تیار وو او د هر ډول وسلې په کارولو پوهېدل."}, {"ref": "1 Chronicles 1:33", "text": "د خوښۍ چیغې به بیا ووهي ځنګل کې ونې کله چې راشي د ځمکې قضاوت ته څښتن"}, {"ref": "1 Chronicles 1:34", "text": "هاشم له جزون څخه یوناتان د شاجای زوی له حرار څخه"}, {"ref": "1 Chronicles 1:34", "text": "د نفتالي د قبیلې څخه: ۱۰۰۰ تنه قوماندانان د ۳۷۰۰۰ کسانو سره یوځای چې سپرونه او نېزې ورسره وې."}, {"ref": "1 Chronicles 1:34", "text": "د څښتن شکر کوئ، ځکه چې نېک دی هغه ده ابدي د هغه مینه"}, {"ref": "1 Chronicles 1:35", "text": "اخیام د ساکار زوی له حرار څخه الیفال د اور زوی"}, {"ref": "1 Chronicles 1:35", "text": "د دان د قبیلې څخه: ۲۸۶۰۰ تنه چې د جګړې دپاره تیار وو."}, {"ref": "1 Chronicles 1:35", "text": "هغه ته ووایئ: وژغوره مونږ ای خدایه زمونږ ژغورونکیه خدایه مونږ یو ځای سره راټول کړه ومو ژغوره له قومونو ترڅو ادا کړو مونږه شکر د ستا ستا د سپېڅلي نوم ثنا مو ویاړ شي"}, {"ref": "1 Chronicles 1:36", "text": "حافر د مکیرات څخه اخیا د فلون څخه"}, {"ref": "1 Chronicles 1:36", "text": "د اشیر د قبیلې څخه: ۴۰۰۰۰ تنه تجربه لرونکي عسکر چې د جګړې دپاره تیار وو."}, {"ref": "1 Chronicles 1:36", "text": "ثنا او صفت دې وي د اسراییلو څښتن خدای ته وکړئ ثنا او صفت یې د ازل نه تر ابده پورې بیا ټولو خلکو وویل: «آمین» او د څښتن ثنا او صفت یې وکړ."}, {"ref": "1 Chronicles 1:37", "text": "حصرو د کرمل څخه نعرای د ازبای زوی"}, {"ref": "1 Chronicles 1:37", "text": "د روبین، جاد او د ختیځې منسي د قبیلو څخه (هغه قبیلې چې د اردن د سیند په ختیځ کې وې): ۱۲۰۰۰۰ تنه، چې په هر ډول وسلو سمبال شوي وو."}, {"ref": "1 Chronicles 1:37", "text": "داود اساف او د هغه د طایفې لاویان د دې دپاره غوره کړل چې په هغه ځای کې د ورځني عبادت مسوولان شي چېرته چې د لوظ صندوق ساتل کېده."}, {"ref": "1 Chronicles 1:38", "text": "یوییل د ناتان ورور مبحار د هجري زوی"}, {"ref": "1 Chronicles 1:38", "text": "دا ټول عسکر چې د جګړې دپاره تیار وو، حبرون ته لاړل. هغوی ټینګه اراده درلودله چې داود په ټولو اسراییلو باندې پاچا کړي. نو پاتې اسراییلیان په دې خبره باندې راضي او خوښ وو."}, {"ref": "1 Chronicles 1:38", "text": "عوبید ادوم او د هغه اته شپېته خپلوان د هغوی مرستیالان وو او حوسه او د یدوتون زوی عوبید ادوم ساتونکي وو."}, {"ref": "1 Chronicles 1:39", "text": "صالق له عمون څخه نحرای د بیروت څخه چې د زرویه د زوی یعنې د یوآب وسلې به یې وړلې."}, {"ref": "1 Chronicles 1:39", "text": "هغو عسکرو هلته د داود سره درې ورځې تېرې کړې او په هغو خوړو او د څښاک په شیانو یې چې خپلو خپلوانو ورته تیار کړي وو، میلې کولې."}, {"ref": "1 Chronicles 1:39", "text": "داود صادوق کاهن او د هغه خپلوان چې کاهنان وو، هم غوره کړل چې د جبعون د عبادت په ځای کې د څښتن په سپېڅلي خېمه کې خدمت وکړي."}, {"ref": "1 Chronicles 1:40", "text": "عیرا او جارب له یتر څخه"}, {"ref": "1 Chronicles 1:40", "text": "د یساکار، زبولون او د نفتالي د شمالي قبیلو پورې د لېرې لېرې ځایونو څخه خلک راتلل او خره، اوښان، قچرې او غویان یې چې اوړه، د انځرو او د ممیزو کلچې، د انګورو شراب او د زیتونو تېل ورباندې بار وو، راوستل. هغوی پادې او رمې هم راوستلې چې حلال یې کړي او ویې خوري. دا ټول د هغو خوشحالیو څرګندونه وه چې په ټول هېواد کې احساسېدله."}, {"ref": "1 Chronicles 1:40", "text": "هغوی به هر سهار او ماښام د قربانۍ په ځای باندې سوځېدونکې نذرانې وړاندې کولې. دا د هغه شریعت سره سم ؤ چې څښتن اسراییلیانو ته ورکړی ؤ."}, {"ref": "1 Chronicles 1:41", "text": "اوریا حیتي زاباد د احلای زوی"}, {"ref": "1 Chronicles 1:41", "text": "هیمان او یدوتون د هغوی مرستیالان وو او همدارنګه هغه نور سړي چې په ځانګړې توګ