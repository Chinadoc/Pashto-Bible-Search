ښې ولوستلو."}, {"ref": "None Jeremiah 3:8", "text": "نو بابليان به واپس راوګرځى او په دې ښار باندې به حمله وکړى، هغوئ به دا ښار قبضه کړى او اور به ورته واچوى."}, {"ref": "None Jeremiah 3:8", "text": "نو عبيدمَلِک هلته لاړو او بادشاه ته يې ووئيل چې،"}, {"ref": "None Jeremiah 3:8", "text": "په دې دوران کښې بابليانو يروشلم، شاهى محل او د خلقو کورونه وسوزول او د ښار دېوالونه يې وران کړل."}, {"ref": "None Jeremiah 3:9", "text": "خو هغوئ به د خپل مالِک خُدائ او د داؤد د نسل نه د هغه بادشاه خِدمت وکړى، څوک چې به زۀ په هغوئ باندې مقرروم."}, {"ref": "None Jeremiah 3:9", "text": "کله چې هغوئ واپس راشى نو د پښېمانۍ نه به اوښکې د هغوئ په مخ روانې وى او زۀ به هغوئ په ډېره مينه خپلو کورونو ته واپس بوځم، نو زۀ به هغوئ د روانو اوبو په خوا کښې او په هواره لاره بوځم هسې نه چې چرته تيندک وخورى، ځکه چې زۀ د بنى اِسرائيلو پلار يم، او اِفرائيم زما مشر زوئ دے.“"}, {"ref": "None Jeremiah 3:9", "text": "نو بيا ما هغه زمکه د ترۀ زوئ حنم‌ايل نه د اوولسو سپينو زرو سيکو په بيعه واخستله."}, {"ref": "None Jeremiah 3:9", "text": "نو بيا به دا ښار ما ته د ټولې دُنيا د خلقو په وړاندې خوشحالى، شُهرت، او عزت راکړى، کله چې دوئ د هغه ټولو ښۀ څيزونو په حقله واورى کوم چې زۀ د يروشلم سره کوم. او خلق به د دې ټول امن او آبادۍ نه متاثره شى او د يرې نه به په لړزان شى."}, {"ref": "None Jeremiah 3:9", "text": "او ټولو په دې اتفاق وکړو چې هر څوک به خپل عبرانى غلامان او وينځې آزادوى، او هيڅ څوک به خپل د مُلک سړے يا ښځه بند نۀ ساتى."}, {"ref": "None Jeremiah 3:9", "text": "او نۀ مونږ د اوسېدو دپاره کورونه جوړ کړى او نۀ مو د انګور باغ، پټى يا فصلونه کَرلى دى."}, {"ref": "None Jeremiah 3:9", "text": "يهويقيم د يوسياه زوئ د يهوداه بادشاه د بادشاهۍ د پينځم کال په نهمه مياشت د يروشلم ټولو خلقو ته او د هغوئ دپاره څوک چې د يهوداه د ښارونو نه راغلى وُو، د روژې اعلان وکړو او هغوئ د مالِک خُدائ دپاره روژه ونيوله."}, {"ref": "None Jeremiah 3:9", "text": "مالِک خُدائ داسې فرمائى چې، خپل ځان ته دا دوکه مۀ ورکوئ چې ګنې د بابليانو فوج ستاسو نه لاړو او بيا به نۀ راځى، ځکه چې هغوئ به بيا واپس راځى."}, {"ref": "None Jeremiah 3:9", "text": "”بادشاه سلامت، دې سړو ډېر زيات بد کار وکړو په دې چې هغوئ يرمياه نبى د اوبو په ډيګۍ کښې واچولو. هغه به ډېر زر د لوږې نه مړ شى، ځکه چې په ښار کښې روټۍ ختمه شوه.“"}, {"ref": "None Jeremiah 3:9", "text": "بيا نبوزردان، د فوجيانو کمانډر هغه کسان چې ژوندى پاتې شوى وُو او کوم کسان چې بګوړه شوى وُو هغوئ يې بابل ته بنديوان بوتلل."}, {"ref": "None Jeremiah 3:10", "text": "بلکې مالِک خُدائ فرمائى چې، اے زما خِدمت کوونکيه يعقوبه، مۀ يرېږه. او اے اِسرائيله تۀ مۀ پرېشانه کېږه. زۀ به په يقين سره تا او ستا اولاد په هغه لرې مُلک کښې د جلاوطنۍ نه آزاد کړم. او تۀ به راواپس شې او خير خيريت سره به ژوند کوې. او څوک به تا نۀ شى يرولے."}, {"ref": "None Jeremiah 3:10", "text": "مالِک خُدائ فرمائى، ”اے قومونو، د مالِک خُدائ کلام واورئ، او هغه لرې ساحلى وطنونو ته يې بيان کړئ. هغه چا چې بنى اِسرائيل خوارۀ کړى دى هم هغه به يې راغونډ کړى. لکه څنګه چې شپونکے د خپلې رمې ساتنه کوى هم داسې به هغه د هغوئ خيال ساتى."}, {"ref": "None Jeremiah 3:10", "text": "ما د ګواهانو په وړاندې د هغه زمکې انتقال نامه وليکله او په هغې مې دستخط وکړو او مهر مې پرې ولګولو او هغه سپين زر مې په تله کښې وتلل."}, {"ref": "None Jeremiah 3:10", "text": "مالِک خُدائ فرمائى چې، تاسو د دې ځائ په حقله وايئ چې، دا ځائ خو د صحرا په شان دے چې په کښې نه انسان او نه ځناور شته. خو د يهوداه ښارونه او د يروشلم کوڅې خالى دى کومې چې په ميرو بدلې شوې چې نۀ په کښې انسان او نۀ په کښې ځناور شته، نو يو ځل بيا به هلته،"}, {"ref": "None Jeremiah 3:10", "text": "ټولو مشرانو او خلقو چا چې هم دا لوظ کړے وو هغوئ دا خبره ومنله چې هغوئ به خپل غلامان او وينځې آزادوى او نور به هغوئ په خپله قبضه کښې نۀ ساتى او هغوئ يې آزاد کړل."}, {"ref": "None Jeremiah 3:10", "text": "مونږ په خېمو کښې اوسېدلو او په هر هغه څۀ مو پوره عمل کړے دے څۀ چې مونږ ته زمونږ نيکۀ يوندب حکم کړے وو."}, {"ref": "None Jeremiah 3:10", "text": "د مالِک خُدائ په کور کښې د ګمرياه د سافن زوئ منشى د کوټې نه، کومه چې د دربار په بره حِصه کښې وه او د مالِک خُدائ د کور د داخلېدو د نوې دروازې سره نزدې وه، باروک ټولو خلقو ته چې هلته موجود وُو د يرمياه کلام د طومار نه تلاوت کړو."}, {"ref": "None Jeremiah 3:10", "text": "تر دې چې کۀ تاسو د بابليانو ټولو لښکرو ته په جنګ کښې شکست هم ورکړئ او د هغوئ په خېمو کښې صرف هغه زخميان سړى وُو چې د جنګ نه ژوندى پاتې شوى وُو، نو هغوئ به راپاڅى او دا ښار به ټول وسوزوى.“"}, {"ref": "None Jeremiah 3:10", "text": "نو بادشاه عبيدمَلِک له حُکم ورکړو چې، ”د دې ځائ نه ځان سره دېرش سړى بوځه او يرمياه د مړ کېدو نه وړاندې د هغه ډيګۍ نه راوباسه.“"}, {"ref": "None Jeremiah 3:10", "text": "خو نبوزردان لږ څۀ غريبانان خلق په يهوداه کښې پرېښودل چا چې زمکه نۀ لرله، او هغۀ هغوئ ته پټى او د انګورو باغونه په حواله کړل چې د هغې خيال ساتى."}, {"ref": "None Jeremiah 3:11", "text": "نو مالِک خُدائ فرمائى چې، زۀ ستا مل يم او زۀ به تا بچ کړم. او زۀ به هغه ټول قومونه مکمل تباه کړم چرته چې ما تاسو خوارۀ وارۀ کړى وئ، خو زۀ به تاسو په مکمل توګه نۀ تباه کوم. زۀ به تاسو په اِنصاف سره تنبيه کړم، او زۀ به تاسو هم داسې بې‌سزا نۀ پرېږدم."}, {"ref": "None Jeremiah 3:11", "text": "مالِک خُدائ به د بنى اِسرائيلو فديه ورکړى او هغوئ به د هغه کسانو نه آزاد کړى چې د دوئ نه زورَور دى."}, {"ref": "None Jeremiah 3:11", "text": "بيا ما د مهر شوې انتقال نامې چې د خرڅولو ټول اصُول او شرائط په کښې درج شوى وُو او هم يوه غېر مهر شوې کاپې راواخسته."}, {"ref": "None Jeremiah 3:11", "text": "د خوشحالۍ او د خندا آوازونه واورېدلے شى او په کښې به د ناوې او د زلمى آوازونه واورېدلے شى، او د هغوئ آوازونه چې د مالِک خُدائ په کور کښې د شکرانې نذرانې پېش کوى، واورېدلے شى. او هغوئ به داسې وائى چې، د مالِک خُدائ ربُ الافواج شُکر ګزارى وکړئ، ځکه چې هغه ښۀ دے، د هغۀ مينه نۀ ختمېدونکې ده. مالِک خُدائ دا فرمائى چې، زۀ به دا مُلک د غلامۍ نه واپس راولم لکه څنګه چې وړاندې وو."}, {"ref": "None Jeremiah 3:11", "text": "خو وروستو هغوئ خپله فېصله بدله کړه، هغوئ آزاد شوى غلامان واپس راوستل او هغوئ يې بيا په زور سره دوباره خپل غلامان او وينځې جوړ کړل."}, {"ref": "None Jeremiah 3:11", "text": "خو کله چې نبوکدنضر بادشاه په دې مُلک باندې قبضه وکړه، مونږ ووئيل، راځئ چې، مونږ يروشلم ته د بابليانو او د شام د لښکرو نه وتښتُو. نو بيا ځکه مونږ په يروشلم کښې پاتې شُو.“"}, {"ref": "None Jeremiah 3:11", "text": "کله چې ميکاياه د ګمرياه زوئ او د سافن نمسى د مالِک خُدائ کلام د طومار نه واورېدو،"}, {"ref": "None Jeremiah 3:11", "text": "کله چې د بابليانو فوجيان د مِصريانو د فوجيانو د رارسېدو په وجه د يروشلم د محاصرې نه راواپس او په شا شُو،"}, {"ref": "None Jeremiah 3:11", "text": "نو عبيدمَلِک د ځان سره کسان واخستل او په شاهى محل کښې د خزانې نه لاندې کمرې ته لاړو او د خپل ځان سره يې څۀ زړې جامې چِرړې راواخستلې. او هغه يې يرمياه ته د پړى په ذريعه ډيګۍ ته ښکته کړې."}, {"ref": "None Jeremiah 3:11", "text": "خو نبوکدنضر بادشاه فوجى آفسر نبوزردان ته دا حکم وکړو چې،"}, {"ref": "None Jeremiah 3:12", "text": "مالِک خُدائ داسې فرمائى چې، ستاسو زخمونه خطرناک دى، او ستاسو زخمونه لاعلاجه دى."}, {"ref": "None Jeremiah 3:12", "text": "هغوئ به راشى او پاس د صيون په غرۀ به د خوشحالۍ چغې ووهى، او هغوئ به د مالِک خُدائ په برکتونو لکه غله دانه، مے، تېل، او د رمو په زياتولو خوشحاله شى. د هغوئ ژوند به لکه د سيرابه باغ په شان وى، او هغوئ به نور غمژن نۀ شى."}, {"ref": "None Jeremiah 3:12", "text": "او دواړه مې باروک د نيرياه زوئ او د محسياه نمسى ته د حنم‌ايل او د هغه ګواهانو چا چې په انتقال دستخط کړے وو او د هغه ټولو خلقو په موجودګۍ کښې چې په فوجى چاوڼۍ کښې ناست وُو حواله کړل."}, {"ref": "None Jeremiah 3:12", "text": "مالِک خُدائ ربُ الافواج فرمائى، کۀ څۀ هم چې دا مُلک اوس د صحرا په شان دے او د انسانانو او ځناورو نه خالى دے خو په دې کښې به بيا د څرن زمکه راپېدا شى چې شپونکى به ورته خپلې رمې څرولو دپاره راولى."}, {"ref": "None Jeremiah 3:12", "text": "نو بيا د مالِک خُدائ کلام په يرمياه نازل شو،"}, {"ref": "None Jeremiah 3:12", "text": "نو بيا د مالِک خُدائ کلام په يرمياه نازل شو، او وې فرمائيل چې،"}, {"ref": "None Jeremiah 3:12", "text": "نو هغه په شاهى محل کښې لاندې د منشى کوټې ته لاړو، چرته چې ټول آفسران ناست وُو. اليسمع، د دربار منشى، د سمعياه زوئ دلاياه، د عکبور زوئ الناتن، د سافن زوئ ګمرياه، د حننياه زوئ صدقياه او نور ټول آفسران هلته موجود وُو."}, {"ref": "None Jeremiah 3:12", "text": "نو يرمياه د دې دپاره د يروشلم د ښار نه د بنيامين قبائيلى علاقې ته په سفر روان شو ترڅو چې هلته کښې د خپلو خپلوانو نه زمکه کښې خپله برخه جائيداد جدا کړى."}, {"ref": "None Jeremiah 3:12", "text": "عبيدمَلِک يرمياه ته آواز ورکړو او ورته يې ووئيل چې، ”دا زړې کپړې او جامې په خپلو ترخونو کښې کېږده چې د راختو په وخت کښې دې پړے زخمى نۀ کړى.“ يرمياه هم هغه شان وکړل،"}, {"ref": "None Jeremiah 3:12", "text": "”لاړ شئ او يرمياه پېدا کړئ او د هغۀ ښۀ خيال وساتئ. هغۀ له تکليف مۀ ورکوئ او هغه چې څۀ غواړى هغه ورله وکړئ.“"}, {"ref": "None Jeremiah 3:13", "text": "داسې څوک نشته چې ستا خيال وساتى، ستا د زخمونو دپاره دارو نشته، ستا دپاره علاج نشته دے."}, {"ref": "None Jeremiah 3:13", "text": "نو پېغلې به د خوشحالۍ نه ګډيږى، ځوانان او بوډاګان به هم خوشحالى کوى. زۀ به د هغوئ غم په خوشحالۍ باندې بدل کړم، او زۀ به هغوئ له تسلى ورکړم، او زۀ به د هغوئ خفګان په خوشحالۍ بدل کړم."}, {"ref": "None Jeremiah 3:13", "text": "د هغه ټولو کسانو په مخکښې ما باروک ته هدايت ورکړو چې،"}, {"ref": "None Jeremiah 3:13", "text": "مالِک خُدائ فرمائى چې، د غريزه مُلک په ښارونو، او د غونډو په شا او خوا، او د نجب په صحرا، د بنيامين په علاقه کښې، د يروشلم په شا او خوا، او د يهوداه په ښارونو کښې به شپونکى يو ځل بيا خپل ګډورى وشمارى."}, {"ref": "None Jeremiah 3:13", "text": "”ما ستاسو د پلار نيکۀ سره لوظ وکړو کله چې ما هغوئ د مِصر نه د غلامۍ د مُلک نه رابهر او آزاد کړل. نو ما وفرمائيل چې،"}, {"ref": "None Jeremiah 3:13", "text": "”دا هغه کلام دے چې مالِک خُدائ ربُ الافواج د بنى اِسرائيلو خُدائ پاک فرمائى چې، لاړ شه او د يهوداه سړو او د يروشلم خلقو ته ووايه چې، آيا تاسو د دې نه سبق نۀ زده کوئ او زما د کلام پيروى نۀ کوئ؟"}, {"ref": "None Jeremiah 3:13", "text": "نو ميکاياه هغوئ ته هغه هر څۀ ووئيل څۀ چې باروک خلقو ته د طومار نه بيانول او هغۀ ترې اورېدلى وُو."}, {"ref": "None Jeremiah 3:13", "text": "خو کله چې هغه د بنيامين دروازې ته ورسېدو، نو هلته د چوکيدارانو آفسر د اِرياه په نوم چې د شلمياه زوئ او د حننياه نمسے وو هغه ونيولو. او ورته يې ووئيل، ”تۀ بګوړه شوے يې او د بابليانو سره ملګرے کېږې.“"}, {"ref": "None Jeremiah 3:13", "text": "او هغوئ هغه د ډيګۍ نه په پړو راوويستلو. او بيا يرمياه د فوجيانو په چاوڼۍ کښې بندى پاتې شو."}, {"ref": "None Jeremiah 3:13", "text": "نو نبوزردان فوجى کمانډر، نبو‌شازبان مشر آفسر، نرګل‌شراضر د بادشاه مشاور، او د بابل بادشاه نورو ټولو آفسرانو"}, {"ref": "None Jeremiah 3:14", "text": "ستا ټولو ملګرو تۀ هېر کړے يې، هغوئ ستا پرواه نۀ کوى. ما په تا باندې داسې حمله وکړه لکه څنګه چې په دشمن کوم، او د يو ظالم په شان مې سزا درکړه، ځکه چې ستا شرارتونه ډېر غټ دى، او ستا ګناهونه ډېر زيات دى."}, {"ref": "None Jeremiah 3:14", "text": "زۀ به د هغوئ اِمامان په غوړو زېړو خوراکونو ماړۀ کړم، او زما خلق به زما په نعمتونو باندې ماړۀ پټ شى. مالِک خُدائ دا فرمائى.“"}, {"ref": "None Jeremiah 3:14", "text": "مالِک خُدائ ربُ الافواج د بنى اِسرائيلو خُدائ پاک فرمائى چې، د سودا دا دواړه کاغذونه واخله چې په يو باندې مهر شته او په بل نشته او دواړه په خاورين منګى کښې واچوه ترڅو چې د ډېر وخت دپاره محفوظ پاتې شى."}, {"ref": "None Jeremiah 3:14", "text": "مالِک خُدائ فرمائى چې، هغه وخت راتلونکے دے چې زۀ به خپله هغه مهربانه وعده پوره کړم چې کومه ما د يهوداه او د اِسرائيل سره کړې وه."}, {"ref": "None Jeremiah 3:14", "text": "په هر يو اوؤم کال تاسو هر هغه عبرانى چې خپل ځان يې په تاسو خرڅ کړے دے آزاد کړئ. د شپږ کاله د خِدمت کولو نه وروستو، نو په کار دے چې تاسو هغه آزاد کړئ او رُخصت يې کړئ. خو ستاسو پلار نيکۀ زما خبرو ته نۀ غوږ ونيولو او نۀ يې ورته توجو ورکړه."}, {"ref": "None Jeremiah 3:14", "text": "يوندب د ريکاب زوئ خپلو بچو ته حکم وکړو چې مے مۀ څښئ نو هغوئ د هغۀ دا حکم ومنلو. تر نن ورځ پورې چا هم په هغوئ کښې مے ونۀ څښل، ځکه چې هغوئ د خپل پلار نيکۀ د حکم پيروى کوى. خو ما تاسو سره په څو څو ځله خبرې وکړې خو تاسو زما د خبرو پيروى ونۀ کړه."}, {"ref": "None Jeremiah 3:14", "text": "نو ټولو آفسرانو په مشورې سره يهودى د نتنياه زوئ، د شلمياه نمسى او د کوشى کړوسے باروک ته ورولېږلو چې ورته دا ووائى، ”آفسران وائى چې راشه، او ځان سره هغه طومار هم راوړه کوم چې تا ټولو خلقو ته ولوستلو.“ نو باروک د نيرياه زوئ د هغه طومار سره چې کوم يې په لاس کښې وو هغوئ له ورغلو."}, {"ref": "None Jeremiah 3:14", "text": "خو يرمياه ورته وفرمائيل چې، ”دا رښتيا نۀ دى. زۀ بګوړه نۀ يم او بابليانو سره نه ملګرے کېږم.“ خو اِرياه هغۀ ته غوږ ونۀ نيولو، او يرمياه يې ونيولو او آفسرانو ته يې پېش کړو."}, {"ref": "None Jeremiah 3:14", "text": "يوه ورځ صدقياه بادشاه، يرمياه پسې کسان ورولېږل او هغه يې خپل ځان ته د مالِک خُدائ د کور درېمې دروازې ته راوستو. بادشاه ورته ووئيل چې، ”زۀ غواړم چې تا نه يو څو تپوسونه وکړم. نو د هيڅ قسمه حقيقت او رښتيا پټولو کوشش مۀ کوه.“"}, {"ref": "None Jeremiah 3:14", "text": "حکم وکړو چې يرمياه د فوجيانو چاوڼۍ نه رابهر کړئ. هغوئ هغه جدلياه د اخيقام زوئ او د سافن نمسى ته وسپارلو، چا چې هغه خپل کور ته واپس بوتلو. نو بيا هغه په يهوداه کښې د خپلو خلقو سره پاتې شو."}, {"ref": "None Jeremiah 3:15", "text": "نو بيا ولې تاسو په خپلو زخمونو او درد ژړا فرياد کوئ، او تاسو وايئ چې د دې خو هيڅ علاج نشته؟ خو دا ما ستاسو د لويو شرارتونو او ډېرو ګناهونو په وجه درسره وکړل."}, {"ref": "None Jeremiah 3:15", "text": "مالِک خُدائ فرمائى چې، ”په راما کښې د چغو آواز واورېدلے شو، د ماتم او لوئ ژړا آواز. راحيل په خپلو بچو باندې ژړا کوى، هيڅ قسم تسلى نۀ قبلوى ځکه چې د هغې ماشومان غېب کړے شوى دى.“"}, {"ref": "None Jeremiah 3:15", "text": "نو مالِک خُدائ ربُ الافواج د بنى اِسرائيلو خُدائ پاک فرمائى چې، په دې مُلک کښې به بيا کورونه، پټى او د انګورو باغونه اخستل کيږى.“"}, {"ref": "None Jeremiah 3:15", "text": "په هغه وخت کښې به زۀ د داؤد د اولاد نه يوه صادقه څانګه راوټوکوم، هغه به په ټول مُلک کښې هغه کارونه کوى کوم چې د اِنصاف او صداقت وى."}, {"ref": "None Jeremiah 3:15", "text": "خو اوس تاسو پښېمانه شوئ او توبه مو وويستله او خپله فېصله مو بدله کړه او هغه کار مو وکړو چې څۀ زما په نظر کښې صحيح وو، او تاسو هر يو د خپلو غلامانو د آزادولو اعلان وکړو. او دا چې تاسو زما په کور کښې چې زما د نوم مهر پرې لګولے شوے دے ما سره لوظ وکړو."}, {"ref": "None Jeremiah 3:15", "text": "ما تاسو ته بار بار خپل نبيان درولېږل. هغوئ تاسو ته وفرمائيل چې، په تاسو کښې دې هر يو د خپلو بدو کارونو نه واوړى او ښۀ کارونه دې کوى، او مۀ تاسو د نورو معبودانو پيروى کوئ او مۀ يې خِدمت کوئ. نو بيا به تاسو په هغه زمکه کښې اوسېږئ کومه چې ما ستاسو پلار نيکۀ ته ورکړې ده. خو تاسو زما خبرو ته توجو ورنۀ کړه او نۀ مو غوږ ونيولو."}, {"ref": "None Jeremiah 3:15", "text": "نو هغوئ هغۀ ته ووئيل چې، ”مهربانى وکړه دلته کښېنه او مونږ ته دا طومار ولوله.“ نو باروک ورته هغه طومار ولوستلو."}, {"ref": "None Jeremiah 3:15", "text": "هغوئ يرمياه ته سخت غصه شول او وې وهلو او د يونتن منشى په کور کښې يې بند کړو، د کوم نه چې هغوئ جيل جوړ کړے وو."}, {"ref": "None Jeremiah 3:15", "text": "يرمياه ورته وفرمائيل، ”کۀ چرې زۀ تاسو ته رښتيا ووايم، نو تاسو به ما مړ کړئ. او کۀ چرې زۀ تاسو ته نصيحت وکړم، نو تاسو به ما ته غوږ ونۀ نيسئ.“"}, {"ref": "None Jeremiah 3:15", "text": "په کوم وخت کښې چې يرمياه په فوجى چاوڼۍ کښې بند وو، نو د مالِک خُدائ کلام په هغۀ نازل شو چې،"}, {"ref": "None Jeremiah 3:16", "text": "خو هر هغه څوک چې تاسو روغ تېروى هغوئ به روغ تېر کړے شى، او ستاسو ټول دشمنان به جلاوطن کړے شى. هر هغه څوک چې تاسو لوټ کوى هغوئ به لوټ کړے شى، او څوک چې په تاسو باندې حمله کوى په هغوئ باندې به حمله وکړے شى."}, {"ref": "None Jeremiah 3:16", "text": "خو مالِک خُدائ فرمائى چې، ”ژړا او اوښکې توېدل بس کړئ، تاسو ته به د خپلو کارونو اجر مِلاو شى.“ مالِک خُدائ داسې فرمائى چې، ”ستاسو ماشومان به د دشمن د مُلک نه راواپس شى.“"}, {"ref": "None Jeremiah 3:16", "text": "”د هغې نه وروستو کله چې ما د زمکې کاغذونه باروک د نيرياه زوئ له ورکړل نو بيا ما دُعا وکړه،"}, {"ref": "None Jeremiah 3:16", "text": "په هغه ورځو کښې به يهوداه بچ کړے شى او يروشلم به د سلامتۍ سره ژوند کوى. او دا هغه نوم دے چې په کوم سره به هغه ياديږى، مالِک خُدائ زمونږ خلاصونکے دے."}, {"ref": "None Jeremiah 3:16", "text": "خو تاسو بيا خپله فېصله بدله کړه او زما د نوم بې‌حرمتى مو وکړه، او تاسو بيا هر يو سړے غلام او ښځه مو واپس وينځه کړه څوک چې تاسو آزاد کړى وُو. نو بيا تاسو هغوئ په زور سره دوباره غلامان او وينځې کړل."}, {"ref": "None Jeremiah 3:16", "text": "يوندب چې د ريکاب زوئ د هغۀ اولاد د خپل پلار حُکم ومنلو او د هغې پيروى يې وکړه، خو تاسو خلقو زما خبره ونۀ منله."}, {"ref": "None Jeremiah 3:16", "text": "نو کله چې هغوئ دا کلام واورېدو، نو بيا هغوئ يو بل ته يرې سره کتل او باروک ته يې ووئيل چې، ”مونږ به ضرور بادشاه د دې ټول کلام نه خبر کړُو.“"}, {"ref": "None Jeremiah 3:16", "text": "يرمياه يې په يوه تاخانه کښې بند کړو او تر ډېره وخته پورې هلته په کښې وو."}, {"ref": "None Jeremiah 3:16", "text": "نو بيا صدقياه بادشاه د هغۀ سره په پټه وعده وکړه او ورته يې ووئيل چې، ”زۀ په مالِک خُدائ درته قسم خورم څوک چې ژوندے دے، او څوک چې مونږ ته ژوند راکوى، نۀ به زۀ تا مړ کړم او نۀ به دې هغه کسانو ته حواله کړم څوک چې تا وژل غواړى.“"}, {"ref": "None Jeremiah 3:16", "text": "”لاړ شئ او د ايتهوپيا عبيدمَلِک ته ووايئ چې مالِک خُدائ ربُ الافواج د بنى اِسرائيلو خُدائ پاک فرمائى چې، زۀ به د دې ښار سره هر هغه څۀ وکړم لکه څنګه چې ما هغوئ ته دهمکى ورکړې ده. زۀ به په هغوئ باندې افتونه نازل کړم، نه چې آبادى. تۀ به د هغوئ تباهى وګورې،"}, {"ref": "None Jeremiah 3:17", "text": "مالِک خُدائ فرمائى چې، زۀ به ستاسو صحت دوباره ښۀ کړم، او ستاسو زخمونو ته به شفا ورکړم. زۀ به دا کار وکړم ځکه چې ما اورېدلى دى چې خلق تا ته ”جلاوطن شوے“ وائى، ”صيون د چا چې څوک هم خيال نۀ ساتى.“"}, {"ref": "None Jeremiah 3:17", "text": "مالِک خُدائ داسې فرمائى چې، ”ستا د راتلونکى ژوند دپاره اُميد شته دے، ستاسو ماشومان به خپل مُلک ته بيا واپس راشى."}, {"ref": "None Jeremiah 3:17", "text": "اے مالِکه قادر مطلق خُدايه، تا په خپل لوئ طاقت او قُدرت سره او په خپل زورَور لاس سره آسمان او زمکه جوړ کړل. ستا دپاره يو کار هم ناممکن نۀ دے."}, {"ref": "None Jeremiah 3:17", "text": "مالِک خُدائ داسې فرمائى چې، د داؤد په اولاد کښې به همېشه يو کس د بنى اِسرائيلو په تخت ناست وى."}, {"ref": "None Jeremiah 3:17", "text": "نو ځکه مالِک خُدائ فرمائى چې، تاسو زما پيروى ونۀ کړه، تاسو د خپل مُلک خلقو ته د آزادۍ اعلان ونۀ کړو. نو زۀ اوس بيا تاسو ته دغه شان د آزادۍ اعلان کوم. مالِک خُدائ فرمائى چې ستاسو آزادى به داسې وى چې زۀ به تاسو په تُورې، وبا او قحط باندې مړۀ کړم. زۀ به تاسو ټولې دُنيا ته د عبرت او د يرې سبب وګرځوم."}, {"ref": "None Jeremiah 3:17", "text": "نو د دې په وجه مالِک خُدائ ربُ الافواج د بنى اِسرائيلو خُدائ پاک فرمائى چې، ما ته غوږ شئ‎. زۀ اوس د يهوداه او د يروشلم په ټولو خلقو باندې هغه ټول افتونه راولم د کومو چې ما د هغوئ خلاف اعلان کړے دے. ما هغوئ ته ووئيل، خو هغوئ غوږ ونۀ نيولو. ما هغوئ ته آواز وکړو، خو هغوئ ما ته جواب رانۀ کړو.“"}, {"ref": "None Jeremiah 3:17", "text": "نو بيا هغوئ د باروک نه تپوس وکړو چې، ”تۀ مونږ ته دا ووايه چې دا هر څۀ تا څنګه وليکل؟ آيا يرمياه نبى تا ته وفرمائيل او تا وليکل؟“"}, {"ref": "None Jeremiah 3:17", "text": "نو څۀ موده پس صدقياه بادشاه څوک ورولېږلو او يرمياه يې خپل محل ته راوغوښتلو، او هغۀ نه يې په راز کښې تپوس وکړو چې، ”د مالِک خُدائ د طرف نه څۀ پېغام شته څۀ؟“ يرمياه جواب ورکړو چې، ”آو، تۀ به د بابل بادشاه ته په حواله کړے شې.“"}, {"ref": "None Jeremiah 3:17", "text": "نو په هغه وخت کښې بيا يرمياه صدقياه د يهوداه بادشاه ته وفرمائيل چې، ”مالِک خُدائ ربُ الافواج د بنى اِسرائيلو خُدائ پاک داسې فرمائى چې، کۀ چرې تاسو خپل ځان د بابل آفسرانو ته حواله کړئ، تاسو او ستاسو خاندان به ژوندى پاتې شئ، او دا ښار به د سوزېدو نه بچ شى."}, {"ref": "None Jeremiah 3:17", "text": "خو په هغه ورځ به زۀ تا بچ کړم او تۀ به هغه چا ته حواله نۀ کړے شې د چا نه چې ستا په زړۀ کښې يره ده."}, {"ref": "None Jeremiah 3:18", "text": "مالِک خُدائ فرمائى چې، زۀ به د يعقوب اولاد د غلامۍ نه واپس راولم او په هغوئ به رحم وکړم، د يروشلم تباه شوے ښار به هم هغه ځائ کښې دوباره آباد کړم، او زوړ محل به يې په خپل اصلى ځائ کښې ودروم."}, {"ref": "None Jeremiah 3:18", "text": "د اِفرائيم ژړا او فرياد ما ته رارسېدلے دے، تا ما ته تربيت راکړو چې په لاره شم، لکه د ناجوته سخى په شان دې تربيت راکړو او زۀ اوس په لاره شوے يم. ما دې خپل حضور ته واپس راوله، نو زۀ به واپس راشم، ځکه چې تۀ زما مالِک خُدائ او خُدائ پاک يې."}, {"ref": "None Jeremiah 3:18", "text": "تۀ زرګونو خلقو سره مينه کوې، خو د مور پلار د ګناهونو په وجه تۀ د هغوئ بچو له سزا ورکوې. اے عظيم او طاقتور خُدايه، د چا نوم چې مالِک خُدائ ربُ الافواج دے،"}, {"ref": "None Jeremiah 3:18", "text": "او هم داسې به اِمامان همېشه د ليوى قبيلې نه وى څوک به چې تل زما خِدمت کوى او ما ته به سوزېدونکې نذرانې، او د غلو نذرانې او قربانۍ پېش کوى.“"}, {"ref": "None Jeremiah 3:18", "text": "ځکه چې تاسو ما سره د لوظ شرائط مات کړل نو زۀ به تاسو هم دوه ځايه کړم لکه څنګه چې تاسو سخى دوه ځايه کړى وُو او د هغې په مينځ کښې تېر شوئ."}, {"ref": "None Jeremiah 3:18", "text": "نو يرمياه د ريکاب خاندان ته وفرمائيل، ”مالِک خُدائ، ربُ الافواج د بنى اِسرائيلو خُدائ پاک فرمائى چې، تاسو خو د خپل پلار نيکۀ يوندب حکم ومنلو او د هغۀ د ټولو هداياتو مو تابعدارى وکړه او په هر هغه څۀ باندې مو عمل وکړو چې هغۀ درته وئيلى وُو."}, {"ref": "None Jeremiah 3:18", "text": "باروک ورته جواب ورکړو چې، ”آو، هغۀ دا هر څۀ ما ته وفرمائيل او ما هغه په دې طومار کښې په سياهۍ باندې وليکل.“"}, {"ref": "None Jeremiah 3:18", "text": "نو بيا يرمياه د صدقياه بادشاه ته وفرمائيل چې، ”ما ستا يا ستا د آفسرانو او يا د دې خلقو خلاف څۀ داسې بد کړى دى چې د هغې په وجه تاسو زۀ په دې قېد کښې اچولے يم؟"}, {"ref": "None Jeremiah 3:18", "text": "خو کۀ تاسو د خپل ځان د حواله کېدو نه اِنکار وکړئ، نو دا ښار به بابليانو ته حواله کړے شى، او هغوئ به دا ښار د سر نه تر آخره پورې وسوزوى. او تاسو به ترې نۀ شئ تښتېدلے.“"}, {"ref": "None Jeremiah 3:18", "text": "ځکه چې تا په ما باور وکړو، زۀ به ستا ژوند تا ته درکړم. زۀ به تا بچ کړم او محفوظ به دې وساتم. دا د مالِک خُدائ فرمان دے.“"}, {"ref": "None Jeremiah 3:19", "text": "نو په هغه وخت کښې به د هغه خلقو نه د شُکر ګزارۍ حمدونه او د خوشحالۍ آوازونه واورېدلے شى. زۀ به د هغوئ شمېر زيات کړم، او هغوئ به کمولے نۀ شى. زۀ به خلق مجبور کړم چې د هغوئ عزت وکړى، او هغوئ به سپک نۀ شمېرلے کيږى."}, {"ref": "None Jeremiah 3:19", "text": "ستا نه د اوړېدو نه پس مونږ توبه وکړه، د پوهېدو نه وروستو مونږ خپله سينه ووهله. مونږ چې کوم کم عقل کارونه په ځوانۍ کښې کړى وُو د هغې په وجه سپک او شرمنده شُو.“"}, {"ref": "None Jeremiah 3:19", "text": "ستا مقصد عظيم او ستا کارونه زورَور دى. ستا سترګې د انسان ټولې لارې وينى، او تۀ هر يو ته د خپل چال چلن او عمل په مطابق اجر ورکوې."}, {"ref": "None Jeremiah 3:19", "text": "نو بيا د مالِک خُدائ پېغام يرمياه ته راغلو چې،"}, {"ref": "None Jeremiah 3:19", "text": "آو، زۀ به تاسو په مينځ وشلوم، هغه کۀ تاسو د يهوداه او يروشلم آفسران، د دربار خصيان آفسران، اِمامان او يا عام خلق هم يئ، ځکه چې تاسو ما سره خپل لوظ مات کړو."}, {"ref": "None Jeremiah 3:19", "text": "نو په دې وجه مالِک خُدائ ربُ الافواج د بنى اِسرائيلو خُدائ پاک فرمائى چې، د يوندب د ريکاب د زوئ په خاندان کښې به همېشه يو سړے داسې وى چې زما خِدمت به کوى.“"}, {"ref": "None Jeremiah 3:19", "text": "نو آفسرانو باروک ته ووئيل چې، ”تۀ او يرمياه لاړ شئ او خپل ځان پټ کړئ. او هيچا ته مۀ وايئ چې تاسو چرته يئ.“"}, {"ref": "None Jeremiah 3:19", "text": "ستاسو په هغه نبيانو باندې څۀ چل وشو چې تاسو ته به يې وئيل چې، د بابل بادشاه به نۀ په تاسو او نۀ په دې مُلک باندې حمله وکړى؟"}, {"ref": "None Jeremiah 3:19", "text": "خو صدقياه بادشاه يرمياه ته ووئيل چې، ”زۀ د خپل مُلک د هغه خلقو نه يرېږم چا چې غدارى وکړه او بابليانو له ورغلل، کېدے شى چې د بابل فوجيان ما هغوئ ته حواله کړى او بيا به هغوئ ما سره بد سلوک وکړى.“"}, {"ref": "None Jeremiah 3:20", "text": "د هغوئ ماشومان به لکه د پخوا په شان ژوند کوى، او د هغوئ جماعت به زما په مخکښې قائم شى، او زۀ به هغه ټولو خلقو له سزا ورکړم څوک چې په دوئ باندې ظلم کوى."}, {"ref": "None Jeremiah 3:20", "text": "مالِک خُدائ فرمائى چې، ”ولې اِسرائيل تر اوسه زما محبوب زوئ نۀ دے څۀ په چا کښې چې زۀ خوشحالېږم؟ کۀ څۀ هم چې زۀ د دۀ خلاف بار بار خبرې کوم، نو بيا هم هغه يادوم. نو په دې وجه زما زړۀ ورپسې زهيريږى، زما په زړۀ کښې د دۀ دپاره ډېر رحم دے."}, {"ref": "None Jeremiah 3:20", "text": "تا په مِصر کښې معجزې او حېرانونکى کارونه کړى دى، او ستا دا سلسله په بنى اِسرائيلو او په ټولو انسانانو کښې تر ننه پورې راروانه ده، او تر نن ورځ پورې تا خپل نوم ته جلال ورکړو."}, {"ref": "None Jeremiah 3:20", "text": "”مالِک خُدائ فرمائى چې، کۀ چرې تاسو زما لوظ د ورځې او د شپې د مقرر شوى نظام په حقله ماتولے شئ، چې شپه او ورځ په خپل مقرر شوى وخت رانۀ شى"}, {"ref": "None Jeremiah 3:20", "text": "نو زۀ به مو خپلو دشمنانو ته حواله کړم څوک چې ستاسو مرګ پسې ګرځى. ستاسو د مړو لاشونه به د هوا د مارغانو او د ګيدړانو خوراک کړم."}, {"ref": "None Jeremiah 3:20", "text": "نو بيا آفسرانو هغه طومار د دربار د منشى اليسمع په کوټه کښې کېښودو، نو بيا هغوئ د بادشاه دربار ته لاړل او د دې ټول کلام نه يې بادشاه خبر کړو."}, {"ref": "None Jeremiah 3:20", "text": "نو اوس، بادشاه سلامته، زۀ تا ته سوال او مِنت کوم چې زما خبره واوره. ما د يونتن منشى کور ته واپس مۀ لېږه، ګنې زۀ به هلته مړ شم.“"}, {"ref": "None Jeremiah 3:20", "text": "يرمياه ورته وفرمائيل چې، ”هغوئ به تاسو چا ته نۀ حواله کوى کۀ چرې تۀ د مالِک خُدائ تابعدارى غوره کړې. هغه به ستا ژوند بچ کړى او تا ته به خير شى."}, {"ref": "None Jeremiah 3:21", "text": "د هغوئ مشر به د هغوئ د خپل قوم نه وى، او د هغوئ مشر به د هغوئ د خپلو خلقو نه وى. زۀ به هغه خپل ځان ته نزدې کړم او هغه به ما له راشى، ځکه چې څوک دا جرأت کولے شى چې نابللے راشى؟ دا د مالِک خُدائ فرمان دے."}, {"ref": "None Jeremiah 3:21", "text": "اے زما قومه، تاسو د تلو په وخت په خپله لار داسې نښې ودروئ چې د هغې نه په واپسۍ کښې خلقو ته د صحيح لارې پته ولګى. اے پېغلې اِسرائيله راوګرځه، خپلو ښارونو ته راوګرځه."}, {"ref": "None Jeremiah 3:21", "text": "تا په خپل زورَور لاس، لوئ دهشت، عجيبه کارونو او معجزو سره خپل خلق بنى اِسرائيل د مِصر نه راوويستل."}, {"ref": "None Jeremiah 3:21", "text": "نو بيا به هغه وخت زما لوظ زما د خِدمتګار داؤد سره او زما لوظ د ليويانو سره چې زما اِمامان دى او زما په حضور کښې خِدمت کوى به هم ماتېدے شى، نو بيا به د داؤد اولاد کښې نور څوک نۀ وى چې د هغۀ په تخت بادشاهى وکړى."}, {"ref": "None Jeremiah 3:21", "text": "زۀ به د يهوداه بادشاه صدقياه او د هغۀ آفسران هم د هغوئ دشمنانو ته حواله کړم څوک چې د هغوئ مرګ پسې ګرځى. کۀ څۀ هم چې د بابليانو د بادشاه لښکرو خپلې حملې ستاسو خلاف بندى کړى دى،"}, {"ref": "None Jeremiah 3:21", "text": "نو بادشاه يهودى نومې سړے ورولېږلو چې هغه طومار راوړى، نو يهودى هغه د اليسمع منشى د کوټې نه راوړو او بادشاه او هغه ټولو آفسرانو ته چې ورسره په خوا کښې ولاړ وُو ولوستلو."}, {"ref": "None Jeremiah 3:21", "text": "نو صدقياه بادشاه حُکم وکړو چې يرمياه د يونتن منشى کور ته مۀ استوئ بلکې د هغې په ځائ يې د فوجيانو په چاوڼۍ کښې بند کړئ. او بيا بادشاه دا حکم هم وکړو چې هره ورځ ورته د تنور يوه روټۍ تر هغه وخته پورې ورکوئ ترڅو چې په ټول ښار کښې يوه روټۍ هم وى. نو يرمياه بيا د فوجيانو چاوڼۍ کښې بند کړے شو."}, {"ref": "None Jeremiah 3:21", "text": "خو کۀ چرې تاسو نۀ غواړئ چې خپل ځان هغوئ ته حواله کړئ نو بيا مالِک خُدائ ما ته دا موضوع په رويا کښې ښکاره کړې ده چې"}, {"ref": "None Jeremiah 3:22", "text": "نو هغه وخت به تاسو زما خلق يئ او زۀ به ستاسو خُدائ پاک يم.“"}, {"ref": "None Jeremiah 3:22", "text": "اے زما بې‌وفا لورې، تۀ به ترڅو پورې سرګردانه ګرځې؟ مالِک خُدائ به يو نوے کار وکړى او هغه دا دے چې بنى اِسرائيل به خپل مالِک خُدائ ته غاړه ورکړى.“"}, {"ref": "None Jeremiah 3:22", "text": "تا هغوئ ته هغه زرخيزه زمکه ورکړه د کومې دې چې د هغوئ د پلار نيکۀ سره وړاندې وعده کړې وه."}, {"ref": "None Jeremiah 3:22", "text": "زۀ به د خپل خِدمتګار داؤد نسل او ليويان کوم چې زما اِمامان دى او زما په وړاندې خِدمت کوى د آسمان د ستورو او د سمندر د شګو په شان بې‌شمېره زيات کړم.“"}, {"ref": "None Jeremiah 3:22", "text": "مالِک خُدائ فرمائى چې، زۀ به هغوئ ته حُکم ورکړم او بيا به زۀ هغوئ واپس دې ښار ته راولم. هغوئ به ستاسو خلاف جنګ وکړى او هغوئ به دا ښار قبضه کړى او وبه يې سوزوى. او زۀ به د يهوداه ښارونه وران او تباه کړم نو بيا به څوک هم هلته نۀ اوسيږى.“"}, {"ref": "None Jeremiah 3:22", "text": "نو د کال نهمه مياشت وه، د يخنۍ موسم وو نو بادشاه په شاهى محل کښې د ژمى دپاره په جوړه شوې کوټه کښې نغرى ته ناست وو."}, {"ref": "None Jeremiah 3:22", "text": "څومره ښځې چې په دې شاهى محل کښې ژوندۍ پاتې وى نو هغوئ به فوجيان د بابليانو آفسرانو ته ستاسو نه بوځى. نو بيا به د تلو په وخت دا ښځې تاسو ته داسې پېغور درکوى او درته به وائى چې، ”ستاسو څومره ښۀ دوستان وُو، ټولو تاسو سره دوکه وکړه او بې‌لارې يې کړئ. او کله چې ستا پښه په دلدل کښې کېښودے شوه نو بيا يې تۀ خپل نصيب ته پرېښودلې.“"}, {"ref": "None Jeremiah 3:23", "text": "ګورئ د مالِک خُدائ غصه لکه د طوفان په شان رانازليږى، او د تېزو هواګانو په شان د بدعمله خلقو په سر په غضب سره لګيږى."}, {"ref": "None Jeremiah 3:23", "text": "مالِک خُدائ ربُ الافواج، د بنى اِسرائيلو خُدائ پاک فرمائى، ”کله چې زۀ هغوئ د غلامۍ نه واپس راولم، په يهوداه او د هغې په ښارونو کښې به هغوئ بيا داسې ووائى چې، اے د صداقت ځايه، اے مقدس غره، مالِک خُدائ دې تا له برکت درکړى."}, {"ref": "None Jeremiah 3:23", "text": "خو چې کله زمونږ پلار نيکۀ په دې مُلک کښې داخل شول او په دې يې قبضه وکړه نو هغوئ نۀ ستا واورېدل او نۀ يې ستا د شريعت پيروى وکړه. او هغوئ په هغه څۀ باندې عمل ونۀ کړو د کوم چې ورله تا حکم کړے وو. نو بيا ځکه تا دا ټول افتونه په هغوئ رانازل کړل."}, {"ref": "None Jeremiah 3:23", "text": "مالِک خُدائ بل پېغام يرمياه ته ورکړو،"}, {"ref": "None Jeremiah 3:23", "text": "هرکله چې يهودى درې څلور عنوانونه ولوستل، نو بادشاه دا طومار په چاقو وشلولو او هغه يې په نغرى کښې اور ته واچولو، تر دې چې هغه طومار ټول په اور کښې وسوزېدو."}, {"ref": "None Jeremiah 3:23", "text": "ستاسو ټولې ښځې او ماشومان به بابليانو ته بهر راوويستلے شى، او تۀ به هم د هغوئ د نيولو نه بچ نۀ شې. تاسو به د بابل د بادشاه له خوا ګرفتار شئ، او دا ښار به وسوزيږى.“"}, {"ref": "None Jeremiah 3:24", "text": "او د مالِک خُدائ سخت قهر او غضب به تر هغې پورې وى او واپس به نۀ شى ترڅو چې د هغۀ مقصد پوره شوے نۀ وى. په راتلونکو ورځو کښې به تاسو په دې هر څۀ باندې پوهه شئ."}, {"ref": "None Jeremiah 3:24", "text": "ښاريان او زمينداران او شپونکى به د خپلو رمو سره په شريکه د يهوداه په مُلک کښې اوسيږى."}, {"ref": "None Jeremiah 3:24", "text": "وګورئ چې بابليانو د ښار د نيولو دپاره ګېرچاپېره څنګه د خاورو ډېرى جوړ کړل. د جنګ، قحط او وبا په وجه به دا ښار بابليانو ته څوک چې پرې حمله کوى حواله شى. تا چې څۀ وئيلى وُو نو هغه کارونه وشول، اوس يې په خپله وګوره."}, {"ref": "None Jeremiah 3:24", "text": "”آيا تا د خلقو خبرو ته غوږ نۀ دے نيولے چې هغوئ وائى، مالِک خُدائ اوس هغه دوه قومونه رد کړى دى کوم چې اول هغۀ غوره کړى وُو؟ نو هغوئ زما د قوم سپکوالے کوى او د يو قوم په حيثيت يې نۀ منى."}, {"ref": "None Jeremiah 3:24", "text": "بادشاه او د هغۀ ټولو خِدمتګارانو چا چې دا کلام واورېدو هغوئ ونۀ يرېدل او نۀ يې د غم نه جامې وشلولې."}, {"ref": "None Jeremiah 3:24", "text": "نو بيا صدقياه يرمياه ته ووئيل چې، ”چا ته داسې ونۀ وائې چې تا ما ته دا خبره وکړه، ګنې تۀ به مړ ‎شې."}, {"ref": "None Jeremiah 3:25", "text": "زۀ به ستړو ستومانو ته طاقت ورکړم او مړاوى شوى به تازه کړم."}, {"ref": "None Jeremiah 3:25", "text": "خو اے مالِکه خُدايه زما ربه تۀ هغه ذات يې چې ما ته دې حُکم راکړو چې د ګواهانو په مخکښې هغه زمکه واخله، سره د دې چې د ښار حالت داسې خراب وو چې بابليانو نيولو.“"}, {"ref": "None Jeremiah 3:25", "text": "خو مالِک خُدائ داسې فرمائى چې، کۀ چرې ما د ورځې او د شپې سره لوظ نۀ وو کړے او د زمکې او آسمان نظام مې نۀ وو جوړ کړے،"}, {"ref": "None Jeremiah 3:25", "text": "کۀ څۀ هم چې الناتن، دلاياه او ګمرياه بادشاه ته مِنتُونه کول چې طومار مۀ سوزوه خو هغۀ د هغوئ خبرې ته غوږ ونۀ نيولو."}, {"ref": "None Jeremiah 3:25", "text": "کۀ آفسرانو ته زما او ستا د ملاقات پته ولګى او راشى او ستا نه تپوس وکړى چې تاسو يو بل ته څۀ ووئيل نو مونږ ته سمه خبره وکړه او دروغ مۀ وايه ګنې مړ به دې کړُو،"}, {"ref": "None Jeremiah 3:26", "text": "نو کله چې زۀ راپاڅېدم او خپلې سترګې مې پرانستلې، نو زۀ پوهه شوم چې په خوږ خوب اودۀ وم.“"}, {"ref": "None Jeremiah 3:26", "text": "نو بيا د مالِک خُدائ له طرفه دا پېغام يرمياه ته راغلو چې،"}, {"ref": "None Jeremiah 3:26", "text": "نو بيا به زۀ د يعقوب او د خپل خِدمتګار داؤد اولاد نامنظور کړم، او نۀ به د يعقوب او د داؤد د اولاد نه څوک خوښ کړم چې د اِبراهيم، اِسحاق او يعقوب په اولاد حکومت وکړى. ځکه چې زۀ به هغوئ د غلامۍ نه واپس راولم او په هغوئ به رحم وکړم.“"}, {"ref": "None Jeremiah 3:26", "text": "نو بيا د دې په ځائ بادشاه يرحمئيل شهزاده او ورسره سراياه د عزرائيل زوئ او شلمياه د عبدائيل زوئ ته حکم وکړو چې باروک منشى او يرمياه نبى ګرفتار کړى. خو مالِک خُدائ هغوئ پټ کړل."}, {"ref": "None Jeremiah 3:26", "text": "نو بيا هغوئ ته ووايه چې ما بادشاه ته مِنت او زارى وکړه چې بيا مې د يونتن د کور تاخانې ته مۀ لېږه ګنې زۀ به هلته مړ شم.“"}, {"ref": "None Jeremiah 3:27", "text": "مالِک خُدائ فرمائى چې، ”هغه ورځ راروانه ده چې زۀ به د اِسرائيل او يهوداه او د هغوئ د ځناورو نسلونه زيات کړم."}, {"ref": "None Jeremiah 3:27", "text": "”زۀ مالِک قادر مطلق خُدائ يم، او د ټولو مخلوقاتو رب العالمين يم. آيا داسې کار شته چې د هغې کول زما دپاره ناممکن وى؟"}, {"ref": "None Jeremiah 3:27", "text": "کله چې يهويقيم هغه طومار وسوزولو چې په کښې هغه الفاظ وُو کوم چې باروک ته يرمياه فرمائيلى وُو او هغۀ ليکلى وُو، نو د مالِک خُدائ کلام په يرمياه نازل شو او ورته يې وفرمائيل چې،"}, {"ref": "None Jeremiah 3:27", "text": "هم هغه شان وشول، لږ وخت تېر شوے نۀ وو چې د بادشاه ټول آفسران راغلل او د يرمياه نه يې تپوسونه شروع کړل چې بادشاه د څۀ دپاره راغوښتے وې. خو يرمياه د بادشاه په هداياتو عمل وکړو. خو د بادشاه او د يرمياه په مينځ کښې شوې خبرې هيچا هم نۀ وې اورېدلې."}, {"ref": "None Jeremiah 3:28", "text": "او لکه څنګه چې ما هغوئ د بېخ نه راويستل، او ټوکړې ټوکړې مې کړل، او راومې غورزول، او تباه مې کړل او افتونه مې پرې نازل کړل، نو دغه شان به زۀ هغوئ دوباره آباد او قائم کړم."}, {"ref": "None Jeremiah 3:28", "text": "نو ځکه زۀ دا ښار د بابل بادشاه نبوکدنضر او د هغۀ لښکر ته حواله کوم، نو هغوئ به دا قبضه کړى"}, {"ref": "None Jeremiah 3:28", "text": "”يو بل طومار راواخله او په هغې کښې هغه هر څۀ وليکه څۀ چې په اول طومار کښې ليکلے شوى وُو کوم چې يهويقيم د يهوداه بادشاه وسوزولو."}, {"ref": "None Jeremiah 3:28", "text": "نو بيا يرمياه د دې نه وروستو د يروشلم د شکست پورې د فوجيانو په چاوڼۍ کښې بندى پاتې شو."}, {"ref": "None Jeremiah 3:29", "text": "په هغه ورځو کښې به نور خلق داسې نۀ وائى چې، تراوۀ انګور يې پلارانو وخوړل، او غاښونه يې د بچو وبرېښېدل."}, {"ref": "None Jeremiah 3:29", "text": "او د دېوال نه اخوا بابليان به راشى او په دې ښار به اور بل کړى. هغوئ به ټول کورونه وسوزوى، چرته چې خلقو زۀ په دې غصه کړم چې د کوټو په چتونو يې بعل ته خوشبويۍ وسوزولې او نورو معبودانو ته يې د څښلو نذرانې پېش کړې."}, {"ref": "None Jeremiah 3:29", "text": "نو همدارنګه يهويقيم د يهوداه بادشاه ته ووايه، مالِک خُدائ داسې فرمائى چې، تا دا طومار وسوزولو او يرمياه ته دې وئيل چې، تا ولې په دې کښې دا ليکلى دى چې په يقين سره به د بابل بادشاه راشى او په حقيقت کښې به دا مُلک تباه کړى او انسان او ځناور داوړه به په کښې جارُو کړى؟"}, {"ref": "None Jeremiah 3:30", "text": "خو هر سړے به د خپلې ګناه په وجه مړ کيږى، هر څوک چې تراوۀ انګور وخورى هم د هغۀ غاښونه به برېښيږى.“"}, {"ref": "None Jeremiah 3:30", "text": "نو د اِسرائيل او د يهوداه خلقو د ځوانۍ نه واخله تر اوسه پورې د شرارت نه بغېر بل کوم کار نۀ دے کړے او هر وخت يې زۀ په خپل کردار سره غصه کړے يم."}, {"ref": "None Jeremiah 3:30", "text": "نو په دې وجه مالِک خُدائ د يهويقيم د يهوداه بادشاه په حقله فرمائى چې، د هغۀ په اولاد کښې به څوک هم د داؤد په تخت بادشاهى ونۀ کړى، او د هغۀ لاش به په خوشى مېدان وغورزولے شى چرته چې په ورځ کښې به نمر او په شپه کښې به سختې يخنۍ او پرخې ته پروت وى."}, {"ref": "None Jeremiah 3:31", "text": "مالِک خُدائ فرمائى چې، ”هغه وخت راروان دے چې کله زۀ د اِسرائيل او د يهوداه د خلقو سره يو نوے لوظ وکړم."}, {"ref": "None Jeremiah 3:31", "text": "د کومې ورځې نه چې دا ښار جوړ شوے دے نو د هغې ورځې نه تر ننه پورې زۀ دې خلقو غصه کړے او په قهر کړے يم. نو ځکه زۀ دا ښار د خپل مخ نه اخوا کوم."}, {"ref": "None Jeremiah 3:31", "text": "زۀ به هغۀ ته او د هغۀ اولاد او د هغۀ نوکرانو ته د هغوئ د غلطو کارونو په وجه سزا ورکړم، زۀ به په دوئ او په هغه چا باندې چې په يروشلم کښې اوسيږى او د يهوداه په ټولو خلقو به هغه افتونه راولم کوم چې ما د هغوئ خلاف اعلان کړى دى، ځکه چې هغوئ ما ته غوږ ونۀ نيولو.“"}, {"ref": "None Jeremiah 3:32", "text": "دا به د هغه لوظ په شان نۀ وى کوم چې ما د هغوئ د پلار نيکۀ سره کړے وو کله چې ما هغوئ د لاس نه ونيول او د مِصر نه مې بهر وويستل، ځکه چې هغوئ ما سره کړے لوظ مات کړو، کۀ څۀ هم چې زما مثال هغوئ ته د وفادار خاوند په شان وو. مالِک خُدائ داسې فرمائى."}, {"ref": "None Jeremiah 3:32", "text": "د اِسرائيل او د يهوداه خلقو زۀ په هغه ټولو شرارتونو کوم چې دوئ وکړل غصه کړم کۀ هغه بادشاهانو، آفسرانو، مشرانو، اِمامانو او کۀ نبيانو هم کړى وى."}, {"ref": "None Jeremiah 3:32", "text": "بيا يرمياه يو بل تش طومار راواخستلو او باروک ليکوال د نيرياه زوئ له يې ورکړو، نو څنګه به چې يرمياه فرمائيل نو هغه ټول الفاظ يې په کښې دوباره وليکل کوم چې په هغه طومار کښې ليکلے شوى وُو چې يهويقيم د يهوداه بادشاه په اور کښې اچولے او سوزولے وو. او د هغې نه علاوه يې نوره هم په دې موضوع رڼا واچوله."}, {"ref": "None Jeremiah 3:33", "text": "خو دا هغه نوے لوظ دے کوم به چې زۀ پس د دې نه د بنى اِسرائيلو د قبيلې سره وکړم، زۀ به خپل شريعت د هغوئ په مازغو کښې واچوم او د هغوئ په زړونو به يې وليکم. زۀ به د هغوئ خُدائ پاک يم او هغوئ به زما بنده ګان وى."}, {"ref": "None Jeremiah 3:33", "text": "زما خلقو ما ته شا کړې ده، او ما ته د کتلو نه يې اِنکار کړے دے، سره د دې چې ما بار بار په نرمۍ سره هغوئ ته تعليم ورکړے دے، خو هغوئ زما خبرو ته غو