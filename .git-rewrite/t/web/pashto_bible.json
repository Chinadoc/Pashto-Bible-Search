 زیات دی. اوس به ستاسو دپاره دا ډېره ښه وي چې په ښار کې پاتې شئ او مونږ ته مرسته راولېږئ.»"}, {"ref": "2 Samuel 1:3", "text": "هغوی د هغو عسکرو په شان چې د جګړې څخه تښتېدلي وي او شرمیږي، په خاموشۍ سره بېرته ښار ته ورننوتل."}, {"ref": "2 Samuel 1:4", "text": "نو حانون د داود استازي ونیول، د هغوی یوه خوا ږیره یې وخریله، کالي یې د پښو نه تر ملا پورې ورته وشکول او رخصت یې کړل."}, {"ref": "2 Samuel 1:4", "text": "نو داود استازي ورولېږل چې هغه راولي، هغه یې راوستله او داود ورسره څملاست. (هغې ښځې د خپل میاشتیني عادت څخه د پاکوالي په خاطر غسل کاوه.) وروسته هغه بېرته کور ته لاړه."}, {"ref": "2 Samuel 1:4", "text": "یوه ورځ د هغه شتمن سړي کور ته یو مسافر راغی، شتمن سړي نه غوښتل چې د خپلو رمو یا پادو څخه کوم حیوان حلال کړي چې د هغه دپاره ډوډۍ تیاره کړي. د هغه په ځای یې د هغه غریب سړي وری ونیوه او د خپل مېلمه دپاره یې کباب کړ.»"}, {"ref": "2 Samuel 1:4", "text": "هغه د امنون څخه پوښتنه وکړه: «ای د پاچا زویه! ولې ورځ په ورځ ډنګرېږې؟ څه خبره ده؟» امنون ځواب ورکړ: «زه د خپل ورور ابشالوم په خور تامار باندې مین شوی یم.»"}, {"ref": "2 Samuel 1:4", "text": "کله چې هغه ښځه پاچا ته ورغله، هغه ته د درناوي په خاطر ټیټه شوه او ویې ویل: «ای اعلیحضرته! زما سره مرسته وکړه.»"}, {"ref": "2 Samuel 1:4", "text": "ابشالوم به زیاته کړه: «کاشکې خلک ما د دې هېواد قاضي وټاکي، نو هرچا چې کوم شکایت یا دعوه درلودله ماته به راشي او زه به د هغه سره انصاف وکړم.»"}, {"ref": "2 Samuel 1:4", "text": "پاچا صیبا ته وویل: «هرڅه چې د مفیبوشت وو اوس هغه ستا دي.» صیبا ځواب ورکړ: «اعلیحضرته! زه د ستاسو په وړاندې د درناوي په خاطر ټیټېږم. تاسو دې تل زما څخه خوشحاله اوسئ.»"}, {"ref": "2 Samuel 1:4", "text": "دا مشوره ابشالوم او د اسراییلو ټولو مشرانو ته ښه ښکاره شوه."}, {"ref": "2 Samuel 1:4", "text": "پاچا ځواب ورکړ: «هرڅه چې تاسو ته ښه ښکاري هغه به وکړم.» بیا پاچا د دروازې تر څنګ ودرېده او د هغه کسان په زر کسیزه او سل کسیزه ټولیو کې د ښاره ووتل."}, {"ref": "2 Samuel 1:4", "text": "پاچا خپل مخ پټ کړ او په لوړ اواز سره یې چیغې ووهلې: «ای زما زویه! زما زویه ابشالومه! ابشالومه زما زویه!»"}, {"ref": "2 Samuel 1:5", "text": "هغوی ډېر شرمېدل چې کور ته راستانه شي. کله چې داود د دې پېښې څخه خبر شو، نو هغوی ته یې خبر ورولېږه: «تر هغې پورې د اریحا په ښار کې پاتې شئ چې ستاسو ږیرې اوږدې شي او بیا بېرته کور ته راشئ.»"}, {"ref": "2 Samuel 1:5", "text": "څو موده وروسته هغه پوه شوه چې امیدواره ده او داود ته یې خبر ولېږه چې د دې خبرې نه خبر شي."}, {"ref": "2 Samuel 1:5", "text": "داود په هغه شتمن سړي باندې ډېر په قهر شو او ویې ویل: «زه د ژوندي څښتن په نوم قسم خورم هغه چا چې دا کار کړی دی، د مرګ د سزا وړ دی!"}, {"ref": "2 Samuel 1:5", "text": "یوناداب وویل: «په خپله بستره کې څمله او دا بهانه وکړه چې ناروغ یې. کله چې پلار دې پوښتنې ته راغی هغه ته ووایه: مهرباني وکړه زما خور تامار پرېږده چې راشي او ماته یو څه راکړي چې ویې خورم. هغه دې زما په مخکې ډوډۍ تیاره کړي چې زه هغه ولیدلی شم او بیا یې ماته په خپل لاس راکړي.»"}, {"ref": "2 Samuel 1:5", "text": "پاچا د هغې څخه پوښتنه وکړه: «ته څه غواړې؟» هغې ځواب ورکړ: «زه کونډه یمه. زما مېړه مړ شوی دی."}, {"ref": "2 Samuel 1:5", "text": "همدارنګه هرکله چې کوم څوک به هغه ته ورنژدې شو چې د درناوي دپاره ورته خپل سر ټیټ کړي، ابشالوم به خپل لاس ور اوږد کړ، هغه به یې ونیوه او ښکل به یې کړ."}, {"ref": "2 Samuel 1:5", "text": "څنګه چې داود پاچا بحوریم ته ورسېده، د شاوول د طایفې څخه د جیرا زوی شمعي د هغه ځای څخه د هغه لیدلو ته راووت. څنګه چې هغه راروان ؤ، ښکنځلې یې کولې."}, {"ref": "2 Samuel 1:5", "text": "بیا ابشالوم وویل: «حوشای راوغواړئ چې د هغه څخه هم واورو چې هغه څه وایي.»"}, {"ref": "2 Samuel 1:5", "text": "هغه یوآب، ابیشای او اتای ته امر وکړ: «زما په خاطر ځوان ابشالوم ته زیان مه رسوئ.» ټولو لښکرو واورېدل چې داود خپل هر یو قوماندان ته دا امر ورکړ."}, {"ref": "2 Samuel 1:5", "text": "یوآب د پاچا کور ته ورغی او هغه ته یې وویل: «تا نن د خپلو ټولو کسانو چې ستا ژوند، ستا د زامنو ژوند او ستا د لورګانو او ستا د ښځو او وینځو ژوند یې وژغوره، سپکاوی وکړ."}, {"ref": "2 Samuel 1:6", "text": "عمونیان په دې پوه شول چې دوی داود خپل دښمن کړ، نو هغوی شل زره سوریایي عسکر د بیت رحوب او صوبې څخه، دولس زره کسان د طوب څخه او د معکې پاچا یې د زرو کسانو سره اجیر ونیول."}, {"ref": "2 Samuel 1:6", "text": "نو داود یوآب ته پیغام ولېږه: «حیتي اوریا ماته راولېږه.» نو یوآب اوریا هغه ته ورولېږه."}, {"ref": "2 Samuel 1:6", "text": "په دې خاطر چې هغه داسې بې رحمه کار کړی دی، هغه باید د هغه وري په ځای څلور چنده بېرته ورکړي.»"}, {"ref": "2 Samuel 1:6", "text": "نو امنون بهانه وکړه چې ناروغ دی او هغه څملاست. کله چې پاچا د هغه پوښتنې ته راغی، امنون ورته وویل: «مهرباني وکړئ تامار ته اجازه ورکړئ چې راشي، دلته زما په مخکې یو څه ځانګړې ډوډۍ پخه کړي او هغه دې ماته په خپل لاس راکړي.»"}, {"ref": "2 Samuel 1:6", "text": "اعلیحضرته! زما دوه زامن وو. یوه ورځ هغوی په پټي کې یو د بله سره جنګ وکړ او هلته هېڅوک نه ؤ چې دوی سره بېل کړي. یوه هغه بل وواژه."}, {"ref": "2 Samuel 1:6", "text": "ابشالوم به د هغو ټولو اسراییلیانو سره چې د پاچا څخه به د انصاف غوښتلو دپاره راتلل، دغه شان چلند کاوه. نو په دې ډول یې د اسراییلیانو زړونه لاسته راوړل."}, {"ref": "2 Samuel 1:6", "text": "که څه هم ټول لښکر او ځانګړي ساتونکي د داود څخه ګردچاپېر ولاړ وو، هغه داود او د هغه ټول درباریان په تیږو باندې ویشتل."}, {"ref": "2 Samuel 1:6", "text": "کله چې حوشای راورسېد، ابشالوم هغه د اخیتوفل د پلان څخه خبر کړ. بیا یې پوښتنه وکړه: «ته څه وایې؟ ایا د اخیتوفل مشوره ومنو؟ که نه، نو ته مونږ ته ووایه چې څه وکړو.»"}, {"ref": "2 Samuel 1:6", "text": "د داود لښکر صحرا ته ووتل او د اسراییلیانو سره یې د افرایم په ځنګل کې جګړه وکړه."}, {"ref": "2 Samuel 1:6", "text": "ته د هغه چا سره مینه کوې چې ستا څخه کرکه کوي او د هغه چا څخه کرکه کوې چې ستا سره مینه کوي. تا نن دا وښودله چې قوماندانان او د هغوی کسان ستا دپاره هېڅ معنی نه لري. زه پوه شوم چې که ابشالوم نن ژوندی وای او مونږ ټول مړه وای، نو ته به خوشحاله وای."}, {"ref": "2 Samuel 1:7", "text": "داود د دې څخه خبر شو او یوآب یې د ټول لښکر سره د هغوی مقابلې ته ورولېږه."}, {"ref": "2 Samuel 1:7", "text": "کله چې اوریا ورغی، داود د هغه څخه د یوآب او د لښکرو د سلامتۍ او د جنګ د حال پوښتنه وکړه."}, {"ref": "2 Samuel 1:7", "text": "ناتان داود ته وویل: «هغه سړی ته یې! د اسراییلو څښتن خدای داسې وایي: ته مې د اسراییلو پاچا وټاکلې او د شاوول څخه مې وژغورلې."}, {"ref": "2 Samuel 1:7", "text": "داود تامار ته چې په ماڼۍ کې وه، خبر ورولېږه: «د خپل ورور امنون کور ته ورشه او د هغه دپاره یو څه خواړه تیار کړه.»"}, {"ref": "2 Samuel 1:7", "text": "اوس زما ټول خپلوان زما په ضد راپورته شوي دي او زما څخه دا غوښتنه کوي چې خپل زوې هغوی ته وسپارم، ترڅو هغه د خپل ورور د قتل په خاطر ووژني. که چېرې هغوی دا کار وکړي، نو زما اخرنۍ هیله به هم له منځه یوسي او زما مېړه ته به د ځمکې په مخ نه نوم پاتې شي او نه اولاد.»"}, {"ref": "2 Samuel 1:7", "text": "وروسته له څلورو کالو ابشالوم پاچا ته وویل: «اجازه راکړئ چې حبرون ته لاړ شم او هغه نذر چې د څښتن دپاره مې منلی ؤ، ورکړم."}, {"ref": "2 Samuel 1:7", "text": "شمعي هغه ته ښکنځلې وکړې، ویې ویل: «ورک شه! ورک شه! ای قاتله! ای رذیله!"}, {"ref": "2 Samuel 1:7", "text": "حوشای ځواب ورکړ: «دا ځل چې اخیتوفل کومه مشوره تاسو ته درکړې ده، هغه ښه نه ده."}, {"ref": "2 Samuel 1:7", "text": "اسراییلیانو د داود د کسانو له خوا ماتې وخوړه. دا ډېره لویه وژنه وه، په هغې ورځ شل زره کسان ووژل شول."}, {"ref": "2 Samuel 1:7", "text": "اوس ووځه او هغه څه چې هغوی کړي دي د هغو په خاطر ورڅخه مننه وکړه! او که داسې ونه کړې، نو زه د ژوندي څښتن په نوم قسم خورم چې سبا سهار به حتی یو سړی هم پاتې نه شي چې ستا طرفداري وکړي. دا به ستا په ټول ژوند کې د هغو ټولو بدبختیو څخه چې په تا باندې راغلي دي، ډېره بده وي.»"}, {"ref": "2 Samuel 1:8", "text": "عمونیان راووتل او د خپل پایتخت ربه د دروازې په خوله کې ځای په ځای شول. په هغه وخت کې د صوبې او رحوب سوریایان او د طوب او معکې عسکر په صحرا کې ځای په ځای شول."}, {"ref": "2 Samuel 1:8", "text": "بیا هغه اوریا ته وویل: «خپل کور ته لاړ شه او یو څه ارام وکړه.» اوریا د ماڼۍ څخه لاړ او داود د هغه کور ته یو سوغات ورولېږه."}, {"ref": "2 Samuel 1:8", "text": "د هغه پاچاهي مې تاته دروبخښله او د هغه ښځې مې تاته په غېږ کې درکړې، ته مې په اسراییلو او یهودا باندې پاچا کړې. که چېرې دا ستا دپاره بس نه وو، نو ما به له دې څخه نور هم زیات درکړي وای."}, {"ref": "2 Samuel 1:8", "text": "نو تامار هلته لاړه او ویې لیدل چې امنون په بستره کې پروت دی. هغې یو څه خمیره کړي اوړه راواخیستل، د هغه په مخکې یې ډوډۍ جوړه کړه او هغه یې پخه کړه."}, {"ref": "2 Samuel 1:8", "text": "پاچا هغې ښځې ته وویل: «ته خپل کور ته ستنه شه او زه به ستا په خاطر امر ورکړم.»"}, {"ref": "2 Samuel 1:8", "text": "کله چې زه د سوریې په جشور کې اوسېدم دا نذر مې منلی ؤ چې که چېرې څښتن ما بېرته اورشلیم ته راولي، نو په حبرون کې به د څښتن عبادت وکړم.»"}, {"ref": "2 Samuel 1:8", "text": "تا د شاوول څخه پاچاهي واخیستله او اوس څښتن د شاوول د کورنۍ د ډېرو خلکو د قتلولو په خاطر ستا څخه بدل اخلي. څښتن ستا زوی ابشالوم ته پاچاهي ورکړه او ته له منځه تللی یې، ځکه چې ته قاتل یې!»"}, {"ref": "2 Samuel 1:8", "text": "تاسو پوهېږئ چې ستاسو پلار داود او د هغه سړي ډېر سخت جنګیالي دي او هغوی د هغې اېږې په شان چې بچي یې تښتول شوي وي په قهر دي. ستاسو پلار یو تجربه لرونکی عسکر دی او هغه د شپې له خوا د خپلو کسانو سره نه پاتې کیږي."}, {"ref": "2 Samuel 1:8", "text": "جګړه شاوخوا سیمې ته خپره شوه. د هغو کسانو شمېر چې په ځنګل کې د خطر له امله مړه شول د هغو کسانو څخه زیات ؤ چې په جګړه کې وژل شوي وو."}, {"ref": "2 Samuel 1:8", "text": "نو پاچا پاڅېد، لاړ او د ښار د دروازې تر څنګ کښېناست. د هغه کسانو واورېدل چې پاچا هلته دی، نو هغوی ټول د هغه حضور ته راټول شول. داود اورشلیم ته ستنیږي په همدې وخت کې ټول اسراییلیان خپلو کورونو ته تښتېدلي وو."}, {"ref": "2 Samuel 1:9", "text": "یوآب ولیدل چې د دښمن لښکر به په هغه باندې مخامخ او د شا له خوا حمله وکړي، نو هغه د اسراییلو د عسکرو څخه ډېر ښه عسکر وټاکل او هغوی یې سوریایانو ته مخامخ ځای په ځای کړل."}, {"ref": "2 Samuel 1:9", "text": "خو اوریا خپل کور ته لاړ نه شو او د پاچا د ساتونکو سره د ماڼۍ په دروازه کې ویده شو."}, {"ref": "2 Samuel 1:9", "text": "ولې دې د څښتن حکمونه سپک وګڼل او د هغه په نظر کې دې داسې بد کار وکړ؟ تا اوریا داسې قتل کړ چې عمونیان دې پرېښودل چې هغه په جګړه کې ووژني."}, {"ref": "2 Samuel 1:9", "text": "بیا یې تبۍ راواخیستله او امنون ته یې ډوډۍ کېښودله، خو هغه د خوړلو څخه انکار وکړ. امنون وویل: «تاسو ټول له دې ځای نه دباندې ووځئ!» نو ټول ووتل."}, {"ref": "2 Samuel 1:9", "text": "هغې وویل: «اعلیحضرته! تاسو چې هرڅه کوئ د هغې ملامتیا دې په ما او زما په کورنۍ باندې وي، تاسو او شاهي کورنۍ دې بې ګناه وي.»"}, {"ref": "2 Samuel 1:9", "text": "پاچا هغه ته وویل: «په خیر لاړ شه.» نو هغه حبرون ته لاړ."}, {"ref": "2 Samuel 1:9", "text": "نو د زرویه زوی ابیشای پاچا ته وویل: «اعلیحضرته! تاسو ولې دې مړ سپي ته اجازه ورکوئ چې تاسو ته ښکنځل وکړي؟ پرېږدئ چې ورشم او سر یې پرې کړم!»"}, {"ref": "2 Samuel 1:9", "text": "ګورئ! همدا اوس هغه په کومه کنده یا بل ځای کې پټ شوی دی. کله چې زمونږ د لښکرو څخه ځینې په لومړۍ حمله کې ووژل شي، هرڅوک چې دا واوري، وبه وایي چې د ابشالوم لښکرې له منځه تللې دي."}, {"ref": "2 Samuel 1:9", "text": "ابشالوم ناڅاپه د داود د یو شمېر کسانو سره مخامخ شو، ابشالوم په قچر باندې سپور ؤ. قچر د څېړۍ د یوې لویې ونې لاندې روان ؤ چې د ابشالوم سر د ونې په شاخونو کې ونښت. قچر خپل تګ ته دوام ورکړ او ابشالوم په هوا کې ځوړند پاتې شو."}, {"ref": "2 Samuel 1:9", "text": "د اسراییلو په ټولو قبیلو کې خلکو یو د بل سره بحث کاوه او ویل یې: «داود پاچا مونږ د خپلو دښمنانو څخه خلاص کړي یو. هغه مونږ د فلسطینیانو څخه ژغورلي یو، خو اوس هغه د ابشالوم څخه تښتېدلی دی او وطن یې پریښی دی."}, {"ref": "2 Samuel 1:10", "text": "یوآب د خپلو لښکرو پاتې کسان د خپل ورور ابیشای تر قوماندې لاندې ورکړل او ابیشای هغوی د عمونیانو په وړاندې ځای په ځای کړل."}, {"ref": "2 Samuel 1:10", "text": "کله چې داود واورېدل چې اوریا کور ته نه دی تللی، د هغه څخه یې پوښتنه وکړه: «تا ډېره لاره وهلې ده، ته ولې کور ته نه یې تللی؟»"}, {"ref": "2 Samuel 1:10", "text": "اوس له دې امله چې تا ماته په سپکه سترګه کتلي دي او د اوریا د ښځې سره دې واده کړی دی، نو په هر نسل کې به ستا ځینې اولاده د تاوتریخوالي له امله مړه شي."}, {"ref": "2 Samuel 1:10", "text": "له هغې وروسته امنون تامار ته وویل: «دلته زما د خوب کوټې ته ډوډۍ راوړه چې ستا د لاس څخه یې وخورم.» هغې ډوډۍ راواخیستله او د هغه د خوب کوټې ته ورغله."}, {"ref": "2 Samuel 1:10", "text": "پاچا ځواب ورکړ: «که چېرې چا درته څه وویل، هغه ماته راوله، بیا به هېڅکله تا نه ځوروي.»"}, {"ref": "2 Samuel 1:10", "text": "خو ابشالوم د اسراییلو ټولو قبیلو ته په پټه پیغام وړونکي واستول چې هغوی ته داسې ووایي: «کله چې تاسو د سرني اواز واورئ، نو چیغې ووهئ چې ابشالوم په حبرون کې پاچا شوی دی!»"}, {"ref": "2 Samuel 1:10", "text": "پاچا ابیشای او د هغه ورور یوآب ته وویل: «زه ستاسو په شان نه یم. که هغه ماته د څښتن په وینا ښکنځلې کوي، نو څوک دا حق لري چې پوښتنه وکړي، ولې هغه داسې کوي؟»"}, {"ref": "2 Samuel 1:10", "text": "نو حتی د ټولو نه زړور عسکر چې زړونه یې د زمري د زړه په شان دي هغوی به هم وارخطا شي، ځکه چې ټول اسراییلیان پوهیږي چې ستاسو پلار ډېر لوی جنګیالی دی او د هغه سړي هم زړور جنګیالي دي."}, {"ref": "2 Samuel 1:10", "text": "کله چې یو سړي هغه ولیده، یوآب یې خبر کړ: «ما همدا اوس ابشالوم ولیده چې د څېړۍ په ونه کې ځوړند ؤ.»"}, {"ref": "2 Samuel 1:10", "text": "مونږ ابشالوم د خپل پاچا په توګه ټاکلی ؤ، خو هغه په جګړه کې وژل شوی دی. نو بیا ولې څوک د دې کوښښ نه کوي چې داود پاچا بېرته راولي؟»"}, {"ref": "2 Samuel 1:11", "text": "یوآب هغه ته وویل: «که چېرې تا ولیدل چې سوریایانو ماته ماتې راکوله، نو راشه او زما سره مرسته وکړه او که چېرې عمونیانو تاته ماتې درکوله نو زه به درشم او ستا سره به مرسته وکړم."}, {"ref": "2 Samuel 1:11", "text": "اوریا ځواب ورکړ: «د اسراییلو او یهودا کسان په جونګړو کې اوسیږي او د لوظ صندوق د هغوی سره دی. زما قوماندان یوآب او د هغه عسکري منصبدارانو په صحرا کې خېمې درولې دي. زه څنګه خپل کور ته لاړ شم، وخورم، وڅښم او د خپلې ښځې سره څملم؟ زه ستا په ژوند باندې قسم خورم چې زه به هېڅکله داسې ونه کړم!»"}, {"ref": "2 Samuel 1:11", "text": "څښتن داسې وایي: زه به ستا د خپلې کورنۍ څخه په تا باندې عذاب راولم. ستا د سترګو په وړاندې به ستا ښځې واخلم او یو بل سړي ته به یې ورکړم او هغه به په رڼا ورځ ستا د ښځو سره څملي."}, {"ref": "2 Samuel 1:11", "text": "خو هغه وخت چې تامار ډوډۍ وروړله چې ویې خوري، امنون هغې ته لاس ورواچاوه او ورته ویې ویل: «ای زما خورې، راشه او راسره څمله.»"}, {"ref": "2 Samuel 1:11", "text": "هغې وویل: «اعلیحضرته! مهرباني وکړئ د خپل څښتن خدای په نوم قسم وخورئ، ترڅو زما خپلوان چې زما د زوی د مرګ د بدل اخیستلو مسوول دی زما د بل زوی په وژلو سره یو لوی جرم ونه کړي.» داود ځواب ورکړ: «زه د ژوندي څښتن په نوم قسم خورم چې ستا د زوی د سر یو ویښته به هم کم نه شي.»"}, {"ref": "2 Samuel 1:11", "text": "دوه سوه کسانو د اورشلیم څخه ابشالوم بدرګه کاوه چې د مېلمنو په توګه رابلل شوي وو. هغوی د زړه له اخلاصه لاړل او د موضوع څخه خبر نه وو."}, {"ref": "2 Samuel 1:11", "text": "بیا داود ابیشای او خپلو ټولو درباریانو ته وویل: «زما خپل زوی هڅه کوي چې ما ووژني، نو تاسو ولې دې بنیامیني ته حیران یئ؟ نو هغه پرېږدئ چې ښکنځلې وکړي، ځکه چې څښتن ورته ویلي دي."}, {"ref": "2 Samuel 1:11", "text": "نو زما مشوره دا ده چې د هېواد له یو سر څخه تر بله سره پورې یعنې د دان څخه تر بیرشبع پورې ټول اسراییلیان چې د بحیرې د شګو په شان ډېر دي، سره راټول کړئ او په جګړه کې تاسو په خپله د هغوی سره لاړ شئ."}, {"ref": "2 Samuel 1:11", "text": "یوآب ځواب ورکړ: «ابشالوم دې ولیده؟ ولې دې په هغه ځای ونه واژه؟ ما به په خپل لاس تاته لس د سپینو زرو سکې او کمربند درکړی وای.»"}, {"ref": "2 Samuel 1:11", "text": "هر هغه څه چې د اسراییلو خلکو ویلي وو، هغه د داود پاچا غوږ ته رسېدلي وو. نو داود پاچا صادوق او ابیاتار کاهنانو ته پیغام ورولېږه چې د یهودا سپین ږیرو ته ووایي: «ولې د پاچا په بېرته راوستلو کې د هغه خپلې ماڼۍ ته د ټولو څخه وروسته یئ؟"}, {"ref": "2 Samuel 1:12", "text": "قوي او زړور اوسه! راځه چې د خپل قوم او د خدای د ښارونو دپاره په مېړانه او زړورتیا سره وجنګېږو. څه چې د څښتن رضا وي هغه دې وشي!»"}, {"ref": "2 Samuel 1:12", "text": "نو داود هغه ته وویل: «یوه ورځ نور هم دلته پاتې شه او سبا به دې بېرته ولېږم.» نو اوریا هغه ورځ او راتلونکې ورځ هم په اورشلیم کې پاتې شو."}, {"ref": "2 Samuel 1:12", "text": "تا دا کار په پټه وکړ، خو زه به دا کار په رڼا ورځ د ټولو اسراییلیانو په مخکې وکړم.»"}, {"ref": "2 Samuel 1:12", "text": "تامار هغه ته وویل: «ای زما وروره! دا کار مه کوه، ما مه مجبوروه! داسې کار په اسراییلو کې یو جرم دی. داسې بې عقل کار مه کوه!"}, {"ref": "2 Samuel 1:12", "text": "هغې ښځې وویل: «اعلیحضرته! اجازه راکړئ چې یوه بله خبره هم درته وکړم.» هغه ځواب ورکړ: «ووایه!»"}, {"ref": "2 Samuel 1:12", "text": "د قربانۍ کولو په وخت کې ابشالوم اخیتوفل د داود مشاور هم راوغوښت چې د خپل وطن جیلوه څخه راشي. نو د پاچا په وړاندې دسیسه قوي شوه او د ابشالوم پیروان زیاتېدل."}, {"ref": "2 Samuel 1:12", "text": "کېدای شي چې څښتن زما مصیبت وویني او د هغو ښکنځلو په بدل کې چې نن ماته وشوې راسره نېکي وکړي.»"}, {"ref": "2 Samuel 1:12", "text": "داود چې په هرځای کې وي مونږ به هغه راپیدا کوو او داسې به ورباندې وروغورځېږو لکه چې په ځمکه باندې پرخه پرېوځي. نه به هغه ژوندی پاتې شي او نه به د هغه د کسانو څخه څوک ژوندی پاتې شي."}, {"ref": "2 Samuel 1:12", "text": "خو هغه کس ځواب ورکړ: «که ماته دې زر د سپینو زرو سکې هم راکړي وای ما به د پاچا د زوی په ضد خپل لاس پورته کړی نه وای. مونږ ټولو واورېدل چې پاچا تاته، ابیشای ته او اتای ته امر وکړ چې زما په خاطر ځوان ابشالوم ته زیان ونه رسوئ."}, {"ref": "2 Samuel 1:12", "text": "تاسو زما ورونه یئ، زما خپل هډوکي او خپله وینه یئ، نو ولې باید زما په بېرته راوستلو کې د ټولو څخه وروسته اوسئ؟»"}, {"ref": "2 Samuel 1:13", "text": "نو یوآب او د هغه سړي مخکې لاړل چې حمله وکړي او سوریایان وتښتېدل."}, {"ref": "2 Samuel 1:13", "text": "داود هغه د ماښام ډوډۍ ته راوغوښت او هغه یې نشه کړ. خو ماښام اوریا ووت او د پاچا د ساتونکو سره په خپلې بسترې باندې ویده شو او کور ته لاړ نه شو."}, {"ref": "2 Samuel 1:13", "text": "داود ناتان ته وویل: «ما د څښتن په وړاندې ګناه کړې ده.» ناتان ځواب ورکړ: «څښتن ته بخښلی یې، ته به د دې ګناه له امله مړ نه شې."}, {"ref": "2 Samuel 1:13", "text": "زه به بیا په خلکو کې سر څنګه اوچتوم؟ او ته به په اسراییلو کې د بدکاره احمقانو په شان بې عزته شې. مهرباني وکړه د پاچا سره خبرې وکړه، هغه به تا زما سره د واده کولو څخه منع نه کړي.»"}, {"ref": "2 Samuel 1:13", "text": "هغې ښځې وویل: «ولې مو د خدای د قوم سره داسې غلطي کړې ده؟ تاسو خپل زوی نه پرېږدئ چې د جلاوطنۍ څخه راستون شي، نو تاسو خپل ځان په هغې خبرې باندې چې همدا اوس مو وکړه، ملامتوئ."}, {"ref": "2 Samuel 1:13", "text": "یو استازي داود ته خبر راوړ چې د اسراییلو خلکو خپله وفاداري بدله کړې ده او د ابشالوم طرفداري کوي."}, {"ref": "2 Samuel 1:13", "text": "نو داود او د هغه سړي خپل تګ ته دوام ورکړ. په هغه وخت کې شمعي هم هغوی ته مخامخ د نژدې غره په څنګ کې روان ؤ. هغه ښکنځلې کولې، داود یې په تیږو باندې ویشته او خاورې یې ورباندې شیندلې."}, {"ref": "2 Samuel 1:13", "text": "که چېرې هغه یو ښار ته ننوځي، نو ټول اسراییلیان به رسۍ ګانې راوړي او ښار به لاندې درې ته راوغورځوي. یوه تیږه به هم د ښار په غونډۍ باندې پاتې نه شي.»"}, {"ref": "2 Samuel 1:13", "text": "له بلې خوا، که چېرې ما خیانت کړی وای او هغه مې وژلی وای، نو پاچا به اورېدلي وای. هغه د هرڅه څخه خبریږي، نو تا به زما څخه دفاع نه وای کړې.»"}, {"ref": "2 Samuel 1:13", "text": "داود هغوی ته دا هم وویل چې عماسا ته ووایي: «ته زما خپل یې، له همدا اوس څخه تا د یوآب په ځای د لښکرو مشر ټاکم. که زه دا کار ونه کړم، نو خدای دې ما ووژني!»"}, {"ref": "2 Samuel 1:14", "text": "کله چې عمونیانو ولیدل چې سوریایان تښتي، هغوی له ابیشای څخه وتښتېدل او ښار ته ننوتل. نو یوآب د عمونیانو سره د جنګ کولو څخه راستون شو او بېرته اورشلیم ته لاړ."}, {"ref": "2 Samuel 1:14", "text": "په راتلونکي سهار داود یوآب ته لیک ولیکه او د اوریا په لاس یې ورولېږه."}, {"ref": "2 Samuel 1:14", "text": "خو تا د دې بد کار له امله د څښتن ډېره بې عزتي وکړه. نو ستا ماشوم به مړ شي.»"}, {"ref": "2 Samuel 1:14", "text": "خو امنون د هغې خبرو ته غوږ ونه نیوه او څرنګه چې هغه د تامار څخه ډېر قوي ؤ، نو هغه یې په زوره بې عزته کړه."}, {"ref": "2 Samuel 1:14", "text": "مونږ ټول مړه کېږو او د اوبو په شان یو چې په ځمکه باندې توییږي او بېرته نه شي راټولېدلی. خدای ژوند نه اخلي بلکې داسې لاره لټوي چې یو شړلی سړی د هغه څخه لېرې پاتې نه شي."}, {"ref": "2 Samuel 1:14", "text": "نو داود خپلو ټولو درباریانو ته چې په اورشلیم کې ورسره وو، وویل: «راشئ! مونږ باید وتښتو، که نه، نو مونږ به یو هم د ابشالوم څخه خلاص نه شو. باید بیړه وکړو او لاړ شو، هسې نه چې هغه سمدلاسه راورسیږي او مونږ او همدارنګه په ښار کې هر یو تن ووژني.»"}, {"ref": "2 Samuel 1:14", "text": "پاچا د خپلو ټولو کسانو سره د اردن سیند ته ورسېده او هلته یې استراحت وکړ."}, {"ref": "2 Samuel 1:14", "text": "ابشالوم او ټولو اسراییلیانو وویل: «د حوشای مشوره د اخیتوفل د مشورې څخه ښه ده.» ځکه چې څښتن دا پرېکړه کړې وه چې د اخیتوفل ښه مشوره باطله کړي، د دې په خاطر چې ابشالوم تباه او برباد کړي."}, {"ref": "2 Samuel 1:14", "text": "یوآب وویل: «زه نه غواړم ستا سره نور وخت ضایع کړم.» هغه درې نېزې راواخیستلې او د ابشالوم په سینه کې یې چې تر هغه وخته لا ژوندی ؤ او د څېړۍ په ونه کې ځوړند ؤ، ورومنډلې."}, {"ref": "2 Samuel 1:14", "text": "د داود په خبرو د یهودا خلک ډېر زر بېرته د هغه ملاتړي شول او هغوی پاچا ته پیغام ورولېږه چې د خپلو ټولو کسانو سره بېرته راستون شي."}, {"ref": "2 Samuel 1:15", "text": "کله چې سوریایان پوه شول چې دوی ته اسراییلو ماتې ورکړه، نو هغوی خپلې لښکرې بېرته سره راټولې کړې."}, {"ref": "2 Samuel 1:15", "text": "هغه لیکلي وو: «اوریا په سخته جګړه کې په لومړۍ کرښه کې ځای په ځای کړه بیا د هغه څخه بېرته په شا شئ، ترڅو هغه ووژل شي.»"}, {"ref": "2 Samuel 1:15", "text": "له هغې وروسته ناتان کور ته لاړ. د داود د زوی مړینه څښتن هغه ماشوم چې د اوریا کونډې داود ته زېږولی ؤ، په سختې ناروغۍ اخته کړ."}, {"ref": "2 Samuel 1:15", "text": "بیا امنون د هغې څخه ډېره سخته کرکه وکړه. د هغه کرکه د هغې مینې څخه چې مخکې یې د هغې سره کوله، ډېره زیاته وه. امنون هغې ته وویل چې «پاڅه او ورکه شه!»"}, {"ref": "2 Samuel 1:15", "text": "نو اوس اعلیحضرته! د دې خبرې دلیل چې زه راغلې یم ستاسو سره خبرې وکړم، دا دی چې خلک ماته ګواښ کوي. نو ما د ځان سره وویل چې زه به ستاسو سره خبرې وکړم او دا هیله مې درلودله چې تاسو به هغه څه وکړئ چې زه یې غواړم."}, {"ref": "2 Samuel 1:15", "text": "درباریانو ځواب ورکړ: «ښه ده اعلیحضرته! هرڅه چې ستاسو خوښه وي مونږ تیار یو.»"}, {"ref": "2 Samuel 1:15", "text": "ابشالوم او هغه اسراییلیان چې د هغه سره وو، اورشلیم ته ورننوتل او اخیتوفل هم د هغوی سره ؤ."}, {"ref": "2 Samuel 1:15", "text": "وروسته حوشای صادوق او ابیاتار کاهنانو ته وویل چې اخیتوفل څه وړاندیز کړی ؤ او د ده مشوره کومه وه."}, {"ref": "2 Samuel 1:15", "text": "بیا د یوآب لس کسان چې د هغه وسلې به یې وړلې، ابشالوم ته ورنژدې شول او هغه یې وواژه."}, {"ref": "2 Samuel 1:15", "text": "نو پاچا بېرته په ستنېدلو پیل وکړ. څنګه چې هغه د اردن سیند ته ورسېده، نو د یهودا خلک جلجال ته راغلل چې د پاچا مخې ته ورشي او هغه د سیند څخه راپورې باسي."}, {"ref": "2 Samuel 1:16", "text": "هددعزر پاچا نور سوریایان راوغوښتل چې د فرات د سیند په ختیځه خوا کې وو. هغوی د پاچا د قوماندان شوبک تر امر لاندې حیلام ته راغلل."}, {"ref": "2 Samuel 1:16", "text": "نو کله چې یوآب ښار کلابند کاوه، نو اوریا یې هغه ځای ته ولېږه چې هغه پوهېده هلته دښمن قوي دی."}, {"ref": "2 Samuel 1:16", "text": "داود د هغه ماشوم دپاره خدای ته زارۍ وکړې چې ماشوم روغ شي. هغه روژه ونیوله او هره شپه به خپلې کوټې ته تللو او ټوله شپه به یې په ځمکه تېروله."}, {"ref": "2 Samuel 1:16", "text": "هغې ورته وویل: «نه! زما شړل به د هغه کار څخه هم لوی جرم وي چې مخکې دې زما سره وکړ.» خو امنون د هغې خبرو ته غوږ ونه نیوه."}, {"ref": "2 Samuel 1:16", "text": "ما فکر کاوه چې تاسو به زما خبرو ته غوږ ونیسئ او ما به د هغه سړي له لاسه وژغورئ چې هڅه کوي ما او زما زوی دواړه د هغه وطن څخه بې برخې کړي چې خدای مونږ ته راکړی دی."}, {"ref": "2 Samuel 1:16", "text": "نو پاچا روان شو او د خپلې ټولې کورنۍ او درباریانو له خوا بدرګه کېده. خو هغه لس وینځې د ماڼۍ د ساتلو دپاره پرېښودلې."}, {"ref": "2 Samuel 1:16", "text": "کله چې د داود اعتباري ملګري حوشای ابشالوم ولیده، هغه چیغې ووهلې: «ژوندی دې وي پاچا! ژوندی دې وي پاچا!»"}, {"ref": "2 Samuel 1:16", "text": "حوشای زیاته کړه: «اوس زر شئ! داود ته پیغام ورولېږئ چې د اردن د سیند په ګودر باندې چې په دښته کې دی شپه تېره نه کړي، بلکې سمدلاسه د سیند څخه تېر شي، ترڅو هغه او هغه خلک چې ورسره دي له منځه لاړ نه شي.»"}, {"ref": "2 Samuel 1:16", "text": "وروسته یوآب سرنی وواهه چې جګړه بس کړي. نو د هغه لښکرې د اسراییلیانو د تعقیبولو څخه بېرته راوګرځېدلې."}, {"ref": "2 Samuel 1:16", "text": "په همدې وخت کې شمعي د بنیامیني جیرا زوی چې د بحوریم څخه ؤ، په بیړه سیند ته ورغی چې د داود پاچا سره لیدنه کتنه وکړي"}, {"ref": "2 Samuel 1:17", "text": "کله چې داود دا واورېدل، هغه د اسراییلو ټولې لښکرې سره راټولې کړې، د اردن د سیند څخه تېر شو او حیلام ته ورغی. سوریایان هلته هغه ته مخامخ ځای په ځای کېدل، بیا وروسته جګړه پیل شوه."}, {"ref": "2 Samuel 1:17", "text": "د دښمن ځواکونه د ښار څخه راووتل او د یوآب د ځواکونو سره وجنګېدل. د داود څو تنه عسکري منصبداران د اوریا سره یوځای ووژل شول."}, {"ref": "2 Samuel 1:17", "text": "د داود د ماڼۍ د خدمتګارانو مشران د هغه په سر ودرېدل او هیله یې وکړه چې هغه به د ځمکې څخه راپاڅیږي او د هغوی سره به ډوډۍ وخوري، خو هغه انکار وکړ."}, {"ref": "2 Samuel 1:17", "text": "هغه خپل شخصي خدمتګار راوغوښت او ورته ویې ویل: «دغه ښځه د دې ځای نه دباندې وباسه او دروازه ورپسې وتړه.»"}, {"ref": "2 Samuel 1:17", "text": "اعلیحضرته! نو ما باور درلود چې ستاسو وعده به ماته ارامي راولي، ځکه چې تاسو د ښو او بدو په پېژندلو کې د خدای د فرښتې په شان یئ. ستاسو څښتن خدای دې ستاسو سره وي.»"}, {"ref": "2 Samuel 1:17", "text": "نو پاچا د هغو ټولو خلکو سره چې د ده پسې وو، روان شو او هغوی د ښار په یوه غاړه کې د اخرني کور په څنګ کې وځنډېدل."}, {"ref": "2 Samuel 1:17", "text": "ابشالوم د هغه څخه پوښتنه وکړه: «ستا په وفادارۍ باندې څه وشو چې د خپل ملګري داود سره دې درلودله؟ ولې د هغه سره لاړ نه شوې؟»"}, {"ref": "2 Samuel 1:17", "text": "په دې وخت کې، یوناتان د ابیاتار زوی او اخیمعص د صادوق زوی د روجل په چینې چې د اورشلیم په غاړه وه انتظار کاوه، ځکه چې هغوی جرات نه کاوه چې ښار ته د ننوتلو په وخت کې ولیدل شي. یوه وینځه به تلله او هرڅه چې به پېښېدل، هغوی ته به یې خبر ورکاوه او بیا به دوی تلل او داود پاچا به یې خبراوه."}, {"ref": "2 Samuel 1:17", "text": "هغوی د ابشالوم مړی راواخیست، په ځنګل کې یې په یوه ژوره کنده کې وغورځاوه او هغه یې د تیږو د یوې لویې ډېرۍ لاندې پټ کړ. بیا ټول اسراییلیان خپلو کورونو ته وتښتېدل."}, {"ref": "2 Samuel 1:17", "text": "او د هغه سره زر تنه بنیامینیان وو. صیبا د شاوول د کورنۍ خدمتګار هم د خپلو پنځلس زامنو او شلو نوکرانو سره په بیړه د پاچا څخه مخکې سیند ته ورسېدل."}, {"ref": "2 Samuel 1:18", "text": "خو د سوریایانو لښکرې د اسراییلیانو څخه وتښتېدلې. داود او د هغه سپرو عسکرو د سوریایانو اووه سوه د جنګي ګاډیو چلوونکي او څلوېښت زره سپاره عسکر ووژل. هغوی د دښمن قوماندان شوبک ژوبل کړ او هغه د جنګ په میدان کې مړ شو."}, {"ref": "2 Samuel 1:18", "text": "بیا یوآب داود ته د جنګ په اړه پوره راپور ولېږه"}, {"ref": "2 Samuel 1:18", "text": "په اوومه ورځ هغه ماشوم مړ شو. د داود خدمتګاران ووېرېدل چې هغه ته خبر ورکړي، ځکه چې دوی وویل: «هغه وخت چې ماشوم لا ژوندی ؤ، مونږ به د داود سره خبرې کولې او هغه مونږ ته ځواب نه راکاوه. نو څنګه به هغه ته ووایو چې د ده ماشوم مړ شوی دی؟ کېدای شي چې هغه خپل ځان ته کوم زیان ورسوي.»"}, {"ref": "2 Samuel 1:18", "text": "نو د هغه خدمتګار هغه دباندې وویستله او دروازه یې ورپسې وتړله. تامار د اوږدو لستوڼو چپنه اغوستله، ځکه چې دا د پېغلو شاهزادګیو رواجي لباس ؤ."}, {"ref": "2 Samuel 1:18", "text": "پاچا ځواب ورکړ: «زه ستا څخه یوه پوښتنه کوم او ته باید راته پوره رښتیا ووایې.» هغې ځواب ورکړ: «اعلیحضرته! د هر شي په هکله چې پوښتنه کوئ نو ویې کړئ.»"}, {"ref": "2 Samuel 1:18", "text": "ټول درباریان او د هغه ساتونکي یعنې کریتیان او فلیتیان د داود په مخکې تېر شول. همدارنګه شپږ سوه عسکر چې د جت څخه د ده پسې وو، هغوی هم تېر شول."}, {"ref": "2 Samuel 1:18", "text": "حوشای ځواب ورکړ: «نه، داسې نه شي کېدای، زه به د هغه چا ملاتړ کوم او زه به د هغه سره اوسم چې د څښتن او د دې قوم او ټولو اسراییلیانو له خوا غوره شوی دی."}, {"ref": "2 Samuel 1:18", "text": "خو یوه ورځ، یو هلک دوی ولیدل او ابشالوم یې خبر کړ. نو هغوی په چټکۍ سره په بحوریم کې د یو سړي کور ته ورغلل چې هلته پټ شي. د هغه په حویلۍ کې یوه څاه وه او هغوی هغې څاه ته ورښکته شول."}, {"ref": "2 Samuel 1:18", "text": "ابشالوم لا ژوندی ؤ چې یو څلی یې د پاچا په دره کې جوړ کړ او هغه یې د خپل ځان په نوم یاد کړ. دا کار یې ځکه وکړ چې هغه زوی نه درلود چې د ده نوم ژوندی وساتي. تر نن ورځې پورې هغه د ابشالوم د څلي په نوم یادیږي."}, {"ref": "2 Samuel 1:18", "text": "هغوی د سیند په ګودر باندې پورې وتل چې د پاچا کورنۍ او ډله راپورې باسي او هرڅه چې پاچا غواړي ویې کړي. داود شمعي بخښي کله چې د جیرا زوی شمعي د اردن څخه پورې وت هغه د پاچا په مخکې په ځمکه باندې پړمخې پرېوت"}, {"ref": "2 Samuel 1:19", "text": "کله چې هغه پاچاهان چې د هددعزر تابع وو، ولیدل چې هغوی د اسراییلو له خوا ماتې وخوړله، نو د اسراییلو سره یې سوله وکړه او د هغوی رعیت شول. نو سوریایان د عمونیانو سره نور د مرستې کولو څخه ووېرېدل."}, {"ref": "2 Samuel 1:19", "text": "او استازي ته یې داسې لارښوونه وکړه: «وروسته له دې چې ته پاچا ته د جنګ په هکله هرڅه بیان کړې،"}, {"ref": "2 Samuel 1:19", "text": "داود ولیدل چې د هغه خدمتګاران په خپل منځ کې ګونګوسې کوي او پوه شو چې ماشوم یې مړ شوی دی. نو د هغوی څخه یې پوښتنه وکړه: «ایا ماشوم مړ شوی دی؟» هغوی ځواب ورکړ: «هو، هغه مړ شوی دی.»"}, {"ref": "2 Samuel 1:19", "text": "تامار په خپل سر باندې ای