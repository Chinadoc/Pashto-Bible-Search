FROM python:3.10-slim

# Install system dependencies
RUN apt-get update && apt-get install -y \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy requirements
COPY whisperx-api/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy WhisperX API code
COPY whisperx-api/ ./whisperx-api/

# Expose port
EXPOSE 8000

# Run the API
CMD ["python", "-m", "uvicorn", "whisperx-api.main:app", "--host", "0.0.0.0", "--port", "8000"]

